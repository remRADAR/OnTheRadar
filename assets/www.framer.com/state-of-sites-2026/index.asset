    <!-- Snippet: CRZ0IdveN -->
<!-- Plugin: api --> <script>
(() => {
  const STORAGE_KEY = "stateOfSitesUnlocked";
  const MOUNT_PATH = "/state-of-sites-2026";
  const INTRO_SEGMENT = "/chapter/intro";
  const ACCESS_EVENT = "state-of-sites-access-change";
  const COOKIE_MAX_AGE = 31536000;
  const UNLOCK_DELAY_MS = 1200;

  const normalizePath = (pathname) => {
    const normalized = String(pathname || "").replace(/\/+$/, "");
    return normalized || "/";
  };

  const getBasePath = (pathname) => {
    const normalized = normalizePath(pathname);
    return normalized === MOUNT_PATH || normalized.startsWith(MOUNT_PATH + "/")
      ? MOUNT_PATH
      : "/";
  };

  const joinPath = (basePath, segment) => {
    return basePath === "/" ? segment : basePath + segment;
  };

  const getHomePath = (pathname) => {
    return getBasePath(pathname);
  };

  const getIntroPath = (pathname) => {
    return joinPath(getBasePath(pathname), INTRO_SEGMENT);
  };

  const isPublicPath = (pathname) => {
    const normalized = normalizePath(pathname);
    return (
      normalized === getHomePath(normalized) ||
      normalized === getIntroPath(normalized)
    );
  };

  const emitAccessChange = () => {
    window.dispatchEvent(new CustomEvent(ACCESS_EVENT));
  };

  const getCookieDomain = () => {
    const { hostname } = window.location;
    if (hostname === "framer.com" || hostname.endsWith(".framer.com")) {
      return ".framer.com";
    }
    if (hostname === "framer.website" || hostname.endsWith(".framer.website")) {
      return ".framer.website";
    }
    return null;
  };

  const readAccessCookie = () => {
    const prefix = STORAGE_KEY + "=";
    const cookies = document.cookie ? document.cookie.split(";") : [];
    for (const rawCookie of cookies) {
      const cookie = rawCookie.trim();
      if (cookie.startsWith(prefix)) {
        return decodeURIComponent(cookie.slice(prefix.length));
      }
    }
    return null;
  };

  const writeAccessCookie = (value, maxAge = COOKIE_MAX_AGE) => {
    const parts = [
      STORAGE_KEY + "=" + encodeURIComponent(value),
      "Path=/",
      "Max-Age=" + String(maxAge),
      "SameSite=Lax",
    ];
    if (window.location.protocol === "https:") parts.push("Secure");
    const domain = getCookieDomain();
    if (domain) parts.push("Domain=" + domain);
    document.cookie = parts.join("; ");
  };

  const clearAccessCookie = () => {
    writeAccessCookie("", 0);
  };

  const isUnlocked = () => {
    const cookieUnlocked = readAccessCookie() === "true";
    if (cookieUnlocked) {
      try {
        window.localStorage.setItem(STORAGE_KEY, "true");
      } catch {}
      return true;
    }

    try {
      const storageUnlocked = window.localStorage.getItem(STORAGE_KEY) === "true";
      if (storageUnlocked) writeAccessCookie("true");
      return storageUnlocked;
    } catch {
      return false;
    }
  };

  const unlockSite = () => {
    writeAccessCookie("true");
    try {
      window.localStorage.setItem(STORAGE_KEY, "true");
    } catch {}
    emitAccessChange();
  };

  const scheduleUnlock = () => {
    window.setTimeout(() => {
      if (!isUnlocked()) unlockSite();
    }, UNLOCK_DELAY_MS);
  };

  const lockSite = () => {
    clearAccessCookie();
    try {
      window.localStorage.removeItem(STORAGE_KEY);
    } catch {}
    emitAccessChange();
  };

  const currentPath = normalizePath(window.location.pathname);
  const homePath = getHomePath(currentPath);

  if (!isPublicPath(currentPath) && !isUnlocked()) {
    window.location.replace(homePath);
    return;
  }

  if (currentPath === homePath) {
    document.addEventListener(
      "submit",
      (event) => {
        const form = event.target;
        if (!(form instanceof HTMLFormElement)) return;
        if (!form.checkValidity()) return;
        scheduleUnlock();
      },
      true
    );
  }

  window.stateOfSitesAccess = {
    isUnlocked,
    unlock: unlockSite,
    lock: lockSite,
  };
})();
</script>
<!-- SnippetEnd: CRZ0IdveN -->

