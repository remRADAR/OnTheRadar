    <!-- Snippet: mzK6Ng3hA --><script>
(function () {
  window.dataLayer = window.dataLayer || [];

  document.addEventListener(
    "submit",
    function (e) {
      const form = e.target;
      if (!(form instanceof HTMLFormElement)) return;

      // Collect values
      const obj = {};
      const fd = new FormData(form);
      fd.forEach((value, key) => {
        // handle multiple values (checkbox groups)
        if (obj[key] !== undefined) {
          obj[key] = Array.isArray(obj[key]) ? obj[key].concat(value) : [obj[key], value];
        } else {
          obj[key] = value;
        }
      });

      // Push to GTM
      window.dataLayer.push({
        event: "state_of_sites_lead",
        formId: "2",
        formName: "State of Sites",
        formAction: form.action || null,
        formData: obj
      });
    },
    true // capture phase helps with JS-handled submits
  );
})();
</script>
