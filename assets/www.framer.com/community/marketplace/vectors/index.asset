0,\"categories\":[{\"id\":\"3535507e-b041-4f48-be7f-a084b14e30b2\",\"name\":\"Icons\",\"slug\":\"icons\"}]}},{\"id\":\"6E5q3D00doNfTYKNyiv5\",\"resolved\":true,\"title\":\"Sushi Set\",\"body\":\"\u003cp class=\\\"editor_paragraph__IOT_o\\\"\u003eThis “Sushi Set” brings a playful and authentic touch to your Framer projects.\u003c/p\u003e\u003cp class=\\\"editor_paragraph__IOT_o\\\"\u003eDesigned by a Japanese creator, each icon captures the charm of classic sushi items — from tuna and salmon to rolls and more. Whether you’re customizing your profile, adding personality to a portfolio, or simply sharing your love of sushi, these icons make it easy to express yourself with style.\u003c/p\u003e\u003cp class=\\\"editor_paragraph__IOT_o\\\"\u003eSince these are food illustrations, the general colors are fairly defined, but variants allow you to customize them.\u003c/p\u003e\u003cp class=\\\"editor_paragraph__IOT_o\\\"\u003eYou can adjust the colors of the sushi toppings, rice, and seaweed, making it possible to use them in vivid palettes or switch to monochrome for a different look.\u003c/p\u003e\",\"bodyJson\":null,\"introduction\":\"An icon sets of sushi, created by a Japanese Framer creator. Perfect for showcasing your personal taste in your profile.\",\"slug\":\"sushi-set\",\"author\":{\"framerUserId\":\"d1dff73b-8bf5-4ebb-a23b-5332bada924d\",\"name\":\"日香理 / hikari\",\"slug\":\"hikari-template\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/492120/avatar-uytCLZVoEDDT5YrOh9eZuN2hFUQace.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/vector-sets/sushi-set/birkqctm-qeRPBtteIDnf46oxla4uIRNxc2iFrB\",\"metadata\":{\"tint\":\"hsl(0 0% 9%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/vector-sets/sushi-set/0rszxq5p-osxLxmkNySYLjfrw1vQn8WQDknicdT\",\"metadata\":{\"tint\":\"hsl(0 0% 9%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/vector-sets/sushi-set/uewf39gb-PLdZH1WENV6xbYhNlwyGcwbtsZtCG0\",\"metadata\":{\"tint\":\"hsl(0 0% 9%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/vector-sets/sushi-set/3udw81ra-m1JDVLaPUegBo9MNRudVe6mb36IyJ4\",\"metadata\":{\"tint\":\"hsl(0 0% 9%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"0199b8ec-ad0c-791d-af35-1879235545e3\",\"bodyJson\":null,\"likes\":{\"count\":39,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2025-10-04T01:39:06.818Z\",\"updatedAt\":\"2025-10-14T13:41:17.917Z\",\"publishedAt\":\"2025-10-06T09:49:02.604Z\",\"featuredAt\":\"2026-06-04T09:33:40.547Z\",\"reported\":false,\"approvedAt\":null,\"type\":\"vector\",\"attributes\":{\"url\":\"https://framer.com/m/Tuna-Nw7T.js@7DEjw9Ebfv7E4VX0c5zK\",\"price\":null,\"paymentUrl\":null,\"vectorCount\":15,\"categories\":[{\"id\":\"78e55a4a-220e-474c-9a7f-690f940cb1de\",\"name\":\"Illustrations\",\"slug\":\"illustrations\"}]}},{\"id\":\"JoGvnUo9YaQLgviqt8bw\",\"resolved\":true,\"title\":\"Busivio\",\"body\":\"$54\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"About\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Busivio is a comprehensive collection of 90 flat color icons designed specifically for startup ecosystems, business operations, and modern digital products. The pack covers essential startup activities including product development, growth marketing, operational workflows, financial management, and team collaboration.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Each icon is carefully crafted with pixel-perfect precision, consistent proportions, and a cohesive visual language to ensure seamless integration across websites, mobile applications, dashboards, presentations, and marketing materials. Whether you're building a SaaS platform, startup website, business presentation, or internal product documentation, Busivio provides a professional and scalable icon solution for modern business environments.\"}]},{\"type\":\"paragraph\"},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Key Features\"}],\"attrs\":{\"level\":2}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Flat Color Style with Clean Visual Appearance\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Pixel-Perfect Design for Crisp Rendering\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Covers Product, Growth, Operations, Finance, and Team Categories\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Suitable for Web, Mobile Apps, Presentations, and Dashboards\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Professional and Modern Business-Oriented Visual Language\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Designed for Designers, Developers, Startups, and Product Teams\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Cohesive Icon System Across All Categories\"}]}]}]},{\"type\":\"customHeading\",\"attrs\":{\"level\":2}},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Refund Policy\",\"marks\":[{\"type\":\"bold\"}]}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Because this product is delivered digitally and becomes accessible immediately after purchase, all sales are final. Refunds, exchanges, or cancellations are not available.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"If you experience any issues accessing or using the files, support is available. Please contact \"},{\"type\":\"text\",\"text\":\"punloka.design@gmail.com\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"mailto:punloka.design@gmail.com\",\"target\":\"_blank\"}},{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" with details of the issue, and assistance will be provided to ensure everything works as expected.\"}]}]},\"introduction\":\"The Essential Startup Business\",\"slug\":\"busivio\",\"author\":{\"framerUserId\":\"ad51ac17-dde0-437c-86d9-e5bdc209191c\",\"name\":\"Punloka\",\"slug\":\"punloka\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/504655/avatar-bptS8eULX4wdaiellNt7JHhPcQXSvh.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/ad51ac17-dde0-437c-86d9-e5bdc209191c/0ukqsk06\",\"metadata\":{\"tint\":\"hsl(180 53% 42%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/ad51ac17-dde0-437c-86d9-e5bdc209191c/hx6xepwv\",\"metadata\":{\"tint\":\"hsl(240 75% 13%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/ad51ac17-dde0-437c-86d9-e5bdc209191c/5s3u00cj\",\"metadata\":{\"tint\":\"hsl(0 0% 9%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/ad51ac17-dde0-437c-86d9-e5bdc209191c/ghx4h8v7\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/ad51ac17-dde0-437c-86d9-e5bdc209191c/zs9q1epx\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019ee2fc-110b-75e8-82e8-7c4b9ec9e5fe\",\"bodyJson\":null,\"likes\":{\"count\":11,\"liked\":false},\"comments\":{\"count\":1},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-06-20T03:03:50.771Z\",\"updatedAt\":\"2026-06-20T03:03:50.771Z\",\"publishedAt\":\"2026-06-20T03:03:50.769Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"vector\",\"attributes\":{\"url\":null,\"price\":\"10\",\"paymentUrl\":\"https://punloka.lemonsqueezy.com/checkout/buy/f69fb9db-4989-436a-8341-46f7cff47050\",\"vectorCount\":90,\"categories\":[{\"id\":\"65fa91ad-4375-40c0-8b72-1cc71f2f4000\",\"name\":\"Business\",\"slug\":\"business\"}]}},{\"id\":\"ttdSx1YmQc0fxF248k9X\",\"resolved\":true,\"title\":\"Mono Shapes\",\"body\":\"\u003cp\u003e\u003cstrong\u003eMono Shapes\u003c/strong\u003e is a versatile vector set by \u003ca target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://shapes.framer.website/\\\"\u003e\u003cstrong\u003eMonika Michalczyk\u003c/strong\u003e\u003c/a\u003e, curated for use in \u003cstrong\u003eFramer\u003c/strong\u003e.\u003c/p\u003e\u003cp\u003eThe collection features bold, minimal shapes designed to add character to any project — perfect as masks, graphic elements, stickers, or logo bases.\u003c/p\u003e\u003cp\u003eEach vector is clean, scalable, and easy to adapt for web, branding, or motion graphics.\u003c/p\u003e\",\"bodyJson\":null,\"introduction\":\"A clean collection of geometric and organic shapes for modern layouts and logos.\",\"slug\":\"mono-shapes\",\"author\":{\"framerUserId\":\"2a425ad9-c342-4590-af3c-88a1f3875e22\",\"name\":\"Sanna Granqvist\",\"slug\":\"sanna-granqvist\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/2a425ad9-c342-4590-af3c-88a1f3875e22/a2khusgj\",\"badges\":[\"pro\"],\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/vector-sets/mono-shapes/3e6i8kmk-t8NfidU0QSMWV1u80LfwSmJW0DXPlE\",\"metadata\":{\"tint\":\"hsl(0 0% 58%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/vector-sets/mono-shapes/renhmbny-xQMCi2vk3gW6zZL7a06DmkMb188rm4\",\"metadata\":{\"tint\":\"hsl(0 0% 58%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"0199ce37-5cad-7c86-a9ab-18f8a96fd8de\",\"bodyJson\":null,\"likes\":{\"count\":43,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2025-10-10T06:59:58.978Z\",\"updatedAt\":\"2025-10-24T14:44:31.393Z\",\"publishedAt\":\"2025-10-10T13:02:38.765Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"vector\",\"attributes\":{\"url\":\"https://framer.com/m/Shape-1-Xf4s.js@6aOH5PZalUiSrnsbAmOj\",\"price\":null,\"paymentUrl\":null,\"vectorCount\":283,\"categories\":[{\"id\":\"89c679b1-87fd-4d3a-830c-c029d9c86011\",\"name\":\"Shapes\",\"slug\":\"shapes\"}]}},{\"id\":\"YsfPiAUVF3PjY3FXmrA1\",\"resolved\":true,\"title\":\"Arrows Hand And Icon\",\"body\":\"$55\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Hand-Drawn Series (30+ Icons)\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"An expressive set of handcrafted, sketch-style arrows built to add personality, visual emphasis, and human touch to graphics, presentations, and interactive layouts.\"}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Style Aesthetics\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\": Loose stroke textures, variable linework, organic curves, and custom doodle aesthetics.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Variations Included\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\":\"}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Spiral loops and swirl gestures\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Zig-zag dynamic movement paths\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Dotted and dashed trajectory lines\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Bold filled tips and cross-hatched focal pointers\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Curved annotation and callback arrows\"}]}]}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Best Used For\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\": Landing page annotations, hero section callouts, onboarding guides, creative portfolios, and informal UX wireframing.\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"System UI Series (200+ Icons)\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"A high-precision, geometric icon set crafted for modern software interfaces, app navigation, and structured web design.\"}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Style Aesthetics\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\": Pixel-aligned vector lines, uniform stroke widths, and consistent geometric proportions.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Variations Included\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\":\"}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Cardinal \u0026 Ordinal Directional Pointers (Up, Down, Left, Right, Diagonal)\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Interface Controls (Expand, Collapse, Return, Outbound)\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Data Sorting Indicators (Alphabetical A-Z, Numeric 0-1, Ascending/Descending)\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Alignment \u0026 Shift Arrows (Tab line anchors, swap indicators, dual-direction vectors)\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Minimal Chevrons \u0026 Carets\"}]}]}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Best Used For\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\": Web app navigation, dashboard controls, data tables, drop-down menus, button components, and design system utility libraries.\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Key Features\"}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Dual-Aesthetic Flexibility\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\": Switch seamlessly between relaxed, humanized graphics and formal, structured interface elements.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Vector Precision\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\": Crisp scaling across high-DPI displays without quality loss.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Fully Customizable\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\": Compatible with stroke width adjustments, custom color fills, and seamless integration into Framer components or Figma UI kits.\"}]}]}]},{\"type\":\"paragraph\"},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Need help?\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Have questions, need custom features, or want to share feedback? Reach out anytime at \"},{\"type\":\"text\",\"text\":\"karimsaif010@gmail.com\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"mailto:karimsaif010@gmail.com\",\"target\":\"_blank\"}},{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" or on X \"},{\"type\":\"mention\",\"attrs\":{\"id\":\"cdbd7ebc-86d4-4b64-baea-421f236c7c35\",\"slug\":\"karim-saif\",\"label\":\"Karim Saif\",\"mentionSuggestionChar\":\"@\"}},{\"type\":\"text\",\"text\":\" .\"}]}]},\"introduction\":\"Dual-style library\",\"slug\":\"arrows-hand-and-icon\",\"author\":{\"framerUserId\":\"cdbd7ebc-86d4-4b64-baea-421f236c7c35\",\"name\":\"Karim Saif\",\"slug\":\"karim-saif\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/38316/JKMR4LgEt-1ogBJEJjcXu0BLVSwyn9DCkQ64JbBx\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/cdbd7ebc-86d4-4b64-baea-421f236c7c35/019fdaf8-0f5d-748b-b492-91f9328a1ec2.png\",\"metadata\":{\"tint\":\"hsl(60 53% 39%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/cdbd7ebc-86d4-4b64-baea-421f236c7c35/019fdafd-a655-7051-8cdf-7b630e736a74.png\",\"metadata\":{\"tint\":\"hsl(60 90% 16%)\",\"aspectRatio\":1.3486111111111112}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/cdbd7ebc-86d4-4b64-baea-421f236c7c35/019fdafc-733d-766c-9911-7c6f8af6974d.png\",\"metadata\":{\"tint\":\"hsl(60 58% 37%)\",\"aspectRatio\":1.3509485094850948}}],\"post\":{\"id\":\"019fdafe-58b3-733f-92f5-e1a2052286f1\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"The Ultimate Vector \u0026 Sketch Duo\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\": \\\"Stop using generic navigation. Elevate your site with 230+ hand-sketched accents and pixel-perfect UI arrows.\"}]}]},\"likes\":{\"count\":6,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-08-07T06:52:09.296Z\",\"updatedAt\":\"2026-08-07T11:42:13.446Z\",\"publishedAt\":\"2026-08-07T06:52:09.289Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"vector\",\"attributes\":{\"url\":null,\"price\":\"5\",\"paymentUrl\":\"https://karimsaif.lemonsqueezy.com/checkout\",\"vectorCount\":350,\"categories\":[{\"id\":\"fa50aa41-372e-4622-9ef3-edf6db436dfe\",\"name\":\"Arrows\",\"slug\":\"arrows\"}]}},{\"id\":\"sX5zbq0yDMiHtoaDuFez\",\"resolved\":true,\"title\":\"Flowers\",\"body\":\"\u003cp\u003eA set of 30 geometric flower icons made on a 256×256 grid. The designs are clean and minimal, with shapes ranging from simple to playful. You can easily change the colors to match your project.\u003c/p\u003e\",\"bodyJson\":null,\"introduction\":\"A set of 30 simple, geometric flower icons. \",\"slug\":\"flowers\",\"author\":{\"framerUserId\":\"0cf4af4d-f636-4da9-b804-9f738baf7c2a\",\"name\":\"Monika\",\"slug\":\"monika-michalczyk\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/35550/avatar-JjDdxR7ifaF5ZFNWlqOtrnSmKM2jDR.jpg\",\"badges\":[\"framer\"],\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/vector-sets/flowers/vnhf1umo-czSStA1jZ2x4f4YU0J0TRhNY1swmQq\",\"metadata\":{\"tint\":\"hsl(266 89% 72%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/vector-sets/flowers/j8kbhx5c-2jAZpBaOJuSGp6WSfMWJCbjozCTjeO\",\"metadata\":{\"tint\":\"hsl(266 89% 72%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"01997bf8-0e63-7215-8a35-533bd09c13d5\",\"bodyJson\":null,\"likes\":{\"count\":40,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2025-09-24T10:32:54.913Z\",\"updatedAt\":\"2026-03-26T16:37:49.980Z\",\"publishedAt\":\"2025-09-24T13:44:38.243Z\",\"featuredAt\":\"2026-06-04T09:30:41.601Z\",\"reported\":false,\"approvedAt\":null,\"type\":\"vector\",\"attributes\":{\"url\":\"https://framer.com/m/Flower-1-pqpC.js@VG7qAdzYnTnjVN2aTXac\",\"price\":null,\"paymentUrl\":null,\"vectorCount\":30,\"categories\":[{\"id\":\"89c679b1-87fd-4d3a-830c-c029d9c86011\",\"name\":\"Shapes\",\"slug\":\"shapes\"}]}},{\"id\":\"5D13wKwRQyGDtETKnAky\",\"resolved\":true,\"title\":\"Japanese Obento Set\",\"body\":\"\u003cp\u003eThis “Japanese Obento Set” collection brings a heartwarming, home-style feel to your Framer projects.\u003c/p\u003e\u003cp\u003eEach icon captures the charming essence of everyday Japanese lunch boxes — from classic rice balls and crispy bites to sautéed spinach and flower-shaped carrots. Designed with a warm, homemade aesthetic, these illustrations are ideal for expressing your passion for food or adding a cozy, personal touch to your designs.\u003c/p\u003e\u003cp\u003eWhile drawing inspiration from Japanese home cooking, these icons are made with universal appeal. Whether you’re drawn to their delightful design, gentle colors, or simply love good food, I hope you’ll find your favorite among them.\u003c/p\u003e\",\"bodyJson\":null,\"introduction\":\"An illustration set inspired by homemade Japanese lunch boxes. Perfect for showcasing your favorite dishes or adding personality to your profile.\",\"slug\":\"japanese-obento-sets\",\"author\":{\"framerUserId\":\"d1dff73b-8bf5-4ebb-a23b-5332bada924d\",\"name\":\"日香理 / hikari\",\"slug\":\"hikari-template\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/492120/avatar-uytCLZVoEDDT5YrOh9eZuN2hFUQace.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/vector-sets/japanese-obento-sets/n4sttswb-dtu1kQFskYMeCouZMibye9Sw4ncFGH\",\"metadata\":{\"tint\":\"hsl(0 0% 9%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/vector-sets/japanese-obento-sets/q0bf0j09-YiHKSoylLzWIapig8N3QVLL6ScAmDR\",\"metadata\":{\"tint\":\"hsl(0 0% 9%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/vector-sets/japanese-obento-sets/b9voc3eh-qIYRGQ4ItBOVwDhDjvDPWigOcnqdMA\",\"metadata\":{\"tint\":\"hsl(0 0% 9%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/vector-sets/japanese-obento-sets/hialchkf-iyE869sQ7FPV4yDl9KgxnSkhyvrcfD\",\"metadata\":{\"tint\":\"hsl(0 0% 9%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"0199bdd5-a377-7f26-a3fb-00389af5a2b2\",\"bodyJson\":null,\"likes\":{\"count\":8,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2025-10-07T07:04:00.274Z\",\"updatedAt\":\"2025-11-12T02:12:41.789Z\",\"publishedAt\":\"2025-10-07T08:41:58.903Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"vector\",\"attributes\":{\"url\":null,\"price\":\"5\",\"paymentUrl\":\"https://hikari-graphics.lemonsqueezy.com/buy/654d752a-faa5-41c1-8621-55ae0ea690ad?discount=0\",\"vectorCount\":25,\"categories\":[{\"id\":\"7e6e2aca-859c-43af-a4c8-39e8d343ced6\",\"name\":\"Lifestyle\",\"slug\":\"lifestyle\"}]}},{\"id\":\"MTa9AI4XisdzH56Ch0Sp\",\"resolved\":true,\"title\":\"LogoMark\",\"body\":\"\u003cp\u003eModern Brand Logo Set is more than a collection of shapes. It’s a toolkit for imagination.Each logo mark is carefully designed with balance, simplicity, and versatility in mind, giving you endless ways to express your brand’s identity.\u003c/p\u003e\u003cp\u003eWhether you’re crafting a startup logo, designing a new product line, or experimenting with bold visual systems, these vectors are built to inspire.Clean lines, geometric harmony, and modern energy all ready to drop into your next Framer or Figma project.\u003c/p\u003e\",\"bodyJson\":null,\"introduction\":\"A bold, modern collection of geometric logo marks crafted to spark creativity and help you build timeless, standout brands.\",\"slug\":\"logomark\",\"author\":{\"framerUserId\":\"4b3a773d-065c-4edd-b489-790ae6cbb82e\",\"name\":\"HD Design\",\"slug\":\"hddesign\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/1142791/avatar-O68YHVSWjcTg7NToc7iBxCZY2nZ7UJ.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/vector-sets/logomark/sewenkxh-sagIeNjRkF6TfAEjiWvUWhiDH5SjFY\",\"metadata\":{\"tint\":\"hsl(0 0% 9%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/vector-sets/logomark/onlc31v5-9zdnLvCyxVhSdcPFIlJhdNH4CEbZrX\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019aa691-caf1-7aa5-8332-3d7d6df98953\",\"bodyJson\":null,\"likes\":{\"count\":39,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2025-11-13T12:22:01.779Z\",\"updatedAt\":\"2025-11-21T13:19:23.889Z\",\"publishedAt\":\"2025-11-21T13:19:23.889Z\",\"featuredAt\":\"2026-07-13T18:48:46.177Z\",\"reported\":false,\"approvedAt\":null,\"type\":\"vector\",\"attributes\":{\"url\":\"https://framer.com/m/Logo-mark-01-Tjnx.js@Q4HKFUmnv4WOmTudUO0c\",\"price\":null,\"paymentUrl\":null,\"vectorCount\":48,\"categories\":[{\"id\":\"fa19b5a7-a3be-4f68-9ba4-25800d07d1a3\",\"name\":\"Logos\",\"slug\":\"logos\"}]}},{\"id\":\"f81Z8PV3fcokKFawSvL0\",\"resolved\":true,\"title\":\"Verdant Folk Botanic\",\"body\":\"\u003cp\u003eVerdant Folk Botanicals is a collection of 12 decorative vector illustrations inspired by hand-drawn botanical doodles and traditional folk ornaments.\u003c/p\u003e\u003cp\u003eThe set features earthy green and brown tones with intricate leaves, flowers, curves, dots, and organic details. Each vector is scalable and suitable for websites, branding, packaging, invitations, social media, and editorial projects.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eIncluded:\u003c/strong\u003e 12 decorative botanical vectors Editable and scalable artwork Consistent folk-art style Earthy green and brown palette Ready to use in Framer\u003c/p\u003e\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Verdant Folk Botanicals is a collection of 12 decorative vector illustrations inspired by hand-drawn botanical doodles and traditional folk ornaments.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"The set features earthy green and brown tones with intricate leaves, flowers, curves, dots, and organic details. Each vector is scalable and suitable for websites, branding, packaging, invitations, social media, and editorial projects.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Included:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" 12 decorative botanical vectors Editable and scalable artwork Consistent folk-art style Earthy green and brown palette Ready to use in Framer\"}]}]},\"introduction\":\"12 decorative folk flower vectors\",\"slug\":\"verdant-folk-botanic\",\"author\":{\"framerUserId\":\"459d0622-8968-4406-9466-b4251fe0f4c7\",\"name\":\"Aniatun Lina\",\"slug\":\"aniatunlina\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/459d0622-8968-4406-9466-b4251fe0f4c7/pcmyntcc\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/459d0622-8968-4406-9466-b4251fe0f4c7/019fd080-de17-775d-b434-ca0fbedb21b0.png\",\"metadata\":{\"tint\":\"hsl(30 70% 49%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/459d0622-8968-4406-9466-b4251fe0f4c7/019fd081-1c02-75b8-be69-92a3a8e697e2.png\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":0.8934426229508197}}],\"post\":{\"id\":\"019fd083-8587-72af-80f7-dba202e09b77\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Verdant Folk Botanic is now available for free! A collection of 12 decorative folk flower vectors in earthy green and brown tones, ready to use in your Framer projects.\"}]}]},\"likes\":{\"count\":9,\"liked\":false},\"comments\":{\"count\":4},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-08-05T06:01:47.730Z\",\"updatedAt\":\"2026-08-05T06:01:47.730Z\",\"publishedAt\":\"2026-08-05T06:01:47.723Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"vector\",\"attributes\":{\"url\":\"https://framer.com/m/folk-flower-1-PEi5k3.js@EESSzY58bjCwdNI29POY\",\"price\":null,\"paymentUrl\":null,\"vectorCount\":12,\"categories\":[{\"id\":\"78e55a4a-220e-474c-9a7f-690f940cb1de\",\"name\":\"Illustrations\",\"slug\":\"illustrations\"}]}},{\"id\":\"l7LQpy7mF3Hk3BoIuIxx\",\"resolved\":true,\"title\":\"Winter Xmas Set\",\"body\":\"\u003cp\u003eThe Winter Xmas Set includes vector elements such as snowflakes, stockings, bells, candles, and gift boxes. Each element has variable color settings, so you can easily adjust the colors to match your design. They look cute when used small like emojis, or fun as large decorative elements falling from above.\u003c/p\u003e\",\"bodyJson\":null,\"introduction\":\"A cheerful and cozy holiday-themed set to add a festive touch to your Framer projects—perfect for winter campaigns, Christmas pages, or any project that needs a warm, joyful vibe.\",\"slug\":\"winter-xmas-set\",\"author\":{\"framerUserId\":\"d1dff73b-8bf5-4ebb-a23b-5332bada924d\",\"name\":\"日香理 / hikari\",\"slug\":\"hikari-template\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/492120/avatar-uytCLZVoEDDT5YrOh9eZuN2hFUQace.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/vector-sets/winter-xmas-set/jvsiruuq-s4JSJfni4pIYZ08V0apSK5ycjsmFov\",\"metadata\":{\"tint\":\"hsl(0 0% 9%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/vector-sets/winter-xmas-set/g9js7f17-lI3WlyWHeckCNXtEwrsKIWUEqQcYJA\",\"metadata\":{\"tint\":\"hsl(0 0% 9%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/vector-sets/winter-xmas-set/mbplb8xq-LRDFiebEPHoTMdZxv95X0s7JbBiVY0\",\"metadata\":{\"tint\":\"hsl(0 0% 9%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/vector-sets/winter-xmas-set/h42inhdz-xDdCLsoyB559tWLIPj8jsiX7Knb7ir\",\"metadata\":{\"tint\":\"hsl(0 0% 9%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019aa648-8ba5-75e9-8c53-2a1ab699884b\",\"bodyJson\":null,\"likes\":{\"count\":9,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2025-11-13T13:18:01.748Z\",\"updatedAt\":\"2025-1