ks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Bento Geo is a precision-built collection of geometric UI icons crafted for modern product, dashboard, and marketing interfaces.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"rocket\",\"emoji\":\"🚀\"}},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"Now available for your next Framer project!\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Ship intentional, pixel-clean designs without hunting for matching assets or redrawing shapes by hand. Drawn on a strict grid with perfectly balanced stroke weights, these glyphs sit beautifully whether scaled up in a massive hero section or tucked into a compact toolbar.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Key Features: \"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"triangular_ruler\",\"emoji\":\"📐\"}},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"Precision Grid:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Consistent stroke weights and balanced geometry for a unified aesthetic \"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"art\",\"emoji\":\"🎨\"}},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"Native Framer Integration:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Inserts instantly and automatically inherits your color styles \"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"jigsaw\",\"emoji\":\"🧩\"}},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"Comprehensive Coverage:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Essential glyphs for navigation, actions, media, status, and layouts \"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"iphone\",\"emoji\":\"📱\"}},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"Flawlessly Scalable:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Aligned optical sizing and pixel-clean corners across all device sizes\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Need help integrating these into your design system or setting things up? Reach out at \"},{\"type\":\"text\",\"text\":\"abdulsamiwd2025@gmail.com\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"mailto:abdulsamiwd2025@gmail.com\",\"target\":\"_blank\"}}]},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"emoji\",\"attrs\":{\"name\":\"envelope\",\"emoji\":\"✉\"}}]}]},\"introduction\":\"Clean geometric UI icon set\",\"slug\":\"bento-ui\",\"author\":{\"framerUserId\":\"2f652dd9-4e10-4c34-aef3-a9c89b31968a\",\"name\":\"Lumina Studio\",\"slug\":\"lumina-studio25\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/2f652dd9-4e10-4c34-aef3-a9c89b31968a/3qux5c0u\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/2f652dd9-4e10-4c34-aef3-a9c89b31968a/01a03250-0f9f-751b-a09d-866fd36010f2.png\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.6733333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/2f652dd9-4e10-4c34-aef3-a9c89b31968a/01a03250-28e3-721f-a291-c126004367d4.png\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":0.7218376337319069}}],\"post\":{\"id\":\"01a03251-3e61-751e-92d8-d9c10da8be2f\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"sparkles\",\"emoji\":\"✨\"}},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"Make your UI feel as sharp as it looks!\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Bento Geo is a precision geometric icon set built natively for Framer.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"rocket\",\"emoji\":\"🚀\"}},{\"type\":\"text\",\"text\":\" Scale cleanly from hero to toolbar!\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Grid-aligned, balanced strokes, and pixel-clean corners for nav, media \u0026 layouts. Inserts instantly and inherits your color styles.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Need help setting this up? Reach out at \"},{\"type\":\"text\",\"text\":\"abdulsamiwd2025@gmail.com\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"mailto:abdulsamiwd2025@gmail.com\",\"target\":\"_blank\"}}]},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"emoji\",\"attrs\":{\"name\":\"envelope\",\"emoji\":\"✉\"}}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Live Preview\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"https://bentoui2.framer.website/\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"https://bentoui2.framer.website/\",\"target\":\"_blank\"}}]}]}]},\"likes\":{\"count\":7,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-08-24T05:49:39.825Z\",\"updatedAt\":\"2026-08-24T05:49:39.825Z\",\"publishedAt\":\"2026-08-24T05:49:39.816Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"vector\",\"attributes\":{\"url\":\"https://framer.com/m/Star-4-Point-Outline-CgjKpT.js@ojn1Q9d4pEnYe3aqgAP5\",\"price\":null,\"paymentUrl\":null,\"vectorCount\":12,\"categories\":[{\"id\":\"84561d79-3c93-47b8-88cc-3ecfa4a60f69\",\"name\":\"UI\",\"slug\":\"ui\"}]}},{\"id\":\"LADAzfmo4mdxLvH80ha5\",\"resolved\":true,\"title\":\"Geometric icon 3\",\"body\":\"$64\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Geometric Shapes Icon Volume 3\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Designed by\"},{\"type\":\"text\",\"text\":\" Nazcraft\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Ideal Use Cases:\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Brand Identity \u0026 Logos:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Craft memorable, tech-forward logos and brand marks.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Posters \u0026 Typography:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Build striking, brutalist-inspired posters and music artwork.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"UI/UX \u0026 Web Design:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Integrate unique, modern iconography into app interfaces and digital platforms.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Merchandise \u0026 Packaging:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Perfect for streetwear graphics, skateboard decks, and tech product packaging.\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Streamline your workflow and inject a clean, structural, and modern aesthetic into your next creative project with this essential vector toolkit!\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Need Help?\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"If you have any questions, trouble downloading your files, or need an invoice, just reply directly to this email or reach out to us at \"},{\"type\":\"text\",\"text\":\"zainanazlan@gmail.com\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"mailto:zainanazlan@gmail.com\",\"target\":\"_blank\"}}]}]}]},\"introduction\":\"Geometric Shapes Icon Volume 3\",\"slug\":\"geometric-icon-3\",\"author\":{\"framerUserId\":\"1a4098c4-0348-45f8-9f4d-8f202e62643a\",\"name\":\"Nazlan Zaina\",\"slug\":\"nazlanzaina\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/1a4098c4-0348-45f8-9f4d-8f202e62643a/wpqraad4\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/1a4098c4-0348-45f8-9f4d-8f202e62643a/019f68e0-5ebd-705f-bdd1-eb673805e565.png\",\"metadata\":{\"tint\":\"hsl(60 53% 39%)\",\"aspectRatio\":1.8380241240666284}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/1a4098c4-0348-45f8-9f4d-8f202e62643a/019f68e0-7c07-7673-b711-a891cc7aa83f.png\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.8380241240666284}}],\"post\":{\"id\":\"019f68e0-c76d-729e-b89c-e8907ac1806f\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Geometric Shapes Icon Volume 3\",\"marks\":[{\"type\":\"bold\"}]}]}]},\"likes\":{\"count\":4,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-07-16T03:03:09.077Z\",\"updatedAt\":\"2026-07-16T03:03:09.077Z\",\"publishedAt\":\"2026-07-16T03:03:09.075Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"vector\",\"attributes\":{\"url\":null,\"price\":\"1\",\"paymentUrl\":\"https://nazcraft.lemonsqueezy.com/checkout/buy/dd5a494e-6d8f-4438-b438-75ba88c7845d\",\"vectorCount\":2,\"categories\":[{\"id\":\"3535507e-b041-4f48-be7f-a084b14e30b2\",\"name\":\"Icons\",\"slug\":\"icons\"}]}},{\"id\":\"9EVecKkmV5Nw3k5KrRAa\",\"resolved\":true,\"title\":\"Ionicons\",\"body\":\"\u003cp\u003eThis refined icon collection is inspired by the clean and modern aesthetic of Ionicons, designed with clarity and precision at its core. Each symbol balances simplicity with geometry, resulting in a cohesive visual language that feels at home in modern interfaces. With sharp vectors and consistent rhythm, these icons adapt effortlessly to light or dark themes, bold brands, and minimalist compositions alike. Perfect for crafting clean UI designs, prototypes, and polished digital experiences.\u003c/p\u003e\u003ch2\u003eAttribution\u003c/h2\u003e\u003cp\u003eThese icons are licensed under the MIT License.\u003c/p\u003e\u003cp\u003eCopyright \u003cspan data-type=\\\"emoji\\\" data-name=\\\"copyright\\\"\u003e©\u003c/span\u003e Ionic.\u003c/p\u003e\u003cp\u003ePermission is hereby granted, free of charge, to use, copy, modify, and distribute these icons, provided that this notice and the license text are included in all copies or substantial portions of the icons.\u003c/p\u003e\u003cp\u003eOriginal project: \u003ca href=\\\"https://ionic.io/ionicons\\\" rel=\\\"noopener noreferrer nofollow\\\" target=\\\"_blank\\\"\u003ehttps://ionic.io/ionicons\u003c/a\u003e\u003c/p\u003e\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"This refined icon collection is inspired by the clean and modern aesthetic of Ionicons, designed with clarity and precision at its core. Each symbol balances simplicity with geometry, resulting in a cohesive visual language that feels at home in modern interfaces. With sharp vectors and consistent rhythm, these icons adapt effortlessly to light or dark themes, bold brands, and minimalist compositions alike. Perfect for crafting clean UI designs, prototypes, and polished digital experiences.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Attribution\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\