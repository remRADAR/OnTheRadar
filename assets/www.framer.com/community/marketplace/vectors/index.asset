\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/8a3c74b3-2623-4203-b165-fd6d81c9e134/019fd729-8eaf-74d5-ba20-6b7e77ead147.png\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.499531396438613}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/8a3c74b3-2623-4203-b165-fd6d81c9e134/019fd729-8da3-74ed-8368-4e84cc43643b.png\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.499531396438613}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/8a3c74b3-2623-4203-b165-fd6d81c9e134/019fd729-8e68-7149-abed-2bbb48bd246e.png\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.499531396438613}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/8a3c74b3-2623-4203-b165-fd6d81c9e134/019fd729-8e3a-756b-8eb8-f099955ff058.png\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.499531396438613}}],\"post\":{\"id\":\"019fd727-4012-745e-b0f4-d2e4798d6e45\",\"bodyJson\":null,\"likes\":{\"count\":8,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-08-06T12:58:21.048Z\",\"updatedAt\":\"2026-08-06T13:13:19.988Z\",\"publishedAt\":\"2026-08-06T12:58:21.043Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"vector\",\"attributes\":{\"url\":null,\"price\":\"29\",\"paymentUrl\":\"https://brickclay.gumroad.com/l/2000-Isometric-Icons-Set?layout=profile\",\"vectorCount\":4013,\"categories\":[{\"id\":\"3535507e-b041-4f48-be7f-a084b14e30b2\",\"name\":\"Icons\",\"slug\":\"icons\"}]}},{\"id\":\"cFbLgqXzjl0nKi1y0oLd\",\"resolved\":true,\"title\":\"Cool Shapes\",\"body\":\"\u003ch2\u003eAbout these Vectors\u003c/h2\u003e\u003cp\u003eCool Shapes is a versatile vector set curated for use in Framer. \u003cstrong\u003eBold, minimal shapes\u003c/strong\u003e designed to inject character into any creative project. This versatile vector collection is perfect for use as \u003cstrong\u003elogo bases, striking graphic elements, UI masks, or digital stickers\u003c/strong\u003e. Every asset is \u003cstrong\u003eclean, scalable, and fully adaptable\u003c/strong\u003e for high-impact use in web design, corporate branding, or dynamic motion graphics.\u003c/p\u003e\",\"bodyJson\":null,\"introduction\":\"A clean collection of geometric and organic shapes for colored gradient layouts and solid white monochrome.\",\"slug\":\"cool-shapes\",\"author\":{\"framerUserId\":\"17a29a78-9597-44c5-b438-6b9e6f2028f1\",\"name\":\"Sandy\",\"slug\":\"sandyuiux\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/260792/avatar-er79IieurSSuYOVhpWUOmSMPcrNeWD.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/vector-sets/cool-shapes/l1dvhizi-PT2O9ppasUvzXHvquegnYyPnylzpL9\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/vector-sets/cool-shapes/4anr2hk8-RozCHTuCkMvBcFjBfD8kFDGJVtfmbu\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019b0efb-6ad4-7b4c-96fd-ae7f9f46f633\",\"bodyJson\":null,\"likes\":{\"count\":59,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2025-10-23T04:49:31.203Z\",\"updatedAt\":\"2025-12-11T19:55:16.564Z\",\"publishedAt\":\"2025-12-11T19:55:16.564Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"vector\",\"attributes\":{\"url\":\"https://framer.com/m/Shape-1-MqNV.js@lGQoDsvgHtCZr8V34wMt\",\"price\":null,\"paymentUrl\":null,\"vectorCount\":78,\"categories\":[{\"id\":\"89c679b1-87fd-4d3a-830c-c029d9c86011\",\"name\":\"Shapes\",\"slug\":\"shapes\"}]}},{\"id\":\"CqbSWvKlzHVT6APLhtlm\",\"resolved\":true,\"title\":\"Cyan Folk Ornament\",\"body\":\"\u003cp\u003eA bold ornamental vector inspired by hand-drawn paisley, botanical curves, flowing leaves, and folk-style details.\u003c/p\u003e\u003cp\u003eBuilt with clean, scalable vector shapes that are easy to resize, recolor, and customize directly in Framer.\u003c/p\u003e\u003cp\u003ePerfect for hero sections, website decorations, branding, posters, packaging, social graphics, invitations, and decorative compositions.\u003c/p\u003e\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"A bold ornamental vector inspired by hand-drawn paisley, botanical curves, flowing leaves, and folk-style details.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Built with clean, scalable vector shapes that are easy to resize, recolor, and customize directly in Framer.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Perfect for hero sections, website decorations, branding, posters, packaging, social graphics, invitations, and decorative compositions.\"}]}]},\"introduction\":\"Ornamental Paisley Vector Motifs\",\"slug\":\"cyan-folk-ornament\",\"author\":{\"framerUserId\":\"459d0622-8968-4406-9466-b4251fe0f4c7\",\"name\":\"Aniatun Lina\",\"slug\":\"aniatunlina\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/459d0622-8968-4406-9466-b4251fe0f4c7/pcmyntcc\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/459d0622-8968-4406-9466-b4251fe0f4c7/019ff53f-fcbc-776c-9ae7-a86291a0ea1f.png\",\"metadata\":{\"tint\":\"hsl(60 53% 39%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/459d0622-8968-4406-9466-b4251fe0f4c7/019ff540-39d4-765d-a830-9c5fd29cdc6a.png\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.084076433121019}}],\"post\":{\"id\":\"019ff544-2259-730c-b4ca-6ae82e1362e3\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Just launched \"},{\"type\":\"text\",\"text\":\"Cyan Folk Ornament\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\"✦\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"A bold paisley-inspired vector with flowing botanical shapes, folk details, and a vibrant Electric Cyan finish.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Scalable, editable, and easy to recolor in Framer, perfect for hero sections, branding, posters, packaging, and decorative layouts.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Available now on Framer Marketplace.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"#Framer #FramerMarketplace #VectorDesign #Paisley #Ornament #GraphicDesign #DigitalAssets\"}]}]},\"likes\":{\"count\":9,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-08-12T09:18:30.529Z\",\"updatedAt\":\"2026-08-12T09:18:30.529Z\",\"publishedAt\":\"2026-08-12T09:18:30.524Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"vector\",\"attributes\":{\"url\":null,\"price\":\"5\",\"paymentUrl\":\"https://aniatunlina.lemonsqueezy.com/checkout/buy/69bd14e4-0272-457c-896f-8970d172304a\",\"vectorCount\":1,\"categories\":[{\"id\":\"89c679b1-87fd-4d3a-830c-c029d9c86011\",\"name\":\"Shapes\",\"slug\":\"shapes\"}]}},{\"id\":\"VIuQj5PKim8nlIb47VsD\",\"resolved\":true,\"title\":\"Text Highliters\",\"body\":\"\u003cp\u003e\u003cstrong\u003eText Highlighters Pack\u003c/strong\u003e is a curated collection of hand-drawn vector accents designed to bring clarity, emphasis, and personality to your Framer projects. Each element is crafted as a bold visual marker: underlines, strokes, swirls, brackets, circles, and freeform highlights that make key words\u003cstrong\u003e \u003c/strong\u003eor ideas stand out instantly.\u003c/p\u003e\u003cp\u003ePerfect for landing pages, presentations, case studies, or editorial layouts, these highlighters add a human, energetic rhythm to otherwise static text blocks.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eIdeal for:\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e• Emphasizing headlines\u003c/p\u003e\u003cp\u003e• Enhancing hero sections\u003c/p\u003e\u003cp\u003e• Creating editorial-style callouts\u003c/p\u003e\u003cp\u003e• Annotating UI/UX case studies\u003c/p\u003e\u003cp\u003e• Adding human texture to digital compositions\u003c/p\u003e\u003cp\u003eFeel free to contact if any quaestions: HiHelenSay@gmail.com\u003c/p\u003e\",\"bodyJson\":null,\"introduction\":\"A set of hand-drawn vector highlighter for text decoration.\",\"slug\":\"text-highliters\",\"author\":{\"framerUserId\":\"5e9178ac-0cf1-46cd-ab75-b55e8e406d28\",\"name\":\"Helen Statsevich\",\"slug\":\"helen-st\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/5e9178ac-0cf1-46cd-ab75-b55e8e406d28/rpwevai5\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/vector-sets/text-highliters/7c6rrujs-kRMseCgCPsv2misiuwwyoTZwFLZPOs\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/vector-sets/text-highliters/du5an584-1NO2eWsXJuXkGWIGHOuFQKsktvbkVR\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019ab65a-f035-7d94-b5f5-33d7bcaa1062\",\"bodyJson\":null,\"likes\":{\"count\":42,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2025-11-13T14:32:28.958Z\",\"updatedAt\":\"2025-11-24T14:53:24.405Z\",\"publishedAt\":\"2025-11-24T14:5