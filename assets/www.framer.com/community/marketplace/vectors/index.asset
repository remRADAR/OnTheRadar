33333333333}}],\"post\":{\"id\":\"019a6da5-49f1-7413-a7cb-9119864d87ab\",\"bodyJson\":null,\"likes\":{\"count\":7,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2025-10-09T12:31:31.731Z\",\"updatedAt\":\"2025-11-10T12:02:20.273Z\",\"publishedAt\":\"2025-11-10T12:02:20.273Z\",\"featuredAt\":\"2026-07-13T18:48:53.475Z\",\"reported\":false,\"approvedAt\":null,\"type\":\"vector\",\"attributes\":{\"url\":null,\"price\":\"1\",\"paymentUrl\":\"https://buy.polar.sh/polar_cl_PENvZ4lSWc0GFEsCEZJybBAeDwNDJ64remWNT0OESo6\",\"vectorCount\":49,\"categories\":[{\"id\":\"65fa91ad-4375-40c0-8b72-1cc71f2f4000\",\"name\":\"Business\",\"slug\":\"business\"}]}},{\"id\":\"aGKN8xrowdTSriUPm2gx\",\"resolved\":true,\"title\":\"Professional Leader\",\"body\":\"$5e\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Bring confidence, leadership, and professional excellence to your business projects with the \"},{\"type\":\"text\",\"text\":\"Professional Leader Illustration Set\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\". This collection features beautifully crafted vector illustrations designed to showcase leadership, team management, decision-making, mentoring, strategic planning, and workplace collaboration through clean and modern visuals.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Perfect for Framer websites, corporate platforms, leadership training programs, HR solutions, consulting services, startup websites, business dashboards, and company landing pages, these illustrations are fully scalable, lightweight, and easy to customize. Each illustration is designed with a modern, professional style that seamlessly fits contemporary websites and digital products.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Features:\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"High-quality editable vector illustrations\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Modern, clean, and professional designs\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Perfect for leadership, management, and business projects\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Easy to customize colors and design elements\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Optimized for Framer projects and components\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Fully scalable without losing quality\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Suitable for websites, mobile apps, presentations, dashboards, and marketing materials\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Whether you're showcasing executive leadership, team management, business strategy, workplace collaboration, mentoring, organizational growth, professional development, or decision-making, the \"},{\"type\":\"text\",\"text\":\"Professional Leader Illustration Set\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" helps create engaging visual experiences that communicate confidence, authority, and effective leadership.\"}]}]},\"introduction\":\"Professional Leadership\",\"slug\":\"professional-leader\",\"author\":{\"framerUserId\":\"154d0636-e767-4df5-9f36-6ac0c379b611\",\"name\":\"Cursoria Studio\",\"slug\":\"cursoria-studio\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/2581207/4DdSlH6iy-R0vaAObimz4xJKd8uMqz7kychAYLv4\",\"followed\":fa