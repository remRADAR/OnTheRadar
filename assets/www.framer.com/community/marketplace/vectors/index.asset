,\"vectorCount\":4,\"categories\":[{\"id\":\"fa50aa41-372e-4622-9ef3-edf6db436dfe\",\"name\":\"Arrows\",\"slug\":\"arrows\"}]}},{\"id\":\"41ffqiy967HQKb4gZ7PN\",\"resolved\":true,\"title\":\"Strategy Icon Set\",\"body\":\"\u003cp\u003eThis icon is your choice for mobile apps or websites and is very compatible.\u003c/p\u003e\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"This icon is your choice for mobile apps or websites and is very compatible.\"}]}]},\"introduction\":\"Strategy Icon Set\",\"slug\":\"strategy-icon-set\",\"author\":{\"framerUserId\":\"1440e4a2-8652-476d-99d8-ff659c92ba2e\",\"name\":\"Loka Tara\",\"slug\":\"loka-tara\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/1440e4a2-8652-476d-99d8-ff659c92ba2e/q37owu63\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/1440e4a2-8652-476d-99d8-ff659c92ba2e/wn3hiw47\",\"metadata\":{\"tint\":\"hsl(0 0% 9%)\",\"aspectRatio\":1.0678733031674208}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/1440e4a2-8652-476d-99d8-ff659c92ba2e/2jv2w6t5\",\"metadata\":{\"tint\":\"hsl(0 0% 9%)\",\"aspectRatio\":1.0678733031674208}}],\"post\":{\"id\":\"019f1f7b-d7e9-7509-849d-c6267cb69401\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"STRATEGY ICON SET FOR MOBILE APP AND WEBSITE. This icon is your choice for mobile apps or websites and is very compatible.\"}]}]},\"likes\":{\"count\":6,\"liked\":false},\"comments\":{\"count\":2},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-07-01T21:00:37.679Z\",\"updatedAt\":\"2026-07-01T21:00:37.679Z\",\"publishedAt\":\"2026-07-01T21:00:37.673Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"vector\",\"attributes\":{\"url\":null,\"price\":\"3\",\"paymentUrl\":\"https://lokatara.lemonsqueezy.com/checkout/buy/fbd3f419-52e6-42be-a5a0-36e273dfeb8a\",\"vectorCount\":9,\"categories\":[{\"id\":\"3535507e-b041-4f48-be7f-a084b14e30b2\",\"name\":\"Icons\",\"slug\":\"icons\"}]}},{\"id\":\"GVXv0rF6TrynQo9Z0LRz\",\"resolved\":true,\"title\":\"Brutalist Icon Vol.6\",\"body\":\"$6c\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Brutalist Geometric Seamless Icon Shapes Volume 6\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Designed by \"},{\"type\":\"text\",\"text\":\"Nazcraft\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Key Design Elements:\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Aesthetic Style:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" The collection leans heavily into brutalist, Y2K, retro-futuristic, and techno-industrial design aesthetics.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Shape Variety:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" The grid features a diverse array of optical illusions, impossible objects, sharp tribal-style spikes, and concentric geometric spirals.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Line Work:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" The structures are built using incredibly clean and precise linework. They range from bold, heavy, solid geometric blocks to intricate, fine-line wireframe constructions.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Standout Motifs:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Abstract multi-pointed stars, mesmerizing swirling vortexes, interconnected circular loops, isometric perspective grids, a linear heart shape, and a stylized, geometric recycling symbol.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Symmetry and Op-Art:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Many of the shapes rely on radial symmetry and optical art techniques, using repeating lines to create a sense of depth, motion, or 3D tunneling effects.\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Need Help?\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"If you have any questions, trouble downloading your files, or need an invoice, just reply directly to this email or reach out to us at \"},{\"type\":\"text\",\"text\":\"zainanazlan@gmail.com\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"mailto:zainanazlan@gmail.com\",\"target\":\"_blank\"}}]}]}]},\"introduction\":\"Brutalist Geometric Seamless Icon\",\"slug\":\"brutalist-icon-vol-6\",\"author\":{\"framerUserId\":\"1a4098c4-0348-45f8-9f4d-8f202e62643a\",\"name\":\"Nazlan Zaina\",\"slug\":\"nazlanzaina\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/1a4098c4-0348-45f8-9f4d-8f202e62643a/wpqraad4\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/1a4098c4-0348-45f8-9f4d-8f202e62643a/019f6543-f850-70cd-92db-8d558eac602f.png\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.2403100775193798}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/1a4098c4-0348-45f8-9f4d-8f202e62643a/019f6543-b78a-72ba-8289-866e0967c418.png\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.2930253623188406}},{\"type\":\"image\",\"url\":\"https://y4pdgn