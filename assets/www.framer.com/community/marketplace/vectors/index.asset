:\"2025-10-07T12:38:36.701Z\",\"publishedAt\":\"2025-10-07T12:34:52.339Z\",\"featuredAt\":\"2026-06-04T10:00:11.692Z\",\"reported\":false,\"approvedAt\":null,\"type\":\"vector\",\"attributes\":{\"url\":\"https://framer.com/m/coolicons-Neob.js@mtFd1ZKylj6geIjrOcaM\",\"price\":null,\"paymentUrl\":null,\"vectorCount\":443,\"categories\":[{\"id\":\"3535507e-b041-4f48-be7f-a084b14e30b2\",\"name\":\"Icons\",\"slug\":\"icons\"}]}},{\"id\":\"jBfSD2zJPMrOcVgFjzv8\",\"resolved\":true,\"title\":\"Doodles UI\",\"body\":\"$50\",\"bodyJson\":null,\"introduction\":\"A friendly set of 64 hand-drawn SVG doodles to add human warmth to product pages, onboarding, and slides. These marks keep things playful without getting messy: clean single-stroke\",\"slug\":\"doodles-ui\",\"author\":{\"framerUserId\":\"5e9178ac-0cf1-46cd-ab75-b55e8e406d28\",\"name\":\"Helen Statsevich\",\"slug\":\"helen-st\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/5e9178ac-0cf1-46cd-ab75-b55e8e406d28/rpwevai5\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/vector-sets/doodles-ui/m3yehmyn-vwKLvE4mawvojRpkHdxXou6P9UwDDB\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/vector-sets/doodles-ui/ti00km8t-FuRoDjTDsZ1EnyIEksM9784CoYwgyM\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019aa737-57d7-7382-b882-8d2741ec9d41\",\"bodyJson\":null,\"likes\":{\"count\":90,\"liked\":false},\"comments\":{\"count\":2},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2025-11-13T13:56:50.230Z\",\"updatedAt\":\"2025-11-21T16:20:13.399Z\",\"publishedAt\":\"2025-11-21T16:20:13.399Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"vector\",\"attributes\":{\"url\":\"https://framer.com/m/Carrot-01-e2OB.js@VtVFLB30d6pwrGZ6iCjV\",\"price\":null,\"paymentUrl\":null,\"vectorCount\":64,\"categories\":[{\"id\":\"78e55a4a-220e-474c-9a7f-690f940cb1de\",\"name\":\"Illustrations\",\"slug\":\"illustrations\"}]}},{\"id\":\"vPLNDr3ycgHlQj03H0jg\",\"resolved\":true,\"title\":\"Futuristic/Y2K\",\"body\":\"\u003cp\u003eA collection of modern abstract vector icons featuring futuristic, geometric, and cyber-inspired elements. The set includes orbital shapes, sparkling stars, crescent moons, wireframe globes, distorted grids, concentric squares, halftone gradients, circular patterns, and minimalist line art. Designed with a sleek purple-on-black color palette, these symbols are perfect for tech branding, digital products, UI/UX design, social media graphics, posters, apparel, and contemporary visual identities. The aesthetic blends Y2K, sci-fi, space, and geometric design trends to create a clean, modern, and innovative look.\u003c/p\u003e\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"A collection of modern abstract vector icons featuring futuristic, geometric, and cyber-inspired elements. The set includes orbital shapes, sparkling stars, crescent moons, wireframe globes, distorted grids, concentric squares, halftone gradients, circular patterns, and minimalist line art. Designed with a sleek purple-on-black color palette, these symbols are perfect for tech branding, digital products, UI/UX design, social media graphics, posters, apparel, and contemporary visual identities. The aesthetic blends Y2K, sci-fi, space, and geometric design trends to create a clean, modern, and innovative look.\"}]}]},\"introduction\":\"Icon Futuristic/Y2K\",\"slug\":\"futuristic-y2k\",\"author\":{\"framerUserId\":\"dde1b40e-11ff-49b4-85c4-7541f0e952cf\",\"name\":\"Uta Labs\",\"slug\":\"uta-labs\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/dde1b40e-11ff-49b4-85c4-7541f0e952cf/gl32m4ku\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/dde1b40e-11ff-49b4-85c4-7541f0e952cf/j6ef942y\",\"metadata\":{\"tint\":\"hsl(270 87% 71%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/dde1b40e-11ff-49b4-85c4-7541f0e952cf/rpqwszfc\",\"metadata\":{\"tint\":\"hsl(270 87% 71%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019efdb5-65ab-710b-8525-3b9f07936e9a\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Icon Futuristic/Y2K \"}]}]},\"likes\":{\"count\":34,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-06-25T07:36:24.192Z\",\"updatedAt\":\"2026-06-25T08:12:24.539Z\",\"publishedAt\":\"2026-06-25T07:36:24.183Z\",\"featuredAt\":\"2026-07-13T18:47:54.623Z\",\"reported\":false,\"approvedAt\":null,\"type\":\"vector\",\"attributes\":{\"url\":null,\"price\":\"5\",\"paymentUrl\":\"https://www.paypal.com/paypalme/utalabs\",\"vectorCount\":15,\"categories\":[{\"id\":\"3535507e-b041-4f48-be7f-a084b14e30b2\",\"name\":\"Icons\",\"slug\":\"icons\"}]}},{\"id\":\"pHpkxn18WEBGYliifCrc\",\"resolved\":true,\"title\":\"Doodles \u0026 Scribbles\",\"body\":\"\u003cp\u003eA collection of simple, expressive doodles including lines, arrows, stars, bursts, and swirls. Perfect for adding energy, emphasis, or a casual feel to your designs.\u003c/p\u003e\",\"bodyJson\":null,\"introduction\":\"Hand-drawn vector doodle set.\",\"slug\":\"doodles-scribbles\",\"author\":{\"framerUserId\":\"0cf4af4d-f636-4da9-b804-9f738baf7c2a\",\"name\":\"Monika\",\"slug\":\"monika-michalczyk\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/35550/avatar-JjDdxR7ifaF5ZFNWlqOtrnSmKM2jDR.jpg\",\"badges\":[\"framer\"],\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\