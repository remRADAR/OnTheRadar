/immutable/chunks/3jpuro209qqra.js\",\"/creators-assets/_next/static/immutable/chunks/2ul6havqzfm41.js\",\"/creators-assets/_next/static/immutable/chunks/0c6romi9ma0is.js\",\"/creators-assets/_next/static/immutable/chunks/1jubx4t_1hq7l.js\",\"/creators-assets/_next/static/immutable/chunks/30hhj9fl_j_en.js\",\"/creators-assets/_next/static/immutable/chunks/2ouyrs2yz196q.js\",\"/creators-assets/_next/static/immutable/chunks/33adfll0sgxzj.js\",\"/creators-assets/_next/static/immutable/chunks/2504rifrkrd_l.js\",\"/creators-assets/_next/static/immutable/chunks/3orcs6a8eyfvz.js\",\"/creators-assets/_next/static/immutable/chunks/14pxn0b6e1dc9.js\",\"/creators-assets/_next/static/immutable/chunks/3n0g19afc7srh.js\",\"/creators-assets/_next/static/immutable/chunks/41zrh_r6fdtfq.js\",\"/creators-assets/_next/static/immutable/chunks/120zfy8hqrcwf.js\",\"/creators-assets/_next/static/immutable/chunks/1_2vu9p6mra4j.js\",\"/creators-assets/_next/static/immutable/chunks/3zq_69yv5l6lg.js\",\"/creators-assets/_next/static/immutable/chunks/3-tcb9ouhlqkm.js\",\"/creators-assets/_next/static/immutable/chunks/37uei1iwbnu3m.js\",\"/creators-assets/_next/static/immutable/chunks/17w9c6wazundy.js\",\"/creators-assets/_next/static/immutable/chunks/1u1uuj9mj0hoo.js\",\"/creators-assets/_next/static/immutable/chunks/1fo1h_o5odhhk.js\",\"/creators-assets/_next/static/immutable/chunks/102lphbyhyqtr.js\",\"/creators-assets/_next/static/immutable/chunks/3o3dwck1w1ue6.js\",\"/creators-assets/_next/static/immutable/chunks/1zpmt8l695i6d.js\",\"/creators-assets/_next/static/immutable/chunks/44oc0x6k7mw-i.js\",\"/creators-assets/_next/static/immutable/chunks/3o1z26bd2_9eh.js\",\"/creators-assets/_next/static/immutable/chunks/2rwbpl35w01v4.js\",\"/creators-assets/_next/static/immutable/chunks/19-jcjdymr-fa.js\",\"/creators-assets/_next/static/immutable/chunks/19r4rf2zyng-y.js\",\"/creators-assets/_next/static/immutable/chunks/1p31g3z3kho5v.js\",\"/creators-assets/_next/static/immutable/chunks/2qeyp4zfa4qwb.js\",\"/creators-assets/_next/static/immutable/chunks/3sj_xp-v1_jxx.js\",\"/creators-assets/_next/static/immutable/chunks/2njnkxjf39nsf.js\",\"/creators-assets/_next/static/immutable/chunks/0ph1ht6wvel_v.js\",\"/creators-assets/_next/static/immutable/chunks/2zfre20tirh12.js\",\"/creators-assets/_next/static/immutable/chunks/05i2jce8amocn.js\",\"/creators-assets/_next/static/immutable/chunks/0v-er0xp5q011.js\",\"/creators-assets/_next/static/immutable/chunks/2rn8ri2u5wuca.js\",\"/creators-assets/_next/static/immutable/chunks/2p6snucyfb6_0.js\",\"/creators-assets/_next/static/immutable/chunks/169pjay1xif06.js\"],\"StaticResourceGridWithToolbar\"]\n4f:T422,\u003cp\u003ePixel Icon Set is a living collection of over 200 pixel icons (and counting), all lovingly drawn on a 2px grid. Scalable up or down without losing their crisp charm, each icon includes variable controls for colour and opacity, giving you total freedom in Framer.They're playful yet precise, fun yet functional, featuring everything from everyday UI elements to a few cult favourites (yes, there are 14 Star Wars icons and 2 Daft Punk ones in there, because why not?). Designed for those who love their pixels with personality.\u003cstrong\u003eFeatures\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eDrawn precisely on a \u003cstrong\u003e2 px grid\u003c/strong\u003e for perfect crispness\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eScalable\u003c/strong\u003e up or down with zero loss in charm\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eColour \u0026amp; opacity variables\u003c/strong\u003e for full Framer control\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003e14 Star Wars\u003c/strong\u003e and \u003cstrong\u003e2 Daft Punk\u003c/strong\u003e icons for the fans\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eConstantly \u003cstrong\u003eupdated and expanding\u003c/strong\u003e with new metaphors\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFuture updates \u003cstrong\u003efree of charge\u003c/strong\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e50:T696,\u003cp\u003eSet of \u003cstrong\u003e64 hand-drawn SVG doodles\u003c/strong\u003e. \u003c/p\u003e\u003cp\u003eUse them to point, nudge, label, and celebrate: drop a spark next to a feature, throw a “click here” tag on a CTA, or frame a note with a loose bubble.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eKey features\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e64 original SVGs, lightweight and crisp at any size\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eWorks on light or dark backgrounds; scales without blur\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFramer-ready: drag-in, recolor in one click, animate with Hover, Scroll or Reveal\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eConsistent style language so doodles support content, not compete with it\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eWhat’s inside\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eArrows \u0026amp; motion cues:\u003c/strong\u003e straight, curved, loopy, wavy\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eEmphasis marks:\u003c/strong\u003e underlines, waves, sparks, stars, asterisks\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eSpeech \u0026amp; note shapes:\u003c/strong\u003e chat bubbles, clouds, brackets, “OK!” and “Start” tags\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eMicrocopy badges:\u003c/strong\u003e “Click here,” “Hurry up!,” punctuation and exclamation marks\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eObjects:\u003c/strong\u003e mug, phone, camera, globe, megaphone, shopping cart, lightbulb\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eCurrency \u0026amp; symbols:\u003c/strong\u003e €, £, $, numbers, flags, crowns, sun and more\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003ePerfect for\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eFeature callouts on landing pages\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eOnboarding tips and empty states\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSocial thumbnails, decks, and video frames\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eEditorial notes, checklists, and quick UI highlights\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003eGive your interface a human accent. These doodles turn sterile screens into clear, inviting stories.\u003c/p\u003e\u003cp\u003eFor any questions: HiHelenSay@gmail.com\u003c/p\u003e51:Tba3,\u003cp\u003eHand-Drawn Wireframe \u0026amp; UI Annotation Vector Pack\u003c/p\u003e\u003cp\u003eAdd a human touch, playful energy, and organic visual emphasis to your digital layouts with this comprehensive collection of \u003cstrong\u003ehand-drawn arrows, scribbles, math symbols, UI badges, and handwritten callout words\u003c/strong\u003e. Perfect for wireframing, design presentations, marketing assets, and interactive website overlays.\u003c/p\u003e\u003ch2\u003e\u003cspan data-type=\"emoji\" data-name=\"milky_way\"\u003e🌌\u003c/span\u003e What It Includes\u003c/h2\u003e\u003ch3\u003e\u003cspan data-type=\"emoji\" data-name=\"bow_and_arrow\"\u003e🏹\u003c/span\u003e Hand-Drawn Arrows \u0026amp; Directional Indicators (\u003ccode\u003earrows.png\u003c/code\u003e)\u003c/h3\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eDynamic Curved \u0026amp; Looped Arrows:\u003c/strong\u003e Wave paths, spiral turns, zig-zags, sharp angles, and sweeping direction pointers.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eDashed \u0026amp; Dotted Lines:\u003c/strong\u003e Motion-path arrows, dashed trajectories, and segmented step-by-step pointers.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eVaried Endings \u0026amp; Styles:\u003c/strong\u003e Simple stroke tips, solid arrowhead ends, and organic sketch weights.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch3\u003e\u003cspan data-type=\"emoji\" data-name=\"pencil2\"\u003e✏\u003c/span\u003e Highlight Scribbles, Underlines \u0026amp; Swirls (\u003ccode\u003ehighlight.png\u003c/code\u003e)\u003c/h3\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eEmphasis Lines \u0026amp; Underlines:\u003c/strong\u003e Multi-stroke scribbles, double underlines, cross-hatched strike-throughs, and quick accent lines.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eTornadoes \u0026amp; Swirls:\u003c/strong\u003e Spiral focus indicators, cloud-like loops, and decorative wave flourishes for drawing visual attention.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch3\u003e\u003cspan data-type=\"emoji\" data-name=\"1234\"\u003e🔢\u003c/span\u003e Math, Currency \u0026amp; Geometric Shapes (\u003ccode\u003emath and finance.png\u003c/code\u003e)\u003c/h3\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eGlobal Currency Symbols:\u003c/strong\u003e Hand-sketched Dollar ($), Euro (€), Cent (¢), Rupee (₹), and Yen (¥) signs.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eMathematical Notations:\u003c/strong\u003e Numbers 0–9, basic operators (+, −, ÷, =), brackets \u003ccode\u003e( )\u003c/code\u003e and \u003ccode\u003e{ }\u003c/code\u003e, infinity ($\\infty$), percentage (%), and inequality symbols ($\\neq$, $\u0026lt;$, $\u0026gt;$).\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eBasic Geometry:\u003c/strong\u003e Hand-drawn circles, triangles, and squares for framing content and creating custom badges.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch3\u003e\u003cspan data-type=\"emoji\" data-name=\"sparkles\"\u003e✨\u003c/span\u003e UI Accents, Emoticons \u0026amp; Icons (\u003ccode\u003esymbols.png\u003c/code\u003e)\u003c/h3\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eEmphasis Sparkles \u0026amp; Stars:\u003c/strong\u003e 4-point glints, traditional stars, burst accents, and lightning bolts.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eInteractive UI Markers:\u003c/strong\u003e Checkmarks, crosses (X), heart icons, bookmarks, paper planes, location flags, speech quotes, and music notes.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eHand-Drawn Expressive Faces:\u003c/strong\u003e Happy, neutral, and sad smiley faces alongside exclamation points and question marks.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003eMade with \u003cspan data-type=\"emoji\" data-name=\"yellow_heart\"\u003e💛\u003c/span\u003e by \u003ca class=\"mention\" data-type=\"mention\" data-id=\"cdbd7ebc-86d4-4b64-baea-421f236c7c35\" href=\"/community/creator/@karim-saif/\"\u003e@Karim Saif\u003c/a\u003e \u003c/p\u003e52:T455,\u003cp\u003e\u003cstrong\u003eNautical\u003c/strong\u003e is a collection of 65 hand-crafted Nordic-style emblems inspired by sea, myth, and nature. Each illustration is drawn with clean geometry and calm balance. Think ships, waves, fish, moons, and ravens rendered in timeless Scandinavian minimalism.Built for Framer, every emblem comes with full variable controls for stroke, colour, background oval tone, and opacity so you can match any brand, mood, or project aesthetic. Whether you’re designing a serene landing page, a coastal brand, or a modern folk narrative, Nautical fits beautifully into any visual system.\u003cstrong\u003eFeatures\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003e65 minimalist\u003c/strong\u003e Nordic-inspired vector emblems\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eFull control\u003c/strong\u003e of stroke, colour, background, and opacity\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePerfectly scalable with \u003cstrong\u003ebalanced oval framing\u003c/strong\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eIdeal for brands, websites, and \u003cstrong\u003eeditorial storytelling\u003c/strong\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eDesigned to bring \u003cstrong\u003ecalm, crafted beauty\u003c/strong\u003e to any project\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFuture updates \u003cstrong\u003efree of charge\u003c/strong\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e53:T4a4,\u003cp\u003eGive your Framer projects a professional edge with this carefully designed collection of \u003cstrong\u003e1215 clean, scalable duotone icons\u003c/strong\u003e. Each icon is crafted with precision to maintain a \u003cstrong\u003emodern, minimalistic look\u003c/strong\u003e that adapts seamlessly to any layout or style.\u003c/p\u003e\u003cp\u003ePerfect for \u003cstrong\u003edashboards, landing pages, mobile apps, and portfolios\u003c/strong\u003e, this versatile set ensures your designs remain consistent, elegant, and instantly recognizable.\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003e1215 unique icons\u003c/strong\u003e across multiple categories\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eVector-based \u0026amp; fully scalable\u003c/strong\u003e without losing quality\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eCustomizable colors and \u003c/strong\u003eto match your brand style\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eLightweight, minimal design\u003c/strong\u003e for faster loading and a polished UI\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eTailored for Framer\u003c/strong\u003e, but easily adaptable to other platforms\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eIdeal for \u003cstrong\u003ewebsites, SaaS, agencies, and creative portfolios\u003c/strong\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003eWhether you need to highlight features, improve navigation, or add visual clarity, this icon set helps your websites stand out while keeping the focus on your content.\u003c/p\u003e54:T729,\u003ch3\u003eAbout\u003c/h3\u003e\u003cp\u003eBusivio is a comprehensive collection of 90 flat color icons designed specifically for startup ecosystems, business operations, and modern digital products. The pack covers essential startup activities including product development, growth marketing, operational workflows, financial management, and team collaboration.\u003c/p\u003e\u003cp\u003eEach icon is carefully crafted with pixel-perfect precision, consistent proportions, and a cohesive visual language to ensure seamless integration across websites, mobile applications, dashboards, presentations, and marketing materials. Whether you\u0026#39;re building a SaaS platform, startup website, business presentation, or internal product documentation, Busivio provides a professional and scalable icon solution for modern business environments.\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003ch3\u003eKey Features\u003c/h3\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eFlat Color Style with Clean Visual Appearance\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePixel-Perfect Design for Crisp Rendering\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCovers Product, Growth, Operations, Finance, and Team Categories\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSuitable for Web, Mobile Apps, Presentations, and Dashboards\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eProfessional and Modern Business-Oriented Visual Language\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eDesigned for Designers, Developers, Startups, and Product Teams\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCohesive Icon System Across All Categories\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch3\u003e\u003c/h3\u003e\u003ch3\u003e\u003cstrong\u003eRefund Policy\u003c/strong\u003e\u003c/h3\u003e\u003cp\u003eBecause this product is delivered digitally and becomes accessible immediately after purchase, all sales are final. Refunds, exchanges, or cancellations are not available.\u003c/p\u003e\u003cp\u003eIf you experience any issues accessing or using the files, support is available. Please contact \u003ca href=\"mailto:punloka.design@gmail.com\"\u003e\u003cstrong\u003epunloka.design@gmail.com\u003c/strong\u003e\u003c/a\u003e with details of the issue, and assistance will be provided to ensure everything works as expected.\u003c/p\u003e55:Ta3f,\u003cp\u003eHand-Drawn Series (30+ Icons)\u003c/p\u003e\u003cp\u003eAn expressive set of handcrafted, sketch-style arrows built to add personality, visual emphasis, and human touch to graphics, presentations, and interactive layouts.\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eStyle Aesthetics\u003c/strong\u003e: Loose stroke textures, variable linework, organic curves, and custom doodle aesthetics.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eVariations Included\u003c/strong\u003e:\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eSpiral loops and swirl gestures\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eZig-zag dynamic movement paths\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eDotted and dashed trajectory lines\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eBold filled tips and cross-hatched focal pointers\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCurved annotation and callback arrows\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eBest Used For\u003c/strong\u003e: Landing page annotations, hero section callouts, onboarding guides, creative portfolios, and informal UX wireframing.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003eSystem UI Series (200+ Icons)\u003c/p\u003e\u003cp\u003eA high-precision, geometric icon set crafted for modern software interfaces, app navigation, and structured web design.\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eStyle Aesthetics\u003c/strong\u003e: Pixel-aligned vector lines, uniform stroke widths, and consistent geometric proportions.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eVariations Included\u003c/strong\u003e:\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eCardinal \u0026amp; Ordinal Directional Pointers (Up, Down, Left, Right, Diagonal)\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eInterface Controls (Expand, Collapse, Return, Outbound)\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eData Sorting Indicators (Alphabetical A-Z, Numeric 0-1, Ascending/Descending)\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAlignment \u0026amp; Shift Arrows (Tab line anchors, swap indicators, dual-direction vectors)\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eMinimal Chevrons \u0026amp; Carets\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eBest Used For\u003c/strong\u003e: Web app navigation, dashboard controls, data tables, drop-down menus, button components, and design system utility libraries.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003eKey Features\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eDual-Aesthetic Flexibility\u003c/strong\u003e: Switch seamlessly between relaxed, humanized graphics and formal, structured interface elements.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eVector Precision\u003c/strong\u003e: Crisp scaling across high-DPI displays without quality loss.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eFully Customizable\u003c/strong\u003e: Compatible with stroke width adjustments, custom color fills, and seamless integration into Framer components or Figma UI kits.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003c/p\u003e\u003ch2\u003eNeed help?\u003c/h2\u003e\u003cp\u003eHave questions, need custom features, or want to share feedback? Reach out anytime at \u003ca href=\"mailto:karimsaif010@gmail.com\"\u003e\u003cstrong\u003ekarimsaif010@gmail.com\u003c/strong\u003e\u003c/a\u003e or on X \u003ca class=\"mention\" data-type=\"mention\" data-id=\"cdbd7ebc-86d4-4b64-baea-421f236c7c35\" href=\"/community/creator/@karim-saif/\"\u003e@Karim Saif\u003c/a\u003e .\u003c/p\u003e56:T43a,\u003cp\u003eA good design isn\u0026#39;t always the most sophisticated one; it must also be easy to understand. To enhance clarity, designs are often divided into various sections. However, some sections can appear blurred together for various reasons, which is where a separator or divider becomes essential. While a simple line typically serves this purpose, it\u0026#39;s not always suitable, especially when aiming for a classy and professional look.\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003eThe Golden Brown Art Deco Dividers Elements Set is an excellent alternative for this purpose. It\u0026#39;s perfect for invitations, restaurant menus, photo frames, certificates, and more. This divider set features not only straight lines but also combinations of basic geometric shapes, resulting in unique and outstanding dividers. Utilizing these elements will elevate the elegance of your designs.\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003eYou can easily adjust the golden brown color to suit your needs, allowing you to create a more cohesive design. Use this divider set to achieve a fancy and sophisticated look for both personal and professional projects.\u003c/p\u003e57:T49a,\u003cp\u003ePreview: \u003ca href=\"https://icons.stylokit.com/\" rel=\"noopener noreferrer nofollow\" target=\"_blank\"\u003eicons.stylokit.com\u003c/a\u003e\u003c/p\u003e\u003cp\u003eAll three styles share identical geometry, proportions, and visual logic, ensuring full interchangeability across any interface. Every icon uses a smooth-corner design by default, providing a clean, modern look that fits perfectly with contemporary UI design.\u003c/p\u003e\u003cp\u003eThe system spans \u003cstrong\u003e46 categories\u003c/strong\u003e, covering everything from essential UI elements to extended themes such as Science, Travel, Nature, Business, and more.Each icon is fully optimized for Framer, offering perfect scaling, clean alignment, and seamless performance inside components and variants.\u003c/p\u003e\u003cp\u003eCrafted with years of design experience, this icon system represents a refined, professional, and highly practical UI library — built specifically for Framer by Stylokit.\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eVersion 1.06 is now available with new icons and improvements.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eVersion 1.07 is now available with new icons and improvements.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eNow available as a React icon package, so you can easily import and use icons directly in your projects.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e58:Tcb2,\u003cp\u003e\u003cstrong\u003eHand-Lettered Typography Sticker Vector Pack\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eAdd expressive personality and playful vibes to your creative projects with this colorful collection of \u003cstrong\u003ehand-lettered typography stickers\u003c/strong\u003e. Featuring vibrant brush script letterforms, bold die-cut white borders, realistic dynamic drop shadows, and expressive decorative symbols, this vector pack is perfect for digital planning, web design accents, branding, and promotional graphics.\u003c/p\u003e\u003ch2\u003e\u003cspan data-type=\"emoji\" data-name=\"milky_way\"\u003e🌌\u003c/span\u003e What It Includes\u003c/h2\u003e\u003ch3\u003e\u003cspan data-type=\"emoji\" data-name=\"speech_balloon\"\u003e💬\u003c/span\u003e Expressive Feedback \u0026amp; Phrase Stickers\u003c/h3\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003ePositive Praise \u0026amp; Celebrations:\u003c/strong\u003e Energetic typography quotes including \u003cem\u003e\u0026quot;GREAT IDEA\u0026quot;\u003c/em\u003e, \u003cem\u003e\u0026quot;LOVE IT\u0026quot;\u003c/em\u003e (with mini heart accents), \u003cem\u003e\u0026quot;GOOD JOB\u0026quot;\u003c/em\u003e, \u003cem\u003e\u0026quot;100!\u0026quot;\u003c/em\u003e, and \u003cem\u003e\u0026quot;Awesome!\u0026quot;\u003c/em\u003e.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eWorkflow \u0026amp; Task Statuses:\u003c/strong\u003e Essential status badges for productivity workflows, featuring \u003cem\u003e\u0026quot;WIP\u0026quot;\u003c/em\u003e, \u003cem\u003e\u0026quot;YES\u0026quot;\u003c/em\u003e, \u003cem\u003e\u0026quot;NO\u0026quot;\u003c/em\u003e, \u003cem\u003e\u0026quot;TO-DO\u0026quot;\u003c/em\u003e, and \u003cem\u003e\u0026quot;DONE\u0026quot;\u003c/em\u003e.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eGratitude \u0026amp; Communication:\u003c/strong\u003e Friendly conversational callouts like \u003cem\u003e\u0026quot;THANKS\u0026quot;\u003c/em\u003e.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2\u003e\u003cspan data-type=\"emoji\" data-name=\"art\"\u003e🎨\u003c/span\u003e Key Features\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eDie-Cut Sticker Aesthetic:\u003c/strong\u003e Each letterform and symbol is framed with a clean, continuous white border offset and a soft drop shadow, creating a realistic physical sticker look.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eHand-Drawn Brush \u0026amp; Block Typography:\u003c/strong\u003e A rich mix of custom lettering styles, ranging from dynamic angular brush script to friendly rounded block capitals and 3D extruded lettering.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eVibrant Color Palette:\u003c/strong\u003e Built using a high-energy triad color scheme featuring electric purple, bold red, and warm golden yellow.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eFully Scalable Vector Format:\u003c/strong\u003e Clean, isolated vector shapes that scale infinitely without loss of resolution or crispness.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eEasy Customization:\u003c/strong\u003e Effortlessly tweak colors, adjust stroke widths, scale elements, or remove shadows using standard vector software like Adobe Illustrator, Figma, or Framer.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2\u003e\u003cspan data-type=\"emoji\" data-name=\"rocket\"\u003e🚀\u003c/span\u003e Best Used For\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cspan data-type=\"emoji\" data-name=\"iphone\"\u003e📱\u003c/span\u003e Mobile apps, digital planners, \u0026amp; task management app UI\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cspan data-type=\"emoji\" data-name=\"art\"\u003e🎨\u003c/span\u003e Creative agency portfolio overlays \u0026amp; interactive site graphics\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cspan data-type=\"emoji\" data-name=\"school_satchel\"\u003e🎒\u003c/span\u003e Printable stickers, merchandise, packaging \u0026amp; stationery design\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cspan data-type=\"emoji\" data-name=\"camera_flash\"\u003e📸\u003c/span\u003e Social media story stickers, promotional banners \u0026amp; blog headers\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003eMade with \u003cspan data-type=\"emoji\" data-name=\"yellow_heart\"\u003e💛\u003c/span\u003e by \u003ca class=\"mention\" data-type=\"mention\" data-id=\"cdbd7ebc-86d4-4b64-baea-421f236c7c35\" href=\"/community/creator/@karim-saif/\"\u003e@Karim Saif\u003c/a\u003e \u003c/p\u003e59:Ta36,\u003cp\u003e\u003cstrong\u003eY2K Starburst \u0026amp; Sparkle Vector Pack\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eElevate your digital designs with a versatile collection of \u003cstrong\u003evector starbursts, sparkles, and geometric Y2K symbols\u003c/strong\u003e. Designed with a modern retro-futuristic aesthetic, this asset pack blends classic 4-point sparkles, wireframe geometric orbits, chrome-inspired flares, and abstract celestial glyphs—perfect for visual assets, graphic layouts, and UI decor.\u003c/p\u003e\u003ch2\u003e\u003cspan data-type=\"emoji\" data-name=\"milky_way\"\u003e🌌\u003c/span\u003e What It Includes\u003c/h2\u003e\u003ch3\u003e\u003cspan data-type=\"emoji\" data-name=\"sparkles\"\u003e✨\u003c/span\u003e Classic \u0026amp; Minimal Sparkles\u003c/h3\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eSolid \u0026amp; Outlined Stars:\u003c/strong\u003e A comprehensive range of 4-point starbursts, cross flares, and subtle glints in both filled solid silhouettes and clean line-art outlines.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eElongated Cross Flares:\u003c/strong\u003e Lens flare shapes with extended vertical and horizontal beams for dramatic lighting accents.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2\u003e\u003cspan data-type=\"emoji\" data-name=\"art\"\u003e🎨\u003c/span\u003e Key Features\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eFully Scalable Vector Format:\u003c/strong\u003e Infinite resolution scalability without loss of detail, ideal for print and high-res screen displays.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eDual-Style Versatility:\u003c/strong\u003e Features both \u003cstrong\u003eSolid Fill\u003c/strong\u003e and \u003cstrong\u003ePrecision Line Art (Stroke)\u003c/strong\u003e variations to match any design weight.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eY2K \u0026amp; Cyberpunk Aesthetic:\u003c/strong\u003e Designed specifically to fit aesthetic trends like Cyberpunk, Acid Graphic, Vaporwave, Modern Minimalist, and Retro-Futurism.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eCustomizable:\u003c/strong\u003e Easily change colors, stroke weights, fills, or scale individual elements in software like Adobe Illustrator, Figma, Photoshop, or Canva.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2\u003e\u003cspan data-type=\"emoji\" data-name=\"rocket\"\u003e🚀\u003c/span\u003e Best Used For\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cspan data-type=\"emoji\" data-name=\"art\"\u003e🎨\u003c/span\u003e Poster design, album art covers \u0026amp; branding assets\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cspan data-type=\"emoji\" data-name=\"shirt\"\u003e👕\u003c/span\u003e Apparel graphics, streetwear prints \u0026amp; merchandise design\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cspan data-type=\"emoji\" data-name=\"iphone\"\u003e📱\u003c/span\u003e Social media graphics, banner visual anchors \u0026amp; promo flyers\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cspan data-type=\"emoji\" data-name=\"computer\"\u003e💻\u003c/span\u003e UI/UX decorative accents, web icons \u0026amp; Framer canvas overlays\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003eMade with \u003cspan data-type=\"emoji\" data-name=\"yellow_heart\"\u003e💛\u003c/span\u003e by \u003ca class=\"mention\" data-type=\"mention\" data-id=\"cdbd7ebc-86d4-4b64-baea-421f236c7c35\" href=\"/community/creator/@karim-saif/\"\u003e@Karim Saif\u003c/a\u003e \u003c/p\u003e5a:T66e,\u003cp\u003eBring strategy, innovation, and business growth to your digital projects with the \u003cstrong\u003eBusiness Strategy Essentials Illustration Set\u003c/strong\u003e. This collection features beautifully crafted vector illustrations designed to showcase strategic planning, market analysis, goal setting, leadership, decision-making, and business development through clean and modern visuals.\u003c/p\u003e\u003cp\u003ePerfect for Framer websites, startup platforms, SaaS products, corporate websites, consulting services, business dashboards, marketing platforms, and company landing pages, these illustrations are fully scalable, lightweight, and easy to customize. Each illustration is designed with a modern, professional style that seamlessly fits contemporary websites and digital products.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eFeatures:\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eHigh-quality editable vector illustrations\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eModern, clean, and professional designs\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePerfect for business strategy, planning, consulting, and growth projects\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eEasy to customize colors and design elements\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eOptimized for Framer projects and components\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFully scalable without losing quality\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSuitable for websites, mobile apps, presentations, dashboards, and marketing materials\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003eWhether you\u0026#39;re showcasing business planning, market research, strategic meetings, performance analysis, leadership, financial growth, project management, or long-term business goals, the \u003cstrong\u003eBusiness Strategy Essentials Illustration Set\u003c/strong\u003e helps create engaging visual experiences that communicate confidence, innovation, and sustainable growth.\u003c/p\u003e5b:T66b,\u003cp\u003eBring professionalism, teamwork, and workplace excellence to your business projects with the \u003cstrong\u003eProfessional Employee Essentials Illustration Set\u003c/strong\u003e. This collection features beautifully crafted vector illustrations designed to showcase office life, employee collaboration, productivity, leadership, and professional development through clean and modern visuals.\u003c/p\u003e\u003cp\u003ePerfect for Framer websites, corporate platforms, HR solutions, recruitment agencies, business dashboards, startup websites, internal portals, and workplace management systems, these illustrations are fully scalable, lightweight, and easy to customize. Each illustration is designed with a modern, approachable style that fits seamlessly into contemporary websites and digital products.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eFeatures:\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eHigh-quality editable vector illustrations\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eModern, clean, and professional designs\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePerfect for employees, workplaces, HR, and business projects\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eEasy to customize colors and design elements\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eOptimized for Framer projects and components\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFully scalable without losing quality\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSuitable for websites, mobile apps, presentations, dashboards, and marketing materials\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003eWhether you\u0026#39;re showcasing office teams, employee onboarding, workplace collaboration, professional skills, leadership, business meetings, company culture, or career development, the \u003cstrong\u003eProfessional Employee Essentials Illustration Set\u003c/strong\u003e helps create engaging visual experiences that communicate productivity, trust, and professional success.\u003c/p\u003e5c:T9a6,\u003cp\u003eFood \u0026amp; Allergen Vector Icon Set\u003c/p\u003e\u003cp\u003eA clean, minimalist vector icon pack designed for modern UI/UX design, dietary labeling, restaurant menus, and packaging. Created by Karim Saif, this collection features precise vector line icons covering ingredients, major food allergens, seafood, produce, and culinary categories.\u003c/p\u003e\u003ch2\u003e\u003cspan data-type=\"emoji\" data-name=\"milky_way\"\u003e🌌\u003c/span\u003e What It Does\u003c/h2\u003e\u003ch3\u003e\u003cspan data-type=\"emoji\" data-name=\"green_apple\"\u003e🍏\u003c/span\u003e Comprehensive Dietary \u0026amp; Food Categorization\u003c/h3\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eAllergen \u0026amp; Ingredient Coverage:\u003c/strong\u003e Clear line illustrations representing common dietary indicators and ingredients, including nuts, dairy, gluten/wheat, seafood, legumes, and meats.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eMinimalist Line Geometry:\u003c/strong\u003e Built with uniform stroke weights and clean geometric curves for maximum legibility at small scale sizes across mobile screens and print interfaces.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch3\u003e\u003cspan data-type=\"emoji\" data-name=\"bento\"\u003e🍱\u003c/span\u003e Multi-Category Visual Library\u003c/h3\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eProduce \u0026amp; Agriculture:\u003c/strong\u003e Apples, bananas, citrus slices, kiwis, mushrooms, potatoes, celery, and acorns.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eProteins \u0026amp; Seafood:\u003c/strong\u003e Poultry drumsticks, bone-in meats, steaks, eggs, fish, squid, crabs, shrimp, and shellfish.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eGrains, Seeds \u0026amp; Legumes:\u003c/strong\u003e Wheat stalks, soybeans, pea pods, loose seeds, and tree nuts (walnuts).\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eDairy \u0026amp; Essentials:\u003c/strong\u003e Milk bottles, lab/flask indicators for processed components, and gelatin/pudding forms.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2\u003e\u003cspan data-type=\"emoji\" data-name=\"rocket\"\u003e🚀\u003c/span\u003e Best Used For\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cspan data-type=\"emoji\" data-name=\"green_salad\"\u003e🥗\u003c/span\u003e Food delivery apps, digital restaurant menus, and recipe platforms\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cspan data-type=\"emoji\" data-name=\"label\"\u003e🏷\u003c/span\u003e Allergen identification badges and nutritional packaging labels\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cspan data-type=\"emoji\" data-name=\"shopping_cart\"\u003e🛒\u003c/span\u003e E-commerce grocery platforms and visual dietary filters\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cspan data-type=\"emoji\" data-name=\"iphone\"\u003e📱\u003c/span\u003e Health, wellness, and calorie-tracking application interfaces\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003eMade with \u003cspan data-type=\"emoji\" data-name=\"yellow_heart\"\u003e💛\u003c/span\u003e by \u003ca class=\"mention\" data-type=\"mention\" data-id=\"cdbd7ebc-86d4-4b64-baea-421f236c7c35\" href=\"/community/creator/@karim-saif/\"\u003e@Karim Saif\u003c/a\u003e \u003c/p\u003e5d:T945,\u003cp\u003eThe \u003cstrong\u003eReal Estate Outline Vectors\u003c/strong\u003e pack includes \u003cstrong\u003e50 clean, minimal outline icons\u003c/strong\u003e designed for real estate, property, and housing platforms. Each icon is built on a \u003cstrong\u003e24×24 grid\u003c/strong\u003e with \u003cstrong\u003e2px rounded strokes\u003c/strong\u003e, making them perfectly balanced for dashboards, mobile apps, and websites.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eWhat’s Included\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e🏠 \u003cstrong\u003e200 editable outline icons\u003c/strong\u003e (40×40 px)\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e⚙️ \u003cstrong\u003eOrganized by category\u003c/strong\u003e: Property, Location, Finance, People, Documents, Interiors, Analytics\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e🎨 \u003cstrong\u003eFully vector-based and scalable\u003c/strong\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e🖌️ \u003cstrong\u003eRecolorable strokes\u003c/strong\u003e for dark/light UI themes\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e📦 Delivered as a \u003cstrong\u003eFramer component (.framerx)\u003c/strong\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e💡 Variants for easy icon switching inside Framer\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eHow to Use\u003c/strong\u003e\u003c/p\u003e\u003col\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eImport the component\u003c/strong\u003e into your Framer project.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eDrag and drop the \u003cstrong\u003eRealEstateOutlineIcon\u003c/strong\u003e component onto your canvas.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eIn the \u003cstrong\u003eright-side panel\u003c/strong\u003e, select the desired icon from the \u003cstrong\u003eVariant dropdown\u003c/strong\u003e.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAdjust the \u003cstrong\u003estroke color\u003c/strong\u003e, \u003cstrong\u003esize\u003c/strong\u003e, and \u003cstrong\u003epadding\u003c/strong\u003e as needed.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCombine icons with your text, buttons, or UI layouts for consistent design.\u003c/p\u003e\u003c/li\u003e\u003c/ol\u003e\u003cp\u003e\u003cstrong\u003eKey Features\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e✨ 100% vector, fully editable\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e🧩 Works seamlessly inside Framer\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e🎨 Recolor icons instantly using Framer’s color picker\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e📐 Scalable for any resolution (40×40 grid optimized)\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e⚡ Lightweight and performance-optimized\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003ePerfect For\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eReal estate dashboards \u0026amp; CRMs\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eProperty tech startups\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAgent \u0026amp; listing websites\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eMobile UI \u0026amp; app interfaces\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFinancial or housing-related analytics tools\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eSupport:- \u003c/strong\u003e\u003c/p\u003e\u003cp\u003eNeed help or want to request new icons?📩 \u003cstrong\u003eEmail:\u003c/strong\u003e \u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"mailto:contact@freelancerdeven.com\"\u003econtact@freelancerdeven.com\u003c/a\u003e🌐 \u003cstrong\u003eCreator:\u003c/strong\u003e Freelancer Deven\u003c/p\u003e5e:T667,\u003cp\u003eBring confidence, leadership, and professional excellence to your business projects with the \u003cstrong\u003eProfessional Leader Illustration Set\u003c/strong\u003e. This collection features beautifully crafted vector illustrations designed to showcase leadership, team management, decision-making, mentoring, strategic planning, and workplace collaboration through clean and modern visuals.\u003c/p\u003e\u003cp\u003ePerfect for Framer websites, corporate platforms, leadership training programs, HR solutions, consulting services, startup websites, business dashboards, and company landing pages, these illustrations are fully scalable, lightweight, and easy to customize. Each illustration is designed with a modern, professional style that seamlessly fits contemporary websites and digital products.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eFeatures:\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eHigh-quality editable vector illustrations\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eModern, clean, and professional designs\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePerfect for leadership, management, and business projects\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eEasy to customize colors and design elements\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eOptimized for Framer projects and components\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFully scalable without losing quality\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSuitable for websites, mobile apps, presentations, dashboards, and marketing materials\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003eWhether you\u0026#39;re showcasing executive leadership, team management, business strategy, workplace collaboration, mentoring, organizational growth, professional development, or decision-making, the \u003cstrong\u003eProfessional Leader Illustration Set\u003c/strong\u003e helps create engaging visual experiences that communicate confidence, authority, and effective leadership.\u003c/p\u003e5f:Tef0,\u003ch3\u003eAbout\u003c/h3\u003e\u003cp\u003e\u003cstrong\u003eFintech Ops\u003c/strong\u003e is a comprehensive icon pack designed to support modern financial products, from digital payments and banking systems to security, investment, and financial management features. Each icon is crafted in a clean, flat style with consistent rounded geometry, ensuring clarity and usability across various interface sizes.\u003c/p\u003e\u003cp\u003eBuilt with a strong focus on pixel-perfect precision and visual consistency, this set works seamlessly in both light and dark themes. Whether you're designing mobile apps, dashboards, or SaaS platforms, \u003cstrong\u003eFintech Ops\u003c/strong\u003e helps communicate complex financial concepts with simple, clear, and reliable visuals.\u003c/p\u003e\u003ch3\u003eKey Features\u003c/h3\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e60 carefully designed fintech icons.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFlat style with clean, modern aesthetics.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePixel-perfect for sharp and consistent rendering.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eConsistent, rounded shapes and visual balance.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eOptimized for light and dark UI themes.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAccessibility-friendly color system.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSuitable for mobile apps, dashboards, and SaaS products.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eDesigned for clarity at small sizes (16–24px).\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch3\u003eIcon List\u003c/h3\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eDigital Payments:\u003c/strong\u003e Send Money, Receive Money, QR Payment, Scan to Pay, Payment Success, Payment Pending, Payment Failed, Split Bill, Refund, Transaction History.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eWallet \u0026amp; Banking:\u003c/strong\u003e Digital Wallet, Wallet Balance, Add Balance, Withdraw, Virtual Card, Physical Card, Card Lock, Card Settings, Linked Bank Account, Account Verification.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eSecurity \u0026amp; Trust:\u003c/strong\u003e Secure Transaction, Biometric Login, Fingerprint Scan, Face ID, Two-Factor Authentication, Fraud Alert, Suspicious Activity, Encrypted Data, Account Protection, Privacy Control.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eInvestment \u0026amp; Wealth:\u003c/strong\u003e Portfolio, Asset Growth, Profit, Loss, Market Trend, Stock Investment, Crypto Wallet, Diversification, Risk Management, Wealth Goal.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eFinance Management:\u003c/strong\u003e Expense Tracking, Income, Monthly Budget, Savings Goal, Cash Flow, Financial Report, Spending Limit, Bill Reminder, Subscription Payment, Financial Planning.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eSystem \u0026amp; Status:\u003c/strong\u003e Processing Transaction, Transaction Approved, Transaction Rejected, Data Sync, System Refresh, Server Connected, Offline Mode, Maintenance Mode, Update System, Notification Alert.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch3\u003eAdaptive Color System\u003c/h3\u003e\u003cp\u003eThis icon pack uses a tint and shade–based color system commonly found in modern UI design, making it easy to customize and adapt to different needs. It ensures strong accessibility while maintaining clear visual consistency across both light and dark interface modes.\u003c/p\u003e\u003cfigure\u003e\u003cimg src=\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/vector-sets/description-image-d2xcvzv2-evjHZVk9Bk4daoJm6AlCngaSaYy3G4\" alt=\"\"\u003e\u003c/figure\u003e\u003cfigure\u003e\u003cimg src=\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/vector-sets/description-image-d2xcvzv2-lfe1XiEXTk5DVVn7bOSr0Y8KZnppSd\" alt=\"\"\u003e\u003c/figure\u003e\u003cfigure\u003e\u003cimg src=\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/vector-sets/description-image-d2xcvzv2-2Fu2lKg57KVRJigfdUeaJsINRDWoOc\" alt=\"\"\u003e\u003c/figure\u003e\u003ch3\u003eRefund Policy\u003c/h3\u003e\u003cp\u003eBecause this product is delivered digitally and becomes accessible immediately after purchase, all sales are final. Refunds, exchanges, or cancellations are not available.\u003c/p\u003e\u003cp\u003eIf you experience any issues accessing or using the files, support is available. Please contact \u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"mailto:punloka.design@gmail.com\"\u003e\u003cstrong\u003epunloka.design@gmail.com\u003c/strong\u003e\u003c/a\u003e with details of the issue, and assistance will be provided to ensure everything works as expected.\u003c/p\u003e60:T4fb,\u003cp\u003eA set of 32 social media icons, ready to use in any Framer project. Each icon is built as a vector, ensuring crisp quality at any size.\u003c/p\u003e\u003cp\u003eEasily adjust color and size to match your design.\u003c/p\u003e\u003cp\u003eThis set includes these vector icons:\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eBehance\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eContra\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eDribbble\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eDiscord\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eEtsy\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFacebook\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFigma\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFramer\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eGitHub\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eGitLab\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eGoogle\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eInstagram\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eLinkedIn\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eMastodon\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eMedium\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePatreon\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePayPal\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePinterest\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eProduct Hunt\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eReddit\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eShopify\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSlack\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSnapchat\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSubstack\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eTelegram\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eThreads\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eTikTok\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eVimeo\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eWhatsApp\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eWebflow\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eX (Twitter)\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eYouTube\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003eIf you\u0026#39;d like me to add a specific icon to this set, feel free to contact me at: \u003ca href=\"mailto:azardam@outlook.com\"\u003eazardam@outlook.com\u003c/a\u003e\u003c/p\u003e\u003cp\u003e🔷 Made by \u003ca href=\"https://framer.link/azardam\" rel=\"noopener noreferrer nofollow\" target=\"_blank\"\u003eAzardam Studio\u003c/a\u003e 🔷\u003c/p\u003e61:T5b8,\u003cp\u003e\u003cstrong\u003eNourico Bold\u003c/strong\u003e is a bold, filled icon set designed for \u003cstrong\u003eFramer creators, UI designers, and web builders\u003c/strong\u003e who want strong and expressive visuals for digital interfaces.\u003c/p\u003e\u003cp\u003eEach icon is built as an \u003cstrong\u003eeditable vector\u003c/strong\u003e, making it easy to change colors and adapt icons to different brands or UI systems. The bold style helps icons stay visible and clear across \u003cstrong\u003ewebsites, dashboards, mobile apps, and product interfaces\u003c/strong\u003e.\u003c/p\u003e\u003cp\u003eThe set focuses on \u003cstrong\u003eclarity, consistency, and usability\u003c/strong\u003e, allowing designers to build modern interfaces with a strong visual presence.\u003c/p\u003e\u003ch3\u003eKey Features\u003c/h3\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eBold Filled Style\u003c/strong\u003e – Strong icons designed for clear and impactful interfaces\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eEasy Color Customization\u003c/strong\u003e – Quickly change icon colors to match your design\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eFully Editable Vector\u003c/strong\u003e – Resize and adapt icons without losing quality\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eUI \u0026amp; Web Ready\u003c/strong\u003e – Suitable for websites, dashboards, apps, and product design\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eConsistent Design System\u003c/strong\u003e – Balanced shapes for cohesive UI design\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eMonthly Updates\u003c/strong\u003e – New icons will be added regularly for free\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eNourico Bold\u003c/strong\u003e helps designers create \u003cstrong\u003eclear, modern interfaces\u003c/strong\u003e using bold icons that are flexible and easy to customize.\u003c/p\u003e62:T55e,\u003cp\u003eA comprehensive collection of 40 developer and DevOps icons designed for developer tools, documentation sites, and coding platforms.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eWhat's Included\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e• 40 vector icons across 8 categories\u003c/p\u003e\u003cp\u003e• Fully customizable stroke color\u003c/p\u003e\u003cp\u003e• Consistent 2px stroke width\u003c/p\u003e\u003cp\u003e• 24×24 base grid, scalable to any size\u003c/p\u003e\u003cp\u003e• Round caps and joins\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eCategories\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e• Code: Code, Braces, Terminal, Binary, FileCode\u003c/p\u003e\u003cp\u003e• Git: GitBranch, GitCommit, GitMerge, GitPullRequest, GitFork\u003c/p\u003e\u003cp\u003e• Files: FolderGit, FileJson, FileType, FileText, FolderOpen\u003c/p\u003e\u003cp\u003e• Debug: Bug, BugOff, AlertCircle, AlertTriangle, SearchCode\u003c/p\u003e\u003cp\u003e• Infrastructure: Server, Database, Cloud, Container, Cpu\u003c/p\u003e\u003cp\u003e• Tools: Wrench, Settings, Puzzle, Blocks, Cog\u003c/p\u003e\u003cp\u003e• API: Globe, Webhook, Link, Unlink, Route\u003c/p\u003e\u003cp\u003e• Actions: Play, Square, RotateCcw, RefreshCw, Zap\u003c/p\u003e\u003cp\u003e\u003cstrong\u003ePerfect For\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e• Developer tools \u0026amp; IDEs\u003c/p\u003e\u003cp\u003e• Documentation sites\u003c/p\u003e\u003cp\u003e• GitHub/GitLab integrations\u003c/p\u003e\u003cp\u003e• DevOps dashboards\u003c/p\u003e\u003cp\u003e• API documentation\u003c/p\u003e\u003cp\u003e• Coding bootcamp platforms\u003cstrong\u003eRefund Policy\u003c/strong\u003e Due to the digital nature of this product, all sales are final. No refunds are available once the purchase is complete. Please review the preview images and description carefully before purchasing.\u003c/p\u003e63:T633,\u003cp\u003e\u003cspan data-type=\"emoji\" data-name=\"sparkles\"\u003e✨\u003c/span\u003e \u003cstrong\u003eBuild interfaces that feel as sharp as they look!\u003c/strong\u003e Bento Geo is a precision-built collection of geometric UI icons crafted for modern product, dashboard, and marketing interfaces.\u003c/p\u003e\u003cp\u003e\u003cspan data-type=\"emoji\" data-name=\"rocket\"\u003e🚀\u003c/span\u003e \u003cstrong\u003eNow available for your next Framer project!\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eShip intentional, pixel-clean designs without hunting for matching assets or redrawing shapes by hand. Drawn on a strict grid with perfectly balanced stroke weights, these glyphs sit beautifully whether scaled up in a massive hero section or tucked into a compact toolbar.\u003c/p\u003e\u003cp\u003eKey Features: \u003c/p\u003e\u003cp\u003e\u003cspan data-type=\"emoji\" data-name=\"triangular_ruler\"\u003e📐\u003c/span\u003e \u003cstrong\u003ePrecision Grid:\u003c/strong\u003e Consistent stroke weights and balanced geometry for a unified aesthetic \u003c/p\u003e\u003cp\u003e\u003cspan data-type=\"emoji\" data-name=\"art\"\u003e🎨\u003c/span\u003e \u003cstrong\u003eNative Framer Integration:\u003c/strong\u003e Inserts instantly and automatically inherits your color styles \u003c/p\u003e\u003cp\u003e\u003cspan data-type=\"emoji\" data-name=\"jigsaw\"\u003e🧩\u003c/span\u003e \u003cstrong\u003eComprehensive Coverage:\u003c/strong\u003e Essential glyphs for navigation, actions, media, status, and layouts \u003c/p\u003e\u003cp\u003e\u003cspan data-type=\"emoji\" data-name=\"iphone\"\u003e📱\u003c/span\u003e \u003cstrong\u003eFlawlessly Scalable:\u003c/strong\u003e Aligned optical sizing and pixel-clean corners across all device sizes\u003c/p\u003e\u003cp\u003eNeed help integrating these into your design system or setting things up? Reach out at \u003ca href=\"mailto:abdulsamiwd2025@gmail.com\"\u003eabdulsamiwd2025@gmail.com\u003c/a\u003e \u003cspan data-type=\"emoji\" data-name=\"envelope\"\u003e✉\u003c/span\u003e\u003c/p\u003e64:T407,\u003cp\u003e\u003cstrong\u003eGeometric Shapes Icon Volume 3\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eDesigned by\u003cstrong\u003e Nazcraft\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eIdeal Use Cases:\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eBrand Identity \u0026amp; Logos:\u003c/strong\u003e Craft memorable, tech-forward logos and brand marks.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003ePosters \u0026amp; Typography:\u003c/strong\u003e Build striking, brutalist-inspired posters and music artwork.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eUI/UX \u0026amp; Web Design:\u003c/strong\u003e Integrate unique, modern iconography into app interfaces and digital platforms.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eMerchandise \u0026amp; Packaging:\u003c/strong\u003e Perfect for streetwear graphics, skateboard decks, and tech product packaging.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003eStreamline your workflow and inject a clean, structural, and modern aesthetic into your next creative project with this essential vector toolkit!\u003c/p\u003e\u003cp\u003eNeed Help?\u003c/p\u003e\u003cp\u003eIf you have any questions, trouble downloading your files, or need an invoice, just reply directly to this email or reach out to us at \u003ca href=\"mailto:zainanazlan@gmail.com\"\u003ezainanazlan@gmail.com\u003c/a\u003e\u003c/p\u003e65:T761,\u003cp\u003eElevate your creative projects with this premium collection of 3D Agriculture Icons. Crafted with a stunning Frosted Matte \u0026amp; Neo-Glassmorphism aesthetic, these graphics combine modern minimalist forms with high-end textures to deliver a visually striking and professional look.\u003c/p\u003e\u003cp\u003eWhether you are designing a website, mobile application, marketing campaign, presentation deck, or physical packaging, these icons are designed to grab attention and enhance user engagement. Each graphic has been meticulously modeled and rendered to ensure clean details and consistent lighting across the entire set.\u003c/p\u003e\u003cp\u003e\u003cspan data-type=\"emoji\" data-name=\"sparkles\"\u003e✨\u003c/span\u003e Key Features:\u003c/p\u003e\u003cp\u003e- High Definition (Full HD) renders with premium gloss, matte, and claymorphic materials.\u003c/p\u003e\u003cp\u003e- Print-ready resolution at 300 DPI for flawless physical production.\u003c/p\u003e\u003cp\u003e- Isolated PNG files with perfect transparent backgrounds for seamless drag-and-drop integration.\u003c/p\u003e\u003cp\u003e- Consistent lighting, perspective, and color harmony to maintain style unity across your projects.\u003c/p\u003e\u003cp\u003e- Ideal for light and dark layouts.\u003c/p\u003e\u003cp\u003e\u003cspan data-type=\"emoji\" data-name=\"package\"\u003e📦\u003c/span\u003e What\u0026#39;s Included in This Bundle:\u003c/p\u003e\u003cp\u003eA collection of 25 premium 3D icons, including:\u003c/p\u003e\u003cp\u003eApple, Barn, Carrot, Chicken Hen, Corn Cob, Cow Head, Egg In Nest, Farmer Hat (Straw Hat), Greenhouse, Hay Bale, Honey Jar With Bee, Milk Bottle, Pig Face, Rake, Seedling Sprout, Sheep, Shovel, Strawberry, Sunflower, Tomato, Tractor, Watering Can, Watermelon Slice, Wheat Sheaf, Windmill\u003c/p\u003e\u003cp\u003e\u003cspan data-type=\"emoji\" data-name=\"rocket\"\u003e🚀\u003c/span\u003e Perfect for:\u003c/p\u003e\u003cp\u003e- Web Design \u0026amp; Landing Pages\u003c/p\u003e\u003cp\u003e- Mobile Application UI/UX\u003c/p\u003e\u003cp\u003e- Social Media Posts \u0026amp; Stories\u003c/p\u003e\u003cp\u003e- Presentation Decks \u0026amp; Pitch Slides\u003c/p\u003e\u003cp\u003e- Branding, Logos \u0026amp; Identity Design\u003c/p\u003e\u003cp\u003e- Print Projects, Packaging \u0026amp; Merchandise\u003c/p\u003e66:T407,\u003cp\u003e\u003cstrong\u003eGeometric Shapes Icon Volume 2\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eDesigned by\u003cstrong\u003e Nazcraft\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eIdeal Use Cases:\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eBrand Identity \u0026amp; Logos:\u003c/strong\u003e Craft memorable, tech-forward logos and brand marks.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003ePosters \u0026amp; Typography:\u003c/strong\u003e Build striking, brutalist-inspired posters and music artwork.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eUI/UX \u0026amp; Web Design:\u003c/strong\u003e Integrate unique, modern iconography into app interfaces and digital platforms.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eMerchandise \u0026amp; Packaging:\u003c/strong\u003e Perfect for streetwear graphics, skateboard decks, and tech product packaging.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003eStreamline your workflow and inject a clean, structural, and modern aesthetic into your next creative project with this essential vector toolkit!\u003c/p\u003e\u003cp\u003eNeed Help?\u003c/p\u003e\u003cp\u003eIf you have any questions, trouble downloading your files, or need an invoice, just reply directly to this email or reach out to us at \u003ca href=\"mailto:zainanazlan@gmail.com\"\u003ezainanazlan@gmail.com\u003c/a\u003e\u003c/p\u003e67:T98c,\u003cp\u003e\u003cstrong\u003eBusiness \u0026amp; Tech Pro: The Essential Icon Set for Modern Interfaces\u003c/strong\u003e \u003cspan data-type=\"emoji\" data-name=\"briefcase\"\u003e💼\u003c/span\u003e\u003cspan data-type=\"emoji\" data-name=\"sparkles\"\u003e✨\u003c/span\u003e\u003c/p\u003e\u003cp\u003eElevate your digital products with \u003cstrong\u003eBusiness \u0026amp; Tech Pro\u003c/strong\u003e—a meticulously crafted collection of 40 Framer-ready vector icons designed specifically for the complex interfaces that modern teams build every single day. Whether you are designing for robust SaaS platforms, secure fintech applications, or high-end agency portals, this set provides the visual clarity and professionalism your projects demand.\u003c/p\u003e\u003cp\u003e\u003cspan data-type=\"emoji\" data-name=\"sparkles\"\u003e✨\u003c/span\u003e\u003cstrong\u003e Core Features \u0026amp; Benefits:\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cspan data-type=\"emoji\" data-name=\"straight_ruler\"\u003e📏\u003c/span\u003e \u003cstrong\u003ePrecision Engineered:\u003c/strong\u003e Every single icon is drawn on a strict, consistent 24px grid, guaranteeing a crisp, dependable, and pixel-perfect appearance across all your product pages, complex dashboards, and client portals.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cspan data-type=\"emoji\" data-name=\"gear\"\u003e⚙\u003c/span\u003e \u003cstrong\u003eTotal Customization:\u003c/strong\u003e Built for ultimate flexibility in Framer. With fully adjustable stroke weights and native \u003ccode\u003ecurrentColor\u003c/code\u003e styling, you can effortlessly tune and adapt the entire collection to perfectly match any brand identity, color palette, or dark/light theme.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cspan data-type=\"emoji\" data-name=\"card_index_dividers\"\u003e🗂\u003c/span\u003e \u003cstrong\u003eComprehensive Categories:\u003c/strong\u003e Stop wasting hours redrawing the basics. This set covers all your essential business and tech needs—seamlessly representing invoices, secure payments, and data reporting, right through to marketing funnels, server infrastructure, cybersecurity, and intricate workflow states.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cspan data-type=\"emoji\" data-name=\"mag\"\u003e🔍\u003c/span\u003e \u003cstrong\u003eBuilt-in Specimen View:\u003c/strong\u003e An interactive gallery allows you to easily browse the complete collection, preview how the icons scale in real-time, and copy your selections directly into your active Framer workspace with absolutely zero friction.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003eIt is the perfect, polished starter set designed to help you ship clearer, more intuitive product experiences while saving you valuable time. Give your next digital project the sharp, consistent visual language it deserves! \u003cspan data-type=\"emoji\" data-name=\"rocket\"\u003e🚀\u003c/span\u003e\u003c/p\u003e68:Ta3a,\u003cp\u003e\u003cstrong\u003eDoodle Callouts \u0026amp; Speech Bubbles\u003c/strong\u003e is a charm-filled vector element collection crafted to add human warmth, informal notes, and expressive visual commentary to your landing pages, marketing banners, and editorial layouts. Featuring clean line work and minimalist typography spaces, these hand-drawn assets seamlessly blend functional annotation with playful aesthetics.\u003c/p\u003e\u003ch3\u003eWhat it does\u003c/h3\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eExpressive Callout Styles:\u003c/strong\u003e Features a versatile mix of rounded speech bubbles, cloud-like thought bubbles, sleek underline brackets, and dynamic swirl accents.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eMinimalist Line-Art Aesthetics:\u003c/strong\u003e Clean, high-contrast outlines that adapt beautifully to light, dark, and gradient backgrounds.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eFlexible Layout Formatting:\u003c/strong\u003e Designed to house custom text overlays, tooltips, team callouts, or inline user feedback highlights.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eVector Precision:\u003c/strong\u003e Scalable graphics that maintain crisp edges across all screen densities and frame sizes.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch3\u003eGreat for\u003c/h3\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003ePlayful Landing Pages:\u003c/strong\u003e Break up static layouts with casual product highlights, humorous notes, or conversational copy.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eUser Feedback \u0026amp; Testimonials:\u003c/strong\u003e Highlight customer quotes and reviews using warm, approachable speech bubbles.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eProduct Tour Tooltips:\u003c/strong\u003e Point out features, onboarding tips, or quick actions with engaging visual pointers.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eSocial Media \u0026amp; Hero Graphics:\u003c/strong\u003e Add energetic, human-centric visual accents to promotional banners and marketing creatives.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch3\u003eWhat you can customize\u003c/h3\u003e\u003cp\u003eEasily tweak and adapt every element to fit your design system:\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eText Content \u0026amp; Typography\u003c/strong\u003e — Overlay any custom font, weight, or copy inside the speech frames\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eStroke \u0026amp; Outline Colors\u003c/strong\u003e — Match line colors directly to your brand palette or light/dark mode themes\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eScale \u0026amp; Orientation\u003c/strong\u003e — Flip, scale, or rotate brackets and callouts to point precisely at UI targets\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eFill \u0026amp; Background\u003c/strong\u003e — Keep transparent line art or apply custom backdrop fills and glassmorphism blurs\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch3\u003eNeed help?\u003c/h3\u003e\u003cp\u003eHave questions or feature suggestions? Reach out anytime at \u003ca href=\"mailto:karimsaif010@gmail.com\"\u003ekarimsaif010@gmail.com\u003c/a\u003e or on X \u003ca href=\"https://x.com/karimsaif0\" rel=\"noopener noreferrer nofollow\" target=\"_blank\"\u003e@karimsaif0\u003c/a\u003e.\u003c/p\u003e69:T94d,\u003cp\u003e\u003cstrong\u003eUS States Vector Silhouette Pack\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eA comprehensive, high-precision vector collection of all 50 US state geographic silhouettes plus Washington D.C. and a complete nationwide map graphic. Created by Karim Saif, this asset set offers clean, scalable vector outlines built for interactive web maps, infographics, travel platforms, and regional UI dashboards.\u003c/p\u003e\u003cp\u003e\u003cspan data-type=\"emoji\" data-name=\"milky_way\"\u003e🌌\u003c/span\u003e What It Does\u003cspan data-type=\"emoji\" data-name=\"world_map\"\u003e🗺\u003c/span\u003e Complete Geographic Coverage\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eAll 50 States + Federal District:\u003c/strong\u003e Includes individual silhouette vectors for all U.S. states (from California and Texas to Alaska and Hawaii) along with Washington D.C. and a complete U.S. nation silhouette.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eGeographically Precise Paths:\u003c/strong\u003e Detailed vector outlines capturing real geographic coastlines, state borders, panhandles, and island chains with smooth node fidelity.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cspan data-type=\"emoji\" data-name=\"triangular_ruler\"\u003e📐\u003c/span\u003e Clean Solid Silhouettes\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eFlat Vector Shapes:\u003c/strong\u003e Minimalist solid black fills designed for effortless styling, hover-state color shifts, and seamless visual integration across dark and light UI themes.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eUniform \u0026amp; Scalable:\u003c/strong\u003e Pixel-perfect vector boundaries optimized for ultra-crisp rendering at small icon scales as well as large hero-section visual displays.\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cspan data-type=\"emoji\" data-name=\"rocket\"\u003e🚀\u003c/span\u003e Best Used For\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cspan data-type=\"emoji\" data-name=\"round_pushpin\"\u003e📍\u003c/span\u003e Interactive store locators, real estate platforms, and shipping region selectors\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cspan data-type=\"emoji\" data-name=\"bar_chart\"\u003e📊\u003c/span\u003e Infographics, election visualizers, and data analytics dashboards\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cspan data-type=\"emoji\" data-name=\"airplane\"\u003e✈\u003c/span\u003e Travel blogs, tourism portals, and regional service directories\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cspan data-type=\"emoji\" data-name=\"iphone\"\u003e📱\u003c/span\u003e Mobile app state selection interfaces and geographical filtering systems\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003eMade with \u003cspan data-type=\"emoji\" data-name=\"yellow_heart\"\u003e💛\u003c/span\u003e by \u003ca class=\"mention\" data-type=\"mention\" data-id=\"cdbd7ebc-86d4-4b64-baea-421f236c7c35\" href=\"/community/creator/@karim-saif/\"\u003e@Karim Saif\u003c/a\u003e \u003c/p\u003e6a:T498,\u003cp\u003eGive your Framer projects a professional edge with this carefully designed collection of \u003cstrong\u003e1246 clean, scalable solid icons\u003c/strong\u003e. Each icon is crafted with precision to maintain a \u003cstrong\u003emodern, minimalistic look\u003c/strong\u003e that adapts seamlessly to any layout or style.\u003c/p\u003e\u003cp\u003ePerfect for \u003cstrong\u003edashboards, landing pages, mobile apps, and portfolios\u003c/strong\u003e, this versatile set ensures your designs remain consistent, elegant, and instantly recognizable.\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003e1246 unique icons\u003c/strong\u003e across multiple categories\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eVector-based \u0026amp; fully scalable\u003c/strong\u003e without losing quality\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eCustomizable colors\u003c/strong\u003e to match your brand\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eLightweight, minimal design\u003c/strong\u003e for faster loading and a polished UI\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eTailored for Framer\u003c/strong\u003e, but easily adaptable to other platforms\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eIdeal for \u003cstrong\u003ewebsites, SaaS, agencies, and creative portfolios\u003c/strong\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003eWhether you need to highlight features, improve navigation, or add visual clarity, this icon set helps your websites stand out while keeping the focus on your content.\u003c/p\u003e6b:T4f8,\u003cp\u003e\u003cstrong\u003eA flexible and expandable collection of social media icons designed for websites, mobile apps, UI projects, branding, and marketing assets. Available in three styles—original brand colors, solid color versions, and clean outlines—each icon is fully editable and optimized for modern design workflows. Free to use, regularly updated with new icons, and e\u003c/strong\u003e\u003c/p\u003e\u003cfigure\u003e\u003cimg src=\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/vector-sets/description-image-9npksm5w-sLyMKUgwsX6Gz9KKLQLin62T4rXcqM\" alt=\"\"\u003e\u003c/figure\u003e\u003cfigure\u003e\u003cimg src=\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/vector-sets/description-image-9npksm5w-zsSxa6VkHT1mE40OjfDOxpJY7cSzo1\" alt=\"\"\u003e\u003c/figure\u003e\u003cp\u003e\u003cstrong\u003easy to customize to match any creative direction.\u003c/strong\u003e\u003c/p\u003e\u003ch2\u003eKey Features:\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eFree to use\u003c/strong\u003e for personal and commercial projects\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eThree styles included:\u003c/strong\u003e original, solid color, and outline\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eFully editable\u003c/strong\u003e to match any brand or theme\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eRegular updates\u003c/strong\u003e with new and trending social media platforms\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003ePerfect for \u003c/strong\u003ewebsites, apps, dashboards, mock ups, presentations, and digital marketing assets\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e6c:T570,\u003cp\u003e\u003cstrong\u003eBrutalist Geometric Seamless Icon Shapes Volume 6\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eDesigned by \u003cstrong\u003eNazcraft\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eKey Design Elements:\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eAesthetic Style:\u003c/strong\u003e The collection leans heavily into brutalist, Y2K, retro-futuristic, and techno-industrial design aesthetics.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eShape Variety:\u003c/strong\u003e The grid features a diverse array of optical illusions, impossible objects, sharp tribal-style spikes, and concentric geometric spirals.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eLine Work:\u003c/strong\u003e The structures are built using incredibly clean and precise linework. They range from bold, heavy, solid geometric blocks to intricate, fine-line wireframe constructions.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eStandout Motifs:\u003c/strong\u003e Abstract multi-pointed stars, mesmerizing swirling vortexes, interconnected circular loops, isometric perspective grids, a linear heart shape, and a stylized, geometric recycling symbol.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eSymmetry and Op-Art:\u003c/strong\u003e Many of the shapes rely on radial symmetry and optical art techniques, using repeating lines to create a sense of depth, motion, or 3D tunneling effects.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003eNeed Help?\u003c/p\u003e\u003cp\u003eIf you have any questions, trouble downloading your files, or need an invoice, just reply directly to this email or reach out to us at \u003ca href=\"mailto:zainanazlan@gmail.com\"\u003ezainanazlan@gmail.com\u003c/a\u003e\u003c/p\u003e6d:Tc54,\u003cp\u003eThis collection is a comprehensive, precision-crafted toolkit designed for modern web developers and designers. Featuring \u003cstrong\u003eover 110 icons\u003c/strong\u003e, it bridges the gap between traditional social media, emerging AI platforms, and the latest fintech tools. Each asset is optimized for high-performance integration into websites, apps, and digital portfolios.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e1. SOCIAL MEDIA \u0026amp; NETWORKING\u003c/strong\u003eThe core of your digital presence, covering everything from legacy giants to 2026’s fastest-growing communities.\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eFacebook\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eInstagram\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eX (Twitter)\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eLinkedIn\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eTikTok\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eThreads\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSnapchat\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePinterest\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eReddit\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eMastodon\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eBluesky\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eTumblr\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eDiscord\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eMessenger\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eWeChat\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eWhatsApp\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eTelegram\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSignal\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e2. AI, TECH \u0026amp; INNOVATION\u003c/strong\u003eFuture-proof your designs with the world’s leading Artificial Intelligence and technical toolsets.\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eChatGPT\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eGemini\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eClaude\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePerplexity\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eMidjourney\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eGithub\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eNotion\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSlack\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFigma\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFramer\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eMetaMask\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eBitcoin\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eEthereum\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eQR Code\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eWiFi\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eWeb\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e3. COMMERCE, PAYMENTS \u0026amp; FINANCE\u003c/strong\u003eEssential assets for e-commerce checkouts, SaaS platforms, and modern fintech interfaces.\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eAmazon\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eApple Pay\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eGoogle Pay\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePayPal\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eStripe\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eWise\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCashApp\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eVenmo\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eRevolut\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eShopify\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eEtsy\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eGumroad\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eLemonSqueezy\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eMercado Libre\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eEbay\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e4. LIFESTYLE, TRAVEL \u0026amp; FOOD\u003c/strong\u003ePerfect for service-based websites, travel blogs, and localized delivery apps.\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eAirbnb\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eUber Eats\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eDeliveroo\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eDoordash\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eGrubhub\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eInstacart\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eChowNow\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePedidos Ya\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eRappi\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eWolt\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eTripAdvisor\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eYelp\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eOpen Table\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eThe Fork\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCouchsurfing\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eMap\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e5. ENTERTAINMENT \u0026amp; CREATIVE UTILITY\u003c/strong\u003eDedicated profiles for creators, streamers, and multimedia enthusiasts.\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eYouTube\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eYouTube Music\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSpotify\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eApple Music\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eApple Podcasts\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSoundcloud\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eTwitch\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eVimeo\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eBehance\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eDribble\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePatreon\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSubstack\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCanva\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFreepik\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eLottie\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eZoom\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003eBrands change and new apps pop up all the time. I’ll try to keep this list updated when I have the chance!\u003c/p\u003e6e:T6c9,\u003cp\u003eThere are hundreds of icon libraries, but most are low-quality, designed for Illustrator, or simply too small – often all three. We couldn’t find a Framer icon library we loved, so we made one ourselves.\u003c/p\u003e\u003cp\u003eEnjoy customizable stroke weights, lifetime updates, and effortless adaptation to any project. Perfect your designs with a tool trusted by +4k professionals.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eDiscover a Framer Library Driven by Variants:\u003c/strong\u003e Over 1,500 smooth and cohesive icons across 2 styles, meticulously crafted with attention to detail.\u003c/p\u003e\u003ch2\u003eNo Limits: Perfect for Paid Framer Templates and Commercial Projects.\u003c/h2\u003e\u003cp\u003e\u003cstrong\u003eAre you a Framer Paid Templates Creator, or just want to use them in your commercial web projects? Go ahead – there are no limits.\u003c/strong\u003e\u003c/p\u003e\u003ch2\u003e2 Styles\u003c/h2\u003e\u003cp\u003e• Classic Line \u003c/p\u003e\u003cp\u003e• Duocolor\u003c/p\u003e\u003ch2\u003eOver 25 different categories\u003c/h2\u003e\u003cp\u003e• Popular – 135 Icons \u003c/p\u003e\u003cp\u003e• Files – 75 Icons \u003c/p\u003e\u003cp\u003e• Alerts – 28 Icons \u003c/p\u003e\u003cp\u003e• Communication – 123 Icons \u003c/p\u003e\u003cp\u003e• User – 79 Icons \u003c/p\u003e\u003cp\u003e• Maps \u0026amp; Travel – 75 Icons \u003c/p\u003e\u003cp\u003e• Time \u0026amp; Date – 45 Icons \u003c/p\u003e\u003cp\u003e• Arrows – 91 Icons \u003c/p\u003e\u003cp\u003e• Charts – 47 Icons \u003c/p\u003e\u003cp\u003e• Media \u0026amp; Devices – 120 Icons\u003c/p\u003e\u003cp\u003e• Security – 53 Icons \u003c/p\u003e\u003cp\u003e• Images – 35 Icons \u003c/p\u003e\u003cp\u003e• AI – 43 Icons \u003c/p\u003e\u003cp\u003e• Development – 47 Icons \u003c/p\u003e\u003cp\u003e• Holidays – 30 Icons \u003c/p\u003e\u003cp\u003e• Shapes – 15 Icons\u003c/p\u003e\u003cp\u003e• Design \u0026amp; Layout – 160 Icons \u003c/p\u003e\u003cp\u003e• Education – 37 Icons \u003c/p\u003e\u003cp\u003e• Building – 30 Icons \u003c/p\u003e\u003cp\u003e• Finance \u0026amp; Shopping – 105 Icons \u003c/p\u003e\u003cp\u003e• Weather – 75 Icons \u003c/p\u003e\u003cp\u003e• Extensions – 10 Icons \u003c/p\u003e\u003cp\u003e• Laundry – 44 Icons \u003c/p\u003e\u003cp\u003e• Food – 60 Icons \u003c/p\u003e\u003cp\u003e• Brands – 22 Icons\u003c/p\u003e4b:[\"$\",\"div\",null,{\"className\":\"resource-listing-module-scss-module__5st7MW__gridAnchor\",\"id\":\"marketplace-grid\",\"children\":[[\"$\",\"$L4d\",null,{\"anchorId\":\"marketplace-grid\"}],[\"$\",\"$8\",null,{\"fallback\":[\"$\",\"$L4e\",null,{\"category\":\"$undefined\",\"fallbackData\":{\"data\":[{\"id\":\"uWr8hAFmgFMnsP6uerh6\",\"resolved\":true,\"title\":\"Social + AI Icons\",\"body\":\"\u003cp\u003eClean social media and AI brand icons in color and solid styles for modern websites, apps, and SaaS products.\u003c/p\u003e\u003ch3\u003eDetails\u003c/h3\u003e\u003cp\u003eModern and consistent social + AI brand icons designed for clean UI systems.\u003c/p\u003e\u003cp\u003eIncludes:\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e90+ icons\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eColor \u0026amp; solid versions\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eScalable vector format\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eReady for web and mobile\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch3\u003eFuture Updates\u003c/h3\u003e\u003cp\u003eNew social platforms and AI tools will be added over time.Free updates included.\u003c/p\u003e\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Clean social media and AI brand icons in color and solid styles for modern websites, apps, and SaaS products.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Details\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Modern and consistent social + AI brand icons designed for clean UI systems.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Includes:\"}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"90+ icons\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Color \u0026 solid versions\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Scalable vector format\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Ready for web and mobile\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Future Updates\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"New social platforms and AI tools will be added over time.Free updates included.\"}]}]},\"introduction\":\"social and AI brand icons\",\"slug\":\"social-ai-brand-icons\",\"author\":{\"framerUserId\":\"f80a15fa-e4be-4492-872d-e5912e1de472\",\"name\":\"mehul\",\"slug\":\"justmehul\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/f80a15fa-e4be-4492-872d-e5912e1de472/7x1q6wbi\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/vector-sets/social-ai-brand-icons/lak6z9ip-VN