unt\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2025-10-09T19:26:16.387Z\",\"updatedAt\":\"2025-10-13T10:48:49.817Z\",\"publishedAt\":\"2025-10-13T10:48:49.817Z\",\"featuredAt\":\"2026-06-04T09:33:58.368Z\",\"reported\":false,\"approvedAt\":null,\"type\":\"vector\",\"attributes\":{\"url\":\"https://framer.com/m/Visa-RHsd.js@mH9NPruSSKQ451aKBmKQ\",\"price\":null,\"paymentUrl\":null,\"vectorCount\":42,\"categories\":[{\"id\":\"65fa91ad-4375-40c0-8b72-1cc71f2f4000\",\"name\":\"Business\",\"slug\":\"business\"}]}},{\"id\":\"a5o2h9EMXJINlGrrdDhh\",\"resolved\":true,\"title\":\"Padel Players\",\"body\":\"\u003cp\u003eA collection of modern flat padel player illustrations designed for websites, landing pages, presentations, mobile apps, and marketing materials. Fully editable vector graphics with clean shapes and consistent styling.\u003c/p\u003e\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"A collection of modern flat padel player illustrations designed for websites, landing pages, presentations, mobile apps, and marketing materials. Fully editable vector graphics with clean shapes and consistent styling.\"}]}]},\"introduction\":\"Modern Sports Illustrations\",\"slug\":\"padel-players\",\"author\":{\"framerUserId\":\"037025ae-12ec-4ec4-82df-ff2f0421e06f\",\"name\":\"Yoga Apriyanto\",\"slug\":\"yoga-apriyanto\",\"avatar\":null,\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/037025ae-12ec-4ec4-82df-ff2f0421e06f/w4gle9a6\",\"metadata\":{\"tint\":\"hsl(228 94% 25%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/037025ae-12ec-4ec4-82df-ff2f0421e06f/tau7kace\",\"metadata\":{\"tint\":\"hsl(228 94% 25%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019f08bb-b1b0-7748-974d-4750b05bd957\",\"bodyJson\":null,\"likes\":{\"count\":3,\"liked\":false},\"comments\":{\"count\":2},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-06-27T10:59:06.218Z\",\"updatedAt\":\"2026-06-27T10:59:06.218Z\",\"publishedAt\":\"2026-06-27T10:59:06.212Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"vector\",\"attributes\":{\"url\":null,\"price\":\"3\",\"paymentUrl\":\"https://yogaapr.lemonsqueezy.com/checkout/buy/4ea62ea1-07d9-4274-b572-a7ede10cf549\",\"vectorCount\":6,\"categories\":[{\"id\":\"78e55a4a-220e-474c-9a7f-690f940cb1de\",\"name\":\"Illustrations\",\"slug\":\"illustrations\"}]}},{\"id\":\"gW7ToyzFHPpw2Eu9IBLS\",\"resolved\":true,\"title\":\"Hand-Drawn Wireframe\",\"body\":\"$51\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Hand-Drawn Wireframe \u0026 UI Annotation Vector Pack\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Add a human touch, playful energy, and organic visual emphasis to your digital layouts with this comprehensive collection of \"},{\"type\":\"text\",\"text\":\"hand-drawn arrows, scribbles, math symbols, UI badges, and handwritten callout words\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\". Perfect for wireframing, design presentations, marketing assets, and interactive website overlays.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"milky_way\",\"emoji\":\"🌌\"}},{\"type\":\"text\",\"text\":\" What It Includes\"}],\"attrs\":{\"level\":1}},{\"type\":\"customHeading\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"bow_and_arrow\",\"emoji\":\"🏹\"}},{\"type\":\"text\",\"text\":\" Hand-Drawn Arrows \u0026 Directional Indicators (\"},{\"type\":\"text\",\"text\":\"arrows.png\",\"marks\":[{\"type\":\"code\"}]},{\"type\":\"text\",\"text\":\")\"}],\"attrs\":{\"level\":2}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Dynamic Curved \u0026 Looped Arrows:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Wave paths, spiral turns, zig-zags, sharp angles, and sweeping direction pointers.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Dashed \u0026 Dotted Lines:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Motion-path arrows, dashed trajectories, and segmented step-by-step pointers.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Varied Endings \u0026 Styles:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Simple stroke tips, solid arrowhead ends, and organic sketch weights.\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"pencil2\",\"emoji\":\"✏\"}},{\"type\":\"text\",\"text\":\" Highlight Scribbles, Underlines \u0026 Swirls (\"},{\"type\":\"text\",\"text\":\"highlight.png\",\"marks\":[{\"type\":\"code\"}]},{\"type\":\"text\",\"text\":\")\"}],\"attrs\":{\"level\":2}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Emphasis Lines \u0026 Underlines:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Multi-stroke scribbles, double underlines, cross-hatched strike-throughs, and quick accent lines.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Tornadoes \u0026 Swirls:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Spiral focus indicators, cloud-like loops, and decorative wave flourishes for drawing visual attention.\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"1234\",\"emoji\":\"🔢\"}},{\"type\":\"text\",\"text\":\" Math, Currency \u0026 Geometric Shapes (\"},{\"type\":\"text\",\"text\":\"math and finance.png\",\"marks\":[{\"type\":\"code\"}]},{\"type\":\"text\",\"text\":\")\"}],\"attrs\":{\"level\":2}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Global Currency Symbols:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Hand-sketched Dollar ($), Euro (€), Cent (¢), Rupee (₹), and Yen (¥) signs.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Mathematical Notations:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Numbers 0–9, basic operators (+, −, ÷, =), brackets \"},{\"type\":\"text\",\"text\":\"( )\",\"marks\":[{\"type\":\"code\"}]},{\"type\":\"text\",\"text\":\" and \"},{\"type\":\"text\",\"text\":\"{ }\",\"marks\":[{\"type\":\"code\"}]},{\"type\":\"text\",\"text\":\", infinity ($\\\\infty$), percentage (%), and inequality symbols ($\\\\neq$, $\u003c$, $\u003e$).\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Basic Geometry:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Hand-drawn circles, triangles, and squares for framing content and creating custom badges.\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"sparkles\",\"emoji\":\"✨\"}},{\"type\":\"text\",\"text\":\" UI Accents, Emoticons \u0026 Icons (\"},{\"type\":\"text\",\"text\":\"symbols.png\",\"marks\":[{\"type\":\"code\"}]},{\"type\":\"text\",\"text\":\")\"}],\"attrs\":{\"level\":2}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Emphasis Sparkles \u0026 Stars:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" 4-point glints, traditional stars, burst accents, and lightning bolts.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Interactive UI Markers:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Checkmarks, crosses (X), heart icons, bookmarks, paper planes, location flags, speech quotes, and music notes.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Hand-Drawn Expressive Faces:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Happy, neutral, and sad smiley faces alongside exclamation points and question marks.\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Made with \"},{\"type\":\"emoji\",\"attrs\":{\"name\":\"yellow_heart\",\"emoji\":\"💛\"}},{\"type\":\"text\",\"text\":\" by \"},{\"type\":\"mention\",\"attrs\":{\"id\":\"cdbd7ebc-86d4-4b64-baea-421f236c7c35\",\"slug\":\"karim-saif\",\"label\":\"Karim Saif\",\"mentionSuggestionChar\":\"@\"}},{\"type\":\"text\",\"text\":\" \"}]}]},\"introduction\":\"hand-drawn arrows, scribbles, math\",\"slug\":\"hand-drawn-wireframe\",\"author\":{\"framerUserId\":\"cdbd7ebc-86d4-4b64-baea-421f236c7c35\",\"name\":\"Karim Saif\",\"slug\":\"karim-saif\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/38316/JKMR4LgEt-1ogBJEJjcXu0BLVSwyn9DCkQ64JbBx\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/cdbd7ebc-86d4-4b64-baea-421f236c7c35/019fb15e-c2f5-7108-9f80-97975187e08e.png\",\"metadata\":{\"tint\":\"hsl(34 89% 44%)\",\"aspectRatio\":1.5}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/cdbd7ebc-86d4-4b64-baea-421f236c7c35/019fb15e-c370-7721-8722-7ceb4a74ff7b.png\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.6}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/cdbd7ebc-86d4-4b64-baea-421f236c7c35/019fb15e-c29f-737b-bb6e-d721a9896c33.png\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.25}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/cdbd7ebc-86d4-4b64-baea-421f236c7c35/019fb15c-3aec-7156-baa0-b3f758659ff6.png\",\"metadata\":{\"tint\":\"hsl(34 89% 44%)\",\"aspectRatio\":1.5}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/cdbd7ebc-86d4-4b64-baea-421f236c7c35/019fb15e-c2e4-7666-80c3-94172e7ab995.png\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1}}],\"post\":{\"id\":\"019fafaf-bd2f-718e-bb8f-4f62a4fd49dd\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Authentic Hand-Drawn Aesthetic:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Natural stroke variations and organic pen pressure give designs a clean, modern doodle feel.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Fully Scalable Vector Format:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Infinite resolution clarity for web, mobile apps, social media graphics, and print assets.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Versatile Wireframing Toolkit:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Ideal for annotating design concepts, pointing out UI features, or adding casual micro-interactions to Framer websites.\"}]}]},\"likes\":{\"count\":16,\"liked\":false},\"comments\":{\"count\":2},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-07-29T21:02:37.392Z\",\"updatedAt\":\"2026-07-30T04:53:55.158Z\",\"publishedAt\":\"2026-07-29T21:02:37.387Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"vector\",\"attributes\":{\"url\":null,\"price\":\"5\",\"paymentUrl\":\"https://karimsaif.lemonsqueezy.com/checkout\",\"vectorCount\":152,\"categories\":[{\"id\":\"84561d79-3c93-47b8-88cc-3ecfa4a60f69\",\"name\":\"UI\",\"slug\":\"ui\"}]}},{\"id\":\"fk4DoZj40nSJQPaNSVbH\",\"resolved\":true,\"title\":\"Brand Icons-Color\",\"body\":\"\u003cp\u003eA curated collection of 150+ scalable brand logos in primary color. Use them to showcase integrations, case studies, or social links. Organized and easy to copy directly into your Framer projects.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003ePreview with examples:\u003c/strong\u003e \u003ca target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://brandicons.framer.website\\\"\u003ebrandicons.framer.website\u003c/a\u003e\u003c/p\u003e\u003cp\u003eNote: All logos are trademarks of their respective owners\u003c/p\u003e\",\"bodyJson\":null,\"introduction\":\"150+ brand logomark in original colors. Perfect for integrations, case studies, or social links in your Framer sites.\",\"slug\":\"brand-icons-color\",\"author\":{\"framerUserId\":\"022c5f63-967c-4ac1-9f6c-27023b26660e\",\"name\":\"Aravind Solaiappan\",\"slug\":\"aravind\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/288945/9IMCbisRG-RiAUqzj3Uz8GTfStJ2VmaZGIAqZ72J\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/vector-sets/brand-icons-color/ytpg9xn2-Ck9e2sEulynvNFpCMiTzQoj0U429FS\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/vector-sets/brand-icons-color/2zfcd49s-EGdXUJsVF3IDoNDr0nRW3agLDna3K2\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019a0118-491d-780e-8610-fbdf2ccf3988\",\"bodyJson\":null,\"likes\":{\"count\":40,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2025-10-14T16:34:21.290Z\",\"updatedAt\":\"2025-10-29T06:52:35.258Z\",\"publishedAt\":\"2025-10-20T10:09:20.157Z\",\"featuredAt\":\"2026-06-04T09:37:28.125Z\",\"reported\":false,\"approvedAt\":null,\"type\":\"vector\",\"attributes\":{\"url\":\"https://framer.com/m/Apple-Ql6k.js@BaLr3FJod8OZuupa1In2\",\"price\":null,\"paymentUrl\":null,\"vectorCount\":155,\"categories\":[{\"id\":\"fa19b5a7-a3be-4f68-9ba4-25800d07d1a3\",\"name\":\"Logos\",\"slug\":\"logos\"}]}},{\"id\":\"fXL7OWNaLEqtioutrf1a\",\"resolved\":true,\"title\":\"Aarrows\",\"body\":\"\u003cp\u003eInstead of relying on your fonts to have / render a nice arrow glyph, just use a vector: Easy to use, no line height mismatch, \u0026amp; infinitely scaleable.\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eNice sharp corners (missing from most icon packs)\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eJust arrows, no flipping through 500 unused icons\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eRotate or flip for the orientation you need\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"bodyJson\":null,\"introduction\":\"Five sharp / rounded arrows, nothing else.\",\"slug\":\"aarrows\",\"author\":{\"framerUserId\":\"da29ad77-d6f0-4a5b-bd3b-e749d8b1ffc6\",\"name\":\"Aaron Rolston\",\"slug\":\"aaron-rolston\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/da29ad77-d6f0-4a5b-bd3b-e749d8b1ffc6/xxsfm2kc\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/vector-sets/aarrows/h6r866b2-yZKgWDptmfwZwG83PNS3aG2CwIHwvr\",\"metadata\":{\"tint\":\"hsl(0 0% 9%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/vector-sets/aarrows/96a14koh-Ufq2XgCUWmwfRADUO7HTz4BOppZaVX\",\"metadata\":{\"tint\":\"hsl(0 0% 9%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019a314d-cad2-7264-9b9d-e68b37cc1c77\",\"bodyJson\":null,\"likes\":{\"count\":37,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2025-10-20T17:43:01.998Z\",\"updatedAt\":\"2025-11-03T15:45:29.640Z\",\"publishedAt\":\"2025-10-29T18:49:33.138Z\",\"featuredAt\":\"2026-06-04T09:59:44.033Z\",\"reported\":false,\"approvedAt\":null,\"type\":\"vector\",\"attributes\":{\"url\":\"https://framer.com/m/Wide-Ykpz.js@HmwZsRjTc8DtH8At0TIi\",\"price\":null,\"paymentUrl\":null,\"vectorCount\":10,\"categories\":[{\"id\":\"fa50aa41-372e-4622-9ef3-edf6db436dfe\",\"name\":\"Arrows\",\"slug\":\"arrows\"}]}},{\"id\":\"P9CG7EUCbDguBTkYuBkX\",\"resolved\":true,\"title\":\"simple clouds\",\"body\":\"\u003ch2\u003e\u003cspan data-type=\\\"emoji\\\" data-name=\\\"cloud\\\"\u003e☁\u003c/span\u003e\u003cspan data-type=\\\"emoji\\\" data-name=\\\"cloud\\\"\u003e☁\u003c/span\u003e\u003cspan data-type=\\\"emoji\\\" data-name=\\\"cloud\\\"\u003e☁\u003c/span\u003e\u003c/h2\u003e\u003cp\u003eCalm and simple, just like a cloud on a bright sunny day.\u003c/p\u003e\u003cp\u003eA little set of cloud vectors for when your design needs a soft, dreamy touch. Use them for websites, social posts, presentations, illustrations, or wherever you feel like putting them :)\u003c/p\u003e\u003cp\u003eFully customizable fill and stroke properties, so you can easily tweak them to fit your design.\u003c/p\u003e\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"customHeading\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"cloud\",\"emoji\":\"☁\"}},{\"type\":\"emoji\",\"attrs\":{\"name\":\"cloud\",\"emoji\":\"☁\"}},{\"type\":\"emoji\",\"attrs\":{\"name\":\"cloud\",\"emoji\":\"☁\"}}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Calm and simple, just like a cloud on a bright sunny day.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"A little set of cloud vectors for when your design needs a soft, dreamy touch. Use them for websites, social posts, presentations, illustrations, or wherever you feel like putting them :)\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Fully customizable fill and stroke properties, so you can easily tweak them to fit your design.\"}]}]},\"introduction\":\"customizable minimal vector clouds\",\"slug\":\"simple-clouds\",\"author\":{\"framerUserId\":\"9c273af1-eeb1-4522-ac13-25a1c52e70d7\",\"name\":\"Blanche Peralta\",\"slug\":\"blancheperalta\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/9c273af1-eeb1-4522-ac13-25a1c52e70d7/1s07g0s0\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/9c273af1-eeb1-4522-ac13-25a1c52e70d7/01a01992-d8f0-749a-83ba-c31e73ec5e72.png\",\"metadata\":{\"tint\":\"hsl(200 80% 24%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/9c273af1-eeb1-4522-ac13-25a1c52e70d7/01a01992-da62-7148-ad50-cdf9ffd0d523.png\",\"metadata\":{\"tint\":\"hsl(200 80% 24%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/9c273af1-eeb1-4522-ac13-25a1c52e70d7/01a01992-d8f0-754f-80cb-3b07c3943868.png\",\"metadata\":{\"tint\":\"hsl(200 80% 24%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/9c273af1-eeb1-4522-ac13-25a1c52e70d7/01a01992-d915-752e-a38e-5a4b8ba05e81.png\",\"metadata\":{\"tint\":\"hsl(200 80% 24%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"01a01897-b801-7329-bc34-17aa1470e169\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"cloud\",\"emoji\":\"☁\"}},{\"type\":\"emoji\",\"attrs\":{\"name\":\"cloud\",\"emoji\":\"☁\"}},{\"type\":\"emoji\",\"attrs\":{\"name\":\"cloud\",\"emoji\":\"☁\"}}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Feeling like a cloud lately.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Calm and simple, floating around on a bright, sunny day.\"}]}]},\"likes\":{\"count\":10,\"liked\":false},\"comments\":{\"count\":2},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-08-19T05:56:30.719Z\",\"updatedAt\":\"2026-08-19T10:31:00.038Z\",\"publishedAt\":\"2026-08-19T05:56:30.710Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"vector\",\"attributes\":{\"url\":\"https://framer.com/m/Cloud-01-G5S2UN.js@963fOUWHOuK5Mnc4nrCn\",\"price\":null,\"paymentUrl\":null,\"vectorCount\":24,\"categories\":[{\"id\":\"89c679b1-87fd-4d3a-830c-c029d9c86011\",\"name\":\"Shapes\",\"slug\":\"shapes\"}]}},{\"id\":\"9RTqH3BZ6ql6h8DwfJgK\",\"resolved\":true,\"title\":\"Creativity Illos Set\",\"body\":\"\u003cp\u003e\u003cstrong\u003eCreativity — \u003cem\u003eSet of 10 Illustrations\u003c/em\u003e\u003c/strong\u003e is a hand-crafted vector pack made to bring warmth and originality to your digital projects.Each illustration is fully vector-based, color-customizable, and optimized for web — under 50KB per file.\u003c/p\u003e\u003cp\u003ePerfect for marketing websites, creative studios, SaaS platforms, or portfolio templates that need a human touch.All ten illustrations are showcased in the promo images above — what you see is exactly what you get.\u003c/p\u003e\u003cp\u003eAdd your brand colors, and your creative identity is ready to go.\u003c/p\u003e\",\"bodyJson\":null,\"introduction\":\"10 hand-drawn illustration pack exploring creativity and imagination. Fully vector-based illustrations for your website or template.\",\"slug\":\"creativity-illos-set\",\"author\":{\"framerUserId\":\"967c673f-62c0-4d73-a492-c1b3bb1190ee\",\"name\":\"Ivan Haidutski\",\"slug\":\"ivan-haidutski\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/741410/avatar-hr4FFjHMsUA6YDBMhraGkRoetfHcCk.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/vector-sets/creativity-illos-pac/nmdvetd1-5kCdtmy9qgl4q4uFmu9NIhYJpFukTx\",\"metadata\":{\"tint\":\"hsl(168 36% 22%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/vector-sets/creativity-illos-set/y02tr31d-hHW9GHMUkZsXJ2bCRowN1ACrPfsIle\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/vector-sets/creativity-illos-set/njky96cj-lcnH7HVsnnuKE49DYziiZeUJEw8CdV\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/vector-sets/creativity-illos-set/v7snbjir-vZaSxYuwNth2Ge6sa7fJqkY1RuaqI5\",\"metadata\":{\"tint\":\"hsl(69 59% 31%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019a396e-f6f2-74c0-b0e1-9216c23ba31a\",\"bodyJson\":null,\"likes\":{\"count\":20,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2025-10-22T18:15:05.019Z\",\"updatedAt\":\"2025-10-31T08:42:44.850Z\",\"publishedAt\":\"2025-10-31T08:42:44.850Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"vector\",\"attributes\":{\"url\":null,\"price\":\"39\",\"paymentUrl\":\"https://buy.polar.sh/polar_cl_zZqabD5EMWYjlM4y3JiYyNqPNnN2E0l5GEqlS42HP8T\",\"vectorCount\":10,\"categories\":[{\"id\":\"78e55a4a-220e-474c-9a7f-690f940cb1de\",\"name\":\"Illustrations\",\"slug\":\"illustrations\"}]}},{\"id\":\"c5UxwUoolu9wovqfngNT\",\"resolved\":true,\"title\":\"Hamburger Set\",\"body\":\"\u003cp\u003eThe Hamburger Set consists of individual components such as the buns, patties, lettuce, tomato, cheese, and egg. These components have been set up with variable color settings. Although the general colors are established for food items, you can adjust the color scheme to match your website's design, for example, by modifying the saturation or even transforming the entire set into a monochrome look.\u003c/p\u003e\",\"bodyJson\":null,\"introduction\":\"A fun and appetizing hamburger set designed to bring a friendly and delicious look to your Framer projects. Perfect for playful layouts or food-themed sites.\",\"slug\":\"hamburger-sets\",\"author\":{\"framerUserId\":\"d1dff73b-8bf5-4ebb-a23b-5332bada924d\",\"name\":\"日香理 / hikari\",\"slug\":\"hikari-template\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/492120/avatar-uytCLZVoEDDT5YrOh9eZuN2hFUQace.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/vector-sets/hamburger-sets/zv1v1las-XgaD338DDXsqcBx1h2irJjZkMCwedC\",\"metadata\":{\"tint\":\"hsl(0 0% 9%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/vector-sets/hamburger-sets/s4edjuoq-D7ziUNO5Amg65fKLfwOz2F9YdKdJ9a\",\"metadata\":{\"tint\":\"hsl(0 0% 9%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/vector-sets/hamburger-sets/x6fbx2hw-pTTgwJ6fxSs1yu2cnVQW7zfX4gUBhA\",\"metadata\":{\"tint\":\"hsl(0 0% 9%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/vector-sets/hamburger-sets/0s1h71ue-agyH2su2lD8ywozlMUWmzLNFgLDDUc\",\"metadata\":{\"tint\":\"hsl(0 0% 9%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"0199e20f-dbca-7077-af12-948b24fe3fae\",\"bodyJson\":null,\"likes\":{\"count\":13,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2025-10-13T15:31:31.974Z\",\"updatedAt\":\"2025-11-12T01:58:45.940Z\",\"publishedAt\":\"2025-10-14T09:31:54.186Z\",\"featuredAt\":\"2026-06-04T09:33:06.119Z\",\"reported\":false,\"approvedAt\":null,\"type\":\"vector\",\"attributes\":{\"url\":null,\"price\":\"5\",\"paymentUrl\":\"https://hikari-graphics.lemonsqueezy.com/buy/a3d15b9c-f084-4cc0-bc05-ec39745fcac7\",\"vectorCount\":35,\"categories\":[{\"id\":\"7e6e2aca-859c-43af-a4c8-39e8d343ced6\",\"name\":\"Lifestyle\",\"slug\":\"lifestyle\"}]}},{\"id\":\"vv8qGGd7w3fBQgx7SAjf\",\"resolved\":true,\"title\":\"Organic Shapes\",\"body\":\"\u003cp\u003eA handcrafted set of \u003cstrong\u003e70 abstract vector shapes\u003c/strong\u003e with natural, imperfect edges. Designed to bring an organic feel to your layouts — ideal for branding, hero sections, posters, and creative compositions.\u003c/p\u003e\u003cp\u003eEach shape is \u003cstrong\u003efully vector-based\u003c/strong\u003e, \u003cstrong\u003ecolor-customizable\u003c/strong\u003e, and \u003cstrong\u003eweb-optimized\u003c/strong\u003e (SVG under 5 KB). Mix, overlap, and experiment to build expressive visuals that feel human and dynamic.\u003c/p\u003e\",\"bodyJson\":null,\"introduction\":\"A handcrafted collection of 70 abstract vector shapes with natural, irregular edges.\",\"slug\":\"organic-shapes\",\"author\":{\"framerUserId\":\"967c673f-62c0-4d73-a492-c1b3bb1190ee\",\"name\":\"Ivan Haidutski\",\"slug\":\"ivan-haidutski\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/741410/avatar-hr4FFjHMsUA6YDBMhraGkRoetfHcCk.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/vector-sets/organic-shapes/psu0cq2m-3LXmrAhQwoh9aSUjaJKxI9yeSI1kUf\",\"metadata\":{\"tint\":\"hsl(0 0% 9%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/vector-sets/organic-shapes/erpmk5ne-khmY3oAlM4qsmt4oWfG3YIAnbT8Tzb\",\"metadata\":{\"tint\":\"hsl(0 0% 36%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/vector-sets/organic-shapes/8m6tkhcb-7ZmUQZ35kweG1a1WFwK4t39zPhs85w\",\"metadata\":{\"tint\":\"hsl(0 0% 36%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/vector-sets/organic-shapes/wefribgs-Gl7AUXtLMloqGH2wFTf3GpQEVjGYG4\",\"metadata\":{\"tint\":\"hsl(0 0% 9%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019a96cb-301d-70fe-9a25-1a942ac1d546\",\"bodyJson\":null,\"likes\":{\"count\":25,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2025-11-05T16:52:59.671Z\",\"updatedAt\":\"2025-11-18T11:48:09.885Z\",\"publishedAt\":\"2025-11-18T11:48:09.885Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"vector\",\"attributes\":{\"url\":null,\"price\":\"19\",\"paymentUrl\":\"https://buy.polar.sh/polar_cl_18bcQUL4UTZJZOGLyeTvGegAvsF0SPyMnAUn01Cfhh0\",\"vectorCount\":70,\"categories\":[{\"id\":\"89c679b1-87fd-4d3a-830c-c029d9c86011\",\"name\":\"Shapes\",\"slug\":\"shapes\"}]}},{\"id\":\"3ODZHJWGDQhxygTciLaI\",\"resolved\":true,\"title\":\"Dotted Icons\",\"body\":\"\u003cp class=\\\"editor_paragraph__IOT_o\\\"\u003eThis set includes a collection of dotted icons with a simple, techy look. Each icon is made from evenly spaced dots.\u003c/p\u003e\u003cp class=\\\"editor_paragraph__IOT_o\\\"\u003eAll icons are vector-based, scalable, and fully customizable. You can easily adjust color and size to match your brand or project style.\u003c/p\u003e\",\"bodyJson\":null,\"introduction\":\"A minimal vector set of dotted icons for clean, modern interfaces. Fully editable and easy to use.\",\"slug\":\"dotted-icons\",\"author\":{\"framerUserId\":\"2a425ad9-c342-4590-af3c-88a1f3875e22\",\"name\":\"Sanna Granqvist\",\"slug\":\"sanna-granqvist\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/2a425ad9-c342-4590-af3c-88a1f3875e22/a2khusgj\",\"badges\":[\"pro\"],\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/vector-sets/dotted-icons/xdt5qtk5-IBHUNLB4ktfqBhXTWI6OLlR1Egm889\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/vector-sets/dotted-icons/rijl9i82-3GWn7qhiEkfFB3t6ShACCEOMCMVycx\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019a01d8-7718-75d3-8e62-ada49bc9f9c1\",\"bodyJson\":null,\"likes\":{\"count\":54,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2025-10-19T12:19:22.395Z\",\"updatedAt\":\"2025-10-20T13:39:14.840Z\",\"publishedAt\":\"2025-10-20T13:39:14.840Z\",\"featuredAt\":\"2026-07-03T10:44:49.726Z\",\"reported\":false,\"approvedAt\":null,\"type\":\"vector\",\"attributes\":{\"url\":\"https://framer.com/m/X-g4Yd.js@sybIxhk1A7mKkTzqpFnr\",\"price\":null,\"paymentUrl\":null,\"vectorCount\":28,\"categories\":[{\"id\":\"3535507e-b041-4f48-be7f-a084b14e30b2\",\"name\":\"Icons\",\"slug\":\"icons\"}]}},{\"id\":\"iEKW2RDz74kr5auM3YEW\",\"resolved\":true,\"title\":\"Folders\",\"body\":\"\u003ch2\u003eGive your site that Organised feeling with folders\u003c/h2\u003e\u003cp\u003ePerfect for creating digital design collages.\u003c/p\u003e\u003ch2\u003eFour folder symbols based on 4 different operating systems\u003c/h2\u003e\u003col\u003e\u003cli\u003e\u003cp\u003eWindows 95\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eWindows 7\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eWindows 11\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003emacOS\u003c/p\u003e\u003c/li\u003e\u003c/ol\u003e\u003cp\u003eWindows 11 includes 16 colour variants\u003c/p\u003e\u003cp\u003emacOS includes 8 colour variants\u003c/p\u003e\u003cp\u003e\u003cem\u003eColours are gradients and, as such, are not customisable.\u003c/em\u003e\u003c/p\u003e\",\"bodyJson\":null,\"introduction\":\"Folder icons based on Windows 95, 7, and 11, as well as macOS. Windows 11 includes 16 and macOS has 8 colour variants. Perfect if you want to make your page feel like a desktop.\",\"slug\":\"folders\",\"author\":{\"framerUserId\":\"a06c31fc-f719-4fa1-bb01-1dd92fb1aa33\",\"name\":\"Harrison Adam Cole\",\"slug\":\"crimson\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/1468697/avatar-pGffuJDVWmuVdWSjBjZ96zEUhDSJts.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/vector-sets/folders/sb8yi9p9-EAUmQuSwuq82SMr4Vm4HFHaN0VzSyq\",\"metadata\":{\"tint\":\"hsl(0 0% 58%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/vector-sets/folders/32d5nvcy-pLdkClmLm60K7lHjlFODzqq8qbGUJB\",\"metadata\":{\"tint\":\"hsl(90 67% 9%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019a48cf-8552-7eab-afcf-c4ba53982a0c\",\"bodyJson\":null,\"likes\":{\"count\":16,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2025-10-24T09:25:54.747Z\",\"updatedAt\":\"2025-11-03T08:22:30.994Z\",\"publishedAt\":\"2025-11-03T08:22:30.994Z\",\"featuredAt\":\"2026-06-04T09:31:30.453Z\",\"reported\":false,\"approvedAt\":null,\"type\":\"vector\",\"attributes\":{\"url\":null,\"price\":\"5\",\"paymentUrl\":\"https://buy.stripe.com/00w6oHaLT3FU2Qidiq0VO03\",\"vectorCount\":18,\"categories\":[{\"id\":\"3535507e-b041-4f48-be7f-a084b14e30b2\",\"name\":\"Icons\",\"slug\":\"icons\"}]}},{\"id\":\"ayLydqdaLlqIXUvZO2dC\",\"resolved\":true,\"title\":\"Nautical Emblems\",\"body\":\"$52\",\"bodyJson\":null,\"introduction\":\"A handcrafted set of 65 Nordic-style nautical emblems. Fully vector, scalable, and customisable in Framer with stroke, colour, background, and opacity controls.\",\"slug\":\"nautical\",\"author\":{\"framerUserId\":\"4d4d9333-ef11-4e84-9c52-2a026fb91e1f\",\"name\":\"Lee Black\",\"slug\":\"leeblack\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/72198/avatar-tITRI6fWrDA7ScuROCY5fJUlpsKNXj.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/vector-sets/nautical/tlwnwdml-WyiyQcjOACw6zicQdt24R9tYtIOZbb\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/vector-sets/nautical/783agbat-Swyj9RGrHeSoJ3Zz3oYS0VQ4A7UJOB\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/vector-sets/nautical/v4mz1p7g-wLomhTAeg0HcW5KtBny3nRRp07OXXZ\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/vector-sets/nautical/kctsfjnh-gtnHGE96tCeVgKMSHGHvMHusaMgi2I\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"0199c293-2992-7b73-9f31-32c055234ab8\",\"bodyJson\":null,\"likes\":{\"count\":12,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2025-10-07T16:32:35.097Z\",\"updatedAt\":\"2026-01-25T21:36:56.557Z\",\"publishedAt\":\"2025-10-08T06:47:28.402Z\",\"featuredAt\":\"2026-06-04T09:36:02.788Z\",\"reported\":false,\"approvedAt\":null,\"type\":\"vector\",\"attributes\":{\"url\":null,\"price\":\"20\",\"paymentUrl\":\"https://www.1042.studio/store/nautical-illustrations\",\"vectorCount\":65,\"categories\":[{\"id\":\"89c679b1-87fd-4d3a-830c-c029d9c86011\",\"name\":\"Shapes\",\"slug\":\"shapes\"}]}},{\"id\":\"zTRnX9cyl9bUi5vgXPbY\",\"resolved\":true,\"title\":\"Solar Duotone Icons\",\"body\":\"$53\",\"bodyJson\":null,\"introduction\":\"1215 beautifully crafted, minimalistic duotone icons designed to elevate your Framer websites, ensuring they stand out with clarity, elegance, and style.\",\"slug\":\"solar-duotone\",\"author\":{\"framerUserId\":\"92be7f14-ead0-4819-9ec1-801ef213ad57\",\"name\":\"Driss Chelouati\",\"slug\":\"driss-chelouati\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/1006739/avatar-yx9AbkfOG8MhVDMs0aC1rCZ4tDWJvf.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/vector-sets/solar-duotone/4zr9l4dl-XqPBS3dxRvBdkEhy3roTQbJ7zzdDef\",\"metadata\":{\"tint\":\"hsl(255 82% 73%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/vector-sets/solar-duotone/0w6jferi-5RA2x0ALqkNIT2k9zrI6N68WMLbzAP\",\"metadata\":{\"tint\":\"hsl(255 82% 73%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"0199bdd4-bb73-7b0b-9d38-de24284d7376\",\"bodyJson\":null,\"likes\":{\"count\":19,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2025-10-06T14:56:38.921Z\",\"updatedAt\":\"2025-10-08T16:06:29.267Z\",\"publishedAt\":\"2025-10-07T08:40:59.507Z\",\"featuredAt\":\"2026-06-04T09:32:03.698Z\",\"reported\":false,\"approvedAt\":null,\"type\":\"vector\",\"attributes\":{\"url\":\"https://framer.com/m/Moon-Sleep-AJ2z.js@uTT2xGVuam48QAGJle2G\",\"price\":null,\"paymentUrl\":null,\"vectorCount\":1215,\"categories\":[{\"id\":\"3535507e-b041-4f48-be7f-a084b14e30b2\",\"name\":\"Icons\",\"slug\":\"icons\"}]}},{\"id\":\"ekgN2U1ZABQ2OBFFB4Q5\",\"resolved\":true,\"title\":\"LogoVault\",\"body\":\"\u003cp\u003eLogoVault is a large collection of 535 clean, scalable logo vectors made for Framer projects.\u003c/p\u003e\u003cp\u003eUse it to quickly build integration sections, partner logo grids, client mockups, SaaS landing pages, pricing pages, dashboards, portfolios, and presentation-style layouts without hunting for low-quality logo files online.\u003c/p\u003e\u003cp\u003eEvery vector is organized for fast browsing and easy use inside Framer. The pack is ideal for designers, developers, agencies, freelancers, and template creators who want a ready-to-use logo library directly inside their workflow.\u003c/p\u003e\u003cp\u003eWhat’s included:\u003c/p\u003e\u003cp\u003e• 535 logo vectors\u003c/p\u003e\u003cp\u003e• Clean SVG/vector format\u003c/p\u003e\u003cp\u003e• Easy to use inside Framer\u003c/p\u003e\u003cp\u003e• Great for logo clouds, integrations, partner sections, dashboards, and landing pages\u003c/p\u003e\u003cp\u003e• Scalable and lightweight\u003c/p\u003e\u003cp\u003e• Organized for faster design work\u003c/p\u003e\u003cp\u003eNote: Brand logos remain the property of their respective owners. This set is intended for design, UI, mockup, and presentation use.\u003c/p\u003e\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"LogoVault is a large collection of 535 clean, scalable logo vectors made for Framer projects.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Use it to quickly build integration sections, partner logo grids, client mockups, SaaS landing pages, pricing pages, dashboards, portfolios, and presentation-style layouts without hunting for low-quality logo files online.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Every vector is organized for fast browsing and easy use inside Framer. The pack is ideal for designers, developers, agencies, freelancers, and template creators who want a ready-to-use logo library directly inside their workflow.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"What’s included:\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• 535 logo vectors\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Clean SVG/vector format\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Easy to use inside Framer\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Great for logo clouds, integrations, partner sections, dashboards, and landing pages\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Scalable and lightweight\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Organized for faster design work\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Note: Brand logos remain the property of their respective owners. This set is intended for design, UI, mockup, and presentation use.\"}]}]},\"introduction\":\"535 logo vectors\",\"slug\":\"logovault\",\"author\":{\"framerUserId\":\"a94b6059-641e-47a7-ac50-cb207146c23b\",\"name\":\"Rabyaan Khan\",\"slug\":\"rabyaan\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/a94b6059-641e-47a7-ac50-cb207146c23b/t3nuyef3\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/a94b6059-641e-47a7-ac50-cb207146c23b/embtfbeo\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/a94b6059-641e-47a7-ac50-cb207146c23b/dn9mdp2e\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019ee2f8-ad14-75b3-9a78-00c7aa132e09\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"535 logo vectors\"}]}]},\"likes\":{\"count\":10,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-06-20T03:00:08.572Z\",\"updatedAt\":\"2026-06-20T03:00:08.572Z\",\"publishedAt\":\"2026-06-20T03:00:08.568Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"vector\",\"attributes\":{\"url\":null,\"price\":\"6\",\"paymentUrl\":\"https://buy.polar.sh/polar_cl_WYcWzuFj6pzM9aGHM9kK9RoYQo2mIT1N8347u3Xo4bk\",\"vectorCount\":535,\"categories\":[{\"id\":\"fa19b5a7-a3be-4f68-9ba4-25800d07d1a3\",\"name\":\"Logos\",\"slug\":\"logos\"}]}},{\"id\":\"ISMyRdyFK5pBmUdu73Pc\",\"resolved\":true,\"title\":\"Halloween Icon Set\",\"body\":\"\u003cp\u003eBring spooky charm to your next project with this \u003cstrong\u003eHalloween Icon Pack\u003c/strong\u003e, featuring \u003cstrong\u003e20 handcrafted icons\u003c/strong\u003e in \u003cstrong\u003etwo versatile styles: Outline and Filled\u003c/strong\u003e. Designed with a playful, modern aesthetic, these icons are perfect for seasonal websites, landing pages, mobile apps, dashboards, games, social media, presentations, and more.\u003c/p\u003e\u003cp\u003eEach icon is carefully crafted with clean geometry, consistent proportions, and a cohesive visual style, making it easy to mix and match across any Halloween-themed design.\u003c/p\u003e\u003ch2\u003eWhat\u0026#39;s Included\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cspan data-type=\\\"emoji\\\" data-name=\\\"jack_o_lantern\\\"\u003e🎃\u003c/span\u003e 20 unique Halloween icons\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cspan data-type=\\\"emoji\\\" data-name=\\\"sparkles\\\"\u003e✨\u003c/span\u003e 2 styles: Outline \u0026amp; Filled\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cspan data-type=\\\"emoji\\\" data-name=\\\"art\\\"\u003e🎨\u003c/span\u003e Consistent visual language\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cspan data-type=\\\"emoji\\\" data-name=\\\"triangular_ruler\\\"\u003e📐\u003c/span\u003e Pixel-perfect vector design\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Bring spooky charm to your next project with this \"},{\"type\":\"text\",\"text\":\"Halloween Icon Pack\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\", featuring \"},{\"type\":\"text\",\"text\":\"20 handcrafted icons\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" in \"},{\"type\":\"text\",\"text\":\"two versatile styles: Outline and Filled\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\". Designed with a playful, modern aesthetic, these icons are perfect for seasonal websites, landing pages, mobile apps, dashboards, games, social media, presentations, and more.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Each icon is carefully crafted with clean geometry, consistent proportions, and a cohesive visual style, making it easy to mix and match across any Halloween-themed design.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"What's Included\"}],\"attrs\":{\"level\":1}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"jack_o_lantern\",\"emoji\":\"🎃\"}},{\"type\":\"text\",\"text\":\" 20 unique Halloween icons\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"sparkles\",\"emoji\":\"✨\"}},{\"type\":\"text\",\"text\":\" 2 styles: Outline \u0026 Filled\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"art\",\"emoji\":\"🎨\"}},{\"type\":\"text\",\"text\":\" Consistent visual language\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"triangular_ruler\",\"emoji\":\"📐\"}},{\"type\":\"text\",\"text\":\" Pixel-perfect vector design\"}]}]}]}]},\"introduction\":\"Halloween Icons: Outline \u0026 Fill\",\"slug\":\"halloween-icon-set\",\"author\":{\"framerUserId\":\"75f99