"content\":[{\"type\":\"text\",\"text\":\"Doodle Callouts \u0026 Speech Bubbles\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" is a charm-filled vector element collection crafted to add human warmth, informal notes, and expressive visual commentary to your landing pages, marketing banners, and editorial layouts. Featuring clean line work and minimalist typography spaces, these hand-drawn assets seamlessly blend functional annotation with playful aesthetics.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"What it does\"}],\"attrs\":{\"level\":2}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Expressive Callout Styles:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Features a versatile mix of rounded speech bubbles, cloud-like thought bubbles, sleek underline brackets, and dynamic swirl accents.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Minimalist Line-Art Aesthetics:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Clean, high-contrast outlines that adapt beautifully to light, dark, and gradient backgrounds.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Flexible Layout Formatting:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Designed to house custom text overlays, tooltips, team callouts, or inline user feedback highlights.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Vector Precision:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Scalable graphics that maintain crisp edges across all screen densities and frame sizes.\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Great for\"}],\"attrs\":{\"level\":2}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Playful Landing Pages:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Break up static layouts with casual product highlights, humorous notes, or conversational copy.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"User Feedback \u0026 Testimonials:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Highlight customer quotes and reviews using warm, approachable speech bubbles.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Product Tour Tooltips:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Point out features, onboarding tips, or quick actions with engaging visual pointers.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Social Media \u0026 Hero Graphics:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Add energetic, human-centric visual accents to promotional banners and marketing creatives.\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"What you can customize\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Easily tweak and adapt every element to fit your design system:\"}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Text Content \u0026 Typography\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" — Overlay any custom font, weight, or copy inside the speech frames\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Stroke \u0026 Outline Colors\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" — Match line colors directly to your brand palette or light/dark mode themes\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Scale \u0026 Orientation\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" — Flip, scale, or rotate brackets and callouts to point precisely at UI targets\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Fill \u0026 Background\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" — Keep transparent line art or apply custom backdrop fills and glassmorphism blurs\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Need help?\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Have questions or feature suggestions? Reach out anytime at \"},{\"type\":\"text\",\"text\":\"karimsaif010@gmail.com\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"mailto:karimsaif010@gmail.com\",\"target\":\"_blank\"}}]},{\"type\":\"text\",\"text\":\" or on X \"},{\"type\":\"text\",\"text\":\"@karimsaif0\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener\",\"href\":\"https://x.com/karimsaif0\",\"target\":\"_blank\"}}]},{\"type\":\"text\",\"text\":\".\"}]}]},\"introduction\":\"Speech bubbles, thought clouds\",\"slug\":\"speech-bubbles-demo\",\"author\":{\"framerUserId\":\"cdbd7ebc-86d4-4b64-baea-421f236c7c35\",\"name\":\"Karim Saif\",\"slug\":\"karim-saif\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/38316/JKMR4LgEt-1ogBJEJjcXu0BLVSwyn9DCkQ64JbBx\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/cdbd7ebc-86d4-4b64-baea-421f236c7c35/019fc163-65b1-720e-8d16-1c8af95203f0.png\",\"metadata\":{\"tint\":\"hsl(195 82% 44%)\",\"aspectRatio\":1.5263157894736843}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.pub