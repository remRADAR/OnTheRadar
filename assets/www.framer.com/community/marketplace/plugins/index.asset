%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"01923265-2aa3-7741-b58f-b491ffbb894e\",\"bodyJson\":null,\"likes\":{\"count\":16,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2024-09-26T04:29:55.122Z\",\"updatedAt\":\"2026-03-30T04:21:09.688Z\",\"publishedAt\":\"2024-09-27T07:32:23.843Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"bjbnw8u1xiux4jmd8kbcvvgh2\",\"paid\":true,\"categories\":[{\"id\":\"c4868181-e303-4aac-8074-bd683d4debe8\",\"name\":\"E-Commerce\",\"slug\":\"ecommerce\"}]}},{\"id\":\"1071\",\"resolved\":true,\"title\":\"Type Bridge\",\"body\":\"$95\",\"bodyJson\":null,\"introduction\":\"Type Bridge\",\"slug\":\"type-bridge\",\"author\":{\"framerUserId\":\"e697cf7a-eb5e-4c6c-a612-96ddefc8d550\",\"name\":\"hicard\",\"slug\":\"hicard\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/1972727/avatar-XRdjHsFRuVTNJASBWA45SvrQiIP9bD.jpg\",\"badges\":[\"pro\"],\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/1071-aP3k4ZC9R8gog06TEoRGf95SVwba3J\",\"metadata\":{\"tint\":\"hsl(187 64% 22%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/1071-HMxmljloA1ydUipraxhnVYq5f5vgGJ\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/1071-zTWwqfkibt3qd1nYHfvIW9lbbA6U6n\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019dd988-c0f1-7d02-8970-095b3a7251e9\",\"bodyJson\":null,\"likes\":{\"count\":29,\"liked\":false},\"comments\":{\"count\":1},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-04-24T03:15:55.542Z\",\"updatedAt\":\"2026-04-30T00:10:22.179Z\",\"publishedAt\":\"2026-04-29T13:58:31.409Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"3owoz8h30m0c4rnsx5h6k8f7d\",\"paid\":false,\"categories\":[{\"id\":\"3fc802d9-7527-48e0-9403-c9bd534ab520\",\"name\":\"Utilities\",\"slug\":\"utilities\"}]}},{\"id\":\"266\",\"resolved\":true,\"title\":\"EFEX - Image Editor\",\"body\":\"\u003ch2\u003eOverview\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eEdit images with pro adjustment tools and filters\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAdd fun effects\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSave and load your own presets\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePlugin takes and keeps the original resolution of the image\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2\u003e🎨 Adjustments\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eVibrance\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSaturation\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eTemperature\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eHue\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eBrightness\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eContrast\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eHighlights\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eShadows\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eBlur\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePixelate\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSharpen\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSmooth\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2\u003e🚥 Effects\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eBlack \u0026amp; White (3 types)\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFriends\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eRetro\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eTuning\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePortrait\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFood\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eUrban\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eNature\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eInvert\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eMozak\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2\u003e💥 Upcoming features\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eAI Features\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAdvanced Filters\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eMore Effects\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eImage Edit tools (crop, flip, ...)\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"bodyJson\":null,\"introduction\":\"Free Image Editor\",\"slug\":\"efex-image-editor\",\"author\":{\"framerUserId\":\"47745ef1-855e-412c-a101-305ac078cd49\",\"name\":\"FrameSpace\",\"slug\":\"framespace\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/129533/avatar-CUOFZiJvUMrfCqPnaTe2BesapDWMrY.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/266-J7cqDHK6FnpcL6xkDPm0k9Gs0ZWK4N\",\"metadata\":{\"tint\":\"hsl(30 29% 22%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/266-i6tZ30R4lOcaACy4TIfBbvtizffyJO\",\"metadata\":{\"tint\":\"hsl(233 89% 14%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"0195eae9-df2f-74c9-858b-b19c4081bb7c\",\"bodyJson\":null,\"likes\":{\"count\":29,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2025-03-10T12:31:58.039Z\",\"updatedAt\":\"2026-08-05T07:17:38.041Z\",\"publishedAt\":\"2025-03-31T06:35:50.447Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"3n9819pf4p053sz5zfpjf3rmq\",\"paid\":false,\"categories\":[{\"id\":\"3fc802d9-7527-48e0-9403-c9bd534ab520\",\"name\":\"Utilities\",\"slug\":\"utilities\"},{\"id\":\"676f63da-b192-4974-930d-73185802088a\",\"name\":\"Assets\",\"slug\":\"assets\"},{\"id\":\"bde1e72b-b4a6-4ecc-8eee-417be77494e8\",\"name\":\"AI\",\"slug\":\"ai\"}]}},{\"id\":\"1476\",\"resolved\":true,\"title\":\"Dexter\",\"body\":\"$96\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Run Claude Code or Codex inside the Framer canvas, using the AI subscription you already pay for. Connected runs don't consume Framer AI credits, and every run reports tokens used and estimated provider cost.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Requires Claude Code or Codex installed locally.\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Setup takes one command.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Select a layer and describe the change. Dexter reads the relevant context, plans the work, applies real changes to the canvas, and shows progress as it happens with the option to redirect or stop a run mid-flight.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"With Dexter, you can:\"}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Create pages, sections, and components\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Edit layouts, copy, typography, colors, spacing, and images\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Connect Claude Code or Codex through a guided setup\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Follow planning, progress, and canvas changes\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Provide additional direction or stop an active run\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Review and undo supported changes\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Reopen conversations with their context and history\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"See reported token usage and estimated provider costs\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Use your existing AI subscription instead of paying for another one\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Connected Claude Code and Codex runs do not consume Framer AI credits. Your provider subscription, limits, and billing remain separate. Cost information is clearly marked as estimated when authoritative billing data is unavailable.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Support for more AI agents is coming soon.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Start with a 7-day free trial, then unlock lifetime access for a one-time $29 payment—no recurring Dexter subscription.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Learn more and watch Dexter in action:\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"https://dexterplugin.online\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"https://dexterplugin.online\",\"target\":\"_blank\"}}]}]}]},\"introduction\":\"Your AI agents inside the canvas\",\"slug\":\"dexter\",\"author\":{\"framerUserId\":\"f54ec92c-f3af-4ffc-8a97-8aed7dd24eeb\",\"name\":\"Brian Gakim\",\"slug\":\"brian-gakim\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/f54ec92c-f3af-4ffc-8a97-8aed7dd24eeb/kr8o9kv4\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/f54ec92c-f3af-4ffc-8a97-8aed7dd24eeb/01a038e1-b3fe-7355-a0a6-644405c39534.png\",\"metadata\":{\"tint\":\"hsl(0 0% 9%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/f54ec92c-f3af-4ffc-8a97-8aed7dd24eeb/01a02a90-48d7-748f-a6e5-77a4658d3026.png\",\"metadata\":{\"tint\":\"hsl(0 0% 9%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/f54ec92c-f3af-4ffc-8a97-8aed7dd24eeb/01a02a90-6b5b-7078-a3d3-21584544eea2.png\",\"metadata\":{\"tint\":\"hsl(0 0% 9%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"video\",\"url\":\"https://stream.mux.com/aMwTlxBeUF7Z3GnjUDUsVex898FK9AkkzkrFOhrEesA.m3u8\",\"metadata\":{\"posterUrl\":\"https://image.mux.com/aMwTlxBeUF7Z3GnjUDUsVex898FK9AkkzkrFOhrEesA/thumbnail.webp?time=11.667\",\"aspectRatio\":\"16:9\",\"duration\":19.066667}}],\"post\":{\"id\":\"019ffdd5-f814-726b-bf15-beefa7d4de3b\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Introducing Dexter for Framer\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Bring Claude Code and OpenAI Codex directly to your Framer canvas.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Create complete pages, sections, and components, redesign existing layouts, improve copy, and make real canvas changes using the AI subscriptions you already pay for.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Dexter also shows your reported token usage and estimated costs, so you can understand how every run spends your AI allowance.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Claude Code and Codex are supported today, with more agents coming soon.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Start with a 7-day free trial: \"},{\"type\":\"text\",\"text\":\"https://dexterplugin.online\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"https://dexterplugin.online\",\"target\":\"_blank\"}}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"I’d love to get feedback and continuously improving it.\"}]}]},\"likes\":{\"count\":7,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-08-14T01:14:45.579Z\",\"updatedAt\":\"2026-08-26T10:46:39.762Z\",\"publishedAt\":\"2026-08-26T10:46:39.749Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"evqqc8dbdva2lcz91rryz1gn2\",\"paid\":true,\"categories\":[{\"id\":\"b238ea64-0ce9-413a-848d-43b73f0eea0f\",\"name\":\"Design Workflow\",\"slug\":\"design-workflow\"},{\"id\":\"bde1e72b-b4a6-4ecc-8eee-417be77494e8\",\"name\":\"AI\",\"slug\":\"ai\"},{\"id\":\"d42b39e6-e921-4d46-be20-263eb61efbf9\",\"name\":\"Developers\",\"slug\":\"developers\"}]}},{\"id\":\"14\",\"resolved\":true,\"title\":\"Google Sheets\",\"body\":\"\u003ch2\u003eOverview\u003c/h2\u003e\u003cp\u003eEasily sync your Google Sheets content directly with Framer CMS. Simply paste your sheet URL, select which columns to map to each CMS field, and click import. Once synced, the Plugin will remember the connected sheet, and allow for syncing with one click, and easy field management. With support for Text, Formatted Text, Toggle, Color, Number, Image, Link, Date, and File field types you can easily sync a wide range of sheet use-cases into your Framer site.\u003c/p\u003e\u003ch2\u003eFeatures\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eOne click-syncing via the CMS Toolbar\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eEasy sheet selection via sheet dropdown\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eField mapping via the Manage button\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSupport for several field types\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"bodyJson\":null,\"introduction\":\"Sync with Google\",\"slug\":\"google-sheets\",\"author\":{\"framerUserId\":\"a7cd9fe6-cf81-4a41-8e93-bca0291dba80\",\"name\":\"Framer\",\"slug\":\"framer\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/107446/xpZr8yYS_400x400-2-MqZMjb2zlessnXickTqkyAzkfqz6le.jpg\",\"badges\":[\"framer\"],\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/14-xqeGJoIkR4A0FAH7kKlsxBBBPJkYMA\",\"metadata\":{\"tint\":\"hsl(150 70% 39%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/14-q5cgI7ekkk8vu0RtbwfReX473glohy\",\"metadata\":{\"tint\":\"hsl(160 90% 16%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"01923355-82bd-7df6-bc63-a7b045149177\",\"bodyJson\":null,\"likes\":{\"count\":38,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2024-09-25T18:36:28.695Z\",\"updatedAt\":\"2025-10-02T18:22:00.455Z\",\"publishedAt\":\"2024-09-27T11:54:55.037Z\",\"featuredAt\":\"2026-06-04T08:26:58.567Z\",\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"5i8ra6xs08ydg7wbx4nhndbn1\",\"paid\":false,\"categories\":[{\"id\":\"1ad3e7b2-bc61-42ce-b01a-7c8bb2278f1a\",\"name\":\"CMS\",\"slug\":\"cms\"}]}},{\"id\":\"86\",\"resolved\":true,\"title\":\"Frameblox\",\"body\":\"$97\",\"bodyJson\":null,\"introduction\":\"UI kit and template library\",\"slug\":\"frameblox\",\"author\":{\"framerUserId\":\"3e5e71d1-2797-4aea-832e-396f539086c1\",\"name\":\"Solt Wagner\",\"slug\":\"solt\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/34897/avatar-Dw7Es90hZZxtV6exw82xl2AlEAFD6x.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/86-Q1ehINy4caStYeLORL87r5qMsxRLxz\",\"metadata\":{\"tint\":\"hsl(30 70% 49%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/86-DFIllc9YmuHMiWCCNa8eonfSP7RLPB\",\"metadata\":{\"tint\":\"hsl(330 45% 36%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/86-e4KRaG9rDsKdgcPKmHwXThf8InpkDC\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/86-NabooeLifW0q8nYqvr91KC3Sr78EeL\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"01930c00-78e8-7c25-80c5-4dcb7a0601ef\",\"bodyJson\":null,\"likes\":{\"count\":10,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2024-10-17T08:05:28.868Z\",\"updatedAt\":\"2025-02-23T15:15:46.785Z\",\"publishedAt\":\"2024-11-08T13:39:37.832Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"3h08h75bkjprpjixajvrpd6gz\",\"paid\":true,\"categories\":[{\"id\":\"79a3568a-05f3-4f98-b70f-6c9ff9e301c4\",\"name\":\"UI Kits\",\"slug\":\"ui-kits\"}]}},{\"id\":\"865\",\"resolved\":true,\"title\":\"Image Compressor\",\"body\":\"$98\",\"bodyJson\":null,\"introduction\":\"Compress images to WebP\",\"slug\":\"image-compressor\",\"author\":{\"framerUserId\":\"78f6a1e4-1d3d-4193-adfb-1a9c0c9098fc\",\"name\":\"Melvin John\",\"slug\":\"melvin-thechief-designer\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/78f6a1e4-1d3d-4193-adfb-1a9c0c9098fc/t1diwknr\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/865-qhvLP4WwXejIrNTmLeBkBfnvNgabTM\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/865-7yjLmdTxJozgy7jTza3AEEC6HnjYy1\",\"metadata\":{\"tint\":\"hsl(0 0% 9%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/865-yU4SJW9lXtRIfy3W4q7qBexO1ATrEy\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/865-cSfZCQwtFdp1JLmapLem30bBz4cC8s\",\"metadata\":{\"tint\":\"hsl(240 53% 70%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019d0b93-c61a-7e29-86c4-09b75508a7de\",\"bodyJson\":null,\"likes\":{\"count\":29,\"liked\":false},\"comments\":{\"count\":1},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-03-08T15:52:16.941Z\",\"updatedAt\":\"2026-03-20T09:45:21.666Z\",\"publishedAt\":\"2026-03-20T14:08:47.130Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"ec3guoqxhghvxgqxn4aad3cu2\",\"paid\":false,\"categories\":[{\"id\":\"3fc802d9-7527-48e0-9403-c9bd534ab520\",\"name\":\"Utilities\",\"slug\":\"utilities\"}]}},{\"id\":\"683\",\"resolved\":true,\"title\":\"FramerFlo E-commerce\",\"body\":\"$99\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"FramerFlo brings complete e-commerce functionality to your Framer sites. Add a fully functional online store with product listings, shopping cart, checkout, and customer accounts — all without writing code.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"WHAT'S INCLUDED:\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Product Grid — Display products in a customizable, responsive grid\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Product Cards — Feature individual products anywhere on\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"your site\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Dynamic Product Pages — SEO-friendly product URLs with full details\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Shopping Cart — Cart button with badge + slide-out cart\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"drawer\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Checkout — Secure Stripe-powered checkout with shipping\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"\u0026 payment\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Customer Accounts — Login, registration, order history,\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"address book\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"KEY FEATURES:\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• 16 ready-to-use e-commerce components\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Supports product variants (size, color, etc.)\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Built-in search, filtering, and sorting\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Light and dark mode support\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Mobile responsive design\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Secure payments via Stripe, PayPal, or Square\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"REQUIREMENTS:\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• FramerFlo merchant account (free signup at \"},{\"type\":\"text\",\"text\":\"app.framerflo.com\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"http://app.framerflo.com\",\"class\":null,\"target\":\"_blank\"}}]},{\"type\":\"text\",\"text\":\")\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• FramerFlo subscription required after 7-day free trial\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"SETUP:\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"1. Sign up at \"},{\"type\":\"text\",\"text\":\"app.framerflo.com\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"http://app.framerflo.com\",\"class\":null,\"target\":\"_blank\"}}]},{\"type\":\"text\",\"text\":\" and add your products\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"2. Connect your Stripe account for payments\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"3. Install this plugin and log in\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"4. Add FramerFlo Config to your page, then add components\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Support: \"},{\"type\":\"text\",\"text\":\"framerflo.app@gmail.com\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"mailto:help@framerflo.com\",\"class\":null,\"target\":\"_blank\"}}]}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"API KEY \u0026 DATA:\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• FramerFlo stores your publishable API key and merchant ID in the browser (localStorage) so the storefront components can make product, cart, checkout, order, and account requests for your store.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• This is a publishable key, similar to a Stripe publishable key, and is meant to be used in the browser. It is limited in scope: it only authorizes public storefront operations and is bound to your store. It cannot access your account settings, payouts, payment processor secrets, or any other merchant's data. It is not your secret or admin key.\"}]}]},\"introduction\":\"FramerFlo - Ecommerce Plugin\",\"slug\":\"framerflo-e-commerce-q1mhroy0wndegm3vngpaiecqo\",\"author\":{\"framerUserId\":\"4cef5a21-df8b-48a8-80b4-aa4a2f80a0af\",\"name\":\"FamerFlo\",\"slug\":\"framerflo\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/707099/avatar-Q0BqQF3dWCeBzKM0Z9yGqaSecjoIIw.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/683-ecXptlZNq6AImEJFiodSPNksywPLrO\",\"metadata\":{\"tint\":\"hsl(160 75% 13%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/683-yTt1zHGg82780ToUfZMSHK8hLmT9Lw\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/683-sIxkZkeDFwoROPNSkyNEwLaGUKphTY\",\"metadata\":{\"tint\":\"hsl(0 0% 9%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/683-LoDdixiDJTT838DPs1bRKq6k4oG56V\",\"metadata\":{\"tint\":\"hsl(0 0% 9%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019b80af-105a-7da2-a441-74f1761b2d68\",\"bodyJson\":null,\"likes\":{\"count\":7,\"liked\":false},\"comments\":{\"count\":1},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2025-12-29T00:31:08.010Z\",\"updatedAt\":\"2026-08-12T04:05:46.807Z\",\"publishedAt\":\"2026-08-12T04:05:46.801Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"q1mhroy0wndegm3vngpaiecqo\",\"paid\":true,\"categories\":[{\"id\":\"c4868181-e303-4aac-8074-bd683d4debe8\",\"name\":\"E-Commerce\",\"slug\":\"ecommerce\"}]}},{\"id\":\"508\",\"resolved\":true,\"title\":\"Frame Audit\",\"body\":\"$9a\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"✅ Why Frame Audit?\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Frame Audit is your built-in quality partner.\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\"It automatically scans your template, flags missing requirements, and gives you a clear pass/fail breakdown. On top of that, you can run full Google PageSpeed tests directly inside Framer, no external tools required.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"🔑 Core Features\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"📋 \"},{\"type\":\"text\",\"text\":\"Marketplace Checklist Audit\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Flags missing meta tags, broken links, accessibility gaps, inconsistent styling, and unresponsive layouts.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Guarantees your template checks \"},{\"type\":\"text\",\"text\":\"every box\",\"marks\":[{\"type\":\"italic\"}]},{\"type\":\"text\",\"text\":\" before submission.\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"⚡ \"},{\"type\":\"text\",\"text\":\"Integrated Google PageSpeed Insights\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Test your template’s loading speed directly inside the plugin.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Get real-time insights into \"},{\"type\":\"text\",\"text\":\"Core Web Vitals\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\": performance, accessibility, best practices, and SEO.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Optimize before you submit—without switching tabs.\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"♿ \"},{\"type\":\"text\",\"text\":\"Accessibility Checker\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Detects missing alt text and accessibility issues.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Ensures your template is \"},{\"type\":\"text\",\"text\":\"usable for everyone\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" and marketplace-compliant.\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"🔍 \"},{\"type\":\"text\",\"text\":\"SEO Essentials\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Scans for proper meta titles, descriptions, canonical tags, and heading structure.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Improves discoverability and drives more organic traffic to your templates.\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"📱 \"},{\"type\":\"text\",\"text\":\"Responsiveness Validator\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Checks your template across all breakpoints.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Guarantees a flawless experience on every device.\"}]},{\"type\":\"paragraph\"}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"🌟 Benefits at a Glance\"}],\"attrs\":{\"level\":2}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Accessibility = More Reach. \",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\"Inclusive templates perform better and stand out in the marketplace.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"SEO = More Visibility \",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\"Built-in SEO checks help your templates rank, attract traffic, and boost sales.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Responsiveness = Better Reviews \",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\"A seamless experience across devices leads to happier customers and higher ratings.\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"🎯 Who It’s For\"}],\"attrs\":{\"level\":2}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Template Creators\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" who wants publish quality templates and better sales.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Freelancers \u0026 Agencies\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" delivering premium, marketplace-compliant Framer sites.\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"🏆 Why Top Creators Love It\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Frame Audit isn’t just a plugin. It’s your silent QA partner—catching details you might overlook and giving you confidence that your template is \"},{\"type\":\"text\",\"text\":\"marketplace-ready, fast, and optimized to sell.\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"👉 \"},{\"type\":\"text\",\"text\":\"Install Frame Audit today. Ship faster. Sell more.\",\"marks\":[{\"type\":\"bold\"}]}]}]},\"introduction\":\"Frame Audit\",\"slug\":\"frame-audit\",\"author\":{\"framerUserId\":\"be6b4bcb-7be2-4441-8600-7543be534f87\",\"name\":\"Bicky Gurung\",\"slug\":\"bickyg\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/28816/avatar-DvXocL0qByuK5JGN74G2T7Y75UVg6i.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/508-fT2sQQK9xQd3Ew2dxX2EXpYkAfCNbs\",\"metadata\":{\"tint\":\"hsl(225 62% 20%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/508-qpq21nIYcBuq5KaJID7Jc0lddm6SXe\",\"metadata\":{\"tint\":\"hsl(225 62% 20%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/508-v4hVQuZXw1vOtedVdap3HT7LDF8qp6\",\"metadata\":{\"tint\":\"hsl(225 62% 20%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/508-AUPxCMmr7jITkeV10iTiYGwfTKZTde\",\"metadata\":{\"tint\":\"hsl(225 62% 20%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"0199ee73-78fb-7e2c-a388-3f788184115e\",\"bodyJson\":null,\"likes\":{\"count\":19,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2025-09-16T17:40:01.161Z\",\"updatedAt\":\"2026-06-18T16:50:47.202Z\",\"publishedAt\":\"2025-10-16T19:16:09.083Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"97at74zhg1xb50xlx4lbpior7\",\"paid\":true,\"categories\":[{\"id\":\"3fc802d9-7527-48e0-9403-c9bd534ab520\",\"name\":\"Utilities\",\"slug\":\"utilities\"},{\"id\":\"9e4479a9-bb0e-4137-8ac0-4a975eb9b882\",\"name\":\"SEO\",\"slug\":\"seo\"},{\"id\":\"b238ea64-0ce9-413a-848d-43b73f0eea0f\",\"name\":\"Design Workflow\",\"slug\":\"design-workflow\"}]}},{\"id\":\"10\",\"resolved\":true,\"title\":\"CMS Export\",\"body\":\"\u003ch2\u003eOverview\u003c/h2\u003e\u003cp\u003eEffortlessly manage and transfer your collections with the CSV Export plugin for Framer. This tool allows you to export any CMS collection as a CSV file, making it easier to handle data outside of Framer.\u003c/p\u003e\u003ch2\u003eExport CMS Collections\u003c/h2\u003e\u003cp\u003eEasily export any Framer collection into a CSV file for external use. Whether you're managing large datasets or collaborating with other tools, CSV Export has you covered.\u003c/p\u003e\u003ch2\u003ePreview Before Exporting\u003c/h2\u003e\u003cp\u003eEnsure your data is accurate with the built-in preview feature. View your file before exporting to verify that all details are correct, saving you from potential errors.\u003c/p\u003e\u003ch2\u003eTransfer Data Between Projects\u003c/h2\u003e\u003cp\u003eCSV exports can be reimported into Framer CMS, making it a powerful tool for transferring collections between projects or backing up your work.\u003c/p\u003e\u003cp\u003eSimplify data management and ensure smooth project transitions with CSV Export.\u003c/p\u003e\",\"bodyJson\":null,\"introduction\":\"Export your collections\",\"slug\":\"cms-export\",\"author\":{\"framerUserId\":\"a7cd9fe6-cf81-4a41-8e93-bca0291dba80\",\"name\":\"Framer\",\"slug\":\"framer\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/107446/xpZr8yYS_400x400-2-MqZMjb2zlessnXickTqkyAzkfqz6le.jpg\",\"badges\":[\"framer\"],\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/10-igw6PBkjWlBMgiTyWqW1c8PM0Nugbp\",\"metadata\":{\"tint\":\"hsl(40 87% 41%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/10-QanaZXnSgDP1xf8M0QY8VDib60Azfu\",\"metadata\":{\"tint\":\"hsl(40 87% 41%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019276e7-cc08-75e8-bcfb-644c3f624d03\",\"bodyJson\":null,\"likes\":{\"count\":33,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2024-09-25T17:13:51.066Z\",\"updatedAt\":\"2024-09-30T08:20:17.307Z\",\"publishedAt\":\"2024-10-10T14:49:15.528Z\",\"featuredAt\":\"2026-06-04T08:28:03.920Z\",\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"6fd8zduyk5je9zsw5morqqldd\",\"paid\":false,\"categories\":[{\"id\":\"1ad3e7b2-bc61-42ce-b01a-7c8bb2278f1a\",\"name\":\"CMS\",\"slug\":\"cms\"}]}},{\"id\":\"1252\",\"resolved\":true,\"title\":\"Cookie PRO\",\"body\":\"$9b\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Cookie PRO\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"The ultimate cookie consent and privacy compliance solution for Framer.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Cookie PRO doesn't just show a banner — it actually blocks trackers. GA4, Meta Pixel, TikTok Pixel, and Google Tag Manager stay neutralized until your visitor consents, with full Google Consent Mode v2 support. Build GDPR and CCPA-compliant sites without compromising design, performance, or user experience.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Why Cookie PRO?\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Most cookie banners hide trackers behind a popup while they load anyway. Cookie PRO enforces consent at the script level, with real blocking, category-based control, and Consent Mode v2 built in.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Features\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Privacy \u0026 Compliance\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- GDPR \u0026 CCPA Compliance • Google Consent Mode v2 • Consent Category Management • Privacy Preference Center • Configurable Consent Expiration • Privacy-First Script Loading\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Script Blocking Engine\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- Real script blocking, not visual hiding • GA4, Meta Pixel \u0026 TikTok Pixel support • Google Tag Manager support • Custom script blocking for any third-party tag • Automatic activation on consent • Persistent consent across sessions\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Analytics \u0026 Marketing\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- GA4 \u0026 GTM Integration • Consent-Based Tracking • Automatic Consent Updates • Data Layer Integration\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Design \u0026 Customization\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- 7 Banner Positions \u0026 Layouts • Custom Colors \u0026 Typography • Border Radius \u0026 Spacing Controls • Logo \u0026 Branding Support • Custom Buttons \u0026 Links • Built-In Animations\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"User Experience\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- Mobile Optimized • Accessibility Focused • Multi-Language Support • Fast \u0026 Lightweight • Production Ready\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Perfect For\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- SaaS Products • Marketing Websites • Startups • Agencies • Client Projects • E-Commerce Stores • Landing Pages • Portfolios • Enterprise Websites\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Whether you're launching a startup or scaling a large business, Cookie PRO helps you implement real privacy compliance in minutes — trackers actually blocked, not just visually hidden.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Built for Framer. Trusted for Compliance. Engineered to Block.\"}]}]},\"introduction\":\"GDPR \u0026 CCPA Cookie Consent\",\"slug\":\"cookie-pro\",\"author\":{\"framerUserId\":\"05bf2ed6-af01-4680-a62b-5543ed36f569\",\"name\":\"Orix Studio\",\"slug\":\"orixstudio\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/1700793/avatar-uYH32XpwpPOgbRFzl7xUpL3fdAxHK3.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/1252-ufzv4hPR3upJ4EswO254KJlcfZq6OO\",\"metadata\":{\"tint\":\"hsl(249 94% 28%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/05bf2ed6-af01-4680-a62b-5543ed36f569/019fb71a-f6ba-74d5-a2c4-72315c81e9df.png\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/05bf2ed6-af01-4680-a62b-5543ed36f569/019fb71b-4f25-739a-ba46-5a96c342b2b0.png\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/05bf2ed6-af01-4680-a62b-5543ed36f569/019fb724-2c6c-72bc-a6ec-7bb1f178ecd2.png\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019ea90f-f24c-796e-a030-6fb2fef32483\",\"bodyJson\":null,\"likes\":{\"count\":27,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-06-07T09:50:53.410Z\",\"updatedAt\":\"2026-08-26T05:00:20.189Z\",\"publishedAt\":\"2026-08-03T12:53:23.406Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"txc9dl76j3hsp6dhm7tvqiqlw\",\"paid\":false,\"categories\":[{\"id\":\"3fc802d9-7527-48e0-9403-c9bd534ab520\",\"name\":\"Utilities\",\"slug\":\"utilities\"},{\"id\":\"d42b39e6-e921-4d46-be20-263eb61efbf9\",\"name\":\"Developers\",\"slug\":\"developers\"},{\"id\":\"f6795017-0256-4955-b31a-c81a28ef20ff\",\"name\":\"Integrations\",\"slug\":\"integrations\"}]}},{\"id\":\"1414\",\"resolved\":true,\"title\":\"Checkout Page\",\"body\":\"$9c\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Checkout Page\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer\",\"href\":\"https://checkoutpage.com\",\"target\":\"_blank\"}}]},{\"type\":\"text\",\"text\":\" lets you sell your products, subscriptions and event tickets on your Framer site.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Build fully customized checkout pages that match your branding.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Payments run through your own Stripe account, so money goes straight to you.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"What you can add\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Checkout pages for digital and physical products, subscriptions and pay what you want pricing\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Events with ticket types, add-ons and sales windows\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Forms for registration, lead gen and lead magnets\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Match your brand\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Checkout pages are fully themeable: your fonts, your colors, your corners, light or dark.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Theme them once in the Checkout Page dashboard and every buy button, embed and popup on your Framer site matches your brand.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"How it works\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"orderedList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Open the plugin and connect your Checkout Page account\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Select the checkout page, event or form you want to add\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Add a buy button, or embed the whole checkout on the page. Click to insert it, or drag it exactly where you want it.\"}]}]}],\"attrs\":{\"type\":null,\"start\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Inserted buy buttons are ordinary Framer components. Set the label, colors, radius, padding and border in the property panel, and choose whether the checkout opens in a pop-up or as a link.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Run more than one store? Connect them all and switch between them in the plugin.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"What you need\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"A Checkout Page account. The plugin will not show anything until you connect one, and you can create one from the plugin if you do not have it yet.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Pricing\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"The plugin is free.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Checkout Page itself has a Free plan covering up to $3,000 in sales a month, and paid plans from $29 a month. See \"},{\"type\":\"text\",\"text\":\"https://checkoutpage.com/pricing\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"https://checkoutpage.com/pricing\",\"target\":\"_blank\"}}]},{\"type\":\"text\",\"text\":\" for current pricing.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Support\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Help center: \"},{\"type\":\"text\",\"text\":\"https://checkoutpage.com/docs\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"https://checkoutpage.com/docs\",\"target\":\"_blank\"}}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Email: \"},{\"type\":\"text\",\"text\":\"support@checkoutpage.com\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"mailto:support@checkoutpage.com\",\"target\":\"_blank\"}}]}]}]},\"introduction\":\"Accept payments on your site\",\"slug\":\"checkout-page\",\"author\":{\"framerUserId\":\"328d1e54-926f-4718-8d81-2e1660534778\",\"name\":\"Sander Visser\",\"slug\":\"sander-visser\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/328d1e54-926f-4718-8d81-2e1660534778/4wfom6eq\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/328d1e54-926f-4718-8d81-2e1660534778/019fb14a-7fa3-755f-a468-f73750c2c21a.jpg\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/328d1e54-926f-4718-8d81-2e1660534778/019fb20d-30b3-741f-8bc9-854c42b7a3a9.jpg\",\"metadata\":{\"tint\":\"hsl(0 0% 9%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/328d1e54-926f-4718-8d81-2e1660534778/019fb14a-7f8b-7025-aa7c-b280ab315ad6.jpg\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/328d1e54-926f-4718-8d81-2e1660534778/019fb20d-5db8-748d-9187-8b87a4d7277d.jpg\",\"metadata\":{\"tint\":\"hsl(0 0% 9%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/328d1e54-926f-4718-8d81-2e1660534778/019fb14a-7ebe-777e-873c-3997f24a69ac.jpg\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019fb14a-ba46-7048-94c4-58d0e3dbe097\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Checkout Page is now on Framer.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Sell products, subscriptions, event tickets, services, and donations on your Framer site, with payments going straight to your own Stripe account.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Browse your pages in the plugin, then add buy buttons or embed the whole checkout without leaving the canvas. Checkouts are fully themeable, so they match your site.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Free to use.\"}]}]},\"likes\":{\"count\":23,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-07-30T04:31:32.082Z\",\"updatedAt\":\"2026-08-27T10:54:36.445Z\",\"publishedAt\":\"2026-08-27T10:54:36.439Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"75y1k1k5pml8z7z75r49f4dla\",\"paid\":false,\"categories\":[{\"id\":\"c4868181-e303-4aac-8074-bd683d4debe8\",\"name\":\"E-Commerce\",\"slug\":\"ecommerce\"},{\"id\":\"f6795017-0256-4955-b31a-c81a28ef20ff\",\"name\":\"Integrations\",\"slug\":\"integrations\"}]}},{\"id\":\"1116\",\"resolved\":true,\"title\":\"Stripe Payment Gateway\",\"body\":\"$9d\",\"bodyJson\":null,\"introduction\":\"Stripe payments for Framer\",\"slug\":\"stripe-payment-gateway\",\"author\":{\"framerUserId\":\"9bdea070-ea37-40d2-9943-455415b514f5\",\"name\":\"Khushal Dewra (KDX Studios)\",\"slug\":\"khushal-dewra\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/307637/avatar-NM7akQxU3JcJlme7gymEqznPAeT33L.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/9bdea070-ea37-40d2-9943-455415b514f5/snnc0v5e\",\"metadata\":{\"tint\":\"hsl(246 78% 30%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/1116-gnWblGhDW950J5slce2W5Q4e8NgH0e\",\"metadata\":{\"tint\":\"hsl(240 53% 70%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/1116-YXXpNQ4D61IEnIzQa2HK2uLyLcRE5g\",\"metadata\":{\"tint\":\"hsl(300 53% 63%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/1116-9yFnc02udnvfK181TtIphY9tkjpwHA\",\"metadata\":{\"tint\":\"hsl(246 92% 33%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019dfa17-9e20-7b37-84f1-e5ba1bc48363\",\"bodyJson\":null,\"likes\":{\"count\":12,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-05-04T10:22:03.269Z\",\"updatedAt\":\"2026-08-16T11:29:46.999Z\",\"publishedAt\":\"2026-08-16T11:29:46.991Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"cn9378ajzbdcqsjse5hodxp5x\",\"paid\":true,\"categories\":[{\"id\":\"c4868181-e303-4aac-8074-bd683d4debe8\",\"name\":\"E-Commerce\",\"slug\":\"ecommerce\"}]}},{\"id\":\"1514\",\"resolved\":true,\"title\":\"Full Site Export\",\"body\":\"$9e\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Framer has no HTML export and no self-hosting. Full Site Export reads your published site the way any visitor does, and gives it back as files you keep.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"THREE WAYS OUT\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Perfect Copy — a pixel-exact static copy of every page and asset. Upload it to any host. Block the network entirely and it still renders: images, fonts, video and CMS data are all local.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Exact (Next.js) — the same copy inside a Next.js project with real routes and a build. Identical rendering, including WebGL.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Readable (React / Next.js) — your pages rebuilt as components with their own stylesheet. Source you can edit.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"WHAT COMES WITH IT\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Every page, not one at a time\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• CMS collections, captured from what your site actually requests at runtime\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Scroll reveals, their stagger and looping marquees, re-emitted as CSS\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Framer's badge, editor bar and analytics stripped\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"WHAT IT CANNOT DO\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• The Readable export is close to your site, not pixel-identical. A component driven frame by frame — a WebGL background, for one — survives in the exact copies and not in the rebuilt source.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Your site must be published. An unpublished project has nothing to read.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• It does not change what you are licensed to own. Framer templates are sold under their own terms.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"ACCOUNT AND PRICING\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Three free exports of three pages each, with no account. After that, a licence key: $10 USD a month for 50 pages a month, or $99 USD a year, with a 7-day trial. Paste the key in the plugin's Settings — \\\"Clear licence key\\\" in the plugin menu removes it at any time.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"EXTERNAL SERVICE\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Exporting runs on our server at \"},{\"type\":\"text\",\"text\":\"api.getfull.site\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"http://api.getfull.site\",\"target\":\"_blank\"}}]},{\"type\":\"text\",\"text\":\", because reading a published site needs a real browser. Two things are sent: the address of your published site, and your licence key. Your Framer project is never uploaded.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Docs and support: \"},{\"type\":\"text\",\"text\":\"https://getfull.site\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"https://getfull.site\",\"target\":\"_blank\"}}]},{\"type\":\"text\",\"text\":\" — \"},{\"type\":\"text\",\"text\":\"hello@getfull.site\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"mailto:hello@getfull.site\",\"target\":\"_blank\"}}]}]}]},\"introduction\":\"Take your Framer site with you\",\"slug\":\"full-site-export\",\"author\":{\"framerUserId\":\"3bf6444d-9a1e-45ee-ab4a-19ebc6bd8443\",\"name\":\"stephen jan lovino\",\"slug\":\"stephen-jan-lovino\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/3bf6444d-9a1e-45ee-ab4a-19ebc6bd8443/95be1urn\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/3bf6444d-9a1e-45ee-ab4a-19ebc6bd8443/01a02c6e-2082-74e2-b1cc-b105003c0d12.png\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":0.5420689655172414}}],\"post\":{\"id\":\"01a02c4b-1719-723c-a7ab-93b85e44ec57\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Framer has no HTML export and no self-hosting. Full Site Export reads your published site the way a visitor does, and gives it back as files you keep.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Two ways out: a pixel-exact static copy of every page and asset that you can host anywhere — block the network entirely and it still renders — or the same pages rebuilt as React / Next.js source you can actually edit.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Your CMS collections come along too. Framer fetches them at runtime from URLs that appear nowhere in your page source, so the export records what your site actually asks for and ships it alongside the pages. Scroll reveals, their stagger and looping marquees are measured on the published site and re-emitted as CSS.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Three free exports, no account.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"One thing to know: it reads your published site, not the canvas. Hit Publish first — staging is enough.\"}]}]},\"likes\":{\"count\":2,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-08-23T01:45:13.206Z\",\"updatedAt\":\"2026-08-23T09:34:12.913Z\",\"publishedAt\":\"2026-08-23T09:34:12.890Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"1vg07rm7d85yx91u0qyseeolp\",\"paid\":true,\"categories\":[{\"id\":\"3fc802d9-7527-48e0-9403-c9bd534ab520\",\"name\":\"Utilities\",\"slug\":\"utilities\"},{\"id\":\"d42b39e6-e921-4d46-be20-263eb61efbf9\",\"name\":\"Developers\",\"slug\":\"developers\"}]}},{\"id\":\"1419\",\"resolved\":true,\"title\":\"Blink\",\"body\":\"$9f\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Blink\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer\",\"href\":\"https://blink.store/\",\"target\":\"_blank\"}}]},{\"type\":\"text\",\"text\":\" brings powerful, beautiful e-commerce to Framer. Effortlessly connect your Blink store to instantly drop fully functional \\\"Buy Now\\\" buttons right into your canvas and sync your Blink products with Framer CMS.\"}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"sparkles\",\"emoji\":\"✨\"}},{\"type\":\"text\",\"text\":\" Features:\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Overlay Checkouts\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\": Keep users on your site. Blink opens a stunning, frictionless checkout overlay directly over your Framer design without redirecting your customers.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Auto-Sync Products\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\": Connect your account to automatically import and sync your entire product catalog directly into the Framer CMS.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Fully Customizable\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\": Match your brand effortlessly by applying your custom Blink checkout templates straight inside Framer.\"}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Sell and grow on autopilot with \"},{\"type\":\"text\",\"text\":\"Blink\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer\",\"href\":\"https://blink.store/\",\"target\":\"_blank\"}}]},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"emoji\",\"attrs\":{\"name\":\"rocket\",\"emoji\":\"🚀\"}}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Drive more sales with automated cart recovery, built-in affiliate programs, revenue splits, broadcasts, real-time analytics, and frictionless checkouts.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Create your store → \"},{\"type\":\"text\",\"text\":\"https://blink.store/\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"https://blink.store/\",\"target\":\"_blank\"}}]}]}]},\"introduction\":\"Beautiful checkouts in Framer\",\"slug\":\"blink\",\"author\":{\"framerUserId\":\"b3e4728f-0e9d-4bd8-acfd-c1f9187d53a5\",\"name\":\"Clonify\",\"slug\":\"omarelabd\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/b3e4728f-0e9d-4bd8-acfd-c1f9187d53a5/o46pkds3\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/b3e4728f-0e9d-4bd8-acfd-c1f9187d53a5/019fbcd5-19d0-7448-a057-9f14e37695b3.jpg\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019fb7cc-7e27-715c-91a6-1d3b8c163412\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Selling on Framer just got a massive upgrade \"},{\"type\":\"emoji\",\"attrs\":{\"name\":\"zap\",\"emoji\":\"⚡\"}}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"️The official \"},{\"type\":\"text\",\"text\":\"Blink\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer\",\"href\":\"https://blink.store/\",\"target\":\"_blank\"}}]},{\"type\":\"text\",\"text\":\" plugin is now live!\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Drop native checkouts onto your canvas, auto-sync your product catalog, and put your growth on autopilot with cart recovery, affiliate tools, splits, broadcasts, and more!\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"sparkles\",\"emoji\":\"✨\"}},{\"type\":\"text\",\"text\":\" Switch to Blink and transform your Framer site into a high-converting storefront.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"→ https://blink.store/\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"https://blink.store/\",\"target\":\"_blank\"}}]}]}]},\"likes\":{\"count\":15,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-07-31T10:50:59.517Z\",\"updatedAt\":\"2026-08-01T10:37:04.425Z\",\"publishedAt\":\"2026-08-01T09:46:50.851Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"1tw5px22ad52samdc5mi3vw9j\",\"paid\":false,\"categories\":[{\"id\":\"1ad3e7b2-bc61-42ce-b01a-7c8bb2278f1a\",\"name\":\"CMS\",\"slug\":\"cms\"},{\"id\":\"3fc802d9-7527-48e0-9403-c9bd534ab520\",\"name\":\"Utilities\",\"slug\":\"utilities\"},{\"id\":\"c4868181-e303-4aac-8074-bd683d4debe8\",\"name\":\"E-Commerce\",\"slug\":\"ecommerce\"}]}},{\"id\":\"168\",\"resolved\":true,\"title\":\"VideoFrame\",\"body\":\"$a0\",\"bodyJson\":null,\"introduction\":\"Custom video players\",\"slug\":\"videoframe\",\"author\":{\"framerUserId\":\"ba90876b-848a-4d1c-bbe3-016394b0d57d\",\"name\":\"Insert Frame\",\"slug\":\"insertframe\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/101008/avatar-ehjigJp2l2cQ7XGmUkjNDaVqdk4Vag.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/168-uIL1v6bpiOHDivsvUOF5SPmGXFLrQL\",\"metadata\":{\"tint\":\"hsl(208 94% 25%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/168-Ikqz1SEaHx9xwSFUlvMKaTaPP9lLAQ\",\"metadata\":{\"tint\":\"hsl(240 53% 70%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/168-f6zwBF11P6QqyzE3lwHMX2vwFGXKLv\",\"metadata\":{\"tint\":\"hsl(210 80% 16%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/168-42eTD1H4y542JIgutUaMfVAcrEFLg8\",\"metadata\":{\"tint\":\"hsl(208 94% 25%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"0193b42c-f830-78fb-9bb1-3e7673aece4f\",\"bodyJson\":null,\"likes\":{\"count\":12,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2024-12-03T03:09:12.567Z\",\"updatedAt\":\"2026-04-01T02:19:16.356Z\",\"publishedAt\":\"2024-12-11T05:24:26.288Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"al61c2x7hui8svfpl46zk8gga\",\"paid\":true,\"categories\":[{\"id\":\"9e4479a9-bb0e-4137-8ac0-4a975eb9b882\",\"name\":\"SEO\",\"slug\":\"seo\"}]}},{\"id\":\"9\",\"resolved\":true,\"title\":\"Doodles\",\"body\":\"\u003ch2\u003eOverview\u003c/h2\u003e\u003cp\u003eUnleash your creativity with the Doodles plugin for Framer, letting you sketch directly on a freeform grid. Whether you want to add playful elements or unique illustrations, Doodles offers an intuitive drawing experience right within your project.\u003c/p\u003e\u003ch2\u003eFreeform Doodle Grid  \u003c/h2\u003e\u003cp\u003eDoodle freely with a pencil on an open grid, making it easy to draw organic, hand-drawn elements for your design. Add a personal, artistic touch to any project.\u003c/p\u003e\u003ch2\u003eFull Stroke Customization  \u003c/h2\u003e\u003cp\u003eCustomize your strokes with precise control over width, hue, saturation, and lightness. Tailor every line to your desired style, ensuring your doodles perfectly complement your overall design.\u003c/p\u003e\u003cp\u003eCreate playful, artistic elements that make your website stand out with the Doodles plugin, and bring a hand-crafted feel to your digital creations.\u003c/p\u003e\",\"bodyJson\":null,\"introduction\":\"Draw anything\",\"slug\":\"doodles\",\"author\":{\"framerUserId\":\"a7cd9fe6-cf81-4a41-8e93-bca0291dba80\",\"name\":\"Framer\",\"slug\":\"framer\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/107446/xpZr8yYS_400x400-2-MqZMjb2zlessnXickTqkyAzkfqz6le.jpg\",\"badges\":[\"framer\"],\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/9-2IYrwol4gMFEtuAdDWDi1YSQesugBV\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/9-WxeCMLm6H9adsHKfc8RFiDZc3e1Knz\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"01922a29-9900-783c-8c04-4c3eff8e6f2a\",\"bodyJson\":null,\"likes\":{\"count\":66,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2024-09-25T17:09:06.116Z\",\"updatedAt\":\"2026-02-19T18:46:17.957Z\",\"publishedAt\":\"2024-09-25T17:10:22.208Z\",\"featuredAt\":\"2026-06-15T14:30:26.117Z\",\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"ahhhxqo51mvyuwejaexvg1td4\",\"paid\":false,\"categories\":[{\"id\":\"676f63da-b192-4974-930d-73185802088a\",\"name\":\"Assets\",\"slug\":\"assets\"}]}},{\"id\":\"645\",\"resolved\":true,\"title\":\"FeCommerce\",\"body\":\"$a1\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"FeCommerce - WooCommerce Plugin for Framer\",\"marks\":[{\"type\":\"bold\"}]}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"FeCommerce is a \"},{\"type\":\"text\",\"text\":\"free WooCommerce plugin for Framer\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"https://www.fecommerce.co/framer-fecommerce\",\"target\":\"_blank\"}}]},{\"type\":\"text\",\"text\":\" that turns Framer into a full WooCommerce storefront. Sync your products into Framer CMS in one click, or pull them live via API, then build a complete shop with drag-and-drop components, so you can add WooCommerce to a Framer site with no code, no theme, and no backend. \"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Framer is a fast-growing no-code website builder, but it has no native WooCommerce integration and no built-in ecommerce. FeCommerce is the Framer ecommerce plugin that closes that gap and takes you from products in WooCommerce to a Framer site that takes orders.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"How to add WooCommerce to Framer\",\"marks\":[{\"type\":\"bold\"}]}],\"attrs\":{\"level\":2}},{\"type\":\"orderedList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Connect your store with your store URL and WooCommerce REST API keys. Choose your data source, CMS (synced) or API (live).\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Sync and drag. Products load automatically. Drag the product listing, product pages, variant selector, cart, and checkout onto the canvas, each auto-wired to your live store.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Style and publish. Shoppers buy on-page with no redirect the moment your site goes live.\"}]}]}],\"attrs\":{\"type\":null,\"start\":1}},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Key features\",\"marks\":[{\"type\":\"bold\"}]}],\"attrs\":{\"level\":2}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"One-click WooCommerce to Framer CMS sync: titles, prices, images, variants, stock, categories\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Shop / Product Listing with live search, sorting, and pagination\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Full component library: Product Page, Variant Selector, Add to Cart, Buy Now, Cart Drawer, Cart Page, Checkout, Mobile Sticky Cart, Price, SKU, Rating, Reviews\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"On-page checkout: Cash on Delivery native, optional inline Stripe card,optional Paystack redirect,live shipping rates and coupons\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Card animations, deep styling controls, and full responsiveness across desktop, tablet, phone\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Why use FeCommerce\",\"marks\":[{\"type\":\"bold\"}]}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Build and launch a complete Framer storefront in minutes, sell physical and digital products, and keep product data synced automatically. Ideal for creators, store owners, and Framer agencies. Free plugin, no code required.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Support\",\"marks\":[{\"type\":\"bold\"}]}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Let's create something amazing together. Get in touch with us:\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Mail: \"},{\"type\":\"text\",\"text\":\"connect@fecommerce.co\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"mailto:connect@fecommerce.co\",\"target\":\"_blank\"}}]}]}]},\"introduction\":\"WooCommerce to Framer  \",\"slug\":\"woocommerce-products\",\"author\":{\"framerUserId\":\"7e63332c-77d2-4e00-a6ca-d9c98c3d7dcf\",\"name\":\"FeCommerce\",\"slug\":\"fecommerce\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/1522163/avatar-O3mD0A25QB3hEFuyWMXPGD4iqS1Dlf.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/7e63332c-77d2-4e00-a6ca-d9c98c3d7dcf/8rr003v0\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/7e63332c-77d2-4e00-a6ca-d9c98c3d7dcf/gjy90pvz\",\"metadata\":{\"tint\":\"hsl(270 70% 70%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/645-SLbUwXMvzebUPwNCpJWNJU5hAAvVZR\",\"metadata\":{\"tint\":\"hsl(270 70% 70%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/645-q94ovD7vFVfqx2kQlSii3sHgkf4VuZ\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019aef1d-b4c0-71cd-b827-3ce85d2709cd\",\"bodyJson\":null,\"likes\":{\"count\":9,\"liked\":false},\"comments\":{\"count\":2},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2025-12-04T08:38:51.714Z\",\"updatedAt\":\"2026-08-06T11:57:10.898Z\",\"publishedAt\":\"2026-08-06T11:57:10.893Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"19btue4xxftzljazxbxpg11gj\",\"paid\":false,\"categories\":[{\"id\":\"c4868181-e303-4aac-8074-bd683d4debe8\",\"name\":\"E-Commerce\",\"slug\":\"ecommerce\"}]}},{\"id\":\"196\",\"resolved\":true,\"title\":\"SVG to 3D\",\"body\":\"$a2\",\"bodyJson\":null,\"introduction\":\"SVG to 3D\",\"slug\":\"svg-to-3d\",\"author\":{\"framerUserId\":\"788a6cbb-d711-4479-aa0e-13301bb28197\",\"name\":\"Umut Sevinc\",\"slug\":\"memselon\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/29209/avatar-h2QIOhEiKFQQjUlpbIxuldGxrDSlqS.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/196-MtCYrTFo51NO3XL89pKdY90qy7xp3o\",\"metadata\":{\"tint\":\"hsl(0 0% 9%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/196-zOc5jQUWNza5yCV5m5894E798rmQhm\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"0194fb97-80d0-72ab-9526-1b993525d5fa\",\"bodyJson\":null,\"likes\":{\"count\":34,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2025-01-06T12:01:54.571Z\",\"updatedAt\":\"2025-05-18T18:07:20.426Z\",\"publishedAt\":\"2025-02-12T19:16:37.712Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"26gik90h8jd6naucmpxmwf131\",\"paid\":true,\"categories\":[{\"id\":\"676f63da-b192-4974-930d-73185802088a\",\"name\":\"Assets\",\"slug\":\"assets\"}]}},{\"id\":\"1312\",\"resolved\":true,\"title\":\"Control Visitor Access - Vanssay\",\"body\":\"$a3\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Bouncer\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" blocks unwanted visitors on your Framer site by \"},{\"type\":\"text\",\"text\":\"country\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" and \"},{\"type\":\"text\",\"text\":\"VPN/proxy\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" — set it up in the plugin, enforced on every visit.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Choose who gets in once, and Bouncer guards your published site automatically. Verification runs \"},{\"type\":\"text\",\"text\":\"server-side from the visitor's real IP\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\", so there are no API keys in your site and no visitor data stored — just a fast check before your page shows.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Why Bouncer?\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- \"},{\"type\":\"text\",\"text\":\"Country + VPN in one\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" — blacklist or whitelist countries, and stop proxy/VPN/hosting IPs\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- \"},{\"type\":\"text\",\"text\":\"Server-side \u0026 tamper-proof\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" — decided on our servers from a local geo database, so it's instant and can't be bypassed client-side\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- \"},{\"type\":\"text\",\"text\":\"Matches your site automatically\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" — the block \u0026 loading screens read your colors, fonts and radius; fine-tune after\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- \"},{\"type\":\"text\",\"text\":\"Live preview before you arm it\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" — and it never blocks you in the editor\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- \"},{\"type\":\"text\",\"text\":\"3 ways to block\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" — a styled message, a redirect, or silently hide the page\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"How it works\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- \"},{\"type\":\"text\",\"text\":\"Pick your countries\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" — blacklist the ones to block, or whitelist only the ones you allow\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- \"},{\"type\":\"text\",\"text\":\"Style the screens\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" — or let Bouncer match your site automatically\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- \"},{\"type\":\"text\",\"text\":\"Arm protection\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" — one click injects it site-wide, or target specific pages\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- \"},{\"type\":\"text\",\"text\":\"Publish\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" — Framer pushes it live; the check runs on every visit\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Built for control\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- \"},{\"type\":\"text\",\"text\":\"VPN \u0026 proxy detection\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" — catch visitors masking their real location\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- \"},{\"type\":\"text\",\"text\":\"Conditional \u0026 scheduled rules\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" — block by country + device, or only during set time windows\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- \"},{\"type\":\"text\",\"text\":\"Analytics\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" — traffic, block rate, top blocked countries, device split and VPN attempts stopped\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Pricing\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Free\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" — block up to \"},{\"type\":\"text\",\"text\":\"3 countries\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" · whole-site protection · full \"},{\"type\":\"text\",\"text\":\"loading-screen\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" styling · fail-open safety\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Pro — $6/mo\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" — \"},{\"type\":\"text\",\"text\":\"unlimited countries\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" · whitelist mode · \"},{\"type\":\"text\",\"text\":\"VPN/proxy blocking\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" · \"},{\"type\":\"text\",\"text\":\"custom block screen\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" · redirect \u0026 hide actions · per-page protection\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Ultra — $14/mo\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" — all of Pro · \"},{\"type\":\"text\",\"text\":\"conditional rules\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" (country + device) · \"},{\"type\":\"text\",\"text\":\"scheduled blocks\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" · \"},{\"type\":\"text\",\"text\":\"full analytics\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"One subscription covers all your Framer projects · 7-day money-back guarantee · cancel anytime.\"}]},{\"type\":\"paragraph\"},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Links\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Website: \"},{\"type\":\"text\",\"text\":\"https://vanssay.net/geoblock\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"https://vanssay.net/geoblock\",\"target\":\"_blank\"}}]},{\"type\":\"text\",\"text\":\" · Support: \"},{\"type\":\"text\",\"text\":\"support@vanssay.net\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"mailto:support@vanssay.net\",\"target\":\"_blank\"}}]}]},{\"type\":\"paragraph\"}]},\"introduction\":\"Bouncer for Countries \u0026 VPNs\",\"slug\":\"control-visitor-access-vanssay\",\"author\":{\"framerUserId\":\"28caa548-cdb6-4992-9127-d2758f0ea47a\",\"name\":\"Marin de Vanssay\",\"slug\":\"marin-de-vanssay\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/28caa548-cdb6-4992-9127-d2758f0ea47a/ophghooc\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/28caa548-cdb6-4992-9127-d2758f0ea47a/snrgmvya\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/28caa548-cdb6-4992-9127-d2758f0ea47a/t7q7agbu\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/28caa548-cdb6-4992-9127-d2758f0ea47a/46u5rc4n\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/28caa548-cdb6-4992-9127-d2758f0ea47a/1zru5vht\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/28caa548-cdb6-4992-9127-d2758f0ea47a/95m2y0ju\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019f009d-974f-7517-b30a-435a00b073f6\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Say hello to Bouncer!\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Control who sees your site: block specific countries, VPN users, or both. Customize a branded block screen or silently redirect traffic. Free to start! Full demo mode with no account needed before committing.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Setup takes minutes. No code required!\"}]}]},\"likes\":{\"count\":8,\"liked\":false},\"comments\":{\"count\":3},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-06-25T21:09:15.687Z\",\"updatedAt\":\"2026-07-08T20:02:20.030Z\",\"publishedAt\":\"2026-06-28T14:24:12.378Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"1oik7skz5dbb8cf8jrz8p0dgy\",\"paid\":true,\"categories\":[{\"id\":\"29d5d6f9-12d2-41eb-9aec-a9c07f09841a\",\"name\":\"Localization\",\"slug\":\"localization\"},{\"id\":\"3fc802d9-7527-48e0-9403-c9bd534ab520\",\"name\":\"Utilities\",\"slug\":\"utilities\"}]}},{\"id\":\"492\",\"resolved\":true,\"title\":\"Text Search\",\"body\":\"\u003cp\u003eWith the Text Search plugin you can search for text content across your whole project: on Pages, in the CMS, or in Code Files. Text Search is a special plugin that can be also launched via the Edit menu or with the shortcut ⌘⇧F on Mac or Ctrl⇧F on Windows just like you might be used to it from other tools.\u003c/p\u003e\",\"bodyJson\":null,\"introduction\":\"Search for text content\",\"slug\":\"text-search\",\"author\":{\"framerUserId\":\"a7cd9fe6-cf81-4a41-8e93-bca0291dba80\",\"name\":\"Framer\",\"slug\":\"framer\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/107446/xpZr8yYS_400x400-2-MqZMjb2zlessnXickTqkyAzkfqz6le.jpg\",\"badges\":[\"framer\"],\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/492-7ZRjopiNC1B85iVbHkTVAn2T25KlHa\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/492-bYv5Sbyd0kQYgmDeB4OoiA35dSxxIR\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"01990b03-6e6e-7d7c-9c69-95b1796b32ab\",\"bodyJson\":null,\"likes\":{\"count\":54,\"liked\":false},\"comments\":{\"count\":1},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2025-09-02T09:36:52.416Z\",\"updatedAt\":\"2026-02-19T18:45:10.582Z\",\"publishedAt\":\"2025-09-02T15:19:58.318Z\",\"featuredAt\":\"2026-06-04T08:27:31.676Z\",\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"7u4tjrbnc6s1he183vzkpea34\",\"paid\":false,\"categories\":[{\"id\":\"b238ea64-0ce9-413a-848d-43b73f0eea0f\",\"name\":\"Design Workflow\",\"slug\":\"design-workflow\"}]}},{\"id\":\"1356\",\"resolved\":true,\"title\":\"Optimo SEO\",\"body\":\"$a4\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Optimo checks your published Framer site the way Google and AI crawlers read it, then helps you fix what it finds. You stay in the editor the whole time.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Built for Framer. No external dashboards, no pasting your URL into five different tools. Open the plugin, scan, fix, publish.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"WHAT OPTIMO DETECTS: 25+ CHECKS\"}],\"attrs\":{\"level\":1}},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"SEO\",\"marks\":[{\"type\":\"italic\"}]}],\"attrs\":{\"level\":2}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Missing, short, long, or duplicate page titles\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Missing, short, long, or duplicate meta descriptions\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Missing H1, multiple H1s, skipped heading levels\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Pages set to noindex (invisible to Google)\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Missing canonical, language attribute, favicon, social image\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Accessibility\",\"marks\":[{\"type\":\"italic\"}]}],\"attrs\":{\"level\":2}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Images missing alt text\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Form fields missing labels\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Links without readable text\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Frames missing titles\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Quality\",\"marks\":[{\"type\":\"italic\"}]}],\"attrs\":{\"level\":2}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Broken links\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Missing custom 404 page\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"AI Visibility\",\"marks\":[{\"type\":\"italic\"}]}],\"attrs\":{\"level\":2}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"AI crawlers (ChatGPT, Perplexity, Google AI) blocked\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Missing robots.txt, sitemap.xml, or llms.txt\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Missing structured data (JSON-LD), site and page level\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Missing FAQ schema that AI answers cite\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Every issue explained in plain words: what's wrong, why it matters, what to fix first.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"WHAT OPTIMO FIXES\"}],\"attrs\":{\"level\":1}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"AI alt text applied in one click — per image or whole site (Pro)\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"SEO-ready titles and meta for every page (Pro)\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Page-specific structured data, JSON-LD (Pro)\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"llms.txt in seconds (Pro)\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Rescan and watch your score climb (Free)\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"FREE\"}],\"attrs\":{\"level\":2}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Scan up to \"},{\"type\":\"text\",\"text\":\"10 pages\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" on \"},{\"type\":\"text\",\"text\":\"1 website \",\"marks\":[{\"type\":\"bold\"}]}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Full score, every issue explained\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"No card, no trial clock\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"PRO — $12/MONTH\"}],\"attrs\":{\"level\":2}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"All AI generation: alt text, meta, structured data, llms.txt\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Scan up to\"},{\"type\":\"text\",\"text\":\" 30 pages\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\", across \"},{\"type\":\"text\",\"text\":\"unlimited websites\",\"marks\":[{\"type\":\"bold\"}]}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Fresh \"},{\"type\":\"text\",\"text\":\"500 AI credits\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" every month\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Upgrade to Pro\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer\",\"href\":\"https://whop.com/checkout/Plvp1pb8EcvqxQFLb-2T9Y-cr8n-gutm-rbxYyFZqnbje/\",\"target\":\"_blank\"}},{\"type\":\"bold\"}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"PRIVACY\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Nothing leaves Framer until you agree — a first-run screen shows exactly what each feature sends (full details in Settings).\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"REFUNDS\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Pro includes AI credits consumed on use, so subscriptions are non-refundable — cancel anytime to stop future billing. If something's broken, reach out and we'll make it right.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Open, scan, fix, publish. Built for Framer.\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\"}]},\"introduction\":\"Audit \u0026 fix your Framer SEO \u0026 AEO\",\"slug\":\"optimo-seo\",\"author\":{\"framerUserId\":\"7233f7ab-ddec-4da6-bfaf-028a3d983408\",\"name\":\"Zineddine Kessaimi\",\"slug\":\"zineddine-kessaimi\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/7233f7ab-ddec-4da6-bfaf-028a3d983408/5f7b74k1\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/7233f7ab-ddec-4da6-bfaf-028a3d983408/019f47cf-ff54-71ae-82db-0a14d6eb4099.png\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/7233f7ab-ddec-4da6-bfaf-028a3d983408/019f47cf-fe1f-7319-80df-106af7b48ec5.png\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/7233f7ab-ddec-4da6-bfaf-028a3d983408/019f47cf-ffc3-77ed-801e-fda620b559a6.png\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019f47da-d01c-729e-969e-6803720a7db3\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Just launched Optimo — a plugin that audits your published Framer site for SEO and AI-search issues, then helps you fix them without leaving the editor\"}]}]},\"likes\":{\"count\":10,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-07-09T17:09:09.277Z\",\"updatedAt\":\"2026-07-14T16:58:52.079Z\",\"publishedAt\":\"2026-07-14T16:58:52.072Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"811ocb0mfp8dxc3lsjbu7j0dq\",\"paid\":true,\"categories\":[{\"id\":\"9e4479a9-bb0e-4137-8ac0-4a975eb9b882\",\"name\":\"SEO\",\"slug\":\"seo\"},{\"id\":\"b238ea64-0ce9-413a-848d-43b73f0eea0f\",\"name\":\"Design Workflow\",\"slug\":\"design-workflow\"},{\"id\":\"bde1e72b-b4a6-4ecc-8eee-417be77494e8\",\"name\":\"AI\",\"slug\":\"ai\"}]}},{\"id\":\"1503\",\"resolved\":true,\"title\":\"Plugin Studio — Design \u0026 Export Plugins\",\"body\":\"$a5\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Plugin Studio — design and export real Framer plugins visually. No code required.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Build multi-screen plugins with a drag-free visual editor: add text, buttons, and graphics, style backgrounds with solid colors or gradients, and wire up button actions like screen navigation or opening URLs. Preview exactly what users will see, then export a production-ready plugin project in one click.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"WHAT YOU GET\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Visual builder for Framer plugin UIs (390px canvas, true plugin dimensions)\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Multi-screen support with go-to-screen navigation\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• 8 ready-made templates: Login Form, AI Copywriter, Asset Library, Theme Sync, Script Installer, Section Library, Pro Paywall, CMS Sync\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Gradient picker with presets, angle control, and named swatches\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Undo/redo and per-screen element isolation\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• One-click export: complete Vite + React + TypeScript project (framer.json, src, configs) ready for npm install and publish\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• AI prompt export: get a ready prompt to refine your plugin with any AI\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"PRICING\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Free to design. Export with a subscription ($12/mo, unlimited exports) or a one-time single export ($5).\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Perfect for designers shipping their first plugin and developers who want a fast UI scaffold instead of writing boilerplate.\"}]}]},\"introduction\":\"Design \u0026 export Framer plugins\",\"slug\":\"plugin-studio-design-export-plugins\",\"author\":{\"framerUserId\":\"c89c22b1-43e1-4329-92b9-d729b84c1e75\",\"name\":\"NIKPT\",\"slug\":\"nikpt\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/2524243/FT_bKXBl0-qrtxA4r4L6Qyx1S33zdyYc8dVj5zVj\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/c89c22b1-43e1-4329-92b9-d729b84c1e75/01a01bc7-70ba-770c-9427-25e6bc328e29.png\",\"metadata\":{\"tint\":\"hsl(0 0% 9%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/c89c22b1-43e1-4329-92b9-d729b84c1e75/01a01bca-10a4-7004-8c75-cb22453ca0a7.png\",\"metadata\":{\"tint\":\"hsl(0 0% 9%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/c89c22b1-43e1-4329-92b9-d729b84c1e75/01a01bcb-765f-7624-9655-3836c0237817.png\",\"metadata\":{\"tint\":\"hsl(0 0% 9%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"01a01bda-25c1-7689-b259-fa3dfe81a336\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Just shipped Plugin Studio \"},{\"type\":\"emoji\",\"attrs\":{\"name\":\"rocket\",\"emoji\":\"🚀\"}}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Design Framer plugins visually, with no code. Multi-screen layouts, gradient picker, 8 templates, button actions. One click exports a production-ready Vite + React + TypeScript project, ready to publish.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Free to design, export from $5.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Try it now!\"}]}]},\"likes\":{\"count\":2,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-08-19T21:07:55.806Z\",\"updatedAt\":\"2026-08-20T16:05:51.823Z\",\"publishedAt\":\"2026-08-20T16:05:51.794Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"3qdvo2ssuzc2j5m5v5jgz9x10\",\"paid\":true,\"categories\":[{\"id\":\"3fc802d9-7527-48e0-9403-c9bd534ab520\",\"name\":\"Utilities\",\"slug\":\"utilities\"},{\"id\":\"b238ea64-0ce9-413a-848d-43b73f0eea0f\",\"name\":\"Design Workflow\",\"slug\":\"design-workflow\"},{\"id\":\"d42b39e6-e921-4d46-be20-263eb61efbf9\",\"name\":\"Developers\",\"slug\":\"developers\"}]}},{\"id\":\"812\",\"resolved\":true,\"title\":\"Framer Form Kit\",\"body\":\"$a6\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"The form system Framer\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Framer gives you beautiful pages. FormKit gives you forms that actually work.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Browse Form Templates (FREE)\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"https://framerformkit.com/templates?utm_source=framer_marketplace\u0026utm_medium=referral\u0026utm_campaign=framer_form_kit_listing\u0026utm_content=templates_cta\",\"class\":null,\"target\":\"_blank\"}}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Drop in 35+ field components — text, email, date pickers, file uploads, star ratings, signature pads and configure everything from the Properties Panel. No code. No embeds. No switching tools.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"What you get\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Real validation\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Required fields, email/phone/URL format checks, character limits, regex patterns, min/max ranges. Errors show inline on blur. Custom error messages that match your brand voice.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Multi-step forms\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Break long forms into steps with progress bars, step indicators, and navigation buttons. The Next button validates the current step before advancing. Auto-saves to localStorage so users never lose progress.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Conditional logic\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Show, hide, enable, or disable any field based on other field values. Eight operators (equals, contains, greater than, is empty, etc.) with AND/OR matching. Hidden fields automatically skip validation.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Full styling control\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Every component exposes Input Styles, Label Styles, Error Styles, Focus Styles, and Success Styles directly in the Properties Panel. Style one field, then Ctrl+Alt+C / Ctrl+Alt+V to copy styles across your entire form.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"URL parameter prefill\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Pre-populate fields from URL query strings. Link from email campaigns, ads, or landing pages with `?\"},{\"type\":\"text\",\"text\":\"email=user@example.com\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"mailto:email=user@example.com\",\"class\":null,\"target\":\"_blank\"}}]},{\"type\":\"text\",\"text\":\"\u0026source=newsletter` and fields fill automatically.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"35+ components\"}],\"attrs\":{\"level\":2}},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"3 steps to your first form\"}],\"attrs\":{\"level\":2}},{\"type\":\"orderedList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Open FormKit from the Plugins bar\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Click any component to insert it into your Framer Form\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Set the field name, label, and validation in the Properties Panel\"}]}]}],\"attrs\":{\"type\":null,\"start\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"That's it. Preview your page and the form works.\"}]}]},\"introduction\":\"Advanced Form Builder for Framer\",\"slug\":\"framer-form-kit\",\"author\":{\"framerUserId\":\"43694cfe-23ad-481d-9cf9-3c2b362055e8\",\"name\":\"FramerHub.io \",\"slug\":\"framerhub\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/1146220/avatar-i8EDq2pFNiTBjFGkVIIoQbuXQMMzZI.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/812-bDjnGlQStPStn64laVor5p3M9wWnB4\",\"metadata\":{\"tint\":\"hsl(0 0% 9%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/812-63PZE3i5Hfv12AqyTPiuCivqvJBmSr\",\"metadata\":{\"tint\":\"hsl(0 0% 9%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019c8542-f837-70ad-92c7-17e7fe25e340\",\"bodyJson\":null,\"likes\":{\"count\":18,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-02-22T02:43:37.749Z\",\"updatedAt\":\"2026-08-23T12:50:04.433Z\",\"publishedAt\":\"2026-02-22T12:11:24.599Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"3vs2i683vxuvisfk38rczokh1\",\"paid\":false,\"categories\":[{\"id\":\"3176e858-a9a6-426f-894a-e1ef01750d76\",\"name\":\"Forms\",\"slug\":\"forms\"}]}},{\"id\":\"1238\",\"resolved\":true,\"title\":\"Connectfic\",\"body\":\"$a7\",\"bodyJson\":null,\"introduction\":\"Connect Shopify to Framer\",\"slug\":\"connectfic\",\"author\":{\"framerUserId\":\"dd3380a5-5fea-401b-be33-8ad908368c7b\",\"name\":\"Framefic\",\"slug\":\"framefic\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/2290784/avatar-D7VyRiPUPgg7M2fib6UPMu0jbZVdeS.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/1238-cTV7EJYlSaXBCyOQIv0UNYHkN2iRK7\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/1238-EzMDJGFLc7B77jMQHYegDj2wIJbipc\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/1238-jPhb4jQQDfQISMs7zUF6ygVBBRPVwW\",\"metadata\":{\"tint\":\"hsl(0 0% 16%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/1238-DlnKhbfQHLc72G7PHnV3sQoWqRDwsL\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019e8521-46b4-7019-bd83-0c771284eb0f\",\"bodyJson\":null,\"likes\":{\"count\":20,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-06-01T18:08:05.160Z\",\"updatedAt\":\"2026-08-07T06:37:19.699Z\",\"publishedAt\":\"2026-08-07T06:37:19.684Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"a0f85lwaxrp167i3ksws9elep\",\"paid\":true,\"categories\":[{\"id\":\"c4868181-e303-4aac-8074-bd683d4debe8\",\"name\":\"E-Commerce\",\"slug\":\"ecommerce\"}]}},{\"id\":\"1497\",\"resolved\":true,\"title\":\"BRIX Internal Link Graph\",\"body\":\"\u003ch2\u003eAudit Internal Links Across Your Framer Project\u003c/h2\u003e\u003cp\u003eAnalyze internal links configured in native layers, component controls, supported CMS fields, and responsive layouts. Find unresolved or unpublished destinations, review navigation gaps, open supported link origins in Framer, and export the current report as CSV. The plugin is read-only and does not crawl the published website.\u003c/p\u003e\u003ch3\u003eFramer Internal Link Audit Features\u003c/h3\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eAnalyze native, component, and supported CMS links.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eIdentify deleted or unresolved destinations.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eDetect links pointing to unpublished pages.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCompare destinations across responsive layouts.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFind published pages without detected inbound links.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eIdentify pages that are not reachable from Home.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eOpen supported link origins directly in Framer.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eExport the current analysis as CSV.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Audit Internal Links Across Your Framer Project\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Analyze internal links configured in native layers, component controls, supported CMS fields, and responsive layouts. Find unresolved or unpublished destinations, review navigation gaps, open supported link origins in Framer, and export the current report as CSV. The plugin is read-only and does not crawl the published website.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Framer Internal Link Audit Features\"}],\"attrs\":{\"level\":2}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Analyze native, component, and supported CMS links.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Identify deleted or unresolved destinations.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Detect links pointing to unpublished pages.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Compare destinations across responsive layouts.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Find published pages without detected inbound links.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Identify pages that are not reachable from Home.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Open supported link origins directly in Framer.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Export the current analysis as CSV.\"}]}]}]}]},\"introduction\":\"Audit internal links in Framer\",\"slug\":\"brix-internal-link-graph\",\"author\":{\"framerUserId\":\"e358d7aa-6ac7-4869-ad44-883c5758a23a\",\"name\":\"BRIX Templates\",\"slug\":\"brixtemplates\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/60505/0rRGr8D8--l5CRGsEWwqui3k1a93f4lhdzU7z6rY\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/e358d7aa-6ac7-4869-ad44-883c5758a23a/01a01619-6083-763a-ac66-e51d5c7800c9.png\",\"metadata\":{\"tint\":\"hsl(200 77% 49%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/e358d7aa-6ac7-4869-ad44-883c5758a23a/01a01619-6f6e-7585-85f2-81d4060cdb40.png\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"01a0161c-2bd0-704e-8c72-eb9a5d893171\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"BRIX Internal Link Graph is now live in the Framer Marketplace \"},{\"type\":\"emoji\",\"attrs\":{\"name\":\"tada\",\"emoji\":\"🎉\"}},{\"type\":\"text\",\"text\":\" Analyze internal links across pages, components, and supported CMS fields, find unresolved or unpublished destinations, review navigation gaps, and export your report as CSV. Check it out in the Framer Marketplace.\"}]}]},\"likes\":{\"count\":7,\"liked\":false},\"comments\":{\"count\":1},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-08-18T18:22:19.493Z\",\"updatedAt\":\"2026-08-18T18:54:04.023Z\",\"publishedAt\":\"2026-08-18T18:54:04.013Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"cvyl8ytw7yvn5bxbrllxafa56\",\"paid\":false,\"categories\":[{\"id\":\"1ad3e7b2-bc61-42ce-b01a-7c8bb2278f1a\",\"name\":\"CMS\",\"slug\":\"cms\"},{\"id\":\"3fc802d9-7527-48e0-9403-c9bd534ab520\",\"name\":\"Utilities\",\"slug\":\"utilities\"},{\"id\":\"9e4479a9-bb0e-4137-8ac0-4a975eb9b882\",\"name\":\"SEO\",\"slug\":\"seo\"}]}},{\"id\":\"625\",\"resolved\":true,\"title\":\"Chatloom\",\"body\":\"$a8\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Add a smart, custom-trained AI chatbot to your Framer site — fast, and no code.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Chatloom is a full AI chatbot platform, not just a widget. Train it on your own content, automate support with visual workflows, and deploy across 7 channels — all from one dashboard, without leaving your Framer workflow.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Key Features\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"→ Trained on Your Content (RAG)\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Upload docs and PDFs, or crawl your website. Your chatbot answers only from your verified content — no hallucinations. Built-in confidence scoring with automatic human handoff when unsure.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"→ 10 Built-in Tools\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Book appointments (Google Calendar, \"},{\"type\":\"text\",\"text\":\"Cal.com\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"http://Cal.com\",\"class\":null,\"target\":\"_blank\"}}]},{\"type\":\"text\",\"text\":\", Calendly), capture leads, send emails and WhatsApp messages, trigger webhooks (Zapier / Make), create support tickets, and more. Your bot takes real actions — not just answers.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"→ Visual Workflow Builder\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Drag-and-drop canvas with 11 node types — triggers, AI responses, conditions, tool calls, intake forms, human handoffs. 18 ready-made templates + 4 industry starter kits.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"→ 7-Channel Deployment\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Web widget, WhatsApp Business, Telegram, Instagram DM, Facebook Messenger, Email, Discord. One brain, consistent answers everywhere.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"→ Live Human Handoff\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Monitors confidence, sentiment, and complexity, then routes the conversation to your team with full context when it matters.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"→ 3 AI Providers, Auto-Failover\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"OpenAI GPT, Anthropic Claude, and Google Gemini. If one fails, Chatloom switches automatically. Smart routing cuts costs by 20–40%.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"→ Total Design Control\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Colors, fonts, bubble styles, avatars, animations. 4 launcher modes: floating button, compact panel, sidebar, fullscreen overlay. White-label on paid plans.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"→ 95+ Languages\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Auto-detects and replies in the visitor's language instantly. Platform UI in 10 languages.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"→ Lead Capture \u0026 Forms\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Conversational form builder with custom fields, validation, and conditional logic.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Pricing\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Free plan — 1 chatbot, 100 messages/month, all core features. No credit card required.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Support: \"},{\"type\":\"text\",\"text\":\"support@chatloom.app\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"mailto:support@chatloom.app\",\"class\":null,\"target\":\"_blank\"}}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Website: \"},{\"type\":\"text\",\"text\":\"https://chatloom.app\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"https://chatloom.app\",\"class\":null,\"target\":\"_blank\"}}]}]}]},\"introduction\":\"AI Chatbot Platform for Framer\",\"slug\":\"chatloom\",\"author\":{\"framerUserId\":\"df3fedfd-4d3f-4100-b2f4-0eb9ffdcaaa1\",\"name\":\"Can Girgin\",\"slug\":\"can-girgin\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/29285/avatar-ET5yH7T79O6hzfpRHA4wHb7OxgIv8O.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/df3fedfd-4d3f-4100-b2f4-0eb9ffdcaaa1/019f4e35-48f5-7553-b967-b5230531c561.png\",\"metadata\":{\"tint\":\"hsl(260 75% 13%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/df3fedfd-4d3f-4100-b2f4-0eb9ffdcaaa1/019f4e4e-f3d7-7464-b890-7dcc71af8105.png\",\"metadata\":{\"tint\":\"hsl(260 75% 13%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019ac272-6603-7db3-9b70-1f06b9b7813a\",\"bodyJson\":null,\"likes\":{\"count\":25,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2025-11-21T11:49:10.178Z\",\"updatedAt\":\"2026-07-13T09:35:55.575Z\",\"publishedAt\":\"2026-07-13T09:35:55.548Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"4d6kan5k6k0hfjrdnmopw27cs\",\"paid\":false,\"categories\":[{\"id\":\"3176e858-a9a6-426f-894a-e1ef01750d76\",\"name\":\"Forms\",\"slug\":\"forms\"},{\"id\":\"bde1e72b-b4a6-4ecc-8eee-417be77494e8\",\"name\":\"AI\",\"slug\":\"ai\"},{\"id\":\"f6795017-0256-4955-b31a-c81a28ef20ff\",\"name\":\"Integrations\",\"slug\":\"integrations\"}]}},{\"id\":\"831\",\"resolved\":true,\"title\":\"Image Library\",\"body\":\"$a9\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Image Library handles your entire image workflow in one place: browse, optimize, replace, fix alt text, and copy image URLs without switching between plugins.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Browse and reuse without re-uploading\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Every image in your project is surfaced automatically. Deduplicated, searchable, and ready to insert onto the canvas or apply to a selected layer in one click.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Generate alt text with AI\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" One click writes descriptive alt text for any image and applies it to every instance. Generate in any of 20 languages to match your site's audience. Available on Pro and Agency plans.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Edit alt text across every instance at once\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Click any image to edit its alt text. Changes apply to every node using that image, not one layer at a time.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Compress images without leaving Framer\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Resize by width, set WebP quality, and preview estimated file size savings before applying. Works on Canvas and CMS images.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Replace an image everywhere, safely\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Swap an image across your entire project, the current page, or just your selection. A confirmation shows exactly how many instances will change and where they live before anything happens.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Spot issues before you publish\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Image Library flags missing alt text and large files (over 1MB) so accessibility and performance problems get caught before they go live.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Find anything on the canvas\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Locate jumps straight to any node using an image. Used in multiple places? Click again to cycle through every instance.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Copy image URLs instantly\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Grab the direct URL of any project image in one click.\"}]}]},\"introduction\":\"Image Library\",\"slug\":\"image-library\",\"author\":{\"framerUserId\":\"328220bb-c6fa-432c-a03c-21adb820f1e4\",\"name\":\"Kevin James\",\"slug\":\"kevin-james\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/386980/avatar-Rvwb7RfBEsjBIt7GWHl3SPuHRBC9c9.jpg\",\"badges\":[\"pro\"],\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/328220bb-c6fa-432c-a03c-21adb820f1e4/019f5cc6-434a-775f-a838-33f6ed404ca5.jpg\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/328220bb-c6fa-432c-a03c-21adb820f1e4/019f5cd2-66dd-7129-9370-7095e9c4cdf8.jpg\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/328220bb-c6fa-432c-a03c-21adb820f1e4/019f5cd2-cf97-716c-a334-115a397a1e88.jpg\",\"metadata\":{\"tint\":\"hsl(192 83% 19%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/328220bb-c6fa-432c-a03c-21adb820f1e4/019f5cd2-fa8f-71b8-8a79-594b2cd87fdf.jpg\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/328220bb-c6fa-432c-a03c-21adb820f1e4/019f5cd5-b7d9-74c5-9504-d22ecbff261c.jpg\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019c9b71-050e-71d0-8ee5-b997d0914bfe\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Image Library 1.4.0 is here\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"The biggest update yet:\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Generate alt text with AI. \",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\"One click writes descriptive alt text for any image and applies it to every instance across your project, in any of 20 languages. Available on Pro and Agency plans.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Replace All, reworked.\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Swap an image across your entire project, the current page, or just your selection. Before anything changes, you see exactly how many instances are affected and which pages they live on.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Smarter permissions.\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Working in a project where you have limited access? Actions you can't perform are clearly disabled with an explanation instead of failing silently.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Plus a new Settings screen, safer license management, and plenty of fixes under the hood.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"The Starter plan still includes every manual feature with a one-time purchase. Existing license keys keep working, nothing changes for current users.\"}]}]},\"likes\":{\"count\":5,\"liked\":false},\"comments\":{\"count\":4},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-02-26T19:06:10.483Z\",\"updatedAt\":\"2026-07-31T18:11:44.596Z\",\"publishedAt\":\"2026-07-31T18:11:44.589Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"4og2xvg3clzsj58nyhlekq6on\",\"paid\":true,\"categories\":[{\"id\":\"3fc802d9-7527-48e0-9403-c9bd534ab520\",\"name\":\"Utilities\",\"slug\":\"utilities\"},{\"id\":\"b238ea64-0ce9-413a-848d-43b73f0eea0f\",\"name\":\"Design Workflow\",\"slug\":\"design-workflow\"},{\"id\":\"bde1e72b-b4a6-4ecc-8eee-417be77494e8\",\"name\":\"AI\",\"slug\":\"ai\"}]}},{\"id\":\"1195\",\"resolved\":true,\"title\":\"Scan \u0026 Pay Button\",\"body\":\"$aa\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"📱 Scan \u0026 Pay buttons for Framer. One drop-in component, every payment app.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Drop a QR + Pay button on any page. Customers tap on mobile — their payment app opens. Or scan on desktop — a styled QR pops up. Pay via UPI, Stripe, PayPal, or any HTTPS payment link. No backend, no transaction cut, no monthly fees.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"✨ WHAT YOU GET\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• QR + Pay button, ready to drop on any page\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• 4 payment methods: UPI, Stripe Link, PayPal Link, Custom Link\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Mobile deep link (opens payment app) + desktop scannable QR popup\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Live URL / VPA validation with friendly errors\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Custom button: text, color, radius, font weight, padding, logo\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Custom QR styling with logo at the center\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• After-payment continue URL (new tab or replace current page)\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Multiple UPI VPAs — rotate across handles\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Buyer-entered amounts — donations, tips, custom totals\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"⚡ HOW IT WORKS\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"1. Open the Scan \u0026 Pay Button plugin in Framer\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"2. Pick a payment method (UPI, Stripe Link, PayPal Link, or Custom Link)\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"3. Paste your VPA, paypal.me URL, Stripe Checkout link, or any HTTPS payment link\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"4. Customize the button — text, color, radius, padding\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"5. Click \\\"Insert ScanPayButton\\\" — the component lands in Assets → Code Components\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"6. Drop on your page\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"🚀 FREE vs PRO\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Free — UPI payments, single VPA, fixed amount, styled button, mobile deep link + desktop QR\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Pro — adds all 4 payment rails, multiple UPI VPAs, buyer-entered amounts, success redirect, custom QR styling with logo\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"🎯 WHO IT'S FOR\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Indie creators selling digital products on a Framer landing page\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Designers shipping client portfolios with a \\\"support my work\\\" button\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Freelancers collecting one-time fees, retainers, or deposits\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Anyone running donations, tips, course sales, or one-shot e-commerce drops\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"🛡 WHY THIS PLUGIN\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• 100% client-side, zero backend\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• No third-party services for the plugin, no API keys to manage\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Works on every device — mobile deep link + desktop QR popup\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• 7-day money-back guarantee\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Built by KDX Studios\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Questions? 📩 \"},{\"type\":\"text\",\"text\":\"thekhushaldewra@gmail.com\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"mailto:thekhushaldewra@gmail.com\",\"class\":null,\"target\":\"_blank\"}}]}]}]},\"introduction\":\"Scan + pay. Any payment app ⚡\",\"slug\":\"scan-pay-button\",\"author\":{\"framerUserId\":\"9bdea070-ea37-40d2-9943-455415b514f5\",\"name\":\"Khushal Dewra (KDX Studios)\",\"slug\":\"khushal-dewra\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/307637/avatar-NM7akQxU3JcJlme7gymEqznPAeT33L.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/1195-4BN1SHpSJVGm0HZAJ4rpcmyOAahUlF\",\"metadata\":{\"tint\":\"hsl(251 79% 28%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/1195-08I89KA8ywstmNCkV1PiNdDV1lx7hU\",\"metadata\":{\"tint\":\"hsl(251 79% 28%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/1195-SHElOEFKRQ3rj2efrb5miOC8IYuKmx\",\"metadata\":{\"tint\":\"hsl(251 79% 28%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/9bdea070-ea37-40d2-9943-455415b514f5/eofmxrhi\",\"metadata\":{\"tint\":\"hsl(251 79% 28%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019e462e-c30a-7221-bd15-ff65a56d6255\",\"bodyJson\":null,\"likes\":{\"count\":11,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-05-20T02:53:48.516Z\",\"updatedAt\":\"2026-08-16T12:08:00.324Z\",\"publishedAt\":\"2026-08-16T12:08:00.320Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"8uha8fo93boe0xt0scfxq34pk\",\"paid\":true,\"categories\":[{\"id\":\"c4868181