orage.com/plugins/599-fUbOQDGDHJ9UN9Gz82xsOEgacvSqsc\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/599-ofENYbHhOseytODXXpumK59WmftvR2\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/599-WnX4pkWdIIgoIKpClQQe1lILK8N5z4\",\"metadata\":{\"tint\":\"hsl(246 92% 33%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/599-E0c9spsRjBt1GoNch0CzgpVdMUzRoW\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019a6be3-b7c6-794f-87d8-01f1eddcb4bf\",\"bodyJson\":null,\"likes\":{\"count\":26,\"liked\":false},\"comments\":{\"count\":3},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2025-11-08T16:37:13.775Z\",\"updatedAt\":\"2025-12-27T12:22:11.249Z\",\"publishedAt\":\"2025-11-10T03:51:17.190Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"bt1ailyey0b0bt1y4cvurlr49\",\"paid\":true,\"categories\":[{\"id\":\"1ad3e7b2-bc61-42ce-b01a-7c8bb2278f1a\",\"name\":\"CMS\",\"slug\":\"cms\"}]}},{\"id\":\"1515\",\"resolved\":true,\"title\":\"ImageFX\",\"body\":\"$69\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"ImageFX: bake dither, halftone, ASCII and pixel effects into your images\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Turn any image on your Framer canvas into print style artwork. Pick a preset, judge it with the Before and After slider, then apply. The effect bakes into a clean PNG, so your site ships a plain image with zero runtime cost.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"What you get\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"4 engines: Halftone · Dither · ASCII · Pixel\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"2 modes. Engine replaces the image. Filter lays ink over the photo with coverage bands, polarity, opacity and blends\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"56 presets from the Frameion component line: Newsprint · Solar · Press · Bisect · Poster · Starlight · Process (CMYK) · Noir · Pop · Etch · Mono Print · Statue · Amber LED · CRT · Blueprint · Emberglow · Frost · Acid · Amber · Bitmap · Editorial · Truecolor · Ink · Ghost · Blur · Emissive · Neon · Datastream · Mosaic · Eight Bit · Dot Matrix · Lite Brite and more\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"18 measured ASCII charsets from Braille to Katakana\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Multi level dithering with 2 to 6 tones, square, dot and glow marks\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"CMYK separations at real press angles, duotone inks, rotated screens\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Big preview with Fit and 100% zoom and drag to pan\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Resolution normalized: identical results at any image size\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"For heroes, portfolio cards, product shots and social graphics.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Free and licensed\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Install free from this page. The free version is the full plugin with watermarked exports and 3 applies\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"A license unlocks unlimited watermark free exports. One time $19 from the Upgrade button inside the plugin, no subscription\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Your key works on 3 devices and updates are free for life\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Email support: \"},{\"type\":\"text\",\"text\":\"support@premshandilya.com\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"mailto:support@premshandilya.com\",\"target\":\"_blank\"}}]}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"License:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Single user license. Use ImageFX in unlimited personal and commercial Framer projects, including client work. Reselling, redistributing or repackaging the plugin is not permitted.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Refunds:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Try the free version first. License purchases are non refundable. If anything does not work as shown, email me and I will fix it fast.\"}]}]},\"introduction\":\"Bake effects into any image\",\"slug\":\"imagefx\",\"author\":{\"framerUserId\":\"b10633cd-e712-48eb-871a-ea0592a67fbc\",\"name\":\"Prem Shandilya\",\"slug\":\"prem-shandilya\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/b10633cd-e712-48eb-871a-ea0592a67fbc/dwlqme1i\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/b10633cd-e712-48eb-871a-ea0592a67fbc/01a02c77-8021-7646-81c4-d1863f526fac.png\",\"metadata\":{\"tint\":\"hsl(0 0% 9%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/b10633cd-e712-48eb-871a-ea0592a67fbc/01a02c77-7f80-73ec-ab84-43233c1172ba.png\",\"metadata\":{\"tint\":\"hsl(180 17% 19%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/b10633cd-e712-48eb-871a-ea0592a67fbc/01a02c77-7feb-727c-89f7-80946a859058.png\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/b10633cd-e712-48eb-871a-ea0592a67fbc/01a02c77-7fb8-75d1-abdd-5e87fb911ac5.png\",\"metadata\":{\"tint\":\"hsl(214 88% 13%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"01a02c54-52c2-7235-b199-4c545a0119bd\",\"bodyJson\":null,\"likes\":{\"count\":11,\"liked\":false},\"comments\":{\"count\":1},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-08-23T01:55:18.287Z\",\"updatedAt\":\"2026-08-23T12:23:31.294Z\",\"publishedAt\":\"2026-08-23T12:23:31.288Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"beudl7n0yidm5yw7xvyh0ozux\",\"paid\":true,\"categories\":[{\"id\":\"b238ea64-0ce9-413a-848d-43b73f0eea0f\",\"name\":\"Design Workflow\",\"slug\":\"design-workflow\"}]}},{\"id\":\"34\",\"resolved\":true,\"title\":\"Rive\",\"body\":\"\u003cp\u003eBuild production-ready graphics for web, apps, and games. Rive is a new way to build graphics for software — with rich interactivity and state-driven animation. It removes the need for hard-coded graphics and empowers teams to iterate faster and build better products. Rive gives designers creative control and removes repetitive engineering work.\u003c/p\u003e\u003cp\u003eThis plugin gives Framer native support of the Rive format, which means you can drag and drop a .riv file directly into Framer. It also lets you access Rive’s state machine inputs and control them in Framer’s component variants. Now, using Rive with Framer is easier and more performant than ever. Go no-code or full-code — it’s up to you.\u003c/p\u003e\",\"bodyJson\":null,\"introduction\":\"Drag and drop Rive assets\",\"slug\":\"rive\",\"author\":{\"framerUserId\":\"0b33bbf5-0d4c-4fbf-be07-7ae0e50e0350\",\"name\":\"Rive\",\"slug\":\"rive-app\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/2052013/avatar-LHEB2az4JliuR1dku1n98E9gx6rzUd.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/34-e7Jc6NQmjifV0AYJbcjKCjCdFnDs5u\",\"metadata\":{\"tint\":\"hsl(200 94% 25%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/34-2rmRZrRJqYDrPeRhGd2uyp2CXUN0f2\",\"metadata\":{\"tint\":\"hsl(0 0% 9%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/34-YQRCE7t6LRmm4e9x1buT7rk8uf3jb6\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/34-fIfZT930m0vwPTEXSR1bTFC0fVUuYO\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"01927a84-5b81-7c7c-af3f-b27c41d3ab19\",\"bodyJson\":null,\"likes\":{\"count\":50,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2024-09-27T17:15:43.750Z\",\"updatedAt\":\"2026-07-15T19:05:11.440Z\",\"publishedAt\":\"2026-07-15T19:05:11.436Z\",\"featuredAt\":\"2026-06-15T14:31:55.115Z\",\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"6839p2e822jesvfuae7qo5w21\",\"paid\":false,\"categories\":[{\"id\":\"79a3568a-05f3-4f98-b70f-6c9ff9e301c4\",\"name\":\"UI Kits\",\"slug\":\"ui-kits\"}]}},{\"id\":\"1430\",\"resolved\":true,\"title\":\"FrameShaders\",\"body\":\"$6a\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Bring your Framer sites to life with stunning, highly customizable WebGL shaders and dynamic gradients. \"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"FrameShaders gives you access to a massive library of premium, interactive backgrounds that you can drop directly onto your canvas with a single click.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"All thanks to Shaders by Paper for providing these awesome shaders.\",\"marks\":[{\"type\":\"italic\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Key Features:\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Massive Shader Library\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\": Access over 40+ unique, high-quality shaders including mesmerizing 3D effects, fluid mesh gradients, and geometric patterns.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Live Previews\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\": Browse and preview every shader in real-time before adding them to your project.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Deep Customization\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\": Easily tweak colors, animation speeds, geometry, and styling parameters directly inside the plugin to perfectly match your brand.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"One-Click Import\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\": Generate production-ready React components that insert seamlessly onto your Framer canvas.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Optimized Performance\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\": Built specifically for Framer with lazy-loaded canvases and Intersection Observers to ensure your final site remains lightning-fast.\"}]}]}]}]},\"introduction\":\"Paper Shaders, Gradient \u0026 Patterns\",\"slug\":\"frameshaders\",\"author\":{\"framerUserId\":\"a698a602-61a2-432e-9ece-e7e00bd33607\",\"name\":\"Soubhagya Sahu\",\"slug\":\"soubhagya\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/241496/avatar-KdgFeN2nBtjtx1ZR3C1ximAaCbnVMd.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/a698a602-61a2-432e-9ece-e7e00bd33607/019fcaf4-b104-72ab-a2fb-4832136ee94f.png\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/a698a602-61a2-432e-9ece-e7e00bd33607/019fcaf2-349c-746e-8b36-20fe0df744d1.png\",\"metadata\":{\"tint\":\"hsl(30 29% 55%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/a698a602-61a2-432e-9ece-e7e00bd33607/019fcaf2-7428-7398-95c7-91c38471c672.png\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/a698a602-61a2-432e-9ece-e7e00bd33607/019fcaf6-5e67-731b-87b7-5db8bb81031b.png\",\"metadata\":{\"tint\":\"hsl(0 0% 9%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019fcaf7-ecfa-714b-8028-1ecf85d11bcc\",\"bodyJson\":null,\"likes\":{\"count\":22,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-08-04T04:11:12.700Z\",\"updatedAt\":\"2026-08-04T04:11:14.650Z\",\"publishedAt\":\"2026-08-04T04:11:14.611Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"ejt4e499jnnlug5qnw4mrot0i\",\"paid\":true,\"categories\":[{\"id\":\"3fc802d9-7527-48e0-9403-c9bd534ab520\",\"name\":\"Utilities\",\"slug\":\"utilities\"},{\"id\":\"79a3568a-05f3-4f98-b70f-6c9ff9e301c4\",\"name\":\"UI Kits\",\"slug\":\"ui-kits\"},{\"id\":\"b238ea64-0ce9-413a-848d-43b73f0eea0f\",\"name\":\"Design Workflow\",\"slug\":\"design-workflow\"}]}},{\"id\":\"1379\",\"resolved\":true,\"title\":\"Design Sync\",\"body\":\"$6b\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Bridging the gap between your Figma designs and Framer projects.\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Stop wasting time manually copying hex codes, recreating text styles, and managing dark mode variants across platforms. Figma Sync is the ultimate bridge between your design tool and your Framer canvas.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"With just a single Figma File URL, this plugin instantly scans your design and generates native, fully-linked Framer Color and Text styles in seconds.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"sparkles\",\"emoji\":\"✨\"}},{\"type\":\"text\",\"text\":\" Key Features\",\"marks\":[{\"type\":\"bold\"}]}],\"attrs\":{\"level\":2}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Instant Style Import:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Automatically pull in all your solid colors and typography settings directly from your Figma file.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Smart Dark Mode Mapping:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Names your Figma colors with \\\"Light\\\" or \\\"Dark\\\" prefixes? Figma Sync intelligently pairs them together to automatically generate Framer styles with built-in Light and Dark themes.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Native Framer Styles:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Creates true Framer Color Styles and Text Styles—meaning if you update the style later, it updates everywhere across your entire Framer site.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Secure OAuth:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Uses Figma's official OAuth to securely connect to your account without ever storing your data.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Native UI:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Built with a clean interface that seamlessly adapts to Framer’s own light and dark mode for a native feel.\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"rocket\",\"emoji\":\"🚀\"}},{\"type\":\"text\",\"text\":\" How to use\",\"marks\":[{\"type\":\"bold\"}]}],\"attrs\":{\"level\":2}},{\"type\":\"orderedList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Connect:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Log in with your Figma account directly inside the plugin.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Activate:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Enter your \"},{\"type\":\"text\",\"text\":\"Polar.sh\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"http://Polar.sh\",\"target\":\"_blank\"}}]},{\"type\":\"text\",\"text\":\" license key.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Paste:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Grab your Figma File URL (Click \"},{\"type\":\"text\",\"text\":\"Share\",\"marks\":[{\"type\":\"italic\"}]},{\"type\":\"text\",\"text\":\" -\u003e \"},{\"type\":\"text\",\"text\":\"Copy Link\",\"marks\":[{\"type\":\"italic\"}]},{\"type\":\"text\",\"text\":\" in Figma) and paste it into the plugin.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Sync:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Hit \\\"Sync Figma File\\\" and watch your Framer assets panel populate instantly!\"}]}]}],\"attrs\":{\"type\":null,\"start\":1}}]},\"introduction\":\"Figma to Framer Sync\",\"slug\":\"design-sync\",\"author\":{\"framerUserId\":\"ff121138-ac98-4c86-a230-12c0d7db0e59\",\"name\":\"Pixels\",\"slug\":\"pixels\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/ff121138-ac98-4c86-a230-12c0d7db0e59/9jje7ugc\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/ff121138-ac98-4c86-a230-12c0d7db0e59/019f8504-ff64-75ac-bad8-536250e0fc9b.png\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019f8507-0ae3-7770-a423-b3a27ef497fb\",\"bodyJson\":null,\"likes\":{\"count\":8,\"liked\":false},\"comments\":{\"count\":2},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-07-21T14:14:18.726Z\",\"updatedAt\":\"2026-07-22T12:47:58.714Z\",\"publishedAt\":\"2026-07-22T12:47:58.704Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"9wfezab12cw3mki30mdratvzr\",\"paid\":true,\"categories\":[{\"id\":\"3fc802d9-7527-48e0-9403-c9bd534ab520\",\"name\":\"Utilities\",\"slug\":\"utilities\"},{\"id\":\"79a3568a-05f3-4f98-b70f-6c9ff9e301c4\",\"name\":\"UI Kits\",\"slug\":\"ui-kits\"},{\"id\":\"d42b39e6-e921-4d46-be20-263eb61efbf9\",\"name\":\"Developers\",\"slug\":\"developers\"}]}},{\"id\":\"83\",\"resolved\":true,\"title\":\"Frameshop\",\"body\":\"$6c\",\"bodyJson\":null,\"introduction\":\"E-commerce with Stripe\",\"slug\":\"frameshop\",\"author\":{\"framerUserId\":\"3375e3c7-e407-4f07-93ee-869116ac71b5\",\"name\":\"Frameshop\",\"slug\":\"frameshop\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/130875/Sans%20titre-2-ofhZUILiMl5PUF9qyxvl3JJIOvm9T3.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/83-X88oGZD0uqM1d4jbG1LXm7NtXpspYX\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/83-PCjdUIPTVOCO53DuSLdVAXRJTkGweO\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/83-yVXZqPUfCQunhO1RMynZmBxuI2QTDG\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/83-CBN4O6MUjIH3NVEgoUreSuhTl4boDo\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019373d9-12f5-705f-a6b9-36f65b6bf1a4\",\"bodyJson\":null,\"likes\":{\"count\":57,\"liked\":false},\"comments\":{\"count\":1},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2024-10-15T12:31:05.311Z\",\"updatedAt\":\"2024-12-06T02:39:38.714Z\",\"publishedAt\":\"2024-11-28T17:37:06.293Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"2meon2n3tpz95y4hbr9kgwe1f\",\"paid\":false,\"categories\":[{\"id\":\"c4868181-e303-4aac-8074-bd683d4debe8\",\"name\":\"E-Commerce\",\"slug\":\"ecommerce\"}]}},{\"id\":\"175\",\"resolved\":true,\"title\":\"React Export\",\"body\":\"$6d\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Framer to React Exporter\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Warning\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\": To use this plugin you need React development knowledge. This plugin also requires a $50 (personal hobby plan) or $250 (commercial use plan) monthly subscription. If you are an open source project or non-profit organization you can get a discount by sending a message to the email on the right.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Framer to React Exporter\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" is a powerful plugin that bridges the gap between Framer’s intuitive design environment and your production-ready React codebase. By selecting components directly in the Framer interface and then running the `unframer` CLI, you’ll instantly have fully typed React components—ready to integrate into your Next.js, Remix, or any other modern React framework.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Key Features\"}],\"attrs\":{\"level\":1}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Full Type Safety\",\"marks\":[{\"type\":\"bold\"}]}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Auto-Completed Props \u0026 Variables\",\"marks\":[{\"type\":\"bold\"}]}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Responsive Breakpoints\",\"marks\":[{\"type\":\"bold\"}]}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Reusable Across Frameworks\",\"marks\":[{\"type\":\"bold\"}]}]}]}]},{\"type\":\"paragraph\"},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"How It Works\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"1. \"},{\"type\":\"text\",\"text\":\"Design in Framer:\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Start by crafting your UI in Framer’s visual editor—create headers, footers, banners, hero sections, and more.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"2. \"},{\"type\":\"text\",\"text\":\"Select Components to Export:\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Pick which components you want to bring into your codebase. This can be an entire section of your site or just a small UI element.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"3. \"},{\"type\":\"text\",\"text\":\"Run the `unframer` CLI:\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Using the CLI, download the components as React files, accompanied by their `.d.ts` files for strict type checking and smooth developer experience.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"4. \"},{\"type\":\"text\",\"text\":\"Integrate into Your Project:\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Import the generated components into your React project. You can fine-tune their styling, integrate them into your SSR setup, or even attach event handlers—like `onClick` or custom callbacks—directly in your code.\"}]}]},\"introduction\":\"Export Framer to React\",\"slug\":\"react-export\",\"author\":{\"framerUserId\":\"72e6ad2e-95e0-4e3a-9831-7d2f681ed72e\",\"name\":\"Tommy D. Rossi\",\"slug\":\"unframer\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/29595/avatar-VnwsfFjinujsKl2PI83QMDayj7xiPw.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/175-vRejywXXTrrPRYFFx46wWIDQyPCQ0U\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/175-LAGFBQplLLkZN8ReOg6LBXT8cc6sUL\",\"metadata\":{\"tint\":\"hsl(240 53% 24%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/175-MiotVB4dLkr1x5zUBWEyDjkhCVLF7f\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"0193af03-b7ae-781e-9f41-57a988154a43\",\"bodyJson\":null,\"likes\":{\"count\":79,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2024-12-06T15:42:13.660Z\",\"updatedAt\":\"2026-08-11T10:11:20.550Z\",\"publishedAt\":\"2026-06-29T13:18:19.431Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"dbzjcpb04ur9l6rzcwd5h9n0q\",\"paid\":true,\"categories\":[{\"id\":\"bde1e72b-b4a6-4ecc-8eee-417be77494e8\",\"name\":\"AI\",\"slug\":\"ai\"},{\"id\":\"d42b39e6-e921-4d46-be20-263eb61efbf9\",\"name\":\"Developers\",\"slug\":\"developers\"},{\"id\":\"f6795017-0256-4955-b31a-c81a28ef20ff\",\"name\":\"Integrations\",\"slug\":\"integrations\"}]}},{\"id\":\"11\",\"resolved\":true,\"title\":\"Notion\",\"body\":\"\u003ch2\u003eOverview\u003c/h2\u003e\u003cp\u003eBring the power of Notion into your Framer workflow with seamless synchronization. The Notion plugin for Framer allows you to connect your Notion databases to Framer CMS, making content management smoother and more efficient.\u003c/p\u003e\u003ch2\u003eAutomatic Notion Sync\u003c/h2\u003e\u003cp\u003eWith this plugin, your Notion databases sync automatically with Framer CMS. Once you've set up the initial connection, updating your CMS collections becomes a breeze.\u003c/p\u003e\u003ch2\u003e1-Click Sync\u003c/h2\u003e\u003cp\u003eKeep your content fresh with just one click. After setup, you can instantly synchronize your data, ensuring your website is always up-to-date.\u003c/p\u003e\u003ch2\u003eSupports Multiple CMS Types\u003c/h2\u003e\u003cp\u003eNotion plugin supports a variety of CMS types, including rich text, dates, images, booleans, links, options, references, and galleries. This flexibility ensures that your data, in any format, is seamlessly integrated into your Framer project.\u003c/p\u003e\u003cp\u003eStreamline your workflow by connecting Notion and Framer CMS, and manage your content effortlessly.\u003c/p\u003e\",\"bodyJson\":null,\"introduction\":\"Sync with Notion\",\"slug\":\"notion\",\"author\":{\"framerUserId\":\"a7cd9fe6-cf81-4a41-8e93-bca0291dba80\",\"name\":\"Framer\",\"slug\":\"framer\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/107446/xpZr8yYS_400x400-2-MqZMjb2zlessnXickTqkyAzkfqz6le.jpg\",\"badges\":[\"framer\"],\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/11-2lPhhuVWMPhcPLKJ8dRoagN6gfCJxH\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/11-6Ov8iqI3EfTCumCDWD3GEF5CtkQWn5\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"01924e11-d331-7c8d-b53a-eb816c11a91a\",\"bodyJson\":null,\"likes\":{\"count\":90,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2024-09-25T17:21:05.478Z\",\"updatedAt\":\"2025-10-02T18:23:12.220Z\",\"publishedAt\":\"2024-10-02T16:30:44.017Z\",\"featuredAt\":\"2026-06-04T08:28:07.097Z\",\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"4pc4dx6f1ivpte3hpofvbjbw7\",\"paid\":false,\"categories\":[{\"id\":\"1ad3e7b2-bc61-42ce-b01a-7c8bb2278f1a\",\"name\":\"CMS\",\"slug\":\"cms\"}]}},{\"id\":\"1118\",\"resolved\":true,\"title\":\"3Drop\",\"body\":\"$6e\",\"bodyJson\":null,\"introduction\":\"Image in. 3D out, on canvas.\",\"slug\":\"3drop\",\"author\":{\"framerUserId\":\"5adc9354-58b8-41ef-8dc9-9b6c8b000586\",\"name\":\"David McBacon\",\"slug\":\"david-mcbacon\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/140422/avatar-NVixyvekUcyiULLqZX1744W2h9tJlQ.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/1118-npWl9LDRmEaVfttHgTs3uCzIYWHHi4\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/1118-vARsRe6dHMObjAt0EPAFxpY2MqbnDj\",\"metadata\":{\"tint\":\"hsl(12 83% 19%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019dfde9-1465-70e4-86ea-aa9972041336\",\"bodyJson\":null,\"likes\":{\"count\":48,\"liked\":false},\"comments\":{\"count\":2},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-05-04T22:52:55.824Z\",\"updatedAt\":\"2026-05-07T16:21:16.932Z\",\"publishedAt\":\"2026-05-06T15:30:04.005Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"dp808wzr7lmnq2g4xc8fpfz8n\",\"paid\":true,\"categories\":[{\"id\":\"bde1e72b-b4a6-4ecc-8eee-417be77494e8\",\"name\":\"AI\",\"slug\":\"ai\"}]}},{\"id\":\"1437\",\"resolved\":true,\"title\":\"Layerwave\",\"body\":\"$6f\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Layerwave adds production-ready realtime WebGL effects to your Framer site — interactive distortion and refraction that normally need shaders development.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Browse the effect gallery, preview it live, pick an art-directed preset, and click Add to Canvas. The component is installed into your project automatically — you never paste code or copy a URL. Every parameter stays editable from Framer's property panel afterwards.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Included\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" • Liquid Media — an image or video deformed by cursor movement, with velocity-driven flow, chromatic aberration and idle motion. 6 presets. • Glass Lens — a refractive glass surface with shaped silhouettes, dispersion, frost, contour and highlights. 5 presets.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Built for production\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" • Pauses when off-screen or when the tab is hidden • Lazy media loading, capped device pixel ratio, automatic quality tiers • Respects prefers-reduced-motion, with an optional mobile off switch • Full GPU cleanup — no leaks when instances are added and removed\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Effects render on the canvas as static media so the editor stays fast; flip Canvas Preview on any instance to art-direct it live. Glass Lens refracts the media you give it. Requires WebGL2.\"}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Try it live here → \"},{\"type\":\"text\",\"text\":\"https://layerwave.netlify.app/\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer\",\"href\":\"https://layerwave.netlify.app/\",\"target\":\"_blank\"}}]}]}]},\"introduction\":\"Realtime WebGL effects for Framer\",\"slug\":\"layerwave\",\"author\":{\"framerUserId\":\"9a2501f7-235e-45b0-9847-417fc01abc3e\",\"name\":\"Mathis Biabiany\",\"slug\":\"mathis-biabiany\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/9a2501f7-235e-45b0-9847-417fc01abc3e/5133y73y\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"video\",\"url\":\"https://stream.mux.com/4EWP7K11Cpt02njiW1istFyRuDN01PrFn3vfvt902oEjVE.m3u8\",\"metadata\":{\"posterUrl\":\"https://image.mux.com/4EWP7K11Cpt02njiW1istFyRuDN01PrFn3vfvt902oEjVE/thumbnail.webp?time=5.841\",\"aspectRatio\":\"40:27\",\"duration\":8.844489}},{\"type\":\"video\",\"url\":\"https://stream.mux.com/0100jWB7XeilHMDFa5zz7YKYHBSsjBJaxrBPJEsRWXZto.m3u8\",\"metadata\":{\"posterUrl\":\"https://image.mux.com/0100jWB7XeilHMDFa5zz7YKYHBSsjBJaxrBPJEsRWXZto/thumbnail.webp?time=6.467\",\"aspectRatio\":\"4:3\",\"duration\":9.726889}},{\"type\":\"video\",\"url\":\"https://stream.mux.com/etgMoZQDVTMQtQJ2s98DXwcWDrg3pZjJ6s029trQstPw.m3u8\",\"metadata\":{\"posterUrl\":\"https://image.mux.com/etgMoZQDVTMQtQJ2s98DXwcWDrg3pZjJ6s029trQstPw/thumbnail.webp?time=7.251\",\"aspectRatio\":\"4:3\",\"duration\":12.020867}},{\"type\":\"video\",\"url\":\"https://stream.mux.com/yAkjdwFPA02Mfsc9PMCqIL02j0100PhBv00wcnHsfHw6Pe6E.m3u8\",\"metadata\":{\"posterUrl\":\"https://image.mux.com/yAkjdwFPA02Mfsc9PMCqIL02j0100PhBv00wcnHsfHw6Pe6E/thumbnail.webp?time=3.201\",\"aspectRatio\":\"4:3\",\"duration\":54.455878}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/9a2501f7-235e-45b0-9847-417fc01abc3e/019fd267-8c0d-71b1-8b6d-e50bdff3e89e.jpg\",\"metadata\":{\"tint\":\"hsl(60 53% 39%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019fd267-b7b9-7458-b647-0866c8424c50\",\"bodyJson\":null,\"likes\":{\"count\":21,\"liked\":false},\"comments\":{\"count\":5},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-08-05T14:50:39.985Z\",\"updatedAt\":\"2026-08-24T19:50:45.801Z\",\"publishedAt\":\"2026-08-24T19:50:45.769Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"cvmflrtyf5cxc1nhgerhxsz17\",\"paid\":false,\"categories\":[{\"id\":\"676f63da-b192-4974-930d-73185802088a\",\"name\":\"Assets\",\"slug\":\"assets\"},{\"id\":\"b238ea64-0ce9-413a-848d-43b73f0eea0f\",\"name\":\"Design Workflow\",\"slug\":\"design-workflow\"}]}},{\"id\":\"693\",\"resolved\":true,\"title\":\"PageLock — Password Protect Pages \u0026 CMS\",\"body\":\"$70\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"PageLock is the only Framer plugin where locked content never reaches the browser. Other tools hide pages with CSS or JavaScript, bypassed by viewing source. PageLock serves password-protected pages from a secure server only after a visitor signs in, so your gated content is never in the HTML, sitemap, or Google's index. Real server-side protection, not a client-side CSS overlay.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Setup: pick a page, set a password, publish. No code required.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Lock a single page, multiple pages in one group, CMS pages and collections, or individual CMS items. Use it for a private page, hidden page, members only area, client portal, coming soon page, or gated content. Put a password gate on any page, restrict access, or make a page access controlled.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Protect portfolio work before it is public: set a portfolio password on case studies, client work, a staging site, or a draft page.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Protected Groups: one login for many pages. Create a group, add pages, and protect them all with one set of credentials. Visitors sign in once and get every page in the group. Sessions are scoped per group.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Lock anything, including the CMS: pages, templates, whole collections, or single CMS items on their own slug. Lock one blog post, product, or download without locking the rest.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Authentication your way: PIN code, passcode, username/password, magic link, multiple users per lock, or request-to-access. Visitors unlock with a password or PIN, with built-in recovery.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Branded login screens with your colors, fonts, and logo. White-label removes all Proofly branding. Automatic backups included; visitors stay signed in for 24 hours.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Free to start: lock pages on your staging domain with a PIN at no cost, the same server-side engine Pro uses. Pro unlocks your custom domain, full authentication (password, OTP, multiple users), and white-label branding. $15.99/mo or $159/yr, backed by a 7 day money back guarantee.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Password-protect one page, a group, or your whole CMS. Every locked page is a secure page.\"}]}]},\"introduction\":\"Lock pages single, group \u0026 CMS\",\"slug\":\"pagelock\",\"author\":{\"framerUserId\":\"25f09ec4-366c-432d-9e12-c66cdfa06240\",\"name\":\"Proofly.ae\",\"slug\":\"proofly\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/1675215/avatar-DmouqWfJ81ao7vxLjcwJ5O6o2RBfVv.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/25f09ec4-366c-432d-9e12-c66cdfa06240/94nqq646\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.7777777777777777}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/25f09ec4-366c-432d-9e12-c66cdfa06240/gr6kj1di\",\"metadata\":{\"tint\":\"hsl(0 0% 9%)\",\"aspectRatio\":1.7777777777777777}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/25f09ec4-366c-432d-9e12-c66cdfa06240/v3fqd3h1\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.7777777777777777}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/25f09ec4-366c-432d-9e12-c66cdfa06240/xohgkziz\",\"metadata\":{\"tint\":\"hsl(0 0% 9%)\",\"aspectRatio\":1.7777777777777777}}],\"post\":{\"id\":\"019be25c-1c04-715d-a359-dfe89c18a1ee\",\"bodyJson\":null,\"likes\":{\"count\":43,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-01-04T10:50:28.755Z\",\"updatedAt\":\"2026-08-22T01:26:26.989Z\",\"publishedAt\":\"2026-08-22T01:26:26.982Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"63f2sgjw3o40p5mnvqout1f2t\",\"paid\":true,\"categories\":[{\"id\":\"1ad3e7b2-bc61-42ce-b01a-7c8bb2278f1a\",\"name\":\"CMS\",\"slug\":\"cms\"},{\"id\":\"3176e858-a9a6-426f-894a-e1ef01750d76\",\"name\":\"Forms\",\"slug\":\"forms\"},{\"id\":\"3fc802d9-7527-48e0-9403-c9bd534ab520\",\"name\":\"Utilities\",\"slug\":\"utilities\"}]}},{\"id\":\"15\",\"resolved\":true,\"title\":\"Tidy Up\",\"body\":\"\u003ch2\u003eOverview\u003c/h2\u003e\u003cp\u003eTidy Up is your go-to solution for organizing and aligning your pages, breakpoints, and frames in Framer with just one click. Perfect for designers looking to streamline their layouts and keep projects looking neat.\u003c/p\u003e\u003ch2\u003eOne-Click Layout Organization  \u003c/h2\u003e\u003cp\u003eTidy Up arranges your pages, breakpoints, and frames instantly. Save time and effort by automatically organizing your project with one simple click.\u003c/p\u003e\u003ch2\u003eMultiple Layout Options  \u003c/h2\u003e\u003cp\u003eChoose from a variety of layout styles to fit your design needs. Whether you prefer horizontal, vertical, or grid arrangements, Tidy Up has a layout option that suits your workflow.\u003c/p\u003e\u003ch2\u003eCustomizable Spacing  \u003c/h2\u003e\u003cp\u003eTake control of your design with fully customizable spacing between frames. Adjust the spacing to match your style and ensure a perfectly polished layout every time.\u003c/p\u003e\u003cp\u003eKeep your Framer projects clean and organized with Tidy Up.\u003c/p\u003e\",\"bodyJson\":null,\"introduction\":\"Clean your canvas\",\"slug\":\"tidy-up\",\"author\":{\"framerUserId\":\"a7cd9fe6-cf81-4a41-8e93-bca0291dba80\",\"name\":\"Framer\",\"slug\":\"framer\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/107446/xpZr8yYS_400x400-2-MqZMjb2zlessnXickTqkyAzkfqz6le.jpg\",\"badges\":[\"framer\"],\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/15-hYqNo4kTVi8jaBdtpn06nHGPfohoCV\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/15-OhldY2w5ADgNQAtpHiFgp9vk3rEDrI\",\"metadata\":{\"tint\":\"hsl(240 88% 13%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"01922a89-842b-766d-8eb7-1c4bdb7d1f23\",\"bodyJson\":null,\"likes\":{\"count\":120,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2024-09-25T18:54:06.153Z\",\"updatedAt\":\"2026-06-22T18:05:08.991Z\",\"publishedAt\":\"2026-06-22T18:05:08.981Z\",\"featuredAt\":\"2026-06-15T14:30:30.342Z\",\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"ayqc3f3hshzw5dzbb4ivs3bp9\",\"paid\":false,\"categories\":[{\"id\":\"b238ea64-0ce9-413a-848d-43b73f0eea0f\",\"name\":\"Design Workflow\",\"slug\":\"design-workflow\"}]}},{\"id\":\"1351\",\"resolved\":true,\"title\":\"Paper Shaders\",\"body\":\"\u003ch3\u003e29 GPU shaders — drag or click to add, then tweak the built-in controls.\u003c/h3\u003e\u003cp\u003eFree and built on the open-source \u003ca href=\\\"https://github.com/paper-design/shaders\\\" rel=\\\"noopener noreferrer nofollow\\\" target=\\\"_blank\\\"\u003e@paper-design/shaders\u003c/a\u003e library. This is an independent, community-built plugin — not affiliated with or endorsed by \u003ca href=\\\"https://paper.design\\\" rel=\\\"noopener noreferrer nofollow\\\" target=\\\"_blank\\\"\u003ePaper\u003c/a\u003e.\u003c/p\u003e\u003cp\u003eThanks to the Paper team for sharing it with the community \u003cspan data-type=\\\"emoji\\\" data-name=\\\"blue_heart\\\"\u003e💙\u003c/span\u003e\u003c/p\u003e\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"29 GPU shaders — drag or click to add, then tweak the built-in controls.\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Free and built on the open-source \"},{\"type\":\"text\",\"text\":\"@paper-design/shaders\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer\",\"href\":\"https://github.com/paper-design/shaders\",\"target\":\"_blank\"}}]},{\"type\":\"text\",\"text\":\" library. This is an independent, community-built plugin — not affiliated with or endorsed by \"},{\"type\":\"text\",\"text\":\"Paper\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer\",\"href\":\"https://paper.design\",\"target\":\"_blank\"}}]},{\"type\":\"text\",\"text\":\".\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Thanks to the Paper team for sharing it with the community \"},{\"type\":\"emoji\",\"attrs\":{\"name\":\"blue_heart\",\"emoji\":\"💙\"}}]}]},\"introduction\":\"Shaders for your website\",\"slug\":\"paper-shaders\",\"author\":{\"framerUserId\":\"011b1504-cab2-4545-ad9d-8dd594e291a3\",\"name\":\"Arsyad Fadly\",\"slug\":\"arsyad\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/1024668/avatar-ZjU4zKA6ayrGGPT76crReCytgW9T9f.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"video\",\"url\":\"https://stream.mux.com/Mj1wduA6iUAodF1CREA183IGZ3cSMTRBbfOtG02I5tLE.m3u8\",\"metadata\":{\"posterUrl\":\"https://image.mux.com/Mj1wduA6iUAodF1CREA183IGZ3cSMTRBbfOtG02I5tLE/thumbnail.webp?time=6.727\",\"aspectRatio\":\"961:720\",\"duration\":10.091667}}],\"post\":{\"id\":\"019f3d54-15fe-7758-9da6-28b203b6b6df\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Paper Shader plugin for Framer here :)\"}]}]},\"likes\":{\"count\":68,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-07-07T16:05:48.566Z\",\"updatedAt\":\"2026-07-09T04:57:14.864Z\",\"publishedAt\":\"2026-07-08T16:41:19.669Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"1y53qq2c83kcxrm27vmk8xmrr\",\"paid\":false,\"categories\":[{\"id\":\"676f63da-b192-4974-930d-73185802088a\",\"name\":\"Assets\",\"slug\":\"assets\"},{\"id\":\"79a3568a-05f3-4f98-b70f-6c9ff9e301c4\",\"name\":\"UI Kits\",\"slug\":\"ui-kits\"},{\"id\":\"b238ea64-0ce9-413a-848d-43b73f0eea0f\",\"name\":\"Design Workflow\",\"slug\":\"design-workflow\"}]}},{\"id\":\"1449\",\"resolved\":true,\"title\":\"Instagram Feed - Vanssay\",\"body\":\"$71\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Instagram Feed\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" puts your live Instagram on your Framer site. Paste a handle, pick a layout, insert it on the canvas. New posts sync in on their own from then on.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"No Instagram login, no Meta app review, no API keys, no token to renew. Any public profile works, yours or a client's.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"The only Instagram feed plugin you can buy once instead of renting forever.\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Lifetime is $35, paid once. No subscription, ever.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Why Instagram Feed?\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- \"},{\"type\":\"text\",\"text\":\"6 designed layouts\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\": Profile, Grid, Slider, a depth-blurred Carousel, an auto-scrolling Marquee and a fanned Rainbow deck. Built for Instagram, not adapted from a generic gallery.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- \"},{\"type\":\"text\",\"text\":\"Real Framer controls\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\": columns, gap, corner radius and post count, right in the panel.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- \"},{\"type\":\"text\",\"text\":\"A proper lightbox\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\": full caption, likes, date, carousel slides, video playback and arrow-key navigation.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- \"},{\"type\":\"text\",\"text\":\"Curated mode\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\": hand-pick from your last 50 posts and lock the exact grid.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- \"},{\"type\":\"text\",\"text\":\"Nothing to maintain\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\": images are proxied and cached on our servers, so Instagram's expiring URLs can never break your published site.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"How it works\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- \"},{\"type\":\"text\",\"text\":\"Paste a handle\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\": live preview with real posts, before you pay.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- \"},{\"type\":\"text\",\"text\":\"Pick a layout\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\": flip through all six on your own feed.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- \"},{\"type\":\"text\",\"text\":\"Insert to canvas\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\": a real code component, auto-sized and styled.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- \"},{\"type\":\"text\",\"text\":\"Publish\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\": it keeps itself current after that.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Try every layout on a live feed: \"},{\"type\":\"text\",\"text\":\"https://vanssay.net/instagram-preview\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"https://vanssay.net/instagram-preview\",\"target\":\"_blank\"}}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Pricing\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Lifetime, $35 once\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\": 2 feeds · up to 12 posts · weekly auto-sync · 50,000 views/mo · priority support\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"with a 7-day free trial\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Starter, $7.99/mo\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\": 1 feed · up to 18 posts · daily auto-sync · 10,000 views/mo\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Pro, $17.99/mo\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\": 3 feeds · up to 18 posts · daily auto-sync · 50,000 views/mo · priority support\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Extra feeds are $29 one-time on Pro and Lifetime. One plan covers all your Framer projects. Cancel anytime.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Links\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Website: \"},{\"type\":\"text\",\"text\":\"https://vanssay.net/instagram\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"https://vanssay.net/instagram\",\"target\":\"_blank\"}}]},{\"type\":\"text\",\"text\":\" · Support: \"},{\"type\":\"text\",\"text\":\"support@vanssay.net\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"mailto:support@vanssay.net\",\"target\":\"_blank\"}}]}]},{\"type\":\"paragraph\"}]},\"introduction\":\"always live, buy once\",\"slug\":\"instagram-feed-vanssay\",\"author\":{\"framerUserId\":\"28caa548-cdb6-4992-9127-d2758f0ea47a\",\"name\":\"Marin de Vanssay\",\"slug\":\"marin-de-vanssay\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/28caa548-cdb6-4992-9127-d2758f0ea47a/ophghooc\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/28caa548-cdb6-4992-9127-d2758f0ea47a/019fd927-a308-75a9-a74f-e8f11f2802a3.png\",\"metadata\":{\"tint\":\"hsl(60 53% 39%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/28caa548-cdb6-4992-9127-d2758f0ea47a/019fd927-a34d-70ba-9727-feec7be7cc50.png\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/28caa548-cdb6-4992-9127-d2758f0ea47a/019fd927-a2f4-7369-b03c-a0e7af81a606.png\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/28caa548-cdb6-4992-9127-d2758f0ea47a/019fd927-a350-7139-9a61-61cc86e9875f.png\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/28caa548-cdb6-4992-9127-d2758f0ea47a/019fd927-a306-7357-834b-cacce4a0a919.png\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019fd92b-e476-720d-8475-51fee99e5486\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"OUT NOW!\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Import your Instagram Feed on your Framer canvas, in 6 premium native widgets. Always live. Buy once, own it forever.\"}]}]},\"likes\":{\"count\":18,\"liked\":false},\"comments\":{\"count\":1},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-08-06T22:22:39.278Z\",\"updatedAt\":\"2026-08-27T11:27:49.574Z\",\"publishedAt\":\"2026-08-27T11:27:49.566Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"26j40u6859uiqd1bgj12zn4f2\",\"paid\":true,\"categories\":[{\"id\":\"3fc802d9-7527-48e0-9403-c9bd534ab520\",\"name\":\"Utilities\",\"slug\":\"utilities\"},{\"id\":\"676f63da-b192-4974-930d-73185802088a\",\"name\":\"Assets\",\"slug\":\"assets\"},{\"id\":\"9e4479a9-bb0e-4137-8ac0-4a975eb9b882\",\"name\":\"SEO\",\"slug\":\"seo\"}]}},{\"id\":\"1442\",\"resolved\":true,\"title\":\"Mapframe\",\"body\":\"\u003cp\u003eConnect any Framer CMS collection to a beautiful, interactive map. No code required.\u003c/p\u003e\u003ch2\u003e\u003cstrong\u003eHow It Works\u003c/strong\u003e\u003c/h2\u003e\u003col\u003e\u003cli\u003e\u003cp\u003eOpen the plugin \u0026amp; drop in the map component.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eConnect it to your CMS collection\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eStyle the map, markers \u0026amp; popups to match your brand.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePublish.\u003c/p\u003e\u003c/li\u003e\u003c/ol\u003e\u003ch2\u003e\u003cstrong\u003eKey Features\u003c/strong\u003e\u003c/h2\u003e\u003cp\u003ePut your Framer CMS on the map. Turn every item into a marker with its own popup, then layer on clustering, arcs, routes and camera animations, all without leaving the property panel.\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eCMS or manual points, no CMS required\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCustom markers \u0026amp; popups, built as Framer components\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eClustering \u0026amp; hover tooltips\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e17 map themes, light to full dark\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eGlobe, 3D buildings \u0026amp; camera animations\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eArcs, routes \u0026amp; GeoJSON overlays\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eOne-time payment\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Connect any Framer CMS collection to a beautiful, interactive map. No code required.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"How It Works\",\"marks\":[{\"type\":\"bold\"}]}],\"attrs\":{\"level\":1}},{\"type\":\"orderedList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Open the plugin \u0026 drop in the map component.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Connect it to your CMS collection\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Style the map, markers \u0026 popups to match your brand.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Publish.\"}]}]}],\"attrs\":{\"type\":null,\"start\":1}},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Key Features\",\"marks\":[{\"type\":\"bold\"}]}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Put your Framer CMS on the map. Turn every item into a marker with its own popup, then layer on clustering, arcs, routes and camera animations, all without leaving the property panel.\"}]},{\"type\":\"paragraph\"},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"CMS or manual points, no CMS required\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Custom markers \u0026 popups, built as Framer components\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Clustering \u0026 hover tooltips\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"17 map themes, light to full dark\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Globe, 3D buildings \u0026 camera animations\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Arcs, routes \u0026 GeoJSON overlays\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"One-time payment\"}]}]}]}]},\"introduction\":\"Powerful maps. Built for the CMS.\",\"slug\":\"mapframe\",\"author\":{\"framerUserId\":\"ba90876b-848a-4d1c-bbe3-016394b0d57d\",\"name\":\"Insert Frame\",\"slug\":\"insertframe\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/101008/avatar-ehjigJp2l2cQ7XGmUkjNDaVqdk4Vag.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/ba90876b-848a-4d1c-bbe3-016394b0d57d/019fd5d7-c65f-7395-b3f6-91033a6aa62a.png\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/ba90876b-848a-4d1c-bbe3-016394b0d57d/019fd5d7-c5cc-739b-b50d-596abd77843a.png\",\"metadata\":{\"tint\":\"hsl(0 0% 58%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/ba90876b-848a-4d1c-bbe3-016394b0d57d/019fd5d7-c5eb-734d-b096-cd8854884ba0.png\",\"metadata\":{\"tint\":\"hsl(240 67% 9%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/ba90876b-848a-4d1c-bbe3-016394b0d57d/019fd5d7-c5c7-76ae-ba8f-c88cb5e22e38.png\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019fd5d9-4d31-758e-bca2-9b2961cd7abc\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"world_map\",\"emoji\":\"🗺\"}},{\"type\":\"text\",\"text\":\" Mapframe is live\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Your CMS just got a passport. Mapframe turns any collection into a beautiful, interactive map, no code needed.\"}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"What it unlocks:\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"round_pushpin\",\"emoji\":\"📍\"}},{\"type\":\"text\",\"text\":\" CMS or manual points\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"art\",\"emoji\":\"🎨\"}},{\"type\":\"text\",\"text\":\" 17 map themes\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"globe_with_meridians\",\"emoji\":\"🌐\"}},{\"type\":\"text\",\"text\":\" Globe, 3D \u0026 camera animations\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"thread\",\"emoji\":\"🧵\"}},{\"type\":\"text\",\"text\":\" Arcs, routes \u0026 GeoJSON overlays\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"moneybag\",\"emoji\":\"💰\"}},{\"type\":\"text\",\"text\":\" One-time payment, no subs\"}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Open the plugin \u0026 drop your data on the map \"},{\"type\":\"emoji\",\"attrs\":{\"name\":\"arrow_down\",\"emoji\":\"⬇\"}}]}]},\"likes\":{\"count\":19,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-08-06T06:53:35.306Z\",\"updatedAt\":\"2026-08-12T08:18:33.756Z\",\"publishedAt\":\"2026-08-12T08:18:33.746Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"3gqcrew9ry8cvp94ycsvd4f8i\",\"paid\":true,\"categories\":[{\"id\":\"1ad3e7b2-bc61-42ce-b01a-7c8bb2278f1a\",\"name\":\"CMS\",\"slug\":\"cms\"},{\"id\":\"3fc802d9-7527-48e0-9403-c9bd534ab520\",\"name\":\"Utilities\",\"slug\":\"utilities\"}]}},{\"id\":\"1296\",\"resolved\":true,\"title\":\"AuraBG\",\"body\":\"$72\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"AuraBG generates beautiful mesh gradient and grain backgrounds directly inside Framer. Simply pick your desired aspect ratio and the plugin fills it with a stunning, atmospheric background.. ready to use on any frame.\"}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Features\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- Generate mesh gradients and grain-textured backgrounds instantly\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- Choose your aspect ratio and let AuraBG fill it automatically\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- Works directly on your Framer canvas\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- Lightweight and fast with no external dependencies\"}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"How to Use\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"1. Open the plugin from the Framer plugin panel\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"2. Select your preferred aspect ratio\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"3. Customize the gradient style and grain intensity\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"4. Click generate.. your background is placed instantly on the canvas\"}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Support\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Made by \"},{\"type\":\"text\",\"text\":\"Reem\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"https://www.framer.com/@reem-magdi/\",\"target\":\"_blank\"}}]},{\"type\":\"text\",\"text\":\". If something is not working or you have an idea, email \"},{\"type\":\"text\",\"text\":\"reem@ireem.net\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"mailto:reem@ireem.net\",\"target\":\"_blank\"}}]},{\"type\":\"text\",\"text\":\" and I will take a look.\"}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Pricing\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Free.\"}]}]},\"introduction\":\"Generate mesh gradients \u0026 grain BG\",\"slug\":\"aurabg\",\"author\":{\"framerUserId\":\"c8f4f7d8-50d8-41de-86aa-c8edf2687e0c\",\"name\":\"Reem Magdi\",\"slug\":\"reem-magdi\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/c8f4f7d8-50d8-41de-86aa-c8edf2687e0c/595zcacu\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/c8f4f7d8-50d8-41de-86aa-c8edf2687e0c/bggt0z1p\",\"metadata\":{\"tint\":\"hsl(190 40% 24%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/c8f4f7d8-50d8-41de-86aa-c8edf2687e0c/bz4x2j18\",\"metadata\":{\"tint\":\"hsl(190 40% 24%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019ee626-4d40-72c9-84d7-b6850172e105\",\"bodyJson\":null,\"likes\":{\"count\":13,\"liked\":false},\"comments\":{\"count\":2},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-06-20T17:48:50.334Z\",\"updatedAt\":\"2026-06-23T10:45:10.155Z\",\"publishedAt\":\"2026-06-23T10:45:10.140Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"3v2o54rfybmovrqj2dq6ffb52\",\"paid\":false,\"categories\":[{\"id\":\"3fc802d9-7527-48e0-9403-c9bd534ab520\",\"name\":\"Utilities\",\"slug\":\"utilities\"},{\"id\":\"676f63da-b192-4974-930d-73185802088a\",\"name\":\"Assets\",\"slug\":\"assets\"},{\"id\":\"79a3568a-05f3-4f98-b70f-6c9ff9e301c4\",\"name\":\"UI Kits\",\"slug\":\"ui-kits\"}]}},{\"id\":\"1459\",\"resolved\":true,\"title\":\"Translo\",\"body\":\"$73\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"FREE DURING LAUNCH \"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Translo translates your Framer site with AI and writes every language into your project as real pages. French visitors land on /fr, Arabic visitors on /ar, on your own domain, inside your own project. Real pages Google can index, not a JavaScript overlay that search engines never see.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Setup: pick your languages, let the AI translate, review anything you want to change, publish. No code required.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"AI translation that understands context. Translo reads your pages and translates them with tone and brand glossary control, so product names and brand terms stay exactly as you wrote them. Edit any sentence yourself and your edit is saved, never overwritten the next time you translate.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Real pages, real SEO. Every language gets its own URL with hreflang tags, so search engines know which version to serve to whom. Right to left languages including Arabic and Hebrew are supported, and every breakpoint you designed comes across with the page.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Localize a landing page, a portfolio, a blog, or a full multilingual website. Website translation for headings, body text, buttons and navigation, across every page you choose. 41 languages available.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Translation memory keeps a second run fast: only new or changed text is ever sent again, and anything you edited by hand is left alone.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Your translations stay yours. Export everything as JSON whenever you like, and remove any language's pages from your project in one action.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"How it works: Translo sends the text on your pages to Proofly's servers, where AI translates it, then writes the results back into your project. Only the text is sent. No project name, no page addresses and no Framer identifiers ever leave the plugin. A free Proofly account is required.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Not supported yet: CMS collection items, and styling applied to part of a sentence, such as one coloured word inside a heading, is not preserved.\"}]}]},\"introduction\":\"AI translate your site, SEO ready\",\"slug\":\"translo\",\"author\":{\"framerUserId\":\"25f09ec4-366c-432d-9e12-c66cdfa06240\",\"name\":\"Proofly.ae\",\"slug\":\"proofly\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/1675215/avatar-DmouqWfJ81ao7vxLjcwJ5O6o2RBfVv.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/25f09ec4-366c-432d-9e12-c66cdfa06240/019fe60f-673a-75bb-b459-b12fc7ba643e.png\",\"metadata\":{\"tint\":\"hsl(0 0% 9%)\",\"aspectRatio\":1.40625}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/25f09ec4-366c-432d-9e12-c66cdfa06240/019fe60f-7374-718b-8420-3dac49eb316f.png\",\"metadata\":{\"tint\":\"hsl(0 0% 9%)\",\"aspectRatio\":0.6428571428571429}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/25f09ec4-366c-432d-9e12-c66cdfa06240/019fe60f-816d-734b-9057-1e4dd57d8055.png\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.40625}}],\"post\":{\"id\":\"019fe60f-9573-773f-b133-8b74c5bdbb06\",\"bodyJson\":null,\"likes\":{\"count\":4,\"liked\":false},\"comments\":{\"count\":1},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-08-09T10:26:48.334Z\",\"updatedAt\":\"2026-08-09T19:09:16.899Z\",\"publishedAt\":\"2026-08-09T10:26:49.262Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"1he5ak16aqnymj1sof01tr6iv\",\"paid\":true,\"categories\":[{\"id\":\"29d5d6f9-12d2-41eb-9aec-a9c07f09841a\",\"name\":\"Localization\",\"slug\":\"localization\"},{\"id\":\"bde1e72b-b4a6-4ecc-8eee-417be77494e8\",\"name\":\"AI\",\"slug\":\"ai\"}]}},{\"id\":\"850\",\"resolved\":true,\"title\":\"RevuKit - Instagram Feed\",\"body\":\"$74\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"customYoutube\",\"attrs\":{\"src\":\"https://www.youtube.com/embed/Nn5l0GeJj-4?color=white\u0026autoplay=0\u0026controls=1\u0026rel=0\",\"width\":700,\"height\":395,\"caption\":\"Tutorial\",\"data-youtube-url\":\"https://youtu.be/Nn5l0GeJj-4\"}},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"What's new?\"}],\"attrs\":{\"level\":2}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"6 Layout Templates\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" — Choose from various layout styles and switch between them instantly from Framer's property controls.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Instagram-style Lightbox\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" — Click any post to open a full-size modal with the real Instagram layout: profile header, caption as comment, relative timestamps, likes count, and video playback with mute controls.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"More Options Menu\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" — Ellipsis menu on each lightbox post with quick links to view the original post on Instagram.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Full Profile Header\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" — Displays avatar, handle, verified badge, bio, follower/following/post counts — just like the real Instagram profile page.\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"RevuKit Instagram Feed\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Your Instagram is social proof people actually believe. This plugin brings that proof directly into your Framer experience so it feels intentional, polished, and fully on-brand. Instead of sending visitors away, you keep them engaged on your site while they explore your latest content, feel your momentum, and gain the confidence to take action.\"}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Shows real social proof exactly where visitors are deciding to trust you\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Keeps people on your site longer by making content more engaging\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Makes your brand feel active, modern, and consistently updated\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Helps visitors see your product, culture, and customer love in real moments\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Increases confidence before checkout, booking, or contact\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Gives creators, founders, agencies, and local businesses a stronger “why choose us” section\"}]},{\"type\":\"paragraph\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Questions? Feature requests? We're here to help at \"},{\"type\":\"text\",\"text\":\"revukit.com/instagram-feed/support\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"https://revukit.com/instagram-feed/support\",\"class\":null,\"target\":\"_blank\"}}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Already subscribed? Manage your subscription here - \"},{\"type\":\"text\",\"text\":\"revukit.com/instagram-feed/account\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"https://www.revukit.com/instagram-feed/account\",\"class\":null,\"target\":\"_blank\"}}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Examples\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"https://revukit-instagram-feed.framer.website/\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"https://revukit-instagram-feed.framer.website/\",\"class\":null,\"target\":\"_blank\"}}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Helpful links\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"https://revukit.com/framer/instagram-feed-framer-plugin-update\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"http://revukit.com/framer/instagram-feed-framer-plugin-update\",\"class\":null,\"target\":\"_blank\"}}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"https://www.revukit.com/framer/complete-guide-to-framer\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"https://www.revukit.com/framer/complete-guide-to-framer\",\"class\":null,\"target\":\"_blank\"}}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Privacy Policy: \"},{\"type\":\"text\",\"text\":\"https://www.revukit.com/privacy\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"https://www.revukit.com/privacy\",\"target\":\"_blank\"}}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Terms and Conditions: \"},{\"type\":\"text\",\"text\":\"https://www.revukit.com/terms\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"https://www.revukit.com/terms\",\"target\":\"_blank\"}}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Full data, provider, and runtime dependency disclosure: \"},{\"type\":\"text\",\"text\":\"https://www.revukit.com/framer/instagram-feed-disclosure\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"https://www.revukit.com/framer/instagram-feed-disclosure\",\"target\":\"_blank\"}}]}]}]},\"introduction\":\"No.1 Instagram Feed plugin\",\"slug\":\"revukit-instagram-feed\",\"author\":{\"framerUserId\":\"3686a0b8-f5d2-47a7-9636-4f5b60f54e15\",\"name\":\"RevuKit Studio\",\"slug\":\"revukit-studio\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/3686a0b8-f5d2-47a7-9636-4f5b60f54e15/lh40jmj3\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/3686a0b8-f5d2-47a7-9636-4f5b60f54e15/o8f5ya1q\",\"metadata\":{\"tint\":\"hsl(60 53% 39%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/850-00v5gbRLdr0oppZVzaMycmSAdxMDWf\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/850-LPDa8sjYwfEHOeHOzxBml8gfmSRVJE\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/850-qhqc2UE4fRBEjLFxmk4deA37XxreX7\",\"metadata\":{\"tint\":\"hsl(0 77% 67%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019cbb1f-8d0d-75d6-89ae-4831f7a33253\",\"bodyJson\":null,\"likes\":{\"count\":43,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-03-03T16:45:33.173Z\",\"updatedAt\":\"2026-08-06T12:06:07.199Z\",\"publishedAt\":\"2026-08-06T12:06:07.195Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"12wc97ekhgbkkkyd63kpg7haq\",\"paid\":true,\"categories\":[{\"id\":\"f6795017-0256-4955-b31a-c81a28ef20ff\",\"name\":\"Integrations\",\"slug\":\"integrations\"}]}},{\"id\":\"424\",\"resolved\":true,\"title\":\"Superfields\",\"body\":\"$75\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Advanced CMS filters for Framer. Made simple. \"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Supercharge your Framer CMS with advanced dynamic filtering, built for the CMS that needs to scale.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"How It Works\",\"marks\":[{\"type\":\"bold\"}]}],\"attrs\":{\"level\":1}},{\"type\":\"orderedList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Drop in the components you need, or run the setup wizard.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Connect to your CMS collection.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Style it to match your design.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Publish.\"}]}]}],\"attrs\":{\"type\":null,\"start\":1}},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Key Features\",\"marks\":[{\"type\":\"bold\"}]}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Turn your CMS into a powerful search experience. Superfields lets you build advanced, fully customizable dynamic filtering experiences that let your visitors find the content they care for most, easily.\"}]},{\"type\":\"paragraph\"},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Advanced Filtering\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" - 23 components covering filtering, sorting and more. Stack and combine buttons, dropdowns, checkboxes, sliders, date pickers and more, to give visitors the best content search experience.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Instant Sorting\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" - Let visitors reorder content by what matters most to them, from price and popularity to newest, oldest, rating or any custom CMS value.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Favoriting\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" - Add save and favoriting functionality to any CMS collection, so visitors can bookmark the content they want to return to later.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Map Upgrade\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" - Want maps too? Upgrade to Mapframe from inside the plugin and turn your CMS into a fully interactive map experience.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Complete Control\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" - Control every filter and style everything to remain on brand, all inside Framer.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Zero Code\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" - No technical setup required. Our plugin makes it too easy to build advanced CMS filters.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"One-Time Purchase\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" - No ongoing subscriptions. Pay once and it's yours.\"}]},{\"type\":\"paragraph\"}]}]}]},\"introduction\":\"Supercharge your Framer CMS\",\"slug\":\"superfields\",\"author\":{\"framerUserId\":\"ba90876b-848a-4d1c-bbe3-016394b0d57d\",\"name\":\"Insert Frame\",\"slug\":\"insertframe\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/101008/avatar-ehjigJp2l2cQ7XGmUkjNDaVqdk4Vag.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/ba90876b-848a-4d1c-bbe3-016394b0d57d/019fd6e9-d73c-7169-965d-619c4dcd687c.png\",\"metadata\":{\"tint\":\"hsl(330 67% 9%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/ba90876b-848a-4d1c-bbe3-016394b0d57d/019fd6e9-c8a0-761e-a9e3-a4667eb48628.png\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/ba90876b-848a-4d1c-bbe3-016394b0d57d/019fd6e9-c89e-73d9-a2b5-3ed1bcd26055.png\",\"metadata\":{\"tint\":\"hsl(60 53% 39%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/ba90876b-848a-4d1c-bbe3-016394b0d57d/019fd6e9-c894-70ca-8cc9-f8b5ba5897f4.png\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"0197ff31-b868-7bc6-9adf-b965d0fa8775\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"tada\",\"emoji\":\"🎉\"}},{\"type\":\"text\",\"text\":\" Superfields - \",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\"your CMS just leveled up.\"}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"mag\",\"emoji\":\"🔍\"}},{\"type\":\"text\",\"text\":\" 23 components, filter, sort, favorite \u0026 more\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"new\",\"emoji\":\"🆕\"}},{\"type\":\"text\",\"text\":\" Presets, reference filtering, Infinite Grid\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"world_map\",\"emoji\":\"🗺\"}},{\"type\":\"text\",\"text\":\" Upgrade to Mapframe for maps\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"art\",\"emoji\":\"🎨\"}},{\"type\":\"text\",\"text\":\" Zero code, one-time payment\"}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Open the plugin \u0026 see what's new\"}]}]},\"likes\":{\"count\":25,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2025-07-11T12:33:28.351Z\",\"updatedAt\":\"2026-08-12T08:17:58.293Z\",\"publishedAt\":\"2026-08-12T08:17:58.284Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"d7gtpgj6q5h4a98m4p67b7oc6\",\"paid\":true,\"categories\":[{\"id\":\"1ad3e7b2-bc61-42ce-b01a-7c8bb2278f1a\",\"name\":\"CMS\",\"slug\":\"cms\"}]}},{\"id\":\"1299\",\"resolved\":true,\"title\":\"FeedSpring\",\"body\":\"$76\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Add beautiful, fully customizable social feeds to any Framer site.\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"FeedSpring is a purpose-built social feed plugin for Framer that helps you \"},{\"type\":\"text\",\"text\":\"add live Instagram, Google Reviews, TikTok, Dribbble and other feeds without ugly embeds or generic widgets.\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Build your feed, choose a layout, paste it into Framer, and customize the design directly inside Framer. Adjust spacing, typography, colors, borders, radius and more so your feed matches your site.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Instagram, TikTok, Google Reviews and Dribbble feeds for Framer\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Perfect for portfolios, agencies, SaaS sites, ecommerce stores, local businesses and client projects.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Features\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Instagram, Google Reviews, TikTok, Dribbble and more\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Complete design control inside Framer\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Pre-made responsive feed layouts\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Customize typography, spacing, colors, borders and radius\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Auto-sync your latest content\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Fast global CDN delivery\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Zero layout shift\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Unlimited feed connections\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"No-code setup\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Why FeedSpring?\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Most social feed tools force you into slow widgets, limited layouts or ugly embeds that are hard to style.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"FeedSpring is different. It is built for Framer, so your feeds feel native to your website, not pasted on from a third-party tool.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Use FeedSpring to showcase posts, highlight customer reviews, display social proof, keep marketing pages fresh, and bring real content into your Framer projects.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"How It Works\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Create a feed in FeedSpring\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Choose your platform\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Copy a Framer-ready component or layout\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Paste it into your Framer project\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Add your FeedSpring ID\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Customize the design in Framer\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Publish your site\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Best For\"}],\"attrs\":{\"level\":1}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Framer websites\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Agency client projects\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Portfolio websites\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"SaaS landing pages\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Startup websites\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Ecommerce stores\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Local business websites\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Restaurant, café and hospitality websites\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Creators and personal brands\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"para