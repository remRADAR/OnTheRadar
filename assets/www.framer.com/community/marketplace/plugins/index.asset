3333333333}}],\"post\":{\"id\":\"019cb484-9c2c-7eef-9cb3-aeb61225ada1\",\"bodyJson\":null,\"likes\":{\"count\":21,\"liked\":false},\"comments\":{\"count\":2},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-03-03T00:12:25.316Z\",\"updatedAt\":\"2026-03-03T22:05:56.646Z\",\"publishedAt\":\"2026-03-03T16:25:15.564Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"cghv0bcv1oewgkfm6jzsr9kt7\",\"paid\":false,\"categories\":[{\"id\":\"b238ea64-0ce9-413a-848d-43b73f0eea0f\",\"name\":\"Design Workflow\",\"slug\":\"design-workflow\"}]}},{\"id\":\"1246\",\"resolved\":true,\"title\":\"Best Video Player\",\"body\":\"$88\",\"bodyJson\":null,\"introduction\":\"Free Custom Video Player Framer\",\"slug\":\"best-video-player\",\"author\":{\"framerUserId\":\"7f4238a9-7650-437e-8609-358d1a6ede0f\",\"name\":\"Sillyweb\",\"slug\":\"sillyweb\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/1765995/Hlvo-URZc-hT6JQi8FcsSPhv2o7TGto51x7Ps8fm\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/7f4238a9-7650-437e-8609-358d1a6ede0f/x4ahd42w\",\"metadata\":{\"tint\":\"hsl(0 0% 9%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/7f4238a9-7650-437e-8609-358d1a6ede0f/u37abece\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019eb19b-021d-79b2-8cac-7a3b51f4fac6\",\"bodyJson\":null,\"likes\":{\"count\":42,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-06-05T23:32:49.842Z\",\"updatedAt\":\"2026-07-04T20:34:25.546Z\",\"publishedAt\":\"2026-06-10T12:56:26.397Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"9b861ezqt0966o5akjirapxy8\",\"paid\":false,\"categories\":[{\"id\":\"3fc802d9-7527-48e0-9403-c9bd534ab520\",\"name\":\"Utilities\",\"slug\":\"utilities\"},{\"id\":\"9e4479a9-bb0e-4137-8ac0-4a975eb9b882\",\"name\":\"SEO\",\"slug\":\"seo\"},{\"id\":\"f6795017-0256-4955-b31a-c81a28ef20ff\",\"name\":\"Integrations\",\"slug\":\"integrations\"}]}},{\"id\":\"1125\",\"resolved\":true,\"title\":\"Before After Image Slider\",\"body\":\"$89\",\"bodyJson\":null,\"introduction\":\"BEAF\",\"slug\":\"beaf\",\"author\":{\"framerUserId\":\"dd3380a5-5fea-401b-be33-8ad908368c7b\",\"name\":\"Framefic\",\"slug\":\"framefic\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/2290784/avatar-D7VyRiPUPgg7M2fib6UPMu0jbZVdeS.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/1125-WavG4gm1wvmHwBArvyyaKGIBrhFe79\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/1125-BLyisy1nFmbfHL9tHEvHuBCTbXgvgM\",\"metadata\":{\"tint\":\"hsl(300 26% 62%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/1125-zJ3McNSRtVfcOtwjrrgeEIQSiL1vM4\",\"metadata\":{\"tint\":\"hsl(300 26% 62%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/1125-GOoqthWBa5PnPDq2XMifwRSaR18cKf\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019e05e5-e101-7ac1-bf45-60f3918006e0\",\"bodyJson\":null,\"likes\":{\"count\":28,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-05-06T09:02:37.681Z\",\"updatedAt\":\"2026-08-12T09:35:18.572Z\",\"publishedAt\":\"2026-08-12T09:35:18.569Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"1atwxslds8u3f1aeofjozq9d1\",\"paid\":true,\"categories\":[{\"id\":\"3fc802d9-7527-48e0-9403-c9bd534ab520\",\"name\":\"Utilities\",\"slug\":\"utilities\"},{\"id\":\"79a3568a-05f3-4f98-b70f-6c9ff9e301c4\",\"name\":\"UI Kits\",\"slug\":\"ui-kits\"},{\"id\":\"b238ea64-0ce9-413a-848d-43b73f0eea0f\",\"name\":\"Design Workflow\",\"slug\":\"design-workflow\"}]}},{\"id\":\"1331\",\"resolved\":true,\"title\":\"Router - Vanssay\",\"body\":\"$8a\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Router\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" sends each visitor to the right page on your Framer site by \"},{\"type\":\"text\",\"text\":\"country, continent, region/city, language, device, or VPN/proxy\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\". Set the rules once, enforced on every visit.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Location is resolved \"},{\"type\":\"text\",\"text\":\"server-side from the visitor's real IP\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\": no API keys in your site, no visitor data stored, a fast check before the page shows.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Why Router?\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- \"},{\"type\":\"text\",\"text\":\"Route by anything\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\": country, region, language, device or VPN, alone or combined\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- \"},{\"type\":\"text\",\"text\":\"Redirect or suggest\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\": send visitors straight there, or show a dismissible \"},{\"type\":\"text\",\"text\":\"suggestion banner\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" (Airbnb-style)\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- \"},{\"type\":\"text\",\"text\":\"Tamper-proof\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\": decided on our servers, instant, unbypassable\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- \"},{\"type\":\"text\",\"text\":\"Test console\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\": simulate any country, language or device, no VPN\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- \"},{\"type\":\"text\",\"text\":\"No account needed\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\": a built-in \"},{\"type\":\"text\",\"text\":\"demo\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" opens the whole plugin first\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"How it works\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- \"},{\"type\":\"text\",\"text\":\"Build your rules\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\": match by geo/language/device/VPN, set a path or URL\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- \"},{\"type\":\"text\",\"text\":\"Choose the action\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\": a hard redirect or a styled suggestion banner\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- \"},{\"type\":\"text\",\"text\":\"Test, then publish\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\": preview visitors, then one click injects it site-wide\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Built for control\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- \"},{\"type\":\"text\",\"text\":\"VPN \u0026 proxy aware\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\": reuses the Vanssay Bouncer engine so geo rules can't be faked\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- \"},{\"type\":\"text\",\"text\":\"Conditional \u0026 scheduled rules\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\": route by geo + device, or only in set time windows\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- \"},{\"type\":\"text\",\"text\":\"Analytics\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\": traffic and redirects by rule, country, language\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"If anything goes wrong, Router does nothing and the visitor just stays, so it never breaks your site.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Pricing\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Free\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\": 1 rule · country redirect · whitelist + fallback · internal paths · visitor memory · test console\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Pro, $9/mo\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\": \"},{\"type\":\"text\",\"text\":\"unlimited rules\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" · external URLs · blacklist · continent/region/city · language combos · \"},{\"type\":\"text\",\"text\":\"VPN/proxy\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" · \"},{\"type\":\"text\",\"text\":\"suggestion banner\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" (custom + translations) · UTM preservation · analytics\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Agency, $29/mo\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\": all of Pro · \"},{\"type\":\"text\",\"text\":\"per-device rules\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" · \"},{\"type\":\"text\",\"text\":\"scheduled routing\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" · \"},{\"type\":\"text\",\"text\":\"webhooks\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" · \"},{\"type\":\"text\",\"text\":\"CSV export\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" · priority support\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"One subscription covers all your Framer projects · 7-day money-back guarantee.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Links\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Website: \"},{\"type\":\"text\",\"text\":\"https://vanssay.net/router\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer\",\"href\":\"https://vanssay.net/router\",\"target\":\"_blank\"}}]},{\"type\":\"text\",\"text\":\" · Support: \"},{\"type\":\"text\",\"text\":\"support@vanssay.net\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"mailto:support@vanssay.net\",\"target\":\"_blank\"}}]}]},{\"type\":\"paragraph\"}]},\"introduction\":\"Country \u0026 Language Redirect\",\"slug\":\"router-vanssay\",\"author\":{\"framerUserId\":\"28caa548-cdb6-4992-9127-d2758f0ea47a\",\"name\":\"Marin de Vanssay\",\"slug\":\"marin-de-vanssay\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/28caa548-cdb6-4992-9127-d2758f0ea47a/ophghooc\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/28caa548-cdb6-4992-9127-d2758f0ea47a/xrai05op\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/28caa548-cdb6-4992-9127-d2758f0ea47a/3oes2l4k\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/28caa548-cdb6-4992-9127-d2758f0ea47a/rnk6k8vb\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/28caa548-cdb6-4992-9127-d2758f0ea47a/70u7lpi3\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/28caa548-cdb6-4992-9127-d2758f0ea47a/wnbsv0n6\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019f23f5-45be-74d2-85a7-e0962bb9e7f0\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Just launched \"},{\"type\":\"text\",\"text\":\"Router\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\"!\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Send every visitor to the right page on your Framer site by country, region, language, device, or VPN. Do a hard redirect or show a dismissible \\\"continue in your region?\\\" banner. Resolved server-side, no code, no API keys. Free to start.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"You can also checkout the demo mode with no account required!\"}]}]},\"likes\":{\"count\":16,\"liked\":false},\"comments\":{\"count\":1},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-07-02T17:51:44.507Z\",\"updatedAt\":\"2026-08-04T21:47:33.210Z\",\"publishedAt\":\"2026-07-06T12:58:35.821Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"4rmcxwk1wml3kkgvgz5dou1yi\",\"paid\":true,\"categories\":[{\"id\":\"29d5d6f9-12d2-41eb-9aec-a9c07f09841a\",\"name\":\"Localization\",\"slug\":\"localization\"},{\"id\":\"3fc802d9-7527-48e0-9403-c9bd534ab520\",\"name\":\"Utilities\",\"slug\":\"utilities\"}]}},{\"id\":\"115\",\"resolved\":true,\"title\":\"Airtable\",\"body\":\"\u003ch2\u003eOverview\u003c/h2\u003e\u003cp\u003eSync your Airtable Bases directly with Framer CMS. Authenticate with Airtable, select a base, choose which fields to map to each CMS field, and click import. Once synced, the Plugin will remember the connected table and allow for syncing with one click. With support for References, Multi-References, Toggle, Color, Number, String, Image, File, Link, Date, and Gallery field types you can easily sync a wide range of use-cases into your Framer site.\u003c/p\u003e\u003ch2\u003eFeatures\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eOne click-syncing via the CMS Toolbar\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eEasy base \u0026amp; table selection dropdowns\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eField mapping via the Manage button\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSupport for several field types\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"bodyJson\":null,\"introduction\":\"Sync with Airtable\",\"slug\":\"airtable\",\"author\":{\"framerUserId\":\"a7cd9fe6-cf81-4a41-8e93-bca0291dba80\",\"name\":\"Framer\",\"slug\":\"framer\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/107446/xpZr8yYS_400x400-2-MqZMjb2zlessnXickTqkyAzkfqz6le.jpg\",\"badges\":[\"framer\"],\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/115-2WlSpxAgHIPMgk3NrLk7ag3LqQTDbD\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/115-OhF8Z0e3UDeSiWusT4o1tBakoeBAGm\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"01936dd2-452a-734b-a878-cd837fca52f5\",\"bodyJson\":null,\"likes\":{\"count\":14,\"liked\":false},\"comments\":{\"count\":2},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2024-11-04T10:54:21.677Z\",\"updatedAt\":\"2025-10-02T18:22:32.214Z\",\"publishedAt\":\"2024-11-27T13:31:57.098Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"ajm1rbv6epwlfpvgr49is3m46\",\"paid\":false,\"categories\":[{\"id\":\"1ad3e7b2-bc61-42ce-b01a-7c8bb2278f1a\",\"name\":\"CMS\",\"slug\":\"cms\"}]}},{\"id\":\"1064\",\"resolved\":true,\"title\":\"CMS Translator\",\"body\":\"\u003cp\u003eThree ways to translate any Framer CMS collection — DeepL automatic (best quality, free tier covers 500k chars/month), any LLM via copy/paste (ChatGPT, Claude, Gemini — no extra subscription), or manual rewrite directly inside the plugin.\u003c/p\u003e\u003cp\u003eCreates a re-syncable Synced mirror collection in any of 54 built-in languages, plus custom ISO codes (Swahili, Basque, Persian…). Strings, rich text, slugs and enum fields are preserved. Sync only re-translates new items — your existing translations and manual edits stay intact.\u003c/p\u003e\u003cp\u003eIncludes an in-plugin item editor with accordion UI, search, sort, Draft/Live toggle, and inputs for every field type (text, rich text, image URL, enum, date, number, color).\u003c/p\u003e\u003cp\u003eWorks on every Framer plan. No paid locales add-on required.\u003c/p\u003e\u003cp\u003eFree: 1 translation included. Pro €19 one-time: unlimited collections \u0026amp; languages, re-sync, custom ISO codes, in-plugin editor, lifetime updates.\u003c/p\u003e\",\"bodyJson\":null,\"introduction\":\"Translate Your Framer CMS\",\"slug\":\"cms-translator\",\"author\":{\"framerUserId\":\"5cc8022e-81cf-4d8d-9537-17d489dadac1\",\"name\":\"Ilies Allali\",\"slug\":\"ilies-allali\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/146401/avatar-j0mWSkxtIA5OziAYwXjl0zrghpqn0Y.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/1064-JwXdSwW6qEUjOkS0USouthsTLNk0ra\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/1064-BoNZQZGfx8Nn8HXmB2qrtc5e02jEML\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019dc027-9354-795d-af5c-c9b113014e82\",\"bodyJson\":null,\"likes\":{\"count\":8,\"liked\":false},\"comments\":{\"count\":2},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-04-22T14:27:54.786Z\",\"updatedAt\":\"2026-08-10T15:28:42.348Z\",\"publishedAt\":\"2026-08-10T15:28:42.339Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"evbx6zybxn0t04440pkeud39z\",\"paid\":true,\"categories\":[{\"id\":\"29d5d6f9-12d2-41eb-9aec-a9c07f09841a\",\"name\":\"Localization\",\"slug\":\"localization\"}]}},{\"id\":\"66\",\"resolved\":true,\"title\":\"TypeSystem\",\"body\":\"\u003ch2\u003eRevolutionize your setup workflow in Framer with text styles that are perfectly scaled and responsive\u003c/h2\u003e\u003cp\u003eThe TypeSystem plugin for Framer allows you to generate responsive text styles for your titles and body texts based on the most popular type scales with just a click. Choose your desired scale, tweak the preset text styles, and hit generate. Don't like the options? Just add your own.\u003c/p\u003e\u003ch2\u003eInstant text style cleanup: Wipe the slate clean with one click!\u003c/h2\u003e\u003cp\u003eThe plugin will generate 6 heading styles and two body styles. To quickly play around and go back and forth, just erase the plugin generated styles with one click.\u003c/p\u003e\",\"bodyJson\":null,\"introduction\":\"Generate custom text styles\",\"slug\":\"typesystem\",\"author\":{\"framerUserId\":\"9fe0915a-1d2c-44d4-ae44-5251ad7dce8f\",\"name\":\"Cédric\",\"slug\":\"cedric\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/28870/avatar.jpg\",\"badges\":[\"pro\"],\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/66-KVWiaxbY3TxMsoccDkOemzlKSGvYI5\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/66-80a1boeZpB81BEkbkwujXtsoSlKlK0\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019295e8-805d-7f74-99fb-7e9663844c52\",\"bodyJson\":null,\"likes\":{\"count\":63,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2024-10-08T21:12:08.610Z\",\"updatedAt\":\"2024-10-16T16:59:47.864Z\",\"publishedAt\":\"2024-10-16T15:18:15.389Z\",\"featuredAt\":\"2026-06-19T10:03:27.755Z\",\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"fg8kfqxy5jp1stoodoxrlqcy5\",\"paid\":false,\"categories\":[{\"id\":\"3fc802d9-7527-48e0-9403-c9bd534ab520\",\"name\":\"Utilities\",\"slug\":\"utilities\"}]}},{\"id\":\"562\",\"resolved\":true,\"title\":\"Feedify RSS\",\"body\":\"$8b\",\"bodyJson\":null,\"introduction\":\"Feedify RSS\",\"slug\":\"feedify-rss\",\"author\":{\"framerUserId\":\"ccd8aecf-9639-4bcf-ae46-d9b936296e82\",\"name\":\"Benjamin Barak\",\"slug\":\"benjamin-barak\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/ccd8aecf-9639-4bcf-ae46-d9b936296e82/1ufpt7p2\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/562-Cw1zZHvePae0iHbXYncsEzoByGaPmE\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/562-VQDJjNedE8ptUlPk59vTri7gHlm1kA\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019a51be-0d01-7bae-9e1d-339b85863149\",\"bodyJson\":null,\"likes\":{\"count\":18,\"liked\":false},\"comments\":{\"count\":7},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2025-10-26T20:54:37.917Z\",\"updatedAt\":\"2025-10-26T20:54:43.981Z\",\"publishedAt\":\"2025-11-05T02:00:01.025Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"2tftzxbc5q4uo0zdwp26r7ni3\",\"paid\":true,\"categories\":[{\"id\":\"1ad3e7b2-bc61-42ce-b01a-7c8bb2278f1a\",\"name\":\"CMS\",\"slug\":\"cms\"}]}},{\"id\":\"1327\",\"resolved\":true,\"title\":\"My Project Cleaner\",\"body\":\"$8c\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Overview\",\"marks\":[{\"type\":\"bold\"}]}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"My Project Cleaner\",\"marks\":[{\"type\":\"italic\"}]},{\"type\":\"text\",\"text\":\" is your go-to tool for \"},{\"type\":\"text\",\"text\":\"scanning\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" and \"},{\"type\":\"text\",\"text\":\"cleaning up\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" your Framer \"},{\"type\":\"text\",\"text\":\"canvas\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\". Find layers cluttering your project and remove them in seconds, keeping your canvas clean and project more organized!\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Detects:\",\"marks\":[{\"type\":\"bold\"},{\"type\":\"italic\"}]}],\"attrs\":{\"level\":2}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"hidden layers\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"zero opacity layers\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"zero size layers\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"off-canvas layers\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"single character text layers\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"empty image layers\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"empty components\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"How does it work?\",\"marks\":[{\"type\":\"bold\"}]}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"With \"},{\"type\":\"text\",\"text\":\"one click\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\", \"},{\"type\":\"text\",\"text\":\"My Project Cleaner\",\"marks\":[{\"type\":\"italic\"}]},{\"type\":\"text\",\"text\":\" scans your entire page and flags every problematic layer by category. No manual hunting through the layers panel. \"},{\"type\":\"text\",\"text\":\"Rescan anytime\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" after making changes.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"See, Review, and Delete with Precision\",\"marks\":[{\"type\":\"bold\"}]}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Click \"},{\"type\":\"text\",\"text\":\"See Layer\",\"marks\":[{\"type\":\"bold\"},{\"type\":\"italic\"}]},{\"type\":\"text\",\"text\":\" to jump directly to any flagged layer on your canvas. Delete individual layers one by one, or remove an entire category at once with the \"},{\"type\":\"text\",\"text\":\"Delete All \",\"marks\":[{\"type\":\"bold\"},{\"type\":\"italic\"}]},{\"type\":\"text\",\"text\":\"button. Use the usual ⌘Z in Framer at any time to restore deleted layers.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"The fun part: tidiness score! \",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"emoji\",\"attrs\":{\"name\":\"sparkles\",\"emoji\":\"✨\"}}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"See your real-time Page \"},{\"type\":\"text\",\"text\":\"Tidiness Meter \",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\"that reflects how clean your Framer project is. Watch your score improve as you clean up and hit 100 for a perfectly clean canvas.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"You choose what to scan\",\"marks\":[{\"type\":\"bold\"}]}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Customize your scan by \"},{\"type\":\"text\",\"text\":\"toggling\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" which \"},{\"type\":\"text\",\"text\":\"layer types\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" to include. Only care about hidden and off-canvas layers? Turn off the rest. My Project Cleaner adapts to your workflow.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"I don't know about you, but I'm sold!\",\"marks\":[{\"type\":\"bold\"}]}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"· Made by Arta from Jelly Studio ·\"}]}]},\"introduction\":\"My Project Cleaner\",\"slug\":\"my-project-cleaner\",\"author\":{\"framerUserId\":\"bbe3708d-fd09-450a-9fdf-e1c6cd0fc6c7\",\"name\":\"Arta Tei\",\"slug\":\"arta-tei\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/1136234/avatar-s2M6gvsEadI9D6f1sgS1vqNCqZDGIH.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"video\",\"url\":\"https://stream.mux.com/8gfPp5YQVrzK4qG9hY02Dh4t3bObDW14gnzIxw1evwg4.m3u8\",\"metadata\":{\"posterUrl\":\"https://image.mux.com/8gfPp5YQVrzK4qG9hY02Dh4t3bObDW14gnzIxw1evwg4/thumbnail.webp?time=13.117\",\"aspectRatio\":\"4:3\",\"duration\":14.65}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/bbe3708d-fd09-450a-9fdf-e1c6cd0fc6c7/h75rkalj\",\"metadata\":{\"tint\":\"hsl(240 50% 6%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019f1ec0-a242-750b-bc34-15069d411e05\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Guys! I finished my first plugin!! \"},{\"type\":\"emoji\",\"attrs\":{\"name\":\"sparkles\",\"emoji\":\"✨\"}},{\"type\":\"text\",\"text\":\" This was SO fun. I made a plugin that I know I'd use a lot. My favorite feature is \\\"See Layer\\\" as it zooms in exactly where the culprit layer item is. Try it out, it's free! \"},{\"type\":\"emoji\",\"attrs\":{\"name\":\"sparkles\",\"emoji\":\"✨\"}},{\"type\":\"text\",\"text\":\" Feedback appreciated ✌🏻\"}]}]},\"likes\":{\"count\":9,\"liked\":false},\"comments\":{\"count\":2},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-07-01T17:36:08.715Z\",\"updatedAt\":\"2026-07-13T12:39:49.175Z\",\"publishedAt\":\"2026-07-12T12:09:21.167Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"1i4obw2d3z5c2ves7ut7t1428\",\"paid\":false,\"categories\":[{\"id\":\"3fc802d9-7527-48e0-9403-c9bd534ab520\",\"name\":\"Utilities\",\"slug\":\"utilities\"},{\"id\":\"b238ea64-0ce9-413a-848d-43b73f0eea0f\",\"name\":\"Design Workflow\",\"slug\":\"design-workflow\"}]}},{\"id\":\"1424\",\"resolved\":true,\"title\":\"Gradient Noise Background\",\"body\":\"$8d\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Gradient Noise Background\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"(Mesh Studio)\",\"marks\":[{\"type\":\"italic\"}]},{\"type\":\"text\",\"text\":\" is a charm-filled generative plugin crafted to add modern depth, rich color transitions, and tactile grain textures to your Framer landing pages, hero banners, and digital UI components. Combining smooth mesh gradients with custom noise overlays, these generative assets seamlessly blend vibrant aesthetics with complete creative control.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"What it does\",\"marks\":[{\"type\":\"bold\"}]}],\"attrs\":{\"level\":1}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Preset Library:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Curated style presets—including Aurora Borealis, Sunset Glow, Cyberpunk Neon, and Glassmorphic Sky—to instantly jumpstart your creative workflow.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"AI \u0026 Shuffle Studio:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" One-click color palette and mesh layout randomization to discover fresh design combinations effortlessly.\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Great for\",\"marks\":[{\"type\":\"bold\"}]}],\"attrs\":{\"level\":1}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Modern SaaS \u0026 AI Landing Pages:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Create eye-catching hero section backgrounds, feature cards, and interactive glow areas.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Product Banners \u0026 Editorial Layouts:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Add subtle atmospheric warmth or bold gradient focal points behind your primary content.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Glassmorphic Cards \u0026 UI Layers:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Enhance translucent components with underlying color blooms and fine-grain textures.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Rapid Prototyping:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Experiment with custom aspect ratios (1:1, 16:9, 9:16, 4:3, 2:1) and apply generated art directly to canvas frames in seconds.\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"What you can customize\",\"marks\":[{\"type\":\"bold\"}]}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Easily tweak and adapt every element to fit your project design system:\"}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Color Palette \u0026 Stops:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Add up to 12 color stops, edit hex codes directly, or lock favorite colors while shuffling.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Mesh \u0026 Blur Controls:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Fine-tune blob count, size, spread, and blur softness to achieve exact gradient density.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Noise \u0026 Grain Texture:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Control grain contrast, grain particle size, and opacity for subtle or retro analog feel.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Seed Value Reproducibility:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Lock or enter precise seed numbers to recreate and export exact background compositions anytime.\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Need help?\",\"marks\":[{\"type\":\"bold\"}]}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Have questions or feature suggestions? Reach out anytime at \"},{\"type\":\"text\",\"text\":\"karimsaif010@gmail.com\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"mailto:karimsaif010@gmail.com\",\"target\":\"_blank\"}},{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" or on X \"},{\"type\":\"text\",\"text\":\"@karimsaif0\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\".\"}]}]},\"introduction\":\"Generate mesh gradients \u0026 grain BG\",\"slug\":\"mesh-studio\",\"author\":{\"framerUserId\":\"cdbd7ebc-86d4-4b64-baea-421f236c7c35\",\"name\":\"Karim Saif\",\"slug\":\"karim-saif\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/38316/JKMR4LgEt-1ogBJEJjcXu0BLVSwyn9DCkQ64JbBx\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/cdbd7ebc-86d4-4b64-baea-421f236c7c35/019fc295-a020-75eb-8808-af3d1c64d40d.png\",\"metadata\":{\"tint\":\"hsl(0 0% 9%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/cdbd7ebc-86d4-4b64-baea-421f236c7c35/019fc295-9fbf-73dd-abf3-7bf4779fd8c5.png\",\"metadata\":{\"tint\":\"hsl(0 0% 58%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019fc29e-1dc2-7435-be58-69d0fa814bd8\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Stop using static images for modern website backgrounds. \"},{\"type\":\"emoji\",\"attrs\":{\"name\":\"stop_sign\",\"emoji\":\"🛑\"}}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Introducing \"},{\"type\":\"text\",\"text\":\"Gradient Noise Background\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" for Framer ✦\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Create gorgeous mesh gradients, custom grain noise, and glassmorphic atmospheres directly inside your canvas in seconds.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"sparkles\",\"emoji\":\"✨\"}},{\"type\":\"text\",\"text\":\" 15+ curated presets\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"art\",\"emoji\":\"🎨\"}},{\"type\":\"text\",\"text\":\" AI Studio \u0026 Color Shuffler\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"control_knobs\",\"emoji\":\"🎛\"}},{\"type\":\"text\",\"text\":\" Full grain, blend mode \u0026 seed control\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"zap\",\"emoji\":\"⚡\"}},{\"type\":\"text\",\"text\":\"️ 1-click apply to any layer\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Try it now in the Framer Marketplace! \"},{\"type\":\"emoji\",\"attrs\":{\"name\":\"point_down\",\"emoji\":\"👇\"}}]}]},\"likes\":{\"count\":21,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-08-02T13:16:09.368Z\",\"updatedAt\":\"2026-08-03T13:29:29.263Z\",\"publishedAt\":\"2026-08-03T13:29:29.253Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"3a8jp043zdzlacsfykrmjb6il\",\"paid\":false,\"categories\":[{\"id\":\"676f63da-b192-4974-930d-73185802088a\",\"name\":\"Assets\",\"slug\":\"assets\"},{\"id\":\"b238ea64-0ce9-413a-848d-43b73f0eea0f\",\"name\":\"Design Workflow\",\"slug\":\"design-workflow\"},{\"id\":\"bde1e72b-b4a6-4ecc-8eee-417be77494e8\",\"name\":\"AI\",\"slug\":\"ai\"}]}},{\"id\":\"1493\",\"resolved\":true,\"title\":\"Butter Commerce\",\"body\":\"\u003cp\u003eButter Commerce is currently in private beta and is not publicly available. A beta password is required. If you were not given one, you will not be able to access the plugin.\u003c/p\u003e\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Butter Commerce is currently in private beta and is not publicly available. A beta password is required. If you were not given one, you will not be able to access the plugin.\"}]}]},\"introduction\":\"Butter Commerce\",\"slug\":\"butter-commerce\",\"author\":{\"framerUserId\":\"0507cd8a-2eaf-4492-9ce0-fdb122352559\",\"name\":\"Framer Commerce\",\"slug\":\"framer-commerce\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/84645/x-pfp-uxXyDgvqvsgfSXZYYWdOXk9ugkjiq9.png\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/0507cd8a-2eaf-4492-9ce0-fdb122352559/01a01035-8867-7174-9ebc-f312e6228187.png\",\"metadata\":{\"tint\":\"hsl(0 0% 58%)\",\"aspectRatio\":1.639344262295082}}],\"post\":{\"id\":\"01a01035-d700-74eb-8c10-beaeb27a0762\",\"bodyJson\":null,\"likes\":{\"count\":5,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-08-17T14:52:38.559Z\",\"updatedAt\":\"2026-08-17T14:52:39.583Z\",\"publishedAt\":\"2026-08-17T14:52:39.573Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"1qiulynm4wnvo7uj3c3y8nsgo\",\"paid\":true,\"categories\":[{\"id\":\"1ad3e7b2-bc61-42ce-b01a-7c8bb2278f1a\",\"name\":\"CMS\",\"slug\":\"cms\"},{\"id\":\"c4868181-e303-4aac-8074-bd683d4debe8\",\"name\":\"E-Commerce\",\"slug\":\"ecommerce\"},{\"id\":\"f6795017-0256-4955-b31a-c81a28ef20ff\",\"name\":\"Integrations\",\"slug\":\"integrations\"}]}},{\"id\":\"632\",\"resolved\":true,\"title\":\"Password Protect\",\"body\":\"\u003cp\u003ePassword Protect lets you secure any page inside your Framer project in seconds. Add, edit, or remove page passwords without writing code or leaving the canvas.\u003c/p\u003e\u003cp\u003eThe plugin gives you a clear overview of every protected page in one place, showing which pages are locked, which aren’t, and letting you update them instantly. Each password change applies immediately, making it easy to manage access during client reviews, private launches, or internal testing.\u003c/p\u003e\u003cp\u003eBuilt for simplicity — one click to lock a page, one click to unlock it, and a clean interface that stays out of your way.\u003c/p\u003e\",\"bodyJson\":null,\"introduction\":\"Password Protect\",\"slug\":\"password-protect\",\"author\":{\"framerUserId\":\"032f128e-5c96-4bb7-9fe8-3591074d9bc0\",\"name\":\"Adheeb\",\"slug\":\"adheeb\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/32754/avatar-RI9Pi1QlJdbAUbJ5Zjqqmyz9UQk8Zi.jpg\",\"badges\":[\"pro\"],\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/632-L8nTu3oz3S9LHeSeTzaUw7pf1n6I7L\",\"metadata\":{\"tint\":\"hsl(208 93% 22%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/632-yAW2X8foKAgtV4QhIAkodBUQT3S08t\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019adad9-a0c4-7ab7-9765-748f07e89d38\",\"bodyJson\":null,\"likes\":{\"count\":30,\"liked\":false},\"comments\":{\"count\":5},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2025-11-29T18:16:06.133Z\",\"updatedAt\":\"2025-11-29T18:16:10.617Z\",\"publishedAt\":\"2025-12-01T16:58:06.916Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"7dp2izwt3uglqa02jnha7e6tw\",\"paid\":false,\"categories\":[{\"id\":\"3fc802d9-7527-48e0-9403-c9bd534ab520\",\"name\":\"Utilities\",\"slug\":\"utilities\"}]}},{\"id\":\"376\",\"resolved\":true,\"title\":\"JSON Import \u0026 Export\",\"body\":\"$8e\",\"bodyJson\":null,\"introduction\":\"Import \u0026 export CMS with JSON\",\"slug\":\"json-sync\",\"author\":{\"framerUserId\":\"af6b5c1e-9f7f-41b0-983d-7f97f99d7c72\",\"name\":\"Isaac Roberts\",\"slug\":\"framestack\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/35028/kSFjV8bIu-AKT3u2pg7PrZL7rowyGEY3MFSLial5\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/376-GI1FInhwKhD8PUv8pJtWR1sX2riTdT\",\"metadata\":{\"tint\":\"hsl(203 94% 28%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/376-shAn3IUnm2NOA7n54QadrlC9LxDzqM\",\"metadata\":{\"tint\":\"hsl(203 94% 28%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"01971cb7-f89e-7dfc-9a2d-cc7da2626042\",\"bodyJson\":null,\"likes\":{\"count\":51,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2025-05-29T03:11:44.963Z\",\"updatedAt\":\"2026-08-08T19:42:16.346Z\",\"publishedAt\":\"2026-08-08T19:42:16.339Z\",\"featuredAt\":\"2026-06-04T09:39:05.769Z\",\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"dn4m2ds3urimpk4prxbhntgb2\",\"paid\":false,\"categories\":[{\"id\":\"1ad3e7b2-bc61-42ce-b01a-7c8bb2278f1a\",\"name\":\"CMS\",\"slug\":\"cms\"}]}},{\"id\":\"23\",\"resolved\":true,\"title\":\"LottieFiles\",\"body\":\"$8f\",\"bodyJson\":null,\"introduction\":\"Customizable animations\",\"slug\":\"lottiefiles\",\"author\":{\"framerUserId\":\"5be18903-c1bd-4411-b268-bd4c733e3488\",\"name\":\"LottieFiles\",\"slug\":\"lottiefiles\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/65217/lottiefiles-logo-512-BdULV9sqYxrUEBnU14E3nA2eweUdKe.png\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/23-LuRnBg0qGwOdckuq0B0BPhRFn5aR9u\",\"metadata\":{\"tint\":\"hsl(180 70% 38%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/23-YnoyBAbOHKnDveSRw4r3Nw16hCIfmS\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/23-8zPCIMRi6WFm9sXh7a63rR97boSwZo\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"01922f58-0ce8-7105-93d6-ece6acdca32b\",\"bodyJson\":null,\"likes\":{\"count\":38,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2024-09-26T06:09:38.369Z\",\"updatedAt\":\"2026-07-29T05:29:09.716Z\",\"publishedAt\":\"2026-07-29T05:29:09.690Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"34tc2ja4nxe8bk8603k766y7q\",\"paid\":false,\"categories\":[{\"id\":\"676f63da-b192-4974-930d-73185802088a\",\"name\":\"Assets\",\"slug\":\"assets\"}]}},{\"id\":\"19\",\"resolved\":true,\"title\":\"FramerForms\",\"body\":\"$90\",\"bodyJson\":null,\"introduction\":\"Advanced forms\",\"slug\":\"framerforms\",\"author\":{\"framerUserId\":\"ba90876b-848a-4d1c-bbe3-016394b0d57d\",\"name\":\"Insert Frame\",\"slug\":\"insertframe\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/101008/avatar-ehjigJp2l2cQ7XGmUkjNDaVqdk4Vag.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/19-P1Tj7cRQA3W8avUGHqIyQwRJ4dI6g1\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/19-RI3Jk4zuiEPRQ57bY6KHoUdgQAHTNs\",\"metadata\":{\"tint\":\"hsl(0 0% 58%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/19-tNxwEmEYFgzHy04wqig7qkaY1paNF9\",\"metadata\":{\"tint\":\"hsl(245 93% 30%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/19-4yBnxCG790jPobBo6ns3a7ZbmJevfw\",\"metadata\":{\"tint\":\"hsl(245 93% 30%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"01924c42-faac-74e6-8566-3e241632af1f\",\"bodyJson\":null,\"likes\":{\"count\":11,\"liked\":false},\"comments\":{\"count\":1},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2024-09-26T04:20:17.458Z\",\"updatedAt\":\"2026-08-04T06:59:18.004Z\",\"publishedAt\":\"2026-08-04T06:59:17.996Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"8ab2nfbo142wsl47gqw8zh2gk\",\"paid\":true,\"categories\":[{\"id\":\"3176e858-a9a6-426f-894a-e1ef01750d76\",\"name\":\"Forms\",\"slug\":\"forms\"}]}},{\"id\":\"1247\",\"resolved\":true,\"title\":\"FrameCharts\",\"body\":\"\u003cp\u003e\u003cstrong\u003eFrameCharts\u003c/strong\u003e is the fastest way to build, style, and insert production-ready charts directly inside your Framer projects. Stop wrestling with screenshots and bring your data to life in seconds.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eKey Features:\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003e9 Chart Types:\u003c/strong\u003e Bar, Line, Area, Pie, Donut, Scatter, Radar, Stacked Bar, and Combo. (More coming soon)\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eEasy Data Entry:\u003c/strong\u003e Type data into the built-in spreadsheet or paste raw CSVs.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eFull Customization:\u003c/strong\u003e Tweak colors, toggle grids/legends/tooltips, and set custom dimensions.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eLive Preview:\u003c/strong\u003e Interactive preview with Light and Dark mode toggles.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003ePNG Export:\u003c/strong\u003e Download your customized chart as a high-res image with one click.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eNative Integration:\u003c/strong\u003e Inserts directly onto your canvas as a clean, responsive Framer component.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePay One-time, use forever.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"bodyJson\":null,\"introduction\":\"Charts For Framer\",\"slug\":\"framecharts\",\"author\":{\"framerUserId\":\"a698a602-61a2-432e-9ece-e7e00bd33607\",\"name\":\"Soubhagya Sahu\",\"slug\":\"soubhagya\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/241496/avatar-KdgFeN2nBtjtx1ZR3C1ximAaCbnVMd.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/1247-mIpyBwiqQByyZlVpVz7j2yuQEdCCSz\",\"metadata\":{\"tint\":\"hsl(240 50% 6%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/1247-IAoc5aGmU26SAmEEiZF9UNnNDMYKTq\",\"metadata\":{\"tint\":\"hsl(203 94% 28%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/1247-8SbitgNJ7jl0UsCTIDH4uo01iOwNEm\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/1247-4OxsjuisnuGg8wqNPPubYUAZkzp5T0\",\"metadata\":{\"tint\":\"hsl(203 94% 28%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019eaaa2-f8f6-7cde-bfef-4d16d817205e\",\"bodyJson\":null,\"likes\":{\"count\":12,\"liked\":false},\"comments\":{\"count\":2},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-06-06T06:55:21.504Z\",\"updatedAt\":\"2026-08-01T14:39:10.879Z\",\"publishedAt\":\"2026-06-09T04:27:47.830Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"cwf4vb2fzlgn8k9w63jtwssg4\",\"paid\":false,\"categories\":[{\"id\":\"3fc802d9-7527-48e0-9403-c9bd534ab520\",\"name\":\"Utilities\",\"slug\":\"utilities\"},{\"id\":\"676f63da-b192-4974-930d-73185802088a\",\"name\":\"Assets\",\"slug\":\"assets\"},{\"id\":\"79a3568a-05f3-4f98-b70f-6c9ff9e301c4\",\"name\":\"UI Kits\",\"slug\":\"ui-kits\"}]}},{\"id\":\"1524\",\"resolved\":true,\"title\":\"Premely Analytics\",\"body\":\"\u003cp\u003eInstall the official Premely tracker into a Framer site in one action, then measure useful visits, pages, sources, campaigns, goals, funnels and supported revenue events in the Premely dashboard.\u003c/p\u003e\u003cp\u003eThe plugin installs or updates Premely at the end of your site’s head, preserves unrelated custom code, and removes only the Premely loader it owns.\u003c/p\u003e\u003cp\u003eFree to install. An active Premely plan may be required for analytics usage.\u003c/p\u003e\u003cp\u003eDocumentation: \u003ca href=\\\"https://premely.io/docs/install-framer\\\" rel=\\\"noopener noreferrer nofollow\\\" target=\\\"_blank\\\"\u003ehttps://premely.io/docs/install-framer\u003c/a\u003e\u003c/p\u003e\u003cp\u003eSupport: \u003ca href=\\\"mailto:support@premely.io\\\"\u003esupport@premely.io\u003c/a\u003e\u003c/p\u003e\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Install the official Premely tracker into a Framer site in one action, then measure useful visits, pages, sources, campaigns, goals, funnels and supported revenue events in the Premely dashboard.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"The plugin installs or updates Premely at the end of your site’s head, preserves unrelated custom code, and removes only the Premely loader it owns.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Free to install. An active Premely plan may be required for analytics usage.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Documentation: \"},{\"type\":\"text\",\"text\":\"https://premely.io/docs/install-framer\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"https://premely.io/docs/install-framer\",\"target\":\"_blank\"}}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Support: \"},{\"type\":\"text\",\"text\":\"support@premely.io\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"mailto:support@premely.io\",\"target\":\"_blank\"}}]}]}]},\"introduction\":\"Privacy-first analytics for Framer\",\"slug\":\"premely-analytics\",\"author\":{\"framerUserId\":\"1c163ac2-b233-4cad-b301-9c5a28cd58d3\",\"name\":\"Premely\",\"slug\":\"premely\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/1c163ac2-b233-4cad-b301-9c5a28cd58d3/xeosgk10\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/1c163ac2-b233-4cad-b301-9c5a28cd58d3/01a03879-780c-754e-904f-a2edb3051b07.png\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/1c163ac2-b233-4cad-b301-9c5a28cd58d3/01a03879-781a-734a-b574-7912ca301630.png\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/1c163ac2-b233-4cad-b301-9c5a28cd58d3/01a03879-7863-72de-b3af-5b0f794f46b7.png\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.7777777777777777}}],\"post\":{\"id\":\"01a03888-02eb-7302-9dc3-5e7a513bfc46\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Premely Analytics is now available for Framer. Install or update the official tracker in one action, keep unrelated custom code untouched, and measure the journeys that matter in Premely. The plugin is free to install; an active Premely plan may be required for analytics usage.\"}]}]},\"likes\":{\"count\":4,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-08-25T10:47:12.008Z\",\"updatedAt\":\"2026-08-25T10:51:57.731Z\",\"publishedAt\":\"2026-08-25T10:47:13.427Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"27jzrzt2or16x702zffjq2xtg\",\"paid\":true,\"categories\":[{\"id\":\"9e4479a9-bb0e-4137-8ac0-4a975eb9b882\",\"name\":\"SEO\",\"slug\":\"seo\"},{\"id\":\"d42b39e6-e921-4d46-be20-263eb61efbf9\",\"name\":\"Developers\",\"slug\":\"developers\"},{\"id\":\"f6795017-0256-4955-b31a-c81a28ef20ff\",\"name\":\"Integrations\",\"slug\":\"integrations\"}]}},{\"id\":\"1251\",\"resolved\":true,\"title\":\"ShieldPage\",\"body\":\"$91\",\"bodyJson\":null,\"introduction\":\"Password-protect any page\",\"slug\":\"shieldpage\",\"author\":{\"framerUserId\":\"6510d3eb-3cca-4861-bc8f-afdd8cac1465\",\"name\":\"Vasile Tiplea\",\"slug\":\"vasile-tiplea\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/1308412/b89257640d4d1665b1fd3da64ed9d405-Zd4HeeSidh3lDZyd3u6exCVEZIgK8q\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/1251-bYVyGka6zVwwOJ1pBttSaNe7Awv3As\",\"metadata\":{\"tint\":\"hsl(0 0% 58%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/1251-GWhJxVbU2p7xrjKqIaUrpT0viQKBvQ\",\"metadata\":{\"tint\":\"hsl(0 0% 58%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019ea910-b311-78e1-a2ab-79f0b34dc434\",\"bodyJson\":null,\"likes\":{\"count\":9,\"liked\":false},\"comments\":{\"count\":2},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-06-06T20:10:18.326Z\",\"updatedAt\":\"2026-06-06T20:10:19.437Z\",\"publishedAt\":\"2026-06-08T21:08:24.465Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"2lgi60tm9m7jnba31070ascct\",\"paid\":false,\"categories\":[{\"id\":\"3fc802d9-7527-48e0-9403-c9bd534ab520\",\"name\":\"Utilities\",\"slug\":\"utilities\"}]}},{\"id\":\"712\",\"resolved\":true,\"title\":\"WP Sync: WordPress Import\",\"body\":\"$92\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Overview\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Bring your WordPress content into Framer the fast way. WP Sync by \"},{\"type\":\"text\",\"text\":\"19.studio\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"https://19.studio\",\"class\":null,\"target\":\"_blank\"}}]},{\"type\":\"text\",\"text\":\" removes the manual work of migration, letting you import posts, custom post types and woocommerce productsi, directly into Framer CMS with just a few clicks.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Whether you’re redesigning in Framer or migrating a large wordpress website, this plugin keeps everything fast and clean.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Get to know more on the \"},{\"type\":\"text\",\"text\":\"WP Sync website.\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"https://19.studio/wp-sync\",\"class\":null,\"target\":\"_blank\"}}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Do you need help with your new Framer website? \"},{\"type\":\"text\",\"text\":\"Let's chat.\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"https://19.studio/contact\",\"class\":null,\"target\":\"_blank\"}}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Why Use WordPress Sync?\"}],\"attrs\":{\"level\":1}},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Lightning-Fast Migration\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Move hundreds of posts into Framer in seconds. This includes images, video, media, rich text content. No copy-paste, no CSV juggling, no plugins to maintain.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Custom Post Type Support\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Import exactly what you need: posts, news, blog, woocommerce products, or any custom post type from your WordPress setup.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Sync When You Need It\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Import once or re-sync any time. Keep your Framer CMS up to date as your WordPress site changes.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Field Mapping Made Easy\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Map WordPress fields to Framer CMS fields with an intuitive visual interface.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Built to Scale\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"From small blogs to 1,000+ posts, imports stay smooth, stable, and fast. Even for heavy media libraries.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"How It Works\"}],\"attrs\":{\"level\":1}},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"1. Connect your WordPress site using your plugin dashboard.\"}],\"attrs\":{\"level\":2}},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"2. Choose what to import: posts, products, or custom posts.\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Note: you cannot import your wordpress pages.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"3. Map your fields to Framer CMS collections.\"}],\"attrs\":{\"level\":2}},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"4. Import and watch your content appear instantly inside Framer.\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"That’s it. No exporting, no re-formatting, no headaches.\"}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"WordPress Sync makes migration effortless, so you can focus on what matters: designing your new Framer site, not wrestling with legacy content.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Whether you’re launching a fresh redesign or rebuilding a large WordPress archive, this plugin gives you a smooth and reliable workflow from start to finish.\"}]}]},\"introduction\":\"Migrate to Framer CMS\",\"slug\":\"wp-sync\",\"author\":{\"framerUserId\":\"6e1b3e94-02c8-46ee-9644-91cc0f1a701f\",\"name\":\"19.studio\",\"slug\":\"19studio\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/6e1b3e94-02c8-46ee-9644-91cc0f1a701f/ywl95a4n\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/712-1HHMjqT4U6gS90q9CoVnneCLVjQF9Q\",\"metadata\":{\"tint\":\"hsl(220 67% 14%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/712-jtdKCPbwwe9zKZBA7q6V8btoVSTGQD\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/712-qP35ibHFBRvopCd5DlQYPAItKmX6kP\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/712-A7Hd6wtbNIhHXjRFtTUxFgxpInDczf\",\"metadata\":{\"tint\":\"hsl(220 67% 14%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019bd905-23be-713b-8247-d389a8850f8a\",\"bodyJson\":null,\"likes\":{\"count\":21,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-01-14T18:14:50.985Z\",\"updatedAt\":\"2026-06-29T16:22:58.128Z\",\"publishedAt\":\"2026-06-26T09:29:50.812Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"8n9sdnman3ke491bfiz44et9y\",\"paid\":true,\"categories\":[{\"id\":\"1ad3e7b2-bc61-42ce-b01a-7c8bb2278f1a\",\"name\":\"CMS\",\"slug\":\"cms\"},{\"id\":\"d42b39e6-e921-4d46-be20-263eb61efbf9\",\"name\":\"Developers\",\"slug\":\"developers\"},{\"id\":\"f6795017-0256-4955-b31a-c81a28ef20ff\",\"name\":\"Integrations\",\"slug\":\"integrations\"}]}},{\"id\":\"951\",\"resolved\":true,\"title\":\"YouTube Sync\",\"body\":\"$93\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"YouTube Sync connects your YouTube channel to a Framer CMS collection and keeps it up to date. Point it at a channel, hit Sync, and your videos appear as structured CMS items, ready to design with.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"What it does\",\"marks\":[{\"type\":\"bold\"}]}],\"attrs\":{\"level\":1}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Fetches all public videos from a YouTube channel\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Maps video metadata (title, description, thumbnail, publish date, URL) to CMS fields\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Supports channels of any size\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Two sync modes: Full Sync (adds, updates, and removes stale items) or Add Only (never removes)\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Preserves any manual edits you make in the CMS across re-syncs\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"CMS fields created automatically\",\"marks\":[{\"type\":\"bold\"}]}],\"attrs\":{\"level\":1}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Title, Description, Published Date, Thumbnail, Video URL, Video ID\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Hidden (boolean, user-editable: the plugin never overwrites it)\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Setup takes under two minutes:\",\"marks\":[{\"type\":\"bold\"}]}],\"attrs\":{\"level\":1}},{\"type\":\"orderedList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Create a free YouTube Data API key in Google Cloud Console\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Enter your API key and Channel ID in the plugin\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Hit Sync\"}]}]}],\"attrs\":{\"type\":null,\"start\":1}},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Pricing\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Free\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\": sync up to 5 videos to try it out.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"$$99 one-time\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\": unlimited videos, lifetime access, dedicated support. One license per Framer project.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Requirements\"}],\"attrs\":{\"level\":1}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"A YouTube Data API v3 key (free, from Google Cloud Console)\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"A YouTube Channel ID\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"A Framer CMS collection\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Support\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"For setup help and troubleshooting, email us at \"},{\"type\":\"text\",\"text\":\"support@framerlabs.com\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"mailto:support@framerlabs.com\",\"class\":null,\"target\":\"_blank\"}}]},{\"type\":\"text\",\"text\":\".\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Roadmap\"}],\"attrs\":{\"level\":1}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"add support for Transcripts (requires YouTube OAuth)\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"option to sync a specific playlist instead of all channel uploads\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"add more custom user-editable fields\"}]}]}]}]},\"introduction\":\"Import your YouTube videos\",\"slug\":\"youtube-sync\",\"author\":{\"framerUserId\":\"e4963e7a-50a2-4343-9e4b-cd660f2a3c6e\",\"name\":\"Fred Moon\",\"slug\":\"fredmoon\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/28835/IMG_2764-fYoHMRDuXpfEvr4mKyO4ziQuI0kHFO.jpg\",\"badges\":[\"pro\"],\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/951-PYTdEG1zc1WM2nX0i1oKcrLttkXKT4\",\"metadata\":{\"tint\":\"hsl(8 90% 36%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/951-kHqufSHVyFAFKoOBO8d9QdZYaLwzmb\",\"metadata\":{\"tint\":\"hsl(0 91% 35%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/951-Yr3ekilZ1W4iI73AY476pCmtbIAy8i\",\"metadata\":{\"tint\":\"hsl(0 91% 35%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/