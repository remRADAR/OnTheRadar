d\":\"991\",\"resolved\":true,\"title\":\"Page Translator\",\"body\":\"$62\",\"bodyJson\":null,\"introduction\":\"Translate Your Framer Site\",\"slug\":\"page-translator\",\"author\":{\"framerUserId\":\"5cc8022e-81cf-4d8d-9537-17d489dadac1\",\"name\":\"Ilies Allali\",\"slug\":\"ilies-allali\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/146401/avatar-j0mWSkxtIA5OziAYwXjl0zrghpqn0Y.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/991-vCZi6N1fXDlzRV5hGNrte6lekXRu0d\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/991-fgQnDugK1oMNNLCwyyvG4AX84xGmH7\",\"metadata\":{\"tint\":\"hsl(240 67% 9%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019d5b20-f579-7e19-bd7e-7223fb96227f\",\"bodyJson\":null,\"likes\":{\"count\":9,\"liked\":false},\"comments\":{\"count\":1},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-04-04T21:10:17.127Z\",\"updatedAt\":\"2026-06-27T21:29:55.807Z\",\"publishedAt\":\"2026-06-27T21:29:55.784Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"cv7itrghhc15tb4plgbgl9g3o\",\"paid\":true,\"categories\":[{\"id\":\"29d5d6f9-12d2-41eb-9aec-a9c07f09841a\",\"name\":\"Localization\",\"slug\":\"localization\"}]}},{\"id\":\"27\",\"resolved\":true,\"title\":\"Unsplash\",\"body\":\"\u003ch2\u003eOverview\u003c/h2\u003e\u003cp\u003eAccess the world’s largest collection of high-quality stock photos directly within Framer with the Unsplash plugin. Whether you need stunning visuals for a project or just the perfect background image, Unsplash has you covered.\u003c/p\u003e\u003ch2\u003eBrowse Millions of Photos  \u003c/h2\u003e\u003cp\u003eUnsplash offers a vast library of stock photos for every need. From landscapes to abstract art, you’ll find the perfect image to complement your design.\u003c/p\u003e\u003ch2\u003eSearch by Keywords  \u003c/h2\u003e\u003cp\u003eQuickly find the exact photo you need by searching with relevant keywords. This feature saves time and helps you efficiently explore Unsplash’s enormous collection.\u003c/p\u003e\u003cp\u003eElevate your projects with beautiful, high-quality stock photos, all without leaving Framer.\u003c/p\u003e\",\"bodyJson\":null,\"introduction\":\"Royalty-free images\",\"slug\":\"unsplash\",\"author\":{\"framerUserId\":\"a7cd9fe6-cf81-4a41-8e93-bca0291dba80\",\"name\":\"Framer\",\"slug\":\"framer\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/107446/xpZr8yYS_400x400-2-MqZMjb2zlessnXickTqkyAzkfqz6le.jpg\",\"badges\":[\"framer\"],\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/27-2MHKC4p3372jEUrCH0IUf2uKyVKRjw\",\"metadata\":{\"tint\":\"hsl(28 94% 28%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/27-wGOEQ09oCGZNYZxgwQ2AMnIxfCF6Xv\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019241c2-aefe-7e17-a93d-825835b181ca\",\"bodyJson\":null,\"likes\":{\"count\":118,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2024-09-26T11:40:30.757Z\",\"updatedAt\":\"2024-09-30T08:13:49.565Z\",\"publishedAt\":\"2024-09-30T07:08:50.814Z\",\"featuredAt\":\"2026-06-04T08:27:26.483Z\",\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"cmqc8pkxvwstuzme9dilm4zm2\",\"paid\":false,\"categories\":[{\"id\":\"676f63da-b192-4974-930d-73185802088a\",\"name\":\"Assets\",\"slug\":\"assets\"}]}},{\"id\":\"837\",\"resolved\":true,\"title\":\"Forms Plugin\",\"body\":\"$6