-a444-3314375cca62\",\"bodyJson\":null,\"likes\":{\"count\":71,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2024-09-26T09:18:39.768Z\",\"updatedAt\":\"2025-01-09T14:18:10.329Z\",\"publishedAt\":\"2024-10-03T09:46:53.613Z\",\"featuredAt\":\"2026-06-04T08:27:48.308Z\",\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"6qoo7rj8055tzpgjzda3pojoi\",\"paid\":false,\"categories\":[{\"id\":\"9e4479a9-bb0e-4137-8ac0-4a975eb9b882\",\"name\":\"SEO\",\"slug\":\"seo\"}]}},{\"id\":\"364\",\"resolved\":true,\"title\":\"Workshop\",\"body\":\"$7f\",\"bodyJson\":null,\"introduction\":\"Turn ideas into components\",\"slug\":\"workshop\",\"author\":{\"framerUserId\":\"a7cd9fe6-cf81-4a41-8e93-bca0291dba80\",\"name\":\"Framer\",\"slug\":\"framer\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/107446/xpZr8yYS_400x400-2-MqZMjb2zlessnXickTqkyAzkfqz6le.jpg\",\"badges\":[\"framer\"],\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/364-rrl7ReRfV9Nblb6OrBgD3R1FifFSUm\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/364-4FmuvPoPz3al4VrqNNkUjzBUKHexFy\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"0196f3b1-d7c2-75da-8139-8643d5b3d2e7\",\"bodyJson\":null,\"likes\":{\"count\":73,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2025-05-20T08:37:30.931Z\",\"updatedAt\":\"2026-02-13T08:29:25.882Z\",\"publishedAt\":\"2025-05-21T16:34:00.770Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"6tknpn1873dkp0ltqsspbysmm\",\"paid\":false,\"categories\":[{\"id\":\"bde1e72b-b4a6-4ecc-8eee-417be77494e8\",\"name\":\"AI\",\"slug\":\"ai\"}]}},{\"id\":\"289\",\"resolved\":true,\"title\":\"FramerKit\",\"body\":\"\u003cp\u003eBuild Websites Faster with FramerKit\u003c/p\u003e\u003cp\u003eEverything you need to build websites in Framer.\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eResponsive Layout Sections\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eReusable UI Components\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eComplete Page Templates\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eLight \u0026amp; Dark Modes\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eWireframe \u0026amp; Design Versions\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eColor Sets \u0026amp; Design Systems\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eText Styles \u0026amp; Typography\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003ePerfect for designers, freelancers, agencies, and teams building in Framer.\u003c/p\u003e\",\"bodyJson\":null,\"introduction\":\"FramerKit\",\"slug\":\"framerkit\",\"author\":{\"framerUserId\":\"d7f040ec-719a-4613-847b-be47b2c713e7\",\"name\":\"Pavel  Golichenko\",\"slug\":\"pavelgolichenko\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/d7f040ec-719a-4613-847b-be47b2c713e7/gabrtfbz\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/289-aFkFhVaISnIvZqg30oqXYghXrIE04L\",\"metadata\":{\"tint\":\"hsl(240 50% 6%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/289-zCAVGz2HHioIxm5t7hwC5A3cwsw2PG\",\"metadata\":{\"tint\":\"hsl(240 50% 6%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/289-sBLc3yv8Yqf7Q9T3CHBUGPot8XzOyP\",\"metadata\":{\"tint\":\"hsl(240 50% 6%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/289-ZbbuykzVS4RXb1PgyT4qdPv2ONlfdk\",\"metadata\":{\"tint\":\"hsl(240 50% 6%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019625af-049c-75b8-abcb-bd572f5f0c93\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Build websites faster with FramerKit\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"FramerKit is a growing library of ready-to-use sections, components and templates for Framer\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Browse polished layouts, choose Wireframe or Design versions, switch between light and dark modes, and insert what you need directly into your project\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Everything is built to be responsive, customizable and easy to combine, so you can spend less time rebuilding the same UI and more time working on your actual website\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"FramerKit includes:\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Responsive layout sections \"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Reusable UI components \"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Complete page templates \"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Wireframe \u0026 Design versions \"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Light \u0026 Dark modes \"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Color sets and design systems \"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Text Styles and typography\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Built for designers, freelancers, agencies and anyone who wants to build in Framer faster\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Explore FramerKit and start building\"}]}]},\"likes\":{\"count\":45,\"liked\":false},\"comments\":{\"count\":1},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2025-03-24T11:17:43.129Z\",\"updatedAt\":\"2026-08-21T06:54:49.301Z\",\"publishedAt\":\"2026-08-21T06:54:49.292Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"b8l61kqzo2efsfvx6yb1g7ayx\",\"paid\":true,\"categories\":[{\"id\":\"79a3568a-05f3-4f98-b70f-6c9ff9e301c4\",\"name\":\"UI Kits\",\"slug\":\"ui-kits\"}]}},{\"id\":\"1029\",\"resolved\":true,\"title\":\"Supabase Sync\",\"body\":\"$80\",\"bodyJson\":null,\"introduction\":\"Sync Supabase data to Framer CMS\",\"slug\":\"supabase-sync\",\"author\":{\"framerUserId\":\"7f4238a9-7650-437e-8609-358d1a6ede0f\",\"name\":\"Sillyweb\",\"slug\":\"sillyweb\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/1765995/Hlvo-URZc-hT6JQi8FcsSPhv2o7TGto51x7Ps8fm\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/7f4238a9-7650-437e-8609-358d1a6ede0f/01a02482-fdee-7350-a971-b0b2ba69555f.png\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/7f4238a9-7650-437e-8609-358d1a6ede0f/01a02484-6a06-744d-b01e-1a8de2333419.png\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/7f4238a9-7650-437e-8609-358d1a6ede0f/01a02484-6935-74ea-9808-d26060ce3ff3.png\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/7f4238a9-7650-437e-8609-358d1a6ede0f/01a02484-6948-70a2-8e08-bcc018b9b682.png\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019d9d64-4a79-7f63-b5f0-95d13f3fabc8\",\"bodyJson\":null,\"likes\":{\"count\":22,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-04-14T20:48:46.272Z\",\"updatedAt\":\"2026-08-21T13:31:04.154Z\",\"publishedAt\":\"2026-08-10T23:14:22.247Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"7y3qn2fzluq7g3pk8uzvxn9mc\",\"paid\":false,\"categories\":[{\"id\":\"1ad3e7b2-bc61-42ce-b01a-7c8bb2278f1a\",\"name\":\"CMS\",\"slug\":\"cms\"},{\"id\":\"9e4479a9-bb0e-4137-8ac0-4a975eb9b882\",\"name\":\"SEO\",\"slug\":\"seo\"},{\"id\":\"f6795017-0256-4955-b31a-c81a28ef20ff\",\"name\":\"Integrations\",\"slug\":\"integrations\"}]}},{\"id\":\"1489\",\"resolved\":true,\"title\":\"MapQ\",\"body\":\"$81\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"MapQ — Multi-Location Map Plugin for Framer\"}],\"attrs\":{\"level\":1}},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Create beautiful, interactive, and fully customizable multi-location maps directly in Framer with MapQ.\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"MapQ is a powerful multi-location map plugin for Framer that makes it easy to create interactive, engaging, and customizable map experiences without complicated setup or custom development.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Add multiple locations to a single map and showcase each place with custom markers, titles, descriptions, addresses, and other useful information. Visitors can explore locations directly on the map and quickly find the details they need.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Key Features\"}],\"attrs\":{\"level\":2}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Add and manage multiple locations on one interactive map \"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Create custom markers for different locations\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Display detailed information for each location\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Add addresses, descriptions, and location details\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Support interactive map exploration\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Add routes and location-based navigation\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Customize the map to match your website design\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Responsive experience across desktop, tablet, and mobile\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Easy setup and configuration\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Built specifically for Framer projects\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Perfect For\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"MapQ is ideal for business websites, office directories, store locators, real estate websites, property listings, travel and tourism websites, hotels, restaurants, events, venues, local business directories, service-area businesses, and location guides.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Built for Framer\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"MapQ fits naturally into your Framer workflow, giving you a simple way to add professional map functionality to your projects. No need to build a map system from scratch add your locations, customize the experience, and create a polished interactive map that works seamlessly with your design.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Whether you need to showcase a few business branches or multiple locations across different areas, MapQ provides a flexible and engaging way to present location-based information.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Create interactive maps, showcase your locations, and give visitors a better way to explore your business or project with MapQ for Framer.\"}]}]},\"introduction\":\"Multi-location maps made simple\",\"slug\":\"mapq\",\"author\":{\"framerUserId\":\"6b8a7295-7cf5-4068-97c4-9e73f8dd2a5a\",\"name\":\"Nirav Jivani\",\"slug\":\"nirav-jivani\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/748434/avatar-ezVWo89tgH3kXj8m4DfCMnfUlNlRfG.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/6b8a7295-7cf5-4068-97c4-9e73f8dd2a5a/01a01ed1-9444-76df-a3c2-4592604a509d.jpg\",\"metadata\":{\"tint\":\"hsl(240 17% 64%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/6b8a7295-7cf5-4068-97c4-9e73f8dd2a5a/01a00f79-a4a2-72e0-9395-9d8cf4a12805.jpg\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/6b8a7295-7cf5-4068-97c4-9e73f8dd2a5a/01a00f79-b2c4-7273-94c0-19b128b8a2f9.jpg\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/6b8a7295-7cf5-4068-97c4-9e73f8dd2a5a/01a00f79-bbb2-7251-81dc-cd7b326a4191.jpg\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"01a00f7a-7749-7042-b99b-ba8cdff4f44f\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Meet \"},{\"type\":\"text\",\"text\":\"MapQ\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" — a powerful multi-location map plugin for Framer\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Create interactive maps, showcase multiple locations, add custom markers, display location details, and help visitors explore your locations with ease.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Perfect for business websites, store locators, real estate, travel, events, offices, and more.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Built to make adding interactive maps to Framer projects simple, flexible, and beautiful.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Now available for Framer.\",\"marks\":[{\"type\":\"bold\"}]}]}]},\"likes\":{\"count\":6,\"liked\":false},\"comments\":{\"count\":1},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-08-17T11:27:58.698Z\",\"updatedAt\":\"2026-08-27T06:12:27.039Z\",\"publishedAt\":\"2026-08-27T06:12:27.029Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"llsbfiyauq5fezhoub57r5zk9\",\"paid\":true,\"categories\":[{\"id\":\"29d5d6f9-12d2-41eb-9aec-a9c07f09841a\",\"name\":\"Localization\",\"slug\":\"localization\"},{\"id\":\"3fc802d9-7527-48e0-9403-c9bd534ab520\",\"name\":\"Utilities\",\"slug\":\"utilities\"},{\"id\":\"bde1e72b-b4a6-4ecc-8eee-417be77494e8\",\"name\":\"AI\",\"slug\":\"ai\"}]}},{\"id\":\"434\",\"resolved\":true,\"title\":\"Website Mockups Pro\",\"body\":\"\u003cp\u003e\u003cstrong\u003eWebsite Mockups\u003c/strong\u003e transforms your Framer designs into stunning professional presentations instantly. No more boring screenshots—create cinema-quality mockups in 30 seconds.\u003c/p\u003e\u003ch2\u003eKey Features\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003ePremium mockup library\u003c/strong\u003e with beautiful backgrounds\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eOne-click customization\u003c/strong\u003e - adjust colors, shadows, angles\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eDrag \u0026amp; drop simplicity\u003c/strong\u003e - works seamlessly in Framer\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eProfessional results\u003c/strong\u003e without Photoshop skills\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2\u003ePerfect For\u003c/h2\u003e\u003cp\u003eFreelancers, agencies, and developers who want to \u003cstrong\u003ewin more clients\u003c/strong\u003e with presentations that command higher rates.\u003c/p\u003e\u003cp\u003e\u003cem\u003eStop using basic screenshots. Start creating showstoppers.\u003c/em\u003e\u003c/p\u003e\",\"bodyJson\":null,\"introduction\":\"Website Mockups\",\"slug\":\"website-mockups\",\"author\":{\"framerUserId\":\"e61f0a6a-36a9-4888-983d-6ac510419224\",\"name\":\"Syed Saboor\",\"slug\":\"syed-saboor\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/309218/avatar-OjublbQTOL1LRgrwzHgZqBTFloHXgy.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/434-HZlVIcWPjGZZUiTibf6Hw2SReo5zrN\",\"metadata\":{\"tint\":\"hsl(28 94% 28%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/434-TXbtHpmyozU3eDI2AmW6GbJQHlSoP9\",\"metadata\":{\"tint\":\"hsl(32 94% 28%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/434-xdr129iGPRHmY0qTknds6g9ZFkxABk\",\"metadata\":{\"tint\":\"hsl(32 94% 28%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/434-yDQ2ZuLAZ1WjLuaz0CVCU06S6y46u5\",\"metadata\":{\"tint\":\"hsl(32 94% 28%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"01987aca-aca2-7298-8c0b-9ec4934e6c0c\",\"bodyJson\":null,\"likes\":{\"count\":29,\"liked\":false},\"comments\":{\"count\":4},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2025-07-21T19:15:59.549Z\",\"updatedAt\":\"2025-07-21T19:16:16.633Z\",\"publishedAt\":\"2025-08-05T15:12:39.586Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"2afvmbr41c9hes3qq3qbl613d\",\"paid\":true,\"categories\":[{\"id\":\"676f63da-b192-4974-930d-73185802088a\",\"name\":\"Assets\",\"slug\":\"assets\"}]}},{\"id\":\"337\",\"resolved\":true,\"title\":\"FramerCursor\",\"body\":\"$82\",\"bodyJson\":null,\"introduction\":\"Free Framer Cursor Components\",\"slug\":\"framercursor\",\"author\":{\"framerUserId\":\"34b02231-e6ff-4f72-955b-7abf4bf2d179\",\"name\":\"Wiretap Ventures\",\"slug\":\"wiretap-ventures\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/648000/avatar-gVwQafwsOQ2rZv0Wo9JErRExXfOOF2.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/337-prNnTp3BICJJWNGQzSK5r8BcYrWjwL\",\"metadata\":{\"tint\":\"hsl(285 58% 65%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/337-GHhHKNVYfZaKoLrnTRwdhcQoJwFMa6\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/337-UKiNVxcoxtY4RfwjwHqQQcibI2CJUb\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/337-DqiTZfiGxPZM4oF1OgsLUBw4L9LMO2\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"01968fd9-52fc-7547-9419-fa3e3039674d\",\"bodyJson\":null,\"likes\":{\"count\":53,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2025-04-28T20:34:27.867Z\",\"updatedAt\":\"2025-05-01T03:10:27.947Z\",\"publishedAt\":\"2025-05-02T07:15:06.620Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"4x0ptg6ksm3z0tzq486n3l2vs\",\"paid\":false,\"categories\":[{\"id\":\"79a3568a-05f3-4f98-b70f-6c9ff9e301c4\",\"name\":\"UI Kits\",\"slug\":\"ui-kits\"}]}},{\"id\":\"1384\",\"resolved\":true,\"title\":\"Project Analyzer\",\"body\":\"$83\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"As a Framer project grows, a few pages and components quietly pile up to hundreds or thousands of layers.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Those are exactly the ones that make the editor lag, slow your published site, and turn a small edit into a wait. Project Analyzer finds them for you and helps you clear them out, making optimizing your project easy.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Run a quick health check before publishing or handing a project off.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Project health at a glance\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"One bar splits every layer in your project into normal, hidden and unused, so you can see the shape of the problem before reading a single number. \"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Findings that tell you what to fix\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Quick, plain language insights into what is holding your project back the most.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Find what's heavy\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"See which pages carry the most layers, which components are large on their own, and which small components add up across every instance. A component placed on every page is often the real weight.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Spot hidden layers\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Hidden isn't deleted. Those layers still load and still cost you. Project Analyzer shows exactly which pages and components are carrying them, and how many.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Jump straight to the problem\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Click any finding to open a filtered list of exactly those items, or go straight to the page, component, code file or collection it is about.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Tune it to your project\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Set your own thresholds for every check, or switch off the ones you don't need. What counts as too heavy is different for every project.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Free, fast and completely local\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"No account, no sign up, no API key, no external service. Project Analyzer reads your open project right there in Framer, scans it in seconds, and nothing ever leaves the editor. It's free.\"}]}]},\"introduction\":\"Project health at a glance\",\"slug\":\"project-analyzer\",\"author\":{\"framerUserId\":\"a98ea6e9-fbce-48ab-aa45-9277135015b9\",\"name\":\"Maxime Vandenberge\",\"slug\":\"maxime-vandenberge-9700\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/a98ea6e9-fbce-48ab-aa45-9277135015b9/xqkmlkad\",\"badges\":[\"pro\"],\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/a98ea6e9-fbce-48ab-aa45-9277135015b9/019fa820-3714-757b-b979-a000826802c6.png\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.5789473684210527}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/a98ea6e9-fbce-48ab-aa45-9277135015b9/019fa5c6-96b6-719f-acd8-3f0180292da4.png\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.5789473684210527}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/a98ea6e9-fbce-48ab-aa45-9277135015b9/019fa860-4b8b-76da-afd0-0c87ab00e495.png\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.5789473684210527}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/a98ea6e9-fbce-48ab-aa45-9277135015b9/019fa5c6-96b9-720b-92f3-242bbede0740.png\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.5789473684210527}}],\"post\":{\"id\":\"019f8f8b-06c2-7605-96ac-09af2fde2f5b\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"As a Framer project grows, a few pages and components quietly pile up too hundreds or thousands of layers\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Those are exactly the ones that make the editor lag, slow your published site, and turn a small edit into a wait. Project Analyzer finds them for you, making optimizing your project easy.\"}]}]},\"likes\":{\"count\":33,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-07-23T15:14:40.489Z\",\"updatedAt\":\"2026-08-24T11:59:05.772Z\",\"publishedAt\":\"2026-08-24T11:59:05.720Z\",\"featuredAt\":\"2026-07-24T11:23:10.257Z\",\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"1rf7od4ah3mdwlwz5yunyjww6\",\"paid\":false,\"categories\":[{\"id\":\"3fc802d9-7527-48e0-9403-c9bd534ab520\",\"name\":\"Utilities\",\"slug\":\"utilities\"},{\"id\":\"676f63da-b192-4974-930d-73185802088a\",\"name\":\"Assets\",\"slug\":\"assets\"},{\"id\":\"d42b39e6-e921-4d46-be20-263eb61efbf9\",\"name\":\"Developers\",\"slug\":\"developers\"}]}},{\"id\":\"864\",\"resolved\":true,\"title\":\"App Icons\",\"body\":\"\u003cp\u003eInstantly find and drag high-resolution App Store logos, iOS app icons, and Apple app icons into your Figma designs – no screenshots, no manual downloads!\u003c/p\u003e\u003cp\u003eAccess a massive database of over 2 million real App Store icons (from popular apps, games, tools, productivity, finance, social, and more). Perfect for UX designers, app developers, icon designers, competitor analysis, inspiration boards, redesign projects, style guides, or creating app icon mockups.\u003c/p\u003e\",\"bodyJson\":null,\"introduction\":\"Find App logos in minutes\",\"slug\":\"app-icons\",\"author\":{\"framerUserId\":\"53da93fe-7fc0-4600-8014-c07eec4bbc21\",\"name\":\"Neo Tang\",\"slug\":\"neo-tang\",\"avatar\":null,\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/864-KvR8RRFZ83NvCiPtudLiVIdmlY0N0T\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/864-rNFpssIFnq8Je77t4OmyZ3rankBN48\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/864-v7CQ47mkLFbLvq3kWKUmkaBCtk5v9G\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019cd85c-ed81-7db1-ac39-8e1eb02bcf1d\",\"bodyJson\":null,\"likes\":{\"count\":48,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-03-07T16:01:15.452Z\",\"updatedAt\":\"2026-03-10T15:13:34.130Z\",\"publishedAt\":\"2026-03-10T15:28:14.721Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"e3xqqpw7940rhefz2vmvw0nb8\",\"paid\":false,\"categories\":[{\"id\":\"676f63da-b192-4974-930d-73185802088a\",\"name\":\"Assets\",\"slug\":\"assets\"}]}},{\"id\":\"1298\",\"resolved\":true,\"title\":\"PDF Export\",\"body\":\"$84\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"PDF Export for Framer — Export Framer Designs as PDF in Seconds\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"The easiest way to export any Framer frame as a professional PDF. Select a frame, preview the output, download your PDF. No screenshots, no stitching, no third-party tools required.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"What is PDF Export for Framer?\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" PDF Export is a Framer plugin that converts any Framer frame directly into a downloadable PDF file. If you've ever searched for \\\"how to export Framer as PDF\\\" or \\\"Framer to PDF\\\" — this is the answer. No workarounds, no manual steps, just a clean PDF straight from your Framer canvas.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Why PDF Export for Framer?\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Exporting Framer designs as PDF used to mean screenshotting section by section and stitching files together manually. PDF Export for Framer replaces that entire workflow with a single click — directly inside Framer.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Perfect for:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" → Client proposals \u0026 project pitches → Invoices \u0026 bills → Style guides \u0026 moodboards → Manuals \u0026 documentation → Design handoffs for developers \u0026 stakeholders → Portfolio exports \u0026 case studies → Print-ready flyers \u0026 one-pagers\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"How to export Framer as PDF:\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"orderedList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Open PDF Export on your Framer canvas\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Complete the one-time setup in under a minute\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Select your frame, preview the output, download your PDF\"}]}]}],\"attrs\":{\"type\":null,\"start\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Free vs Pro\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" The free tier lets you test PDF Export for Framer on real projects before committing. Pro unlocks 300 exports per month for a Monthly Subscription.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Requirements\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Your Framer site must be published for the plugin to work. \"}]}]},\"introduction\":\"PDF Export, export your Frames!\",\"slug\":\"pdf-export\",\"author\":{\"framerUserId\":\"88ef42a9-d576-476d-8133-6f47f666b5d3\",\"name\":\"Chris Lacorte\",\"slug\":\"chrislacorte\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/130577/avatar-NfJOgzo5NU6LHAmDWjFef1ypVYIxMo.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/88ef42a9-d576-476d-8133-6f47f666b5d3/v55tmub3\",\"metadata\":{\"tint\":\"hsl(180 50% 6%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"video\",\"url\":\"https://stream.mux.com/PyZv43u2DLW1eMlcO8KR5kyj61gvP4hq5KPLq2eW1DE.m3u8\",\"metadata\":{\"posterUrl\":\"https://image.mux.com/PyZv43u2DLW1eMlcO8KR5kyj61gvP4hq5KPLq2eW1DE/thumbnail.webp?time=17.867\",\"aspectRatio\":\"1721:1080\",\"duration\":28.983333}}],\"post\":{\"id\":\"019eeaec-d505-760b-9697-e687b90641cd\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"PDF Export is live on the Framer Marketplace \",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"emoji\",\"attrs\":{\"name\":\"tada\",\"emoji\":\"🎉\"}}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"v1 is out — export any Framer frame directly as a PDF. Select, preview, download. No screenshots, no stitching, no workarounds.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Built for client proposals, invoices, moodboards, handoffs, and more. Your site just needs to be published and you're good to go.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Free tier available to test before you commit. Pro unlocks 300 exports per month — one-time payment, no subscription.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"This is a Beta launch, so I'd love your honest feedback. Bug, missing feature, or just a thought — drop it in the comments. Every response shapes what comes next. \"},{\"type\":\"emoji\",\"attrs\":{\"name\":\"point_down\",\"emoji\":\"👇\"}}]}]},\"likes\":{\"count\":27,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-06-21T16:04:10.077Z\",\"updatedAt\":\"2026-08-25T16:00:45.498Z\",\"publishedAt\":\"2026-08-25T16:00:45.479Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"hj9v7mn2vhxqg4t5nc63ovmb6\",\"paid\":true,\"categories\":[{\"id\":\"3fc802d9-7527-48e0-9403-c9bd534ab520\",\"name\":\"Utilities\",\"slug\":\"utilities\"},{\"id\":\"676f63da-b192-4974-930d-73185802088a\",\"name\":\"Assets\",\"slug\":\"assets\"},{\"id\":\"b238ea64-0ce9-413a-848d-43b73f0eea0f\",\"name\":\"Design Workflow\",\"slug\":\"design-workflow\"}]}},{\"id\":\"248\",\"resolved\":true,\"title\":\"Image \u0026 Video Lightbox Gallery\",\"body\":\"$85\",\"bodyJson\":null,\"introduction\":\"Image \u0026 Video Lightbox Gallery\",\"slug\":\"image-lightbox-gallery\",\"author\":{\"framerUserId\":\"bcb1c22c-10d7-4fff-8941-0b3db5106386\",\"name\":\"Şafak\",\"slug\":\"safakotur\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/29544/q9hnFYKW_400x400-k0AegtwQlOTiLbVwC7vr3jxTw9qWd9.jpeg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/248-6xXjmlOsN4oUwSKrA4dSDD6PPVdea3\",\"metadata\":{\"tint\":\"hsl(240 50% 6%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/248-BB4wGIfc4UVUf9gfcOong2AstMdb7W\",\"metadata\":{\"tint\":\"hsl(240 50% 6%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/248-jz05yG65ulkJ90oP1lBHMQPAAosw26\",\"metadata\":{\"tint\":\"hsl(240 50% 6%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/plugins/248-lYjdcm8SRVzCfhJF3xA3OsAA9ecKLo\",\"metadata\":{\"tint\":\"hsl(240 50% 6%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"01958f39-316a-793c-b862-1f437d027c60\",\"bodyJson\":null,\"likes\":{\"count\":20,\"liked\":false},\"comments\":{\"count\":1},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2025-02-16T20:10:59.231Z\",\"updatedAt\":\"2026-06-14T22:28:32.246Z\",\"publishedAt\":\"2025-03-13T11:17:24.970Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"plugin\",\"attributes\":{\"framerPluginId\":\"byie5nh2sjotq6avfjcubuci4\",\"paid\":true,\"categories\":[{\"id\":\"79a3568a-05f3-4f98-b70f-6c9ff9e301c4\",\"name\":\"UI Kits\",\"slug\":\"ui-kits\"}]}},{\"id\":\"95\",\"resolved\":true,\"title\":\"Shopiframe\",\"body\":\"$86\",\"bodyJson\":null,\"introduction\":\"Integrate with Shopify\",\"slug\":\"shopiframe\",\"author\":{\"framerUserId\":\"47745ef1-855e-412c-a101-305ac078cd49\",\"name\":\"FrameSpace\",\"slug\":\"framespace\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/129533/avatar-CUOFZiJvUMrfCqPnaTe2BesapDWMrY.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/47745ef1-855e-412c-a101-305ac078cd49/019fb061-4aa3-70bd-b2e0-cf1afd0a2c22.png\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/47745ef1-855e-412c-a101-305ac078cd49/019fb065-0f47-7332-960b-c65ea8ef18ef.png\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.333