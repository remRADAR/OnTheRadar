text\",\"text\":\"Framer CMS page\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" or any URL using the \"},{\"type\":\"text\",\"text\":\"CMS Link\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" control. This makes it easy to create clickable project, portfolio, case study, product, or collection showcases.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"✦ Fisheye Image Carousel\"}],\"attrs\":{\"level\":1}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Swell Effect\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" — Cards expand toward the center and smoothly shrink toward the edges.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Infinite Scrolling\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" — Create a continuously moving image carousel.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Center Focus\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" — Automatically emphasize the cards near the center.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Custom Card Size\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" — Adjust card width and aspect ratio.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Edge Scale\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" — Control how small cards become at the edges.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Spread\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" — Adjust the width and intensity of the swell effect.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Overlap\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" — Create tighter card arrangements.\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"✦ CMS-Friendly Links\"}],\"attrs\":{\"level\":1}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Connect each card to a different \"},{\"type\":\"text\",\"text\":\"Framer CMS page\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\".\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Use the \"},{\"type\":\"text\",\"text\":\"CMS Link\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" control for individual cards.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Link cards to projects, case studies, products, portfolios, or any URL.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Choose whether links open in the \"},{\"type\":\"text\",\"text\":\"same tab or a new tab\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\".\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"✦ Smooth Interactions\"}],\"attrs\":{\"level\":1}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Autoplay\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" — Keep the carousel moving automatically.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Direction Control\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" — Move the carousel left or right.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"ty