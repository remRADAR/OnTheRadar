\",\"paymentUrl\":\"https://hreza.lemonsqueezy.com/checkout/buy/8a52cfd7-3af0-449d-be29-1cf366319d80\",\"workshop\":false,\"categories\":[{\"id\":\"1a3a0eb3-698e-461a-bf42-2502a7ed43e0\",\"name\":\"Backgrounds\",\"slug\":\"backgrounds\"}],\"lastSaveId\":\"3CfQToHelN0ZIrSQPsPP\"}},{\"id\":\"2i3I6U8FYMaJ7P1eSf5B\",\"resolved\":true,\"title\":\"CMS Slider Pro\",\"body\":\"$aa\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Key features:\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Direction\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" — Left, Right, Up, or Down\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Multi-item view\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" — show 1–8 cards at once with configurable gap, padding, radius, and aspect ratio\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Playback\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" — autoplay with interval, pause-on-hover, loop, and start-at-start/end\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Navigation\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" — drag (with edge rubber-band resistance), arrow keys, and click\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Scroll step\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" — advance one card at a time or a full page\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Arrows\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" — Split (edge-ancho