omponent\",\"attributes\":{\"url\":\"https://framer.com/m/AnimatedLiquidBackground-Prod-vIhm.js@ghH1aHLmGZ0iE7qXDFVk\",\"previewUrl\":\"https://liquid-bg.learnframer.site/\",\"price\":null,\"paymentUrl\":null,\"workshop\":false,\"categories\":[{\"id\":\"1a3a0eb3-698e-461a-bf42-2502a7ed43e0\",\"name\":\"Backgrounds\",\"slug\":\"backgrounds\"}],\"lastSaveId\":\"ghH1aHLmGZ0iE7qXDFVk\"}},{\"id\":\"rLOhzn6csNCEq5JsXArY\",\"resolved\":true,\"title\":\"Hover Shader Index\",\"body\":\"$88\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Get this component in the complete Shader Components Bundle.\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Access all four paid shader-driven Framer components—worth \"},{\"type\":\"text\",\"text\":\"$$39 separately—for $25.\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Get the Shader Components Bundle →\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer\",\"href\":\"https://buy.polar.sh/polar_cl_FBTRwXvW4IxXMkrBRaY6alzgUNvhGm5kkWwJN4Gn6NH\",\"target\":\"_blank\"}}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Hover Shader Index \",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\"is a premium Framer section with hover-driven shader previews, smooth list interactions, and clean visual rhythm.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Shader Visuals\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Each liquid shader block uses its own color palette and seed, while shared settings keep the overall system consistent.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"The result is five distinct shader combinations that feel connected, with the block, gradient, icon, and description transitioning smoothly between states.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Typography and Spacing\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"The design uses bold Inter typography, tight letter spacing, restrained inactive colors, balanced spacing, rounded shader blocks, and soft motion. The description sits below the list without competing with the main interaction.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Responsiveness\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Desktop is hover-based. On phone, the list becomes a tap accordion: tapping an item reveals its description, dims the others, and shows the matching shader block above the list. Tapping again returns to default.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Customization\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Customizable Framer variables let you adjust content, colors, logos, shader behavior, transitions, radius, and styling.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Customizable fields include:\"}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Item labels, descriptions, and logos\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Item, inactive, and description colors\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Section background color\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Transition settings\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Shader speed, scale, amplitude, frequency, bands, noise amount, definition, and seeds\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Shader block radius for desktop and phone\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Great For\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Ideal for AI startups, SaaS landing pages, product feature sections, service showcases, portfolio pages, tool stack sections, creative studios, and any Framer website that needs a visually rich but minimal way to present multiple capabilities.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Questions \u0026 Support\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Reach out any time via\"},{\"type\":\"text\",\"text\":\" x.com \",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer\",\"href\":\"https://x.com/@omeronframer\",\"target\":\"_blank\"}}]},{\"type\":\"text\",\"text\":\"email at \"},{\"type\":\"text\",\"text\":\"contact@omermirza.com\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"mailto:contact@omermirza.com\",\"target\":\"_blank\"}}]},{\"type\":\"text\",\"text\":\".\"}]}]},\"introduction\":\"Hover List With Shader Previews\",\"slug\":\"hover-shader-index\",\"author\":{\"framerUserId\":\"001f5b33-6097-4b89-9746-eafbbc58ab0c\",\"name\":\"Omer Mirza\",\"slug\":\"omermirza\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/001f5b33-6097-4b89-9746-eafbbc58ab0c/lzhswod7\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/001f5b33-6097-4b89-9746-eafbbc58ab0c/v0n8l5v6\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019ed203-3f2f-7350-80b7-706a5ad52a41\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Introducing Hover Shader Index \"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Inspired by Raul Dronca's original work. Recreated in \"},{\"type\":\"text\",\"text\":\"@framer.\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"https://x.com/framer\",\"target\":\"_blank\"}}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Usually $9 but to celebrate the new Framer community, it is free for 24 hours for whoever gives me a follow and leaves a comment (include your X account as well)\"}]}]},\"likes\":{\"count\":148,\"liked\":false},\"comments\":{\"count\":14},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-06-16T19:58:08.642Z\",\"updatedAt\":\"2026-08-19T16:14:33.102Z\",\"publishedAt\":\"2026-06-16T19:58:08.634Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"component\",\"attributes\":{\"url\":null,\"previewUrl\":\"https://hover-shader-index.framer.website\",\"price\":\"9\",\"paymentUrl\":\"https://contra.com/payment-link/7mASR63e-hover-shader-index-hover-list-with-shader-previews\",\"workshop\":false,\"categories\":[{\"id\":\"3a855006-6097-4489-b33b-8024cb26633e\",\"name\":\"Interactions\",\"slug\":\"interactions\"}],\"lastSaveId\":\"U6KU4pSw9vJlyV1XZT5l\"}},{\"id\":\"iUZQj04cBLtgPIR6u69C\",\"resolved\":true,\"title\":\"Wheel Carousel\",\"body\":\"$89\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Wheel Carousel turns a simple list into a piece of motion design. Labels curve around an invisible drum and sweep past a fixed marker as visitors scroll or drag — the selected item locks upright while the rest arc away and fade into the background, with a portrait photo crossfading in to match whatever's selected.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"It's built for portfolios, project indexes, city/location pickers, menus, or any list where you want scrolling itself to feel like an interaction, not just a means to an end.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Every visual dimension is exposed as a property control: curve radius, label spacing, how many items stay visible, font, colors, marker style, drag and scroll sensitivity, snap and momentum behavior, and a built-in Light / Dark / Custom mode switch. No code editing required — just drop it in, add your items, and tune it in the panel.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Key Features\"}],\"attrs\":{\"level\":1}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Scroll- and drag-driven rotation with momentum and snap-to-item\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Infinite loop — the list wraps seamlessly in either direction\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Photo panel that crossfades to the selected item's image\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Light, Dark, and fully Custom color modes via one toggle\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Editable item list — add any number of rows, each with its own label and uploaded image\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Adjustable curve radius, label spacing, and visible item count for denser or sparser wheels\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Soft top/bottom edge fade — no hard cropping at the frame edges, at any size\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Centered, width-capped layout that holds up across canvas sizes\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Subtle fade-up entrance animation (optional)\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Fully responsive — supports any width and height\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"What Buyers Get\"}],\"attrs\":{\"level\":1}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"The Wheel Carousel code component, ready to paste or duplicate into any Framer project\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Full property-control access — no code editing needed\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Support for unlimited items, each with custom label + image\"}]}]}]}]},\"introduction\":\"A cinematic, rotating-wheel picker\",\"slug\":\"wheel-carousel\",\"author\":{\"framerUserId\":\"c9f12b5c-1282-4c21-8c05-f526eed6f01b\",\"name\":\"Maria\",\"slug\":\"mariathedesigner\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/c9f12b5c-1282-4c21-8c05-f526eed6f01b/026chhq1\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/c9f12b5c-1282-4c21-8c05-f526eed6f01b/019fa821-3ea8-7664-9d25-926a9f5a7e27.jpg\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019f8f92-b1fb-706b-af7a-bccb3901a6dd\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"This cinematic, clean wheel carousel just went live on the Framer Marketplace \"},{\"type\":\"emoji\",\"attrs\":{\"name\":\"ferris_wheel\",\"emoji\":\"🎡\"}}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"A scroll-and-drag picker for your portfolio, project index, or list. Labels sweep around a curved wheel while a photo crossfades in to match whatever's selected. Comes with Light, Dark, and Custom color modes built in, fully responsive, zero code required.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Grab it on the Marketplace!\"}]}]},\"likes\":{\"count\":49,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-07-28T09:51:07.774Z\",\"updatedAt\":\"2026-07-30T11:01:58.839Z\",\"publishedAt\":\"2026-07-28T09:51:07.772Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"component\",\"attributes\":{\"url\":null,\"previewUrl\":\"https://wheel-carousel.framer.website/\",\"price\":\"5\",\"paymentUrl\":\"https://buy.stripe.com/eVq14n5PT2Er30OeDggfu00\",\"workshop\":false,\"categories\":[{\"id\":\"8f93ccfe-423c-47f2-b8ae-79e9e132012f\",\"name\":\"Carousels\",\"slug\":\"carousels\"}],\"lastSaveId\":\"JUFnZdeL6IILCjLvtOto\"}},{\"id\":\"2CSsWi962ZZCTemCJdPZ\",\"resolved\":true,\"title\":\"Scroll 3D Slider\",\"body\":\"\u003cp\u003eScroll-driven image slider powered by Three.js. Pick from five 3D effects — distortion, carousel, coverflow, cube, and cards — and the controls panel adapts to show only the relevant settings for that effect. \u003c/p\u003e\u003cp\u003eSupports horizontal and vertical scroll, plus drag and touch input. \u003c/p\u003e\u003cp\u003eSnap-to-slide, autoplay, and a built-in title/counter overlay are all configurable from the props panel. \u003c/p\u003e\u003cp\u003eProps are grouped into clear sections so nothing gets buried.\u003c/p\u003e\u003ch3\u003eFeatures:\u003c/h3\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e5 effect presets: distortion, carousel, coverflow, cube, cards\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eScroll, drag, and touch input\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eHorizontal or vertical direction\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSnap-to-slide and autoplay\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eConfigurable title + counter overlay\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eContextual controls per effect preset\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eGrouped props for cleaner configuration\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"bodyJson\":null,\"introduction\":\"Infinite-scroll image slider 3d effect\",\"slug\":\"scroll-3d-slider\",\"author\":{\"framerUserId\":\"2a425ad9-c342-4590-af3c-88a1f3875e22\",\"name\":\"Sanna Granqvist\",\"slug\":\"sanna-granqvist\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/2a425ad9-c342-4590-af3c-88a1f3875e22/a2khusgj\",\"badges\":[\"pro\"],\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/components/2CSsWi962ZZCTemCJdPZ/scroll-3d-slider-QBOaxqOQjJTpGYFCUlGuUlq4LqxHvD\",\"metadata\":{\"tint\":\"hsl(0 0% 9%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019d481a-33bf-7edf-a70d-33fe15508405\",\"bodyJson\":null,\"likes\":{\"count\":200,\"liked\":false},\"comments\":{\"count\":4},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-03-15T19:39:24.600Z\",\"updatedAt\":\"2026-03-31T08:00:51.033Z\",\"publishedAt\":\"2026-04-01T08:12:49.983Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"component\",\"attributes\":{\"url\":\"https://framer.com/m/Scroll3dSlider-feA8su.js@2fWxUpTxmOoSNHrRJKeH\",\"previewUrl\":\"https://scroll3dslider.framer.website/\",\"price\":null,\"paymentUrl\":null,\"workshop\":false,\"categories\":[{\"id\":\"8f93ccfe-423c-47f2-b8ae-79e9e132012f\",\"name\":\"Carousels\",\"slug\":\"carousels\"}],\"lastSaveId\":\"2fWxUpTxmOoSNHrRJKeH\"}},{\"id\":\"OhkGFUWiMmtHJKZw58st\",\"resolved\":true,\"title\":\"Tilt Card Group\",\"body\":\"$8a\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Overview\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Tilt Card is a fully interactive, deeply customizable card component built for Framer. Each card responds to the user's cursor with a smooth 3D tilt, a shimmer highlight that follows the mouse, and a soft color glow that pulses on hover — all driven by native browser APIs with no external dependencies.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"The component ships with three pre-built card styles out of the box — Violet, Rose, and Teal — but every visual property is exposed in the properties panel, so you can make it match any brand in minutes.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"What's Included\"}],\"attrs\":{\"level\":2}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Unlimited cards — add or remove cards freely from the properties panel. No cap.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"3D tilt interaction with configurable angle, perspective, and return spring\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Per-card shimmer layer that tracks the cursor position in real time\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Hover glare, mesh gradient layer, noise texture, and colored box shadow — all individually toggleable\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Four custom cursor styles per card: Plus, Asterisk, Circle, and Square — plus the Default browser cursor\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Cursor follows the mouse with a smooth, weighted lag (adjustable per card)\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Logo block that accepts either a text glyph or a custom image — never both simultaneously\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Clickable arrow button with a URL link field per card\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Fully fluid layout — cards shrink gracefully on small screens and grow vertically to fit long content\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Every property grouped into labelled sections with plain-language descriptions so you always know what you're editing\"}]}]}]},{\"type\":\"customHeading\",\"attrs\":{\"level\":2}}]},\"introduction\":\"3D Tilt Cards With Depth \u0026 Glow.\",\"slug\":\"tilt-card-group\",\"author\":{\"framerUserId\":\"a51b36dd-c20b-4c2a-b8c0-30f6fd377ddd\",\"name\":\"Jephthah Ledum\",\"slug\":\"jephthah-ledum\",\"avatar\":\"https://framerusercontent.com/avatars/users/a51b36dd-c20b-4c2a-b8c0-30f6fd377ddd/MLKfswbGE\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/components/OhkGFUWiMmtHJKZw58st/tilt-card-group-u9THH8kisOpnjqCvA2aE7SJHKvSdzH\",\"metadata\":{\"tint\":\"hsl(240 50% 6%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019e3cfc-62e2-7bad-9135-cf639fd01420\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"If you've been putting off adding motion to your feature sections because it always feels like \\\"extra work\\\" — this one's built to remove that friction entirely.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Tilt Card\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" gives you:\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"3D tilt that responds to cursor movement, fully configurable (angle, perspective, spring)\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Per-card shimmer, glare, mesh gradient, and noise — all toggleable\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"4 custom cursor styles (Plus, Asterisk, Circle, Square) + Default\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Unlimited cards, no cap\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Fully fluid — shrinks and grows cleanly on any screen\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"No external dependencies. No code components needed unless you want to go deeper. Just drag it in, plug in your content, and tweak from the properties panel.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Nearly 200 builders are already using it in production sites — feature grids, service breakdowns, you name it.\"}]}]},\"likes\":{\"count\":95,\"liked\":false},\"comments\":{\"count\":2},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-05-03T05:28:04.534Z\",\"updatedAt\":\"2026-07-01T12:19:29.120Z\",\"publishedAt\":\"2026-05-18T21:27:13.890Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"component\",\"attributes\":{\"url\":null,\"previewUrl\":\"https://irresistible-menu-827503.framer.app/preview\",\"price\":\"5\",\"paymentUrl\":\"https://buy.polar.sh/polar_cl_H4crVcEZkbw81V00xbIB8QFK51OKdIODtOc3Z1U9oJK\",\"workshop\":true,\"categories\":[{\"id\":\"3a855006-6097-4489-b33b-8024cb26633e\",\"name\":\"Interactions\",\"slug\":\"interactions\"}],\"lastSaveId\":\"0p3Fyix5SdZ2He09nmY3\"}},{\"id\":\"rTU2Mo4WvAVrPhnCTIsy\",\"resolved\":true,\"title\":\"Dynamic Info\",\"body\":\"\u003cp\u003eThis is an interactive and customizable UI component designed to display user profile information. It features editable fields for the user’s name, role, and profile picture. The component also shows real-time data, such as time or status, making it ideal for dynamic applications. With its minimalist and modern design, this component allows for seamless updates and easy personalization, offering a user-friendly interface suitable for messaging apps, social platforms, or project management tools.\u003c/p\u003e\",\"bodyJson\":null,\"introduction\":\"\",\"slug\":\"dynamic-info\",\"author\":{\"framerUserId\":\"d4303c8e-dd1e-4538-b63e-62ba424cd1f6\",\"name\":\"Federico Esposito\",\"slug\":\"federicoesposito\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/30770/avatar-rm6COZYGW5v2T5EqtVSL6FqCFIWolb.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/components/rTU2Mo4WvAVrPhnCTIsy/dynamic-info-X7Z2hFpGaijdh7Gc2CJYawcr7pIHMC\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019985f2-5e11-7c04-b7e6-b2cef2b9878b\",\"bodyJson\":null,\"likes\":{\"count\":362,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2025-09-19T16:25:00.259Z\",\"updatedAt\":\"2025-09-26T11:47:06.841Z\",\"publishedAt\":\"2025-09-26T12:14:37.585Z\",\"featuredAt\":\"2026-06-15T14:16:23.858Z\",\"reported\":false,\"approvedAt\":null,\"type\":\"component\",\"attributes\":{\"url\":\"https://framer.com/m/Dynamic-Info-JmvR.js@WKgPoJPIgbHfueQ8bTZQ\",\"previewUrl\":\"https://dynamic-info-preview.framer.website/\",\"price\":null,\"paymentUrl\":null,\"workshop\":false,\"categories\":[{\"id\":\"3a855006-6097-4489-b33b-8024cb26633e\",\"name\":\"Interactions\",\"slug\":\"interactions\"}],\"lastSaveId\":\"WKgPoJPIgbHfueQ8bTZQ\"}},{\"id\":\"jjnLlFywbE2VSYPFo6tD\",\"resolved\":true,\"title\":\"Testimonial Hanger\",\"body\":\"$8b\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Testimonial Hanger\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" is a premium hanging testimonial carousel for Framer that transforms customer reviews into an elegant hanging display. Featuring realistic hanging strings, premium editorial cards, smooth spring animations, and immersive interactions, it creates a unique way to showcase testimonials that instantly captures attention and builds trust.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Every testimonial is displayed as a beautifully suspended card featuring customer photos, quotes, names, roles, companies, and customizable styling. With smooth animations, optional autoplay, drag interactions, and complete customization through Framer Property Controls, Testimonial Hanger delivers a polished testimonial experience for modern websites.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Perfect For\"}],\"attrs\":{\"level\":1}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"SaaS Landing Pages\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Startup Websites\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Creative Agencies\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Design Studios\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Personal Portfolios\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Freelancers\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Consultants\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Architecture Firms\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Business Websites\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Features\"}],\"attrs\":{\"level\":1}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Unique hanging testimonial card design\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Realistic hanging strings\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Premium editorial card layouts\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Infinite testimonial carousel\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Smooth spring animations\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Drag and swipe navigation\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Optional autoplay\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Interactive hover effects\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Clickable testimonial cards\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Navigation arrows and pagination\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Responsive across desktop, tablet, and mobile\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Fully customizable typography\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Adjustable colors, spacing, sizing, and layout\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Complete Framer Property Controls\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"No code required\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Why You'll Love It\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Testimonial Hanger gives your social proof a distinctive presentation that feels playful, premium, and memorable. Instead of ordinary testimonial sliders, it creates an interactive hanging display that highlights customer stories with elegant motion and thoughtful design, making your website stand out while building credibility.\"}]},{\"type\":\"paragraph\"}]},\"introduction\":\"Premium Hanging Testimonials\",\"slug\":\"testimonial-hanger\",\"author\":{\"framerUserId\":\"ca05e506-1465-479c-9098-193c2ad13a2b\",\"name\":\"Design Foundry\",\"slug\":\"designfoundry\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/ca05e506-1465-479c-9098-193c2ad13a2b/xcfk0umu\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/ca05e506-1465-479c-9098-193c2ad13a2b/019fd143-8041-749c-a71f-e72234b8e162.png\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019fd144-7627-7398-862f-5eae44f6aa60\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Just launched \"},{\"type\":\"text\",\"text\":\"Testimonial Hanger\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" \"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"An editorial hanging testimonial carousel with natural swing animations, smooth drag interactions, autoplay, and full customization. A unique way to showcase customer reviews on modern websites.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"heart\",\"emoji\":\"❤\"}},{\"type\":\"text\",\"text\":\" If you find it useful, please give it a like on the component page!\"}]}]},\"likes\":{\"count\":32,\"liked\":false},\"comments\":{\"count\":4},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-08-05T09:32:32.215Z\",\"updatedAt\":\"2026-08-08T13:41:09.039Z\",\"publishedAt\":\"2026-08-05T09:32:32.213Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"component\",\"attributes\":{\"url\":null,\"previewUrl\":\"https://testimonialhanger.framer.website/\",\"price\":\"10\",\"paymentUrl\":\"https://buy.polar.sh/polar_cl_GeLBJ39PwabZ95CjAdMAeZgZYQ06mfcgBflSm39AAWY\",\"workshop\":false,\"categories\":[{\"id\":\"8f93ccfe-423c-47f2-b8ae-79e9e132012f\",\"name\":\"Carousels\",\"slug\":\"carousels\"}],\"lastSaveId\":\"kfmChRVluxeBceHtjFJW\"}},{\"id\":\"KCcHFFkWHYb7sNJkZUvd\",\"resolved\":true,\"title\":\"Smooth Image Trail\",\"body\":\"$8c\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"A transparent overlay that spawns image stickers along your cursor as you move, then fades them out behind you. It turns any section into a playful, interactive moment, like leaving a trail of stickers wherever the mouse goes.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Drop in up to 10 images and they appear one after another as the cursor moves, each with slightly randomized size and rotation so the trail always feels organic. New stickers spawn based on distance moved, so the spacing stays even instead of clumping.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Built to work anywhere: the background stays fully transparent, the layer passes clicks through to content beneath it, and there's no text or clutter, just your images following the cursor. Tune everything from the panel: spacing, fade, size, rotation, and how many appear at once.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Features\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Image stickers trail the cursor as it moves\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Up to 10 custom images\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Randomized size and rotation for an organic feel\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Even spacing based on distance, no clumping\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Transparent and click-through, works over any section\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Tunable spacing, fade, size, and count\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Responsive and performance-friendly\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"How to use\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" \"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Drop it on top of any section, upload your images, and adjust the trail to taste. Great as an interactive hero layer, a landing accent, or a playful about-page touch.\"}]}]},\"introduction\":\"Sticker trail that follows cursor\",\"slug\":\"smooth-image-trail\",\"author\":{\"framerUserId\":\"22f194ca-4704-4786-b94f-970f9d3548b7\",\"name\":\"Daniil Filatov\",\"slug\":\"filatovdesign\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/22f194ca-4704-4786-b94f-970f9d3548b7/3dpat02y\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/22f194ca-4704-4786-b94f-970f9d3548b7/1w2d5j4w\",\"metadata\":{\"tint\":\"hsl(0 0% 58%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019f42f4-fa98-7608-aeec-1c9a6b155bfa\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Your images trail the cursor and fade as you go, works as an overlay on anything. Grab the remix and make it yours.\"}]}]},\"likes\":{\"count\":203,\"liked\":false},\"comments\":{\"count\":2},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-07-08T18:19:38.748Z\",\"updatedAt\":\"2026-07-09T08:25:21.212Z\",\"publishedAt\":\"2026-07-08T18:19:38.745Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"component\",\"attributes\":{\"url\":\"https://framer.com/m/SmoothImageCursor-KDy2rX.js@hlsQst4eU2SiqLNxx4IO\",\"previewUrl\":\"https://whole-globe-065232.framer.app/\",\"price\":null,\"paymentUrl\":null,\"workshop\":false,\"categories\":[{\"id\":\"3a855006-6097-4489-b33b-8024cb26633e\",\"name\":\"Interactions\",\"slug\":\"interactions\"}],\"lastSaveId\":\"hlsQst4eU2SiqLNxx4IO\"}},{\"id\":\"YHnSk6STU9Nll6MQXCZe\",\"resolved\":true,\"title\":\"Chat Messages\",\"body\":\"$8d\",\"bodyJson\":null,\"introduction\":\"\",\"slug\":\"chat-messages\",\"author\":{\"framerUserId\":\"2a425ad9-c342-4590-af3c-88a1f3875e22\",\"name\":\"Sann