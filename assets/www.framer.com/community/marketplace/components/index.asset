shedAt\":\"2026-05-30T14:56:29.089Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"component\",\"attributes\":{\"url\":null,\"previewUrl\":\"https://animatedstatspro.framer.website/\",\"price\":\"5\",\"paymentUrl\":\"https://ahmetloca.lemonsqueezy.com/checkout/buy/4b6a7bd2-de29-4650-b7c9-382b5b2dcda6\",\"workshop\":false,\"categories\":[{\"id\":\"367c9c1e-4f68-45ab-8981-56e69b3dda95\",\"name\":\"Data\",\"slug\":\"data\"}],\"lastSaveId\":\"QAXPP93pk281zyy591Bi\"}},{\"id\":\"YtF12YUbIRaBI097IO7p\",\"resolved\":true,\"title\":\"E-Commerce Mega Nav\",\"body\":\"$86\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"About\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"E-Commerce Mega Nav is a complete responsive shopping navigation with an announcement bar, search field, account actions, category links, and four product-rich mega menus. Each menu combines product previews, organized link columns, and a large promotional card, while mobile transforms into a full-height drawer with drill-down categories.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"What you can customize\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Built entirely with native Framer elements and fully editable on the canvas. Customize the logo, products, images, categories, menu links, promotional cards, CTA buttons, icons, cart badge, colors, typography, and responsive layouts without code. The styled search field is ready to connect to Framer Search and your CMS.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Great for (examples)\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Just a few ideas, use it anywhere you need a more complete product discovery experience:\"}]},{\"type\":\"bulletList\",\"content\":[{\"ty