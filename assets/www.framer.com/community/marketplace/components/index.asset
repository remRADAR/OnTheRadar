-storage.com/components/n57x7pUtparegV6rvCXB/text-arrow-cta-jPboVfdSdC7P7KUekxvel0UW4LhB6i\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019df8af-9adb-7de9-9af8-84a59586a956\",\"bodyJson\":null,\"likes\":{\"count\":248,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-04-18T12:00:19.216Z\",\"updatedAt\":\"2026-05-30T08:37:56.041Z\",\"publishedAt\":\"2026-05-05T15:09:11.259Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"component\",\"attributes\":{\"url\":\"https://framer.com/m/Text-Arrow-CTA-qdMepe.js@XiBbzo9BI6TcvdY4iuSg\",\"previewUrl\":\"https://arrowlinkcta.framer.website/\",\"price\":null,\"paymentUrl\":null,\"workshop\":false,\"categories\":[{\"id\":\"cd81cc33-d6cf-4630-8e59-b5b3100166ba\",\"name\":\"Buttons\",\"slug\":\"buttons\"}],\"lastSaveId\":\"XiBbzo9BI6TcvdY4iuSg\"}},{\"id\":\"NjZN2Nir1xiHYf9KeRAi\",\"resolved\":true,\"title\":\"Pill Dropdown Nav\",\"body\":\"$9e\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"About\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Pill Dropdown Nav is a responsive floating navigation with a smooth sliding hover highlight and fluid dropdown panels on desktop. On mobile, it transforms into a compact hamburger menu with expandable accordion sections, keeping the complete experience inside one component.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"What you can customize\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Built entirely with native Framer elements and customizable directly from the properties panel. Edit all 21 link labels, destinations, new-tab settings, and visibility controls, while colors, typography, spacing, and radius stay synchronized across desktop and mobile.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Great for (examples)\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Just a few ideas, use it anywhere you need a polished navigation for larger link structures:\"}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"SaaS websites\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Product websites\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Startup websites\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Software platforms\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Creative agencies\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Design studios\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Portfolio websites\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"AI products\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Marketing websites\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Modern landing pages\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Documentation hubs\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Premium Framer templates\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Share your build\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"If you ship something cool with it, post it on X and tag me \"},{\"type\":\"text\",\"text\":\"@Matthias_Oel\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer\",\"href\":\"https://x.com/Matthias_Oel\",\"target\":\"_blank\"}}]},{\"type\":\"text\",\"text\":\", or send it over. I’d love to see what you create.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Need help?\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Questions or feedback? Reach me anytime: \"},{\"type\":\"text\",\"text\":\"matthias@lmvision.de\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"mailto:matthias@lmvision.de\",\"target\":\"_blank\"}}]},{\"type\":\"text\",\"text\":\" or on X \"},{\"type\":\"text\",\"text\":\"@Matthias_Oel.\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"https://x.com/Matthias_Oel\",\"target\":\"_blank\"}}]}]}]},\"introduction\":\"Smooth from tab to tab\",\"slug\":\"pill-dropdown-nav\",\"author\":{\"framerUserId\":\"94772ad7-baad-4763-bd35-365704374dc3\",\"name\":\"Matt\",\"slug\":\"matthias-oel\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/94772ad7-baad-4763-bd35-365704374dc3/tlc8u3mt\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/94772ad7-baad-4763-bd35-365704374dc3/01a01427-223a-7758-a5eb-23c6c4aa358a.png\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"01a01426-1ae2-72f1-8d44-b4d50a7f4836\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Introducing Pill Dropdown Nav \",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"emoji\",\"marks\":[{\"type\":\"bold\"}],\"attrs\":{\"name\":\"sparkles\",\"emoji\":\"✨\"}}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"A floating navigation with a smooth sliding highlight, fluid dropdown panels, and a complete mobile accordion experience.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Support it and grab your free copy \"},{\"type\":\"emoji\",\"attrs\":{\"name\":\"heart_hands\",\"emoji\":\"🫶\"}}]}]},\"likes\":{\"count\":36,\"liked\":false},\"comments\":{\"count\":5},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-08-18T09:13:56.171Z\",\"updatedAt\":\"2026-08-18T09:15:08.695Z\",\"publishedAt\":\"2026-08-18T09:13:56.145Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"component\",\"attributes\":{\"url\":\"https://framer.com/m/Pill-Dropdown-Nav-s5GzCY.js@eunA8uaaXny3CJiuNFNw\",\"previewUrl\":\"https://pill-dropdown-nav.framer.website\",\"price\":null,\"paymentUrl\":null,\"workshop\":false,\"categories\":[{\"id\":\"4c691677-c621-4041-a908-cbc2d3272658\",\"name\":\"Navigation\",\"slug\":\"navigation\"}],\"lastSaveId\":\"eunA8uaaXny3CJiuNFNw\"}},{\"id\":\"pfCcuGIrQjg2WC4rg2Mu\",\"resolved\":true,\"title\":\"Testimonial Stamp\",\"body\":\"$9f\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"A premium postcard-inspired testimonial component designed to showcase customer stories as beautifully crafted mail cards.\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Testimonial Stamp transforms customer feedback into an elegant collection of vintage-inspired testimonial postcards. Each card combines customer quotes, author details, stamp portraits, postmarks, signature marks, address lines, company logos, and subtle card rotations for a tactile editorial feel.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Features\"}],\"attrs\":{\"level\":1}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Postcard-inspired testimonial cards\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Customer quotes and author details\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Stamp-style customer portraits\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Decorative postmarks\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Signature squiggles or rules\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Address-style decorative lines\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Company logo support\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Automatic light and dark text contrast\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Custom card colors\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Adjustable card size, radius, padding, and overlap\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Hover lift and scale interactions\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Staggered entrance animations\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Multiple entrance styles\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Centre-out, edge-in, and directional animation orders\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Responsive horizontal scrolling\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Drag and touch-friendly browsing\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Keyboard accessible interactions\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Reduced-motion support\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Fully customizable in Framer\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Perfect For\"}],\"attrs\":{\"level\":1}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"SaaS websites\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Startup landing pages\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Creative agencies\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Design studios\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Portfolio websites\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Personal brands\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Product websites\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Marketing pages\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Consultancy websites\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Professional services\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Why You'll Love It\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Testimonial Stamp gives traditional social proof a distinctive editorial character. Instead of presenting testimonials as standard cards or sliders, each customer story feels like a carefully designed postcard, complete with stamps, postmarks, paper colors, handwritten-inspired marks, and mailing details.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Customize every postcard directly through Framer Property Controls, including customer information, portraits, logos, colors, typography, card layouts, hover effects, and entrance animations. The layered overlapping layout and subtle interactions create a premium visual experience while keeping customer stories easy to explore.\"}]}]},\"introduction\":\"Premium Postcard-Style Testimonial\",\"slug\":\"testimonial-stamp\",\"author\":{\"framerUserId\":\"ca05e506-1465-479c-9098-193c2ad13a2b\",\"name\":\"Design Foundry\",\"slug\":\"designfoundry\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/ca05e506-1465-479c-9098-193c2ad13a2b/xcfk0umu\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/ca05e506-1465-479c-9098-193c2ad13a2b/01a01332-2e72-760f-b44a-4165767de031.png\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"01a01332-a9d7-76a1-aeb4-0ee726e5c19a\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Testimonial Stamp is live!\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"A premium testimonial component for Framer with postcard-inspired cards, custom stamps, postmarks, layered layouts, smooth entrance animations, hover interactions, logos, avatars, and responsive layouts.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"If you like it, I’d really appreciate a \"},{\"type\":\"emoji\",\"attrs\":{\"name\":\"heart\",\"emoji\":\"❤\"}},{\"type\":\"text\",\"text\":\" on the component page!\"}]}]},\"likes\":{\"count\":22,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-08-18T04:48:01.933Z\",\"updatedAt\":\"2026-08-19T11:57:16.884Z\",\"publishedAt\":\"2026-08-18T04:48:01.930Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"component\",\"attributes\":{\"url\":null,\"previewUrl\":\"https://testimonialstamp.framer.website/\",\"price\":\"12\",\"paymentUrl\":\"https://buy.polar.sh/polar_cl_r0y7OV3XS5JGWxS5ZFYztmV86KZ9v1Jp9ZDOw4SarBg\",\"workshop\":false,\"categories\":[{\"id\":\"3a855006-6097-4489-b33b-8024cb26633e\",\"name\":\"Interactions\",\"slug\":\"interactions\"}],\"lastSaveId\":\"j39JX8XLaPmw5xSwDfHq\"}},{\"id\":\"NX8oaSyo5XY8xvXtYfac\",\"resolved\":true,\"title\":\"Soft Background\",\"body\":\"$a0\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"MORE FRAMER COMPONENTS LIKE THIS\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"✦ Browse +38 FREE + 85 premium components: \",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\"https://frameze.com/components\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"https://frameze.com/components\",\"target\":\"_blank\"}},{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"✦ Background Bundle: \",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\"https://frameze.com/components/category/background?ref=bundles\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"https://frameze.com/components/category/background?ref=bundles\",\"target\":\"_blank\"}},{\"type\":\"bold\"}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"About Soft Background\",\"marks\":[{\"type\":\"bold\"}]}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Soft Background is a fully customizable animated background component for Framer. Smooth, blurred color orbs drift slowly across the canvas, creating a living mesh-gradient effect without any external dependencies.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Features\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"10 color presets: Aurora, Blush, Mint, Dusk, Peach, Slate, Midnight, Ember, Forest, Noir\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Custom color mode (base + 3 orb colors)\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Mouse parallax with adjustable strength\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Noise texture overlay with soft-light blending\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Radial vignette effect\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Fill Container mode — drops into any Framer frame at 100% size\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Responsive demo panel with live preset switching, orb count, speed, and FX controls\"}]}]},{