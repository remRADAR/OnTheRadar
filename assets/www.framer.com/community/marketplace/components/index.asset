text\",\"text\":\" Highlight software dashboards and features with premium depth.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Creative Portfolios:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Display design work, photography, or 3D art in an immersive way.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Hero Sections:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Replace static top-of-page images with an interactive, attention-grabbing slider.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Mobile App Previews:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Showcase app screens on your landing page with natural swipe mechanics.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"E-commerce Product Highlights:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Let users effortlessly scroll through premium product shots.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"NFT \u0026 Web3 Galleries:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Display digital assets with a futuristic, spatial layout.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Event \u0026 Venue Showcases:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Walk visitors through physical spaces and event photos.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Testimonial Cards:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Turn boring text reviews into a dynamic, swipeable 3D deck.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Team Member Bios:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Introduce your company’s team in a highly interactive, modern format.\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Main Features:\"}],\"attrs\":{\"level\":1}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Immersive 3D Depth \u0026 Scaling:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Creates a stunning visual hierarchy with dynamic rotation, sizing, and Z-axis depth that reacts as users scroll.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Fluid Physics-Based Motion:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Powered by Framer Motion springs to provide incredibly smooth drag, pan, swipe, and mouse-wheel interactions.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Cinematic Edge Blur:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Built-in, fully customizable frosted glass (backdrop blur) on the edges keeps the user's focus locked on the center content.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Fully Customizable UI Controls:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Easily adjust item sizes, gaps, 3D perspective, and scroll damping right from the Framer properties panel—no coding required.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Responsive \u0026 Plug-and-Play:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Drops instantly into any Framer project, scaling beautifully and working flawlessly across desktop, tablet, and mobile devices.\"}]}]}]},{\"type\":\"customImage\",\"attrs\":{\"alt\":\"\",\"src\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/components/description-image-tjtfqlx3-rWOrOFprl9nwsL79vsDxKmQrS4RuSB\",\"link\":\"https://marketplace.framer.com/@saadat-ali-designsbysadat/\",\"caption\":\"\",\"uploadId\":null}}]},\"introduction\":\"Smooth 3D slider with blur effects\",\"slug\":\"depth-blur-carousel\",\"author\":{\"framerUserId\":\"682fc11e-0644-4920-8b94-8b794b0ece9e\",\"name\":\"Saadat Ali\",\"slug\":\"saadat-ali-designsbysadat\",\"avatar\":\"https://framerusercontent.com/avatars/users/682fc11e-0644-4920-8b94-8b794b0ece9e/OrcFwpGK4\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/components/HnGyrHLdrJ3aJqr0nT0N/depth-blur-carousel-xF3yNKX8J3zHrRuKEM0rd3WPMyxDoz\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019e2115-f5cf-7a04-aac9-54ad87e7b0cf\",\"bodyJson\":null,\"likes\":{\"count\":408,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-05-04T10:15:22.564Z\",\"updatedAt\":\"2026-07-29T05:30:58.677Z\",\"publishedAt\":\"2026-05-13T11:25:47.855Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"component\",\"attributes\":{\"url\":\"https://framer.com/m/Depth-Blur-Carousel-fvJ2lB.js@GXN6LrtdSMkVOzHCU8CD\",\"previewUrl\":\"https://nice-store-831383.framer.app\",\"price\":null,\"paymentUrl\":null,\"workshop\":false,\"categories\":[{\"id\":\"8f93ccfe-423c-47f2-b8ae-79e9e132012f\",\"name\":\"Carousels\",\"slug\":\"carousels\"}],\"lastSaveId\":\"GXN6LrtdSMkVOzHCU8CD\"}},{\"id\":\"nFea3ib4sCPC4EyMk5W5\",\"resolved\":true,\"title\":\"Pixel Scroll\",\"body\":\"\u003ch3\u003eThe component supports two reveal approaches:\u003c/h3\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eColors mode: transitions from one color state to another, with optional accent pixels.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eTwo-layer mode: transitions from Layer A to Layer B (image-to-image style transition).\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch3\u003eMain controls and functionality:\u003c/h3\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003ePixel Size and Gap: define the block size and spacing.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eEnd At: sets when the transition finishes within the scroll range.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eDirection: controls flow (top-bottom, bottom-top, left-right, right-left, center-out, center-in).\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePattern: changes threshold distribution (random, checker, diagonal, wave, spiral, radial).\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePattern Intensity: controls how strongly the selected pattern affects transition timing.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eEasing: shapes transition timing (linear, ease-in, ease-out, ease-in-out, expo-out).\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAccent Share + 4 Accent Colors: adds controlled variation inside the transition band.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"bodyJson\":null,\"introduction\":\"Scroll-driven pixel transition\",\"slug\":\"pixel-scroll\",\"author\":{\"framerUserId\":\"48231163-6b2a-4966-a42b-c7d4d2d5ea47\",\"name\":\"UX Ridham\",\"slug\":\"ux-ridham\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/29379/Avatar-ry5kHlPDGDm9NRzyPEOt2sQLfG2PpF.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/components/nFea3ib4sCPC4EyMk5W5/pixel-scroll-5asby9wXOFTunMssZbnExdiaRtCdit\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019c703b-7254-7f63-acac-e434338c6cc5\",\"bodyJson\":null,\"likes\":{\"count\":163,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-02-16T15:23:25.509Z\",\"updatedAt\":\"2026-07-01T13:51:17.509Z\",\"publishedAt\":\"2026-02-18T10:11:10.036Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"component\",\"attributes\":{\"url\":null,\"previewUrl\":\"https://pixelscrolltransition.framer.website/\",\"price\":\"5\",\"paymentUrl\":\"https://buy.polar.sh/polar_cl_ONqcNSrC8Rfb0WlnTS3RZ9M0Voy2z9fmrVNe61MG1Hz\",\"workshop\":false,\"categories\":[{\"id\":\"1a3a0eb3-698e-461a-bf42-2502a7ed43e0\",\"name\":\"Backgrounds\",\"slug\":\"backgrounds\"}],\"lastSaveId\":\"jDtFJgGnXhFiECt2KZ95\"}},{\"id\":\"7e6GjpAKENIzD6uj1oRR\",\"resolved\":true,\"title\":\"Mask Carousel\",\"body\":\"$6a\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Add a premium infinite scrolling media carousel to your site with custom SVG masking, smooth WebGL physics, and progressive edge blurring for a high-end cinematic feel.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Features\",\"marks\":[{\"type\":\"bold\"}]}],\"attrs\":{\"level\":1}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Endless looping WebGL carousel physics\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Custom SVG and PNG mask support (Alpha \u0026 Luma modes)\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Progressive scroll edge blur overlay\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Real-time media contrast and saturation controls\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Smooth touch drag and trackpad wheel scrolling\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Auto-play with customizable damping and speed\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Horizontal and vertical layout direction modes\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"High-performance resource caching and memory management\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Pauses WebGL rendering when off-screen for peak site speed\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Responsive auto-resizing and native Framer integration\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Customization Options\",\"marks\":[{\"type\":\"bold\"}]}],\"attrs\":{\"level\":1}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Media items (Images \u0026 Videos)\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Custom SVG or PNG masks\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Mask modes (Alpha Transparent or Luma B/W)\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Carousel layout direction (Horizontal / Vertical)\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Item width, height, and gap spacing\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Edge blur strength and coverage size\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Media contrast and saturation\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Scroll damping (motion smoothness)\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Drag, wheel, and auto-play speeds\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"How to Use\",\"marks\":[{\"type\":\"bold\"}]}],\"attrs\":{\"level\":1}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Drop the component onto your Framer canvas\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Upload your images, videos, and custom SVG masks\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Choose your layout direction (horizontal or vertical)\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Tune the gap sizing and media dimensions to fit your layout\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Adjust the progressive edge blur, contrast, and scrolling speeds\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Publish for a premium, highly optimized WebGL interactive slider\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Use Cases\",\"marks\":[{\"type\":\"bold\"}]}],\"attrs\":{\"level\":1}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Premium SaaS feature showcases\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Creative agency portfolios\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"High-end eCommerce product galleries\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Interactive masking slider sections\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Client logo ticker loops\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Video highlight reels\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Immersive landing page hero sections\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Modern interactive UI systems\"}]}]}]}]},\"introduction\":\"Endless Masked Media Slider\",\"slug\":\"mask-carousel\",\"author\":{\"framerUserId\":\"682fc11e-0644-4920-8b94-8b794b0ece9e\",\"name\":\"Saadat Ali\",\"slug\":\"saadat-ali-designsbysadat\",\"avatar\":\"https://framerusercontent.com/avatars/users/682fc11e-0644-4920-8b94-8b794b0ece9e/OrcFwpGK4\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/682fc11e-0644-4920-8b94-8b794b0ece9e/01a01355-6ca7-7758-8ffc-6319a86ab018.png\",\"metadata\":{\"tint\":\"hsl(330 41% 64%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"01a01355-8107-713f-99b9-5a99932574e0\",\"bodyJson\":null,\"likes\":{\"count\":16,\"liked\":false},\"comments\":{\"count\":1},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-08-18T05:26:05.257Z\",\"updatedAt\":\"2026-08-23T06:36:03.179Z\",\"publishedAt\":\"2026-08-18T05:26:05.253Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"component\",\"attributes\":{\"url\":null,\"previewUrl\":\"https://creative-pear-245595.framer.app\",\"price\":\"7\",\"paymentUrl\":\"https://designsbysadat.lemonsqueezy.com/checkout/buy/1dc27355-4324-40f4-be6b-25bdc2320f0e\",\"workshop\":false,\"categories\":[{\"id\":\"8f93ccfe-423c-47f2-b8ae-79e9e132012f\",\"name\":\"Carousels\",\"slug\":\"carousels\"}],\"lastSaveId\":\"vTr5VbpJZOQTaAkVKQYS\"}},{\"id\":\"fwDwNQgXVgKPLJL4AmNn\",\"resolved\":true,\"title\":\"Expand OnHover List\",\"body\":\"$6b\",\"bodyJson\":null,\"introduction\":\"Hover to expand image -Details on demand\",\"slug\":\"expand-onhover-list\",\"author\":{\"framerUserId\":\"492da4c7-1f68-44bb-a835-d654f4ede7b8\",\"name\":\"Pentaclay\",\"slug\":\"pentaclay\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/28817/5IpLqH7F9iimwZKthWdWp8kYrU-vxHo09smZpSjxasGJhxW7DH2mYch2a.png\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/components/fwDwNQgXVgKPLJL4AmNn/expand-onhover-list-Y1kHRCJVQA1ovLhG9p7mPJGY9kcQR9\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019d671b-6140-7c7d-a179-be1f3ab833f0\",\"bodyJson\":null,\"likes\":{\"count\":368,\"liked\":false},\"comments\":{\"count\":1},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-03-25T01:55:38.890Z\",\"updatedAt\":\"2026-04-07T08:12:52.714Z\",\"publishedAt\":\"2026-04-07T08:42:20.864Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"component\",\"attributes\":{\"url\":\"https://framer.com/m/Expand-OnHover-List-LByFXR.js@OBy0vsXNMeZtHbjUoVsi\",\"previewUrl\":\"https://expand-on-hover-list.framer.website\",\"price\":null,\"paymentUrl\":null,\"workshop\":false,\"categories\":[{\"id\":\"3a855006-6097-4489-b33b-8024cb26633e\",\"name\":\"Interactions\",\"slug\":\"interactions\"}],\"lastSaveId\":\"OBy0vsXNMeZtHbjUoVsi\"}},{\"id\":\"dXdQyooiOZOa8Re70Xrg\",\"resolved\":true,\"title\":\"CMS Story Carousel\",\"body\":\"$6c\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"CMS Story Carousel\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" is a refined, editorial-style story carousel for Framer designed to showcase images, headlines, and short-form content in a smooth, immersive horizontal layout. It combines infinite scrolling, autoplay, drag interaction, wheel control, momentum, and an elegant overlay caption plate to create a cinematic way to present stories, projects, articles, case studies, and visual content.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"✦ Connect Every Story to Your CMS\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Each story can be connected individually to a \"},{\"type\":\"text\",\"text\":\"Framer CMS page or any URL\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" using the CMS Link control. This makes it easy to turn individual cards into clickable articles, case studies, projects, client stories, or other pages. \"},{\"type\":\"text\",\"text\":\"CMS Story Carousel is not a CMS Collection component\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\"—you add the stories manually and optionally link each card to its corresponding CMS page.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"✦ Features Highlight\"}],\"attrs\":{\"level\":1}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Editorial Story Cards\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" — Combine large imagery with an elegant text overlay for a magazine-inspired presentation.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Infinite Horizontal Carousel\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" — Stories continuously loop for a seamless scrolling experience.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Smooth Autoplay\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" — Automatically drift through stories with adjustable speed and direction.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Drag \u0026 Flick Interaction\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" — Drag, swipe, and flick through cards with natural momentum.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Wheel Scrolling\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" — Navigate the carousel using vertical or horizontal mouse-wheel gestures.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Interactive Caption Plate\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" — Expand or collapse the story information with a smooth animated toggle.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Flexible Story Content\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" — Add your own image, label, headline, and supporting content to every card\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"✦ Made for Stories That Deserve to Move\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Use \"},{\"type\":\"text\",\"text\":\"CMS Story Carousel\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" for \"},{\"type\":\"text\",\"text\":\"editorial websites, creative studios, portfolios, agencies, photography, fashion, magazines, blogs, case studies, architecture, campaigns, project showcases, and storytelling-focused landing pages\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\". \"},{\"type\":\"text\",\"text\":\"Keywords:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Framer Story Carousel, CMS Story Carousel, Framer Carousel, Framer CMS Link, Framer Editorial Carousel, Story Carousel Component, Framer Portfolio Carousel, Editorial Gallery, Framer Image Carousel, Interactive Story Slider.\"}]}]},\"introduction\":\"CMS Ready Editorial Image Carousel\",\"slug\":\"cms-story-carousel\",\"author\":{\"framerUserId\":\"93e0445d-da1b-434f-be79-797c7c983df6\",\"name\":\"Axis Supply\",\"slug\":\"axissupply\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/93e0445d-da1b-434f-be79-797c7c983df6/x7b91rcg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/93e0445d-da1b-434f-be79-797c7c983df6/01a02453-cb41-7285-9e97-38e341f0c9f1.png\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"01a02454-b263-76dd-bd7f-5be58e2091c1\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Just launched \"},{\"type\":\"text\",\"text\":\"CMS Story Carousel\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"A cinematic, CMS-powered story carousel with editorial image cards, continuous horizontal scrolling, drag \u0026 flick interactions, wheel control, auto-drift, and expandable story captions.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"If you like it, give it a \"},{\"type\":\"emoji\",\"attrs\":{\"name\":\"heart\",\"emoji\":\"❤\"}}]}]},\"likes\":{\"count\":8,\"liked\":false},\"comments\":{\"count\":2},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-08-21T12:38:44.941Z\",\"updatedAt\":\"2026-08-23T10:03:23.236Z\",\"publishedAt\":\"2026-08-21T12:38:44.937Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"typ