",\"text\":\"Features\"}],\"attrs\":{\"level\":2}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Infinite Text Wheel:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Smoothly cycles through unlimited text items in a continuous loop.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Fully Customizable Typography:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Control fonts, colors, and text styling directly from the Framer properties panel.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Adjustable Curvature:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Customize the wheel radius to create anything from subtle curves to dramatic circular layouts.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Custom Icon Support:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Replace the default arrow with any custom icon component to match your design system.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Physics-Based Motion:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Spring-powered animations provide smooth, natural interactions and transitions.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Advanced Layout Controls:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Fine-tune arrow size, spacing, offsets, row gaps, and positioning without writing code.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Responsive Design:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Adapts seamlessly across screen sizes while maintaining visual balance and readability.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Performance Optimized:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Lightweight and efficient for smooth rendering and interactions.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Designer-Friendly Workflow:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Every setting is accessible through Framer's visual interface.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Production Ready:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Ideal for portfolios, agencies, SaaS products, directories, brand showcases, team pages, and modern landing pages.\"}]}]}]}]},\"introduction\":\"Customizable kinetic text slider\",\"slug\":\"kinetic-text-slider\",\"author\":{\"framerUserId\":\"47745ef1-855e-412c-a101-305ac078cd49\",\"name\":\"FrameSpace\",\"slug\":\"framespace\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/129533/avatar-CUOFZiJvUMrfCqPnaTe2BesapDWMrY.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/47745ef1-855e-412c-a101-305ac078cd49/qncrixl5\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019ef9e4-984b-7072-8081-872a0590893a\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"heart_hands\",\"emoji\":\"🫶\"}},{\"type\":\"text\",\"text\":\" Hellow Framer!\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"we're about to publish multiple components we made!\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"hope you like it, give us some hearts (IT IS FREE)\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Infinit text wheel completely customizable based on your taste.\"}]}]},\"likes\":{\"count\":243,\"liked\":false},\"comments\":{\"count\":2},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-06-24T13:49:28.489Z\",\"updatedAt\":\"2026-06-24T14:51:58.437Z\",\"publishedAt\":\"2026-06-24T13:49:28.487Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"component\",\"attributes\":{\"url\":\"https://framer.com/m/InfinityText-sCMW9t.js@jdbpeiMUt51NiAp1k7xZ\",\"previewUrl\":\"https://scary-employees-458847.framer.app/\",\"price\":null,\"paymentUrl\":null,\"workshop\":false,\"categories\":[{\"id\":\"7fe42fdd-1b16-4f5a-93b8-009488614de8\",\"name\":\"Typography\",\"slug\":\"typography\"}],\"lastSaveId\":\"jdbpeiMUt51NiAp1k7xZ\"}},{\"id\":\"unsbYS6MnC2QF64PgiCG\",\"resolved\":true,\"title\":\"Handwritten Text FX\",\"body\":\"$99\",\"bodyJson\":null,\"introduction\":\"Handwritten Text Animation Effect\",\"slug\":\"handwriting-effect\",\"author\":{\"framerUserId\":\"1159add7-a06c-4bd0-b4a6-eaa54b4f3a0e\",\"name\":\"BasePixel\",\"slug\":\"basepixel\",\"avatar\":\"https://framerusercontent.com/avatars/users/1159add7-a06c-4bd0-b4a6-eaa54b4f3a0e/yfvgaNnFR\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/components/unsbYS6MnC2QF64PgiCG/handwriting-effect-FDdqiPUxrhBqPfeBsXgU13rWZsxSqZ\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019c6cb7-9ad9-7211-857d-53363f7aef0d\",\"bodyJson\":null,\"likes\":{\"count\":64,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-02-10T04:53:52.587Z\",\"updatedAt\":\"2026-07-28T21:27:35.868Z\",\"publishedAt\":\"2026-02-17T17:48:18.009Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"component\",\"attributes\":{\"url\":null,\"previewUrl\":\"https://versatile-pictogram-628995.framer.app/preview\",\"price\":\"4\",\"paymentUrl\":\"https://buy.stripe.com/28EbJ11Pw61xaJT1MP0sU02\",\"workshop\":true,\"categories\":[{\"id\":\"7fe42fdd-1b16-4f5a-93b8-009488614de8\",\"name\":\"Typography\",\"slug\":\"typography\"}],\"lastSaveId\":\"gbtFRGyXLkQzBSIEgD4v\"}},{\"id\":\"2qQSCNYRwdZQo8UkPzfJ\",\"resolved\":true,\"title\":\"Full Width Navbar\",\"body\":\"\u003cp\u003eFull Width Navbar is a solid starting point for any website that needs a bit more than a basic navbar. The layout is inspired by the navigation patterns used by leading lifestyle and retail brands. Multi-column dropdowns that give your content room to breathe, without feeling heavy or overcomplicated.\u003c/p\u003e\u003cp\u003eIt's intentionally neutral. No strong brand personality, no niche-specific styling. Just clean structure that adapts to whatever you're building.\u003c/p\u003e\u003ch3\u003eUpdates\u003c/h3\u003e\u003cp\u003e1.0 Initial release\u003c/p\u003e\",\"bodyJson\":null,\"introduction\":\"Modern Full Width Dropdown Menu\",\"slug\":\"full-width-navbar\",\"author\":{\"framerUserId\":\"049bdbd1-fa60-443e-9e4a-f8433df30d57\",\"name\":\"Val Casanova\",\"slug\":\"val-casanova\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/54328/avatar-ZZSU0iegtq8dKeLkWjWXLVQQYOkioT.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/components/2qQSCNYRwdZQo8UkPzfJ/full-width-navbar-9fsf0mR4t0j2qRhMfIyUdCNDDkfbIT\",\"metadata\":{\"tint\":\"hsl(0 0% 20%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019e2875-157c-763e-8032-563fa0a459eb\",\"bodyJson\":null,\"likes\":{\"count\":148,\"liked\":false},\"comments\":{\"count\":6},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-05-09T20:29:45.103Z\",\"updatedAt\":\"2026-06-25T12:30:44.775Z\",\"publishedAt\":\"2026-05-14T21:47:02.396Z\",\"featuredAt\":\"2026-07-18T08:25:22.035Z\",\"reported\":false,\"approvedAt\":null,\"type\":\"component\",\"attributes\":{\"url\":\"https://framer.com/m/Full-Width-Nav-cKuKfD.js@K0nzfwzwv9DSMMCzogvn\",\"previewUrl\":\"https://full-width-nav.framer.website/\",\"price\":null,\"paymentUrl\":null,\"workshop\":false,\"categories\":[{\"id\":\"4c691677-c621-4041-a908-cbc2d3272658\",\"name\":\"Navigation\",\"slug\":\"navigation\"}],\"lastSaveId\":\"K0nzfwzwv9DSMMCzogvn\"}},{\"id\":\"bmrdj1a2RjbWSaHnyp97\",\"resolved\":true,\"title\":\"Image Trail Cursor\",\"body\":\"$9a\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"You know that moment - you're scrolling an award-winning site and suddenly images start trailing your cursor like magic. It feels alive, tactile, and impossibly cool. That effect lives on Awwwards-winning sites. Now you can add it to yours in minutes.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Instructions\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"orderedList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Drop the \"},{\"type\":\"text\",\"text\":\"Image Cursor Trail\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" component into the section where you want the effect\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Set the component's position to \"},{\"type\":\"text\",\"text\":\"Absolute\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" in the right-hand panel\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Pin all four edges - Top, Bottom, Left, Right to \"},{\"type\":\"text\",\"text\":\"0\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" so it expands to fill the full section\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Add your own images from the \"},{\"type\":\"text\",\"text\":\"Images panel\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" on the right.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Adjust the controls to match your vibe and you're done\"}]}]}],\"attrs\":{\"type\":null,\"start\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"How It Works\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"The panel has two layers of controls — core settings visible by default, and advanced settings unlocked via the \"},{\"type\":\"text\",\"text\":\"Advanced\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" toggle:\"}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Images\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\": Add your own photos; demo images are used automatically until you do\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Background\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\": Optional background color for the trail container\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Image Size\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\": Set width and height of each trail image independently\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Corner Radius\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\": Round the image corners from sharp to fully circular\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Image Fit\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\": Choose Cover, Contain, or Fill for how images crop\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Max Tilt\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\": Controls how much each image randomly rotates as it appears\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Trail Length\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\": How many images can be visible on screen at once\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Lifespan\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\": How long each image stays before it exits\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Animate In / Animate Out\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\": Full Framer transition control - use tween, spring, or custom easing\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Advanced → Spawn Distance\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\": How far the cursor must travel before a new image appears\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Advanced → Scroll Rate\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\": Spawn rate while the user is scrolling\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Advanced → Idle Rate\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\": How often images spawn when the cursor is stationary\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Advanced → Removal Delay\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\": Stagger timing between consecutive image removals\"}]}]}]}]},\"introduction\":\"Images that follow your cursor ✦\",\"slug\":\"image-trail-cursor\",\"author\":{\"framerUserId\":\"c3bff3a7-7c7d-4186-83a4-ec14bfdad6e4\",\"name\":\"Soyeb\",\"slug\":\"soyeb\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/867947/avatar-jQxx1q8RWj76NfGo0ZcrLujaVCrKOh.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/c3bff3a7-7c7d-4186-83a4-ec14bfdad6e4/j0pzhbkg\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019ed155-bd74-74ba-a25d-43e5ffd14b71\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"That cursor trail effect you see on Awwwards sites? Just dropped it as a Framer component.\",\"marks\":[{\"type\":\"bold\"}]}]}]},\"likes\":{\"count\":117,\"liked\":false},\"comments\":{\"count\":1},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-06-16T16:48:37.677Z\",\"updatedAt\":\"2026-06-30T20:21:18.694Z\",\"publishedAt\":\"2026-06-16T16:48:37.662Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"component\",\"attributes\":{\"url\":null,\"previewUrl\":\"https://image-trail-cursor.framer.ai\",\"price\":\"14\",\"paymentUrl\":\"https://buy.polar.sh/polar_cl_mf5H0E1Wn3IzVT2kSMccYVZ2MwYgM9aheShDy1zyxvp\",\"workshop\":false,\"categories\":[{\"id\":\"3a855006-6097-4489-b33b-8024cb26633e\",\"name\":\"Interactions\",\"slug\":\"interactions\"}],\"lastSaveId\":\"47ZzwxfsMYp7S8sfSlsq\"}},{\"id\":\"9PjXeXxuJfs0Rs0PjmZ7\",\"resolved\":true,\"title\":\"Pricing Plans Pro\",\"body\":\"$9b\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Pricing Plans Pro\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" is a polished, interactive pricing picker for SaaS and tiered products. It combines an animated billing toggle, expandable feature drawer, and live user-based pricing in one connected interface. Visitors can compare plans without leaving the page, while the component adapts seamlessly from mobile to desktop.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Key Features\"}],\"attrs\":{\"level\":1}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Vertical or Horizontal layout with automatic frame resizing\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Animated Monthly/Yearly toggle with customizable discount badge\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Up to 8 plans with names, descriptions, monthly/yearly prices, and features\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Live price calculation based on user/seat count with smooth animations\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Configurable user counter with +/- controls, starting value, and label\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"12 currencies via native \"},{\"type\":\"text\",\"text\":\"Intl.NumberFormat\",\"marks\":[{\"type\":\"code\"}]},{\"type\":\"text\",\"text\":\": USD, EUR, GBP, JPY, CAD, AUD, CHF, CNY, INR, BRL, MXN, SGD\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Feature separators using newlines or \"},{\"type\":\"text\",\"text\":\"|\",\"marks\":[{\"type\":\"code\"}]}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Optional custom user and feature icons\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Animated feature drawer with sequential slide-up effects\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Responsive CTA with hover and tap animations\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"9 editable font controls and extensive color customization\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Container-based responsiveness using ResizeObserver, with compact mode below 380px\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"3 pre-loaded plans: Plus, Standard, Advanced\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Works on both Framer Canvas and published sites\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Where to Use\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Ideal for SaaS pricing, per-seat subscriptions, storage and infrastructure tiers, bootcamps, memberships, communities, APIs, and developer tools.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Best For\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Teams selling tiered products with per-user pricing, designers needing one responsive component, and Framer users who want complete visual control without coding.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Why This Component\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Unlike static three-column pricing grids or stepper modals, \"},{\"type\":\"text\",\"text\":\"Pricing Plans Pro\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" keeps everything connected. The active plan reveals its features, pricing updates instantly as seats change, and the same component switches between mobile-stacked and desktop-horizontal layouts through a single property.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Built for Framer. Drop it onto your canvas, customize it, and publish.\"}]}]},\"introduction\":\"Live-price plan picker\",\"slug\":\"pricing-plans-pro\",\"author\":{\"framerUserId\":\"092b6e6a-5b7e-4e19-9a5a-4352c205c584\",\"name\":\"ONYRI Strategy\",\"slug\":\"onyri-strategy\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/1412066/avatar-kHGXusqZB1syGd3pNBioephGEmuqkO.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/components/9PjXeXxuJfs0Rs0PjmZ7/pricing-plans-pro-WyhpyKYJSDzIGeDrLbylvfwlnAgGu3\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019e9bed-dfa2-7d06-907e-d4d319582163\",\"bodyJson\":null,\"likes\":{\"count\":54,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-05-27T09:49:12.030Z\",\"updatedAt\":\"2026-08-22T08:48:05.699Z\",\"publishedAt\":\"2026-06-06T07:55:18.306Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"component\",\"attributes\":{\"url\":null,\"previewUrl\":\"https://pricing-card-by-onyri-strategy.framer.website/\",\"price\":\"9\",\"paymentUrl\":\"https://polar.sh/checkout/polar_c_XWPlSPGhJVLcgowu1IqTjNi03w4bfmmC0Izcm3wjSQG\",\"workshop\":false,\"categories\":[{\"id\":\"4fdfe3ed-ecd1-4761-a9df-b36c0c38e974\",\"name\":\"Layout\",\"slug\":\"layout\"}],\"lastSaveId\":\"yB2wPbQ0rv7jAZJmpPVu\"}},{\"id\":\"Ec2bXiM0fNPAKQDqMC3O\",\"resolved\":true,\"t