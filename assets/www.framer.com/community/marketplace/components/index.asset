19-jcjdymr-fa.js\",\"/creators-assets/_next/static/immutable/chunks/19r4rf2zyng-y.js\",\"/creators-assets/_next/static/immutable/chunks/1p31g3z3kho5v.js\",\"/creators-assets/_next/static/immutable/chunks/2qeyp4zfa4qwb.js\",\"/creators-assets/_next/static/immutable/chunks/3sj_xp-v1_jxx.js\",\"/creators-assets/_next/static/immutable/chunks/2njnkxjf39nsf.js\",\"/creators-assets/_next/static/immutable/chunks/0ph1ht6wvel_v.js\",\"/creators-assets/_next/static/immutable/chunks/2zfre20tirh12.js\",\"/creators-assets/_next/static/immutable/chunks/05i2jce8amocn.js\",\"/creators-assets/_next/static/immutable/chunks/0v-er0xp5q011.js\",\"/creators-assets/_next/static/immutable/chunks/2rn8ri2u5wuca.js\",\"/creators-assets/_next/static/immutable/chunks/2p6snucyfb6_0.js\",\"/creators-assets/_next/static/immutable/chunks/169pjay1xif06.js\"],\"StaticResourceGridWithToolbar\"]\n4f:T7eb,\u003ch2\u003e✦ Add depth and motion to every story.\u003c/h2\u003e\u003cp\u003eCreate beautiful stacked card layouts with smooth animations, layered depth and natural interactions. Fully responsive, easy to customize and \u003cstrong\u003eready to use in seconds.\u003c/strong\u003e Make it completely your own with flexible controls for layout, styling and motion :)\u003c/p\u003e\u003ch2\u003e\u003cspan data-type=\"emoji\" data-name=\"gear\"\u003e⚙\u003c/span\u003e What you can customize\u003c/h2\u003e\u003cp\u003eEasily adapt every part of the component to match your own brand and style.\u003c/p\u003e\u003cp\u003eImages ✦ Titles ✦ Subtitles ✦ Descriptions ✦ Card width ✦ Card height ✦ Card spacing ✦ Stack offset ✦ Mobile sizing ✦ Border radius ✦ Active scale ✦ Inactive scale ✦ Depth intensity ✦ Animation speed ✦ Scroll sensitivity ✦ Background color ✦ Text colors ✦ Typography\u003c/p\u003e\u003ch2\u003e\u003cspan data-type=\"emoji\" data-name=\"dart\"\u003e🎯\u003c/span\u003e Perfect for\u003c/h2\u003e\u003cp\u003eCreative portfolios ✦ Agency presentations ✦ Editorial storytelling ✦ Featured case studies ✦ Fashion campaigns ✦ Product showcases ✦ Landing pages ✦ Brand storytelling ✦ Content highlights ✦ Project previews\u003c/p\u003e\u003ch2\u003e\u003cspan data-type=\"emoji\" data-name=\"iphone\"\u003e📱\u003c/span\u003e Responsive by default\u003c/h2\u003e\u003cp\u003eOptimized layouts for Desktop, Tablet and Mobile with smooth animations and touch-friendly interactions.\u003c/p\u003e\u003ch2\u003e\u003cspan data-type=\"emoji\" data-name=\"computer_mouse\"\u003e🖱\u003c/span\u003e Included interactions\u003c/h2\u003e\u003cp\u003eLayered scaling ✦ Smooth transitions ✦ Scroll interactions ✦ Touch navigation ✦ Depth animations ✦ Responsive layouts\u003c/p\u003e\u003ch2\u003e\u003cspan data-type=\"emoji\" data-name=\"link\"\u003e🔗\u003c/span\u003e Live Preview\u003c/h2\u003e\u003cp\u003e\u003ca href=\"https://bisque-potential-446779.framer.app/\" rel=\"noopener noreferrer nofollow\" target=\"_blank\"\u003ehttps://bisque-potential-446779.framer.app/\u003c/a\u003e\u003c/p\u003e\u003cp\u003e––––––––\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan data-type=\"emoji\" data-name=\"heart\"\u003e❤\u003c/span\u003e Thank you so much for your support! I genuinely appreciate every download. I hope you have fun customizing this component and making it your own. Happy building!\u003c/strong\u003e\u003c/p\u003e50:T663,\u003ch2\u003e✦ Make your first impression unforgettable.\u003c/h2\u003e\u003cp\u003eCreate bold editorial hero sections with an interactive pixel reveal, immersive visuals and natural cursor interactions. Fully responsive, easy to customize and \u003cstrong\u003eready to use in seconds.\u003c/strong\u003e Make it completely your own with flexible controls for layout, styling and motion :)\u003c/p\u003e\u003ch2\u003e\u003cspan data-type=\"emoji\" data-name=\"gear\"\u003e⚙\u003c/span\u003e What you can customize\u003c/h2\u003e\u003cp\u003eHeadline ✦ Link text ✦ Link URL ✦ Background image ✦ Image position ✦ Pixel color ✦ Pixel size ✦ Pixel density ✦ Reveal radius ✦ Animation speed ✦ Interaction ✦ Text color ✦ Padding ✦ Typography\u003c/p\u003e\u003ch2\u003e\u003cspan data-type=\"emoji\" data-name=\"dart\"\u003e🎯\u003c/span\u003e Perfect for\u003c/h2\u003e\u003cp\u003eLanding page heroes ✦ Portfolio intros ✦ Creative studios ✦ Fashion campaigns ✦ Editorial websites ✦ Brand launches ✦ Photography showcases ✦ Art direction ✦ Product storytelling ✦ Visual headers\u003c/p\u003e\u003ch2\u003e\u003cspan data-type=\"emoji\" data-name=\"iphone\"\u003e📱\u003c/span\u003e Responsive by default\u003c/h2\u003e\u003cp\u003eOptimized layouts for Desktop, Tablet and Mobile with touch-friendly interactions and adaptive pixel animations.\u003c/p\u003e\u003ch2\u003e\u003cspan data-type=\"emoji\" data-name=\"computer_mouse\"\u003e🖱\u003c/span\u003e Included interactions\u003c/h2\u003e\u003cp\u003eInteractive cursor reveal ✦ Pixel animation ✦ Clickable links ✦ Smooth transitions ✦ Responsive layouts\u003c/p\u003e\u003cp\u003e––––––––\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan data-type=\"emoji\" data-name=\"heart\"\u003e❤\u003c/span\u003e Thank you so much for your support! I genuinely appreciate every download. I hope you have fun customizing this component and making it your own. Happy building!\u003c/strong\u003e\u003c/p\u003e51:T629,\u003ch2\u003eText Reveal on Scroll\u003c/h2\u003e\u003cp\u003eText Reveal on Scroll is a lightweight interaction component that progressively reveals text as users scroll through the page. Designed for modern storytelling layouts, landing pages, portfolios, and editorial experiences, it creates a refined reading effect with smooth motion and customizable styling.\u003c/p\u003e\u003ch3\u003eFeatures\u003c/h3\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eReveal text by \u003cstrong\u003echaracter\u003c/strong\u003e, \u003cstrong\u003eword\u003c/strong\u003e, or \u003cstrong\u003esentence\u003c/strong\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSmooth spring-based scroll animations\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eOptional replay behavior on reverse scrolling\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eBalanced text wrapping for cleaner typography\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFully customizable colors and fonts\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eResponsive and accessibility-friendly\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eLightweight and optimized for Framer projects\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch3\u003ePerfect For\u003c/h3\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eHero sections\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eStorytelling websites\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePortfolio intros\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eEditorial layouts\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eProduct launches\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eModern landing pages\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch3\u003eCustomization\u003c/h3\u003e\u003cp\u003eAdjust typography, reveal style, animation feel, muted/active colors, and transition settings directly from Framer property controls — no code changes required.\u003c/p\u003e\u003ch3\u003eIncludes\u003c/h3\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eEasy-to-use property controls\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eResponsive behavior\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eProduction-ready animation setup\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003eReach out anytime via \u003ca href=\"mailto:kaniyanahmad1@gmail.com\"\u003eemail\u003c/a\u003e or DM on \u003ca href=\"https://www.x.com/kaniyanstudio\" rel=\"noopener noreferrer nofollow\" target=\"_blank\"\u003eX\u003c/a\u003e.\u003c/p\u003e52:T737,\u003ch2\u003e\u003cstrong\u003e✦ Let your content unfold naturally.\u003c/strong\u003e\u003c/h2\u003e\u003cp\u003eCreate immersive expanding galleries with a clear visual focus, smooth interactions and elegant transitions. Fully responsive, easy to customize and \u003cstrong\u003eready to use in seconds. \u003c/strong\u003eMake it completely your own with flexible controls for layout, styling and motion :)\u003c/p\u003e\u003ch2\u003e\u003cspan data-type=\"emoji\" data-name=\"gear\"\u003e⚙\u003c/span\u003e What you can customize\u003c/h2\u003e\u003cp\u003eEasily adapt every part of the component to match your own brand and style.\u003c/p\u003e\u003cp\u003eImages ✦ Titles ✦ Descriptions ✦ Links ✦ Active \u0026amp; inactive sizes ✦ Spacing ✦ Border radius ✦ Animation timing ✦ Scroll navigation ✦ Per-breakpoint layouts\u003c/p\u003e\u003ch2\u003e\u003cspan data-type=\"emoji\" data-name=\"dart\"\u003e🎯\u003c/span\u003e Perfect for\u003c/h2\u003e\u003cp\u003eService navigation ✦ Portfolios ✦ Case studies ✦ Landing pages ✦ Brand storytelling ✦ Product showcases ✦ Editorial galleries ✦ Creative projects\u003c/p\u003e\u003ch2\u003e\u003cspan data-type=\"emoji\" data-name=\"iphone\"\u003e📱\u003c/span\u003e Responsive by default\u003c/h2\u003e\u003cp\u003eOptimized layouts for Desktop, Tablet and Mobile with adaptive expanding layouts and smooth touch interactions.\u003c/p\u003e\u003ch2\u003e\u003cspan data-type=\"emoji\" data-name=\"computer_mouse\"\u003e🖱\u003c/span\u003e Included interactions\u003c/h2\u003e\u003cp\u003eScroll \u0026amp; swipe ✦ Click to focus ✦ Smooth expanding transitions ✦ Linked slides ✦ Responsive layouts\u003c/p\u003e\u003ch2\u003e\u003cspan data-type=\"emoji\" data-name=\"link\"\u003e🔗\u003c/span\u003e Live Preview\u003c/h2\u003e\u003cp\u003e\u003ca href=\"https://goodness-badger-090727.framer.app/\" rel=\"noopener noreferrer nofollow\" target=\"_blank\"\u003ehttps://goodness-badger-090727.framer.app/\u003c/a\u003e\u003c/p\u003e\u003cp\u003e––––––––\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan data-type=\"emoji\" data-name=\"heart\"\u003e❤\u003c/span\u003e Thank you so much for your support! I genuinely appreciate every download. I hope you have fun customizing this component and making it your own. Happy building!\u003c/strong\u003e\u003c/p\u003e53:Td3c,\u003cp\u003e\u003ca href=\"/assets/www.framer.com/community/marketplace/components/index.assetgithub-contributions/?via=market\" rel=\"noopener noreferrer nofollow\" target=\"_blank\"\u003eCheck Out the New Component →\u003c/a\u003e\u003c/p\u003e\u003ch2\u003e✦ Not Ordinary Scroll Reveal\u003c/h2\u003e\u003cp\u003eMost scroll text reveal components require you to enter text in the control panel, which breaks your ability to apply global text styles in Framer.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eText Reveal Scroll\u003c/strong\u003e works differently..\u003c/p\u003e\u003cp\u003eInstead of replacing the native text layer, it works directly with your existing text. This preserves all styles applied from the global assets panel, ensuring your font size, weight, color, letter spacing, and line height remain exactly as designed.\u003c/p\u003e\u003cp\u003eYou keep full control over your typography, while the component adds a smooth, cinematic scroll-driven text animation on top.\u003c/p\u003e\u003ch2\u003eInstructions\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eAdd this component to the canvas on the \u003cstrong\u003edesktop breakpoint\u003c/strong\u003e.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePlace a \u003cstrong\u003eText layer outside the desktop breakpoint\u003c/strong\u003e.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eWrap the Text layer in a Stack.\u003c/strong\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSet the Text layer\u0026#39;s \u003cstrong\u003ewidth to \u0026quot;Fill\u0026quot;\u003c/strong\u003e so it will be responsive across screens.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eIn the component\u0026#39;s property panel, use the \u003cstrong\u003e\u0026quot;Text\u0026quot; property control\u003c/strong\u003e to connect that Text layer.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch3\u003eSetup\u003c/h3\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eYou can configure the component settings from the right-side control panel.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eThe animation works in Preview and live site (not inside canvas)\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2\u003eProperties Control\u003c/h2\u003e\u003cfigure\u003e\u003cimg src=\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/components/description-image-iyao6vdz-OTv65lz0ervrMknbtHMx9ZIfhkfM0Q\" alt=\"Scroll Text Reveal Framer Component Controls\" /\u003e\u003cfigcaption\u003eScroll Text Reveal Framer Component Controls\u003c/figcaption\u003e\u003c/figure\u003e\u003ch2\u003eHow It Works\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eStart %: \u003c/strong\u003eDefines where the reveal begins in the viewport.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eEnd %: \u003c/strong\u003eDefines where the reveal completes\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eDim Opacity: \u003c/strong\u003eControls opacity of unrevealed text (subtle ghost → fully hidden)\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eReveal By: \u003c/strong\u003eChoose between:\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eCharacters\u003c/strong\u003e → letter by letter reveal\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eWords\u003c/strong\u003e → smoother word-by-word animation\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eFont Size\u003c/strong\u003e: Toggle between Global (uses the connected Text layer\u0026#39;s style) or Custom (set a fixed px size).\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2\u003eKey Features\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eStyle-safe text splitting: \u003c/strong\u003ePreserves all Framer typography styles.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eScroll-driven reveal: \u003c/strong\u003eTrue scroll-driven text animation.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eSmooth progressive animation: \u003c/strong\u003ePartial opacity transitions create a cinematic \u003cstrong\u003etext opacity scroll\u003c/strong\u003e effect.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003ePerformance optimized: \u003c/strong\u003eUses passive scroll listeners and efficient DOM updates.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eSupport CMS: \u003c/strong\u003eWorks with dynamically loaded content.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eMade with ❤️ by \u003c/strong\u003e\u003ca href=\"https://framer.link/market\" rel=\"noopener noreferrer nofollow\" target=\"_blank\"\u003e\u003cstrong\u003eSoyeb\u003c/strong\u003e\u003c/a\u003e\u003c/p\u003e\u003cp\u003eHave questions or need a custom Framer component? Reach out at \u003ca href=\"mailto:heysoyebali@gmail.com\"\u003eheysoyebali@gmail.com\u003c/a\u003e\u003c/p\u003e54:T7cf,\u003ch2\u003e✦ Introduce your team with personality.\u003c/h2\u003e\u003cp\u003eShowcase your team with interactive profile cards, smooth animations and a clean editorial layout. Fully responsive, easy to customize and \u003cstrong\u003eready to use in seconds. \u003c/strong\u003eMake it completely your own with flexible controls for layout, styling and motion :)\u003c/p\u003e\u003ch2\u003e\u003cspan data-type=\"emoji\" data-name=\"gear\"\u003e⚙\u003c/span\u003e What you can customize\u003c/h2\u003e\u003cp\u003eEasily adapt every part of the component to match your own brand and style.\u003c/p\u003e\u003cp\u003ePortraits ✦ Names ✦ Descriptions ✦ Role tags ✦ Button labels ✦ Card background ✦ Page background ✦ Text colors ✦ Tag colors ✦ Button colors ✦ Typography ✦ Border radius ✦ Card shadows ✦ Card gap ✦ Section padding ✦ Image margin ✦ Card sizing ✦ Arrow styling\u003c/p\u003e\u003ch2\u003e\u003cspan data-type=\"emoji\" data-name=\"dart\"\u003e🎯\u003c/span\u003e Perfect for\u003c/h2\u003e\u003cp\u003eTeam sections ✦ Agency websites ✦ Studio portfolios ✦ Startup landing pages ✦ About pages ✦ Founder showcases ✦ Employee profiles ✦ Speaker lineups ✦ Creator teams ✦ Advisory boards\u003c/p\u003e\u003ch2\u003e\u003cspan data-type=\"emoji\" data-name=\"iphone\"\u003e📱\u003c/span\u003e Responsive by default\u003c/h2\u003e\u003cp\u003eOptimized layouts for Desktop, Tablet and Mobile with touch-friendly interactions and beautifully centered profile cards.\u003c/p\u003e\u003ch2\u003e\u003cspan data-type=\"emoji\" data-name=\"computer_mouse\"\u003e🖱\u003c/span\u003e Included interactions\u003c/h2\u003e\u003cp\u003eDrag \u0026amp; swipe ✦ Click to focus ✦ Arrow controls ✦ Keyboard navigation ✦ Animated profile reveal ✦ CTA buttons\u003c/p\u003e\u003ch2\u003e\u003cspan data-type=\"emoji\" data-name=\"link\"\u003e🔗\u003c/span\u003e Live Preview\u003c/h2\u003e\u003cp\u003e\u003ca href=\"https://teammembercarousel.framer.website/\" rel=\"noopener noreferrer nofollow\" target=\"_blank\"\u003ehttps://teammembercarousel.framer.website/\u003c/a\u003e\u003c/p\u003e\u003cp\u003e––––––––\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan data-type=\"emoji\" data-name=\"heart\"\u003e❤\u003c/span\u003e Thank you so much for your support! I genuinely appreciate every download. I hope you have fun customizing this component and making it your own. Happy building!\u003c/strong\u003e\u003c/p\u003e55:T667,\u003ch2\u003e✦ Turn scrolling into a memorable experience.\u003c/h2\u003e\u003cp\u003eCreate interactive scroll galleries with dynamic content, smooth transitions and a clear visual focus. Fully responsive, easy to customize and \u003cstrong\u003eready to use in seconds. \u003c/strong\u003eMake it completely your own with flexible controls for layout, styling and motion :)\u003c/p\u003e\u003ch2\u003e\u003cspan data-type=\"emoji\" data-name=\"gear\"\u003e⚙\u003c/span\u003e What you can customize\u003c/h2\u003e\u003cp\u003eEasily adapt every part of the component to match your own brand and style.\u003c/p\u003e\u003cp\u003eImages ✦ Titles ✦ Subtitles ✦ Links ✦ Background colors ✦ Active scale ✦ Inactive opacity ✦ Spacing ✦ Border radius ✦ Typography ✦ Layout ✦ Responsive behavior\u003c/p\u003e\u003ch2\u003e\u003cspan data-type=\"emoji\" data-name=\"dart\"\u003e🎯\u003c/span\u003e Perfect for\u003c/h2\u003e\u003cp\u003ePortfolio showcases ✦ Case studies ✦ Creative agencies ✦ Landing pages ✦ Brand storytelling ✦ Editorial galleries ✦ Product highlights ✦ Service presentations\u003c/p\u003e\u003ch2\u003e\u003cspan data-type=\"emoji\" data-name=\"iphone\"\u003e📱\u003c/span\u003e Responsive by default\u003c/h2\u003e\u003cp\u003eOptimized layouts for Desktop, Tablet and Mobile with adaptive layouts and smooth touch interactions.\u003c/p\u003e\u003ch2\u003e\u003cspan data-type=\"emoji\" data-name=\"computer_mouse\"\u003e🖱\u003c/span\u003e Included interactions\u003c/h2\u003e\u003cp\u003eScroll-based focus ✦ Dynamic background transitions ✦ Clickable images ✦ Smooth scaling ✦ Opacity transitions ✦ Responsive layouts\u003c/p\u003e\u003cp\u003e––––––––\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan data-type=\"emoji\" data-name=\"heart\"\u003e❤\u003c/span\u003e Thank you so much for your support! I genuinely appreciate every download. I hope you have fun customizing this component and making it your own. Happy building!\u003c/strong\u003e\u003c/p\u003e56:T49e,\u003cp\u003eA modern scroll zoom reveal component for Framer designed to create immersive visual storytelling through smooth image scaling and text fade animations. Built with responsive layouts and clean motion effects, this component helps present content in a visually engaging and cinematic way.\u003c/p\u003e\u003cp\u003eAs users scroll, images gradually expand into focus while text smoothly fades away, creating a seamless transition that enhances readability and interaction. Easily customizable and optimized for performance, it integrates smoothly into landing pages, portfolios, and modern website experiences.\u003c/p\u003e\u003cp\u003e✨ Features:\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eSmooth scroll-based zoom interaction\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eImmersive image scaling animation\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSeamless text fade transition effects\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFully responsive across desktop, tablet, and mobile\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eClean and modern UI design\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eEasy to customize content and styling\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eOptimized for storytelling and premium web experiences\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e🔗 Live Preview:\u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://scrollzoomreveal.framer.website/\"\u003ehttps://scrollzoomreveal.framer.website/\u003c/a\u003e\u003c/p\u003e57:T643,\u003ch2\u003eLenis — Smooth scroll as it should be.\u003c/h2\u003e\u003cp\u003eLenis (meaning \u003cem\u003esmooth\u003c/em\u003e in Latin) is a lightweight, performant, and reliable smooth scroll library created by \u003ca href=\"http://darkroom.engineering\" rel=\"noopener noreferrer nofollow\" target=\"_blank\"\u003edarkroom.engineering\u003c/a\u003e. It’s designed to be simple to use and easy to integrate into any project, with modern performance in mind.\u003c/p\u003e\u003cp\u003ePerfect for creating smooth scrolling experiences, custom scroll, parallax effects, and more, Lenis enhances your site\u0026#39;s UX with minimal setup.\u003c/p\u003e\u003cp\u003eLenis is a 100% free and open-source project. But maintaining and improving Lenis takes time and resources. If you use Lenis and want to support its development, consider becoming a sponsor. A huge thank you to everyone who helps keep Lenis alive!\u003c/p\u003e\u003cp\u003eDonation: \u003ca href=\"https://buy.polar.sh/polar_cl_mpaOpp6UGpjARFe8NX3SGczPGciijvpTpyiWN0PhAjK\" rel=\"noopener noreferrer nofollow\" target=\"_blank\"\u003ehttps://buy.polar.sh/polar_cl_mpaOpp6UGpjARFe8NX3SGczPGciijvpTpyiWN0PhAjK\u003c/a\u003e\u003c/p\u003e\u003ch2\u003eFeatures\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eSmooth scroll\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eInfinite scroll\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eHorizontal scroll\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eNested scroll\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eScroll Snap\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eTouch Support\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003ca href=\"https://framer.lenis.dev/\" rel=\"noopener noreferrer nofollow\" target=\"_blank\"\u003eSee Demo\u003c/a\u003e\u003c/p\u003e\u003ch2\u003eConsiderations\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eIf you notice something wrong or see an opportunity of improvement, please open a \u003ca href=\"https://github.com/darkroomengineering/lenis/issues\" rel=\"noopener noreferrer nofollow\" target=\"_blank\"\u003eGithub issue\u003c/a\u003e.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e58:T597,\u003ch2\u003eWhat It Does\u003c/h2\u003e\u003cp\u003e\u003cstrong\u003eShort Form Video Slider\u003c/strong\u003e is a flexible video carousel designed for reels, and short form video content. Think TIK TOK / Instagram showcase, and youtube shorts.\u003c/p\u003e\u003cp\u003eIt supports both \u003cstrong\u003ehorizontal and vertical layouts\u003c/strong\u003e, making it easy to create anything from a cinematic desktop slider to a mobile-first short-form video experience.\u003c/p\u003e\u003cp\u003eUsers can browse through videos with arrows, pagination dots, or autoplay, while the inactive cards create a layered, polished slider effect.\u003c/p\u003e\u003cfigure\u003e\u003cimg src=\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/components/description-image-79pyxd01-qhdNmW1Sc1Y9xEi2bzG0BFI7nWgx30\" alt=\"\"\u003e\u003c/figure\u003e\u003ch2\u003eKey Features\u003c/h2\u003e\u003cp\u003e\u003cstrong\u003eVideo Setup\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eAdd multiple videos directly inside the component and customize how they appear across desktop, tablet, and mobile.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eLayout Options\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eSwitch between horizontal and vertical orientation depending on your design and content format.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eCustom Card Styling\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eControl card width, height, spacing, border radius, background colour, depth, perspective, scale, blur, and opacity.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003ePlayback Controls\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eEnable autoplay, looping, muted playback, and set the autoplay timing.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eNavigation UI\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eShow or hide arrows and dots, and customize their size, spacing, colour, and background.\u003c/p\u003e59:T49e,\u003ch2\u003eFeature Highlights\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eSpiral Motion \u003c/strong\u003eDisplays content along a smooth spiral path for a cinematic 3D browsing effect.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eScroll Based \u003c/strong\u003eSmooth scroll based rotation along a 3D spiral\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eDepth Perspective \u003c/strong\u003eCreates layered visual depth with dynamic scaling and positioning.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eInteractive Navigation \u003c/strong\u003eSupports drag, swipe, and smooth motion-based interaction.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eAuto Rotation \u003c/strong\u003eContinuously animates items for an immersive gallery experience.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eDynamic Focus \u003c/strong\u003eKeeps attention centered on highlighted elements while surrounding items flow naturally.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eResponsive Layout \u003c/strong\u003eAdapts beautifully across desktop, tablet, and mobile screens.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2\u003eWhy It’s Useful\u003c/h2\u003e\u003cp\u003eSpiralSlider transforms traditional galleries into immersive visual experiences.Perfect for portfolios, creative showcases, product presentations, hero sections, and experimental interfaces.\u003c/p\u003e\u003cp\u003eIts floating spiral layout adds motion, depth, and elegance while keeping interactions smooth and intuitive.\u003c/p\u003e5a:T654,\u003cp\u003eTransform your Framer projects with a polished, interactive grid background designed to elevate modern interfaces. This component reacts smoothly to cursor movement, creating subtle proximity-based animations that feel responsive, elegant, and professional.\u003c/p\u003e\u003cp\u003eChoose from \u003cstrong\u003efive distinct grid styles\u003c/strong\u003e—Dots + Lines, Lines Only, Dots Only, Plus Symbols, or Plus + Lines—giving you full creative flexibility to match any visual identity. Grid elements gently fade in as the cursor approaches, adding depth and motion without overwhelming your content.\u003c/p\u003e\u003cp\u003eEvery detail is fully customizable. Adjust grid spacing, element size, thickness, colors, opacity levels, proximity radius, hover darkening, and fade delay to create exactly the interaction you want. You can also toggle the background on or off, making it easy to layer the grid behind text, images, or UI elements.\u003c/p\u003e\u003cp\u003eBuilt with performance in mind, the component delivers smooth animations even when other layers sit above it. It’s fully responsive and adapts automatically to any container size, supporting both fixed and flexible layouts.\u003c/p\u003e\u003cp\u003ePerfect for hero sections, landing pages, portfolios, presentations, and modern web applications—this interactive grid helps your designs feel dynamic, refined, and alive.*** Feedback -\u0026gt; \u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://docs.google.com/forms/d/e/1FAIpQLSexopfTprHsvLOJI0daTpvbRVr-KdTrfjEvCXEfr9nDh8ZwcQ/viewform?usp=header\"\u003ehttps://docs.google.com/forms/d/e/1FAIpQLSexopfTprHsvLOJI0daTpvbRVr-KdTrfjEvCXEfr9nDh8ZwcQ/viewform?usp=header \u003c/a\u003e***\u003c/p\u003e5b:T77a,\u003ch2\u003e✦ Put your best work front and center.\u003c/h2\u003e\u003cp\u003eCreate elegant editorial carousels with a lifted center card, smooth interactions and a clear visual hierarchy. Fully responsive, easy to customize and \u003cstrong\u003eready to use in seconds. \u003c/strong\u003eMake it completely your own with flexible controls for layout, styling and motion :)\u003c/p\u003e\u003ch2\u003e\u003cspan data-type=\"emoji\" data-name=\"gear\"\u003e⚙\u003c/span\u003e What you can customize\u003c/h2\u003e\u003cp\u003eEasily adapt every part of the component to match your own brand and style.\u003c/p\u003e\u003cp\u003eImages ✦ Titles ✦ Subtitles ✦ Tags ✦ Tag position ✦ CTA labels ✦ Links ✦ Card size ✦ Card spacing ✦ Active elevation ✦ Border radius ✦ Typography ✦ Background color ✦ Text colors ✦ CTA styling ✦ Content spacing\u003c/p\u003e\u003ch2\u003e\u003cspan data-type=\"emoji\" data-name=\"dart\"\u003e🎯\u003c/span\u003e Perfect for\u003c/h2\u003e\u003cp\u003ePortfolios ✦ Featured projects ✦ Product highlights ✦ Landing pages ✦ Brand storytelling ✦ Editorial galleries ✦ Lifestyle showcases ✦ Creative studios\u003c/p\u003e\u003ch2\u003e\u003cspan data-type=\"emoji\" data-name=\"iphone\"\u003e📱\u003c/span\u003e Responsive by default\u003c/h2\u003e\u003cp\u003eOptimized layouts for Desktop, Tablet and Mobile with smooth touch interactions and a perfectly centered active card.\u003c/p\u003e\u003ch2\u003e\u003cspan data-type=\"emoji\" data-name=\"computer_mouse\"\u003e🖱\u003c/span\u003e Included interactions\u003c/h2\u003e\u003cp\u003eDrag \u0026amp; swipe ✦ Click to focus ✦ Mobile arrow controls ✦ Active content reveal ✦ Smooth spring animations\u003c/p\u003e\u003ch2\u003e\u003cspan data-type=\"emoji\" data-name=\"link\"\u003e🔗\u003c/span\u003e Live Preview\u003c/h2\u003e\u003cp\u003e\u003ca href=\"https://unreal-studies-359278.framer.app/\" rel=\"noopener noreferrer nofollow\" target=\"_blank\"\u003ehttps://unreal-studies-359278.framer.app/\u003c/a\u003e\u003c/p\u003e\u003cp\u003e––––––––\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan data-type=\"emoji\" data-name=\"heart\"\u003e❤\u003c/span\u003e Thank you so much for your support! I genuinely appreciate every download. I hope you have fun customizing this component and making it your own. Happy building!\u003c/strong\u003e\u003c/p\u003e5c:T795,\u003cp\u003eThe Eye Button is a playful, highly interactive UI component featuring animated eyes that respond to cursor movement in real time. The pupils smoothly follow the user\u0026#39;s cursor, adding personality and delight to calls-to-action. Perfect for landing pages, portfolios, and creative interfaces.\u003c/p\u003e\u003cp\u003eDesigned for flexibility, the component includes extensive customization options, letting you tailor both appearance and behavior to fit any brand or layout.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eCustomizable Properties\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eLink: Add any URL or action\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eButton Color: Customize the button background color\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eText: Edit the button label\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eText Color: Control the label color\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePadding: Adjust internal spacing for compact or spacious layouts\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eRadius: Control button corner roundness\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eEye Color: Set the eye background color\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePupil Color: Customize pupil color\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eEye Count: Choose between one or two eyes\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eEye Size: Adjust overall eye dimensions\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePupil Size: Control pupil scale\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eEye Gap: Set spacing between eyes\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSpeed: Adjust how quickly pupils follow the cursor\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eRange: Control how far pupils can move\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eBlinking: Enable or disable blinking\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eBlinking Intensity: Fine-tune blink strength\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003eWith smooth motion, expressive animations, and detailed controls, the Eye Button brings character and interactivity to any Framer project while remaining easy to customize and integrate.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eSupport \u0026amp; Feedback\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eQuestions or issues with setup? Reach out at \u003ca href=\"mailto:aathif.design@gmail.com\"\u003eaathif.design@gmail.com\u003c/a\u003e.\u003c/p\u003e\u003cp\u003eIf you like the component, I\u0026#39;d really appreciate a testimonial — just send it over to \u003ca href=\"mailto:aathif.design@gmail.com\"\u003eaathif.design@gmail.com\u003c/a\u003e.\u003c/p\u003e\u003cp\u003e\u003c/p\u003e5d:T453,\u003ch3\u003eFeatures\u003c/h3\u003e\u003cp\u003e• \u003cstrong\u003eSplit Modes\u003c/strong\u003e — Lines (masked reveal), Words, or Characters\u003c/p\u003e\u003cp\u003e• \u003cstrong\u003eTrigger\u003c/strong\u003e — Scroll-linked or On Load (fires when element appears)\u003c/p\u003e\u003cp\u003e• \u003cstrong\u003e12 Presets\u003c/strong\u003e — Default, Fade In Up, Blur Reveal, Cinematic, 3D Flip, Wave RTL, Typewriter, Glitch Rise, Soft Words, Cascade Down, Masked Lines, Scale Pop\u003c/p\u003e\u003cp\u003e• \u003cstrong\u003eCustom Mode\u003c/strong\u003e — Full control over stagger, offsets, blur, rotateX, perspective, and scale\u003c/p\u003e\u003cp\u003e• \u003cstrong\u003eColor Transition\u003c/strong\u003e — Smooth CSS color-mix from hidden to revealed color (supports dark mode)\u003c/p\u003e\u003cp\u003e• \u003cstrong\u003eHTML Tag\u003c/strong\u003e — Semantic tag (h1–h6, p, div, span) for SEO and accessibility\u003c/p\u003e\u003cp\u003e• \u003cstrong\u003eHigh Performance\u003c/strong\u003e — Direct DOM updates, no React re-renders during animation\u003c/p\u003e\u003ch3\u003eUse cases\u003c/h3\u003e\u003cp\u003eHero headlines, section titles, testimonials, landing page copy, and any scroll-driven storytelling.\u003c/p\u003e\u003ch3\u003eOptions\u003c/h3\u003e\u003cp\u003e\u003cimg src=\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/components/description-image-udw7zf7p-AFIHE3nZNSzh6G4c9pfdF9lcmqt2ie\"\u003e\u003c/p\u003e5e:T554,\u003cp\u003eA full-frame interactive wall where your images become real physical objects. They fall with gravity, collide, and stack up naturally. Grab any sticker, drag it, and throw it with real momentum. Built on a 2D physics engine for motion that feels genuinely tactile.\u003c/p\u003e\u003cp\u003eDrop in up to 10 images and they spawn as bouncy, grabbable stickers with slightly randomized size and rotation, so the pile always feels organic. Walls and floor keep everything inside the frame while the physics do the rest.\u003c/p\u003e\u003cp\u003eEvery feel is tunable from the property panel: gravity, bounciness, friction, throw power, and more. Dial it from a slow, heavy stack to a light, floaty bounce in seconds.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eFeatures\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eReal 2D physics: gravity, collisions, momentum\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eGrab, drag, and throw with natural weight\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eUp to 10 custom images as stickers\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eRandomized size and rotation for an organic pile\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eTunable gravity, bounciness, friction, and throw power\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eContained within the frame by floor and walls\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eResponsive and performance-friendly\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eHow to use\u003c/strong\u003e Drop it into any frame, upload your images, and adjust the physics controls to taste. Great as an interactive hero, an about-page moment, or a playful section that invites people to touch it.\u003c/p\u003e5f:T845,\u003ch2\u003eSilky Mouse Trail is a high-performance cursor trail effect that renders a fluid ribbon following the user’s pointer. It uses a canvas-based system with custom physics to simulate inertia, damping, and speed-based motion.\u003c/h2\u003e\u003cp\u003eThe trail dynamically adjusts width and color based on cursor velocity, creating a natural, silk-like flow. It runs outside the canvas in preview and publish mode, while staying invisible in the editor using a canvas guard.\u003c/p\u003e\u003ch2\u003eFeatures\u003c/h2\u003e\u003cp\u003eSilky Mouse Trail includes the following features out of the box:\u003c/p\u003e\u003cp\u003e• Physics-Based Motion — Smooth trailing effect with inertia, damping, and velocity influence• Speed Reactive Width — Trail expands and contracts based on cursor speed• Gradient Color Blending — Seamless transition between head and tail colors• High Performance Canvas Rendering — Efficient drawing loop using requestAnimationFrame• Stable Motion Handling — Prevents jitter and glitches with smart edge calculations• Pointer Tracking — Follows cursor with accurate and responsive updates• Auto Resize Support — Adjusts canvas resolution based on screen size and pixel ratio• Canvas Guard — Hidden in editor, active only in preview and live mode• Non-Interactive Layer — Pointer events are disabled so it never blocks UI\u003c/p\u003e\u003ch2\u003eProperty Controls\u003c/h2\u003e\u003cp\u003eLength — Controls the number of segments in the trailHead Width — Sets the thickness of the trail at the frontTail Width — Sets the thickness at the end of the trailHead Color — Defines the color near the cursorTail Color — Defines the color at the end of the trailDamping — Adjusts how tightly the trail follows the cursorMax Speed — Sets the speed threshold for width scalingZ-Index — Controls stacking order above other layers\u003c/p\u003e\u003ch2\u003eIdeal Use Cases\u003c/h2\u003e\u003cp\u003e• Portfolio websites that need a unique cursor effect• Agency and studio sites with strong visual identity• Landing pages that benefit from subtle motion• Interactive experiences and creative projects\u003c/p\u003e\u003cp\u003eIt adds a polished, modern feel without interfering with layout or interactions.\u003c/p\u003e60:T6f9,\u003ch2\u003eSpiderCircleEffect\u003c/h2\u003e\u003cp\u003e\u003cstrong\u003eSpiderCircleEffect\u003c/strong\u003e is an interactive animated dot-field component that creates a smooth “spider-like” motion across a network of dots. As the main point moves through the scene, it connects with nearby dots and generates clean, dynamic line effects that react beautifully to cursor movement.\u003c/p\u003e\u003cp\u003ePerfect for hero sections, landing pages, portfolios, creative websites, futuristic backgrounds, SaaS visuals, and interactive UI experiments.\u003c/p\u003e\u003ch3\u003eDescription\u003c/h3\u003e\u003cp\u003eBring your interface to life with a responsive spider-style particle animation. The component moves through a field of dots, creating elegant connections and motion trails that feel organic, modern, and playful. You can fully customize the colors, dot count, dot size, line transparency, movement speed, easing, reaction distance, and connection behavior.\u003c/p\u003e\u003cp\u003eWhether you want a subtle animated background or a bold interactive visual effect, \u003cstrong\u003eSpiderCircleEffect\u003c/strong\u003e gives you flexible controls to match your design style.\u003c/p\u003e\u003ch3\u003eKey Features\u003c/h3\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eAnimated spider-like movement through dots\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eInteractive cursor reaction\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCustomizable dot count, size, and colors\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAdjustable main point size and movement speed\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSmooth easing controls\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eDynamic connecting lines\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eOptional background toggle\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eGreat for dark, futuristic, creative, and tech-inspired layouts\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eEasy to customize directly from component properties\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch3\u003eSuggested Marketplace Short Description\u003c/h3\u003e\u003cp\u003eAn interactive spider-style dot animation that moves through particles, connects nearby dots, and creates smooth reactive visual effects for modern websites.\u003c/p\u003e61:T764,\u003cp\u003e\u003cstrong\u003eCMS Scrolling Gallery\u003c/strong\u003e is designed for projects that need more energy than a traditional portfolio or editorial layout. As users scroll, a thumbnail bar progresses through items, triggering background image changes and large scale text, creating a cinematic and intentional flow without manual animation work.\u003c/p\u003e\u003cp\u003eThe component offers extensive property controls for layout, spacing, text scale, thumbnails, and interaction behaviour, with multiple transition styles to shape how content and text moves. The thumbnail bar can be docked in several postions and orientations along with ability to either drag (or not drag) the bar. The remix includes two versions: an advanced coded component for deeper control, and a no code CMS driven version for easy content management. Including a package of curated Midjourney images and videos. It suits visual storytelling, bold portfolios, and expressive, motion led brand pages.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eFeatures\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eFramer remix \u0026amp; Midjoureny images and videos package\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eScroll driven gallery with cycling thumbnails\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eThumbnail bar advances automatically as the user scrolls\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eThumbnail bar is fully customisable and can be set of drag or no drag\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eBackground images update in sync with active thumbnails\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eLarge scale text reveals tied to each gallery item\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFully CMS powered no code version for easy content management\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAdvanced coded version included with extended interaction features\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eEight transition styles with additional options for motion behaviour\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCustomisable layout, docking, spacing, and sizing controls\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSupports expressive, colourful, and typographically led designs\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAlso delivered as a Framer remix for full flexibility and adaptation\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e62:T732,\u003ch2 class=\"editor_heading__csCxL\"\u003eWhy you’ll love it\u003c/h2\u003e\u003cul class=\"editor_bulletList__dyU6T\"\u003e\u003cli\u003e\u003cp class=\"editor_paragraph__IOT_o\"\u003eFeels alive: Click-hold to zoom out, drag, throw to glide; release to auto-zoom back—without drift or snapping.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp class=\"editor_paragraph__IOT_o\"\u003eCylindrical arc effect: Tiles gently curve toward/away from the viewer for a premium “curved wall” look.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp class=\"editor_paragraph__IOT_o\"\u003eHover polish: A separate blurred image layer (30px by default) fades in under a sharp foreground image.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp class=\"editor_paragraph__IOT_o\"\u003eStable zoom: Pin-based zoom math keeps the same world point under your cursor—no “jumping” when zooming.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp class=\"editor_paragraph__IOT_o\"\u003eEased parallax: Reverse-axis cursor parallax with tunable strength and easing.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp class=\"editor_paragraph__IOT_o\"\u003eBuilt for touch \u0026amp; mouse: Pointer Events, drag threshold, and capture for rock-solid input.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp class=\"editor_paragraph__IOT_o\"\u003eFramer-first: Simple property controls; drop onto any frame and go.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2 class=\"editor_heading__csCxL\"\u003ePerfect for\u003c/h2\u003e\u003cul class=\"editor_bulletList__dyU6T\"\u003e\u003cli\u003e\u003cp class=\"editor_paragraph__IOT_o\"\u003ePortfolios \u0026amp; case-study browsers\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp class=\"editor_paragraph__IOT_o\"\u003eMoodboards, visual libraries, inspiration walls\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp class=\"editor_paragraph__IOT_o\"\u003eMedia pickers \u0026amp; galleries with a kinetic/3D vibe\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp class=\"editor_paragraph__IOT_o\"\u003eLanding pages that need motion without WebGL\u003cbr\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2 class=\"editor_heading__csCxL\"\u003eLimitations\u003c/h2\u003e\u003cul class=\"editor_bulletList__dyU6T\"\u003e\u003cli\u003e\u003cp class=\"editor_paragraph__IOT_o\"\u003eGallery items are not clickable.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp class=\"editor_paragraph__IOT_o\"\u003eIt’s not possible to connect it to the CMS.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e63:Ta4b,\u003cp\u003eBring your website to life with \u003cstrong\u003eLiquid Cursor\u003c/strong\u003e, an interactive cursor component that creates mesmerizing liquid trails that smoothly follow the mouse.\u003c/p\u003e\u003cp\u003eDesigned for modern portfolios, creative agencies, SaaS products, landing pages, and premium websites, this component delivers a polished, high-end experience without writing a single line of code.\u003c/p\u003e\u003cp\u003eCustomize every aspect—from colors and size to viscosity, glow, blur, speed, and responsiveness—to perfectly match your brand.\u003c/p\u003e\u003cp\u003eSimply drag, drop, and publish.\u003c/p\u003e\u003cp\u003eFeatures\u003c/p\u003e\u003cp\u003e\u003cspan data-type=\"emoji\" data-name=\"sparkles\"\u003e✨\u003c/span\u003e Beautiful liquid animation\u003c/p\u003e\u003cp\u003e\u003cspan data-type=\"emoji\" data-name=\"rainbow\"\u003e🌈\u003c/span\u003e Fully customizable gradient colors\u003c/p\u003e\u003cp\u003e\u003cspan data-type=\"emoji\" data-name=\"zap\"\u003e⚡\u003c/span\u003e GPU-accelerated for smooth performance\u003c/p\u003e\u003cp\u003e\u003cspan data-type=\"emoji\" data-name=\"computer_mouse\"\u003e🖱\u003c/span\u003e Mouse \u0026amp; touch support\u003c/p\u003e\u003cp\u003e\u003cspan data-type=\"emoji\" data-name=\"art\"\u003e🎨\u003c/span\u003e Adjustable glow and blur\u003c/p\u003e\u003cp\u003e\u003cspan data-type=\"emoji\" data-name=\"droplet\"\u003e💧\u003c/span\u003e Control liquid size and viscosity\u003c/p\u003e\u003cp\u003e\u003cspan data-type=\"emoji\" data-name=\"rocket\"\u003e🚀\u003c/span\u003e Responsive across desktop and mobile\u003c/p\u003e\u003cp\u003e\u003cspan data-type=\"emoji\" data-name=\"hammer_and_wrench\"\u003e🛠\u003c/span\u003e Easy property controls\u003c/p\u003e\u003cp\u003e\u003cspan data-type=\"emoji\" data-name=\"dart\"\u003e🎯\u003c/span\u003e No code required\u003c/p\u003e\u003cp\u003e\u003cspan data-type=\"emoji\" data-name=\"infinity\"\u003e♾\u003c/span\u003e Lightweight and optimized\u003c/p\u003e\u003cp\u003ePerfect For\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eCreative Portfolios\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eDesign Agencies\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSaaS Websites\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eStartup Landing Pages\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eProduct Launches\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAI Products\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eInteractive Experiences\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePersonal Portfolios\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePremium Brands\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003eProperty Controls\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eCursor Size\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eTrail Length\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eLiquid Strength\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAnimation Speed\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eViscosity\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eGlow Intensity\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eBlur Amount\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eGradient Colors\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eOpacity\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eBlend Mode\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFollow Delay\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eMobile Enable / Disable\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePerformance Quality\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eZ-Index\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAuto Pause When Hidden\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003eWhy You\u0026#39;ll Love It\u003c/p\u003e\u003cp\u003eUnlike traditional custom cursors, \u003cstrong\u003eLiquid Cursor\u003c/strong\u003e creates a living, organic liquid motion effect that makes your website feel premium and interactive while maintaining exceptional performance. Easily customize every detail to match your brand and create memorable user experiences without writing any code.\u003c/p\u003e64:T74f,\u003ch2\u003e✦ A carousel that feels anything but ordinary.\u003c/h2\u003e\u003cp\u003eCreate expressive image carousels with layered cards, smooth motion and natural interactions. Fully responsive, easy to customize and\u003cstrong\u003e ready to use in seconds. \u003c/strong\u003eMake it completely your own with flexible controls for layout, styling and motion :)\u003c/p\u003e\u003ch2\u003e\u003cspan data-type=\"emoji\" data-name=\"gear\"\u003e⚙\u003c/span\u003e What you can customize\u003c/h2\u003e\u003cp\u003eEasily adapt every part of the component to match your own brand and style.\u003c/p\u003e\u003cp\u003eImages ✦ Titles ✦ Subtitles ✦ Tags ✦ Links ✦ Headlines ✦ Typography ✦ Colors ✦ Card size ✦ Fan spread ✦ Rotation ✦ Scale ✦ Animation speed ✦ Drag \u0026amp; Scroll ✦ Per-device layout\u003c/p\u003e\u003ch2\u003e\u003cspan data-type=\"emoji\" data-name=\"dart\"\u003e🎯\u003c/span\u003e Perfect for\u003c/h2\u003e\u003cp\u003eLanding pages ✦ Product showcases ✦ Creative portfolios ✦ Editorial layouts ✦ Travel stories ✦ Brand presentations ✦ Case studies ✦ Image galleries\u003c/p\u003e\u003ch2\u003e\u003cspan data-type=\"emoji\" data-name=\"iphone\"\u003e📱\u003c/span\u003e Responsive by default\u003c/h2\u003e\u003cp\u003eOptimized layouts for Desktop, Tablet and Mobile with smooth touch interactions.\u003c/p\u003e\u003ch2\u003e\u003cspan data-type=\"emoji\" data-name=\"computer_mouse\"\u003e🖱\u003c/span\u003e Included interactions\u003c/h2\u003e\u003cp\u003eDrag \u0026amp; swipe ✦ Scroll navigation ✦ Keyboard navigation ✦ Click to focus ✦ Optional links ✦ Hover animations ✦ Page indicators\u003c/p\u003e\u003ch2\u003e\u003cspan data-type=\"emoji\" data-name=\"link\"\u003e🔗\u003c/span\u003e Live Preview\u003c/h2\u003e\u003cp\u003e\u003ca href=\"https://decisive-reassurance-155626.framer.app\" rel=\"noopener noreferrer nofollow\" target=\"_blank\"\u003ehttps://decisive-reassurance-155626.framer.app\u003c/a\u003e\u003c/p\u003e\u003cp\u003e––––––––\u003c/p\u003e\u003cp\u003e\u003cspan data-type=\"emoji\" data-name=\"heart\"\u003e❤\u003c/span\u003e \u003cstrong\u003eThank you so much for your support! I genuinely appreciate every download. I hope you have fun customizing this component and making it your own. Happy building!\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e65:T50e,\u003cp\u003e\u003cstrong\u003eUse Cases\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eImmersive Hero Sections:\u003c/strong\u003e Create a high-impact first impression with a rotating 3D media gallery.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003ePortfolio Showcases:\u003c/strong\u003e Display project screenshots or videos in a continuous, interactive loop.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eDynamic Brand Walls:\u003c/strong\u003e Feature logo patterns or product highlights with atmospheric fog effects.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eFeatures\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eHybrid Media Support:\u003c/strong\u003e Seamlessly mix uploaded images and MP4/MOV videos in one gallery.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003ePhysics-Based Interaction:\u003c/strong\u003e Features smooth drag-to-rotate with adjustable damping for a premium \"weighty\" feel.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eFully Parametric 3D Space:\u003c/strong\u003e Control the curve radius, item dimensions, camera FOV, and yaw directly from the Framer UI.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eAtmospheric Depth:\u003c/strong\u003e Integrated Fog Fade system to naturally blend items into the background as they move away.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003ePerformance Optimized:\u003c/strong\u003e Uses an Intersection Observer to pause rendering when the component is off-screen.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eSmart Auto-Play:\u003c/strong\u003e Smooth continuous rotation that intelligently pauses during manual user interaction.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e66:T7aa,\u003ch2\u003e✦ Make your content the center of attention.\u003c/h2\u003e\u003cp\u003eCreate elegant card carousels with a centered focus, smooth interactions and a clean editorial layout. Fully responsive, easy to customize and \u003cstrong\u003eready to use in seconds.\u003c/strong\u003e Make it completely your own with flexible controls for layout, styling and motion :)\u003c/p\u003e\u003ch2\u003e\u003cspan data-type=\"emoji\" data-name=\"gear\"\u003e⚙\u003c/span\u003e What you can customize\u003c/h2\u003e\u003cp\u003eEasily adapt every part of the component to match your own brand and style.\u003c/p\u003e\u003cp\u003eImages ✦ Headlines ✦ Text ✦ Button labels ✦ Links ✦ Active \u0026amp; inactive scale ✦ Card gap ✦ Mobile overlap ✦ Border radius ✦ Border width ✦ Overlay color \u0026amp; opacity ✦ Shadow intensity ✦ Animation speed ✦ Typography ✦ Background color ✦ Indicator color\u003c/p\u003e\u003ch2\u003e\u003cspan data-type=\"emoji\" data-name=\"dart\"\u003e🎯\u003c/span\u003e Perfect for\u003c/h2\u003e\u003cp\u003ePortfolio sections ✦ Project showcases ✦ Service highlights ✦ Case study previews ✦ Product storytelling ✦ Landing pages ✦ Brand presentations ✦ Feature sliders\u003c/p\u003e\u003ch2\u003e\u003cspan data-type=\"emoji\" data-name=\"iphone\"\u003e📱\u003c/span\u003e Responsive by default\u003c/h2\u003e\u003cp\u003eOptimized layouts for Desktop, Tablet and Mobile with smooth touch interactions and perfectly centered cards.\u003c/p\u003e\u003ch2\u003e\u003cspan data-type=\"emoji\" data-name=\"computer_mouse\"\u003e🖱\u003c/span\u003e Included interactions\u003c/h2\u003e\u003cp\u003eDrag \u0026amp; swipe ✦ Click to focus ✦ Keyboard navigation ✦ Dot indicators ✦ CTA buttons ✦ Smooth transitions\u003c/p\u003e\u003ch2\u003e\u003cspan data-type=\"emoji\" data-name=\"link\"\u003e🔗\u003c/span\u003e Live Preview\u003c/h2\u003e\u003cp\u003e\u003ca href=\"https://versatile-desert-600216.framer.app/\" rel=\"noopener noreferrer nofollow\" target=\"_blank\"\u003ehttps://versatile-desert-600216.framer.app/\u003c/a\u003e\u003c/p\u003e\u003cp\u003e––––––––\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan data-type=\"emoji\" data-name=\"heart\"\u003e❤\u003c/span\u003e Thank you so much for your support! I genuinely appreciate every download. I hope you have fun customizing this component and making it your own. Happy building!\u003c/strong\u003e\u003c/p\u003e67:T8ca,\u003ch2\u003eUpdate 1.1\u003c/h2\u003e\u003cp\u003eAdded CMS support. You can now connect Flipbook 3D to Framer CMS and display pages dynamically from your collections.\u003c/p\u003e\u003ch2\u003eAbout\u003c/h2\u003e\u003cp\u003e\u003cstrong\u003eFlipbook 3D\u003c/strong\u003e adds a realistic, page-turning booklet to your Framer projects. Drop in a front cover, inner pages, and a back cover, then let visitors flip through a digital menu, catalog, album, or brochure with smooth 3D turns and crisp paper. Licensed for unlimited personal and commercial projects by the purchaser.\u003c/p\u003e\u003ch2\u003eWhat it does\u003c/h2\u003e\u003cp\u003eRenders a lifelike book with covers and pages, handles click/tap and keyboard turns, can show a page indicator, and preloads nearby images for stutter-free animation. Also supports Framer CMS, so you can connect collections and display flipbook pages dynamically.\u003c/p\u003e\u003ch2\u003eWhat you can customize\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eAssets:\u003c/strong\u003e Front Cover, Inner Pages (up to 100), Back Cover\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eDisplay:\u003c/strong\u003e Front / Inner / Back Display (Fit, Fill, Stretch)\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eLook:\u003c/strong\u003e Background color, Book Color (paper), Padding, Aspect Ratio (e.g. 3:4, 4:5, 5:7), Corner Radius, Shadow Strength\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eMotion:\u003c/strong\u003e Page Turn Duration, Easing\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eInteraction \u0026amp; UI:\u003c/strong\u003e Keyboard Nav on/off, Swipe/Drag on/off, Show Controls (prev/next buttons), Page Indicator show/hide\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2\u003eGreat for\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eRestaurant \u0026amp; café menus\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eBars, hotels, and events\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eBrochures, catalogs, and lookbooks\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePhoto albums \u0026amp; portfolios\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eLanding sections, hero blocks, and digital booklets\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2\u003eShare your build \u003c/h2\u003e\u003cp\u003eIf you ship something cool with it, post it on X and tag me \u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://x.com/Matthias_Oel\"\u003e\u003cstrong\u003e@Matthias_Oel\u003c/strong\u003e\u003c/a\u003e, or send it over. I’d love to see what you create.\u003c/p\u003e\u003ch2\u003eNeed help?\u003c/h2\u003e\u003cp\u003eQuestions or feedback? Reach me anytime: \u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"mailto:matthias@lmvision.de\"\u003e\u003cstrong\u003ematthias@lmvision.de\u003c/strong\u003e\u003c/a\u003e or on X \u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://x.com/Matthias_Oel\"\u003e\u003cstrong\u003e@Matthias_Oel\u003c/strong\u003e\u003c/a\u003e.\u003c/p\u003e68:T58f,\u003cp\u003e\u003ca href=\"https://www.framer.com/@rkoby/?tab=component\" rel=\"noopener noreferrer nofollow\" target=\"_blank\"\u003eMORE COMPONENTS →\u003c/a\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003eGlass Showcase helps you create an interactive card section with a clean glass-style look. Cards expand on hover, backgrounds blur dynamically, and all key settings can be customized directly in Framer.\u003c/p\u003e\u003ch2\u003eFeatures:\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eExpandable hover interactions\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eDynamic blurred background transitions\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFully customizable typography controls\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eEditable spacing and sizing options\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSmooth animations and hover effect\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eGlassmorphism-inspired visual style\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eEasy integration into Framer projects\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2\u003eFlexible controls\u003c/h2\u003e\u003cp\u003eCustomize every part of the component directly in Framer — from images, videos, layout, spacing, blur, and sizing to typography, colors, hover states, and active card settings.\u003c/p\u003e\u003cfigure\u003e\u003cimg src=\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/components/description-image-7xvbiclr-G17apPE7EDtWevJvLgN5cI7xdA64sD\" alt=\"\" /\u003e\u003c/figure\u003e\u003ch2\u003eResponsive layout options\u003c/h2\u003e\u003cp\u003eAdapt the showcase to different sections and screen sizes with flexible width, height, spacing, and thumbnail controls.\u003c/p\u003e\u003ch2\u003eSupport\u003c/h2\u003e\u003cp\u003eIf you need help with the component or have any issues while using it, feel free to reach out.\u003c/p\u003e\u003cp\u003eEmail: promakdesign@gmail.com\u003c/p\u003e69:Tb9c,\u003ch2\u003eAdd Premium Components To Your Projects:\u003c/h2\u003e\u003cfigure\u003e\u003ca href=\"https://marketplace.framer.com/@saadat-ali-designsbysadat/\" target=\"_blank\" rel=\"noopener noreferrer nofollow\"\u003e\u003cimg src=\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/components/description-image-g094t2v1-8wrj2R4JsfS8dz3uRkUmPxMk3a0JAx\" alt=\"\" /\u003e\u003c/a\u003e\u003c/figure\u003e\u003cfigure\u003e\u003ca href=\"https://www.framer.com/marketplace/components/liquid-glass-logo/\" target=\"_blank\" rel=\"noopener noreferrer nofollow\"\u003e\u003cimg src=\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/components/description-image-ectn8thw-7b1PJqGkGxVCbwcjGww89DIM89TglR\" alt=\"\" /\u003e\u003c/a\u003e\u003c/figure\u003e\u003ch2\u003eWhere to use:\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eSaaS Feature Showcases:\u003c/strong\u003e Highlight software dashboards and features with premium depth.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eCreative Portfolios:\u003c/strong\u003e Display design work, photography, or 3D art in an immersive way.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eHero Sections:\u003c/strong\u003e Replace static top-of-page images with an interactive, attention-grabbing slider.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eMobile App Previews:\u003c/strong\u003e Showcase app screens on your landing page with natural swipe mechanics.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eE-commerce Product Highlights:\u003c/strong\u003e Let users effortlessly scroll through premium product shots.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eNFT \u0026amp; Web3 Galleries:\u003c/strong\u003e Display digital assets with a futuristic, spatial layout.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eEvent \u0026amp; Venue Showcases:\u003c/strong\u003e Walk visitors through physical spaces and event photos.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eTestimonial Cards:\u003c/strong\u003e Turn boring text reviews into a dynamic, swipeable 3D deck.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eTeam Member Bios:\u003c/strong\u003e Introduce your company’s team in a highly interactive, modern format.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2\u003eMain Features:\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eImmersive 3D Depth \u0026amp; Scaling:\u003c/strong\u003e Creates a stunning visual hierarchy with dynamic rotation, sizing, and Z-axis depth that reacts as users scroll.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eFluid Physics-Based Motion:\u003c/strong\u003e Powered by Framer Motion springs to provide incredibly smooth drag, pan, swipe, and mouse-wheel interactions.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eCinematic Edge Blur:\u003c/strong\u003e Built-in, fully customizable frosted glass (backdrop blur) on the edges keeps the user\u0026#39;s focus locked on the center content.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eFully Customizable UI Controls:\u003c/strong\u003e Easily adjust item sizes, gaps, 3D perspective, and scroll damping right from the Framer properties panel—no coding required.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eResponsive \u0026amp; Plug-and-Play:\u003c/strong\u003e Drops instantly into any Framer project, scaling beautifully and working flawlessly across desktop, tablet, and mobile devices.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cfigure\u003e\u003ca href=\"https://marketplace.framer.com/@saadat-ali-designsbysadat/\" target=\"_blank\" rel=\"noopener noreferrer nofollow\"\u003e\u003cimg src=\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/components/description-image-tjtfqlx3-rWOrOFprl9nwsL79vsDxKmQrS4RuSB\" alt=\"\" /\u003e\u003c/a\u003e\u003c/figure\u003e6a:T8ce,\u003cp\u003eAdd a premium infinite scrolling media carousel to your site with custom SVG masking, smooth WebGL physics, and progressive edge blurring for a high-end cinematic feel.\u003c/p\u003e\u003ch2\u003e\u003cstrong\u003eFeatures\u003c/strong\u003e\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eEndless looping WebGL carousel physics\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCustom SVG and PNG mask support (Alpha \u0026amp; Luma modes)\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eProgressive scroll edge blur overlay\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eReal-time media contrast and saturation controls\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSmooth touch drag and trackpad wheel scrolling\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAuto-play with customizable damping and speed\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eHorizontal and vertical layout direction modes\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eHigh-performance resource caching and memory management\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePauses WebGL rendering when off-screen for peak site speed\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eResponsive auto-resizing and native Framer integration\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2\u003e\u003cstrong\u003eCustomization Options\u003c/strong\u003e\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eMedia items (Images \u0026amp; Videos)\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCustom SVG or PNG masks\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eMask modes (Alpha Transparent or Luma B/W)\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCarousel layout direction (Horizontal / Vertical)\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eItem width, height, and gap spacing\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eEdge blur strength and coverage size\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eMedia contrast and saturation\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eScroll damping (motion smoothness)\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eDrag, wheel, and auto-play speeds\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2\u003e\u003cstrong\u003eHow to Use\u003c/strong\u003e\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eDrop the component onto your Framer canvas\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eUpload your images, videos, and custom SVG masks\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eChoose your layout direction (horizontal or vertical)\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eTune the gap sizing and media dimensions to fit your layout\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAdjust the progressive edge blur, contrast, and scrolling speeds\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePublish for a premium, highly optimized WebGL interactive slider\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2\u003e\u003cstrong\u003eUse Cases\u003c/strong\u003e\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003ePremium SaaS feature showcases\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCreative agency portfolios\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eHigh-end eCommerce product galleries\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eInteractive masking slider sections\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eClient logo ticker loops\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eVideo highlight reels\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eImmersive landing page hero sections\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eModern interactive UI systems\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e6b:Tacf,\u003cp\u003e\u003cstrong\u003eExpand OnHover List – Interactive Numbered List with Hover-to-Expand Details\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eExpand OnHover List is a modern, interactive Framer component that transforms a clean numbered list into a rich, detail-revealing experience. Instead of overwhelming visitors with all your content at once, this component displays a minimal numbered layout by default — and elegantly expands to reveal an image, description, and CTA the moment someone hovers. The smooth transitions, layered animations, and refined motion make your services, features, or case studies feel premium and intentional with almost no setup required.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eHover-to-Expand Interaction\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eExpands to reveal image, description, and arrow CTA on hover.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eInactive items stay minimal and greyed out — keeping focus sharp.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSmooth height, opacity, and fade transitions feel natural and responsive.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSupports numbered sequencing (01, 02, 03...) for structured storytelling.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFully responsive and optimized for modern GPU-accelerated performance.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eCustomizable Design Controls\u003c/strong\u003e Expand OnHover List includes full Framer property controls so you can instantly match it to your brand or layout.\u003c/p\u003e\u003cp\u003eCustomize\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eList Items\u003c/strong\u003e – Add, remove, or reorder as many items as needed.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eTitle \u0026amp; Description\u003c/strong\u003e – Edit label and body text per item.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eImage\u003c/strong\u003e – Add a unique image or thumbnail to each list item.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eNumber Style\u003c/strong\u003e – Adjust size, color, and opacity of index numbers.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eExpanded Height\u003c/strong\u003e – Control how tall each item grows on hover.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eTypography\u003c/strong\u003e – Customize font size, weight, and spacing.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eDivider Style\u003c/strong\u003e – Adjust line color, thickness, or remove entirely.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eArrow Button\u003c/strong\u003e – Toggle, resize, or restyle the CTA arrow.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eTransition Speed \u0026amp; Easing\u003c/strong\u003e – Control how quickly items expand.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eActive \u0026amp; Inactive Colors\u003c/strong\u003e – Fine-tune contrast between states.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eHow It Works\u003c/strong\u003e Expand OnHover List tracks the cursor's hover state across each list item. When a user hovers over a row, the component smoothly animates the item open — expanding its height and fading in the image and description using layered motion transitions. Inactive rows simultaneously dim, keeping visual focus on the active item. When the cursor moves away, the expanded item gracefully collapses back to its default minimal state, ready for the next interaction.\u003c/p\u003e6c:T964,\u003cp\u003e\u003cstrong\u003eCMS Story Carousel\u003c/strong\u003e is a refined, editorial-style story carousel for Framer designed to showcase images, headlines, and short-form content in a smooth, immersive horizontal layout. It combines infinite scrolling, autoplay, drag interaction, wheel control, momentum, and an elegant overlay caption plate to create a cinematic way to present stories, projects, articles, case studies, and visual content.\u003c/p\u003e\u003ch2\u003e✦ Connect Every Story to Your CMS\u003c/h2\u003e\u003cp\u003eEach story can be connected individually to a \u003cstrong\u003eFramer CMS page or any URL\u003c/strong\u003e using the CMS Link control. This makes it easy to turn individual cards into clickable articles, case studies, projects, client stories, or other pages. \u003cstrong\u003eCMS Story Carousel is not a CMS Collection component\u003c/strong\u003e—you add the stories manually and optionally link each card to its corresponding CMS page.\u003c/p\u003e\u003ch2\u003e✦ Features Highlight\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eEditorial Story Cards\u003c/strong\u003e — Combine large imagery with an elegant text overlay for a magazine-inspired presentation.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eInfinite Horizontal Carousel\u003c/strong\u003e — Stories continuously loop for a seamless scrolling experience.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eSmooth Autoplay\u003c/strong\u003e — Automatically drift through stories with adjustable speed and direction.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eDrag \u0026amp; Flick Interaction\u003c/strong\u003e — Drag, swipe, and flick through cards with natural momentum.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eWheel Scrolling\u003c/strong\u003e — Navigate the carousel using vertical or horizontal mouse-wheel gestures.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eInteractive Caption Plate\u003c/strong\u003e — Expand or collapse the story information with a smooth animated toggle.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eFlexible Story Content\u003c/strong\u003e — Add your own image, label, headline, and supporting content to every card\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2\u003e✦ Made for Stories That Deserve to Move\u003c/h2\u003e\u003cp\u003eUse \u003cstrong\u003eCMS Story Carousel\u003c/strong\u003e for \u003cstrong\u003eeditorial websites, creative studios, portfolios, agencies, photography, fashion, magazines, blogs, case studies, architecture, campaigns, project showcases, and storytelling-focused landing pages\u003c/strong\u003e. \u003cstrong\u003eKeywords:\u003c/strong\u003e Framer Story Carousel, CMS Story Carousel, Framer Carousel, Framer CMS Link, Framer Editorial Carousel, Story Carousel Component, Framer Portfolio Carousel, Editorial Gallery, Framer Image Carousel, Interactive Story Slider.\u003c/p\u003e6d:T615,\u003ch2\u003eAbout\u003c/h2\u003e\u003cp\u003eLiquid Glass Footer is a responsive premium footer with a metallic gradient rim, layered glass surface, and polished interactions. It combines organized link columns, a newsletter form, social buttons, and dedicated desktop, tablet, and phone layouts.\u003c/p\u003e\u003ch2\u003eWhat you can customize\u003c/h2\u003e\u003cp\u003eBuilt entirely with native Framer elements and fully editable on the canvas. Customize the brand, tagline, links, newsletter button, social icons, copyright text, colors, spacing, shadows, and responsive layouts without code.\u003c/p\u003e\u003ch2\u003eGreat for (examples)\u003c/h2\u003e\u003cp\u003eJust a few ideas, use it anywhere you want a more polished footer experience:\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eSaaS landing pages\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eProduct websites\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eStartup websites\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCreative agencies\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eDesign studios\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePortfolio websites\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eTechnology brands\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAI products\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eMarketing websites\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eModern one-page websites\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePremium Framer templates\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eLiquid glass websites\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2\u003eShare your build\u003c/h2\u003e\u003cp\u003eIf you ship something cool with it, post it on X and tag me \u003ca href=\"https://x.com/Matthias_Oel\" rel=\"noopener noreferrer nofollow\" target=\"_blank\"\u003e@Matthias_Oel\u003c/a\u003e, or send it over. I’d love to see what you create.\u003c/p\u003e\u003ch2\u003eNeed help?\u003c/h2\u003e\u003cp\u003eQuestions or feedback? Reach me anytime: \u003ca href=\"mailto:matthias@lmvision.de\"\u003ematthias@lmvision.de\u003c/a\u003e or on X \u003ca href=\"https://x.com/Matthias_Oel\" rel=\"noopener noreferrer nofollow\" target=\"_blank\"\u003e@Matthias_Oel.\u003c/a\u003e\u003c/p\u003e6e:Tc77,\u003cp\u003eDot Grid Background brings your Framer canvas to life with a physics-inspired cursor interaction. As visitors hover, surrounding dots break from the grid and begin orbiting in randomized 3D planes — each dot tilted at a unique inclination and rotational axis, creating the layered depth of an atomic orbital model rather than a flat 2D swirl.\u003c/p\u003e\u003ch2\u003eHow it works\u003c/h2\u003e\u003cp\u003eEvery dot on the grid has three permanent orbital parameters assigned at render time: an inclination angle (how tilted its orbital plane is), an ascension angle (how that plane is rotated around the viewer axis), and a phase offset (where on the orbit it starts). A single global clock drives all orbits at a constant speed, so cursor movement never affects orbit velocity — only position determines which dots are pulled in. When the cursor leaves, orbits wind down with a smooth ease-out decay rather than cutting off abruptly.\u003c/p\u003e\u003ch2\u003eProperties\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eDot Color\u003c/strong\u003e — supports plain hex, RGB values, and Framer color styles with full light/dark theme awareness\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eDot Size\u003c/strong\u003e — dot radius from 1px to 12px\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eGrid Spacing\u003c/strong\u003e — controls density of the dot grid from tight (12px) to airy (80px)\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eEnable Orbiting\u003c/strong\u003e — toggle the 3D orbit effect on or off; when off, dots still scale and brighten under the cursor\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eOrbit Speed\u003c/strong\u003e — how fast dots revolve in their orbital planes (hidden when orbiting is off)\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eImpact Radius\u003c/strong\u003e — how far from the cursor the effect reaches, from 20px to 400px\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eScale on Hover\u003c/strong\u003e — how much dots enlarge at the center of the impact zone\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2\u003eTheme support\u003c/h2\u003e\u003cp\u003eColor styles defined in Framer's color system are resolved live against the component element every animation frame using getComputedStyle. This means the dot color correctly switches between your light and dark theme tokens the moment the theme changes — no re-mount required.\u003c/p\u003e\u003ch2\u003ePerformance\u003c/h2\u003e\u003cp\u003eRendered entirely on a hardware-accelerated \u0026lt;canvas\u0026gt; element using requestAnimationFrame. The grid rebuilds automatically on resize via ResizeObserver. The component is resolution-aware and renders at the device's native pixel ratio for crisp output on all screens including high-DPI displays.\u003c/p\u003e\u003ch2\u003eNo refunds allowed\u003c/h2\u003e\u003cp\u003eBy purchasing this Framer component, you acknowledge and agree to the following:\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eImmediate Delivery:\u003c/strong\u003e You will receive instant access to the digital assets upon purchase. Consequently, we do not offer refunds, returns, or exchanges for \"change of mind\" or accidental purchases.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eCompatibility:\u003c/strong\u003e It is the buyer's responsibility to ensure they have a functional Framer account and the technical proficiency to use the component.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eTechnical Issues:\u003c/strong\u003e If you encounter a genuine technical defect or a discrepancy between the live preview and the delivered file, please contact us within 7 days. We will provide a fix or support; if the issue remains unresolved, a refund may be issued at our sole discretion.\u003c/p\u003e6f:T9d6,\u003cp\u003e\u003cstrong\u003eMORE FRAMER COMPONENTS LIKE THIS\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e✦ Browse +38 FREE + 85 premium components: \u003c/strong\u003e\u003ca href=\"https://frameze.com/components\" rel=\"noopener noreferrer nofollow\" target=\"_blank\"\u003e\u003cstrong\u003ehttps://frameze.com/components\u003c/strong\u003e\u003c/a\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e✦ Get everything for one price: \u003c/strong\u003e\u003ca href=\"https://ahmetloca.dub.link/allcomponents\" rel=\"noopener noreferrer nofollow\" target=\"_blank\"\u003e\u003cstrong\u003ehttps://ahmetloca.dub.link/allcomponents\u003c/strong\u003e\u003c/a\u003e\u003c/p\u003e\u003ch2\u003e\u003cstrong\u003eAbout Accordion Service\u003c/strong\u003e\u003c/h2\u003e\u003cp\u003eAccordionSection is a numbered, animated accordion component for Framer. Each item expands with a smooth height animation on click, revealing its full description underneath. On hover, titles animate sharply from left to right with a precision reveal effect — creating a premium interactive layer that immediately elevates the page. A structured two-column header sits above the list, combining an eyebrow label, bold uppercase display heading and a right-aligned side description. This makes AccordionSection a complete, publication-ready section that drops into any Framer project with zero configuration.\u003c/p\u003e\u003cp\u003eNumbered items with auto-formatted labels (01, 02, 03...)\u003c/p\u003e\u003cp\u003eLeft-to-right title reveal animation on hover\u003c/p\u003e\u003cp\u003eSmooth expand and collapse with individually tunable open and close durations\u003c/p\u003e\u003cp\u003eTwo-column section header: eyebrow text, bold heading and side description\u003c/p\u003e\u003cp\u003eEyebrow icon — toggle on or off independently\u003c/p\u003e\u003cp\u003eFully responsive — auto-stacks to a single column under 768px\u003c/p\u003e\u003cp\u003eNative Framer font picker for title family and weight\u003c/p\u003e\u003cp\u003eGlobal font scale multiplier for quick size adjustments\u003c/p\u003e\u003cp\u003eFull color control — background and text, with borders auto-derived\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eUse Cases\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eAgency and studio services pages\u003c/p\u003e\u003cp\u003eProduct features and benefits sections\u003c/p\u003e\u003cp\u003eFAQ and support pages\u003c/p\u003e\u003cp\u003eTeam skills and expertise presentations\u003c/p\u003e\u003cp\u003ePricing plan and tier breakdowns\u003c/p\u003e\u003cp\u003eStep-by-step process and workflow sections\u003c/p\u003e\u003cp\u003eCompany values and mission pages\u003c/p\u003e\u003cp\u003eCase study and project summary layouts\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eKeywords\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eaccordion section, numbered accordion, accordion, services section, animated accordion, hover reveal animation, title reveal, expand collapse framer, FAQ accordion, services list, responsive accordion, services component, feature list, animated list, content accordion, numbered list, agency section, smooth accordion, accordion component\u003c/p\u003e70:T5d8,\u003ch2\u003eAbout This Component\u003c/h2\u003e\u003cp\u003eCircle Expand Card is an interactive media card designed to create bold hover interactions with smooth expanding circle animations.\u003c/p\u003e\u003cp\u003eWhen hovering the card, the icon background grows dynamically to fill the entire card, creating a fluid transition between the default and hover states. Combined with animated text colors, overlays, and customizable layouts, the result feels modern, playful, and highly interactive.\u003c/p\u003e\u003cp\u003eThe component supports flexible text positioning, custom icons, adjustable overlays, and responsive media backgrounds, making it ideal for portfolios, featured content, navigation cards, case studies, or creative landing pages.\u003c/p\u003e\u003ch3\u003eLayout \u0026amp; Content\u003c/h3\u003e\u003cp\u003eChoose between \u003cstrong\u003e5 built-in layouts\u003c/strong\u003e:\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eTitle Bottom Left\u003c/strong\u003e — category at the top left, icon at the top right, title and subtitle aligned bottom-left\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eTitle Bottom Right\u003c/strong\u003e — category at the top left, icon at the top right, title and subtitle aligned bottom-right\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eTitle Top Left\u003c/strong\u003e — category at the bottom left, icon at the bottom right, title and subtitle aligned top-left\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eTitle Top Right\u003c/strong\u003e — category at the bottom left, icon at the bottom right, title and subtitle aligned top-right\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eTitle Centered\u003c/strong\u003e — category at the top left, icon at the top right, title and subtitle perfectly centered\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e71:T6f1,\u003cp\u003eA Framer-ready gallery component that integrates seamlessly with CMS Collections. It features a continuous infinite scroll and a WebGL warp effect driven by scroll velocity. Build professional portfolio sites efficiently with a single component.\u003c/p\u003e\u003ch3\u003eCustomizable Properties\u003c/h3\u003e\u003col\u003e\u003cli\u003e\u003cp\u003eLayout\u003c/p\u003e\u003c/li\u003e\u003c/ol\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eColumns : 1~6\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePatterns : You can customize your layout using and 0. Simply mark the areas you wish to leave empty with an *\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eGap : Gap X/Y (px)\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePadding (px)\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eImage \u003cem\u003e*CMS Integration\u003c/em\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eTitle \u003cem\u003e*CMS Integration\u003c/em\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eText Style\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eFont\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eColor\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eIndex (Show/Hide)\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eGap (px)\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eLink\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eOpen in new tab\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eHover Effect\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eGrayscale to Color\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eColor to Grayscale\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eTitle Appear\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eNone\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eWarp Effect (On/Off)\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eScroll Speed\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch3\u003eHave Questions?\u003c/h3\u003e\u003cp\u003e\u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"mailto:hello@thedesignfuturist.zip\"\u003ehello@thedesignfuturist.zip\u003c/a\u003e\u003c/p\u003e\u003ch3\u003eBrowse More Resources\u003c/h3\u003e\u003cp\u003e\u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://thedesignfuturist.zip\"\u003ehttps://thedesignfuturist.zip\u003c/a\u003e\u003c/p\u003e\u003cfigure\u003e\u003ca href=\"https://thedesignfuturist.zip\" target=\"_blank\" rel=\"noopener noreferrer nofollow\"\u003e\u003cimg src=\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/components/description-image-vaslczgy-CeYRfkC3MMJX6bPXI5l31s17loVUhL\" alt=\"THE DESIGN FUTURIST: Framer Resources\" data-link=\"https://thedesignfuturist.zip\"\u003e\u003c/a\u003e\u003cfigcaption\u003eTHE DESIGN FUTURIST: Framer Resources\u003c/figcaption\u003e\u003c/figure\u003e72:Ta7d,\u003cp\u003e\u003cstrong\u003eFlap Split Reveal\u003c/strong\u003e creates a bold, mechanical text animation inspired by retro split-flap displays. Each line of text is covered by a solid color block that splits into two halves and flips away — choose whether it opens from the center outward or the edges inward, on either the horizontal or vertical axis, for four reveal styles in one component. Fully responsive: line count and block sizing recalculate automatically as your layout resizes, so the effect always matches your text.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eKey Features:\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eFour reveal modes: Horizontal or Vertical, Center-Out or Edges-In\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFully responsive — blocks recalculate on resize automatically\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eStaggered line-by-line animation\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFull typography and SEO tag control\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAdjustable block padding and corner radius\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eScroll-triggered or on-load animation\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch3\u003e\u003cstrong\u003eProperties\u003c/strong\u003e\u003c/h3\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eText\u003c/strong\u003e — The paragraph that will be animated. Each line is measured and revealed individually. \u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eSEO Tag\u003c/strong\u003e — Sets the HTML heading tag (H1, H2, paragraph, etc.) for accessibility and SEO. \u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eFont\u003c/strong\u003e — Choose the font family for your text. Supports all fonts in your Framer project. \u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eText Color\u003c/strong\u003e — Sets the color of the revealed text. \u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eAlignment\u003c/strong\u003e — Controls the alignment of the paragraph within its container. \u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eDirection\u003c/strong\u003e — Options: Horizontal or Vertical, Center-Out or Edges-In. Sets the split axis and reveal mode. \u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eDuration\u003c/strong\u003e — Sets the flip time for each block. \u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eStagger Delay\u003c/strong\u003e — Delay between each consecutive line\u0026#39;s reveal. \u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eReveal Color\u003c/strong\u003e — The solid color covering the text before it\u0026#39;s revealed. \u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eLine Spacing\u003c/strong\u003e — The space between lines of the effect. \u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eBlock Pad X / Block Pad Y\u003c/strong\u003e — Horizontal and vertical padding around each block, independent of the text. \u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eCorners\u003c/strong\u003e — Sets the corner radius of each block. \u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eTrigger\u003c/strong\u003e — Options: On Load, On Scroll. Easing — Sets the animation curve for the flip. \u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003ePadding\u003c/strong\u003e — Overall padding around the component.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch3\u003eSupport \u0026amp; Assistance \u003c/h3\u003e\u003cp\u003eQuestions or issues? Reach out at \u003ca href=\"mailto:danielgrafix12@gmail.com\"\u003edanielgrafix12@gmail.com\u003c/a\u003e and I\u0026#39;ll get back to you as soon as possible.\u003c/p\u003e73:T491,\u003cp\u003e\u003cstrong\u003eDetails\u003c/strong\u003eHover Bloom is a generative interaction component that turns pointer movement into animated floral growth. As the cursor moves across the canvas, stems grow organically and bloom into soft watercolor-style flowers with subtle blur, paper texture, and customizable color palettes.\u003c/p\u003e\u003cp\u003eIt works well for:\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eartistic hero sections\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eimmersive editorial layouts\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003efashion, beauty, and culture websites\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eexperimental portfolio pages\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003epoetic or nature-inspired interfaces\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003eMain features:\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eflowers spawn on pointer move or tap\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eupright or vine-like growth modes\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003epreset palettes: Mixed, Warm, Cool, Pink\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eoptional custom flower colors\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eadjustable bloom scale, blur, watercolor strength, and trail fade\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eoptional paper tint and dot grid background\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ereset-on-leave option for clean interactions\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eperformance-friendly bloom limit control\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003eUse it to add a living, painterly layer of interaction without relying on video or heavy 3D effects.\u003c/p\u003e74:T9b3,\u003cp\u003e-----------------------------------------------------------------------------------------------\u003c/p\u003e\u003ch2\u003eAdd More Premium Components To Your Projects:\u003c/h2\u003e\u003cfigure\u003e\u003ca href=\"https://marketplace.framer.com/@saadat-ali-designsbysadat/\" target=\"_blank\" rel=\"noopener noreferrer nofollow\"\u003e\u003cimg src=\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/components/description-image-g094t2v1-8wrj2R4JsfS8dz3uRkUmPxMk3a0JAx\" alt=\"\" data-link=\"https://marketplace.framer.com/@saadat-ali-designsbysadat/\"\u003e\u003c/a\u003e\u003c/figure\u003e\u003cfigure\u003e\u003ca href=\"https://www.framer.com/marketplace/components/liquid-glass-logo/\" target=\"_blank\" rel=\"noopener noreferrer nofollow\"\u003e\u003cimg src=\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/components/description-image-ectn8thw-7b1PJqGkGxVCbwcjGww89DIM89TglR\" alt=\"\" data-link=\"https://www.framer.com/marketplace/components/liquid-glass-logo/\"\u003e\u003c/a\u003e\u003c/figure\u003e\u003ch2\u003eWhere to use\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eLanding pages with animated hover typography\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCreative portfolio hero sections with media reveals\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSaaS marketing websites with interactive headlines\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAgency websites showcasing brand identity sections\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eEcommerce campaign banners with hover animations\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eProduct showcase sections with visual storytelling\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eMusic and entertainment websites with motion typography\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eModern startup landing pages with immersive hero text\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eWeb3 and AI websites with futuristic UI interactions\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eInteractive brand experiences and promo sections\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2\u003eFeatures\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eDynamic — Media reveal follows hovered character positions in real time\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFixed — Create clean split text layouts with centered hover media\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eVideo — Supports auto playing video hover interactions for immersive effects\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eImage — Display responsive image reveals with smooth expansion animation\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSpring — Natural spring motion creates fluid premium hover feedback\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eResponsive — Flexible layout adapts across hero sections and banners\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCustomizable — Adjust typography, spacing, radius, sizing, and animation controls\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eOptimized — Intersection Observer pauses videos outside the viewport\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSmooth — Layout animations prevent harsh jumps during interaction\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFlexible — Works for portfolios, SaaS websites, gaming pages, and campaigns\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e75:Taa6,\u003cp\u003e\u003cstrong\u003eCMS Swell Carousel\u003c/strong\u003e is a smooth, interactive image carousel for Framer that creates a dynamic fisheye-style effect. Cards naturally swell toward the center and taper toward the edges, creating a fluid, immersive gallery with continuous scrolling, drag interaction, wheel navigation, and autoplay.\u003c/p\u003e\u003cp\u003eEach card can be connected individually to a \u003cstrong\u003eFramer CMS page\u003c/strong\u003e or any URL using the \u003cstrong\u003eCMS Link\u003c/strong\u003e control. This makes it easy to create clickable project, portfolio, case study, product, or collection showcases.\u003c/p\u003e\u003ch2\u003e✦ Fisheye Image Carousel\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eSwell Effect\u003c/strong\u003e — Cards expand toward the center and smoothly shrink toward the edges.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eInfinite Scrolling\u003c/strong\u003e — Create a continuously moving image carousel.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eCenter Focus\u003c/strong\u003e — Automatically emphasize the cards near the center.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eCustom Card Size\u003c/strong\u003e — Adjust card width and aspect ratio.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eEdge Scale\u003c/strong\u003e — Control how small cards become at the edges.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eSpread\u003c/strong\u003e — Adjust the width and intensity of the swell effect.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eOverlap\u003c/strong\u003e — Create tighter card arrangements.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2\u003e✦ CMS-Friendly Links\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eConnect each card to a different \u003cstrong\u003eFramer CMS page\u003c/strong\u003e.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eUse the \u003cstrong\u003eCMS Link\u003c/strong\u003e control for individual cards.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eLink cards to projects, case studies, products, portfolios, or any URL.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eChoose whether links open in the \u003cstrong\u003esame tab or a new tab\u003c/strong\u003e.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2\u003e✦ Smooth Interactions\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eAutoplay\u003c/strong\u003e — Keep the carousel moving automatically.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eDirection Control\u003c/strong\u003e — Move the carousel left or right.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eDrag Interaction\u003c/strong\u003e — Drag cards freely with smooth momentum.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eWheel Navigation\u003c/strong\u003e — Navigate using mouse or trackpad scrolling.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eWheel Smoothing\u003c/strong\u003e — Control the softness of wheel movement.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003ePause on Hover\u003c/strong\u003e — Pause autoplay while hovering over the carousel.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2\u003e✦ Fully Customizable\u003c/h2\u003e\u003cp\u003eControl \u003cstrong\u003eimages, CMS links, new-tab behavior, card width, aspect ratio, edge scale, spread, overlap, background color, corner radius, autoplay, speed, direction, pause on hover, drag, momentum, wheel navigation, wheel sensitivity, and wheel smoothing.\u003c/strong\u003e\u003c/p\u003e\u003ch2\u003e✦ Perfect For\u003c/h2\u003e\u003cp\u003e\u003cstrong\u003eCreative Portfolios · Design Studios · Agencies · Photography · Fashion · Architecture · Case Studies and Many More.\u003c/strong\u003e\u003c/p\u003e76:Tacf,\u003cp\u003eCreate beautiful, interactive Google Maps in Framer without writing code. MapFlow makes it easy to build location maps, store locators, real estate maps, hotel maps, travel guides, office locations, and business directories using the Google Maps JavaScript API.\u003c/p\u003e\u003cp\u003eAdd unlimited custom markers, category filters, nearby locations, marker clustering, custom popups, automatic distance calculation, smart auto-fit, and fully branded map styles—all directly inside Framer.\u003c/p\u003e\u003cp\u003eLive Preview :- \u003ca href=\"https://mapflow.framer.website/\" rel=\"noopener noreferrer nofollow\" target=\"_blank\"\u003ehttps://mapflow.framer.website/\u003c/a\u003e \u003c/p\u003e\u003ch3\u003e\u003cstrong\u003eFeatures\u003c/strong\u003e\u003c/h3\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eInteractive Google Maps component for Framer\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eGoogle Maps API \u0026amp; Map ID support\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAdvanced Markers with hover effects\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eUnlimited custom markers\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eUpload custom marker icons (SVG, PNG, JPG, WebP)\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePrimary location with custom popup\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eMarker clustering for large datasets\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFilter box with categories \u0026amp; nearby locations\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAutomatic distance calculation\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCustom popups with links\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eBuilt-in map styles + Custom JSON styling\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eGoogle Cloud Map Styling support\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eRoadmap, Satellite, Hybrid \u0026amp; Terrain views\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eResponsive for Desktop, Tablet \u0026amp; Mobile\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eGlobal typography controls\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFully customizable colors, spacing \u0026amp; appearance\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eNo code required\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch3\u003e\u003cstrong\u003ePerfect For\u003c/strong\u003e\u003c/h3\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eReal Estate\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eHotels \u0026amp; Resorts\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eRestaurants \u0026amp; Cafés\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eStore Locators\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eOffice Locations\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eProperty Listings\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eTravel \u0026amp; Tourism\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eEvent Websites\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eBusiness Directories\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCampus \u0026amp; School Maps\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch3\u003e\u003cstrong\u003eSupport\u003c/strong\u003e\u003c/h3\u003e\u003cp\u003e\u003cspan data-type=\"emoji\" data-name=\"book\"\u003e📖\u003c/span\u003e Documentation:\u003ca href=\"https://docs.mapflow.7sync.tech\" rel=\"noopener noreferrer nofollow\" target=\"_blank\"\u003e \u003c/a\u003e\u003ca href=\"https://mapflow-docs.framer.website/\" rel=\"noopener noreferrer nofollow\" target=\"_blank\"\u003ehttps://mapflow-docs.framer.website/\u003c/a\u003e \u003c/p\u003e\u003cp\u003e\u003cspan data-type=\"emoji\" data-name=\"envelope\"\u003e✉\u003c/span\u003e Support: \u003ca href=\"mailto:hello@7synctech.com\"\u003e\u003cstrong\u003ehello@7synctech.com\u003c/strong\u003e\u003c/a\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eKeywords:\u003c/strong\u003e Google Maps, Framer Google Maps, Interactive Map, Custom Markers, Advanced Markers, Marker Clustering, Store Locator, Property Map, Real Estate Map, Location Finder, Map Component, Google Maps API, Map ID, Filter Box, Nearby Places, Custom Popups, Responsive Map, No-Code Framer Component.\u003c/p\u003e77:T4ba,\u003cp\u003eTextFlow converts static text into living, breathing particle systems. Each character becomes hundreds of animated particles that move and flow around cursor movements, creating an unforgettable visual experience.\u003c/p\u003e\u003ch3\u003eKey Features:\u003c/h3\u003e\u003cp\u003e• Interactive mouse physics - Particles react dynamically to cursor\u003c/p\u003e\u003cp\u003eproximity\u003c/p\u003e\u003cp\u003e• Fully customizable text content, colors, and typography and style to match the vibe of your site. Slow, fast, rigid? no worries\u003c/p\u003e\u003cp\u003e• Adjustable particle density, size, and animation speed\u003c/p\u003e\u003cp\u003e• Smart text wrapping that maintains perfect particle formation\u003c/p\u003e\u003cp\u003e• Multiple alignment options for seamless design integration\u003c/p\u003e\u003cp\u003e• Smooth return animations with customizable physics\u003c/p\u003e\u003ch3\u003eBenefits:\u003c/h3\u003e\u003cp\u003e• Instantly grab user attention with eye-catching animations\u003c/p\u003e\u003cp\u003e• Perfect for hero sections, landing pages, and feature highlights\u003c/p\u003e\u003cp\u003e• Enhance user engagement through interactive storytelling\u003c/p\u003e\u003cp\u003e• Stand out from competitors with unique visual effects\u003c/p\u003e\u003cp\u003e• Lightweight performance with optimized rendering\u003c/p\u003e\u003cp\u003e• Responsive to work across all screen sizes\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eGrab it and make that striking impression.\u003c/strong\u003e\u003c/p\u003e78:Tcec,\u003cfigure\u003e\u003ca href=\"https://www.framer.com/marketplace/components/slot-text-with-3d/\" target=\"_blank\" rel=\"noopener noreferrer nofollow\"\u003e\u003cimg src=\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/components/description-image-lkq0yj28-cliI6KTOjfzGc4nwPCg2yKZlBdzcEq\" alt=\"\" data-link=\"https://www.framer.com/marketplace/components/slot-text-with-3d/\"\u003e\u003c/a\u003e\u003c/figure\u003e\u003cp\u003eA lightweight Three.js globe that renders countries as shimmering point clouds and lets you place labeled “pins” anywhere on Earth. Designed for Framer, it balances visual polish with strict GPU/CPU budgeting, so it feels smooth in both the canvas and on published sites.\u003c/p\u003e\u003cp\u003e––––––––––––––––––––––––––––––––––––––––––\u003c/p\u003e\u003ch3\u003eLicense Agreement\u003c/h3\u003e\u003cp\u003e\u003cstrong\u003eAllowed\u003c/strong\u003e: Use in personal websites and commercial client projects.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eNot allowed\u003c/strong\u003e: Including the component in templates for resale on any digital marketplace.\u003c/p\u003e\u003cp\u003e––––––––––––––––––––––––––––––––––––––––––\u003c/p\u003e\u003ch2\u003e🌎 Where You Can Use\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eStore/office locator:\u003c/strong\u003e highlight your locations with rich labels.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eGlobal footprint / client map:\u003c/strong\u003e show presence, partners, shipments.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eData storytelling:\u003c/strong\u003e keynote slides and hero sections with subtle motion.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eLanding pages:\u003c/strong\u003e ambient, low-distraction background with interactive points.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eEvent sites:\u003c/strong\u003e visualize attendees, venues, or tour stops.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eDashboards:\u003c/strong\u003e at-a-glance geographic status without heavy tile maps.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2\u003e💎 Key Features\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eAuto-rotate\u003c/strong\u003e the globe and control speed.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eZoom \u0026amp; orbit\u003c/strong\u003e (optional) with inertia.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eCountry rendering\u003c/strong\u003e as edge + fill point layers (color, size, density, opacity).\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003ePins with labels:\u003c/strong\u003e name, address, phone; glowing dot + halo.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eStyling:\u003c/strong\u003e label color, background, border, opacity; pin dot color.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eTypography:\u003c/strong\u003e pick a font family and label size.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003eYou can find LON/LAT coordinates on \u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://www.latlong.net/\"\u003ewww.latlong.net\u003c/a\u003e\u003c/p\u003e\u003cfigure\u003e\u003cimg src=\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/components/description-image-zo7l1hzb-P94lEdMyCu7bm0U1afeuVLr9fgBVXD\" alt=\"\"\u003e\u003c/figure\u003e\u003ch2\u003e🎛️ Settings\u003c/h2\u003e\u003cfigure\u003e\u003cimg src=\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/components/description-image-tpuwgleh-Ml6jAMhOSDj51KAQxhxhRDqXwpn6sB\" alt=\"\"\u003e\u003c/figure\u003e\u003ch2\u003e✅ Updates\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e14.10.2025 – Added preloader progress themes: Light or Dark\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e23.10.2025 - Added Opacity Backside\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e6.11.2025 - Added Start From (Globe Position) and Stop Motion in Editor\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e3.12.2025 - Fixed bug with Globe size in Framer Editor\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e19.12.2025 - Added Post Effects\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e8.01.2026 - Added Trails to Pins\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e24.05.2026 - Added Real Map with Day/Night change.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e79:T608,\u003cp\u003eThis component is fully customizable with speed of the animation, colors and easing for a custom branded experience.\u003c/p\u003e\u003ch3\u003eHow to actually set up this component to work on your site:\u003c/h3\u003e\u003col\u003e\u003cli\u003e\u003cp\u003eSet it position type to fixed fixed (Absolute can work as well). Set the left and right positions to zero.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSet its width to 100% and height to 100vh so that it covers the full page no matter the screensize.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eMake the Z-Index 10 so that it appears ontop of everything else\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAdd Pointer Events: None –– Go under the styles Tab - Click the Plus Icon , you will see the Pointer Events option. Add it and set it to none, this will make sure that the loader doesn't block your site content.PS: Use the image below to follow the steps by using the blue marked numbers in the picture\u003c/p\u003e\u003c/li\u003e\u003c/ol\u003e\u003cfigure\u003e\u003cimg src=\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/components/description-image-t7s5gm2f-hi4hHbjYIzxfvCgV6vVK6n9y33YHjn\" alt=\"\"\u003e\u003c/figure\u003e\u003cp\u003eThat's all, everything else is about what you want to edit, the colors, the counter,  duration and more\u003c/p\u003e\u003cfigure\u003e\u003cimg src=\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/components/description-image-t7s5gm2f-Z3CWWG7RsDSi72EWBc3XwYY9Y2eBNB\" alt=\"\"\u003e\u003c/figure\u003e\u003cp\u003e\u003cstrong\u003eAimation Tip\u003c/strong\u003e:  Try to make sure that the counter duration and the transition duration are close, so that the loader line and the counter are at the same pace to create a realistic 100% loader effectThat's all, for any questions, feel free to reach out.\u003c/p\u003e7a:T9d6,\u003cp\u003eScroll Synced Text Highlight is a narrative text component that adds rhythm and focus to your content.\u003c/p\u003e\u003cp\u003eAs users scroll, words reveal and transition in sync with the viewport, creating a smooth, guided reading experience.\u003c/p\u003e\u003cp\u003eBuilt with GSAP and ScrollTrigger, it offers precise control while staying easy to use inside Framer.\u003c/p\u003e\u003cp\u003ePerfect for patterns like:\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eWe build → products → platforms → systems\u003c/strong\u003e\u003c/p\u003e\u003ch3\u003eCustomizable Properties\u003c/h3\u003e\u003cp\u003eEasily customize everything directly in Framer:\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003ePrefix text and word list\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAnimation mode (fade-in, spotlight, slide)\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eScroll behavior (scrub and snap)\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eText position (top, middle, bottom)\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eTypography, colors, and spacing\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003eAll controls are designed to be simple, flexible, and code-free.\u003c/p\u003e\u003ch3\u003eKey Features\u003c/h3\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eThree animation modes for different storytelling styles\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSmooth scroll-synced animations with GSAP\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eOptional snapping for precise alignment\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSticky layout for a strong visual anchor\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eBuilt-in accessibility support\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFully reusable across projects\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch3\u003eHow it works\u003c/h3\u003e\u003cp\u003eEach word is mapped to a position in the viewport using ScrollTrigger.\u003c/p\u003e\u003cp\u003eAs the user scrolls:\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eFade-in\u003c/strong\u003e: words appear and stay visible\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eSpotlight\u003c/strong\u003e: only the centered word is highlighted\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eSlide\u003c/strong\u003e: words move vertically in a fixed window\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003eThe prefix stays fixed, guiding the reading flow, while optional snapping ensures clean alignment.\u003c/p\u003e\u003ch3\u003eIdeal For\u003c/h3\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eLanding page hero sections\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCreative studio websites\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePortfolio storytelling\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eProduct highlights\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eBrand narratives\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSaaS marketing pages\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch3\u003eWhy this component stands out\u003c/h3\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eCombines multiple animation styles in one component\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSmooth and reliable thanks to GSAP\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSeamless integration with Framer controls\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAccessible by default\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eWorks for both minimal and expressive designs\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch3\u003eFuture improvements\u003c/h3\u003e\u003cp\u003eThe component is already production-ready, but future updates may include:\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003ePreset styles (Hero, Minimal, Cinematic)\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eMore advanced timing control\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAdditional animation variants\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e7b:T5ee,\u003ch2\u003eAbout\u003c/h2\u003e\u003cp\u003eLiquid Glass Navbar is a premium liquid glass navigation with refined hover interactions, a shimmering CTA, and a responsive mobile drawer. Built entirely with native Framer elements, it delivers a polished glass experience across every screen.\u003c/p\u003e\u003ch2\u003eWhat you can customize\u003c/h2\u003e\u003cp\u003eBuilt entirely with native Framer elements and fully editable on the canvas. Customize the logo, links, CTA, colors, shadows, spacing, typography, animations, and responsive behavior without code.\u003c/p\u003e\u003ch2\u003eGreat for (examples)\u003c/h2\u003e\u003cp\u003eJust a few ideas, use it anywhere you want navigation to feel more premium:\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003ePortfolio websites\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSaaS landing pages\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eStartup websites\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCreative agencies\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eDesign studios\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePersonal brands\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eProduct websites\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eLuxury brands\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePremium Framer templates\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eModern one-page websites\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eInteractive websites\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eMarketing websites\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2\u003eShare your build\u003c/h2\u003e\u003cp\u003eIf you ship something cool with it, post it on X and tag me \u003ca href=\"https://x.com/Matthias_Oel\" rel=\"noopener noreferrer nofollow\" target=\"_blank\"\u003e@Matthias_Oel\u003c/a\u003e, or send it over. I’d love to see what you create.\u003c/p\u003e\u003ch2\u003eNeed help?\u003c/h2\u003e\u003cp\u003eQuestions or feedback? Reach me anytime: \u003ca href=\"mailto:matthias@lmvision.de\"\u003ematthias@lmvision.de\u003c/a\u003e or on X \u003ca href=\"https://x.com/Matthias_Oel\" rel=\"noopener noreferrer nofollow\" target=\"_blank\"\u003e@Matthias_Oel.\u003c/a\u003e\u003c/p\u003e7c:T9b8,\u003cp\u003eElevate your feature presentations with Card Reveal—a sophisticated, interactive component that transforms how visitors discover what you offer. Say goodbye to static grids and hello to an engaging, user-controlled exploration experience.\u003c/p\u003e\u003ch3\u003eWhat makes it special:\u003c/h3\u003e\u003cp\u003eCard Reveal brings your features to life through fluid, polished animations. When a visitor clicks a card, it elegantly expands to reveal detailed content—text, images, and more—while other cards smoothly shrink to make space. This dynamic interaction keeps users engaged while maintaining a clean, uncluttered layout. Every transition feels premium and intentional, creating a memorable browsing experience.\u003c/p\u003e\u003ch3\u003eFlexible and customizable:\u003c/h3\u003e\u003cp\u003eStart with the default 2-card layout, or expand to 3 cards for more content. Each card supports custom images, icons, titles, and detailed descriptions. The component comes with a mobile-optimized variant that ensures perfect functionality across all devices.\u003c/p\u003e\u003cp\u003eFor 3-card setups: adjust the first card's width inside the expanded variants, then create additional variants showing each card in its expanded form with the others shrunk. If you need assistance setting this up, feel free to get in touch—I'm happy to help.\u003c/p\u003e\u003ch3\u003eResponsive by design:\u003c/h3\u003e\u003cp\u003eBuilt with mobile users in mind, Card Reveal includes dedicated variants for smaller screens, ensuring your features look stunning whether viewed on desktop, tablet, or phone.\u003c/p\u003e\u003ch3\u003eIdeal for:\u003c/h3\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eProduct feature showcases\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eService offering highlights\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePlatform capability demonstrations\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSolution benefit presentations\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eTechnology stack overviews\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePricing tier comparisons\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eTeam or department introductions\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eProcess or methodology breakdowns\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCase study highlights\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eBefore/after transformations\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch3\u003ePerfect for:\u003c/h3\u003e\u003cp\u003eStartups looking to make a strong first impression, SaaS companies highlighting product capabilities, agencies showcasing services, and any business that wants to present multiple features in an elegant, space-efficient way.\u003c/p\u003e\u003cp\u003eSimply add Card Reveal to your Framer project, swap in your content and images, customize the styling to match your brand, and watch your features come alive. Whether you're highlighting two key differentiators or three main services, this component adapts to your storytelling needs.\u003c/p\u003e7d:T6e8,\u003ch2\u003eAbout This Component\u003c/h2\u003e\u003cp\u003eLimitless Pro transforms your media into an infinite, explorable canvas. Built for performance and flexibility, this component creates a seamless masonry grid that repeats infinitely in all directions. Users can drag to navigate or scroll naturally through your content, with buttery-smooth animations that make exploration feel effortless. Whether you’re showcasing a portfolio, building a product gallery, or creating an immersive media experience, Limitless Pro adapts to your needs. Switch between images and videos, customize sizing modes, and fine-tune every aspect of the interaction to match your vision.\u003c/p\u003e\u003ch3\u003eFeatures\u003c/h3\u003e\u003cp\u003e• Infinite scrolling masonry grid with smooth drag-to-explore\u003c/p\u003e\u003cp\u003e•\u0026nbsp; Images and videos with smart aspect ratio detection\u003c/p\u003e\u003cp\u003e• Customizable play button with 6 presets + custom positioning\u003c/p\u003e\u003cp\u003e• Auto-pause videos when out of view for performance\u003c/p\u003e\u003cp\u003e• Multiple sizing modes: Fit, preset ratios, or fixed dimensions\u003c/p\u003e\u003ch3\u003eUse Cases\u003c/h3\u003e\u003cp\u003e• Portfolio galleries for creatives and photographers\u003c/p\u003e\u003cp\u003e• Product showcases with mixed media for e-commerce\u003c/p\u003e\u003cp\u003e• Immersive brand experiences and landing pages\u003c/p\u003e\u003cp\u003e• Video galleries and showreels for agencies\u003c/p\u003e\u003cp\u003e• Event photo and video collections\u003c/p\u003e\u003ch3\u003eTechnical Highlight\u0026nbsp;\u003c/h3\u003e\u003cp\u003e• Optimized grid repetition for infinite scroll without lag\u003c/p\u003e\u003cp\u003e• Automatic aspect ratio detection in Fit mode\u003c/p\u003e\u003cp\u003e• 60fps animations with React state optimization\u003c/p\u003e\u003cp\u003e• SSR compatible with graceful error handling\u003c/p\u003e\u003cp\u003eThere should be a clear Refund Policy on the checkout page.\u0026nbsp;\u003c/p\u003e\u003cp\u003eRefund Policy: Due to the digital nature of this product, all sales are final. Refunds are not offered after purchase.\u003c/p\u003e7e:T4e4,\u003cp\u003e\u003cstrong\u003ePolaroid Flip Card\u003c/strong\u003e is a single polaroid that tilts in 3D on hover and flips to reveal a handwritten note on the back. Drop it in, customize it, and make it feel personal.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eFlip interaction\u003c/strong\u003e Click the card to flip it. A spring animation gives the flip a satisfying physical weight. On hover, the card tilts in 3D following your cursor. \u003c/p\u003e\u003ch3\u003eDesign \u003c/h3\u003e\u003cp\u003eClassic polaroid-style frame, fully customizable. \u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eFrame color\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePadding\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCorner radius \u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eOptional border with color and width controls \u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eShadow intensity from subtle to dramatic \u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePhoto fit — cover, contain, or fill\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eTilt amount\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eTypography for notes\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch3\u003eWho it's for? \u003c/h3\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eDesigners building portfolio pages or personal showcases \u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAnyone who wants their site to feel like a real memory, not just a layout\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2\u003eNeed help?\u003c/h2\u003e\u003cp\u003eReach me anytime:\u0026nbsp;\u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"mailto:sashabalandina2003@gmail.com\"\u003eEmail \u003c/a\u003eor on X\u0026nbsp;\u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://x.com/aleksksaa\"\u003ehttps://x.com/aleksksaa\u003c/a\u003e\u003c/p\u003e7f:T416,\u003ch2\u003eAbout this component\u003c/h2\u003e\u003cp\u003eMeet Image Flow, a great way to showcase visuals on your website. Hover to reveal each image in the carousel, or set it to automatically loop through.\u003c/p\u003e\u003cp\u003ePerfect for product showcase, photos, or big visuals for your hero section. It's completely responsive and ready to copy into your Framer project.\u003c/p\u003e\u003ch2\u003eProperties\u003c/h2\u003e\u003cp\u003e• Image (any size, you can adapt component size responsively to the aspect ratio of choice)\u003c/p\u003e\u003cp\u003e• Manual / Auto loop through images at interval of choice\u003c/p\u003e\u003cp\u003e• Editable size, gaps, and border radius\u003c/p\u003e\u003cp\u003e• Desktop / Mobile variants\u003c/p\u003e\u003ch2\u003eQuestions?\u003c/h2\u003e\u003cp\u003eIf you have any questions about this component, feel free to contact me \u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://x.com/gustavwf\"\u003e@gustavwf\u003c/a\u003e or \u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"mailto:hi@gustavwf.com\"\u003ehi@gustavwf.com\u003c/a\u003e\u003c/p\u003e\u003ch2\u003eWant more?\u003c/h2\u003e\u003cp\u003eFind my works \u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://gustavwf.supply/\"\u003ehere\u003c/a\u003e.\u003c/p\u003e80:T7af,\u003ch2\u003eDynamic Roadmap Component (CMS Connected)\u003c/h2\u003e\u003cp\u003e\u003cstrong\u003eVisualize your journey. Build trust with your users.\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eThis fully responsive, CMS-powered Roadmap component is the perfect way to showcase your project's timeline and future milestones. Whether you're launching a SaaS product, a mobile app, a crypto token, or a community initiative, this component turns your plan into an engaging visual story.\u003c/p\u003e\u003ch3\u003eKey Features\u003c/h3\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eCMS Powered:\u003c/strong\u003e Manage your timeline effortlessly. Update phases, dates, and milestones directly from the Framer CMS—no design tweaks required.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eVersatile Design:\u003c/strong\u003e Clean, modern aesthetic that fits any brand, from tech startups and SaaS to Web3 and creative agencies.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eVisual Storytelling:\u003c/strong\u003e Each milestone features a customizable thumbnail, allowing you to visually represent key events like \"Beta Launch,\" \"Global Expansion,\" or \"Version 2.0.\"\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eStructured \u0026amp; Clear:\u003c/strong\u003e Pre-built fields for phase titles, release dates, and detailed feature lists ensure your audience knows exactly what's coming next.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003e100% Responsive:\u003c/strong\u003e Flawlessly adapts to any screen size, ensuring your roadmap looks professional on mobile, tablet, and desktop.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch3\u003eWhy You Need This\u003c/h3\u003e\u003cp\u003eYour users want to know where you're headed. A clear, interactive roadmap demonstrates transparency and vision, converting casual visitors into long-term supporters. Save hours of design time with a component that is ready to deploy and easy to scale as your project grows.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eIdeal for:\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eSaaS \u0026amp; App Launches\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eProduct Development Timelines\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eCrypto \u0026amp; Web3 Projects\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eCommunity \u0026amp; Event Schedules\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eCompany Growth Plans\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e81:T4d3,\u003cp\u003eStats Section is a fully customizable Framer component that animates numbers when scrolled into view — perfect for showcasing statistics, metrics, and achievements on any landing page. \u003c/p\u003e\u003cp\u003e\u003cstrong\u003eKey Features \u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eScroll-triggered animation with smooth easeOutExpo easing \u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eNative Framer font picker for number and label typography \u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePer-item value, prefix, suffix, and decimal configuration \u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e1,000 separator toggle (e.g. 10,000+ vs 10000+) \u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eLabel Case control — None / UPPERCASE / lowercase / Capitalize \u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eColumn Gap \u0026amp; Row Gap — independent spacing control \u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eResponsive wrap — auto stacks on smaller widths (set width to Fill) \u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePer-side padding control (T / R / B / L) - Optional divider lines between items \u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eBackground color and border radius support \u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eUsage \u003c/strong\u003e\u003c/p\u003e\u003col\u003e\u003cli\u003e\u003cp\u003eAdd the component to your page \u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSet width to Fill \u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eEdit Stats items — value, label, prefix, suffix \u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eDone \u003c/p\u003e\u003c/li\u003e\u003c/ol\u003e\u003cp\u003e\u003cstrong\u003ePerfect For \u003c/strong\u003eLanding pages · Portfolios · SaaS sites · Agency sites · E-commerce\u003c/p\u003e82:T63f,\u003cp class=\"editor_paragraph__IOT_o\"\u003e\u003cstrong\u003eAbout this Component\u003c/strong\u003e\u003cbr\u003eStatic illustrations feel lifeless. Why settle for motionless eyes when you can give your design a playful, human touch?\u003c/p\u003e\u003cp class=\"editor_paragraph__IOT_o\"\u003eIntroducing \u003cstrong\u003eEyes Follow Cursor\u003c/strong\u003e: an interactive component that makes pupils track the user’s mouse movement in real time. With subtle, natural motion, your design instantly feels alive drawing attention and adding charm to any layout. Simply drop the pupils inside your eye designs, and they’ll do the rest!\u003c/p\u003e\u003cp class=\"editor_paragraph__IOT_o\"\u003e\u003cstrong\u003ePerfect For:\u003c/strong\u003e\u003c/p\u003e\u003cul class=\"editor_bulletList__dyU6T\"\u003e\u003cli\u003e\u003cp class=\"editor_paragraph__IOT_o\"\u003eCharacter illustrations that react to your visitors.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp class=\"editor_paragraph__IOT_o\"\u003eFun landing pages with personality.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp class=\"editor_paragraph__IOT_o\"\u003eGamified UI elements or mascots.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp class=\"editor_paragraph__IOT_o\"\u003eAny design that could use a little spark of interactivity.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp class=\"editor_paragraph__IOT_o\"\u003e\u003cstrong\u003eKey Features:\u003c/strong\u003e\u003c/p\u003e\u003cp class=\"editor_paragraph__IOT_o\"\u003e✅ \u003cstrong\u003ePerfect Centering\u003c/strong\u003e – Pupils always start from and return to the exact center of the eye.\u003cbr\u003e✅ \u003cstrong\u003eSmooth Tracking Motion\u003c/strong\u003e – Follows the cursor with realistic, constrained movement.\u003cbr\u003e✅ \u003cstrong\u003eCustomizable Radius\u003c/strong\u003e – Adjust how far the pupils can move from the center for the perfect look.\u003cbr\u003e✅ \u003cstrong\u003eLightweight \u0026amp; Responsive\u003c/strong\u003e – Works seamlessly across screen sizes and layouts.\u003c/p\u003e83:T4ae,\u003cp\u003e\u003cstrong\u003eDiscPlayer\u003c/strong\u003e is a beautifully crafted, animated MP3 player component for Framer, designed with inspiration from classic vinyl record players. It brings a blend of minimalism and realism into your design, offering a clean, distraction-free interface where the focus is entirely on the experience of sound and motion.\u003c/p\u003e\u003cp\u003eAt the heart of the component is a glossy disc that subtly spins when audio is playing, accompanied by a mechanical needle arm that gently moves into position—mimicking the tactile charm of vintage turntables. With no visible buttons, titles, or timestamps, the interaction is intentionally simple: tap the disc to start or pause playback.\u003c/p\u003e\u003cp\u003eThis component is perfect for creators who want to feature audio in a stylish and non-intrusive way. Whether you’re showcasing a song, adding ambient background sound to a landing page, or evoking a sense of analog nostalgia, \u003cstrong\u003eDiscPlayer\u003c/strong\u003e helps you do it with elegance and ease.\u003c/p\u003e\u003cp\u003eDesigned to be fully customizable and easy to integrate, it’s ideal for portfolios, music previews, interactive storytelling, or any project that deserves a touch of retro sophistication in a modern UI.\u003c/p\u003e84:Tb10,\u003cp\u003e\u003cstrong\u003eEditorial Marquee\u003c/strong\u003e is a refined, media-rich scrolling component built to bring movement, rhythm, and an editorial feel to modern Framer websites. Combine bold typography with images and videos to create a dynamic visual showcase that feels premium, immersive, and effortless.\u003c/p\u003e\u003cp\u003ePerfect for creative studios, portfolios, agencies, fashion brands, photographers, digital magazines, and anyone looking to make their website feel more expressive.\u003c/p\u003e\u003ch2\u003e✦ What You Can Create\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eInfinite Scrolling Marquee\u003c/strong\u003e — Create smooth, continuous scrolling content that loops seamlessly.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eMultiple Rows\u003c/strong\u003e — Build anything from a single ticker to multi-row editorial layouts with up to 8 rows.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eText + Image + Video\u003c/strong\u003e — Mix different media types together to create visually rich compositions.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eCustom Speed \u0026amp; Variation\u003c/strong\u003e — Adjust scrolling speed and add subtle motion differences between rows.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2\u003e✦ Fully Customizable\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eControl typography, font size, weight, spacing, and text case.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCustomize media width, height, scale, radius, fit, spacing, and shadows.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAdd separators between content items.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCustomize background and text colors.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAdjust row spacing, item spacing, alignment, and vertical padding.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eControl hover scale, rotation, fade, and animation duration.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAdd edge fading for a polished, cinematic finish.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2\u003e✦ Interactive Media\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eAdd \u003cstrong\u003eimages or videos\u003c/strong\u003e to individual entries.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eUpload videos directly or use a video URL.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAdd custom video posters.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eEnable looping and muted playback.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eChoose between continuous playback or hover-to-play.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAdd links to individual items for projects, pages, case studies, or external websites.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePause the marquee while hovering for a more interactive experience.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2\u003e✦ Perfect For\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eFramer websites \u0026amp; landing pages\u003c/strong\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eCreative portfolios\u003c/strong\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eDesign studio websites\u003c/strong\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eAgency websites\u003c/strong\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eDigital magazines \u0026amp; editorial websites\u003c/strong\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eFashion \u0026amp; luxury websites\u003c/strong\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003ePhotography portfolios\u003c/strong\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eCreative agency showcases\u003c/strong\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003ePersonal portfolios\u003c/strong\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eProduct \u0026amp; brand showcases\u003c/strong\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eCase study presentations\u003c/strong\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eInteractive website sections\u003c/strong\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e85:T9ab,\u003cp\u003e\u003cstrong\u003eMORE FRAMER COMPONENTS LIKE THIS\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e✦ Browse +38 FREE + 85 premium components: \u003c/strong\u003e\u003ca href=\"https://frameze.com/components\" rel=\"noopener noreferrer nofollow\" target=\"_blank\"\u003e\u003cstrong\u003ehttps://frameze.com/components\u003c/strong\u003e\u003c/a\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e✦ Get everything for one price: \u003c/strong\u003e\u003ca href=\"https://ahmetloca.dub.link/allcomponents\" rel=\"noopener noreferrer nofollow\" target=\"_blank\"\u003e\u003cstrong\u003ehttps://ahmetloca.dub.link/allcomponents\u003c/strong\u003e\u003c/a\u003e\u003c/p\u003e\u003ch2\u003e\u003cstrong\u003eAbout Animated Stats Pro\u003c/strong\u003e\u003c/h2\u003e\u003cp\u003eAnimated Stats is a production-ready Framer component that animates numbers when scrolled into view. Unlike basic counter components, it ships with 4 distinct animation styles, a built-in interactive Demo Mode, and automatic responsive behavior.\u003c/p\u003e\u003cp\u003eDrop it on any page, add your numbers, and you\u0026#39;re done.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eKey Features\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e4 animation styles — Blur, Slide, Fade, Scale\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eScroll-triggered with easeOutExpo easing\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eDark / Light theme toggle\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e3 layout modes — 1×4, 2×2, 4×1 (auto-responsive)\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eLive Demo Mode — adjust everything in real time without leaving the canvas\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eNumber size, label size, gap, radius, padding controls\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eStagger delay for sequential entrance\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eReplay on re-enter option\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eDecimal number support (e.g. 4.9★)\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCustom font family\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCustom colors for number, suffix, label, divider\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFully responsive — auto-stacks on mobile\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eUsage\u003c/strong\u003e\u003c/p\u003e\u003col\u003e\u003cli\u003e\u003cp\u003eAdd to your page\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSet width to Fill\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eEdit stats — number, suffix, label\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eDone\u003c/p\u003e\u003c/li\u003e\u003c/ol\u003e\u003cp\u003e\u003cstrong\u003ePerfect For\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eLanding pages\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSaaS sites\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePortfolios\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAgency sites\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eE-commerce\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eLive Preview: \u003c/strong\u003e\u003ca href=\"https://animatedstatspro.framer.website/\" rel=\"noopener noreferrer nofollow\" target=\"_blank\"\u003e\u003cstrong\u003ehttps://animatedstatspro.framer.website/\u003c/strong\u003e\u003c/a\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eKeywords\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eAnimated stats, number counter, scroll animation, animated numbers, counter component, framer stats, stats section, animated counter, scroll trigger, number animation, KPI, metrics, milestone, landing page, saas, portfolio, dark mode, light mode, framer component, code component\u003c/p\u003e86:T6c8,\u003ch2\u003eAbout\u003c/h2\u003e\u003cp\u003eE-Commerce Mega Nav is a complete responsive shopping navigation with an announcement bar, search field, account actions, category links, and four product-rich mega menus. Each menu combines product previews, organized link columns, and a large promotional card, while mobile transforms into a full-height drawer with drill-down categories.\u003c/p\u003e\u003ch2\u003eWhat you can customize\u003c/h2\u003e\u003cp\u003eBuilt entirely with native Framer elements and fully editable on the canvas. Customize the logo, products, images, categories, menu links, promotional cards, CTA buttons, icons, cart badge, colors, typography, and responsive layouts without code. The styled search field is ready to connect to Framer Search and your CMS.\u003c/p\u003e\u003ch2\u003eGreat for (examples)\u003c/h2\u003e\u003cp\u003eJust a few ideas, use it anywhere you need a more complete product discovery experience:\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eOnline stores\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eD2C brands\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSupplement shops\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFitness brands\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFood and beverage stores\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eBeauty brands\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSkincare shops\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFashion stores\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eLifestyle brands\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eProduct marketplaces\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eEcommerce templates\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePremium Framer templates\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2\u003eShare your build\u003c/h2\u003e\u003cp\u003eIf you ship something cool with it, post it on X and tag me \u003ca href=\"https://x.com/Matthias_Oel\" rel=\"noopener noreferrer nofollow\" target=\"_blank\"\u003e@Matthias_Oel\u003c/a\u003e, or send it over. I’d love to see what you create.\u003c/p\u003e\u003ch2\u003eNeed help?\u003c/h2\u003e\u003cp\u003eQuestions or feedback? Reach me anytime: \u003ca href=\"mailto:matthias@lmvision.de\"\u003ematthias@lmvision.de\u003c/a\u003e or on X \u003ca href=\"https://x.com/Matthias_Oel\" rel=\"noopener noreferrer nofollow\" target=\"_blank\"\u003e@Matthias_Oel.\u003c/a\u003e\u003c/p\u003e87:T40c,\u003cp\u003eThe effect runs on four gradient colors that blend and shift as the cursor moves. Gradient toggle, radius, strength, distortion, hue shift, and color cycle speed all live under the Effect group.\u003c/p\u003e\u003cp\u003eAnimation controls cover overall speed, trail persistence, and pointer smoothing — smoothing affects how closely the fluid tracks the cursor versus drifting behind it. Overflow padding lets the canvas bleed past the image edges for a softer boundary.\u003c/p\u003e\u003cp\u003eUnder Advanced: quality toggle (high uses curl noise for a cleaner flow field, low is faster), fade-in duration, and max DPR cap. The image prop hot-reloads the texture without destroying the GL context, so swapping images in the CMS works cleanly.\u003c/p\u003e\u003cp\u003eClick anywhere on the image to trigger a radial burst that expands and decays.\u003c/p\u003e\u003cp\u003eThe RAF loop pauses when the pointer leaves and all effects have settled — it doesn't keep running in the background.\u003c/p\u003e\u003cp\u003eStatic fallback renders a plain image for SSR and thumbnails. Reduced motion disables pointer tracking.\u003c/p\u003e88:T949,\u003cp\u003e\u003cstrong\u003eGet this component in the complete Shader Components Bundle.\u003c/strong\u003e Access all four paid shader-driven Framer components—worth \u003cstrong\u003e$39 separately—for $25.\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003ca href=\"https://buy.polar.sh/polar_cl_FBTRwXvW4IxXMkrBRaY6alzgUNvhGm5kkWwJN4Gn6NH\" rel=\"noopener noreferrer nofollow\" target=\"_blank\"\u003eGet the Shader Components Bundle →\u003c/a\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eHover Shader Index \u003c/strong\u003eis a premium Framer section with hover-driven shader previews, smooth list interactions, and clean visual rhythm.\u003c/p\u003e\u003ch3\u003eShader Visuals\u003c/h3\u003e\u003cp\u003eEach liquid shader block uses its own color palette and seed, while shared settings keep the overall system consistent.\u003c/p\u003e\u003cp\u003eThe result is five distinct shader combinations that feel connected, with the block, gradient, icon, and description transitioning smoothly between states.\u003c/p\u003e\u003ch3\u003eTypography and Spacing\u003c/h3\u003e\u003cp\u003eThe design uses bold Inter typography, tight letter spacing, restrained inactive colors, balanced spacing, rounded shader blocks, and soft motion. The description sits below the list without competing with the main interaction.\u003c/p\u003e\u003ch3\u003eResponsiveness\u003c/h3\u003e\u003cp\u003eDesktop is hover-based. On phone, the list becomes a tap accordion: tapping an item reveals its description, dims the others, and shows the matching shader block above the list. Tapping again returns to default.\u003c/p\u003e\u003ch3\u003eCustomization\u003c/h3\u003e\u003cp\u003eCustomizable Framer variables let you adjust content, colors, logos, shader behavior, transitions, radius, and styling.\u003c/p\u003e\u003cp\u003eCustomizable fields include:\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eItem labels, descriptions, and logos\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eItem, inactive, and description colors\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSection background color\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eTransition settings\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eShader speed, scale, amplitude, frequency, bands, noise amount, definition, and seeds\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eShader block radius for desktop and phone\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch3\u003eGreat For\u003c/h3\u003e\u003cp\u003eIdeal for AI startups, SaaS landing pages, product feature sections, service showcases, portfolio pages, tool stack sections, creative studios, and any Framer website that needs a visually rich but minimal way to present multiple capabilities.\u003c/p\u003e\u003ch3\u003eQuestions \u0026amp; Support\u003c/h3\u003e\u003cp\u003eReach out any time via\u003ca href=\"https://x.com/@omeronframer\" rel=\"noopener noreferrer nofollow\" target=\"_blank\"\u003e x.com \u003c/a\u003eemail at \u003ca href=\"mailto:contact@omermirza.com\"\u003econtact@omermirza.com\u003c/a\u003e.\u003c/p\u003e89:T7c1,\u003cp\u003eWheel Carousel turns a simple list into a piece of motion design. Labels curve around an invisible drum and sweep past a fixed marker as visitors scroll or drag — the selected item locks upright while the rest arc away and fade into the background, with a portrait photo crossfading in to match whatever\u0026#39;s selected.\u003c/p\u003e\u003cp\u003eIt\u0026#39;s built for portfolios, project indexes, city/location pickers, menus, or any list where you want scrolling itself to feel like an interaction, not just a means to an end.\u003c/p\u003e\u003cp\u003eEvery visual dimension is exposed as a property control: curve radius, label spacing, how many items stay visible, font, colors, marker style, drag and scroll sensitivity, snap and momentum behavior, and a built-in Light / Dark / Custom mode switch. No code editing required — just drop it in, add your items, and tune it in the panel.\u003c/p\u003e\u003ch2\u003eKey Features\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eScroll- and drag-driven rotation with momentum and snap-to-item\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eInfinite loop — the list wraps seamlessly in either direction\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePhoto panel that crossfades to the selected item\u0026#39;s image\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eLight, Dark, and fully Custom color modes via one toggle\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eEditable item list — add any number of rows, each with its own label and uploaded image\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAdjustable curve radius, label spacing, and visible item count for denser or sparser wheels\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSoft top/bottom edge fade — no hard cropping at the frame edges, at any size\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCentered, width-capped layout that holds up across canvas sizes\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSubtle fade-up entrance animation (optional)\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFully responsive — supports any width and height\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2\u003eWhat Buyers Get\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eThe Wheel Carousel code component, ready to paste or duplicate into any Framer project\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFull property-control access — no code editing needed\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSupport for unlimited items, each with custom label + image\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e8a:T65b,\u003ch3\u003eOverview\u003c/h3\u003e\u003cp\u003eTilt Card is a fully interactive, deeply customizable card component built for Framer. Each card responds to the user\u0026#39;s cursor with a smooth 3D tilt, a shimmer highlight that follows the mouse, and a soft color glow that pulses on hover — all driven by native browser APIs with no external dependencies.\u003c/p\u003e\u003cp\u003eThe component ships with three pre-built card styles out of the box — Violet, Rose, and Teal — but every visual property is exposed in the properties panel, so you can make it match any brand in minutes.\u003c/p\u003e\u003ch3\u003eWhat\u0026#39;s Included\u003c/h3\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eUnlimited cards — add or remove cards freely from the properties panel. No cap.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e3D tilt interaction with configurable angle, perspective, and return spring\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePer-card shimmer layer that tracks the cursor position in real time\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eHover glare, mesh gradient layer, noise texture, and colored box shadow — all individually toggleable\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFour custom cursor styles per card: Plus, Asterisk, Circle, and Square — plus the Default browser cursor\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCursor follows the mouse with a smooth, weighted lag (adjustable per card)\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eLogo block that accepts either a text glyph or a custom image — never both simultaneously\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eClickable arrow button with a URL link field per card\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFully fluid layout — cards shrink gracefully on small screens and grow vertically to fit long content\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eEvery property grouped into labelled sections with plain-language descriptions so you always know what you\u0026#39;re editing\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch3\u003e\u003c/h3\u003e8b:T857,\u003cp\u003e\u003cstrong\u003eTestimonial Hanger\u003c/strong\u003e is a premium hanging testimonial carousel for Framer that transforms customer reviews into an elegant hanging display. Featuring realistic hanging strings, premium editorial cards, smooth spring animations, and immersive interactions, it creates a unique way to showcase testimonials that instantly captures attention and builds trust.\u003c/p\u003e\u003cp\u003eEvery testimonial is displayed as a beautifully suspended card featuring customer photos, quotes, names, roles, companies, and customizable styling. With smooth animations, optional autoplay, drag interactions, and complete customization through Framer Property Controls, Testimonial Hanger delivers a polished testimonial experience for modern websites.\u003c/p\u003e\u003ch2\u003ePerfect For\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eSaaS Landing Pages\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eStartup Websites\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCreative Agencies\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eDesign Studios\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePersonal Portfolios\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFreelancers\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eConsultants\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eArchitecture Firms\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eBusiness Websites\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2\u003eFeatures\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eUnique hanging testimonial card design\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eRealistic hanging strings\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePremium editorial card layouts\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eInfinite testimonial carousel\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSmooth spring animations\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eDrag and swipe navigation\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eOptional autoplay\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eInteractive hover effects\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eClickable testimonial cards\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eNavigation arrows and pagination\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eResponsive across desktop, tablet, and mobile\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFully customizable typography\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAdjustable colors, spacing, sizing, and layout\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eComplete Framer Property Controls\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eNo code required\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2\u003eWhy You\u0026#39;ll Love It\u003c/h2\u003e\u003cp\u003eTestimonial Hanger gives your social proof a distinctive presentation that feels playful, premium, and memorable. Instead of ordinary testimonial sliders, it creates an interactive hanging display that highlights customer stories with elegant motion and thoughtful design, making your website stand out while building credibility.\u003c/p\u003e\u003cp\u003e\u003c/p\u003e8c:T593,\u003cp\u003eA transparent overlay that spawns image stickers along your cursor as you move, then fades them out behind you. It turns any section into a playful, interactive moment, like leaving a trail of stickers wherever the mouse goes.\u003c/p\u003e\u003cp\u003eDrop in up to 10 images and they appear one after another as the cursor moves, each with slightly randomized size and rotation so the trail always feels organic. New stickers spawn based on distance moved, so the spacing stays even instead of clumping.\u003c/p\u003e\u003cp\u003eBuilt to work anywhere: the background stays fully transparent, the layer passes clicks through to content beneath it, and there\u0026#39;s no text or clutter, just your images following the cursor. Tune everything from the panel: spacing, fade, size, rotation, and how many appear at once.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eFeatures\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eImage stickers trail the cursor as it moves\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eUp to 10 custom images\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eRandomized size and rotation for an organic feel\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eEven spacing based on distance, no clumping\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eTransparent and click-through, works over any section\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eTunable spacing, fade, size, and count\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eResponsive and performance-friendly\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eHow to use\u003c/strong\u003e \u003c/p\u003e\u003cp\u003eDrop it on top of any section, upload your images, and adjust the trail to taste. Great as an interactive hero layer, a landing accent, or a playful about-page touch.\u003c/p\u003e8d:T4cc,\u003cp\u003eAn animated chat preview for Framer that simulates real-time conversation between sender and receiver bubbles.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eFeatures\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eAnimated typing indicator and message reveal\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eUnlimited messages via array input\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAuto, click, hover, or scroll-triggered playback\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eBuilt-in iMessage, WhatsApp, and Messenger themes\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCustom color, gradient, and font controls\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAuto-contrast text color for readability\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eWorks in static preview (always shows full chat)\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eUse it for\u003c/strong\u003eShowcasing chatbot flows, onboarding sequences, customer support UI, or playful conversation mockups inside landing pages or app demos.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eFramer Controls\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eMessages:\u003c/strong\u003e Add, remove, and reorder text bubbles (sender/receiver)\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003ePacing:\u003c/strong\u003e Adjust typing speed and gap between messages\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eTheme:\u003c/strong\u003e Pick from presets or create your own with gradients\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eTriggers:\u003c/strong\u003e Start automatically or on click/hover/scroll\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003eLightweight, responsive, and fully configurable for any design style.\u003c/p\u003e8e:Tbc1,\u003cp\u003e\u003cstrong\u003eMORE FRAMER COMPONENTS LIKE THIS\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e✦ Browse +38 FREE + 85 premium components: \u003c/strong\u003e\u003ca href=\"https://frameze.com/components\" rel=\"noopener noreferrer nofollow\" target=\"_blank\"\u003e\u003cstrong\u003ehttps://frameze.com/components\u003c/strong\u003e\u003c/a\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e✦ Carousel Bundle: \u003c/strong\u003e\u003ca href=\"https://frameze.com/components/category/carousels?ref=bundles\" rel=\"noopener noreferrer nofollow\" target=\"_blank\"\u003e\u003cstrong\u003ehttps://frameze.com/components/category/carousels?ref=bundles\u003c/strong\u003e\u003c/a\u003e\u003c/p\u003e\u003ch2\u003e\u003cstrong\u003eAbout Phone Scroll Pro\u003c/strong\u003e\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eSmooth scroll-synced slide transitions with animated background color\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eRealistic iPhone frame with Black and Titanium finishes\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCircular reveal dark/light mode toggle, expands from the tap point\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e3D tilt effect that follows cursor movement\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAmbient glow and giant ambient slide numbers for depth\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eStaggered blur + fade text reveal on every slide\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePer-slide CTA buttons with custom text and links\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAnimated progress dots and vertical scroll progress bar\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eDemo Mode — live preview frame color, glow, dots and bar controls\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFully responsive — adapts phone size and layout for mobile and tablet\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFull property controls: colors, fonts, sizes, CTA, and theme defaults\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eWhat\u0026#39;s Included\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eUnlimited scroll-synced slides with image, title, description, CTA\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eBuilt-in circular reveal dark/light mode system\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e2 frame finishes — Black and Titanium\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e12+ property control groups\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eWorks out of the box, zero config\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eHow It Works\u003c/strong\u003e\u003c/p\u003e\u003col\u003e\u003cli\u003e\u003cp\u003eDrop the component onto your canvas\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAdd your slides with images, titles, and descriptions\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePick your colors and theme default, and you\u0026#39;re live\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ol\u003e\u003cp\u003e\u003cstrong\u003eUse Cases\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eApp landing pages \u0026amp; mobile app showcases\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSaaS feature walkthroughs \u0026amp; product tours\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eStartup \u0026amp; tech product launch pages\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eE-commerce app marketing pages\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFintech \u0026amp; banking app showcases\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePortfolio sites for app designers \u0026amp; developers\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAgency case study \u0026amp; client showcase pages\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eHealth \u0026amp; fitness app landing pages\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eEditorial scroll-storytelling layouts\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eProduct feature highlight sections\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eKeywords\u003c/strong\u003e\u003c/p\u003e\u003cp\u003ephone scroll component, iphone mockup framer, scroll showcase, app landing page framer, scroll-driven animation, iphone frame component, dark mode toggle, circular reveal animation, parallax phone mockup, product showcase, app mockup component, scroll sync slides, mobile app showcase, phone component, sticky scroll animation, theme toggle component\u003c/p\u003e8f:T7c3,\u003ch2\u003e✦ Give your content a fresh perspective.\u003c/h2\u003e\u003cp\u003eCreate elegant arc-shaped carousels with a centered focus, smooth interactions and a clean editorial look. Fully responsive, easy to customize and \u003cstrong\u003eready to use in seconds.\u003c/strong\u003e Make it completely your own with flexible controls for layout, styling and motion :)\u003c/p\u003e\u003ch2\u003e\u003cspan data-type=\"emoji\" data-name=\"gear\"\u003e⚙\u003c/span\u003e What you can customize\u003c/h2\u003e\u003cp\u003eEasily adapt every part of the component to match your own brand and style.\u003c/p\u003e\u003cp\u003eImages ✦ Titles ✦ Subtitles ✦ CTA labels ✦ Links ✦ Text styling ✦ Button styling ✦ Background color ✦ Border radius ✦ Shadows ✦ Active \u0026amp; inactive scale ✦ Opacity ✦ Lift ✦ Spacing ✦ Arc positioning ✦ Drag sensitivity ✦ Scroll sensitivity ✦ Spring timing ✦ Card ratio ✦ Scroll on/off\u003c/p\u003e\u003ch2\u003e\u003cspan data-type=\"emoji\" data-name=\"dart\"\u003e🎯\u003c/span\u003e Perfect for\u003c/h2\u003e\u003cp\u003ePortfolios ✦ Lifestyle showcases ✦ Service highlights ✦ Case studies ✦ Editorial landing pages ✦ Product storytelling ✦ Brand presentations ✦ Creative projects\u003c/p\u003e\u003ch2\u003e\u003cspan data-type=\"emoji\" data-name=\"iphone\"\u003e📱\u003c/span\u003e Responsive by default\u003c/h2\u003e\u003cp\u003eOptimized layouts for Desktop, Tablet and Mobile with adaptive arc layouts and smooth touch interactions.\u003c/p\u003e\u003ch2\u003e\u003cspan data-type=\"emoji\" data-name=\"computer_mouse\"\u003e🖱\u003c/span\u003e Included interactions\u003c/h2\u003e\u003cp\u003eDrag \u0026amp; swipe ✦ Scroll navigation ✦ Arrow controls ✦ Click to focus ✦ Linked CTAs ✦ Smooth spring animations\u003c/p\u003e\u003ch2\u003e\u003cspan data-type=\"emoji\" data-name=\"link\"\u003e🔗\u003c/span\u003e Live Preview\u003c/h2\u003e\u003cp\u003e\u003ca href=\"https://just-yards-913081.framer.app/\" rel=\"noopener noreferrer nofollow\" target=\"_blank\"\u003ehttps://just-yards-913081.framer.app/\u003c/a\u003e\u003c/p\u003e\u003cp\u003e––––––––\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cspan data-type=\"emoji\" data-name=\"heart\"\u003e❤\u003c/span\u003e Thank you so much for your support! I genuinely appreciate every download. I hope you have fun customizing this component and making it your own. Happy building!\u003c/strong\u003e\u003c/p\u003e90:T8fc,\u003cp\u003eAdd a premium 3D spatial rotating ring layout to your Framer projects with smart depth fading, physics-based swipe interactions, and responsive auto-fill spacing.\u003c/p\u003e\u003ch2\u003e\u003cstrong\u003eFeatures\u003c/strong\u003e\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eReal-time 3D spatial positioning and rotation\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSmooth physics-based drag and swipe interactions\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSmart auto-spacing with equal arc gap calculations\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eDynamic depth fading and intelligent z-index sorting\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAdjustable camera tilt and 3D perspective distortion\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eHighly optimized requestAnimationFrame performance\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAuto-fill functionality for rapid dynamic content scaling\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eClean integration with native Framer components\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eWorks perfectly for galleries, portfolios, and spatial UI\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2\u003e\u003cstrong\u003eCustomization Options\u003c/strong\u003e\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eRing radius and distance\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCamera tilt angle\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e3D perspective intensity\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAuto-spin toggle and speed multiplier\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eDrag and swipe sensitivity\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eDepth fade visibility toggle\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFront-safe fade start angle\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eBack-side fade limit angle\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eTotal slot count for auto-fill\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFully customizable embedded child content\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2\u003e\u003cstrong\u003eHow to Use\u003c/strong\u003e\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eDrop the Circular UI Slider component onto your Framer canvas\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eConnect your native Framer cards, images, or frames as children\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAdjust the ring radius and 3D perspective to fit your specific layout\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eTune the drag sensitivity, camera tilt, and auto-spin speed\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSet your depth fading angles for a realistic spatial effect\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePublish to deliver a highly interactive 3D spatial gallery\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2\u003e\u003cstrong\u003eUse Cases\u003c/strong\u003e\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003ePremium portfolio galleries\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e3D product showcases\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eInteractive testimonial sliders\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eImmersive app feature tours\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSpatial team member directories\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eModern SaaS landing pages\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eDynamic pricing tier displays\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eInteractive partner logo clouds\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eDark mode UI environments\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eWeb3 and futuristic interfaces\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e91:T10ff,\u003cp\u003e\u003cstrong\u003eScroll Sequences\u003c/strong\u003e lets you scrub through image or frame sequences using scroll. It’s ideal for showcasing 3D renders, product rotations, and frame-by-frame animations with smooth, responsive control.\u003c/p\u003e\u003cp\u003eInstead of autoplaying or looping, motion is driven by scroll position—creating a direct, tactile connection between user input and visual feedback.\u003c/p\u003e\u003ch2\u003eHow It Works\u003c/h2\u003e\u003cp\u003eThe component maps scroll progress to a sequence of images, displaying one frame at a time based on how far the user has scrolled. This makes it perfect for:\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e3D object rotations exported as image sequences\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eProduct spins and explainer visuals\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eVideo frames converted to images\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eHigh-fidelity, scroll-driven storytelling\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2\u003eProperties \u0026amp; Configuration\u003c/h2\u003e\u003ch3\u003eImages\u003c/h3\u003e\u003cp\u003eUpload up to \u003cstrong\u003e200 images\u003c/strong\u003e to form your sequence. Images are played in the order they appear in the list.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eRecommendations\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eUse evenly spaced frames for smooth motion (60–120 images works well for most 3D rotations)\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eKeep image dimensions consistent to avoid layout shifts\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eExport frames with optimized file sizes to improve performance\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch3\u003eScroll Behavior\u003c/h3\u003e\u003cp\u003eChoose how the sequence responds to scroll input:\u003c/p\u003e\u003col\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eViewport\u003c/strong\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ol\u003e\u003cp\u003eThe sequence is scrubbed based on the component’s progress through the viewport, from the moment it enters until it leaves.\u003c/p\u003e\u003cp\u003eThis mode is best suited for \u003cstrong\u003ea single, continuous scroll interaction\u003c/strong\u003e, typically when the sequence is the main focus of the page.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eRecommended use cases\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eFixed or sticky-positioned visuals\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFull-page hero animations\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eOne-scroll product reveals\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eExperiences where the animation plays once from start to end\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cfigure\u003e\u003cimg src=\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/components/description-image-agcz8fuq-nYr9P4YhBvagv0NMveXtf1AA4pZDgD\" alt=\"\"\u003e\u003c/figure\u003e\u003colstart=\"2\"\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eScroll Section\u003c/strong\u003e\u003c/p\u003e\u003c/li\u003e\u003c/ol\u003e\u003cp\u003eThe sequence is tied to a specific scroll section using a Section ID.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eBest for\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eLong-scrolling pages\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eNarrative or step-based layouts\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eControlling animation timing precisely\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cfigure\u003e\u003cimg src=\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/components/description-image-agcz8fuq-X6Akz2kch5JYSjYjGmyvJsTyHtSGuY\" alt=\"\"\u003e\u003c/figure\u003e\u003cp\u003e\u003cstrong\u003eTip:\u003c/strong\u003e Ensure the section has enough scroll height to allow smooth scrubbing across all frames.\u003c/p\u003e\u003ch3\u003eSmoothing\u003c/h3\u003e\u003cp\u003eControls how smoothly frames transition as the user scrolls.\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eLow values (0.01–0.2):\u003c/strong\u003e Very responsive, direct frame changes\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eMedium values (0.3–0.6):\u003c/strong\u003e Balanced and natural\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eHigh values (0.7–1):\u003c/strong\u003e Softer, more cinematic motion\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eRecommendations\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eUse lower values for technical or interactive visuals\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eUse higher values for product showcases and cinematic effects\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch3\u003ePreload Images\u003c/h3\u003e\u003cp\u003eEnable or disable preloading of all frames.\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eOn:\u003c/strong\u003e Loads all images upfront for the smoothest playback\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eOff:\u003c/strong\u003e Loads images progressively to reduce initial load time\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eRecommendations\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eTurn \u003cstrong\u003eOn\u003c/strong\u003e for short sequences or hero sections\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eTurn \u003cstrong\u003eOff\u003c/strong\u003e for long pages or large image sets\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2\u003eBest Practices\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eExport 3D sequences from tools like Blender at consistent angles and lighting\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eKeep scroll sections tall enough to avoid rushed animations\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eTest on both desktop and mobile to fine-tune smoothing values\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eUse compressed images (WebP recommended) for better performance\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2\u003eIdeal Use Cases\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e3D product spins and rotations\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eScroll-driven product storytelling\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eInteractive hero sections\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFrame-by-frame video animations\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eHigh-end marketing and portfolio sites\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e92:T14aa,\u003cp\u003eGrowing Navigation is a fully animated hamburger navigation built for Framer. It expands horizontally on desktop and fills the full screen on mobile. You get a clean fullscreen menu with no extra code.\u003c/p\u003e\u003cp\u003eEvery interaction runs on Framer Motion. Links slide in with opacity and blur for a smooth layered reveal. Closing the menu plays the same animation in reverse. A dimmed overlay appears behind the panel and closes it on click.\u003c/p\u003e\u003cp\u003eOn mobile (767px and below), the menu switches to fullscreen, locks scroll, and restores it on close. Pressing Escape closes it as well. On the canvas, you see a static collapsed preview for easy placement.\u003c/p\u003e\u003cp\u003eGrowing Navigation uses Framer’s router to handle navigation. It resolves routes and anchors automatically. External links open in a new tab.\u003c/p\u003e\u003ch2\u003eFeatures\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eAnimated Hamburger Toggle\u003c/strong\u003eTwo bars morph into an X. Hover shows a preview of the shift.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eBlur-Fade Staggered Links\u003c/strong\u003eLinks enter with vertical slide, opacity, and blur. Each item is staggered by 80ms.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eMobile Fullscreen Layout\u003c/strong\u003eOn small screens, the menu fills the viewport with proper padding and scroll lock.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eFramer Router Navigation\u003c/strong\u003eHandles internal routes and anchor links. External URLs open in a new tab.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eSocial Links Panel\u003c/strong\u003eA secondary column for social links with hover arrow reveal and sibling dimming.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eTagline Text\u003c/strong\u003eOptional short text block above social links.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eBackdrop Overlay\u003c/strong\u003eDark overlay fades in and closes the menu on click.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eBackdrop Filter Support\u003c/strong\u003eControl blur, saturation, and brightness for a frosted glass look.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eEscape Key Support\u003c/strong\u003ePress Escape to close the menu.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eCanvas Preview\u003c/strong\u003eStatic collapsed view for accurate layout in Framer.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2\u003eProperty Controls\u003c/h2\u003e\u003ch3\u003eNavigation\u003c/h3\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eNav Links\u003c/strong\u003eArray of links with Label, URL, and New Tab toggle.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eNav Font\u003c/strong\u003eFont family and size for links.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eNav Color\u003c/strong\u003eText color for navigation links.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eLink Spacing\u003c/strong\u003eVertical padding for each link.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch3\u003eSocial \u0026amp; Tagline\u003c/h3\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eSocial Links\u003c/strong\u003eArray of links with Label, URL, and New Tab toggle.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eSocial Font\u003c/strong\u003eFont family for social links.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eSocial Color\u003c/strong\u003eText color for social links.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eTagline Text\u003c/strong\u003eShort text above social links.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eTagline Font\u003c/strong\u003eFont family for tagline.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eTagline Color\u003c/strong\u003eText color for tagline.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch3\u003eBranding\u003c/h3\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eLogo Image\u003c/strong\u003eResponsive logo in the collapsed bar.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eLogo Link\u003c/strong\u003eURL for logo click.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eLogo Width\u003c/strong\u003eWidth in pixels.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch3\u003eStyling\u003c/h3\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eToggle Color\u003c/strong\u003eColor of hamburger bars.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eDivider Color\u003c/strong\u003eColor of dividers and panel edges.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eNav Background\u003c/strong\u003eBackground color of the panel.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eBg Blur\u003c/strong\u003eBlur level in pixels.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eBg Saturation\u003c/strong\u003eSaturation percentage.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eBg Brightness\u003c/strong\u003eBrightness multiplier.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch3\u003eLayout\u003c/h3\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eWidth (Open)\u003c/strong\u003eMax width of panel on desktop.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eHamburger Size\u003c/strong\u003eSize of the toggle button.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cfigure\u003e\u003cimg src=\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/components/description-image-bog97n29-adT6Ym4mWCfJNnbkHT2vjkqWQMkvsP\" alt=\"\"\u003e\u003c/figure\u003e\u003cfigure\u003e\u003cimg src=\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/components/description-image-bog97n29-zPQxhPfQYIDV6gxNSeZFVkxdnTDDJa\" alt=\"\"\u003e\u003c/figure\u003e\u003cfigure\u003e\u003cimg src=\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/components/description-image-bog97n29-Fr5tRYTJNxW74kpHESTxyMEj8gBWzP\" alt=\"\"\u003e\u003c/figure\u003e\u003ch2\u003eHow to Use\u003c/h2\u003e\u003col\u003e\u003cli\u003e\u003cp\u003eAdd Growing Navigation to your page and place it as a header on top of all your layers. \u003cstrong\u003e(Recommendation: Place it in your main template so you don't have to edit the navigation properties manually on every single page of your Framer project.)\u003c/strong\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eOpen Nav Links and add labels and URLs.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSet your Logo Image and link it to your homepage.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAdd Social Links and a short Tagline.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAdjust colors, blur, and background to match your style.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSet Width (Open) for desktop layout.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePublish and test on mobile to check fullscreen behavior.\u003c/p\u003e\u003c/li\u003e\u003c/ol\u003e\u003ch2\u003eIdeal Use Cases\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003ePortfolio and agency sites that need a bold navigation moment\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eStudio and creative projects that want one system for desktop and mobile\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFramer sites that rely on router-based navigation\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eProjects that include social links and a short brand message in the menu\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003eGrowing Navigation handles both internal routing and external links without extra setup.\u003c/p\u003e93:T4b0,\u003cp\u003eFanSlider Pro\u003c/p\u003e\u003cp\u003eFanSlider Pro is a premium infinite carousel component built for Framer creators who want smooth motion, clean layouts, and modern interaction effects.\u003c/p\u003e\u003cp\u003eDesigned with performance and flexibility in mind, this component helps you create visually engaging sections for landing pages, SaaS websites, portfolios, agencies, and startup websites.\u003c/p\u003e\u003ch2\u003eFeatures\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eInfinite smooth scrolling\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eResponsive layout\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eDrag \u0026amp; swipe interaction\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAutoplay animation\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eEasy customization\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eLightweight performance\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eModern clean design\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFramer native component\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2\u003ePerfect For\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eTestimonials\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eBrand logos\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePortfolio showcase\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eProduct sections\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eTeam members\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFeatured content\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eClient showcase\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2\u003eWhy Choose FanSlider Pro?\u003c/h2\u003e\u003cp\u003eFanSlider Pro delivers smooth and modern motion effects while remaining easy to customize inside Framer. The component is optimized for responsive websites and works beautifully across desktop, tablet, and mobile devices.\u003c/p\u003e94:T75a,\u003cp\u003eAdd a premium interactive image trail effect to your typography with seamless inline expansion, smooth motion physics, and high-performance WebGL rendering.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eFeatures\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eReal-time inline text expansion on hover\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePremium WebGL-powered image rendering\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSmooth damped motion physics\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eDynamic image aspect ratio preservation\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eHighly optimized Three.js performance\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eResponsive resize and layout handling\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eClean layered visual architecture\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eWorks perfectly for bold typography and portfolios\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCustomizable sizing, spacing, and motion feel\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eCustomization Options\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eText content and typography\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eText and background colors\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eImage collection array\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eBase image size\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eImage gap padding\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCorner radius\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAppear and hover duration\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eMotion smoothness damping\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSpawn distance gap\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eEditor preview toggle\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eHow to Use\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eDrop the component onto your Framer canvas\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eType your custom text and style the typography\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eUpload your preferred image collection\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCustomize image sizing, padding, and corner radius\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eTune the hover time and motion smoothness\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePublish for a premium interactive media reveal effect\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eUse Cases\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003ePremium portfolio headers\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eInteractive agency websites\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCreative team rosters\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eProject showcase links\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eDynamic menu typography\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePhotography galleries\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eModern landing pages\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eE-commerce category reveals\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e95:T6b7,\u003cp\u003e\u003cstrong\u003eBring Your Layouts to Life with Kinetic Metal Flow\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eAdd an impactful aesthetic to your Framer website. Kinetic Metal Flow captures the heavy, hypnotic ripple of molten chrome and illuminated liquid metal, bringing a living art-installation feeling directly to your canvas.\u003c/p\u003e\u003cp\u003eWhether you want an ambient background or a bold, high-contrast focal point, this component offers a highly immersive experience.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eWhat it does\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eSharp on Retina: Automatically scales to match high-DPI and Retina displays so the metallic highlights never look pixelated or blurry.\u003c/p\u003e\u003cp\u003eLayer Friendly: Built with alpha-channel transparency and click-through disabled (pointer-events: none), meaning you can stack it seamlessly over background gradients, grids, or behind text.\u003c/p\u003e\u003cp\u003eProper Cleanup: Safely purges its own WebGL memory buffers when unmounted, preventing memory leaks or browser lag over long sessions.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eControls\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eAdjust the animation look directly from the Framer sidebar:\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eFlow Speed: \u003c/strong\u003eChanges how fast the liquid moves (from a slow, heavy crawl to a quicker ripple).\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eWave Density:\u003c/strong\u003e Controls the frequency of the shapes (broad, sweeping sheets vs. tight, detailed waves).\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eContrast Power:\u003c/strong\u003e Adjusts the balance between the bright chrome highlights and the dark background shadows. \u003c/p\u003e\u003cp\u003e\u003cstrong\u003ePerfect For:\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eHigh-end tech, AI engineering, and developer landing pages.\u003c/p\u003e\u003cp\u003eSleek dark-mode portfolios and creative agency homepages.\u003c/p\u003e\u003cp\u003eImmersive digital artwork grids and premium hero sections.\u003c/p\u003e\u003cp\u003eModern fashion, architecture, and luxury product showcases.\u003c/p\u003e96:T7b0,\u003ch2\u003eBad Handwriting Component\u003c/h2\u003e\u003cp\u003eTransform your text into authentic messy handwriting by randomly mixing different handwriting fonts for each character. Unlike traditional text that uses a single font, this component creates a chaotic, natural look by applying one of five handwriting fonts to every letter.\u003c/p\u003e\u003ch3\u003eHow It Works\u003c/h3\u003e\u003cp\u003eThe component wraps each character in your text with a randomly selected handwriting font from a curated collection: Caveat, Indie Flower, Nothing You Could Do, Reenie Beanie, and Shadows Into Light. Smart logic ensures the same letter never uses the same font twice in a row, creating maximum visual variation and preventing any repetitive patterns.\u003c/p\u003e\u003cp\u003eThe Pattern control uses a seeded random number generator, which means each pattern number produces a unique but consistent result.\u003c/p\u003e\u003ch3\u003eBest For\u003c/h3\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eHandwritten-style\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCasual, playful headlines\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSticky note effects\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePersonal touches on landing pages\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eHuman-feeling UI elements\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCreative typography experiments\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch3\u003eKey Features\u003c/h3\u003e\u003cp\u003e\u003cstrong\u003eFull Customization:\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eAdjust font size, color, letter spacing, and line height\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eControl text alignment (left, center, right)\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eVariable font weight (400-700, affects Caveat font only)\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eResponsive text wrapping—resize the component and text reflows naturally\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003ePattern Control:\u003c/strong\u003e Simply change the Pattern number (1-10,000) to generate completely different random variations. Each number creates a unique but repeatable pattern, so you can explore options and lock in your favorite.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003ePerformance Optimized:\u003c/strong\u003e All five handwriting fonts are loaded from Google Fonts and cached by the browser for fast rendering.\u003c/p\u003e\u003ch3\u003eFor design work, questions, or help, please reach out at\u003c/h3\u003e\u003ch3\u003ehttps://www.fireislanddesign.com/\u003c/h3\u003e97:T9e7,\u003cp\u003e\u003cstrong\u003eA premium video carousel designed to showcase short-form content in a smooth, continuously drifting reel-style layout.\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eReel Video Carousel transforms video content into an engaging horizontal rail where cards continuously drift across the screen. Users can interact with the carousel using drag and mouse wheel controls, while videos automatically play near the centre for a dynamic, immersive browsing experience.\u003c/p\u003e\u003ch2\u003eFeatures\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eReel-style video carousel\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eContinuous horizontal drifting\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSmooth infinite looping\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eUpload videos directly in Framer\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eVideo URL support\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCustom poster images\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eMultiple aspect ratios\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e9:16, 3:4, 4:5, 1:1, and 16:9 formats\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCover or fit video display\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCentre-focused video playback\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eOptional playback for all cards\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eLooping video support\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eMuted autoplay\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCustom sound controls\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eIndividual card borders and radius\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAdjustable card width and spacing\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eDrag and momentum interaction\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eMouse wheel navigation\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAdjustable drift speed\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eDirection control\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eHover speed adjustment\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCentre focus scaling\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eEdge fading effects\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCustom resting opacity\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSmooth responsive layout\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eReduced-motion support\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFully customizable in Framer\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2\u003ePerfect For\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eSaaS websites\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eStartup landing pages\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCreative agencies\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eDesign studios\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePortfolio websites\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eProduct websites\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSocial media websites\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eMarketing pages\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCreator websites\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eModern business websites\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2\u003eWhy You\u0026#39;ll Love It\u003c/h2\u003e\u003cp\u003eReel Video Carousel gives your video content a more dynamic and immersive presentation. Instead of a standard video grid or static carousel, the continuously drifting rail creates a smooth reel-style browsing experience that naturally draws attention to each clip.\u003c/p\u003e\u003cp\u003eAdd videos, posters, aspect ratios, spacing, playback settings, colors, and interaction controls directly through Framer Property Controls. Drag gestures, mouse wheel navigation, momentum, centre-focused playback, and smooth visual effects make the carousel feel polished across desktop and mobile.\u003c/p\u003e98:T8b4,\u003ch3\u003eUse Cases\u003c/h3\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eBrand \u0026amp; Client Showcases:\u003c/strong\u003e Display brands, clients, partners, sponsors, or technologies in a continuously rotating list.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eProject Highlights:\u003c/strong\u003e Showcase featured projects, case studies, products, or collections with an engaging curved layout.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eTeam \u0026amp; Member Directories:\u003c/strong\u003e Present team members, contributors, speakers, or creators in a unique interactive format.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eCategory Navigation:\u003c/strong\u003e Organize services, industries, skills, tags, or content categories in a visually dynamic wheel.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eArtist \u0026amp; Creator Collections:\u003c/strong\u003e Perfect for musicians, designers, agencies, and creative portfolios looking to showcase names and work with style.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch3\u003eFeatures\u003c/h3\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eInfinite Text Wheel:\u003c/strong\u003e Smoothly cycles through unlimited text items in a continuous loop.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eFully Customizable Typography:\u003c/strong\u003e Control fonts, colors, and text styling directly from the Framer properties panel.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eAdjustable Curvature:\u003c/strong\u003e Customize the wheel radius to create anything from subtle curves to dramatic circular layouts.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eCustom Icon Support:\u003c/strong\u003e Replace the default arrow with any custom icon component to match your design system.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003ePhysics-Based Motion:\u003c/strong\u003e Spring-powered animations provide smooth, natural interactions and transitions.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eAdvanced Layout Controls:\u003c/strong\u003e Fine-tune arrow size, spacing, offsets, row gaps, and positioning without writing code.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eResponsive Design:\u003c/strong\u003e Adapts seamlessly across screen sizes while maintaining visual balance and readability.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003ePerformance Optimized:\u003c/strong\u003e Lightweight and efficient for smooth rendering and interactions.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eDesigner-Friendly Workflow:\u003c/strong\u003e Every setting is accessible through Framer\u0026#39;s visual interface.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eProduction Ready:\u003c/strong\u003e Ideal for portfolios, agencies, SaaS products, directories, brand showcases, team pages, and modern landing pages.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e99:T507,\u003cp\u003eFramer Handwriting Effect (which can be used with any font you want) is designed for moments where you want a handwriting effect for your text, not a typical typewriting effect or fade or slide. A handwriting effect is a creative alternative to a typewriter effect or a typing effect animation. The stroke reveal simulates writing in real-time, with alignment, direction, duration, and loop options so it fits hero sections, landing page headers, and product UI callouts with a handwritten effect.\u003c/p\u003e\u003ch3\u003eWhere You Can Use It\u003c/h3\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eHero header text and hero section headings\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFeature callouts, CTAs, and product UI labels\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePortfolio intros and case study titles\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eOnboarding screens and loading states\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eLanding pages that need subtle motion, not noise\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAnywhere else you could use a unique handwritten effect\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch3\u003eFeatures\u003c/h3\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eCustomizable font family (choose any font)\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eText content editor\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCustomizable color\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eText alignment options\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eWrite direction control (left to right/LTR or right to left/RTL)\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eDuration control\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eLoop toggle\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eOn appear trigger (start when visible)\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e9a:T1106,\u003cp\u003eYou know that moment - you're scrolling an award-winning site and suddenly images start trailing your cursor like magic. It feels alive, tactile, and impossibly cool. That effect lives on Awwwards-winning sites. Now you can add it to yours in minutes.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eInstructions\u003c/strong\u003e\u003c/p\u003e\u003col\u003e\u003cli\u003e\u003cp\u003eDrop the \u003cstrong\u003eImage Cursor Trail\u003c/strong\u003e component into the section where you want the effect\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSet the component's position to \u003cstrong\u003eAbsolute\u003c/strong\u003e in the right-hand panel\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePin all four edges - Top, Bottom, Left, Right to \u003cstrong\u003e0\u003c/strong\u003e so it expands to fill the full section\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAdd your own images from the \u003cstrong\u003eImages panel\u003c/strong\u003e on the right.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAdjust the controls to match your vibe and you're done\u003c/p\u003e\u003c/li\u003e\u003c/ol\u003e\u003cp\u003e\u003cstrong\u003eHow It Works\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eThe panel has two layers of controls — core settings visible by default, and advanced settings unlocked via the \u003cstrong\u003eAdvanced\u003c/strong\u003e toggle:\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eImages\u003c/strong\u003e: Add your own photos; demo images are used automatically until you do\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eBackground\u003c/strong\u003e: Optional background color for the trail container\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eImage Size\u003c/strong\u003e: Set width and height of each trail image independently\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eCorner Radius\u003c/strong\u003e: Round the image corners from sharp to fully circular\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eImage Fit\u003c/strong\u003e: Choose Cover, Contain, or Fill for how images crop\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eMax Tilt\u003c/strong\u003e: Controls how much each image randomly rotates as it appears\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eTrail Length\u003c/strong\u003e: How many images can be visible on screen at once\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eLifespan\u003c/strong\u003e: How long each image stays before it exits\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eAnimate In / Animate Out\u003c/strong\u003e: Full Framer transition control - use tween, spring, or custom easing\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eAdvanced → Spawn Distance\u003c/strong\u003e: How far the cursor must travel before a new image appears\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eAdvanced → Scroll Rate\u003c/strong\u003e: Spawn rate while the user is scrolling\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eAdvanced → Idle Rate\u003c/strong\u003e: How often images spawn when the cursor is stationary\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eAdvanced → Removal Delay\u003c/strong\u003e: Stagger timing between consecutive image removals\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eFeatures\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eZero-config out of the box: 26 demo images built in, works immediately\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eBring your own images: swap demo images with your own from the panel\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFull Framer transition support: spring, tween, custom cubic-bezier on both enter and exit\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eOverflow-aware: trail renders outside the component boundary, nothing gets clipped\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eScroll-reactive: images spawn while scrolling, not just on mouse move\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eIdle spawning: keeps the trail alive even when the cursor is still\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCanvas-safe: shows a clean placeholder in the Framer editor, animates only in Preview and live\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eResponsive: works at any frame size, just pin to fill your section\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eLightweight: no external dependencies beyond Framer Motion (already in Framer)\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAdvanced controls hidden by default: clean panel for most users, full power for tinkerers\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eUse Cases\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eHero sections on agency and portfolio sites\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFull-page image galleries with interactive browsing\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCreative studios and photographer websites\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eProduct landing pages with visual storytelling\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\"About\" or team sections that make people linger\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAny section where you want to reward exploration with delight\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eMade with ❤️ by \u003c/strong\u003e\u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://framer.link/market\"\u003e\u003cstrong\u003eSoyeb\u003c/strong\u003e\u003c/a\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eRefund Policy: \u003c/strong\u003eDue to the digital nature of these components, all sales are final, and once delivered they cannot be returned, exchanged or refunded. Please review product details and demos before purchasing, and feel free to reach out if anything is unclear.\u003c/p\u003e\u003cp\u003eHave questions or need a custom Framer component? Reach out at \u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"mailto:heysoyebali@gmail.com\"\u003eheysoyebali@gmail.com\u003c/a\u003e\u003c/p\u003e9b:T8d7,\u003cp\u003e\u003cstrong\u003ePricing Plans Pro\u003c/strong\u003e is a polished, interactive pricing picker for SaaS and tiered products. It combines an animated billing toggle, expandable feature drawer, and live user-based pricing in one connected interface. Visitors can compare plans without leaving the page, while the component adapts seamlessly from mobile to desktop.\u003c/p\u003e\u003ch2\u003eKey Features\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eVertical or Horizontal layout with automatic frame resizing\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAnimated Monthly/Yearly toggle with customizable discount badge\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eUp to 8 plans with names, descriptions, monthly/yearly prices, and features\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eLive price calculation based on user/seat count with smooth animations\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eConfigurable user counter with +/- controls, starting value, and label\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e12 currencies via native \u003ccode\u003eIntl.NumberFormat\u003c/code\u003e: USD, EUR, GBP, JPY, CAD, AUD, CHF, CNY, INR, BRL, MXN, SGD\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFeature separators using newlines or \u003ccode\u003e|\u003c/code\u003e\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eOptional custom user and feature icons\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAnimated feature drawer with sequential slide-up effects\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eResponsive CTA with hover and tap animations\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e9 editable font controls and extensive color customization\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eContainer-based responsiveness using ResizeObserver, with compact mode below 380px\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e3 pre-loaded plans: Plus, Standard, Advanced\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eWorks on both Framer Canvas and published sites\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2\u003eWhere to Use\u003c/h2\u003e\u003cp\u003eIdeal for SaaS pricing, per-seat subscriptions, storage and infrastructure tiers, bootcamps, memberships, communities, APIs, and developer tools.\u003c/p\u003e\u003ch2\u003eBest For\u003c/h2\u003e\u003cp\u003eTeams selling tiered products with per-user pricing, designers needing one responsive component, and Framer users who want complete visual control without coding.\u003c/p\u003e\u003ch2\u003eWhy This Component\u003c/h2\u003e\u003cp\u003eUnlike static three-column pricing grids or stepper modals, \u003cstrong\u003ePricing Plans Pro\u003c/strong\u003e keeps everything connected. The active plan reveals its features, pricing updates instantly as seats change, and the same component switches between mobile-stacked and desktop-horizontal layouts through a single property.\u003c/p\u003e\u003cp\u003eBuilt for Framer. Drop it onto your canvas, customize it, and publish.\u003c/p\u003e9c:T667,\u003cp\u003eMotion Gallery is an interactive, scroll-driven image carousel designed to showcase visual work with clarity and depth. Instead of relying on static layouts, it introduces continuous motion, smooth physics, and optional sound feedback to create a more engaging browsing experience. Built for modern portfolios and case studies, it transforms simple image galleries into fluid, responsive interfaces that feel intentional and alive.\u003c/p\u003e\u003cp\u003e⸻\u003c/p\u003e\u003ch3\u003eKey Features\u003c/h3\u003e\u003cfigure\u003e\u003cimg src=\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/components/description-image-2p7wbvr5-21FFLJKxTblZqYlaDdnquW2SI0fsBA\" alt=\"\"\u003e\u003c/figure\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eInfinite scrolling system with seamless looping in both directions\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003ePhysics-based motion using smooth spring animations\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eOptional auto-centering for clean and precise alignment\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eVelocity-based sound feedback with multiple sound styles\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eHorizontal and vertical orientations\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eAdjustable spacing, sizing, and visual styling\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eBuilt-in indicators for navigation (optional)\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eUp to 10 images with dynamic handling\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e⸻\u003c/p\u003e\u003ch3\u003eCompatibility\u003c/h3\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eFully usable inside CMS project pages\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eSupports image-based content structures\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eWorks across desktop and mobile\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eDesigned to integrate into portfolios, case studies, and product showcases\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e⸻\u003c/p\u003e\u003cp\u003eA flexible gallery component that adds motion and interaction without adding complexity.\u003c/p\u003e9d:T5b3,\u003ch2\u003eOverview\u003c/h2\u003e\u003cp\u003eA text-style call-to-action with a smooth arrow shift interaction on hover. Built for clarity and subtle motion, making it ideal for modern interfaces that prioritise simplicity and precision.\u003c/p\u003e\u003ch2\u003eGetting Started\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eCopy and paste the component into your Framer canvas.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSelect the component and edit the CTA label from the right panel.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eModify text colour, underline, and arrow styling as needed.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eHover over the link in preview to see the arrow movement.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2\u003eControls\u003c/h2\u003e\u003cfigure\u003e\u003cimg src=\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/components/description-image-uwekuecr-ZmzvmDpKvST0O3ekTQw4W43okfx1LT\" alt=\"\"\u003e\u003c/figure\u003e\u003ch2\u003eUse Cases\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003ePortfolio navigation links\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e“View more” or “Explore” actions\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eBlog or CMS listings\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSection-level CTAs\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eMinimal interface designs\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2\u003eNotes\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eBuilt using native Framer properties\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAdapts to text length automatically\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eMaintains consistent spacing and alignment\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eDesigned for lightweight interactions\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2\u003eSupport\u003c/h2\u003e\u003cp\u003eIf you have any questions, need clarification, or run into any issues, feel free to reach out at\u003c/p\u003e\u003cp\u003e\u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"mailto:s.senthil2206@gmail.com\"\u003e\u003cstrong\u003es.senthil2206@gmail.com\u003c/strong\u003e\u003c/a\u003e\u003c/p\u003e9e:T65b,\u003ch2\u003eAbout\u003c/h2\u003e\u003cp\u003ePill Dropdown Nav is a responsive floating navigation with a smooth sliding hover highlight and fluid dropdown panels on desktop. On mobile, it transforms into a compact hamburger menu with expandable accordion sections, keeping the complete experience inside one component.\u003c/p\u003e\u003ch2\u003eWhat you can customize\u003c/h2\u003e\u003cp\u003eBuilt entirely with native Framer elements and customizable directly from the properties panel. Edit all 21 link labels, destinations, new-tab settings, and visibility controls, while colors, typography, spacing, and radius stay synchronized across desktop and mobile.\u003c/p\u003e\u003ch2\u003eGreat for (examples)\u003c/h2\u003e\u003cp\u003eJust a few ideas, use it anywhere you need a polished navigation for larger link structures:\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eSaaS websites\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eProduct websites\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eStartup websites\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSoftware platforms\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCreative agencies\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eDesign studios\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePortfolio websites\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAI products\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eMarketing websites\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eModern landing pages\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eDocumentation hubs\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePremium Framer templates\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2\u003eShare your build\u003c/h2\u003e\u003cp\u003eIf you ship something cool with it, post it on X and tag me \u003ca href=\"https://x.com/Matthias_Oel\" rel=\"noopener noreferrer nofollow\" target=\"_blank\"\u003e@Matthias_Oel\u003c/a\u003e, or send it over. I’d love to see what you create.\u003c/p\u003e\u003ch2\u003eNeed help?\u003c/h2\u003e\u003cp\u003eQuestions or feedback? Reach me anytime: \u003ca href=\"mailto:matthias@lmvision.de\"\u003ematthias@lmvision.de\u003c/a\u003e or on X \u003ca href=\"https://x.com/Matthias_Oel\" rel=\"noopener noreferrer nofollow\" target=\"_blank\"\u003e@Matthias_Oel.\u003c/a\u003e\u003c/p\u003e9f:T968,\u003cp\u003e\u003cstrong\u003eA premium postcard-inspired testimonial component designed to showcase customer stories as beautifully crafted mail cards.\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eTestimonial Stamp transforms customer feedback into an elegant collection of vintage-inspired testimonial postcards. Each card combines customer quotes, author details, stamp portraits, postmarks, signature marks, address lines, company logos, and subtle card rotations for a tactile editorial feel.\u003c/p\u003e\u003ch2\u003eFeatures\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003ePostcard-inspired testimonial cards\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCustomer quotes and author details\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eStamp-style customer portraits\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eDecorative postmarks\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSignature squiggles or rules\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAddress-style decorative lines\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCompany logo support\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAutomatic light and dark text contrast\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCustom card colors\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAdjustable card size, radius, padding, and overlap\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eHover lift and scale interactions\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eStaggered entrance animations\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eMultiple entrance styles\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCentre-out, edge-in, and directional animation orders\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eResponsive horizontal scrolling\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eDrag and touch-friendly browsing\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eKeyboard accessible interactions\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eReduced-motion support\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFully customizable in Framer\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2\u003ePerfect For\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eSaaS websites\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eStartup landing pages\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCreative agencies\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eDesign studios\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePortfolio websites\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePersonal brands\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eProduct websites\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eMarketing pages\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eConsultancy websites\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eProfessional services\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2\u003eWhy You\u0026#39;ll Love It\u003c/h2\u003e\u003cp\u003eTestimonial Stamp gives traditional social proof a distinctive editorial character. Instead of presenting testimonials as standard cards or sliders, each customer story feels like a carefully designed postcard, complete with stamps, postmarks, paper colors, handwritten-inspired marks, and mailing details.\u003c/p\u003e\u003cp\u003eCustomize every postcard directly through Framer Property Controls, including customer information, portraits, logos, colors, typography, card layouts, hover effects, and entrance animations. The layered overlapping layout and subtle interactions create a premium visual experience while keeping customer stories easy to explore.\u003c/p\u003ea0:T9a4,\u003cp\u003e\u003cstrong\u003eMORE FRAMER COMPONENTS LIKE THIS\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e✦ Browse +38 FREE + 85 premium components: \u003c/strong\u003e\u003ca href=\"https://frameze.com/components\" rel=\"noopener noreferrer nofollow\" target=\"_blank\"\u003e\u003cstrong\u003ehttps://frameze.com/components\u003c/strong\u003e\u003c/a\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e✦ Background Bundle: \u003c/strong\u003e\u003ca href=\"https://frameze.com/components/category/background?ref=bundles\" rel=\"noopener noreferrer nofollow\" target=\"_blank\"\u003e\u003cstrong\u003ehttps://frameze.com/components/category/background?ref=bundles\u003c/strong\u003e\u003c/a\u003e\u003c/p\u003e\u003ch2\u003e\u003cstrong\u003eAbout Soft Background\u003c/strong\u003e\u003c/h2\u003e\u003cp\u003eSoft Background is a fully customizable animated background component for Framer. Smooth, blurred color orbs drift slowly across the canvas, creating a living mesh-gradient effect without any external dependencies.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eFeatures\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e10 color presets: Aurora, Blush, Mint, Dusk, Peach, Slate, Midnight, Ember, Forest, Noir\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCustom color mode (base + 3 orb colors)\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eMouse parallax with adjustable strength\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eNoise texture overlay with soft-light blending\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eRadial vignette effect\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFill Container mode — drops into any Framer frame at 100% size\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eResponsive demo panel with live preset switching, orb count, speed, and FX controls\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePrefers-reduced-motion support for accessibility compliance\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eUp to 5 independent animated orbs with unique drift paths\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eControls for blur, opacity, speed, and orb count\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eLive Preview: \u003c/strong\u003e\u003ca href=\"https://softbackground.framer.website/\" rel=\"noopener noreferrer nofollow\" target=\"_blank\"\u003e\u003cstrong\u003ehttps://softbackground.framer.website/\u003c/strong\u003e\u003c/a\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003ePerfect for\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eLanding pages\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eHero sections\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePortfolio backgrounds\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSaaS dashboards\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eApp loading screens, and any design that needs ambient depth without heavy assets.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003eNo images, no external fonts, no dependencies beyond Framer\u0026#39;s built-in Motion library.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eKeywords\u003c/strong\u003e\u003c/p\u003e\u003cp\u003esoft background, animated background, gradient background, mesh gradient, framer background component, dark mode background, parallax background, blob animation, color orbs, soft gradient, hero background, landing page background, aurora gradient, framer motion background, animated hero, ambient background, living gradient\u003c/p\u003ea1:T8d4,\u003cp\u003eThis Component is built for Visual first Content to create dynamic Bentos, Grids and layouts without the complexity of manual development. Fully built with Workshop\u003c/p\u003e\u003cp\u003eCreating dynamic grids can be overwhelming, this is why I've created this component. This means you can create which ever grid  design you want by using a visual first approach\u003c/p\u003e\u003ch2\u003eHere is what you get:\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eAn Image Focused Grid Component\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eColumns \u0026amp; Rows Customization\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eLightbox support to preview your images in a focused lightbox on click\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFull style customization (Radius, Overlay, Border, hover etc)\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eThe Span feature (Create dynamic Compositions with Span for columns and rows)\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFully responsive for mobile\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAd much more\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2\u003eWho this Component is for;\u003c/h2\u003e\u003cp\u003eThis Component has been specifically built for Visual first content, meaning focus is on imagery, artwork, visuals than text content\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eSo it's perfect for;\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eGallary showcases\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eVisual first work\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCreative Studios/Portfolios\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePhotography Work\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eUI Work\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003eOne of the most powerful features it has is to create Spannning layouts. Lets see it in action\u003c/p\u003e\u003cp\u003eYou can see that we can target individual image cards in the bento and span them across columns or rows in the grid to create emphasis, dynamic and creative layouts. This is one of the top powers for this component\u003c/p\u003e\u003cfigure\u003e\u003cimg src=\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/components/description-image-rfx5nlmf-GpqDg8MQlNBGJQjg11ThdgwNUlZXjd\" alt=\"\"\u003e\u003c/figure\u003e\u003ch2\u003eLight box Feature\u003c/h2\u003e\u003cp\u003eYou can enable the lightbox functionality as well for users to view your work in a focused model... Full keyboard navigation is supported too for users to nagivate images without the need to close the light box\u003c/p\u003e\u003cfigure\u003e\u003cimg src=\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/components/description-image-rfx5nlmf-VV0GH4ZkVDmmI5MN98AWxi4HHWsqwr\" alt=\"\"\u003e\u003c/figure\u003e\u003cp\u003eAlright, I guess the best way is to try it out and see it in action for yourself as I can't explain everything...\u003c/p\u003e\u003cp\u003eGrab it now for yourself, it's 100% free. \u003c/p\u003ea2:T7bf,\u003ch2\u003eAdd Premium Components To Your Projects:\u003c/h2\u003e\u003cfigure\u003e\u003ca href=\"https://marketplace.framer.com/@saadat-ali-designsbysadat/\" target=\"_blank\" rel=\"noopener noreferrer nofollow\"\u003e\u003cimg src=\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/components/description-image-g094t2v1-8wrj2R4JsfS8dz3uRkUmPxMk3a0JAx\" alt=\"\" /\u003e\u003c/a\u003e\u003c/figure\u003e\u003cfigure\u003e\u003ca href=\"https://www.framer.com/marketplace/components/liquid-glass-logo/\" target=\"_blank\" rel=\"noopener noreferrer nofollow\"\u003e\u003cimg src=\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/components/description-image-ectn8thw-7b1PJqGkGxVCbwcjGww89DIM89TglR\" alt=\"\" /\u003e\u003c/a\u003e\u003c/figure\u003e\u003cp\u003e\u003cstrong\u003eKey Features\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eScroll-driven animation (no manual triggers needed)\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSmooth spring motion for natural movement\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFully responsive with automatic scaling\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSupports unlimited cards\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eOptional image mode (image fills card, hides text)\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCustomizable colors and text styles\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAdjustable initial stack angle\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eClean center alignment with mathematically correct positioning\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eCustomization Options\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eCard width and height\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eBackground color\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eInitial rotation angle\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCard list (color, text color, or image per card)\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePreview state for canvas testing\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eHow It Works\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eCards are anchored at the center and rotate around their bottom-left corner\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eScroll progress drives rotation from stacked → full circle\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eA hidden scroll layer controls animation smoothly\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eLayout auto-adjusts to fit any screen size\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eUse Cases\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eFeature showcases\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eProduct highlights\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePortfolio presentations\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eInteractive storytelling sections\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eLanding page hero interactions\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003ea3:T708,\u003cp\u003eThe Pro Text Type Effect component brings dynamic storytelling to your Framer projects with a highly customizable typewriter animation.\u003c/p\u003e\u003ch2\u003e✨ Features:\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eTypewriter-style text animation with customizable typing \u0026amp; deleting speeds.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSupports single or multiple text strings with cycling through sentences.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eLoop mode on/off — stop on last sentence when disabled.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAdjustable initial delay and pause duration between sentences.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eOptional variable typing speed for natural, human-like typing rhythm.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eStart animation only when visible in viewport (scroll-triggered).\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eReverse text animation mode for text mirror effect.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eMulti-color text cycling — supports Framer project color styles (tokens).\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFull font customization with font family, weight, size, and line-height control.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eShow/hide cursor toggle.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCursor mode: Preset shapes (|, _, ❚, ▋, ▌, █, etc.) or custom character(s).\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCursor color mode: Match first text color or pick a custom color.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCursor blink speed control.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eOption to hide cursor while typing.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAutomatic font size \u0026amp; style matching between text and cursor.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFully responsive with\u0026nbsp;\u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://developer.mozilla.org/en-US/docs/Web/CSS/clamp\"\u003eCSS clamp()\u003c/a\u003e\u0026nbsp;property support.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003ePro Text Type Effect is designed for maximum flexibility.\u003c/strong\u003e\u0026nbsp;Whether you’re building a sleek modern portfolio or a bold marketing page, you can fine-tune every detail — from font styling and cursor behavior to custom cursors — without touching code.\u003c/p\u003ea4:T736,\u003cp\u003eStudioShowcase Stack is a minimal, studio-style stacked carousel built for showcasing work. Use images or videos per card, with optional mute control and global video looping for smooth previews. Tune the look with shadow strength and background-card clarity to match any brand. Ideal for case study highlights, agency homepages, and curated project galleries.\u003c/p\u003e\u003cp\u003e Key Features\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eInteractive card stack: Cards fan out and overlap like a deck; click any card to bring it forward\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSmooth, natural animations: Cards glide into place with a soft, bouncy motion\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eImages or videos, your choice: Mix and match per card, upload your own files or paste a link\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eVideo sound control: Built-in mute/unmute button on each video card\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eLooks great on any screen: Automatically resizes and adjusts spacing for mobile, tablet, and desktop\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePick your starting card: Choose whether the stack opens on the left, center, or right card\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFully customizable style: Change corner roundness, borders, shadow depth, and overlay darkness: all with simple sliders and color pickers, no code needed\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAdd up to 12 cards: Perfect for portfolios, project showcases, or featured work\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003c/p\u003e\u003cfigure data-youtube-url=\"https://youtu.be/198K98cfjB8\"\u003e\u003ciframe src=\"https://www.youtube.com/embed/198K98cfjB8?color=white\u0026amp;autoplay=0\u0026amp;controls=1\u0026amp;rel=0\" title=\"YouTube video player\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" referrerpolicy=\"strict-origin-when-cross-origin\" width=\"700\" height=\"395\" frameborder=\"0\"\u003e\u003c/iframe\u003e\u003c/figure\u003e\u003cfigure\u003e\u003cimg src=\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/components/description-image-39g3bg1z-TG0kcRuH8iyyBgh9bOhcK2jkEYKJZJ\" alt=\"\" /\u003e\u003c/figure\u003ea5:T89e,\u003cp\u003e\u003cstrong\u003eMORE FRAMER COMPONENTS LIKE THIS\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e✦ Browse +38 FREE + 85 premium components: \u003c/strong\u003e\u003ca href=\"https://frameze.com/components\" rel=\"noopener noreferrer nofollow\" target=\"_blank\"\u003e\u003cstrong\u003ehttps://frameze.com/components\u003c/strong\u003e\u003c/a\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e✦ Background Bundle: \u003c/strong\u003e\u003ca href=\"https://frameze.com/components/category/background?ref=bundles\" rel=\"noopener noreferrer nofollow\" target=\"_blank\"\u003e\u003cstrong\u003ehttps://frameze.com/components/category/background?ref=bundles\u003c/strong\u003e\u003c/a\u003e\u003c/p\u003e\u003ch2\u003e\u003cstrong\u003eAbout Aura Cursor\u003c/strong\u003e\u003c/h2\u003e\u003cp\u003eAuraCursor is an ambient, cursor-reactive glow effect component for Framer. A soft plasma-like aura trails behind the mouse pointer, blending vivid color streaks against a dark canvas to create a living, atmospheric background layer. Built to add a premium, cinematic touch to hero sections and full-page backgrounds without any external assets.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eFeatures\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eCursor-reactive aura trail that follows mouse movement in real time\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSmooth, organic trailing motion with soft glow and color blending\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCustomizable color palette for the aura\u0026#39;s core and trailing streaks\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAdjustable glow intensity and fade speed\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eWorks as a full-bleed background layer — drops into any Framer frame at 100% size\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eLightweight, GPU-friendly rendering with no external dependencies\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFully responsive — scales cleanly across desktop and tablet\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eWorks out of the box — no setup needed\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eUse Cases\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eLanding page and hero section backgrounds\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePortfolio and personal branding sites\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCreative agency and studio pages\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSaaS and product launch pages\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eMusic, art and creative showcase sites\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eEvent and conference landing pages\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eKeywords\u003c/strong\u003e \u003c/p\u003e\u003cp\u003eaura cursor, cursor trail effect, mouse trail animation, cursor glow framer, ambient background effect, interactive cursor effect, plasma glow background, framer cursor animation, glow trail effect, animated background framer\u003c/p\u003ea6:T4f2,\u003cp\u003e\u003cstrong\u003eGlassy Button Component\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eA modern, glass-style button for Framer with smooth hover and pressed states. Features fully editable icon color and stroke width for quick customization. The subtle frosted background and soft shadows make it great for minimal, high-end interfaces.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eKey Features:\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eGlassy, frosted look with depth and subtle shine\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eInteractive hover and pressed states\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAdjustable icon color and stroke width\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eWorks with any icon from your library\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eIdeal for dashboards, navigation, and modern UIs\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e** The component uses the \u003cstrong\u003eIconic\u003c/strong\u003e icon set, you need to add that vector set to your file to be able to swap icons on the component variable. See here: \u003c/p\u003e\u003cfigure data-youtube-url=\"https://youtu.be/PfLEApuYwXQ\"\u003e\u003ciframe src=\"https://www.youtube.com/embed/PfLEApuYwXQ?color=white\u0026amp;autoplay=0\u0026amp;controls=1\u0026amp;rel=0\" start=\"0\" width=\"700\" height=\"395\" data-youtube-url=\"https://youtu.be/PfLEApuYwXQ\" title=\"YouTube video player\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" referrerpolicy=\"strict-origin-when-cross-origin\" frameborder=\"0\"\u003e\u003c/iframe\u003e\u003c/figure\u003ea7:T885,\u003ch2\u003eFeatures\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eRealistic liquid glass shader effects\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eInteractive 3D logo rendering with Three.js\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eUpload custom SVG logos instantly\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePremium refraction and chromatic dispersion\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFrosted blur glass rendering\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eMouse tracking and drag rotation controls\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFloating idle animation support\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eOptional auto-rotation motion\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eDynamic environment reflections\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFully customizable glass appearance\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eHigh-performance optimized WebGL rendering\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eResponsive scaling and ultra-HD visuals\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2\u003eCustomization Options\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eUpload custom SVG logos\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSwitch between SVG, Torus, Sphere, or X shapes\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAdjust 3D extrusion depth\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eControl bevel edge softness\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCustomize glass tint color\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFine-tune refraction intensity\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAdjust dispersion and chromatic aberration\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eControl frost blur strength\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eEnable or disable floating motion\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eToggle mouse tracking interaction\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eEnable drag rotation or auto-rotation\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAdd custom background images for reflections\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2\u003eHow to Use\u003c/h2\u003e\u003col\u003e\u003cli\u003e\u003cp\u003eAdd the component to your Framer project\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eUpload your custom SVG logo or choose a preset shape\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAdjust extrusion depth and bevel styling\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCustomize glass tint and refraction settings\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eUpload a background image for realistic reflections\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eEnable mouse tracking, drag rotate, or auto-spin effects\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePublish stunning liquid glass logo animations instantly\u003c/p\u003e\u003c/li\u003e\u003c/ol\u003e\u003ch2\u003eUse Cases\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eSaaS brand hero sections\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eStartup landing pages\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eInteractive logo showcases\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCreative agency websites\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePortfolio intros\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAI product branding\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eModern WebGL experiences\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePremium marketing pages\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e3D visual identity presentations\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eHigh-end glassmorphism interfaces\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003ea8:T459,\u003cp\u003e\u003cstrong\u003eMinimalist Filterable Gallery (Free Code Component)\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eEnhance your Framer site with this production-grade gallery. No coding required.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eKey Features:\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eZero-CMS Setup\u003c/strong\u003e: No need for Framer Collections. Manage everything directly inside the component.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eLightweight \u0026amp; Efficient\u003c/strong\u003e: Perfect for small to medium sets (5-20 items).\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eZero-Code Styling\u003c/strong\u003e: Manage images, titles, and categories via the properties panel.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eAuto-Filter Tabs\u003c/strong\u003e: Category buttons are generated automatically from your content.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003ePremium Animations\u003c/strong\u003e: Smooth, scroll-triggered staggered reveal for cards and tabs.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eBuilt-in Lightbox\u003c/strong\u003e: Click any image to view it full-screen with spring physics.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eResponsive Design\u003c/strong\u003e: Fully adaptable grid for Desktop, Tablet, and Mobile.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eCustomizable Styling\u003c/strong\u003e: Control fonts, colors, gaps, and aspect ratios easily.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003ea9:T9ee,\u003cp\u003eAn infinite scrolling grid background with a mouse-follow spotlight that reveals a brighter grid layer beneath the cursor. Dual-layer grid system, 8-directional animation, three gradient blobs, and full opacity and speed controls. Built for hero sections, portfolio headers, dashboard backgrounds, and any landing page that needs an interactive animated background.\u003c/p\u003e\u003ch2\u003eFeatures\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eDual-layer grid system — subtle base layer plus bright mouse reveal layer\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eMouse-follow radial spotlight reveals high-opacity grid around cursor\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eConfigurable reveal radius (100–800px)\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e8-directional animation — right, left, up, down and four diagonals\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eIndependent X and Y speed controls (−5 to 5)\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSeamless infinite loop via 40px modulo offset\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eThree gradient blob overlays with individual color controls\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eToggle gradient blobs on or off\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eBackground color and grid line color controls\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eBase layer and reveal layer opacity controls independently\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSVG-based grid pattern for crisp rendering at any scale\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003euseAnimationFrame for smooth 60fps animation\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eNo dependencies\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2\u003eProperty Controls\u003c/h2\u003e\u003cp\u003e\u003cstrong\u003eVisual\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eBackground — container background color\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eGrid Color — grid line color\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eGrid Opacity — base layer opacity (0–1)\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eReveal Opacity — mouse reveal layer opacity (0–1)\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eReveal Radius — spotlight circle size (100–800px)\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eAnimation\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eDirection — 8-way directional control\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSpeed X — horizontal speed (−5 to 5)\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSpeed Y — vertical speed (−5 to 5)\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eGradients\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eShow Gradients — toggle visibility\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eGradient 1 — top right large blob color\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eGradient 2 — top right small blob color\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eGradient 3 — bottom left large blob color\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2\u003e\u003c/h2\u003e\u003cp\u003e\u003cstrong\u003eSEO Keywords\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eframer infinite grid · framer grid background · framer mouse reveal · framer animated background · framer grid animation · framer interactive background · framer spotlight effect · framer cursor effect · framer grid component · framer background effect · framer hero background · framer animated grid · framer mouse interaction · framer code component · framer background animation\u003c/p\u003eaa:T62c,\u003cp\u003e\u003cstrong\u003eKey features:\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eDirection\u003c/strong\u003e — Left, Right, Up, or Down\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eMulti-item view\u003c/strong\u003e — show 1–8 cards at once with configurable gap, padding, radius, and aspect ratio\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003ePlayback\u003c/strong\u003e — autoplay with interval, pause-on-hover, loop, and start-at-start/end\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eNavigation\u003c/strong\u003e — drag (with edge rubber-band resistance), arrow keys, and click\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eScroll step\u003c/strong\u003e — advance one card at a time or a full page\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eArrows\u003c/strong\u003e — Split (edge-anchored), Grouped, or Inline with pagination; custom icons, shadow, fade-on-hover, offset controls\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003ePagination\u003c/strong\u003e — Dots, Progress bar (continuous or segmented Instagram-style), Numbers, or None; compact windowed mode for long lists\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eCenter Focus\u003c/strong\u003e — scale up the centered card and fade the rest\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eAccessibility\u003c/strong\u003e — ARIA carousel role, keyboard navigation, screen-reader live region, focus-visible outline, reduced-motion support\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cfigure data-youtube-url=\"https://youtu.be/xPZFTi0bFO0\"\u003e\u003ciframe src=\"https://www.youtube.com/embed/xPZFTi0bFO0?color=white\u0026amp;autoplay=0\u0026amp;controls=1\u0026amp;rel=0\" title=\"YouTube video player\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" referrerpolicy=\"strict-origin-when-cross-origin\" width=\"700\" height=\"395\" frameborder=\"0\"\u003e\u003c/iframe\u003e\u003cfigcaption\u003eTutorial\u003c/figcaption\u003e\u003c/figure\u003e\u003c/li\u003e\u003c/ul\u003eab:T74f,\u003cp\u003eInspired by \u003ca class=\"mention\" data-type=\"mention\" data-id=\"0365a5a1-29eb-426a-bb58-af7fe6b72ccf\" href=\"/community/creator/@tilljanek/\"\u003e@Till Janek\u003c/a\u003e \u003cspan data-type=\"emoji\" data-name=\"heart_hands\"\u003e🫶\u003c/span\u003e\u003c/p\u003e\u003ch2\u003eAbout\u003c/h2\u003e\u003cp\u003eAnnouncement Nav is a floating pill navigation with a built-in, dismissible announcement ticker. Up to four messages move continuously across the bar, supported by a layered entrance animation, typing text effect, rolling hover interactions, and a smooth hover slowdown for easier reading.\u003c/p\u003e\u003ch2\u003eWhat you can customize\u003c/h2\u003e\u003cp\u003eBuilt entirely with native Framer elements and customizable from the properties panel. Control the announcement visibility, close button, badge, four news messages, links, new-tab behavior, navigation labels, icons, colors, gradients, glow, and animation timing without code.\u003c/p\u003e\u003ch2\u003eGreat for (examples)\u003c/h2\u003e\u003cp\u003eJust a few ideas, use it anywhere you want to keep visitors updated without adding a separate banner:\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eMarketplace websites\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eE-commerce stores\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSaaS websites\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eProduct launches\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eStartup websites\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFeature announcements\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eChangelog pages\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eEvent websites\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eWaitlist pages\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSales campaigns\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eProduct drops\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePremium Framer templates\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2\u003eShare your build\u003c/h2\u003e\u003cp\u003eIf you ship something cool with it, post it on X and tag me \u003ca href=\"https://x.com/Matthias_Oel\" rel=\"noopener noreferrer nofollow\" target=\"_blank\"\u003e@Matthias_Oel\u003c/a\u003e, or send it over. I’d love to see what you create.\u003c/p\u003e\u003ch2\u003eNeed help?\u003c/h2\u003e\u003cp\u003eQuestions or feedback? Reach me anytime: \u003ca href=\"mailto:matthias@lmvision.de\"\u003ematthias@lmvision.de\u003c/a\u003e or on X \u003ca href=\"https://x.com/Matthias_Oel\" rel=\"noopener noreferrer nofollow\" target=\"_blank\"\u003e@Matthias_Oel.\u003c/a\u003e\u003c/p\u003e4b:[\"$\",\"div\",null,{\"className\":\"resource-listing-module-scss-module__5st7MW__gridAnchor\",\"id\":\"marketplace-grid\",\"children\":[[\"$\",\"$L4d\",null,{\"anchorId\":\"marketplace-grid\"}],[\"$\",\"$8\",null,{\"fallback\":[\"$\",\"$L4e\",null,{\"category\":\"$undefined\",\"fallbackData\":{\"data\":[{\"id\":\"vybaxS7cvvVyBVVq16nZ\",\"resolved\":true,\"title\":\"Swtich on hover tabs\",\"body\":\"\u003cp\u003eThis component is also responsive, and can be used to showcase services or any other similar use-case.\u003c/p\u003e\",\"bodyJson\":null,\"introduction\":\"Minimal card with switch on hover tabs\",\"slug\":\"swtich-on-hover-tabs\",\"author\":{\"framerUserId\":\"5e863e48-c75c-45ab-b606-e5b84dff35df\",\"name\":\"Suraj Kale\",\"slug\":\"suraj-kale-6pq60i\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/1476982/avatar-JvB7dp81Fj1B61HwfomkBqE7h4TVlc.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/components/vybaxS7cvvVyBVVq16nZ/swtich-on-hover-tabs-WbZcLGvYXuzLP6Q4wmQ1fVHGWEqLOG\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019e1bd9-c3ea-772a-bbea-f68cd1984b2a\",\"bodyJson\":null,\"likes\":{\"count\":497,\"liked\":false},\"comments\":{\"count\":5},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-05-07T17:36:11.605Z\",\"updatedAt\":\"2026-05-12T09:15:26.036Z\",\"publishedAt\":\"2026-05-12T11:01:56.842Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"component\",\"attributes\":{\"url\":\"https://framer.com/m/Tabs-card-f58s7K.js@O9keGBZsedinOMWKPrnS\",\"previewUrl\":\"https://switchonhover.framer.website/\",\"price\":null,\"paymentUrl\":null,\"workshop\":false,\"categories\":[{\"id\":\"3a855006-6097-4489-b33b-8024cb26633e\",\"name\":\"Interactions\",\"slug\":\"interactions\"}],\"lastSaveId\":\"O9keGBZsedinOMWKPrnS\"}},{\"id\":\"kShEti6yJFrcvEUsMxzb\",\"resolved\":true,\"title\":\"Confidential Folder\",\"body\":\"\u003cp\u003eA smooth and playful folder micro-interaction designed to spark curiosity and engagement.The component presents a “Do Not Open” file which flips on interaction to reveal hidden content, creating a satisfying and memorable user moment.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eUse cases:\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eEaster eggs in landing pages\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eOnboarding surprises\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePortfolio interactions\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePlayful UI moments in product design\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eFeatures:\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eClean flip animation\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFront \u0026amp; back content support\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eEasily customizable text and styling\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eBuilt for Framer, ready to drop into projects\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"bodyJson\":null,\"introduction\":\"A playful folder reveal component\",\"slug\":\"confidential-folder\",\"author\":{\"framerUserId\":\"8495aaab-95dc-4a84-8da5-0612d6cb1289\",\"name\":\"Aditya Sur\",\"slug\":\"aditya-sur\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/36322/avatar-HUQQbEHWKrzajr8aTCJzRBN7ZTA4P7.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/components/kShEti6yJFrcvEUsMxzb/confidential-folder-TB6jk5kME4qj61Wb2USBv4ty8vdDYM\",\"metadata\":{\"tint\":\"hsl(0 53% 66%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019d99c5-fef0-7d53-81fd-acb687f6bd58\",\"bodyJson\":null,\"likes\":{\"count\":1126,\"liked\":false},\"comments\":{\"count\":3},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-04-04T09:31:51.472Z\",\"updatedAt\":\"2026-08-21T10:21:14.295Z\",\"publishedAt\":\"2026-04-17T04:49:43.152Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"component\",\"attributes\":{\"url\":null,\"previewUrl\":\"https://earlier-stack-529814.framer.app/\",\"price\":\"5\",\"paymentUrl\":\"https://buy.polar.sh/polar_cl_OvudKp1W1WstKj4JToAdL10uLS1USIc0Aamwg3gAJXi\",\"workshop\":false,\"categories\":[{\"id\":\"3a855006-6097-4489-b33b-8024cb26633e\",\"name\":\"Interactions\",\"slug\":\"interactions\"}],\"lastSaveId\":\"ac6MOJH3eBldgCoGRS1D\"}},{\"id\":\"24KyqEDfxg4nxqaSUBKV\",\"resolved\":true,\"title\":\"3D Flipping Book\",\"body\":\"\u003cp\u003eNote: After uploading images, ensure both the \u003cstrong\u003eWidth\u003c/strong\u003e and \u003cstrong\u003eHeight\u003c/strong\u003e are explicitly set to \u003cstrong\u003eFixed\u003c/strong\u003e values in the Properties Panel to prevent rendering issues.\u003c/p\u003e\u003cp\u003eFeatures You'll Love:\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eRealistic 3D Page Turn:\u003c/strong\u003e Visitors simply click the book to open it, revealing a stunning, realistic page-flipping animation powered by Framer Motion. Click again to turn the next page, or click one last time to elegantly close the book.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eFully Customizable Page Content:\u003c/strong\u003e Easily plug in images or other content for the front cover, inner pages, and the back cover that's a total of 12 slots for your amazing visuals.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e\u003cstrong\u003eAdvanced Shadow Controls:\u003c/strong\u003e Fine-tune the 3D realism! Customize the shadow color, blur, spread, and offset to make the book perfectly match your site's aesthetic. The shadow even disappears during the flip animation, just like a real object.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\",\"bodyJson\":null,\"introduction\":\"A realistic 3D book flip animation\",\"slug\":\"interactivebook\",\"author\":{\"framerUserId\":\"0fd07f96-0111-409d-84f2-02aa6bac3cc7\",\"name\":\"astitva arora\",\"slug\":\"astitva-arora\",\"avatar\":null,\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/components/24KyqEDfxg4nxqaSUBKV/interactivebook-66RmvPIlrPpeOAZCWRZmcs5qpFKJ3T\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019bb828-72d3-71d4-96bb-c0aa7d4f89f8\",\"bodyJson\":null,\"likes\":{\"count\":726,\"liked\":false},\"comments\":{\"count\":11},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2025-12-15T13:10:49.727Z\",\"updatedAt\":\"2026-02-13T08:10:56.292Z\",\"publishedAt\":\"2026-01-13T16:20:17.235Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"component\",\"attributes\":{\"url\":\"https://framer.com/m/InteractiveBook-xGXc.js@uLOYl8huI2w4XDdONaRK\",\"previewUrl\":\"https://interactive3dbook.framer.website\",\"price\":null,\"paymentUrl\":null,\"workshop\":false,\"categories\":[{\"id\":\"3a855006-6097-4489-b33b-8024cb26633e\",\"name\":\"Interactions\",\"slug\":\"interactions\"}],\"lastSaveId\":\"uLOYl8huI2w4XDdONaRK\"}},{\"id\":\"N3RW4Y1WeMynntr0IkLv\",\"resolved\":true,\"title\":\"Stacked Flow\",\"body\":\"$4f\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"✦ Add depth and motion to every story.\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Create beautiful stacked card layouts with smooth animations, layered depth and natural interactions. Fully responsive, easy to customize and \"},{\"type\":\"text\",\"text\":\"ready to use in seconds.\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Make it completely your own with flexible controls for layout, styling and motion :)\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"gear\",\"emoji\":\"⚙\"}},{\"type\":\"text\",\"text\":\" What you can customize\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Easily adapt every part of the component to match your own brand and style.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Images ✦ Titles ✦ Subtitles ✦ Descriptions ✦ Card width ✦ Card height ✦ Card spacing ✦ Stack offset ✦ Mobile sizing ✦ Border radius ✦ Active scale ✦ Inactive scale ✦ Depth intensity ✦ Animation speed ✦ Scroll sensitivity ✦ Background color ✦ Text colors ✦ Typography\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"dart\",\"emoji\":\"🎯\"}},{\"type\":\"text\",\"text\":\" Perfect for\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Creative portfolios ✦ Agency presentations ✦ Editorial storytelling ✦ Featured case studies ✦ Fashion campaigns ✦ Product showcases ✦ Landing pages ✦ Brand storytelling ✦ Content highlights ✦ Project previews\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"iphone\",\"emoji\":\"📱\"}},{\"type\":\"text\",\"text\":\" Responsive by default\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Optimized layouts for Desktop, Tablet and Mobile with smooth animations and touch-friendly interactions.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"computer_mouse\",\"emoji\":\"🖱\"}},{\"type\":\"text\",\"text\":\" Included interactions\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Layered scaling ✦ Smooth transitions ✦ Scroll interactions ✦ Touch navigation ✦ Depth animations ✦ Responsive layouts\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"link\",\"emoji\":\"🔗\"}},{\"type\":\"text\",\"text\":\" Live Preview\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"https://bisque-potential-446779.framer.app/\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"https://bisque-potential-446779.framer.app/\",\"target\":\"_blank\"}}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"––––––––\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"emoji\",\"marks\":[{\"type\":\"bold\"}],\"attrs\":{\"name\":\"heart\",\"emoji\":\"❤\"}},{\"type\":\"text\",\"text\":\" Thank you so much for your support! I genuinely appreciate every download. I hope you have fun customizing this component and making it your own. Happy building!\",\"marks\":[{\"type\":\"bold\"}]}]}]},\"introduction\":\"Layered interactive card carousel\",\"slug\":\"stacked-flow\",\"author\":{\"framerUserId\":\"2179b778-b2d7-4c1e-ab27-60e7e12a6593\",\"name\":\"felix strobel\",\"slug\":\"fs\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/2179b778-b2d7-4c1e-ab27-60e7e12a6593/8gv1pj67\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/2179b778-b2d7-4c1e-ab27-60e7e12a6593/019fbd91-d98c-72ee-af3f-10dd8e2fa9c8.jpg\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019e7a94-6519-7afc-8c05-40091c9ae7bb\",\"bodyJson\":null,\"likes\":{\"count\":359,\"liked\":false},\"comments\":{\"count\":0},\"reposts