ge.com/components/unXHEPxtqIdTzESe4oSa/dot-grid-background-nFhnNM7ECZqHRivIDgAxqKc0RtksMs\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019e2216-e655-7b40-90ec-c1748aa03ab3\",\"bodyJson\":null,\"likes\":{\"count\":314,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-04-23T16:42:32.472Z\",\"updatedAt\":\"2026-06-10T05:26:16.702Z\",\"publishedAt\":\"2026-05-13T16:06:26.645Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"component\",\"attributes\":{\"url\":\"https://framer.com/m/Dot-Grid-BG-GVxaLr.js@mfNBQfaPK0E7CX1epbhh\",\"previewUrl\":\"https://dotgridbg.framer.website/\",\"price\":null,\"paymentUrl\":null,\"workshop\":false,\"categories\":[{\"id\":\"1a3a0eb3-698e-461a-bf42-2502a7ed43e0\",\"name\":\"Backgrounds\",\"slug\":\"backgrounds\"}],\"lastSaveId\":\"mfNBQfaPK0E7CX1epbhh\"}},{\"id\":\"8hHNRwz6QxLqsyYRI96h\",\"resolved\":true,\"title\":\"Accordion Service\",\"body\":\"$6f\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"MORE FRAMER COMPONENTS LIKE THIS\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"✦ Browse +38 FREE + 85 premium components: \",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\"https://frameze.com/components\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"https://frameze.com/components\",\"target\":\"_blank\"}},{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"✦ Get everything for one price: \",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\"https://ahmetloca.dub.link/allcomponents\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"https://ahmetloca.dub.link/allcomponents\",\"target\":\"_blank\"}},{\"type\":\"bold\"}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"About Accordion Service\",\"marks\":[{\"type\":\"bold\"}]}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"AccordionSection is a numbered, animated accordion component for Framer. Each item expands with a smooth height animation on click, revealing its full description underneath. On hover, titles animate sharply from left to right with a precision reveal effect — creating a premium interactive layer that immediately elevates the page. A structured two-column header sits above the list, combining an eyebrow label, bold uppercase display heading and a right-aligned side description. This makes AccordionSection a complete, publication-ready section that drops into any Framer project with zero configuration.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Numbered items with auto-formatted labels (01, 02, 03...)\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Left-to-right title reveal animation on hover\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Smooth expand and collapse with individually tunable open and close durations\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Two-column section header: eyebrow text, bold heading and side description\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Eyebrow icon — toggle on or off independently\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Fully responsive — auto-stacks to a single column under 768px\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Native Framer font picker for title family and weight\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Global font scale multiplier for quick size adjustments\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Full color control — background and text, with borders auto-derived\"}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Use Cases\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Agency and studio services pages\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Product features and benefits sections\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"FAQ and support pages\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Team skills and expertise presentations\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Pricing plan and tier breakdowns\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Step-by-step process and workflow sections\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Company values and mission pages\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Case study and project summary layouts\"}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Keywords\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"accordion section, numbered accordion, accordion, services section, animated accordion, hover reveal animation, title reveal, expand collapse framer, FAQ accordion, services list, responsive accordion, services component, feature list, animated list, content accordion, numbered list, agency section, smooth accordion, accordion component\"}]}]},\"introduction\":\"Numbered accordion with animations\",\"slug\":\"accordion-service\",\"author\":{\"framerUserId\":\"bcb94bf9-7aa9-40d7-b681-19421ce62bd3\",\"name\":\"Ahmet Loca\",\"slug\":\"ahmet-loca\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/107742/avatar-FjO7QBJgG4WwbY6uS5eymN55rN0btF.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\