\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-05-20T10:22:53.475Z\",\"updatedAt\":\"2026-08-18T09:55:32.913Z\",\"publishedAt\":\"2026-05-30T19:53:58.634Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"component\",\"attributes\":{\"url\":\"https://framer.com/m/VideoCarousel-3ACghD.js@gN3OxtTWepzM2Kd4SUcE\",\"previewUrl\":\"https://affable-ideas-694418.framer.app\",\"price\":null,\"paymentUrl\":null,\"workshop\":true,\"categories\":[{\"id\":\"8f93ccfe-423c-47f2-b8ae-79e9e132012f\",\"name\":\"Carousels\",\"slug\":\"carousels\"}],\"lastSaveId\":\"gN3OxtTWepzM2Kd4SUcE\"}},{\"id\":\"mYLoavYLbsfxkFMQSuXb\",\"resolved\":true,\"title\":\"Spiral 3D Slider\",\"body\":\"$59\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Feature Highlights\"}],\"attrs\":{\"level\":1}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Spiral Motion \",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\"Displays content along a smooth spiral path for a cinematic 3D browsing effect.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Scroll Based \",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\"Smooth scroll based rotation along a 3D spiral\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Depth Perspective \",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\"Creates layered visual depth with dynamic scaling and positioning.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Interactive Navigation \",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\"Supports drag, swipe, and smooth motion-based interaction.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Auto Rotation \",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\"Continuously animates items for an immersive gallery experience.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Dynamic Focus \",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\"Keeps attention centered on highlighted elements while surrounding items flow naturally.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Responsive Layout \",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\"Adapts beautifully across desktop, tablet, and mobile screens.\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Why It’s Useful\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"SpiralSlider transforms traditional galleries into immersive visual experiences.Perfect for portfolios, creative showcases, product presentations, hero sections, and experimental interfaces.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Its floating spiral layout adds motion, depth, and elegance while keeping interactions smooth and intuitive.\"}]}]},\"introduction\":\"Customizable 3D Spiral Slider\",\"slug\":\"spiral-3d-slider\",\"author\":{\"framerUserId\":\"47745ef1-855e-412c-a101-305ac078cd49\",\"name\":\"FrameSpace\",\"slug\":\"framespace\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/129533/avatar-CUOFZiJvUMrfCqPnaTe2BesapDWMrY.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/components/mYLoavYLbsfxkFMQSuXb/spiral-3d-slider-5KVn8uuLEjOyczEqYeXCrWeQi12AbL\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019e79e8-67e7-754b-ae9f-efb46a02f518\",\"bodyJson\":null,