":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"About this component\"}],\"attrs\":{\"level\":1}},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"A component for vibrant and memorable interactions\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"A modern, clean background effect. It features fully editable settings: upload your own images or videos, adjust the mask size, and even create a rotation effect (if you have a circular graphic). You can easily adapt the background's appearance to your design.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Key Features:\"}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"WOW Effect\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Smooth hover animation\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"An engaging user experience\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Fully editable component\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Ideal for vibrant and memorable websites\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Format support — .jpeg, .png, .mp4\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Use the button names in the \\\"\"},{\"type\":\"text\",\"text\":\"Button\",\"marks\":[{\"type\":\"italic\"}]},{\"type\":\"text\",\"text\":\"\\\" layers to avoid losing the effect. Or any other, just fill in the \\\"Full visibility\\\" field.\"}]},{\"type\":\"customImage\",\"attrs\":{\"alt\":\"\",\"src\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/components/description-i