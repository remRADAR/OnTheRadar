fBaS219G9AbxjBO1eJ5uRY0jhdYT\",\"workshop\":true,\"categories\":[{\"id\":\"3a855006-6097-4489-b33b-8024cb26633e\",\"name\":\"Interactions\",\"slug\":\"interactions\"}],\"lastSaveId\":\"0qMRfmG87IcHK5HiyqSV\"}},{\"id\":\"ANIcayozOsdQksaeT0H8\",\"resolved\":true,\"title\":\"Glass Showcase\",\"body\":\"$68\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"MORE COMPONENTS →\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer\",\"href\":\"https://www.framer.com/@rkoby/?tab=component\",\"target\":\"_blank\"}}]}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Glass Showcase helps you create an interactive card section with a clean glass-style look. Cards expand on hover, backgrounds blur dynamically, and all key settings can be customized directly in Framer.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Features:\"}],\"attrs\":{\"level\":1}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Expandable hover interactions\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Dynamic blurred background transitions\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Fully customizable typography controls\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Editable spacing and sizing options\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Smooth animations and hover effect\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Glassmorphism-inspired visual style\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Easy integration into Framer projects\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Flexible controls\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Customize every part of the component directly in Framer — from images, videos, layout, spacing, blur, and sizing to typography, colors, hover states, and active card settings.\"}]},{\"type\":\"customImage\",\"attrs\":{\"alt\":\"\",\"src\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/components/description-image-7xvbiclr-G17apPE7EDtWevJvLgN5cI7xdA64sD\",\"link\":null,\"caption\":\"\",\"uploadId\":null}},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Responsive layout options\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Adapt the showcase to different sections and screen sizes with flexible width, height, spacing, and thumbnail controls.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Support\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"If you need help with the component or have any issues while using it, feel free to reach out.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Email: promakdesign@gmail.com\"}]}]},\"introduction\":\"Interactive glass showcase\",\"slug\":\"glass-showcase\",\"author\":{\"framerUserId\":\"98ab5a06-8301-4883-baae-44ea08e5277e\",\"name\":\"Roman Koby\",\"slug\":\"rkoby\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/98ab5a06-8301-4883-baae-44ea08e5277e/60ipsovp\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/components/ANIcayozOsdQksaeT0H8/glass-showcase-PbEGFBNLW5IDGWwZqR1ITdxQnanILl\",\"metadata\":{\"tint\":\"hsl(0 0% 30%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"