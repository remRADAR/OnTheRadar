 hover slide-up reveal\",\"slug\":\"image-ticker\",\"author\":{\"framerUserId\":\"9895593f-f88e-4331-8cb1-7b7c1b1c9a25\",\"name\":\"Shivani Sharma\",\"slug\":\"shivani-sharma-ss\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/9895593f-f88e-4331-8cb1-7b7c1b1c9a25/2h1rcvd5\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/components/ovm8ljh7RzNTFNWu4Nq5/image-ticker-gR83lIsGAi65vtCBEBLAurCLJ0ZD1g\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019e98e7-811a-77d6-89d0-eeb688264f18\",\"bodyJson\":null,\"likes\":{\"count\":326,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-05-29T21:59:44.250Z\",\"updatedAt\":\"2026-06-05T17:57:29.004Z\",\"publishedAt\":\"2026-06-05T17:49:29.242Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"component\",\"attributes\":{\"url\":\"https://framer.com/m/Hover-Ticker-TMF7QK.js@91oEQpDvofJ2mya5tHIq\",\"previewUrl\":\"https://hover-ticker.framer.website/\",\"price\":null,\"paymentUrl\":null,\"workshop\":false,\"categories\":[{\"id\":\"3a855006-6097-4489-b33b-8024cb26633e\",\"name\":\"Interactions\",\"slug\":\"interactions\"}],\"lastSaveId\":\"91oEQpDvofJ2mya5tHIq\"}},{\"id\":\"OAToGSOw3GWHXUqEuimP\",\"resolved\":true,\"title\":\"FanSlider Pro\",\"body\":\"$93\",\"bodyJson\":null,\"introduction\":\"Smooth infinite carousel component\",\"slug\":\"fanslider-pro\",\"author\":{\"framerUserId\":\"7acc44a9-1d04-435f-ab18-0fbac19933de\",\"name\":\"Sk Shohid Hossain\",\"slug\":\"sk-shohid-hossain\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/39568/avatar-y2O54tlJu2wcObqEIIAmtBf3bjiCrA.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/components/OAToGSOw3G