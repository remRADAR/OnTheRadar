\":\"$51\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Text Reveal on Scroll\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Text Reveal on Scroll is a lightweight interaction component that progressively reveals text as users scroll through the page. Designed for modern storytelling layouts, landing pages, portfolios, and editorial experiences, it creates a refined reading effect with smooth motion and customizable styling.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Features\"}],\"attrs\":{\"level\":2}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Reveal text by \"},{\"type\":\"text\",\"text\":\"character\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\", \"},{\"type\":\"text\",\"text\":\"word\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\", or \"},{\"type\":\"text\",\"text\":\"sentence\",\"marks\":[{\"type\":\"bold\"}]}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Smooth spring-based scroll animations\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Optional replay behavior on reverse scrolling\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Balanced text wrapping for cleaner typography\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Fully customizable colors and fonts\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Responsive and accessibility-friendly\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Lightweight and optimized for Framer projects\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Perfect For\"}],\"attrs\":{\"level\":2}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Hero sections\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Storytelling websites\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Portfolio intros\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Editorial layouts\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Product launches\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Modern landing pages\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Customization\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Adjust typography, reveal style, animation feel, muted/active colors, and transition settings directly from Framer property controls — no code changes required.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Includes\"}],\"attrs\":{\"level\":2}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Easy-to-use property controls\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Responsive behavior\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Production-ready animation setup\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Reach out anytime via \"},{\"type\":\"text\",\"text\":\"email\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"mailto:kaniyanahmad1@gmail.com\",\"class\":null,\"target\":\"_blank\"}}]},{\"type\":\"text\",\"text\":\" or DM on \"},{\"type\":\"text\",\"text\":\"X\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"https://www.x.com/kaniyanstudio\",\"class\":null,\"target\":\"_blank\"}}]},{\"type\":\"text\",\"text\":\".\"}]}]},\"introduction\":\"Smooth Scroll Text Reveal\",\"slug\":\"reveal-text\",\"author\":{\"framerUserId\":\"e0862edc-8395-48e7-9ef4-4063a0d9cad5\",\"name\":\"Kaniyan Ahmad\",\"slug\":\"kaniyanstudio\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/1220476/avatar-40j7gZKDe1GraJ7xVYL0gpcEicOXcF.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/components/zDtiSTBfViqo5tUzeRNn/reveal-text-HHHflMBg2sZ0qDONHj5Be97xbHECVB\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019e7a2b-315c-7f90-b47e-f3bdd5c94ba9\",\"bodyJson\":null,\"likes\":{\"count\":599,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-05-25T09:09:45.321Z\",\"updatedAt\":\"2026-07-06T00:23:35.248Z\",\"publishedAt\":\"2026-05-30T18:35:11.580Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"component\",\"attributes\":{\"url\":\"https://framer.com/m/Text-Reveal-on-Scroll-iAEwo4.js@r5fIqIUYTgYRry5w2nRx\",\"previewUrl\":\"https://text-reveal-on-scroll.framer.website/\",\"price\":null,\"paymentUrl\":null,\"workshop\":false,\"categories\":[{\"id\":\"3a855006-6097-4489-b33b-8024cb26633e\",\"name\":\"Interactions\",\"slug\":\"interactions\"}],\"lastSaveId\":\"r5fIqIUYTgYRry5w2nRx\"}},{\"id\":\"rl7d7Vf87QGDeF4IBjBw\",\"resolved\":true,\"title\":\"Floating Pill Nav\",\"body\":\"\u003cp\u003eThe \u003cstrong\u003eFloating Pill Navigation \u003c/strong\u003eis a production-ready component built to recreate the polished behavior and visual feel of Apple’s tab-style navigation. Its defining feature is a smooth animated background pill that moves behind the active item when a link is clicked, paired with a text color change that keeps the active state clear and readable.\u003c/p\u003e\u003cp\u003eAt its default settings, the component is tuned to closely match Apple’s actual tab navigation: motion behavior, spacing, padding, typography proportions, colors, and item structure are all set up to feel nearly identical out of the box. But unlike a locked visual clone, every important part of the component is fully customizable—so you can keep the Apple-like feel or push it into your own system entirely.\u003c/p\u003e\u003cp\u003ePerfect for product pages, segmented controls, filters, settings views, dashboards, and interfaces that need elegant, motion-led navigation.\u003c/p\u003e\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"The \"},{\"type\":\"text\",\"text\":\"Floating Pill Navigation \",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\"is a production-ready component built to recreate the polished behavior and visual feel of Apple’s tab-style navigation. Its defining feature is a smooth animated background pill that moves behind the active item when a link is clicked, paired with a text color change that keeps the active state clear and readable.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"At its default settings, the component is tuned to closely match Apple’s actual tab navigation: motion behavior, spacing, padding, typography proportions, colors, and item structure are all set up to feel nearly identical out of the box. But unlike a locked visual clone, every important part of the component is fully customizable—so you can keep the Apple-like feel or push it into your own system entirely.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Perfect for product pages, segmented controls, filters, settings views, dashboards, and interfaces that need elegant, motion-led navigation.\"}]}]},\"introduction\":\"Apple-Style Animated Tabs\",\"slug\":\"floating-pill-nav\",\"author\":{\"framerUserId\":\"001f5b33-6097-4b89-9746-eafbbc58ab0c\",\"name\":\"Omer Mirza\",\"slug\":\"omermirza\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/001f5b33-6097-4b89-9746-eafbbc58ab0c/lzhswod7\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/001f5b33-6097-4b89-9746-eafbbc58ab0c/3o0ozh20\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019ee4cb-a611-77da-942e-577ebfd1588b\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"A fully-customizable \"},{\"type\":\"text\",\"text\":\"pill navigation\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" component, inspired by Apple’s tab navigation and recreated with carefully tuned motion, spacing, and styling.\"}]}]},\"likes\":{\"count\":601,\"liked\":false},\"comments\":{\"count\":10},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-06-20T11:30:12.069Z\",\"updatedAt\":\"2026-06-20T11:30:12.069Z\",\"publishedAt\":\"2026-06-20T11:30:12.061Z\",\"featuredAt\":\"2026-07-18T08:25:07.324Z\",\"reported\":false,\"approvedAt\":null,\"type\":\"component\",\"attributes\":{\"url\":\"https://framer.com/m/FloatingPillNavigation-s92k8M.js@qwsogf78G8HhJg4I53jE\",\"previewUrl\":\"https://floating-pill-nav.framer.website\",\"price\":null,\"paymentUrl\":null,\"workshop\":true,\"categories\":[{\"id\":\"4c691677-c621-4041-a908-cbc2d3272658\",\"name\":\"Navigation\",\"slug\":\"navigation\"}],\"lastSaveId\":\"qwsogf78G8HhJg4I53jE\"}},{\"id\