t size, weight, color, letter spacing, and line height remain exactly as designed.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"You keep full control over your typography, while the component adds a smooth, cinematic scroll-driven text animation on top.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Instructions\"}],\"attrs\":{\"level\":1}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Add this component to the canvas on the \"},{\"type\":\"text\",\"text\":\"desktop breakpoint\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\".\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Place a \"},{\"type\":\"text\",\"text\":\"Text layer outside the desktop breakpoint\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\".\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Wrap the Text layer in a Stack.\",\"marks\":[{\"type\":\"bold\"}]}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Set the Text layer's \"},{\"type\":\"text\",\"text\":\"width to \\\"Fill\\\"\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" so it will be responsive across screens.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"In the component's property panel, use the \"},{\"type\":\"text\",\"text\":\"\\\"Text\\\" property control\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" to connect that Text layer.\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Setup\"}],\"attrs\":{\"level\":2}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"You 