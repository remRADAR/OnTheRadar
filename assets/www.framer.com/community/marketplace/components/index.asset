3c/p\u003e\u003cp\u003e- No code required\u003c/p\u003e\u003ch3\u003ePerfect for\u003c/h3\u003e\u003cp\u003e- Landing pages\u003c/p\u003e\u003cp\u003e- SaaS websites\u003c/p\u003e\u003cp\u003e- Product launches\u003c/p\u003e\u003cp\u003e- Case studies\u003c/p\u003e\u003cp\u003e- Feature showcases\u003c/p\u003e\u003cp\u003e- Brand storytelling\u003c/p\u003e\u003cp\u003e- Step-by-step guides\u003c/p\u003e\u003cp\u003e- Educational content\u003c/p\u003e\u003cp\u003e---\u003c/p\u003e\u003cp\u003eBuilt with Framer Workshop and optimized for performance.\u003c/p\u003e\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Sticky Scroll Story\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Create engaging scroll-driven storytelling experiences with a fully customizable sticky component for Framer.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Sticky Scroll Story keeps your content fixed on screen while smoothly transitioning between messages as users scroll. It's perfect for showcasing product features, explaining processes, presenting case studies, or creating immersive landing pages.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Features\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- Sticky scroll storytelling\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- Smooth text transitions\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- Progress indicators\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- Fully responsive\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- Fully customizable\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- Easy to integrate\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- No code required\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Perfect for\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- Landing pages\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- SaaS websites\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- Product launches\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- Case studies\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- Feature showcases\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- Brand storytelling\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- Step-by-step guides\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- Educational content\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"---\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Built with Framer Workshop and optimized for performance.\"}]}]},\"introduction\":\"Tell stories as users scroll\",\"slug\":\"sticky-scroll-story\",\"author\":{\"framerUserId\":\"67e8ef10-7922-4f05-baf2-94797e1ffdcf\",\"name\":\"Ulises Gabriel\",\"slug\":\"ulisesgabriel\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/67e8ef10-7922-4f05-baf2-94797e1ffdcf/0fhd0qm5\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/67e8ef10-7922-4f05-baf2-94797e1ffdcf/019f740c-b6da-7097-94cf-803b007e7dec.png\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":0.9704472843450479}}],\"post\":{\"id\":\"019f740c-eb7c-71d9-a1df-c20d8b86aa61\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"sparkles\",\"emoji\":\"✨\"}},{\"type\":\"text\",\"text\":\" Sticky Scroll Story is now live!\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"A free Framer component for creating clean, scroll-driven storytelling experiences.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Fully customizable\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Responsive\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Built with Framer Workshop\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Hope you find it useful!\"}]}]},\"likes\":{\"count\":137,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-07-18T07:07:11.153Z\",\"updatedAt\":\"2026-07-18T07:07:11.153Z\",\"publishedAt\":\"2026-07-18T07:07:11.141Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"component\",\"attributes\":{\"url\":\"https://framer.com/m/StickyScrollStory-2-x6oztN.js@3u60lLOoADWXFvcvY5Ek\",\"previewUrl\":\"https://sticky-scroll-story.framer.website/\",\"price\":null,\"paymentUrl\":null,\"workshop\":true,\"categories\":[{\"id\":\"8f93ccfe-423c-47f2-b8ae-79e9e132012f\",\"name\":\"Carousels\",\"slug\":\"carousels\"}],\"lastSaveId\":\"3u60lLOoADWXFvcvY5Ek\"}},{\"id\":\"vCmgrkRTlK5UlkOVS4GQ\",\"resolved\":true,\"title\":\"Reel Video Carousel\",\"body\":\"$97\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"A premium video carousel designed to showcase short-form content in a smooth, continuously drifting reel-style layout.\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Reel Video Carousel transforms video content into an engaging horizontal rail where cards continuously drift across the screen. Users can interact with the carousel using drag and mouse wheel controls, while videos automatically play near the centre for a dynamic, immersive browsing experience.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Features\"}],\"attrs\":{\"level\":1}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Reel-style video carousel\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Continuous horizontal drifting\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Smooth infinite looping\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Upload videos directly in Framer\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Video URL support\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Custom poster images\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Multiple aspect ratios\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"9:16, 3:4, 4:5, 1:1, and 16:9 formats\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Cover or fit video display\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Centre-focused video playback\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Optional playback for all cards\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Looping video support\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Muted autoplay\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Custom sound controls\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Individual card borders and radius\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Adjustable card width and spacing\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Drag and momentum interaction\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Mouse wheel navigation\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Adjustable drift speed\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Direction control\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Hover speed adjustment\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Centre focus scaling\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Edge fading effects\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Custom resting opacity\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Smooth responsive layout\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Reduced-motion support\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Fully customizable in Framer\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Perfect For\"}],\"attrs\":{\"level\":1}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"SaaS websites\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Startup landing pages\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Creative agencies\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Design studios\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Portfolio websites\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Product websites\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Social media websites\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Marketing pages\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Creator websites\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Modern business websites\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Why You'll Love It\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Reel Video Carousel gives your video content a more dynamic and immersive presentation. Instead of a standard video grid or static carousel, the continuously drifting rail creates a smooth reel-style browsing experience that naturally draws attention to each clip.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Add videos, posters, aspect ratios, spacing, playback settings, colors, and interaction controls directly through Framer Property Controls. Drag gestures, mouse wheel navigation, momentum, centre-focused playback, and smooth visual effects make the carousel feel polished across desktop and mobile.\"}]}]},\"introduction\":\"Premium Drifting Video Carousel\",\"slug\":\"reel-video-carousel\",\"author\":{\"framerUserId\":\"ca05e506-1465-479c-9098-193c2ad13a2b\",\"name\":\"Design Foundry\",\"slug\":\"designfoundry\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/ca05e506-1465-479c-9098-193c2ad13a2b/xcfk0umu\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/ca05e506-1465-479c-9098-193c2ad13a2b/01a019f5-890f-763a-b935-33fda6477fde.png\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"01a019fd-0b26-721d-a7a3-6889b9a9255d\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Reel Video Carousel is live!\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"A premium video carousel for Framer with drifting video cards, smooth autoplay, drag and wheel interactions, centre-focused playback, sound controls, customizable aspect ratios, and responsive layouts.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"If you like it, I’d really appreciate a \"},{\"type\":\"emoji\",\"attrs\":{\"name\":\"heart\",\"emoji\":\"❤\"}},{\"type\":\"text\",\"text\":\" on the component page!\"}]}]},\"likes\":{\"count\":16,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-08-19T12:26:48.423Z\",\"updatedAt\":\"2026-08-20T12:59:33.293Z\",\"publishedAt\":\"2026-08-19T12:26:48.417Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"component\",\"attributes\":{\"url\":null,\"previewUrl\":\"https://reelvideocarousel.framer.website/\",\"price\":\"15\",\"paymentUrl\":\"https://buy.polar.sh/polar_cl_LxxMCd73nn9YvG5DoIQSj3YADIo8AjzDc4duQ3IjkmZ\",\"workshop\":false,\"categories\":[{\"id\