gency\",\"slug\":\"agency\"},{\"id\":218,\"name\":\"Free\",\"slug\":\"free-website-templates\"},{\"id\":263,\"name\":\"Video\",\"slug\":\"video\"},{\"id\":248,\"name\":\"Services\",\"slug\":\"professional-services\"}],\"styles\":[{\"id\":220,\"name\":\"Gradient\",\"slug\":\"gradient\"},{\"id\":247,\"name\":\"Professional\",\"slug\":\"professional\"},{\"id\":109,\"name\":\"Modern\",\"slug\":\"modern\"},{\"id\":110,\"name\":\"Animated\",\"slug\":\"animated\"},{\"id\":201,\"name\":\"Colorful\",\"slug\":\"colorful\"}],\"mainCategory\":{\"id\":3,\"name\":\"Agency\",\"slug\":\"agency\"},\"features\":[{\"id\":1,\"name\":\"Appear Effects\",\"slug\":\"appear-effects\"},{\"id\":13,\"name\":\"Slideshows/Tickers\",\"slug\":\"slideshows-tickers\"},{\"id\":35,\"name\":\"Text Effects\",\"slug\":\"text-effects\"},{\"id\":41,\"name\":\"Vector Sets\",\"slug\":\"vector-sets\"}]}},{\"id\":\"54379\",\"resolved\":true,\"title\":\"Sanjaya\",\"body\":\"$9c\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"emoji\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer\",\"href\":\"https://veloxthemes.com/templates/platform/framer-templates?utm_source=framer\",\"target\":\"_blank\"}}],\"attrs\":{\"name\":\"arrow_upper_right\",\"emoji\":\"↗\"}},{\"type\":\"text\",\"text\":\" Live preview\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer\",\"href\":\"https://veloxthemes.com/templates/platform/framer-templates?utm_source=framer\",\"target\":\"_blank\"}}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"emoji\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer\",\"href\":\"https://veloxthemes.com/templates/platform/framer-templates?utm_source=framer\",\"target\":\"_blank\"}}],\"attrs\":{\"name\":\"arrow_upper_right\",\"emoji\":\"↗\"}},{\"type\":\"text\",\"text\":\" More Framer templates\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer\",\"href\":\"https://veloxthemes.com/templates/platform/framer-templates?utm_source=framer\",\"target\":\"_blank\"}}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"About this template\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Your agency needs more than a website. You need a platform that helps you win serious clients. Sanjaya is an AI agency Framer template built for teams that want to attract B2B and enterprise customers with a professional and trustworthy online presence.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"If you offer AI automation, AI consulting, or AI solutions for businesses, Sanjaya helps you present your services clearly and show the real value of your work. You can showcase services, highlight case studies, and explain your workflow in a way that builds trust with decision makers.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Launch your website faster and focus on growing your AI agency!\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"This template is for you if you want to\"}],\"attrs\":{\"level\":1}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Build a modern website for your AI agency or AI automation agency\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Attract B2B and enterprise clients looking for AI solutions\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Showcase services like AI automation, workflow systems, and integrations\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Build trust with case studies and a clear process\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Your benefits after purchase\