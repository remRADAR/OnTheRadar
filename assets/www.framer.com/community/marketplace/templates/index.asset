Dark\",\"slug\":\"dark\"}],\"mainCategory\":{\"id\":3,\"name\":\"Agency\",\"slug\":\"agency\"},\"features\":[{\"id\":1,\"name\":\"Appear Effects\",\"slug\":\"appear-effects\"},{\"id\":9,\"name\":\"Overlays \u0026 Modals\",\"slug\":\"overlays-modals\"},{\"id\":13,\"name\":\"Slideshows/Tickers\",\"slug\":\"slideshows-tickers\"},{\"id\":21,\"name\":\"CMS\",\"slug\":\"cms\"},{\"id\":30,\"name\":\"Forms\",\"slug\":\"forms\"},{\"id\":32,\"name\":\"Layout Templates\",\"slug\":\"layout-templates\"},{\"id\":35,\"name\":\"Text Effects\",\"slug\":\"text-effects\"},{\"id\":37,\"name\":\"Code Components\",\"slug\":\"code-components\"}]}},{\"id\":\"70406\",\"resolved\":true,\"title\":\"Surfera\",\"body\":\"$b4\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Surfera\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" is a website template for surf camps, retreats and small travel operators who want their site to feel as memorable as the trip.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Built around one bold idea — oversized Anton headlines, a warm cream-and-lemon palette, deep-green accents and a hand-tuned dot-grid texture — Surfera reads like a designed brand, not a generic template. Every section is engineered to convert browsers into bookings: a spacious hero, a clear \\\"what's included\\\" breakdown, an experiences catalog, real social proof and a built-in application form.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Everything is fully responsive across three breakpoints (desktop, tablet, mobile), with a full-screen menu, tasteful scroll and hover animations, and clean CMS collections so the owner can update content without touching design.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Perfect for:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" surf camps, surf schools, yoga \u0026 wellness retreats, adventure travel, dive camps, and any experience-led hospitality brand.\"}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"3 designed pages\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" — Home, Experiences, and a custom 404\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"CMS collections\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" — fully editable, no design skills needed\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Fully responsive\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" — desktop / tablet / mobile breakpoints, audited\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Motion built-in\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" — scroll reveals, hover gallery, animated full-screen menu\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Booking / application form\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" — native Framer form, submissions land in your dashboard\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Custom components\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" — buttons with hover, nav, cards, hover gallery, pricing\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Reusable styles \u0026 color tokens\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" — restyle the whole site in minutes\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Optimized \u0026 clean\",\"marks\":[{\"type\":\"bold\"}]},{\"