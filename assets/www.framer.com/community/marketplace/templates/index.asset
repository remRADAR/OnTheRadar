rue,\"title\":\"Bungee\",\"body\":\"$8d\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Live Preview\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer\",\"href\":\"https://bungee.framer.website/\",\"target\":\"_blank\"}}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Access all templates and 1K+ sections\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer\",\"href\":\"https://library.clonify.io/\",\"target\":\"_blank\"}}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"emoji\",\"marks\":[{\"type\":\"code\"}],\"attrs\":{\"name\":\"earth_africa\",\"emoji\":\"🌍\"}},{\"type\":\"text\",\"text\":\" We support Parity Purchase Pricing. Depending on your country, you may automatically receive a discounted price at checkout.\",\"marks\":[{\"type\":\"code\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Bungee was crafted for creative studios that want more than a pretty layout — it’s built for impact, clarity, and leaving the right impression.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"With a modern, minimal aesthetic and a purposeful structure, Bungee keeps your work front and center while guiding visitors seamlessly through your story.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Why choose Bungee?\"}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Minimal, Not Basic – Every section has intention. Clean, smart design with zero distractions.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Conversion-Ready – CTAs are thoughtfully placed to drive action without ever feeling pushy.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Proven in Practice – The layout isn’t experimental; it’s shaped by real-world results and user behavior.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"100% Framer-Native – Lightning-fast performance, SEO-friendly structure, and a smooth setup from start to finish.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Effortlessly Customizable – Flexible and beautiful by design. Swap colors, fonts, content, or layouts in minutes — stress-free and clutter-free.\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Whether you’re a solo creative, an agency, or a studio ready to refresh your online presence, Bungee gives you the framework to showcase your work with confidence.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Included Pages\"}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Home – A scroll-friendly intro to your brand.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Projects (CMS) – Showcase your best work in a clean, scalable format.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"About – Share your team’s story and mission with clarity.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Blog (CMS) – Publish updates, insights, or case studies with ease\"}]}]}]}]},\"introduction\":\"Studio Template Built for Impact\",\"slug\":\"bungee\",\"author\":{\"framerUserId\":\"b3e4728f-0e9d-4bd8-acfd-c1f9187d53a5\",\"name\":\"Clonify\",\"slug\":\"omarelabd\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/b3e4728f-0e9d-4bd8-acfd-c1f9187d53a5/o46pkds3\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\"