pe\":\"emoji\",\"attrs\":{\"name\":\"link\",\"emoji\":\"🔗\"}},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"Full Live Preview:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"https://agero.framer.website/\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"https://agero.framer.website/\",\"target\":\"_blank\"}}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"sparkles\",\"emoji\":\"✨\"}},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"More Premium Templates:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"https://www.framer.com/@nframe/?tab=template\u0026sort=popular\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"https://www.framer.com/@nframe/?tab=template\u0026sort=popular\",\"target\":\"_blank\"}}]}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Agero\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" is a modern AI agency Framer template built for businesses that want a professional, conversion-focused agency website. Whether you're running an AI agency, digital agency, creative agency, marketing agency, automation agency, technology agency, consulting agency, branding agency, startup agency or SaaS agency.\"}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Designed with modern agency needs in mind, this agency template combines clean layouts, smooth interactions, and strategic content sections to showcase agency services, agency solutions, agency expertise, agency projects, agency works, and agency results. Each agency page is crafted to help an agency show value clearly \u0026 convert visitors into clients.\"}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Why Choose Agero?\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"A successful agency needs more than great design. Agero provides a complete agency framework that helps an agency present services, agency achievements, display agency testimonials, and strengthen agency credibility. The responsive agency layout ensures a seamless experience across desktop, tablet, and mobile devices, while optimized agency structure keeps your website fast and engaging agency site.\"}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Key Features\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Modern AI agency design, responsive agency layout, smooth agency interactions, fast-loading agency performance, scalable agency sections, premium agency typography, flexible agency customization, and conversion-focused agency.\"}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Perfect For\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"AI Agency, Digital Agency, Creative Agency, Marketing Agency, Technology Agency, Automation Agency, Startup Agency, Consulting Agency, Branding Agency, Design Agency, Development Agency, Web Agency, Software Agency, Growth Agency, SEO Agency, Content Agency, Media Agency, SaaS Agency, Innovation Agency, Enterprise Agency, AI Agency, Digital Agency, Creative Agency, Marketing Agency, Technology Agency, Automation Agency, Startup Agency, Consulting Agency.\"}]}]},\"introduction\":\"Creative Agency \u0026 Marketing Agency\",\"slug\":\"agero\",\"author\":{\"framerUserId\":\"37c240a6-d191-4737-bb34-b07d82d65414\",\"name\":\"NFrame\",\"slug\":\"nframe\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/980653/avatar-lyo51cYZXv2UyGVPVIkntWxfLIzEJg.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/templates/53542/agero-Ep6TUa9iKTooOkySX5uOturVI4KFeH\",\"metadata\":{\"tint\":\"hsl(0 0% 33%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/templates/53542/agero-sRSVr8MRRpAy1xNo8cSLctIOjdqaCr\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/templates/53542/agero-vtLNwiuKM1ph1cPKlp6NNXzgxmW0JG\",\"metadata\":{\"tint\":\"hsl(0 0% 24%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/templates/53542/agero-66Ei15tazlXTkXvMYmCZUZBRAkh0X4\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"0198515f-a422-786f-83de-5788ad41739a\",\"bodyJson\":null,\"likes\":{\"count\":842,\"liked\":false},\"comments\":{\"count\":38},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2025-06-23T07:37:50.012Z\",\"updatedAt\":\"2026-07-28T08:42:15.279Z\",\"publishedAt\":\"2025-07-28T14:11:19.202Z\",\"featuredAt\":\"2026-06-19T09:41:24.433Z\",\"reported\":false,\"approvedAt\":\"2026-06-01T14:46:12.987Z\",\"type\":\"template\",\"attributes\":{\"price\":null,\"paymentUrl\":\"https://framer.link/UqGVPy5\",\"remixUrl\":\"https://framer.link/UqGVPy5\",\"previewUrl\":\"https://agero.framer.website/\",\"categories\":[{\"id\":3,\"name\":\"Agency\",\"slug\":\"agency\"},{\"id\":22,\"name\":\"Startup\",\"slug\":\"startup\"},{\"id\":237,\"name\":\"Marketing\",\"slug\":\"marketing\"},{\"id\":14,\"name\":\"Landing Page\",\"slug\":\"landing-page\"},{\"id\":218,\"name\":\"Free\",\"slug\":\"free-website-templates\"}],\"styles\":[{\"id\":247,\"name\":\"Professional\",\"slug\":\"professional\"},{\"id\":109,\"name\":\"Modern\",\"slug\":\"modern\"},{\"id\":110,\"name\":\"Animated\",\"slug\":\"animated\"},{\"id\":111,\"name\":\"Minimal\",\"slug\":\"minimal\"}],\"mainCategory\":{\"id\":3,\"name\":\"Agency\",\"slug\":\"agency\"},\"features\":[{\"id\":1,\"name\":\"Appear Effects\",\"slug\":\"appear-effects\"},{\"id\":13,\"name\":\"Slideshows/Tickers\",\"slug\":\"slideshows-tickers\"},{\"id\":17,\"name\":\"Sticky Scrolling\",\"slug\":\"sticky-scrolling\"},{\"id\":18,\"name\":\"Scroll Effects\",\"slug\":\"scroll-effects\"},{\"id\":19,\"name\":\"Localization\",\"slug\":\"localization\"},{\"id\":21,\"name\":\"CMS\",\"slug\":\"cms\"},{\"id\":25,\"name\":\"Custom Cursors\",\"slug\":\"custom-cursors\"},{\"id\":30,\"name\":\"Forms\",\"slug\":\"forms\"},{\"id\":32,\"name\":\"Layout Templates\",\"slug\":\"layout-templates\"},{\"id\":35,\"name\":\"Text Effects\",\"slug\":\"text-effects\"},{\"id\":37,\"name\":\"Code Components\",\"slug\":\"code-components\"},{\"id\":39,\"name\":\"Selection Styles\",\"slug\":\"selection-styles\"},{\"id\":40,\"name\":\"Variable Fonts\",\"slug\":\"variable-fonts\"},{\"id\":41,\"name\":\"Vector Sets\",\"slug\":\"vector-sets\"}]}},{\"id\":\"62463\",\"resolved\":true,\"title\":\"Paperline\",\"body\":\"$88\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Paperline is a portfolio template for designers and creative professionals who want to present their work in a clean, distinctive, and well-structured way. It combines an editorial layout with blueprint/engineering visual details, spacious composition, and polished case study presentation to create a personal site that feels both professional and memorable.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"The template is designed to help you showcase projects, introduce yourself clearly, and build a stronger visual identity online. It works especially well for product designers, UI/UX designers, digital creatives, art directors, and other professionals who want a portfolio with more character than a standard minimal layout.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Paperline features a strong landing section, carefully framed project previews, balanced typography, soft rounded containers, and mobile-ready screens that preserve the same visual quality across devices. The overall style feels modern, thoughtful, and slightly technical without becoming cold or overly complex.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"It is easy to customize and adapt to your own practice. You can quickly replace images, edit text, update case studies, adjust colors, and shape the template around your personal style or professional focus.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Whether you are building a first portfolio or refreshing an existing one, Paperline offers a solid and expressive starting point.\"}]}]},\"introduction\":\"Portfolio Website Template\",\"slug\":\"paperline\",\"author\":{\"framerUserId\":\"59237a1d-fe02-4c35-bdc9-7d757e8f1065\",\"name\":\"Iaroslav\",\"slug\":\"iaroslav-vinokurov\",\"avatar\":\"https://framerusercontent.com/avatars/users/59237a1d-fe02-4c35-bdc9-7d757e8f1065/z_6ikyLlr\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"video\",\"url\":\"https://stream.mux.com/bQp2800Xwi2V2whsNcW9vPb7RbtPQ8m16900V7HEVAom00.m3u8\",\"metadata\":{\"posterUrl\":\"https://image.mux.com/bQp2800Xwi2V2whsNcW9vPb7RbtPQ8m16900V7HEVAom00/thumbnail.webp?time=4.731\",\"aspectRatio\":\"4:3\",\"duration\":31.816667}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/templates/62463/paperline-xT4VcyO1ovobqOst07CNwjfU4fLEG1\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/templates/62463/paperline-DAU1LcVF0KFqNZXkhUlusLhk9xHn6g\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}