:\"Art \u0026 Design\",\"slug\":\"art-and-design\"},{\"id\":221,\"name\":\"Graphic Design\",\"slug\":\"graphic-design\"},{\"id\":218,\"name\":\"Free\",\"slug\":\"free-website-templates\"}],\"styles\":[{\"id\":236,\"name\":\"Light\",\"slug\":\"light\"},{\"id\":111,\"name\":\"Minimal\",\"slug\":\"minimal\"}],\"mainCategory\":{\"id\":19,\"name\":\"Portfolio\",\"slug\":\"portfolio\"},\"features\":[{\"id\":1,\"name\":\"Appear Effects\",\"slug\":\"appear-effects\"},{\"id\":17,\"name\":\"Sticky Scrolling\",\"slug\":\"sticky-scrolling\"},{\"id\":21,\"name\":\"CMS\",\"slug\":\"cms\"},{\"id\":30,\"name\":\"Forms\",\"slug\":\"forms\"},{\"id\":32,\"name\":\"Layout Templates\",\"slug\":\"layout-templates\"},{\"id\":35,\"name\":\"Text Effects\",\"slug\":\"text-effects\"},{\"id\":39,\"name\":\"Selection Styles\",\"slug\":\"selection-styles\"},{\"id\":41,\"name\":\"Vector Sets\",\"slug\":\"vector-sets\"}]}},{\"id\":\"71800\",\"resolved\":true,\"title\":\"Nocturna\",\"body\":\"$9a\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Live site →\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer\",\"href\":\"https://try-nocturna.framer.website/\",\"target\":\"_blank\"}},{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Nocturna is a Framer marketing template for SaaS products of any kind — analytics, dev tools, fintech, productivity, infrastructure, whatever you're building. Dark, monospace, built to feel technical and serious rather than soft and illustrative.\"}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"What makes Nocturna different\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"A full site, not just a landing page — 11 pages and 5 CMS collections covering product, pricing, blog, and legal, everything a SaaS company needs to launch\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Complete pricing system: monthly/annual toggle with a savings callout, three pricing cards, and a full comparison table so buyers can check every plan detail before they commit\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"CMS-powered blog, team, and legal pages — Privacy Policy, Terms of Service, and Cookie Policy content lives in the CMS, so updates never touch the design\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Complete customization guide included inside the Framer project\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"AI setup prompts included — generate content with your AI of choice, with automatic population available for supported tools\"}]}]}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Pages included\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Home — hero, product walkthrough, how it works, testimonials, pricing, FAQ\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Product — six feature blocks, each with an image and caption\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Pricing — plan comparison table plus a billing FAQ\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"About — company story, animated stats, team\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Contact — inquiry form\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Blog — CMS-powered post grid\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Privacy Policy, Terms of Service, Cookie Policy, 404\"}]}]}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Built for\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Any SaaS product that needs a complete marketing site with pricing, blog, and legal pages already built, and wants the whole thing to read as technical and serious rather than soft and illustrative.\"}]}]},\"introduction\":\"SaaS Template\",\"slug\":\"nocturna\",\"author\":{\"framerUserId\":\"c115ffd4-eb0a-48c2-b65d-ff77c528ed6d\",\"name\":\"Berci Hazman\",\"slug\":\"berci-hazman\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/593064/avatar-ozRXd9F9HrWvmhRm8oWbrCKbmbBbtj.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/c115ffd4-eb0a-48c2-b65d-ff77c528ed6d/01a0341c-923d-76c5-8fe0-67bb916f1ed6.png\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/c115ffd4-eb0a-48c2-b65d-ff77c528ed6d/01a0341c-922a-764f-8df3-05c1958ff506.png\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/c115ffd4-eb0a-48c2-b65d-ff77c528ed6d/01a0341c-922c-777a-a85a-3cc8d071dd7b.png\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/c115ffd4-eb0a-48c2-b65d-ff77c528ed6d/01a0341c-9255-70