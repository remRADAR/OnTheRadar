ug\":\"modern\"},{\"id\":111,\"name\":\"Minimal\",\"slug\":\"minimal\"},{\"id\":222,\"name\":\"Grid\",\"slug\":\"grid\"}],\"mainCategory\":{\"id\":3,\"name\":\"Agency\",\"slug\":\"agency\"},\"features\":[{\"id\":1,\"name\":\"Appear Effects\",\"slug\":\"appear-effects\"},{\"id\":18,\"name\":\"Scroll Effects\",\"slug\":\"scroll-effects\"},{\"id\":21,\"name\":\"CMS\",\"slug\":\"cms\"},{\"id\":32,\"name\":\"Layout Templates\",\"slug\":\"layout-templates\"},{\"id\":36,\"name\":\"3D Transforms\",\"slug\":\"3d-transforms\"}]}},{\"id\":\"71375\",\"resolved\":true,\"title\":\"Torque® Studio\",\"body\":\"$a1\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Live Preview\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer\",\"href\":\"https://torque.framer.media/\",\"target\":\"_blank\"}}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Stand out from first scroll and earn customer trust.\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Torque is a premium Framer template designed for digital creative studios, agencies, and ambitious businesses that want their website to feel as thoughtful as the work they deliver. With a refined visual system, intentional layouts, and distinctive interactions, it helps you present your services, projects, and expertise with clarity while creating a strong first impression.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Built with creative studios and agencies in mind, Torque is thoughtfully flexible enough for consulting firms, technology companies, professional services, and other modern businesses looking for a polished, high-converting online presence.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"What makes Torque stand out\"}],\"attrs\":{\"level\":2}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Premium, thoughtful design built to impress and build trust\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Two distinctive hero sections for different brand directions\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Scroll-based hero animation that creates an engaging first impression\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Project page with search and filters for easy portfolio discovery\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Blog page with filtering to organize and showcase your insights\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Dedicated services page with detailed service pages for deeper storytelling\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Structured layouts designed to communicate expertise and guide visitors toward action\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Flexible foundation that can be adapted beyond creative agencies and studios\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Everything you need to build a credible digital presence\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Every detail in Torque is designed with intention — from the visual hierarchy and interactions to the way information is presented. Whether you're running a creative studio, consulting business, or professional service, Torque gives you a premium foundation to look credible, communicate clearly, and convert more of the right visitors.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"If you need any help, feel free to reach out \"},{\"type\":\"mention\",\"attrs\":{\"id\":\"59b1a783-b1b1-4d0c-8788-c0b9532ff9ec\",\"slug\":\"aamir-saifi\",\"label\":\"Aamir Saifi\",\"mentionSuggestionChar\":\"@\"}},{\"type\":\"text\",\"text\":\" \"}]}]},\"introduction\":\"A Complete Studio/Agency Template\",\"slug\":\"torque-studio\",\"author\":{\"framerUserId\":\"59b1a783-b1b1-4d0c-8788-c0b9532ff9ec\",\"name\":\"Aamir Saifi\",\"slug\":\"aamir-saifi\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/590514/avatar-6pbIPrGtZyXVQBqqHedMVOHYMagb8i.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/59b1a783-b1b1-4d0c-8788-c0b9532ff9ec/01a00bb5-2750-727c-b308-d573bbdb9168.webp\",\"metadata\":{\"tint\":\"hsl(0 0% 33%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/59b1a783-b1b1-4d0c-8788-c0b9532ff9ec/01a00bb5-27e8-7560-8463-33d836e9537e.webp\",\"metadata\":{\"tint\":\"hsl(0 0% 33%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/59b1a783-b1b1-4d0c-8788-c0b9532ff9ec/01a00bb5-27f5-758c-a169-1a5b4de49fb4.webp\",\"metadata\":{\"tint\":\"hsl(0 0% 33%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/59b1a783-b1b1-4d0c-8788-c0b9532ff9ec/01a00bb5-2736-705a-a8ff-c01b86b1ba95.webp\",\"metadata\":{\"tint\":\"hsl(0 0% 33%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"01a00bb6-1153-77be-beb1-c60c78e95fbd\",\"bodyJson\":null,\"likes\":{\"count\":35,\"liked\":false},\"comments\":{\"count\":23},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-08-16T17:54:35.960Z\",\"updatedAt\":\"2026-08-19T13:02:52.033Z\",\"publishedAt\":\"2026-08-16T