Json\":null,\"likes\":{\"count\":515,\"liked\":false},\"comments\":{\"count\":47},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-04-06T18:08:00.115Z\",\"updatedAt\":\"2026-08-24T06:44:40.760Z\",\"publishedAt\":\"2026-04-29T11:47:46.250Z\",\"featuredAt\":\"2026-06-19T09:28:41.408Z\",\"reported\":false,\"approvedAt\":\"2026-06-01T14:46:12.987Z\",\"type\":\"template\",\"attributes\":{\"price\":\"129\",\"paymentUrl\":\"https://templifica.com/checkout/mattis\",\"remixUrl\":null,\"previewUrl\":\"https://mattis.framer.website/\",\"categories\":[{\"id\":19,\"name\":\"Portfolio\",\"slug\":\"portfolio\"},{\"id\":221,\"name\":\"Graphic Design\",\"slug\":\"graphic-design\"},{\"id\":263,\"name\":\"Video\",\"slug\":\"video\"}],\"styles\":[{\"id\":247,\"name\":\"Professional\",\"slug\":\"professional\"},{\"id\":110,\"name\":\"Animated\",\"slug\":\"animated\"},{\"id\":111,\"name\":\"Minimal\",\"slug\":\"minimal\"},{\"id\":193,\"name\":\"Black \u0026 White\",\"slug\":\"black-and-white\"},{\"id\":222,\"name\":\"Grid\",\"slug\":\"grid\"}],\"mainCategory\":{\"id\":3,\"name\":\"Agency\",\"slug\":\"agency\"},\"features\":[{\"id\":1,\"name\":\"Appear Effects\",\"slug\":\"appear-effects\"},{\"id\":9,\"name\":\"Overlays \u0026 Modals\",\"slug\":\"overlays-modals\"},{\"id\":13,\"name\":\"Slideshows/Tickers\",\"slug\":\"slideshows-tickers\"},{\"id\":18,\"name\":\"Scroll Effects\",\"slug\":\"scroll-effects\"},{\"id\":21,\"name\":\"CMS\",\"slug\":\"cms\"},{\"id\":23,\"name\":\"Rich Media\",\"slug\":\"rich-media\"},{\"id\":24,\"name\":\"Site Search\",\"slug\":\"site-search\"},{\"id\":30,\"name\":\"Forms\",\"slug\":\"forms\"},{\"id\":32,\"name\":\"Layout Templates\",\"slug\":\"layout-templates\"},{\"id\":35,\"name\":\"Text Effects\",\"slug\":\"text-effects\"},{\"id\":37,\"name\":\"Code Components\",\"slug\":\"code-components\"}]}},{\"id\":\"54074\",\"resolved\":true,\"title\":\"Palmer\",\"body\":\"$66\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Live Preview\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer\",\"href\":\"https://palmer-template.framer.website/\",\"target\":\"_blank\"}}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Palmer is a remarkable portfolio \u0026 agency template crafted to enhance your portfolio's or agency's presentation. It’s an ideal portfolio solution for designers, freelancers, creative agencies, digital agencies, photographers, or anyone in the creative industry who wants to showcase their portfolio or agency's in a clean and sophisticated way. The minimal design keeps the focus entirely on your portfolio or agency, allowing the work to speak for itself.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Whether you're building your first portfolio or looking to refresh your existing one, Palmer offers the perfect balance of simplicity and elegance. Its portfolio-centric layout ensures that every project in your portfolio or agency stands out, free from unnecessary clutter. This template is designed for professionals who value the importance of a well-curated portfolio and agency, helping to make a lasting impression on clients and employers. If you're looking for a powerful and stylish way to present your portfolio or agency, Palmer is the ideal choice to take your portfolio or agency to the next level.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"For anyone serious about their portfolio, Palmer provides everything needed to create a striking portfolio or agency's that commands attention.\"}]}]},\"introduction\":\"Minimal Portfolio \u0026 Dark Portfolio\",\"slug\":\"palmer\",\"author\":{\"framerUserId\":\"5bc99235-3235-4f92-aff4-e2932ca7af74\",\"name\":\"Westhill Studio\",\"slug\":\"westhill-studio\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/29059/Dark%20logo-9sDWVbDyIvubCoiI69qjDKupxAVZGJ.png\