{\"type\":\"bold\"}]},{\"type\":\"emoji\",\"attrs\":{\"name\":\"point_down\",\"emoji\":\"👇\"}}]}]},\"likes\":{\"count\":231,\"liked\":false},\"comments\":{\"count\":12},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-07-28T10:27:50.042Z\",\"updatedAt\":\"2026-07-28T10:27:50.042Z\",\"publishedAt\":\"2026-07-28T10:27:50.026Z\",\"featuredAt\":\"2026-07-28T13:21:26.876Z\",\"reported\":false,\"approvedAt\":null,\"type\":\"template\",\"attributes\":{\"price\":null,\"paymentUrl\":\"https://framer.link/sHDR05y\",\"remixUrl\":\"https://framer.link/sHDR05y\",\"previewUrl\":\"https://liam-bennet.framer.website/\",\"categories\":[{\"id\":107,\"name\":\"Resume\",\"slug\":\"resume-cv\"},{\"id\":16,\"name\":\"Personal\",\"slug\":\"personal\"},{\"id\":17,\"name\":\"Photography\",\"slug\":\"photography\"},{\"id\":19,\"name\":\"Portfolio\",\"slug\":\"portfolio\"},{\"id\":188,\"name\":\"Art \u0026 Design\",\"slug\":\"art-and-design\"},{\"id\":221,\"name\":\"Graphic Design\",\"slug\":\"graphic-design\"},{\"id\":218,\"name\":\"Free\",\"slug\":\"free-website-templates\"}],\"styles\":[{\"id\":247,\"name\":\"Professional\",\"slug\":\"professional\"},{\"id\":208,\"name\":\"Dark\",\"slug\":\"dark\"}],\"mainCategory\":{\"id\":19,\"name\":\"Portfolio\",\"slug\":\"portfolio\"},\"features\":[{\"id\":1,\"name\":\"Appear Effects\",\"slug\":\"appear-effects\"},{\"id\":9,\"name\":\"Overlays \u0026 Modals\",\"slug\":\"overlays-modals\"},{\"id\":21,\"name\":\"CMS\",\"slug\":\"cms\"},{\"id\":30,\"name\":\"Forms\",\"slug\":\"forms\"},{\"id\":37,\"name\":\"Code Components\",\"slug\":\"code-components\"},{\"id\":40,\"name\":\"Variable Fonts\",\"slug\":\"variable-fonts\"}]}},{\"id\":\"71167\",\"resolved\":true,\"title\":\"“Untitled.”\",\"body\":\"$ac\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"\\\"Untitled.\\\" — Launch your filmmaker portfolio in hours, not weeks\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"\\\"Untitled.\\\" is a premium Framer portfolio template built for filmmakers, videographers, directors, cinematographers, and motion designers who want a portfolio that gets out of the way and lets their work do the talking.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Designed with a minimal, dark aesthetic, \\\"Untitled.\\\" strips away everything unnecessary, leaving only what matters: your reel, your work, and your story. No distractions. No clutter. Just a stage built for visual storytelling.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"What makes \\\"Untitled.\\\" different?\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"It's not just a template. It's a complete portfolio system built specifically for the film industry.\"}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Minimal, cinematic design. A clean visual language that puts your work front and center, without competing with it.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Built for the film world. Every detail, from typography to layout, is crafted with filmmakers in mind, not adapted from a generic template.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"CMS-powered work showcase. Easily manage your projects with a fully integrated CMS. Add, update, or remove work without touching any code.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Setup walkthrough video. A step-by-step video guide walks you through customizing the template, connecting your domain, and going live, fast.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"SEO-ready and performance optimized. Built on Framer for blazing fast load times and clean structure that search engines love.\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Free customization tutorial\",\"marks\":[{\"type\":\"bold\"}]}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Every purchase includes a full walkthrough video, hosted right on my website. It walks you through customizing every part of the template, connecting your own domain, and publishing your site, so you're never stuck figuring things out on your own.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Click here to access \"},{\"type\":\"text\",\"text\":\"Free Customization Tutorial\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer\",\"href\":\"https://titarvldesign.framer.website/works/%E2%80%9Cuntitled.%E2%80%9D\",\"target\":\"_blank\"}}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Pages included\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Core pages\"}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Home\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Work Grid (CMS)\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Work List (CMS)\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"About\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Work Detail (CMS)\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Contact\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Privacy Policy\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Terms of Use\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"404\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Features used\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"3D Transforms, Appear Effects, CMS, Code Components, Custom Cursors, Forms, Layout Templates, Overlays \u0026 Modals, Scroll Effects, Selection Styles, Sticky Scrolling, Text Effects\"}]}]},\"introduction\":\"Premium Portfolio for Filmmakers\",\"slug\":\"untitled\",\"author\":{\"framerUserId\":\"6374d0ef-29c2-4d62-a562-a8e4857e9e0b\",\"name\":\"Titarvl\",\"slug\":\"titarvl\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/1333452/avatar-ZhX58RcEIUKvj8bpdX7kku6oMbffwS.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"video\",\"url\":\"https://stream.mux.com/WTml02WaEvXMEQA5eLbIQdaPzdeEXpidF00kVLMGihIzU.m3u8\",\"metadata\":{\"posterUrl\":\"https://image.mux.com/WTml02WaEvXMEQA5eLbIQdaPzdeEXpidF00kVLMGihIzU/thumbnail.webp?time=1.32\",\"aspectRatio\":\"4:3\",\"duration\":9.68}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/6374d0ef-29c2-4d62-a562-a8e4857e9e0b/019ff6b1-cda5-70fb-911d-72340df2c011.png\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/6374d0ef-29c2-4d62-a562-a8e4857e9e0b/019ff6b1-dd2a-74b7-b79d-b1773de1f51c.png\",\"metadata\":{\"tint\":\"hsl(0 40% 16%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/6374d0ef-29c2-4d62-a562-a8e4857e9e0b/019ff6b2-43ef-70a9-9365-c73153a274a9.png\",\