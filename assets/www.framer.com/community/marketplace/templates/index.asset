ull,\"type\":\"template\",\"attributes\":{\"price\":null,\"paymentUrl\":\"https://framer.link/xTN2cY3\",\"remixUrl\":\"https://framer.link/xTN2cY3\",\"previewUrl\":\"https://foldex.framer.website/\",\"categories\":[{\"id\":16,\"name\":\"Personal\",\"slug\":\"personal\"},{\"id\":17,\"name\":\"Photography\",\"slug\":\"photography\"},{\"id\":19,\"name\":\"Portfolio\",\"slug\":\"portfolio\"},{\"id\":188,\"name\":\"Art \u0026 Design\",\"slug\":\"art-and-design\"},{\"id\":221,\"name\":\"Graphic Design\",\"slug\":\"graphic-design\"},{\"id\":218,\"name\":\"Free\",\"slug\":\"free-website-templates\"}],\"styles\":[{\"id\":247,\"name\":\"Professional\",\"slug\":\"professional\"},{\"id\":222,\"name\":\"Grid\",\"slug\":\"grid\"}],\"mainCategory\":{\"id\":19,\"name\":\"Portfolio\",\"slug\":\"portfolio\"},\"features\":[{\"id\":1,\"name\":\"Appear Effects\",\"slug\":\"appear-effects\"},{\"id\":17,\"name\":\"Sticky Scrolling\",\"slug\":\"sticky-scrolling\"},{\"id\":21,\"name\":\"CMS\",\"slug\":\"cms\"},{\"id\":23,\"name\":\"Rich Media\",\"slug\":\"rich-media\"},{\"id\":30,\"name\":\"Forms\",\"slug\":\"forms\"},{\"id\":32,\"name\":\"Layout Templates\",\"slug\":\"layout-templates\"},{\"id\":37,\"name\":\"Code Components\",\"slug\":\"code-components\"},{\"id\":39,\"name\":\"Selection Styles\",\"slug\":\"selection-styles\"},{\"id\":40,\"name\":\"Variable Fonts\",\"slug\":\"variable-fonts\"}]}},{\"id\":\"63875\",\"resolved\":true,\"title\":\"Whitman\",\"body\":\"\u003cp\u003eWhitman is a video portfolio website template made to make your work feel instantly more expensive, cinematic, and unforgettable. It turns films, campaigns, music videos, brand stories, and client projects into a high-end showcase that makes visitors stop, watch, and take you seriously.\u003c/p\u003e\u003cp\u003eEvery part of Whitman is built to sell your creative value. Big project previews create instant impact, minimal layouts make your work feel premium, and smooth interactions give the whole site a polished studio-level feeling. Instead of simply showing what you’ve made, Whitman makes your portfolio feel like a curated visual experience – the kind clients remember long after viewing.\u003c/p\u003e\u003cp\u003eFor filmmakers, videographers, directors, editors, production studios, and visual creators, Whitman helps your best work look sharper, your brand feel stronger, and your next opportunity feel closer with a more professional presence.\u003c/p\u003e\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Whitman is a video portfolio website template made to make your work feel instantly more expensive, cinematic, and unforgettable. It turns films, campaigns, music videos, brand stories, and client projects into a high-end showcase that makes visitors stop, watch, and take you seriously.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Every part of Whitman is built to sell your creative value. Big project previews create instant impact, minimal layouts make your work feel premium, and smooth interactions give the whole site a polished studio-level feeling. Instead of simply showing what you’ve made, Whitman makes your portfolio feel like a curated visual experience – the kind clients remember long after viewing.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"For filmmakers, videographers, directors, editors, production studios, and visual creators, Whitman helps your best work look sharper, your brand feel stronger, and your next opportunity feel closer with a more professional presence.\"}]}]},\"introduction\":\"Video Portfolio\",\"slug\":\"whitman\",\"author\":{\"framerUserId\":\"4b25900a-f920-4deb-8c53-760a3b72d42c\",\"name\":\"NutsDev\",\"slug\":\"nutsdev\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/28855/avatar-Du0DMMPMOJiAYpJ8Am0xmXgZt8Oa49.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":