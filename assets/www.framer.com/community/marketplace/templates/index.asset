":false,\"approvedAt\":null,\"type\":\"template\",\"attributes\":{\"price\":null,\"paymentUrl\":\"/assets/framer.com/projects/index.assetnew?duplicate=5PqR2f5speXvPl1RSk0A\u0026via=designepulsar\",\"remixUrl\":\"/assets/framer.com/projects/index.assetnew?duplicate=5PqR2f5speXvPl1RSk0A\u0026via=designepulsar\",\"previewUrl\":\"https://td-maxfolio.framer.website/\",\"categories\":[{\"id\":16,\"name\":\"Personal\",\"slug\":\"personal\"},{\"id\":19,\"name\":\"Portfolio\",\"slug\":\"portfolio\"},{\"id\":218,\"name\":\"Free\",\"slug\":\"free-website-templates\"}],\"styles\":[{\"id\":236,\"name\":\"Light\",\"slug\":\"light\"},{\"id\":109,\"name\":\"Modern\",\"slug\":\"modern\"},{\"id\":110,\"name\":\"Animated\",\"slug\":\"animated\"},{\"id\":208,\"name\":\"Dark\",\"slug\":\"dark\"},{\"id\":222,\"name\":\"Grid\",\"slug\":\"grid\"}],\"mainCategory\":{\"id\":19,\"name\":\"Portfolio\",\"slug\":\"portfolio\"},\"features\":[{\"id\":1,\"name\":\"Appear Effects\",\"slug\":\"appear-effects\"},{\"id\":7,\"name\":\"Light \u0026 Dark Theme\",\"slug\":\"light-dark-theme\"},{\"id\":17,\"name\":\"Sticky Scrolling\",\"slug\":\"sticky-scrolling\"},{\"id\":21,\"name\":\"CMS\",\"slug\":\"cms\"}]}},{\"id\":\"70698\",\"resolved\":true,\"title\":\"Videofolio\",\"body\":\"$85\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"The Best Videography Video Portfolio Framer Template for Videographer, Video Editor and Video Services.\"}],\"attrs\":{\"level\":1}},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Live Preview\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer\",\"href\":\"https://video-folio.framer.website/\",\"target\":\"_blank\"}},{\"type\":\"bold\"}]}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"A professional video portfolio website designed for videographer portfolio, filmmaker portfolio, cinematographer portfolio, video editor portfolio, directors, 3D artist portfolio, motion graphic designer portfolio, animator portfolio, VFX artists, photographers, creative agencies, production companies, and video production studios. This modern portfolio template gives visual creators a professional space to showcase selected work, featured projects, showreels, case studies, creative services, client testimonials, and project details.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"The flexible portfolio layout is ideal for a videographer portfolio, filmmaker portfolio, cinematographer portfolio, video editor portfolio, director portfolio, 3D artist portfolio, motion graphic designer portfolio, motion designer portfolio, animator portfolio, VFX artist portfolio, photographer portfolio, creative studio portfolio, production company portfolio, and video production studio portfolio.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Built for freelance videographers, independent filmmakers, professional cinematographers, video editors, 3D designers, CGI artists, motion designers, visual effects artists, creative directors, production houses, animation studios, film studios, and full-service video production companies, this creative portfolio website helps every project look polished, organized, and memorable.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Showcase your professional experience, creative process, portfolio projects, recent work, featured work, selected projects, project galleries, showreels, client collaborations, awards etc.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"This video portfolio template is suitable for personal portfolios, freelance portfolios, studio portfolios, agency portfolios, creative portfolios, filmmaker websites, videographer websites, cinematographer websites, motion design websites, 3D artist websites, animation studio websites, production compa