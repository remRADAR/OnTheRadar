ideshows-tickers\"},{\"id\":18,\"name\":\"Scroll Effects\",\"slug\":\"scroll-effects\"},{\"id\":21,\"name\":\"CMS\",\"slug\":\"cms\"},{\"id\":25,\"name\":\"Custom Cursors\",\"slug\":\"custom-cursors\"},{\"id\":30,\"name\":\"Forms\",\"slug\":\"forms\"},{\"id\":35,\"name\":\"Text Effects\",\"slug\":\"text-effects\"},{\"id\":37,\"name\":\"Code Components\",\"slug\":\"code-components\"},{\"id\":39,\"name\":\"Selection Styles\",\"slug\":\"selection-styles\"},{\"id\":41,\"name\":\"Vector Sets\",\"slug\":\"vector-sets\"}]}},{\"id\":\"69959\",\"resolved\":true,\"title\":\"Macxfolio\",\"body\":\"$94\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Macxfolio\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"emoji\",\"attrs\":{\"name\":\"registered\",\"emoji\":\"®\"}},{\"type\":\"text\",\"text\":\" | Premium macOS Portfolio Framer Template\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Create a memorable portfolio with \"},{\"type\":\"text\",\"text\":\"Macxfolio\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"emoji\",\"attrs\":{\"name\":\"registered\",\"emoji\":\"®\"}},{\"type\":\"text\",\"text\":\", a premium Framer portfolio template inspired by the iconic macOS experience. Designed for designers, developers, creatives, freelancers, and agencies, it transforms your portfolio into an immersive desktop-inspired website with modern animations, interactive elements, and a polished glassmorphism interface. Showcase projects, blogs, resources, resume, and personal information through a unique browsing experience while maintaining excellent performance, responsiveness, and SEO.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"sparkles\",\"emoji\":\"✨\"}},{\"type\":\"text\",\"text\":\" Key Features\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Authentic macOS-inspired desktop interface\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Interactive macOS Dock\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Interactive desktop experience\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Customizable playful pet cursor\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Live Cat Herding mini game\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Built-in music player\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"CMS-powered Projects\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"CMS-powered Blog\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"CMS-powered Resources\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Resume page\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"About page\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Contact page\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Movies \u0026 Series section\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Modern Glassmorphism UI\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Smooth page transitions \u0026 overlays\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\"