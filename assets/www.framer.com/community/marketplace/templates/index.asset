:41,\"name\":\"Vector Sets\",\"slug\":\"vector-sets\"}]}},{\"id\":\"57894\",\"resolved\":true,\"title\":\"Manner\",\"body\":\"$75\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Live Preview →\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer\",\"href\":\"https://manner.framer.website/\",\"target\":\"_blank\"}},{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Manner avoids visual noise and short lived trends, so visitors quickly understand who you are, what you do, and why it matters.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"What makes Manner different?\"}],\"attrs\":{\"level\":2}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Clarity First :- \",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\"Clear layouts and strong hierarchy guide visitors through your work, services, and process with ease.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Focused Presentation:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\"-\"},{\"type\":\"text\",\"text\":\" \",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\"No gimmicks or unnecessary effects. A clean, considered structure that lets your work speak for itself.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Proven Agency Structure:- \",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\"Built around how real agencies and studios present themselves, not experimental or trend driven layouts.\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Whether you’re a designer, agency, or studio, Manner gives you the tools to build a site that clearly represents your work, expertise, and brand.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Pages Included\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Home:- \",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\"A structured landing page that introduces your studio and highlights key work.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Studio / About:- \",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\"Share your story, values, and approach with clarity.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Work (CMS):- \",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\"A flexible system for showcasing case studies and selected projects.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"News (CMS):- \",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\"Publish updates, articles, or insights using a scalable layout.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Contact \u0026 Legal Pages:- \",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\"Everything needed for a complete, professional website.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Changelog\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"1.0\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Intial release\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"1.1\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Added a more robust Services section for greater flexibility\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Fixed an issue where the header occasionally did not appear in Safari\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"1.2\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Replaced Smooth Scroll with Lenis for better performance.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"1.3\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Added a more comprehensive setup guide\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"1.4\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Reworked the entire CMS system to make it more robust and scalable than ever.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Added video support with compatibility for file formats like WebM and MP4.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Contact\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Need help using the template or want to share feedback? Reach out via \"},{\"type\":\"text\",\"text\":\"email chayanp188@gmail.com\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"mailto:chayanp188@gmail.com\",\"class\":null,\"target\":\"_blank\"}}]}]}]},\"introduction\":\"Design Studio \u0026 Agency\",\"slug\":\"manner\",\"author\":{\"framerUserId\":\"4eda6286-3439-4556-868b-5db8cb4e1cfb\",\"name\":\"Chayan Panda\",\"slug\":\"chayan-panda\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/48154/avatar-31RE1b0Y5DrBEF7qcIrOrrWC6Qsud8.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/templates/57894/manner-eM0v3WSv1hazgIC1pttwJ36Nx6WsAJ\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/templates/57894/manner-Ogf2UmIAyqqSCSgE43lrs75RfjskcN\",\"metadata\":{\"tint\":\"hsl(0 0% 58%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019aef07-1522-79f3-ba95-52ab6ae986af\",\"bodyJson\":null,\"likes\":{\"count\":163,\"liked\":false},\"comments\":{\"count\":4},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2025-11-12T05:54:30.628Z\",\"updatedAt\":\"2026-08-27T03:15:18.671Z\",\"publishedAt\":\"2025-12-05T15:00:10.146Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":\"2026-06-01T14:46:12.987Z\",\"type\":\"template\",\"attributes\":{\"price\":\"49\",\"paymentUrl\":\"https://dub.sh/get-manner\",\"remixUrl\":null,\"previewUrl\":\"https://manner.framer.website/\",\"categories\":[{\"id\":3,\"name\":\"Agency\",\"slug\":\"agency\"},{\"id\":19,\"name\":\"Portfolio\",\"slug\":\"portfolio\"},{\"id\":221,\"name\":\"Graphic Design\",\"slug\":\"graphic-design\"}],\"styles\":[{\"id\":234,\"name\":\"Large Type\",\"slug\":\"large-type\"},{\"id\":261,\"name\":\"Typographic\",\"slug\":\"typographic\"},{\"id\":239,\"name\":\"Monochromatic\",\"slug\":\"monochromatic\"},{\"id\":111,\"name\":\"Minimal\",\"slug\":\"minimal\"},{\"id\":193,\"name\":\"Black \u0026 White\",\"slug\":\"black-and-white\"}],\"mainCategory\":{\"id\":3,\"name\":\"Agency\",\"slug\":\"agency\"},\"features\":[{\"id\":1,\"name\":\"Appear Effects\",\"slug\":\"appear-effects\"},{\"id\":18,\"name\":\"Scroll Effects\",\"slug\":\"scroll-effects\"},{\"id\":21,\"name\":\"CMS\",\"slug\":\"cms\"},{\"id\":23,\"name\":\"Rich Media\",\"slug\":\"rich-media\"},{\"id\":25,\"name\":\"Custom Cursors\",\"slug\":\"custom-cursors\"},{\"id\":30,\"name\":\"Forms\",\"slug\":\"forms\"},{\"id\":32,\"name\":\"Layout Templates\",\"slug\":\"layout-templates\"}]}},{\"id\":\"45431\",\"resolved\":true,\"title\":\"Cohesion\",\"body\":\"$76\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Cohesion\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" is a Framer template for agencies, portfolios and personal brands. It pairs minimalist layout with dynamic motion, so the work stays centre stage while transitions, 3D elements and custom cursors carry the personality.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Pages:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Home, Licensing and 404, plus CMS-driven project and legal templates. It also ships a full member area wired to FramerAuth V2: Sign in, Sign up, Forgot password, Reset password and Account. The homepage runs a ticker hero with a 3D element and memoji, rotating stack text, skills and about cards, a tools and stack logo row, services, the project collection, and a testimonials slider.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"2 CMS collections\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Projects:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" title, date, client, category, duration, three images, live website link, a configurable buy or remix button with custom label, short and long content, and a meta description for SEO\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Legal:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" title and formatted content, rendered through the legal page template\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Everything else is built as reusable components, so the CMS stays light. Add a project and the collection stack, cards and detail page populate from one entry.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Who it's for\",\"marks\":[{\"type\":\"bold\"}]}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Freelancers and independent designers presenting a small, strong body of work. Studios and agencies wanting a single-page site with real motion. Personal brands who need a portfolio plus licensing and account pages without a heavy CMS to maintain.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Not the right fit if you need a blog, multi-author content or deep case study structure.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Why Cohesion?\",\"marks\":[{\"type\":\"bold\"}]}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"The animation does actual work here. Sticky scroll sections, tickers, a slideshow, 3D and custom cursors are built in rather than bolted on, and Public Sans keeps the typography clean underneath. Accessibility, SEO and responsive layouts are handled, colour and text styles are defined throughout, and the FramerAuth pages mean gated or client-only areas are ready if you want them.\"}]}]},\"introduction\":\"Dynamic Animated Portfolio\",\"slug\":\"cohesion\",\"author\":{\"framerUserId\":\"a0d236b2-97bf-42fd-ad0e-db4402ef113b\",\"name\":\"Cristian Mielu\",\"slug\":\"cristian\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/28883/avatar-K5ojCTv2bAJrkxuByVEiWGqgqe7d73.jpg\",\"badges\":[\"pro\"],\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"video\",\"url\":\"https://stream.mux.com/tJWZKSUYLehBxqecm7oBrdfwGONVBShV02PR102vv7x9w.m3u8\",\"metadata\":{\"posterUrl\":\"https://image.mux.com/tJWZKSUYLehBxqecm7oBrdfwGONVBShV02PR102vv7x9w/thumbnail.webp?time=2.167\",\"aspectRatio\":\"4:3\",\"duration\":30.309333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/templates/45431/cohesion-uNEIatuYhYkmAxPbHHh5Q2HARjnv6H\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/templates/45431/cohesion-1kptSxW6ozpd0eWxty22O3jgOFAU2p\",\"metadata\":{\"tint\":\"hsl(0 0% 24%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/templates/45431/cohesion-oMZwzhg9PKaFnMGYanzDUAppNn3oLM\",\"metadata\":{\"tint\":\"hsl(0 0% 58%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"018f197f-667f-73e7-bf70-ff35f29d0945\",\"bodyJson\":null,\"likes\":{\"count\":1117,\"liked\":false},\"comments\":{\"count\":23},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2024-07-05T08:54:22.148Z\",\"updatedAt\":\"2026-08-28T13:29:37.672Z\",\"publishedAt\":\"2024-04-26T00:00:00.000Z\",\"featuredAt\":\"2026-06-19T09:26:07.629Z\",\"reported\":false,\"approvedAt\":null,\"type\":\"template\",\"attributes\":{\"price\":null,\"paymentUrl\":\"https://framer.link/SW15EBF\",\"remixUrl\":\"https://framer.link/SW15EBF\",\"previewUrl\":\"https://cohesion.framer.ai/\",\"categories\":[{\"id\":16,\"name\":\"Personal\",\"slug\":\"personal\"},{\"id\":19,\"name\":\"Portfolio\",\"slug\":\"portfolio\"},{\"id\":218,\"name\":\"Free\",\"slug\":\"free-website-templates\"}],\"styles\":[{\"id\":236,\"name\":\"Light\",\"slug\":\"light\"},{\"id\":109,\"name\":\"Modern\",\"slug\":\"modern\"},{\"id\":110,\"name\":\"Animated\",\"slug\":\"animated\"},{\"id\":6,\"name\":\"3D\",\"slug\":\"3d\"},{\"id\":201,\"name\":\"Colorful\",\"slug\":\"colorful\"}],\"mainCategory\":{\"id\":3,\"name\":\"Agency\",\"slug\":\"agency\"},\"features\":[{\"id\":1,\"name\":\"Appear Effects\",\"slug\":\"appear-effects\"},{\"id\":13,\"name\":\"Slideshows/Tickers\",\"slug\":\"slideshows-tickers\"},{\"id\":17,\"name\":\"Sticky Scrolling\",\"slug\":\"sticky-scrolling\"},{\"id\":18,\"name\":\"Scroll Effects\",\"slug\":\"scroll-effects\"},{\"id\":25,\"name\":\"Custom Cursors\",\"slug\":\"custom-cursors\"},{\"id\":32,\"name\":\"Layout Templates\",\"slug\":\"layout-templates\"}]}},{\"id\":\"54831\",\"resolved\":true,\"title\":\"Bartix\",\"body\":\"$77\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"art\",\"emoji\":\"🎨\"}},{\"type\":\"text\",\"text\":\" F