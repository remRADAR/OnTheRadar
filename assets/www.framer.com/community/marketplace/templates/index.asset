yout Templates\",\"slug\":\"layout-templates\"},{\"id\":35,\"name\":\"Text Effects\",\"slug\":\"text-effects\"},{\"id\":36,\"name\":\"3D Transforms\",\"slug\":\"3d-transforms\"},{\"id\":37,\"name\":\"Code Components\",\"slug\":\"code-components\"},{\"id\":39,\"name\":\"Selection Styles\",\"slug\":\"selection-styles\"}]}},{\"id\":\"58675\",\"resolved\":true,\"title\":\"Studio Think\",\"body\":\"$ad\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"customHeading\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"point_right\",\"emoji\":\"👉\"}},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"Live Preview\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer\",\"href\":\"https://studiothink.framer.website/\",\"target\":\"_blank\"}}]}],\"attrs\":{\"level\":2}},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Introducing Studio Think\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Studio Think is a high-performance agency template that transforms thoughtful design into compelling stories through an analog aesthetic that converts visitors into believers.\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Inspired by the spirit of traditional design workshops, this template captures the moment when pencil meets paper, ideas are sketched out, refined through iteration, and carefully developed into polished work. It's designed for creative professionals who want to showcase not just their final output, but the deliberate process behind it.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"What makes Studio Think different?\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- Analog meets digital: Craft paper textures and tactile details create an intimate, human-centred experience.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- Designed for storytelling: Invites visitors to slow down, explore, and understand the thought behind your work.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- Conversion-Optimized: Strategic CTAs, social proof sections, and clear service breakdowns guide visitors toward booking calls.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- Launch-Ready Structure: Pre-built pages and sections let you go live in hours with a professional, client-ready website.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Pages included:\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- Home Page: A warm, craft-focused landing experience with tactile imagery and smooth animations that invite exploration\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- About: Tell your story with authenticity and showcase the philosophy behind your work.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- Works/Portfolio: An elegantly organized gallery that lets your best projects shine.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- Individual Project Pages: Dedicated case study layouts that turn portfolio pieces into compelling narratives.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- Contact: A clean, frictionless way for potential clients to reach out and start a conversation.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Features:\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- Analog aesthetic. \"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- Stunning animation.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- CMS.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- SEO optimized.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- Lifetime Free Support\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- Lifetime Free Updates\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Have questions? Reach out to us at \"},{\"type\":\"text\",\"text\":\"hello@huehaus.design\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"mailto:hello@huehaus.design\",\"class\":null,\"target\":\"_blank\"}}]},{\"type\":\"text\",\"text\":\" and we'll be happy to help you get started. \"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Refund Policy: Due to the nature of digital products, all sales are final and no refunds will be issued.\"}]}]},\"introduction\":\"Analog Studio Template\",\"slug\":\"studio-think\",\"author\":{\"framerUserId\":\"75daa66e-f6ac-40cc-a657-fc512991d883\",\"name\":\"Huehaus Studio\",\"slug\":\"huehaus-studio\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/34299/avatar-bp3mzKKtnuZkwx4x5jOPkcGyYw2xUX.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/templates/58675/studio-think-TxJQqsIwYjjBk56juW4kstl1ZLzaWX\",\"metadata\":{\"tint\":\"hsl(60 53% 39%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/templates/58675/studio-think-lSrv1BSgl8qMMLwfapAxfBzKGOvs3L\",\"metadata\":{\"tint\":\"hsl(60 53% 39%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019b12fa-dace-78e2-9c57-80c8e0756d84\",\"bodyJson\":null,\"likes\":{\"count\":233,\"liked\":false},\"comments\":{\"count\":6},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2025-12-10T21:53:06.981Z\",\"updatedAt\":\"2026-08-07T17:34:52.090Z\",\"publishedAt\":\"2025-12-12T14:33:08.558Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":\"2026-06-01T14:46:12.987Z\",\"type\":\"template\",\"attributes\":{\"price\":\"49\",\"paymentUrl\":\"https://buy.polar.sh/polar_cl_KTJ6KGSPJlDq8Ta5W3dHalxTysxBwzKpDjxm83ZIs4u\",\"remixUrl\":null,\"previewUrl\":\"https://studiothink.framer.website/\",\"categories\":[{\"id\":3,\"name\":\"Agency\",\"slug\":\"agency\"},{\"id\":16,\"name\":\"Personal\",\"slug\":\"personal\"},{\"id\":19,\"name\":\"Portfolio\",\"slug\":\"portfolio\"}],\"styles\":[{\"id\":261,\"name\":\"Typographic\",\"slug\":\"typographic\"},{\"id\":236,\"name\":\"Light\",\"slug\":\"light\"},{\"id\":243,\"name\":\"Pastel\",\"slug\":\"pastel\"},{\"id\":222,\"name\":\"Grid\",\"slug\":\"grid\"},{\"id\":251,\"name\":\"Retro\",\"slug\":\"retro\"}],\"mainCategory\":{\"id\":3,\"name\":\"Agency\",\"slug\":\"agency\"},\"features\":[{\"id\":1,\"name\":\"Appear Effects\",\"slug\":\"appear-effects\"},{\"id\":9,\"name\":\"Overlays \u0026 Modals\",\"slug\":\"overlays-modals\"},{\"id\":13,\"name\":\"Slideshows/Tickers\",\"slug\":\"slideshows-tickers\"},{\"id\":17,\"name\":\"Sticky Scrolling\",\"slug\":\"sticky-scrolling\"},{\"id\":18,\"name\":\"Scroll Effects\",\"slug\":\"scroll-effects\"},{\"id\":21,\"name\":\"CMS\",\"slug\":\"cms\"},{\"id\":23,\"name\":\"Rich Media\",\"slug\":\"rich-media\"},{\"id\":25,\"name\":\"Custom Cursors\",\"slug\":\"custom-cursors\"},{\"id\":30,\"name\":\"Forms\",\"slug\":\"forms\"},{\"id\":32,\"name\":\"Layout Templates\",\"slug\":\"layout-templates\"},{\"id\":35,\"name\":\"Text Effects\",\"slug\":\"text-effects\"},{\"id\":37,\"name\":\"Code Components\",\"slug\":\"code-components\"},{\"id\":39,\"name\":\"Selection Styles\",\"slug\":\"selection-styles\"}]}},{\"id\":\"67866\",\"resolved\":true,\"title\":\"Tabfolio\",\"body\":\"$ae\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Tabfolio Pro (New)\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"/assets/www.framer.com/community/marketplace/templates/index.assettabfolio-pro/?via=framewave\",\"target\":\"_blank\"}}]}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Tabfolio is a modern and flexible Framer portfolio template designed for product designers, UX designers, researchers, and creative professionals who want to showcase their work through detailed and structured case studies. \"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"It's built around Framer CMS, which is more advanced than typical templates and gives you the flexibility to choose how many sections you add and even use components within the CMS itself, all while staying consistent and easy to maintain.\"}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Perfect for\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Product Designers\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"UX/UI Designers\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Researchers\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Freelancers\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Design Students\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Creative Professionals\"}]}]}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"What's Included\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"CMS-powered (but still flexible) case studies\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Animated backgrounds\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"About me page\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Dynamic resume\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Template guide\"}]},{\"type\":\"paragraph\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Built for Flexible Case Studies with CMS\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Create case studies using text, images, videos, galleries, lightboxes, and custom Framer components. Add up to six custom sections per project, rename them to match your process, and hide any sections you don't need.\"}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Easy to Customize\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Update colors, typography, and styles through Framer Assets. Choose between multiple animated background options or create your own custom variation.\"}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"CMS-Powered Workflow\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Manage your entire portfolio from Framer CMS. Add projects, edit content, organize case studies, and publish updates without touching the layout structure.\"}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Tabfolio PRO\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer\",\"href\":\"/assets/www.framer.com/community/marketplace/templates/index.assettabfolio-pro/?via=framewave\",\"target\":\"_blank\"}},{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" \",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\"NEW !\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"For those who want even more control, Tabfolio PRO gives you fully custom case studies (detached from CMS), advanced components like before-and-after sliders, testimonials, and research cards, plus dark mode. It also includes Figma assets and video tutorials built specifically for product design and research case studies.\"}]}]},\"introduction\":\"UX \u0026 Design Portfolio Template\",\"slug\":\"tabfolio\",\"author\":{\"framerUserId\":\"aca61592-4be2-4a8e-a3bd-86322033d2e1\",\"name\":\"Sebastian\",\"slug\":\"sebastianst\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/aca61592-4be2-4a8e-a3bd-86322033d2e1/wcwbpct5\",\"badges\":[\"pro\"],\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/aca61592-4be2-4a8e-a3bd-86322033d2e1/01a02d50-154b-737e-8273-9a6025a5ec93.png\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"video\",\"url\":\"https://stream.mux.com/mBH8PyyicDiRj3Y00OceBFMPY902XTgFIz5wMqrQFln3o.m3u8\",\"metadata\":{\"posterUrl\":\"https://image.mux.com/mBH8PyyicDiRj3Y00OceBFMPY902XTgFIz5wMqrQFln3o/thumbnail.webp?time=6.833\",\"aspectRatio\":\"719:540\",\"duration\":30.006667}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/aca61592-4be2-4a8e-a3bd-86322033d2e1/grmgg8wz\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/aca61592-4be2-4a8e-a3bd-86322033d2e1/o3467n9d\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/aca61592-4be2-4a8e-a3bd-86322033d2e1/47syf9rh\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019eee03-5ec9-7333-9b6a-ddadb95dbdf0\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Meet Tabfolio - my new (and free \"},{\"type\":\"emoji\",\"attrs\":{\"name\":\"tada\",\"emoji\":\"🎉\"}},{\"type\":\"text\",\"text\":\") Framer portfolio template for product and UX designers, where updating case studies is as simple as editing a Notion page.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Most portfolio templates focus just on the landing page with a few case study pictures. I wanted to create something with more structure, built specifically for product and UX design work.\"}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Tabfolio PRO is coming soon - detached from CMS for more freedom, advanced components, dark mode, and Figma assets \"},{\"type\":\"emoji\",\"attrs\":{\"name\":\"eyes\",\"emoji\":\"👀\"}}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"I'd love to hear your feedback and see what you build with it \"},{\"type\":\"emoji\",\"attrs\":{\"name\":\"right_anger_bubble\",\"emoji\":\"🗯\"}}]}]},\"likes\":{\"count\":438,\"liked\":false},\"comments\":{\"count\":4},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-06-22T06:27:38.774Z\",\"updatedAt\":\"2026-08-23T06:30:26.566Z\",\"publishedAt\":\"2026-06-22T06:27:38.770Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"template\",\"attributes\":{\"price\":null,\"paymentUrl\":\"https://framer.link/PaS7FIr\",\"remixUrl\":\"https://framer.link/PaS7FIr\",\"previewUrl\":\"https://tabfolio.framer.ai/\",\"categories\":[{\"id\":107,\"name\":\"Resume\",\"slug\":\"resume-cv\"},{\"id\":16,\"name\":\"Personal\",\"slug\":\"personal\"},{\"id\":19,\"name\":\"Portfolio\",\"slug\":\"portfolio\"},{\"id\":188,\"name\":\"Art \u0026 Design\",\"slug\":\"art-and-design\"},{\"id\":221,\"name\":\"Graphic Design\",\"slug\":\"graphic-design\"},{\"id\":218,\"name\":\"Free\",\"slug\":\"free-website-templates\"},{\"id\":252,\"name\":\"School\",\"slug\":\"school\"}],\"styles\":[{\"id\":247,\"name\":\"Professional\",\"slug\":\"professional\"},{\"id\":243,\"name\":\"Pastel\",\"slug\":\"pastel\"}],\"mainCategory\":{\"id\":19,\"name\":\"Portfolio\",\"slug\":\"portfolio\"},\"features\":[{\"id\":1,\"name\":\"Appear Effects\",\"slug\":\"appear-effects\"},{\"id\":9,\"name\":\"Overlays \u0026 Modals\",\"slug\":\"overlays-modals\"},{\"id\":18,\"name\":\"Scroll Effects\",\"slug\":\"scroll-effects\"},{\"id\":21,\"name\":\"CMS\",\"slug\":\"cms\"},{\"id\":32,\"name\":\"Layout Templates\",\"slug\":\"layout-templates\"},{\"id\":41,\"name\":\"Vector Sets\",\"slug\":\"vector-sets\"}]}},{\"id\":\"71253\",\"resolved\":true,\"title\":\"Span™\",\"body\":\"$af\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Open Live Demo\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer\",\"href\":\"https://span.framer.ai\",\"target\":\"_blank\"}}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"In a world where launching an AI SaaS is getting easier and easier, the challenge is no longer building a product, but getting people to notice it, understand it, and try it. The solution is a website that explains your product clearly and the knowledge to outperform competitors who have a product but no customers.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Pages:\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Home\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"About\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Updates (CMS)\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Pricing\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Careers (CMS)\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Blog (CMS)\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Waitlist\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Contact\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Legal (CMS)\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"404\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Span combines the key elements needed to launch an AI SaaS:\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Website Template:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" An easily customizable AI SaaS website template with 13 responsive pages to showcase your product in the best way. A Waitlist page is also included if you haven’t launched yet.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"30-Day Launch Plan:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Instead of guessing what to do next, I built a clear plan that takes you from validating your product idea to launching it with proof of demand from real users.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Research Guides:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" 7 visual research guides on what worked for other founders and why, with each guide designed to be understood in under 5 minutes. Topics:\"}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Idea \u0026 Validation\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Offer \u0026 Positioning\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Landing Page Conversion\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Trust \u0026 Credibility\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Traffic \u0026 Distribution\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"First Revenue\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Failure Patterns\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Templates \u0026 Assets:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Research-backed launch assets to help you get customers and skip months of trial and error. These include:\"}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Social Post Templates\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Ad Templates\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Website Optimization: AI prompts for Framer Agent to generate website copy\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Outreach Templates\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Visual Assets\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Perfect for:\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"AI SaaS \"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"AI Startup \"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"AI Agent \"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"AI Automation \"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"AI Productivity \"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"AI Marketing \"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"AI Sales \"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"AI Developer Tool \"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"AI Customer Support \"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"AI Analytics \"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"AI Workflow \"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"AI Writing \"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"AI Content \"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"AI Research \"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"t