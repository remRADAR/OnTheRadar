nt\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Easy to customize in Framer\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Designed to let your work speak for itself\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Less interface. More work.\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Mariano is made for creatives who want a portfolio that feels \"},{\"type\":\"text\",\"text\":\"clean, confident, and intentional\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" without unnecessary visual noise.\"}]}]},\"introduction\":\"Minimal Modern Portfolio\",\"slug\":\"mariano\",\"author\":{\"framerUserId\":\"319fb817-3ad9-4dd6-b034-0f407f52c545\",\"name\":\"ETHAN CARTER\",\"slug\":\"ethanf16\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/319fb817-3ad9-4dd6-b034-0f407f52c545/yfklg6uq\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/319fb817-3ad9-4dd6-b034-0f407f52c545/019ff0f6-6e5f-76a8-97eb-80d0718ce121.png\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.710164835164835}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/319fb817-3ad9-4dd6-b034-0f407f52c545/019ff0f6-6cf6-724b-b159-3fa3abb245e3.png\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.710164835164835}}],\"post\":{\"id\":\"019ff0fb-0c72-71c0-b5f3-c13195a1e89c\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"1 Prompt. 1 Customized Template.\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"This template comes with a \"},{\"type\":\"text\",\"text\":\"custom AI prompt built specifically for it\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\", coveri