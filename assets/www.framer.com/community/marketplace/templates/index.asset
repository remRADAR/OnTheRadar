gency\",\"slug\":\"agency\"},\"features\":[{\"id\":1,\"name\":\"Appear Effects\",\"slug\":\"appear-effects\"},{\"id\":13,\"name\":\"Slideshows/Tickers\",\"slug\":\"slideshows-tickers\"},{\"id\":18,\"name\":\"Scroll Effects\",\"slug\":\"scroll-effects\"},{\"id\":21,\"name\":\"CMS\",\"slug\":\"cms\"},{\"id\":30,\"name\":\"Forms\",\"slug\":\"forms\"},{\"id\":32,\"name\":\"Layout Templates\",\"slug\":\"layout-templates\"},{\"id\":35,\"name\":\"Text Effects\",\"slug\":\"text-effects\"},{\"id\":37,\"name\":\"Code Components\",\"slug\":\"code-components\"},{\"id\":39,\"name\":\"Selection Styles\",\"slug\":\"selection-styles\"},{\"id\":40,\"name\":\"Variable Fonts\",\"slug\":\"variable-fonts\"},{\"id\":41,\"name\":\"Vector Sets\",\"slug\":\"vector-sets\"}]}},{\"id\":\"54514\",\"resolved\":true,\"title\":\"Fusion AI\",\"body\":\"$6e\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Fusion AI is a premium Framer 3.0 ready template \",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\"built for AI agent startups, SaaS teams, automation platforms, and product-led companies that want to launch a high-trust website faster.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Built for AI Startups\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Fusion AI is designed for AI products, automation tools, agent platforms, Web3 startups, and growth-focused SaaS companies that need a polished website without wasting weeks on design and development.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Designed to Convert\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Instead of starting from a blank canvas, you get a complete website system built around clarity, credibility, and conversion. Every page and section is structured to help visitors understand your product, trust your solution, and take action.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Ready for Framer 3.0\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Built for the new AI-native Framer workflow, Fusion AI is easy to customize, extend, and improve with Framer Agents. Update content, adjust sections, explore new layouts, and move faster with a clean, flexible foundation.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"What’s Included\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"10 pre-designed pages 50+ reusable responsive components CMS-powered blog and legal collections Forms, scroll effects, and appear effects Responsive layouts for desktop, tablet, and mobile Clean structure for fast customization and publishing\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Figma File Included\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Fusion AI also includes a fully customizable Figma file with dashboard screens, ready for custom graphics, brand visuals, and presentation assets.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Consistent Visual System\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"3D image generation prompts are included, so you can create visuals in the same style and keep your website consistent across pages.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Perfect For\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"AI agent startups SaaS products Automation platforms Web3 companies Product-led teams Growth-focused startups\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"For any query or customization support \"},{\"type\":\"text\",\"text\":\"email\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"mailto:amanidesign786@gmail.com\",\"target\":\"_blank\"}}]},{\"type\":\"text\",\"text\":\". \"}]}]},\"introduction\":\"Automation \u0026 AI Agent Template\",\"slug\":\"fusion-ai\",\"author\":{\"framerUserId\":\"002fd15f-569c-45ed-870e-354988c9191a\",\"name\":\"Amani\",\"slug\":\"helloamani\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/002fd15f-569c-45ed-870e-354988c9191a/dt0c0332\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"video\",\"url\":\"https://stream.mux.com/jbzMQZlg9zs7Dia6VPIcXSLU4mERC8XWo4Y02eCpJ501g.m3u8\",\"metadata\":{\"posterUrl\":\"https://image.mux.com/jbzMQZlg9zs7Dia6VPIcXSLU4mERC8XWo4Y02eCpJ501g/thumbnail.webp?time=1.433\",\"aspectRatio\":\"347:270\",\"duration\":12.416667}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/templates/54514/fusion-ai-MhA066EzZvoNKMtKJhSC8Kz91BkwNm\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/templates/54514/fusion-ai-lblCXh5pqnbITl2H0IIfANBq0jksEr\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/templates/54514/fusion-ai-wb7FwFKNHRawT4eDJuyJgH7KYmmMW6\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"0198f639-7af6-7443-b57c-98aad01be52e\",\"bodyJson\":null,\"likes\":{\"count\":225,\"liked\":false},\"comments\":{\"count\":65},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2025-07-27T21:10:11.697Z\",\"updatedAt\":\"2026-08-15T05:18:04.689Z\",\"publishedAt\":\"2025-08-29T14:26:58.934Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":\"2026-06-01T14:46:12.987Z\",\"type\":\"template\",\"attributes\":{\"price\":\"79\",\"paymentUrl\":\"https://amanidesign.lemonsqueezy.com/buy/7f16787c-5c58-4da6-b1fd-952d38c91534\",\"remixUrl\":null,\"previewUrl\":\"https://fusionai.framer.website/\",\"categories\":[{\"id\":26,\"name\":\"AI\",\"slug\":\"ai\"},{\"id\":23,\"name\":\"Web3\",\"slug\":\"web3\"},{\"id\":112,\"name\":\"Technology\",\"slug\":\"technology\"}],\"styles\":[{\"id\":220,\"name\":\"Gradient\",\"slug\":\"gradient\"},{\"id\":110,\"name\":\"Animated\",\"slug\":\"animated\"},{\"id\":6,\"name\":\"3D\",\"slug\":\"3d\"},{\"id\":208,\"name\":\"Dark\",\"slug\":\"dark\"},{\"id\":222,\"name\":\"Grid\",\"slug\":\"grid\"}],\"mainCategory\":{\"id\":2,\"name\":\"SaaS\",\"slug\":\"saas\"},\"features\":[{\"id\":1,\"name\":\"Appear Effects\",\"slug\":\"appear-effects\"},{\"id\":13,\"name\":\"Slideshows/Tickers\",\"slug\":\"slideshows-tickers\"},{\"id\":18,\"name\":\"Scroll Effects\",\"slug\":\"scroll-effects\"},{\"id\":21,\"name\":\"CMS\",\"slug\":\"cms\"},{\"id\":30,\"name\":\"Forms\",\"slug\":\"forms\"},{\"id\":36,\"name\":\"3D Transforms\",\"slug\":\"3d-transforms\"}]}},{\"id\":\"70691\",\"resolved\":true,\"title\":\"Kai Marlow\",\"body\":\"$6f\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Kai Marlow is a free portfolio website template for Framer that helps designers, studios, and creatives launch a portfolio that makes visitors stop and look in a few hours.\",\"marks\":[{\"type\":\"bold\"}]}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Kai Marlow uses an editorial layout with oversized serif type and a 3D project carousel. It looks nothing like the templates recruiters and clients see every day. You add projects through Framer's CMS. Drop in images, video, or both and organize them with category filters. You do not need to code or hire a developer. You can stop delaying and publish in a few hours.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Perfect for\",\"marks\":[{\"type\":\"bold\"}]}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- Junior designers who need a portfolio before their first job interview and have no time to build from scratch\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- Freelance creatives who want to look credible when clients ask for their website\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- Design studios that need to show many project types without changing the layout each time\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- Recent graduates with strong student work but no live site to show it\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"- Anyone who has been \\\"working on their portfolio\\\" for months and needs to finish it this week\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"What's included\",\"marks\":[{\"type\":\"bold\"}]}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Editorial homepage:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" A 3D project carousel and oversized serif type that makes visitors stop scrolling and remember your work long after.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Image and video galleries:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Add photos and video to any project so you can show static work, motion, and case studies in one place.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"AI prompt pack:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Let Framer's AI Agent customize colors, fonts, and content for you without you ever needing to touch the design.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Customization guide:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" A step-by-step manual that walks you through every edit if you prefer to customize the template yourself by hand.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Framer Pro 25% off:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Use code to get 25% off Framer Pro Annual and publish your site on your own domain.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Support\",\"marks\":[{\"type\":\"bold\"}]}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"If you get stuck, email \"},{\"type\":\"text\",\"text\":\"hi@lazarfilipovic.com\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"mailto:hi@lazarfilipovic.com\",\"target\":\"_blank\"}}]},{\"type\":\"text\",\"text\":\".\"}]}]},\"introduction\":\"Free Portfolio Website Template\",\"slug\":\"kai-marlow\",\"author\":{\"framerUserId\":\"4a5b3c66-0cb4-4306-91d6-b4597a1e72ad\",\"name\":\"Lazar Filipović\",\"slug\":\"filipoviclazar\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/520346/avatar-ANsP3fSLOmFIU38OMCEygfZKqFPGpY.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/4a5b3c66-0cb4-4306-91d6-b4597a1e72ad/019fccf0-10bc-749f-9a29-9cb5785451b4.jpg\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"video\",\"url\":\"https://stream.mux.com/l4UpOERiEJzpM00GZAcbwLBPbBI1qMqBCe5NsghH9TCk.m3u8\",\"metadata\":{\"posterUrl\":\"https://image.mux.com/l4UpOERiEJzpM00GZAcbwLBPbBI1qMqBCe5NsghH9TCk/thumbnail.webp?time=15.264\",\"aspectRatio\":\"831:623\",\"duration\":16.883333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/4a5b3c66-0cb4-4306-91d6-b4597a1e72ad/01a0296a-4a06-743f-b1f5-ec98ce1f2e03.png\",\"metadata\":{\"tint\":\"hsl(0 0% 58%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/4a5b3c66-0cb4-4306-91d6-b4597a1e72ad/01a0296a-5ebd-76ba-b4a6-27e6f5baca54.png\",\"metadata\":{\"tint\":\"hsl(0 0% 58%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/4a5b3c66-0cb4-4306-91d6-b4597a1e72ad/01a0296a-6c3d-7394-9b52-5c29c4c7cd02.png\",\"metadata\":{\"tint\":\"hsl(0 0% 58%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019fccf0-ee7e-77a3-b556-662c1f3aa406\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Just dropped a 100% FREE portfolio template on the @framer marketplace \"},{\"type\":\"emoji\",\"attrs\":{\"name\":\"tada\",\"emoji\":\"🎉\"}}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Made for designers, art directors, and studios who want a website that feels unique and has that wow factor.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"One small ask: if you like it, tap the \"},{\"type\":\"emoji\",\"attrs\":{\"name\":\"heart\",\"emoji\":\"❤\"}},{\"type\":\"text\",\"text\":\" on the marketplace page and leave a comment too. It really helps with visibility and makes it easier for more people to discover it. Thank you \"},{\"type\":\"emoji\",\"attrs\":{\"name\":\"pray\",\"emoji\":\"🙏\"}}]}]},\"likes\":{\"count\":290,\"liked\":false},\"comments\":{\"count\":38},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-08-04T13:22:49.048Z\",\"updatedAt\":\"2026-08-22T12:20:41.663Z\",\"publishedAt\":\"2026-08-04T13:22:49.033Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"template\",\"attributes\":{\"price\":null,\"paymentUrl\":\"https://framer.link/i9TyTJZ\",\"remixUrl\":\"https://framer.link/i9TyTJZ\",\"previewUrl\":\"https://kaimarlow.framer.website/\",\"categories\":[{\"id\":3,\"name\":\"Agency\",\"slug\":\"agency\"},{\"id\":16,\"name\":\"Personal\",\"slug\":\"personal\"},{\"id\":17,\"name\":\"Photography\",\"slug\":\"photography\"},{\"id\":19,\"name\":\"Portfolio\",\"slug\":\"portfolio\"},{\"id\":188,\"name\":\"Art \u0026 Design\",\"slug\":\"art-and-design\"},{\"id\":221,\"name\":\"Graphic Design\",\"slug\":\"graphic-design\"},{\"id\":218,\"name\":\"Free\",\"slug\":\"free-website-templates\"},{\"id\":248,\"name\":\"Services\",\"slug\":\"professional-services\"}],\"styles\":[],\"mainCategory\":{\"id\":19,\"name\":\"Portfolio\",\"slug\":\"portfolio\"},\"features\":[{\"id\":1,\"name\":\"Appear Effects\",\"slug\":\"appear-effects\"},{\"id\":13,\"name\":\"Slideshows/Tickers\",\"slug\":\"slideshows-tickers\"},{\"id\":18,\"name\":\"Scroll Effects\",\"slug\":\"scroll-effects\"},{\"id\":21,\"name\":\"CMS\",\"slug\":\"cms\"},{\"id\":25,\"name\":\"Custom Cursors\",\"slug\":\"custom-cursors\"},{\"id\":37,\"name\":\"Code Components\",\"slug\":\"code-components\"}]}},{\"id\":\"71208\",\"resolved\":true,\"title\":\"Okta Studio\",\"body\":\"$70\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Okta – Creative Agency \u0026 Portfolio Framer Template\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Okta is a premium Framer template designed for creative studios, branding agencies, digital agencies, designers, and independent creatives who want a bold and memorable online presence. With its editorial-inspired layout, striking typography, dark aesthetic, and vibrant visual accents, Okta gives your brand a distinctive identity from the first interaction.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Showcase your best work through a carefully structured portfolio experience, highlight branding and creative projects, introduce your design process, and communicate what makes your studio different. Okta includes dedicated sections for featured projects, brand identity, creative process, services, testimonials, FAQs, and contact—everything you need to turn your portfolio into a powerful business tool.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"The template is designed to tell a story rather than simply display a collection of projects. Large typography, immersive imagery, subtle interactions, and carefully balanced layouts create a premium experience that keeps visitors engaged and makes your work stand out.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Built entirely in Framer, Okta is fully responsive across desktop, tablet, and mobile devices. Customize your colors, typography, images, content, and branding easily using Framer's intuitive no-code editor. No coding experience is required.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Features\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Bold Creative Studio Design \"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Portfolio \u0026 Project Showcase \"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Brand Identity Sections \"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Creative Process Showcase \"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Services \u0026 Capabilities \"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Testimonials \u0026 Client Reviews \"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• FAQ Section \"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Contact \u0026 Lead Generation \"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Responsive Design \"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Smooth Animations \u0026 Interactions \"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• SEO-Friendly Structure \"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Performance Optimized \"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Easy No-Code Customization\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Perfect For\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Creative Studios \"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Branding Agencies \"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Design Agencies \"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Digital Agencies \"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Art Directors \"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Graphic Designers \"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Creative Freelancers \"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Brand Designers \"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Portfolio Websites \"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Creative Consultants\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Build a portfolio that feels as creative as the work you produce.\"}]}]},\"introduction\":\"Creative Studio \u0026 Portfolio\",\"slug\":\"okta-studio\",\"author\":{\"framerUserId\":\"fc522000-8e41-4a7d-8465-71455de6f944\",\"name\":\"Mr. Frame\",\"slug\":\"mrframeteam\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/327228/avatar-wv5V9aSX9m3mG6kXLhjzasf2zqJJTM.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/fc522000-8e41-4a7d-8465-71455de6f944/019ffbe5-2deb-737a-8d3e-4ace8d78ffbf.png\",\"metadata\":{\"tint\":\"hsl(0 0