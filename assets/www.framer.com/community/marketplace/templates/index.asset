ntent\":[{\"type\":\"text\",\"text\":\"• Easy to customize in Framer\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Perfect For\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Interior Designers\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Architecture Studios\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Interior Architecture Firms\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Residential Design Studios\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Commercial Design Firms\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Creative Agencies\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Design Consultants\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Boutique Design Practices\"}]}]},\"introduction\":\"Interior Design Framer Template\",\"slug\":\"forma-interior\",\"author\":{\"framerUserId\":\"106f2c62-aa56-4dc2-8a35-1e09e1a11dfc\",\"name\":\"Hari Om\",\"slug\":\"uixhariom\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/106f2c62-aa56-4dc2-8a35-1e09e1a11dfc/awvk0tqj\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/106f2c62-aa56-4dc2-8a35-1e09e1a11dfc/yn2i9wzn\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/106f2c62-aa56-4dc2-8a35-1e09e1a11dfc/68kxtp2u\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3392857142857142}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/106f2c62-aa56-4dc2-8a35-1e09e1a11dfc/p13g9xh2\",\"metadata\":{\"tint\":\"hsl(0 17% 19%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"i