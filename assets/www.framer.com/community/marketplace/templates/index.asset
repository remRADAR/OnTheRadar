r.website/\",\"categories\":[{\"id\":26,\"name\":\"AI\",\"slug\":\"ai\"},{\"id\":14,\"name\":\"Landing Page\",\"slug\":\"landing-page\"},{\"id\":113,\"name\":\"App\",\"slug\":\"app\"},{\"id\":218,\"name\":\"Free\",\"slug\":\"free-website-templates\"}],\"styles\":[{\"id\":247,\"name\":\"Professional\",\"slug\":\"professional\"},{\"id\":109,\"name\":\"Modern\",\"slug\":\"modern\"},{\"id\":110,\"name\":\"Animated\",\"slug\":\"animated\"},{\"id\":6,\"name\":\"3D\",\"slug\":\"3d\"},{\"id\":201,\"name\":\"Colorful\",\"slug\":\"colorful\"}],\"mainCategory\":{\"id\":2,\"name\":\"SaaS\",\"slug\":\"saas\"},\"features\":[{\"id\":1,\"name\":\"Appear Effects\",\"slug\":\"appear-effects\"},{\"id\":13,\"name\":\"Slideshows/Tickers\",\"slug\":\"slideshows-tickers\"},{\"id\":17,\"name\":\"Sticky Scrolling\",\"slug\":\"sticky-scrolling\"},{\"id\":18,\"name\":\"Scroll Effects\",\"slug\":\"scroll-effects\"},{\"id\":21,\"name\":\"CMS\",\"slug\":\"cms\"},{\"id\":23,\"name\":\"Rich Media\",\"slug\":\"rich-media\"},{\"id\":30,\"name\":\"Forms\",\"slug\":\"forms\"},{\"id\":32,\"name\":\"Layout Templates\",\"slug\":\"layout-templates\"},{\"id\":36,\"name\":\"3D Transforms\",\"slug\":\"3d-transforms\"},{\"id\":37,\"name\":\"Code Components\",\"slug\":\"code-components\"},{\"id\":38,\"name\":\"P3 Colors\",\"slug\":\"p3-colors\"}]}},{\"id\":\"70286\",\"resolved\":true,\"title\":\"Liam Bennet\",\"body\":\"$ab\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"About Liam Bennet\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Liam Bennet\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" is a minimalist dark portfolio template designed for modern creatives who want their work to take centre stage. Built with a refined visual language, it combines clean typography, generous spacing, and subtle interactions to create a sophisticated browsing experience that feels both contemporary and timeless.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Perfect for product designers, UI/UX designers, visual designers, photographers, developers, freelancers, and creative professionals, Liam Bennet provides a polished foundation for presenting projects with clarity and confidence. Every section is intentionally crafted to reduce distractions and keep attention focused on the work itself.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Whether you're launching a new portfolio or redesigning an existing one, Liam Bennet makes it easy to create a professional online presence that feels premium from the first glance. The dark aesthetic enhances imagery and interface details, while the structured layout helps visitors navigate seamlessly through your projects, experience, and story.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Liam Bennet is more than a portfolio template. It is a thoughtful presentation system for creatives who value simplicity, precision, and strong visual impact. If your goal is to showcase your work in a clean, elegant, and memorable way, Liam Bennet is the perfect starting point.\"}]}]},\"introduction\":\"Dark Portfolio Template\",\"slug\":\"liam-bennet\",\"author\":{\"framerUserId\":\"7e4e7e95-7491-45c5-99a3-0990a379822b\",\"name\":\"Moyin\",\"slug\":\"moyin\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/122131/avatar-tts2zbdMAxZa3oZjSbsG0G8mhTac7D.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"video\",\"url\":\"https://stream.mux.com/yeYtBrm5M1FOhd6AAeHvcMlwx4cGtVfJv5MaYEkDgco.m3u8\",\"metadata\":{\"posterUrl\":\"https://image.mux.com/yeYtBrm5M1FOhd6AAeHvcMlwx4cGtVfJv5MaYEkDgco/thumbnail.webp?time=15.483\",\"aspectRatio\":\"4:3\",\"duration\":17.116667}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/7e4e7e95-7491-45c5-99a3-0990a379822b/019fa83f-b465-7309-