"id\":111,\"name\":\"Minimal\",\"slug\":\"minimal\"},{\"id\":222,\"name\":\"Grid\",\"slug\":\"grid\"}],\"mainCategory\":{\"id\":2,\"name\":\"SaaS\",\"slug\":\"saas\"},\"features\":[{\"id\":1,\"name\":\"Appear Effects\",\"slug\":\"appear-effects\"},{\"id\":9,\"name\":\"Overlays \u0026 Modals\",\"slug\":\"overlays-modals\"},{\"id\":13,\"name\":\"Slideshows/Tickers\",\"slug\":\"slideshows-tickers\"},{\"id\":17,\"name\":\"Sticky Scrolling\",\"slug\":\"sticky-scrolling\"},{\"id\":18,\"name\":\"Scroll Effects\",\"slug\":\"scroll-effects\"},{\"id\":21,\"name\":\"CMS\",\"slug\":\"cms\"},{\"id\":30,\"name\":\"Forms\",\"slug\":\"forms\"},{\"id\":32,\"name\":\"Layout Templates\",\"slug\":\"layout-templates\"},{\"id\":35,\"name\":\"Text Effects\",\"slug\":\"text-effects\"},{\"id\":37,\"name\":\"Code Components\",\"slug\":\"code-components\"},{\"id\":41,\"name\":\"Vector Sets\",\"slug\":\"vector-sets\"}]}},{\"id\":\"68044\",\"resolved\":true,\"title\":\"Forma Interior\",\"body\":\"$9e\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Forma Studio is a premium Framer template designed for interior designers, architects, creative studios, and design professionals who want a refined and modern online presence.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Built with a minimal aesthetic and carefully structured layouts, Forma Studio helps showcase projects, services, studio expertise, and client trust in a clear and professional way. The template combines elegant visuals with thoughtful content sections, making it ideal for studios looking to present their work and attract new clients.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"The homepage is designed around storytelling and credibility, featuring a bold hero section, studio introduction, services, featured projects, design process, testimonials, FAQs, and a conversion-focused contact experience.\"}]},{\"type\":\"cu