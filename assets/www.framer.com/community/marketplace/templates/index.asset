,{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Live Preview:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"https://bureaunine.framer.website/\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"https://bureaunine.framer.website/\",\"target\":\"_blank\"}}]},{\"type\":\"text\",\"text\":\" \"}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Bureau Nine is a calm, editorial, fully responsive Framer template built for creative studios and independent designers who let the work speak. It pairs generous whitespace with a CMS-driven case study system that makes every project feel like an edition and it works just as well as a personal portfolio for graphic designers and creative directors, so you can run it as a studio site or as your own body of work.\"}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Perfect for\"}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Creative studios and boutique agencies\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Graphic designers building a personal portfolio\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Creative directors presenting selected work\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Brand identity and packaging designers\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Art directors and motion designers\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Freelance creatives launching a first studio site\"}]}]}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"What's inside\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Whether you're presenting a handful of signature projects or a growing body of client work, Bureau Nine gives you a refined, quietly confident home for your portfolio with detailed project pages, an about story, and a direct contact flow.\"}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Support:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"hello@soleno.io\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"mailto:hello@soleno.io\",\"target\":\"_blank\"}}]}]}]},\"introduction\":\"Minimalistic Agency Template\",\"slug\":\"bureau-nine\",\"author\":{\"framerUserId\":\"8228e4b2-0815-49ed-b215-bc30e24b5abd\",\"name\":\"Soleno Studio\",\"slug\":\"soleno\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/43027/avatar-MVGgLqvLNYTlmzXqiB6NVBptetf0Tb.jpg\",\"badges\":[\"pro\"],\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"video\",\"url\":\"https://stream.mux.com/ZJJG5Q136FhpPkaP39bKBIf6sO021r43eNExObyFWfwg.m3u8\",\"metadata\":{\"posterUrl\":\"https://image.mux.com/ZJJG5Q136FhpPkaP39bKBIf6sO021r43eNExObyFWfwg/thumbnail.webp?time=5.733\",\"aspectRatio\":\"4:3\",\"duration\":7.983333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/8228e4b2-0815-49ed-b215-bc30e24b5abd/019fc70d-d7d4-765c-a3b2-edd75fe4cde0.jpg\",\"metadata\":{\"tint\":\"hsl(60 17% 51%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019fc710-a223-75ea-93c6-91eb5187c88b\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"I'm obsessed with scrolling through the featured project preview. You will be too. Grab it for free, now live on the Framer Market