ssional\"},{\"id\":261,\"name\":\"Typographic\",\"slug\":\"typographic\"},{\"id\":109,\"name\":\"Modern\",\"slug\":\"modern\"},{\"id\":110,\"name\":\"Animated\",\"slug\":\"animated\"},{\"id\":208,\"name\":\"Dark\",\"slug\":\"dark\"}],\"mainCategory\":{\"id\":2,\"name\":\"SaaS\",\"slug\":\"saas\"},\"features\":[{\"id\":1,\"name\":\"Appear Effects\",\"slug\":\"appear-effects\"},{\"id\":13,\"name\":\"Slideshows/Tickers\",\"slug\":\"slideshows-tickers\"},{\"id\":17,\"name\":\"Sticky Scrolling\",\"slug\":\"sticky-scrolling\"},{\"id\":18,\"name\":\"Scroll Effects\",\"slug\":\"scroll-effects\"},{\"id\":21,\"name\":\"CMS\",\"slug\":\"cms\"},{\"id\":23,\"name\":\"Rich Media\",\"slug\":\"rich-media\"},{\"id\":30,\"name\":\"Forms\",\"slug\":\"forms\"},{\"id\":32,\"name\":\"Layout Templates\",\"slug\":\"layout-templates\"},{\"id\":35,\"name\":\"Text Effects\",\"slug\":\"text-effects\"},{\"id\":37,\"name\":\"Code Components\",\"slug\":\"code-components\"},{\"id\":39,\"name\":\"Selection Styles\",\"slug\":\"selection-styles\"},{\"id\":41,\"name\":\"Vector Sets\",\"slug\":\"vector-sets\"}]}},{\"id\":\"66466\",\"resolved\":true,\"title\":\"Taylor\",\"body\":\"$62\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Taylor\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" is a standout premium agency and portfolio template created to elevate how your work is presented. It’s a versatile solution for designers, freelancers, creative studios, digital agencies, photographers, and anyone in the creative space looking to display their work with clarity and sophistication. Its clean, minimal approach ensures your projects remain the center of attention, letting your work speak without distraction.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Whether you’re launching a new portfolio or refining an existing one, Taylor strikes a thoughtful balance between simplicity and elegance. The layout is built to highlight each project effectively, giving your work room to breathe while maintaining a polished, professional look. Every element is intentionally designed to support strong visual storytelling and leave a lasting impression on clients and collaborators.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"For creatives who take their presentation seriously, Taylor offers a powerful and stylish way to stand out. It provides all the essentials needed to build a compelling portfolio or agency presence that captures attention and communicates quality with confidence.\"}]}]},\"introduction\":\"Premium Agency \u0026 Portfolio\",\"slug\":\"taylor\",\"author\":{\"framerUserId\":\"6e35a542-0c6e-4f5a-a79f-9c7544298ee3\",\"name\":\"Akin \u0026 Ed\",\"slug\":\"akin-ed\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/6e35a542-0c6e-4f5a-a79f-9c7544298ee3/05raupra\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/6e35a542-0c6e-4f5a-a79f-9c7544298ee3/9yxwf3p4\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/6e35a542-0c6e-4f5a-a79f-9c7544298ee3/yjedvqqc\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/6e35a542-0c6e-4f5a-a79f-9c7544298ee3/estiuxkq\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/6e35a542-0c6e-4f5a-a79f-9c7544298ee3/aiofukzq\",\"metadata\":{\"tint\":\"hsl(0 0% 16%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019ed1b6-fd20-70ea-a155-022c71ce3d0b\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Premium Portfolio Template\"}]}]},\"likes\":{\"count\":1100,\"liked\":false},\"comments\":{\"count\":21},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-06-16T18:34:51.005Z\",\"updatedAt\":\"2026-06-16T18:34:51.005Z\",\"publishedAt\":\"2026-06-16T18:34:50.999Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"template\",\"attributes\":{\"price\":null,\"paymentUrl\":\"https://framer.link/Vu6hDWa\",\"remixUrl\":\"https://framer.link/Vu6hDWa\",\"previewUrl\":\"https://taylordesigner.framer.website/\",\"categories\":[{\"id\":3,\"name\":\"Agency\",\"slug\":\"agency\"},{\"id\":16,\"name\":\"Personal\",\"slug\":\"personal\"},{\"id\":19,\"name\":\"Portfolio\",\"slug\":\"portfolio\"},{\"id\":188,\"name\":\"Art \u0026 Design\",\"slug\":\"art-and-design\"},{\"id\":14,\"name\":\"Landing Page\",\"slug\":\"landing-page\"},{\"id\":221,\"name\":\"Graphic Design\",\"slug\":\"graphic-design\"}],\"styles\":[{\"id\":247,\"name\":\"Professional\",\"slug\":\"professional\"},{\"id\":109,\"name\":\"Modern\",\"slug\":\"modern\"}],\"mainCategory\":{\"id\":19,\"name\":\"Portfolio\",\"slug\":\"portfolio\"},\"features\":[{\"id\":1,\"name\":\"Appear Effects\",\"slug\":\"appear-effects\"},{\"id\":17,\"name\":\"Sticky Scrolling\",\"slug\":\"sticky-scrolling\"},{\"id\":18,\"name\":\"Scroll Effects\",\"slug\":\"scroll-effects\"},{\"id\":21,\"name\":\"CMS\",\"slug\":\"cms\"},{\"id\":23,\"name\":\"Rich Media\",\"slug\":\"rich-media\"},{\"id\":25,\"name\":\"Custom Cursors\",\"slug\":\"custom-cursors\"},{\"id\":32,\"name\":\"Layout Templates\",\"slug\":\"layout-templates\"},{\"id\":35,\"name\":\"Text Effects\",\"slug\":\"text-effects\"}]}},{\"id\":\"57037\",\"resolved\":true,\"title\":\"Mike Bennet\",\"body\":\"$63\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"About template\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Mike Bennet is a clean, minimal portfolio template for designers who want to launch fast and present their work in a more professional, premium way.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Built primarily for \"},{\"type\":\"text\",\"text\":\"brand designers\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\", it helps you turn your projects into a polished portfolio site without spending days figuring out structure, layout, or CMS setup from scratch. \"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Whether you are applying for jobs, sending your portfolio to potential clients, or simply upgrading your online presence, Mike Bennet is designed to help you make a stronger first impression with less effort.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Why Mike Bennet\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Most portfolio templates either feel too generic or too overloaded. Mike Bennet takes a more focused approach.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"It is designed to keep attention on your work through a clean structure, bold typography, and a project-first layout that feels creative, professional, and easy to navigate.\"}]},{\"type\":\"customImage\",\"attrs\":{\"alt\":\"\",\"src\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/templates/57037-mike-bennet-gApN0jXrKK5fOYqljzXVkvdDaA9vQJ\",\"link\":null,\"caption\":\"\",\"uploadId\":null}},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Best for\"}],\"attrs\":{\"level\":1}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Brand designers\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Graphic designers\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Art directors\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Designers building a personal portfolio\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Creatives who want a premium portfolio without a complicated setup\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Motion designers\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"What this template helps you do\"}],\"attrs\":{\"level\":1}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Launch your portfolio faster\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Create a stronger and more professional first impression\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Showcase projects in a clean, premium format\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Send a portfolio link with more confidence\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Manage projects through a simpler CMS-driven structure\"}]}]}]},{\"type\":\"customImage\",\"attrs\":{\"alt\":\"\",\"src\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/templates/57037-mike-bennet-GTizoXzKeEzd0HTughTv75p1IYv33x\",\"link\":null,\"caption\":\"\",\"uploadId\":null}},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Image and Video Support\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Show your work in the format that fits it best. Project cards and project presentation can support both image and video-based content, making the template suitable for a wider range of visual work.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Support\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"If you need help with anything, email me at \"},{\"type\":\"text\",\"text\":\"webdesignbylazar@gmail.com\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"mailto:webdesignbylazar@gmail.com\",\"target\":\"_blank\"}}]},{\"type\":\"text\",\"text\":\".\"}]}]},\"introduction\":\"Free Portfolio Website Template\",\"slug\":\"mike-bennet\",\"author\":{\"framerUserId\":\"4a5b3c66-0cb4-4306-91d6-b4597a1e72ad\",\"name\":\"Lazar Filipović\",\"slug\":\"filipoviclazar\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/520346/avatar-ANsP3fSLOmFIU38OMCEygfZKqFPGpY.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/4a5b3c66-0cb4-4306-91d6-b4597a1e72ad/01a02971-145c-76bb-aae0-ce23e9c43970.jpg\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/templates/57037/mike-bennet-Px90knWZuEkdTQiwmNoQA17vl9A2Uf\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019a25e7-07d0-72b2-9f31-501b024ef9e1\",\"bodyJson\":null,\"likes\":{\"count\":1086,\"liked\":false},\"comments\":{\"count\":20},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2025-10-16T17:41:01.572Z\",\"updatedAt\":\"2026-08-22T12:28:25.585Z\",\"publishedAt\":\"2025-10-27T13:41:29.168Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":\"2026-06-01T14:46:12.987Z\",\"type\":\"template\",\"attributes\":{\"price\":null,\"paymentUrl\":\"https://framer.link/9oOOSJe\",\"remixUrl\