blob.vercel-storage.com/media/4b8eacfd-b979-4bb5-942b-85860303ad92/019f895d-957c-72fb-ad4d-7e5faf6a0404.png\",\"metadata\":{\"tint\":\"hsl(227 90% 16%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/4b8eacfd-b979-4bb5-942b-85860303ad92/019f895d-e4ac-715a-b15f-bd2b7895fbd4.png\",\"metadata\":{\"tint\":\"hsl(227 90% 16%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/4b8eacfd-b979-4bb5-942b-85860303ad92/019f895f-9dcf-732c-bb12-beb2d94bd03f.png\",\"metadata\":{\"tint\":\"hsl(227 90% 16%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019f8964-60d7-731a-b9e5-283b115d8571\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"rocket\",\"emoji\":\"🚀\"}},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"Macxfolio\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"emoji\",\"attrs\":{\"name\":\"registered\",\"emoji\":\"®\"}},{\"type\":\"text\",\"text\":\" is officially out!\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Meet \"},{\"type\":\"text\",\"text\":\"Macxfolio\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"emoji\",\"attrs\":{\"name\":\"registered\",\"emoji\":\"®\"}},{\"type\":\"text\",\"text\":\" — a premium \"},{\"type\":\"text\",\"text\":\"macOS-inspired Portfolio Framer Template\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" crafted for designers, developers, creatives, and personal brands who want to stand out.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Experience an interactive desktop with a functional Dock, CMS-powered projects, blogs \u0026 resources, a built-in music player, playful pet cursor, live Cat Herding game, glassmorphism UI, premium animations, and much more—all packed into one polished portfolio template.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"sparkles\",\"emoji\":\"✨\"}},{\"type\":\"text\",\"text\":\" Built for creators who want more than just another portfolio.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"link\",\"emoji\":\"🔗\"}},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"Live Preview:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"https://macxfolio.framer.website/\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer\",\"href\":\"https://macxfolio.framer.website/\",\"target\":\"_blank\"}}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"#Framer #FramerTemplate #Portfolio #PortfolioWebsite #WebDesign #UIDesign #UXDesign #ProductDesign #CreativePortfolio #NoCode #WebDevelopment #MacOS #Designer #Freelancer #PersonalBrand\"}]}]},\"likes\":{\"count\":343,\"liked\":false},\"comments\":{\"count\":9},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-07-22T10:34:44.477Z\",\"updatedAt\":\"2026-07-29T06:53:38.322Z\",\"publishedAt\":\"2026-07-22T10:34:44.474Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"template\",\"attributes\":{\"price\":null,\"paymentUrl\":\"https://framer.link/u3KdYJq\",\"remixUrl\":\"https://framer.link/u3KdYJq\",\"previewUrl\":\"https://macxfolio.framer.website/\",\"categories\":[{\"id\":107,\"name\":\"Resume\",\"slug\":\"resume-cv\"},{\"id\":3,\"name\":\"Agency\",\"slug\":\"agency\"},{\"id\":16,\"name\":\"Personal\",\"slug\":\"personal\"},{\"id\":19,\"name\":\"Portfolio\",\"slug\":\"portfolio\"},{\"id\":189,\"name\":\"Artist\",\"slug\":\"artist\"},{\"id\":210,\"name\":\"Digital Products\",\"slug\":\"digital-products\"},{\"id\":218,\"name\":\"Free\",\"slug\":\"free-website-templates\"},{\"id\":248,\"name\":\"Services\",\"slug\":\"professional-services\"}],\"styles\":[{\"id\":111,\"name\":\"Minimal\",\"slug\":\"minimal\"}],\"mainCategory\":{\"id\":19,\"name\":\"Portfolio\",\"slug\":\"portfolio\"},\"features\":[{\"id\":1,\"name\":\"Appear Effects\",\"slug\":\"appear-effects\"},{\"id\":9,\"name\":\"Overlays \u0026 Modals\",\"slug\":\"overlays-modals\"},{\"id\":18,\"name\":\"Scroll Effects\",\"slug\":\"scroll-effects\"},{\"id\":21,\"name\":\"CMS\",\"slug\":\"cms\"},{\"id\":23,\"name\":\"Rich Media\",\"slug\":\"rich-media\"},{\"id\":30,\"name\":\"Forms\",\"slug\":\"forms\"},{\"id\":37,\"name\":\"Code Components\",\"slug\":\"code-components\"},{\"id\":40,\"name\":\"Variable Fonts\",\"slug\":\"variable-fonts\"},{\"id\":41,\"name\":\"Vector Sets\",\"slug\":\"vector-sets\"}]}},{\"id\":\"59483\",\"resolved\":true,\"title\":\"Himon\",\"body\":\"\u003cp\u003eHimon is a modern Framer template built specifically for logistics, transportation, and delivery businesses.\u003c/p\u003e\u003cp\u003eThe layout is structured to highlight core services such as freight and trucking, container transport, and last mile delivery. Content is organized to communicate reliability, scale, and operational clarity, helping potential clients quickly understand your capabilities.\u003c/p\u003e\u003cp\u003eHimon includes dedicated sections for services, company story, fleet or operations overview, team, partners, FAQs, and contact. The design feels professional and trustworthy, suitable for both B2B and large scale transport operations.\u003c/p\u003e\u003cp\u003eBuilt natively in Framer, the template is fast, responsive, and easy to customize. You can adjust colors, typography, and layouts to match your brand while keeping performance and usability at the core.\u003c/p\u003e\u003cp\u003eHimon is ideal for logistics providers, transport companies, freight operators, and supply chain businesses looking for a strong and modern online presence.\u003c/p\u003e\",\"bodyJson\":null,\"introduction\":\"Logistics \u0026 Transport Website\",\"slug\":\"himon\",\"author\":{\"framerUserId\":\"2033412d-0adf-4646-bb5d-e8ed4dcc797f\",\"name\":\"Sang\",\"slug\":\"sang\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/28912/MWPM00Jjoze3bjuTB8QMu3Oig-YVtuuKvdRGcB5VJNFruqFx0sD5V8fI.png\",\"badges\":[\"pro\"],\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/templates/59483/himon-0VMhNaerN7fP6nm3Bmc8VExTnKCU8Y\",\"metadata\":{\"tint\":\"hsl(30 40% 16%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/templates/59483/himon-p8SMkOyA7j6PMv5ImujvV8tygj6389\",\"metadata\":{\"tint\":\"hsl(30 40% 16%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/templates/59483/himon-CHPMbSe2RX1yVw6n3ivcPzVUAlAJiD\",\"metadata\":{\"tint\":\"hsl(0 0% 9%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/templates/59483/himon-0aX8foT3qZTU5UAB4T1beJ1Tfnv5Df\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019e0803-738c-7f3c-a291-311864f42a32\",\"bodyJson\":null,\"likes\":{\"count\":250,\"liked\":false},\"comments\":{\"count\":16},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-01-13T05:35:13.814Z\",\"updatedAt\":\"2026-06-19T14:34:41.272Z\",\"publishedAt\":\"2026-05-08T14:35:04.460Z\",\"featuredAt\":\"2026-06-15T13:23:58.367Z\",\"reported\":false,\"approvedAt\":\"2026-06-01T14:46:12.987Z\",\"type\":\"template\",\"attributes\":{\"price\":\"79\",\"paymentUrl\":\"https://contra.com/payment-link/mivReKTF-himon-logistics-and-transport-website\",\"remixUrl\":null,\"previewUrl\":\"https://himon.framer.website/\",\"categories\":[{\"id\":3,\"name\":\"Agency\",\"slug\":\"agency\"},{\"id\":22,\"name\":\"Startup\",\"slug\":\"startup\"},{\"id\":112,\"name\":\"Technology\",\"slug\":\"technology\"},{\"id\":204,\"name\":\"Construction\",\"slug\":\"construction\"},{\"id\":248,\"name\":\"Services\",\"slug\":\"professional-services\"}],\"styles\":[{\"id\":247,\"name\":\"Professional\",\"slug\":\"professional\"},{\"id\":109,\"name\":\"Modern\",\"slug\":\"modern\"},{\"id\":110,\"name\":\"Animated\",\"slug\":\"animated\"}],\"mainCategory\":{\"id\":248,\"name\":\"Services\",\"slug\":\"professional-services\"},\"features\":[{\"id\":1,\"name\":\"Appear Effects\",\"slug\":\"appear-effects\"},{\"id\":9,\"name\":\"Overlays \u0026 Modals\",\"slug\":\"overlays-modals\"},{\"id\":18,\"name\":\"Scroll Effects\",\"slug\":\"scroll-effects\"},{\"id\":21,\"name\":\"CMS\",\"slug\":\"cms\"},{\"id\":23,\"name\":\"Rich Media\",\"slug\":\"rich-media\"},{\"id\":30,\"name\":\"Forms\",\"slug\":\"forms\"},{\"id\":32,\"name\":\"Layout Templates\",\"slug\":\"layout-templates\"},{\"id\":37,\"name\":\"Code Components\",\"slug\":\"code-components\"}]}},{\"id\":\"66945\",\"resolved\":true,\"title\":\"Sevora\",\"body\":\"$95\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Live preview: \"},{\"type\":\"text\",\"text\":\"sevora.framer.website\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"https://sevora.framer.website\",\"target\":\"_blank\"}}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Sevora is a free Framer portfolio template for independent designers, freelancers, and creative studios who want to present their work with clarity and confidence.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Built around a refined minimal style, Sevora gives you a complete foundation for showcasing projects, explaining your services, sharing your process, and turning visitors into potential clients.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"What’s included:\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Project and case study layouts • CMS-powered projects and articles • Services and integrations sections • Process and experience sections • Pricing, testimonials, and FAQ • About and contact pages • Responsive desktop, tablet, and mobile layouts • Smooth scrolling and subtle interactions • Easy-to-edit colors, typography, and content.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Sevora is designed to be simple to customize. Replace the demo content, add your projects through the CMS, adjust the global styles, and publish a professional portfolio without starting from scratch.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Latest update:\"}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Added a new integrations service\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Added AnimatedNumber for statistics\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Refined typography and spacing\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Added subtle background line patterns\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Improved smooth scrolling and interactions\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Updated the tab navigation on the Projects and Article 2 pages for clearer states and a more consistent browsing experience.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Added Hero Section 02 as an alternative homepage hero layout, plus updated Style Guidelines for easier customization and better visual consistency.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Added left button icons, refreshed typography, and improved overall spacing, balance, and visual consistency across Sevora.\"}]}]}]}]},\"introduction\":\"A refined portfolio for designers\",\"slug\":\"sevora\",\"author\":{\"framerUserId\":\"22ccca22-dff6-4bd1-9e17-7ef77ed7e047\",\"name\":\"Dmytri Ivanov\",\"slug\":\"dmytri-ivanov\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/28916/Avatar%201-gJDXaVPqnUpIfASXYVn23H3Mt6hVc8.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/22ccca22-dff6-4bd1-9e17-7ef77ed7e047/019fc569-bf28-75a1-be40-cbff32714433.jpg\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/22ccca22-dff6-4bd1-9e17-7ef77ed7e047/3qh7yo04\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/22ccca22-dff6-4bd1-9e17-7ef77ed7e047/c0rd92lg\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/22ccca22-dff6-4bd1-9e17-7ef77ed7e047/ae34tlpl\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019ed4b7-714d-76dd-9ac0-05327836081f\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"New update: Button icons, typography, and balance improvements\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Sevora now includes a left icon option for buttons, refreshed typography settings, and refined spacing across key sections. The overall visual balance has been improved to make the template feel cleaner, more consistent, and more polished.\"}]}]},\"likes\":{\"count\":411,\"liked\":false},\"comments\":{\"count\":22},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-06-17T08:34:12.383Z\",\"updatedAt\":\"2026-08-03T02:17:59.105Z\",\"publishedAt\":\"2026-06-17T08:34:12.380Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"template\",\"attributes\":{\"price\":null,\"paymentUrl\":\"https://framer.link/jjswomy\",\"remixUrl\":\"https://framer.link/jjswomy\",\"previewUrl\":\"https://sevora.framer.website/\",\"categories\":[{\"id\":3,\"name\":\"Agency\",\"slug\":\"agency\"},{\"id\":16,\"name\":\"Personal\",\"slug\":\"personal\"},{\"id\":19,\"name\":\"Portfolio\",\"slug\":\"portfolio\"},{\"id\":218,\"name\":\"Free\",\"slug\":\"free-website-templates\"}],\"styles\":[{\"id\":111,\"name\":\"Minimal\",\"slug\":\"minimal\"},{\"id\":193,\"name\":\"Black \u0026 White\",\"slug\":\"black-and-white\"}],\"mainCategory\":{\"id\":3,\"name\":\"Agency\",\"slug\":\"agency\"},\"features\":[{\"id\":1,\"name\":\"Appear Effects\",\"slug\":\"appear-effects\"},{\"id\":9,\"name\":\"Overlays \u0026 Modals\",\"slug\":\"overlays-modals\"},{\"id\":17,\"name\":\"Sticky Scrolling\",\"slug\":\"sticky-scrolling\"},{\"id\":18,\"name\":\"Scroll Effects\",\"slug\":\"scroll-effects\"},{\"id\":21,\"name\":\"CMS\",\"slug\":\"cms\"},{\"id\":23,\"name\":\"Rich Media\",\"slug\":\"rich-media\"},{\"id\":30,\"name\":\"Forms\",\"slug\":\"forms\"},{\"id\":32,\"name\":\"Layout Templates\",\"slug\":\"layout-templates\"},{\"id\":35,\"name\":\"Text Effects\",\"slug\":\"text-effects\"},{\"id\":40,\"name\":\"Variable Fonts\",\"slug\":\"variable-fonts\"},{\"id\":41,\"name\":\"Vector Sets\",\"slug\":\"vector-sets\"}]}},{\"id\":\"62156\",\"resolved\":true,\"title\":\"Alex Kabiru\",\"body\":\"\u003cp\u003eKabiru is a premium Framer portfolio and agency template designed for creatives, freelancers, studios, and modern businesses. Featuring clean layouts, striking typography, and smooth animations, it helps you showcase your projects, services, and expertise with clarity and confidence.\u003c/p\u003e\u003cp\u003eBuilt with performance and usability in mind, Kabiru delivers a seamless experience across desktop, tablet, and mobile devices. Its flexible and fully customizable design allows you to easily adapt content, visuals, and branding to create a website that reflects your unique identity.\u003c/p\u003e\u003cp\u003eWhether you\u0026#39;re creating a creative portfolio, digital agency website, or personal brand platform, Kabiru provides the perfect balance of style, functionality, and speed. Optimized for user experience and SEO, it helps you build a strong online presence, attract potential clients, and leave a lasting impression.\u003c/p\u003e\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Kabiru is a premium Framer portfolio and agency template designed for creatives, freelancers, studios, and modern businesses. Featuring clean layouts, striking typography, and smooth animations, it helps you showcase your projects, services, and expertise with clarity and confidence.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Built with performance and usability in mind, Kabiru delivers a seamless experience across desktop, tablet, and mobile devices. Its flexible and fully customizable design allows you to easily adapt content, visuals, and branding to create a website that reflects your unique identity.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Whether you're creating a creative portfolio, digital agency website, or personal brand platform, Kabiru provides the perfect balance of style, functionality, and speed. Optimized for user experience and SEO, it helps you build a strong online presence, attract potential clients, and leave a lasting impression.\"}]}]},\"introduction\":\"Minimal Por