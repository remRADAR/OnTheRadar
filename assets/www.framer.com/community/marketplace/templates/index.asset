:\"layout-templates\"},{\"id\":37,\"name\":\"Code Components\",\"slug\":\"code-components\"}]}},{\"id\":\"62654\",\"resolved\":true,\"title\":\"Homy\",\"body\":\"$7f\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Homy is the #1 modern real estate website template for Framer, built for real estate agencies, realtors, property dealers, brokers, and property management companies who want to showcase luxury homes and sell properties faster. No coding required.\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Homy is a premium, fully responsive real estate template that helps you launch a professional property website in minutes. Whether you list residential homes, luxury villas, commercial real estate, apartments, or new construction projects, Homy presents every property with clarity, impact, and conversion focused design.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"emoji\",\"marks\":[{\"type\":\"bold\"}],\"attrs\":{\"name\":\"house_with_garden\",\"emoji\":\"🏡\"}},{\"type\":\"text\",\"text\":\" Perfect For:\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Real estate agencies and brokerages\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Realtors, estate agents, and property dealers\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Property management and property listing platforms\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Luxury villa, apartment, and residential home showcases\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Commercial and residential real estate\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"New construction and property development projects\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Interior design and architecture studios\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Mortgage brokers, property investors, and rental businesses\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"emoji\",\"marks\":[{\"type\":\"bold\"}],\"attrs\":{\"name\":\"sparkles\",\"emoji\":\"✨\"}},{\"type\":\"text\",\"text\":\" Key Features:\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Clean, modern, and premium real estate design that builds instant trust\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Fully responsive layout that works perfectly on desktop, tablet, and mobile\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Built in CMS to add, edit, and manage property listings visually with zero code\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Structured property detail pages for photos, pricing, location, and key features\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Reusable components and smooth animations for a high end feel\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"SEO ready structure so your real estate website ranks and loads fast\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Easy to customize, match your brand in a few clicks, and scale as you grow\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"emoji\",\"marks\":[{\"type\":\"bold\"}],\"attrs\":{\"name\":\"page_facing_up\",\"emoji\":\"📄\"}},{\"type\":\"text\",\"text\":\" Pages Included:\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Home\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Properties (CMS)\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Property Detail (CMS)\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Services\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"About\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Contact\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"404\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"emoji\",\"marks\":[{\"type\":\"bold\"}],\"attrs\":{\"name\":\"rocket\",\"emoji\":\"🚀\"}},{\"type\":\"text\",\"text\":\" Why Homy:\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Unlike generic business templates, Homy is purpose built for real estate. Every section, from the property listings grid to the agent contact form, helps agencies, realtors, and property managers turn visitors into buyers and leads. Launch a real estate agency website, property listing platform, or luxury home showcase without hiring a developer.\"}]}]},\"introduction\":\"Real Estate \u0026 Property Template\",\"slug\":\"homy\",\"author\":{\"framerUserId\":\"e384faea-043f-4f5c-bd25-070ec91488d7\",\"name\":\"Framer Geeks\",\"slug\":\"framergeeks\",\"avatar\":\"https