\"},{\"id\":19,\"name\":\"Portfolio\",\"slug\":\"portfolio\"},{\"id\":188,\"name\":\"Art \u0026 Design\",\"slug\":\"art-and-design\"},{\"id\":221,\"name\":\"Graphic Design\",\"slug\":\"graphic-design\"},{\"id\":218,\"name\":\"Free\",\"slug\":\"free-website-templates\"},{\"id\":248,\"name\":\"Services\",\"slug\":\"professional-services\"}],\"styles\":[{\"id\":239,\"name\":\"Monochromatic\",\"slug\":\"monochromatic\"},{\"id\":109,\"name\":\"Modern\",\"slug\":\"modern\"},{\"id\":111,\"name\":\"Minimal\",\"slug\":\"minimal\"},{\"id\":193,\"name\":\"Black \u0026 White\",\"slug\":\"black-and-white\"},{\"id\":222,\"name\":\"Grid\",\"slug\":\"grid\"}],\"mainCategory\":{\"id\":3,\"name\":\"Agency\",\"slug\":\"agency\"},\"features\":[{\"id\":1,\"name\":\"Appear Effects\",\"slug\":\"appear-effects\"},{\"id\":9,\"name\":\"Overlays \u0026 Modals\",\"slug\":\"overlays-modals\"},{\"id\":17,\"name\":\"Sticky Scrolling\",\"slug\":\"sticky-scrolling\"},{\"id\":18,\"name\":\"Scroll Effects\",\"slug\":\"scroll-effects\"},{\"id\":21,\"name\":\"CMS\",\"slug\":\"cms\"},{\"id\":23,\"name\":\"Rich Media\",\"slug\":\"rich-media\"},{\"id\":25,\"name\":\"Custom Cursors\",\"slug\":\"custom-cursors\"},{\"id\":32,\"name\":\"Layout Templates\",\"slug\":\"layout-templates\"},{\"id\":35,\"name\":\"Text Effects\",\"slug\":\"text-effects\"}]}},{\"id\":\"69096\",\"resolved\":true,\"title\":\"Ocha — Matcha Cafe\",\"body\":\"$96\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Ocha is a bold and expressive Framer template designed for modern matcha cafés, specialty coffee shops, tea houses, bakeries, and creative food \u0026 beverage brands.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Built with oversized typography, vibrant colors, immersive imagery, and playful interactions, Ocha transforms a traditional café website into a memorable digital experience.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"sparkles\",\"emoji\":\"✨\"}},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"Key Features\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"tea\",\"emoji\":\"🍵\"}},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"Immersive Single-Page Experience\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" A long-form homepage that brings your brand, menu, products, people, and community together.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"tropical_drink\",\"emoji\":\"🍹\"}},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"Interactive Menu \u0026 Specials\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Showcase signature drinks, seasonal creations, and café favorites through bold, image-driven layouts.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"film_strip\",\"emoji\":\"🎞\"}},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"Playful Interactions\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Smooth animations, expressive typography, and engaging visual experiences bring your website to life.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"busts_in_silhouette\",\"emoji\":\"👥\"}},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"Team, Reviews \u0026 Community\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Introduce your team, share customer stories, and promote workshops, pop-ups, and upcoming events.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"shirt\",\"emoji\":\"👕\"}},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"Merchandise Showcase\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Promote apparel, packaged products, accessories, and branded merchandise.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"newspaper\",\"emoji\":\"📰\"}},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"CMS-Powered Articles\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Publish stories, recipes, guides, announcements, and updates with Framer CMS.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"iphone\",\"emoji\":\"📱\"}},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"Fully Responsive\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Carefully optimized for desktop, tablet, and mobile devices.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"art\",\"emoji\":\"🎨\"}},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"Easy to Customize\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Built with organized layers, reusable components, flexible layouts, and Framer best practices.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"page_facing_up\",\"emoji\":\"📄\"}},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"Pages Included\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Home\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" — Featuring your brand story, specials, menu, reviews, team, merchandise, events, location, articles, FAQ, and more.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Ideas / Articles\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" — A CMS-powered hub for stories, recipes, guides, and updates.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Article Detail\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" — A flexible CMS-powered layout for long-form content.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"dart\",\"emoji\":\"🎯\"}},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"Perfect For\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Matcha cafés, specialty coffee shops, tea houses, bakeries, restaurants, beverage brands, and creative hospitality businesses.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"green_heart\",\"emoji\":\"💚\"}},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"Why Ocha?\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Ocha is made for cafés that want more than a basic website. Bold typography, vibrant visuals, interactive layouts, and community-focused storytelling come together to create a memorable digital experience.\"}]},{\"type\":\"paragraph\"}]},\"introduction\":\"Bold Matcha Cafe Template\",\"slug\":\"ocha-matcha-cafe\",\"author\":{\"framerUserId\":\"3625e752-a44c-48a7-9a2a-eac8e788b703\",\"name\":\"Ambie\",\"slug\":\"ambiework\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/3625e752-a44c-48a7-9a2a-eac8e788b703/xiv2uopd\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/3625e752-a44c-48a7-9a2a-eac8e788b703/xz693nnl\",\"metadata\":{\"tint\":\"hsl(50 47% 30%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"video\",\"url\":\"https://stream.mux.com/Nr00ttQVvV0001cvTsqNC027aovjvqi02yxiEvuMFJQTixAU.m3u8\",\"metadata\":{\"posterUrl\":\"https://image.mux.com/Nr00ttQVvV0001cvTsqNC027aovjvqi02yxiEvuMFJQTixAU/thumbnail.webp?time=15.033\",\"aspectRatio\":\"4:3\",\"duration\":32.616667}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/3625e752-a44c-48a7-9a2a-eac8e788b703/s0lozckt\",\"metadata\":{\"tint\":\"hsl(156 83% 19%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\