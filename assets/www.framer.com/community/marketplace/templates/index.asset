fessional-services\"}],\"styles\":[{\"id\":247,\"name\":\"Professional\",\"slug\":\"professional\"},{\"id\":109,\"name\":\"Modern\",\"slug\":\"modern\"},{\"id\":208,\"name\":\"Dark\",\"slug\":\"dark\"}],\"mainCategory\":{\"id\":3,\"name\":\"Agency\",\"slug\":\"agency\"},\"features\":[{\"id\":1,\"name\":\"Appear Effects\",\"slug\":\"appear-effects\"},{\"id\":17,\"name\":\"Sticky Scrolling\",\"slug\":\"sticky-scrolling\"},{\"id\":18,\"name\":\"Scroll Effects\",\"slug\":\"scroll-effects\"},{\"id\":21,\"name\":\"CMS\",\"slug\":\"cms\"},{\"id\":25,\"name\":\"Custom Cursors\",\"slug\":\"custom-cursors\"},{\"id\":30,\"name\":\"Forms\",\"slug\":\"forms\"},{\"id\":32,\"name\":\"Layout Templates\",\"slug\":\"layout-templates\"},{\"id\":35,\"name\":\"Text Effects\",\"slug\":\"text-effects\"},{\"id\":37,\"name\":\"Code Components\",\"slug\":\"code-components\"},{\"id\":39,\"name\":\"Selection Styles\",\"slug\":\"selection-styles\"}]}},{\"id\":\"66556\",\"resolved\":true,\"title\":\"Parley Agent\",\"body\":\"$74\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Live preview:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"parley.framer.ai\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"http://parley.framer.ai\",\"target\":\"_blank\"}}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Bundles\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Parley is also available with its Figma file and an AI prompt for rebuilding the site as standalone code in Claude Code, Codex, or your favorite tool. Pick the template alone or a \"},{\"type\":\"text\",\"text\":\"bundle at checkout\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noreferrer\",\"href\":\"https://buy.polar.sh/polar_cl_7Q45Ctx5zQj5b442xEeCbt0GFZSBgSHCHDh3I2QfuzY?product_id=6ec699ff-8ea3-4875-8d1d-14414b7de01b\",\"target\":\"_blank\"}}]},{\"type\":\"text\",\"text\":\".\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"A modern AI agent template built on one idea: AI that works with you, not just for you.\",\"marks\":[{\"type\":\"bold\"}]}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Parley is a Framer template for AI startups, SaaS founders, and teams that want a site that reads like a real product, not a side project. A warm, editorial aesthetic that stands apart from the sea of dark, neon AI sites, with the structure to turn visitors into trials.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"What's included\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"11 pages: home, workflows, pricing, blog, contact, waitlist, legal, and 404\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"CMS blog with categories and article pages\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Usage calculator, pricing tiers, integrations showcase, and testimonials\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Waitlist flow with a working form\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Organized styles and reusable components\"}]},{\"type\":\"paragraph\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Easy to customize\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Everything is native Framer and editable on the canvas. Colors and text styles are tokenized, so a palette or type change carries through the whole site.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Perfect for\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"AI agent and automation startups\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"SaaS products and developer tools\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Solo founders launching fast\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Teams replacing a dated landing page\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Built with care\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Accessible structure, one clean H1 per page, unique titles and descriptions, descriptive alt text, and three tuned breakpoints. The unglamorous work is already done.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Get 3 months of Framer Pro free\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" The promo code is inside the template. Apply it to the yearly Pro plan at checkout. Framer's terms apply.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Please note\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Parley is a template and demonstration brand. Connect your own forms, analytics, and services before launch.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Support\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Questions or help getting set up? Reach us any time at \"},{\"type\":\"text\",\"text\":\"alex@apollostudio.design\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"mailto:alex@apollostudio.design\",\"target\":\"_blank\"}}]},{\"type\":\"text\",\"text\":\". Designed and built by \"},{\"type\":\"text\",\"text\":\"Apollo Studio.\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer\",\"href\":\"https://apollostudio.design/\",\"target\":\"_blank\"}}]}]}]},\"introduction\":\"AI SaaS \u0026 Startup Template\",\"slug\":\"parley-agent\",\"author\":{\"framerUserId\":\"b505b9dc-5fa4-42d6-ad8a-36ea114d98d6\",\"name\":\"Alex Prokhorov\",\"slug\":\"alex-prokhorov\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/30678/photo_2023-08-02%2022.18.40-xybJQiuozIgB2Ywelb9O9kcMEVCmz4.jpeg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/b505b9dc-5fa4-42d6-ad8a-36ea114d98d6/019fb2b2-1362-70d7-8cd4-d50117fc070e.jpg\",\"metadata\":{\"tint\":\"hsl(60 53% 39%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"video\",\"url\":\"https://stream.mux.com/L7qUS6necl1x81J3twjDQ5Ca02rcRuI2l02acDJzDvXLc.m3u8\",\"metadata\":{\"posterUrl\":\"https://image.mux.com/L7qUS6necl1x81J3twjDQ5Ca02rcRuI2l02acDJzDvXLc/thumbnail.webp?time=5.383\",\"aspectRatio\":\"4:3\",\"duration\":9.016667}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/b505b9dc-5fa4-42d6-ad8a-36ea114d98d6/0ai8qkwm\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/b505b9dc-5fa4-42d6-ad8a-36ea114d98d6/qkmqbug1\",\"metadata\":{\"tint\":\"hsl(60 53% 39%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/b505b9dc-5fa4-42d6-ad8a-36ea114d98d6/a6hb7dxm\",\"metadata\":{\"tint\":\"hsl(60 53% 39%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019ed1d8-d74c-76d8-a196-71787fe5d89b\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Tired of every AI site looking the same? Dark mode, purple gradient,