":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Live Preview\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer\",\"href\":\"https://launchfolio.framer.website/?utm_source=framer\",\"target\":\"_blank\"}}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Launchfolio: A portfolio template that helps designers land more clients.\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Built after studying dozens of successful design businesses, this template helps you launch your design business in days, not months.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Built for Conversion\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Every section is strategically placed to guide potential clients toward hiring you. From projects to testimonials, each element builds trust and encourages action. It's completely customizable. The minimal design means you can adapt it to your style without breaking what makes it convert.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Why most design portfolios fail to convert:\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Too focused on aesthetics over conversion\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Missing key trust-building elements\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"No clear user journey. This template solves all of that.\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Flexible Image System\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"The multi-reference approach lets you create side-by-side comparisons, and add custom descriptions to explain your process—all without modifying the template structure.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"12/7/25* Image system now supports video file uploads\"}],\"attrs\":{\"level\":2}},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Blog\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Includes category filters and search\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"2/19/26\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"This template has been updated to support Framers new dynamic filters\"}]},{\"type\":\"customImage\",\"attrs\":{\"alt\":\"\",\"src\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/templates/48356-launchnow-q6sjU0smD4uPwuj0KoOOvfaD4DG5nM\",\"link\":null,\"caption\":\"\",\"uploadId\":null}},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Professional Quote Generation\"}],\"attrs\":{\"level\":1}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Include detailed project briefs\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Professional terms and conditions\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Automatically calculates subtotal , vat, and grand total based off line item entries.\"}]}]}]},{\"type\":\"customImage\",\"attrs\":{\"alt\":\"\",\"src\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/templates/48356-launchnow-WTRCSrrNxlMa7Ok0vu17G0K8mjuuII\",\"link\":null,\"caption\":\"\",\"uploadId\":null}},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Built for Real Use\"}],\"attrs\":{\"level\":1}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Clean, minimal design that adapts to your style\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Mobile-optimized viewing\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"SEO-friendly structure\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Real talk: Most designers spend weeks (or months) building their portfolio...and still end up with something that doesn't convert visitors into clients. Why start from scratch when you can build in days with a template that's designed to help you win more clients.\"}],\"attrs\":{\"level\":1}}]},\"introduction\":\"The complete portfolio template\",\"slug\":\"launchnow\",\"author\":{\"framerUserId\":\"300f4c65-27a0-47d9-9b2d-d3e7324b37fb\",\"name\":\"Joseph Alexander\",\"slug\":\"joseph-alexander\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/30929/avatarme-huNfMRLO8tm6y99B5JhCTp23eziKSs.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"video\",\"url\":\"https://stream.mux.com/l01NjmdcdYe2TH9qcDZCWIJ9y8i02fNmdShTh24eD1Pjo.m3u8\",\"metadata\":{\"posterUrl\":\"https://image.mux.com/l01NjmdcdYe2TH9qcDZCWIJ9y8i02fNmdShTh24eD1Pjo/thumbnail.webp?time=6.717\",\"aspectRatio\":\"4:3\",\"duration\":17.233333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/templates/48356/launchnow-OC0qosljvjgCVQbSpJURDvrmGW0t2D\",\"metadata\":{\"tint\":\"hsl(0 0% 58%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/templates/48356/launchnow-oGMFJddhDh9RzrUePgPIE43QvYbUL2\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.