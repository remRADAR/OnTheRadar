\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2025-10-05T14:39:40.756Z\",\"updatedAt\":\"2026-08-28T10:00:55.216Z\",\"publishedAt\":\"2025-10-29T15:17:04.633Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":\"2026-06-01T14:46:12.987Z\",\"type\":\"template\",\"attributes\":{\"price\":\"39\",\"paymentUrl\":\"https://buy.polar.sh/polar_cl_E6svtCeJtd6SAtAOAFRbKAgfPZnoB401VS0Mt05OM5o\",\"remixUrl\":null,\"previewUrl\":\"https://mondragon.framer.website/\",\"categories\":[{\"id\":3,\"name\":\"Agency\",\"slug\":\"agency\"},{\"id\":237,\"name\":\"Marketing\",\"slug\":\"marketing\"},{\"id\":19,\"name\":\"Portfolio\",\"slug\":\"portfolio\"},{\"id\":188,\"name\":\"Art \u0026 Design\",\"slug\":\"art-and-design\"},{\"id\":189,\"name\":\"Artist\",\"slug\":\"artist\"},{\"id\":221,\"name\":\"Graphic Design\",\"slug\":\"graphic-design\"}],\"styles\":[{\"id\":208,\"name\":\"Dark\",\"slug\":\"dark\"}],\"mainCategory\":{\"id\":3,\"name\":\"Agency\",\"slug\":\"agency\"},\"features\":[{\"id\":1,\"name\":\"Appear Effects\",\"slug\":\"appear-effects\"},{\"id\":13,\"name\":\"Slideshows/Tickers\",\"slug\":\"slideshows-tickers\"},{\"id\":21,\"name\":\"CMS\",\"slug\":\"cms\"},{\"id\":25,\"name\":\"Custom Cursors\",\"slug\":\"custom-cursors\"},{\"id\":30,\"name\":\"Forms\",\"slug\":\"forms\"},{\"id\":32,\"name\":\"Layout Templates\",\"slug\":\"layout-templates\"},{\"id\":35,\"name\":\"Text Effects\",\"slug\":\"text-effects\"},{\"id\":36,\"name\":\"3D Transforms\",\"slug\":\"3d-transforms\"},{\"id\":37,\"name\":\"Code Components\",\"slug\":\"code-components\"}]}},{\"id\":\"58378\",\"resolved\":true,\"title\":\"Fuel\",\"body\":\"$50\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Live Preview\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer\",\"href\":\"https://fuel.framer.website/\",\"target\":\"_blank\"}}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Template of the Year 2025 — Framer Awards\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer\",\"href\":\"https://x.com/framer/status/2032142055376633937?s=20\",\"target\":\"_blank\"}},{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Fuel is a remarkable premium agency \u0026 portfolio template crafted to enhance your portfolio's or agency's presentation. It’s an ideal portfolio solution for designers, freelancers, creative agencies, digital agencies, photographers, or anyone in the creative industry who wants to showcase their portfolio or agency's in a clean and sophisticated way. The minimal design keeps the focus entirely on your portfolio or agency, allowing the work to speak for itself.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Whether you're building your first portfolio or looking to refresh your existing one, Fuel offers the perfect balance of simplicity and elegance. Its portfolio-centric layout ensures that every project in your portfolio or agency stands out, free from unnecessary clutter. This template is designed for professionals who value the importance of a well-curated portfolio and agency, helping to make a lasting impression on clients and employers. If you're looking for a powerful and stylish way to present your portfolio or agency, Fuel is the ideal choice to take your portfolio or agency to the next level.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"For anyone serious about their portfolio, Fuel provides everything needed to create a striking portfolio or agency's that commands attention.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Need help or have a question? Feel free to reach out at \",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\"westhillstudio77@gmail.com\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"mailto:westhillstudio77@gmail.com\",\"target\":\"_blank\"}},{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\".\",\"marks\":[{\"type\":\"bold\"}]}]}]},\"introduction\":\"Premium Agency \u0026 Portfolio\",\"slug\":\"fuel\",\"author\":{\"framerUserId\":\"5bc99235-3235-4f92-aff4-e2932ca7af74\",\"name\":\"Westhill Studio\",\"slug\":\"westhill-studio\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/29059/Dark%20logo-9sDWVbDyIvubCoiI69qjDKupxAVZGJ.png\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"video\",\"url\":\"https://stream.mux.com/YEyNjEoTKOlbSmWI02txgFFoipg6a0101iaH3A4c2UEx7s.m3u8\",\"metadata\":{\"posterUrl\":\"https://image.mux.com/YEyNjEoTKOlbSmWI02txgFFoipg6a0101iaH3A4c2UEx7s/thumbnail.webp?time=9.572\",\"aspectRatio\":\"179:134\",\"duration\":17.816667}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/templates/58378/fuel-cxVfde7R2p54adU3CSTkTlNHUEwfXq\",\"metadata\":{\"tint\":\"hsl(0 0% 9%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/templates/58378/fuel-p2U93BUVu7H1ytaAqsNg7R0OQm8YBX\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019b03a8-f790-7215-857c-96ca5dcca136\",\"bodyJson\":null,\"likes\":{\"count\":2332,\"liked\":false},\"comments\":{\"count\":56},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2025-11-28T15:05:04.194Z\",\"updatedAt\":\"2026-08-28T04:57:28.546Z\",\"publishedAt\":\"2025-12-09T15:09:23.728Z\",\"featuredAt\":\"2026-06-15T13:34:50.719Z\",\"reported\":false,\"approvedAt\":\"2026-06-01T14:46:12.987Z\",\"type\":\"template\",\"attributes\":{\"price\":null,\"paymentUrl\":\"https://framer.link/xkiLfDJ\",\"remixUrl\":\"https://framer.link/xkiLfDJ\",\"previewUrl\":\"https://fuel.framer.website/\",\"categories\":[{\"id\":3,\"name\":\"Agency\",\"slug\":\"agency\"},{\"id\":16,\"name\":\"Personal\",\"slug\":\"personal\"},{\"