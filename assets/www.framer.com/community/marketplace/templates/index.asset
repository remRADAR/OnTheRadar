\":\"light\"},{\"id\":109,\"name\":\"Modern\",\"slug\":\"modern\"},{\"id\":110,\"name\":\"Animated\",\"slug\":\"animated\"},{\"id\":111,\"name\":\"Minimal\",\"slug\":\"minimal\"},{\"id\":222,\"name\":\"Grid\",\"slug\":\"grid\"}],\"mainCategory\":{\"id\":25,\"name\":\"Property\",\"slug\":\"real-estate\"},\"features\":[{\"id\":1,\"name\":\"Appear Effects\",\"slug\":\"appear-effects\"},{\"id\":13,\"name\":\"Slideshows/Tickers\",\"slug\":\"slideshows-tickers\"},{\"id\":17,\"name\":\"Sticky Scrolling\",\"slug\":\"sticky-scrolling\"},{\"id\":18,\"name\":\"Scroll Effects\",\"slug\":\"scroll-effects\"},{\"id\":21,\"name\":\"CMS\",\"slug\":\"cms\"},{\"id\":30,\"name\":\"Forms\",\"slug\":\"forms\"},{\"id\":32,\"name\":\"Layout Templates\",\"slug\":\"layout-templates\"},{\"id\":35,\"name\":\"Text Effects\",\"slug\":\"text-effects\"},{\"id\":37,\"name\":\"Code Components\",\"slug\":\"code-components\"}]}},{\"id\":\"56191\",\"resolved\":true,\"title\":\"Agenciy\",\"body\":\"$80\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Agenciy is a modern Creative \u0026 Digital Agency Framer template designed for agencies that want to launch a professional, conversion-focused website without starting from scratch.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Built for creative agencies, digital agencies, marketing agencies, design studios, branding agencies, web agencies, and development studios, Agenciy provides everything you need to showcase your services, projects, expertise, and results while turning visitors into potential clients.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Why Choose Agenciy?\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Agenciy combines bold, modern design with a conversion-focused structure built around real agency needs. Showcase your services, case studies, testimonials, team, and work through carefully designed sections that clearly communicate what you do and why clients should choose you.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Every page is fully responsive and easy to customize in Framer, allowing you to quickly adapt the colors, typography, imagery, and content to match your brand.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Key Features\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Modern creative agency design\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Fully responsive across desktop, tablet, and mobile\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"CMS-powered projects and blog\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Services and case study sections\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Testimonials and social proof\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Contact forms\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Smooth animations and scroll effects\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Custom interactions and cursor effects\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Premium typography\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Easy Framer customization\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Conversion-focused layouts\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Perfect For\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Creative Agencies • Digital Agencies • Marketing Agencies • Design Studios • Branding Agencies • Web Design Agencies • Development Studios • Creative Businesses\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Live Preview\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"https://agenciy.framer.website/\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"https://agenciy.framer.website/\",\"target\":\"_blank\"}}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"More Premium Templates\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"https://www.framer.com/@nframe/?tab=template\u0026sort=popular\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"https://www.framer.com/@nframe/?tab=template\u0026sort=popular\",\"target\":\"_blank\"}}]}]}]},\"introduction\":\"Creative Agency \u0026 Marketing Agency\",\"slug\":\"agenciy\",\"author\":{\"framerUserId\":\"37c240a6-d191-4737-bb34-b07d82d65414\",\"name\":\"NFrame\",\"slug\":\"nframe\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/980653/avatar-lyo51cYZXv2UyGVPVIkntWxfLIzEJg.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/templates/56191/agenciy-aIgSDo7zNPtj2vNvO0KgfAyrp3mg8z\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/templates/56191/agenciy-VKrFWFOYjPTPVhLJrPAmSeI2HDY4NW\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/templates/56191/agenciy-mZSdEcZMRdWFwFsPNNlXl17nQXhQBP\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/templates/56191/agenciy-ChO1elrylKq96Wjt6l7v41XLqQB1qZ\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019a0c30-4f89-71cc-94c9-2dd3407d7228\",\"bodyJson\":null,\"likes\":{\"count\":1036,\"liked\":false},\"comments\":{\"count\":35},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2025-10-01T07:50:08.342Z\",\"updatedAt\":\"2026-08-25T14:23:32.733Z\",\"publishedAt\":\"2025-10-22T13:51:24.041Z\",\"featuredAt\":\"2026-06-19T09:41:22.167Z\",\"reported\":false,\"approvedAt\":\"2026-06-01T14:46:12.987Z\",\"type\":\"template\",\"attributes\":{\"price\":null,\"paymentUrl\":\"https://framer.link/lDW4Nkz\",\"remixUrl\":\"https://framer.link/lDW4Nkz\",\"previewUrl\":\"https://agenciy.framer.website/\",\"categories\":[{\"id\":3,\"name\":\"Agency\",\"slug\":\"agency\"},{\"id\":19,\"name\":\"Portfolio\",\"slug\":\"portfolio\"},{\"id\":14,\"name\":\"Landing Page\",\"slug\":\"landing-page\"},{\"id\":218,\"name\":\"Free\",\"slug\":\"free-website-templates\"}],\"styles\":[{\"id\":239,\"name\":\"Monochromatic\",\"slug\":\"monochromatic\"},{\"id\":110,\"name\":\"Animated\",\"slug\":\"animated\"},{\"id\":111,\"name\":\"Minimal\",\"slug\":\"minimal\"},{\"id\":193,\"name\":\"Black \u0026 White\",\"slug\":\"black-and-white\"},{\"id\":6,\"name\":\"3D\",\"slug\":\"3d\"}],\"mainCategory\":{\"id\":3,\"name\":\"Agency\",\"slug\":\"agency\"},\"features\":[{\"id\":1,\"name\":\"Appear Effects\",\"slug\":\"appear-effects\"},{\"id\":9,\"name\":\"Overlays \u0026 Modals\",\"slug\":\"overlays-modals\"},{\"id\":13,\"name\":\"Slideshows/Tickers\",\"slug\":\"slideshows-tickers\"},{\"id\":18,\"name\":\"Scroll Effects\",\"slug\":\"scroll-effects\"},{\"id\":21,\"name\":\"CMS\",\"slug\":\"cms\"},{\"id\":23,\"name\":\"Rich Media\",\"slug\":\"rich-media\"},{\"id\":25,\"name\":\"Custom Cursors\",\"slug\":\"custom-cursors\"},{\"id\":30,\"name\":\"Forms\",\"slug\":\"forms\"},{\"id\":32,\"name\":\"Layout Templates\",\"slug\":\"layout-templates\"},{\"id\":35,\"name\":\"Text Effects\",\"slug\":\"text-effects\"},{\"id\":37,\"name\":\"Code Components\",\"slug\":\"code-components\"}]}},{\"id\":\"66901\",\"resolved\":true,\"title\":\"ArcSphere Studio\",\"body\":\"$81\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"ArcSphere Studio\"},{\"type\":\"emoji\",\"attrs\":{\"name\":\"registered\",\"emoji\":\"®\"}},{\"type\":\"text\",\"text\":\" | Modern Architecture Portfolio\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"link\",\"emoji\":\"🔗\"}},{\"type\":\"text\",\"text\":\" \",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\"Preview Here\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"https://arcsphere-studio.framer.website/\",\"target\":\"_blank\"}},{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"ArcSphere Studio is a premium architecture Framer template designed for architects, interior designers, landscape studios, urban planners, and creative firms that want a refined online presence.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Featuring minimalist layouts, immersive project showcases, CMS-powered case studies, premium animations, and a fully responsive experience, it's built to present your work with clarity, professionalism, and impact—without writing code.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Key Features\"}],\"attrs\":{\"level\":1}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Minimal architecture-inspired design\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Immersive project showcases\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"CMS-powered portfolio \u0026 case studies\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Premium animations \u0026 micro-interactions\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Fully responsive across all devices\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"No-code customization\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Organized components\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Performance optimized\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Perfect For\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Architects, architecture studios, interior designers, landscape architects, urban planners, luxury real estate developers, design consultancies, creative agencies, and freelance design professionals.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"What's Included\"}],\"attrs\":{\"level\":1}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"25% OFF Framer Yearly Plan Promo Code\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"FREE Lifetime Updates\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Fully Responsive Design\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"CMS-Powered Projects \u0026 Case Studies\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Premium Animations \u0026 Micro-Interactions\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Organized Components \u0026 Easy Customization\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Premium Email Support (including live call/video guidance)\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Optional Customization Available\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Need help getting started? A \"},{\"type\":\"text\",\"text\":\"Customization Plan\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" is available at checkout, including branding setup (logo, colors, fonts), content replacement, and website publishing using the assets you provide.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Please note that this service \"},{\"type\":\"text\",\"text\":\"does not include\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" redesigning existing sections, adding new sections or pages, custom development, or changing the template's layout or functionality. Any additional custom work is quoted separately.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Refund Policy\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Due to the nature of digital products, \"},{\"type\":\"text\",\"text\":\"all purchases are final and non-refundable\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\".\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Support\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Premium email support is included with every purchase.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Email:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"contact@firstframe.agency\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"mailto:contact@firstframe.agency\",\"target\":\"_blank\"}}]}]}]},\"introduction\":\"Modern Architecture Portfolio\",\"slug\":\"arcsphere-studio\",\"author\":{\"framerUserId\":\"4b8eacfd-b979-4bb5-942b-85860303ad92\",\"name\":\"Talha Nawaz\",\"slug\":\"talha-uxd\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/745367/avatar-OpfMzB8yXp4YVO6sulGpIXL86P9Tyz.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/4b8eacfd-b979-4bb5-942b-85860303ad92/dympwmio\",\"metadata\":{\"tint\":\"hsl(0 50% 6%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/4b8eacfd-b979-4bb5-942b-85860303ad92/hzo561mr\",\"metadata\":{\"tint\":\"hsl(60 26% 47%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/4b8eacfd-b979-4bb5-942b-85860303ad92/r1dhk674\",\"metadata\":{\"tint\":\"hsl(0 13% 60%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/4b8eacfd-b979-4bb5-942b-85860303ad92/osnw8nyh\",\"metadata\":{\"tint\":\"hsl(30 13% 27%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019ed458-3441-7540-be08-fac3125732f8\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Hello Framer Community!\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Just published my first Framer template on the Marketplace.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"ArcSphere Studio, a minimal architecture portfolio template built for architects, interior designers, and creative studios who want their work to feel premium online.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Designed to make architecture portfolios look sharp, refined, and easy to explore.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"I’d love to hear your thoughts, feedback, and suggestions.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Check it out here: \"},{\"type\":\"text\",\"text\":\"https://arcsphere-studio.framer.website/\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"https://arcsphere-studio.framer.website/\",\"target\":\"_blank\"}}]}]}]},\"likes\":{\"count\":200,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-06-17T06:50:10.832Z\",\"updatedAt\":\"2026-08-13T14:03:04.385Z\",\"publishedAt\":\"2026-06-17T06:50:10.825Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"template\",\"attributes\":{\"price\":\"59\",\"paymentUrl\":\"https://buy.polar.sh/polar_cl_QwArz8pkwHxLId113Pc3m0IW4cnDLRESadxKd0Z2NCJ\",\"remixUrl\":null,\"previewUrl\":\"https://arcsphere-studio.framer.website/\",\"categories\":[{\"id\":19,\"name\":\"Portfolio\",\"slug\":\"portfolio\"},{\"id\":14,\"name\":\"Landing Page\",\"slug\":\"landing-page\"},{\"id\":187,\"name\":\"Architecture\",\"slug\":\"architecture\"},{\"id\":210,\"name\":\"Digital Products\",\"slug\":\"digital-products\"},{\"id\":230,\"name\":\"Interior Design\",\"slug\":\"interior-design\"}],\"styles\":[],\"mainCategory\":{\"id\":25,\"name\":\"Property\",\"slug\":\"real-estate\"},\"features\":[{\"id\":1,\"name\":\"Appear Effects\",\"slug\":\"appear-effects\"},{\"id\":9,\"name\":\"Overlays \u0026 Modals\",\"slug\":\"overlays-modals\"},{\"id\":13,\"name\":\"Slideshows/Tickers\",\"slug\":\"slideshows-tickers\"},{\"id\":18,\"name\":\"Scroll Effects\",\"slug\":\"scroll-effects\"},{\"id\":21,\"name\":\"CMS\",\"slug\":\"cms\"},{\"id\":23,\"name\":\"Rich Media\",\"slug\":\"rich-media\"},{\"id\":25,\"name\":\"Custom Cursors\",\"slug\":\"custom-cursors\"},{\"id\":30,\"name\":\"Forms\",\"slug\":\"forms\"},{\"id\":35,\"name\":\"Text Effects\",\"slug\":\"text-effects\"},{\"id\":40,\"name\":\"Variable Fonts\",\"slug\":\"variable-fonts\"}]}},{\"id\":\"70759\",\"resolved\":true,\"title\":\"Mira\",\"body\":\"$82\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Live preview\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer\",\"href\":\"https://mirastudio.framer.website/?utm_source=framer\",\"target\":\"_blank\"}}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Mira is an editorial template for studios that refuse to blend in. Built around a simple fiction: a small, personality-led studio where clients talk directly to the maker. Quiet copy, huge display type, a single red accent, work that does the talking.\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Powered by WebGL\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Three custom WebGL components give Mira motion you won't find in other templates, with ten transition effects like Noise Warp, Liquid, and Dissolve built in. The fullscreen hero slider and project showcase run on your Projects CMS: add a project once and it shows up in the hero, the showcase, and its own page. Both play images or videos, ripple and bend as your cursor moves, and every effect adjusts with simple sliders. No code anywhere.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"The preloader counts up while your site actually loads, then reveals the page through your own logo. Swap the logo, pick how it enters, done. Even the 404 turns your text into a 3D wireframe that shatters and swirls under the cursor.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"See the 404 page in action\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"https://mirastudio.framer.website/404?utm_source=framer\",\"target\":\"_blank\"}}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Everything runs on the CMS\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Five connected collections power the whole site. Projects know their services, articles know their authors. Case studies come with image or video headers, galleries, results, and client quotes. Change something once and it updates everywhere it appears.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Rich features\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"A contact form that reads like a conversation and confirms your message arrived. A pricing calculator your visitors can actually use: tick add-ons, the total updates live. And the demo content is fully written, so you're editing a working site instead of staring at empty boxes.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Heavily documented\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"You're never customizing alone. A user guide and style guide sit right on the canvas, and the customization guide comes with ready-made AI prompts: restyle Mira by telling an agent what you want.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Contact\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Questions? \"},{\"type\":\"text\",\"text\":\"joseph@launchnow.design\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"mailto:joseph@launchnow.design\",\"target\":\"_blank\"}},{\"type\":\"bold\"}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Most templates are a layout you fill in. Mira is a point of view with an engine under it.\"}],\"attrs\":{\"level\":1}}]},\"introduction\":\"Design Agency Template\",\"slug\":\"mira\",\"author\":{\"framerUserId\":\"300f4c65-27a0-47d9-9b2d-d3e7324b37fb\",\"name\":\"Joseph Alexander\",\"slug\":\"joseph-alexander\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/30929/avatarme-huNfMRLO8tm6y99B5JhCTp23eziKSs.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/300f4c65-27a0-47d9-9b2d-d3e7324b37fb/01a001d2-ee03-752d-8306-01337b98fd03.jpg\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/300f4c65-27a0-47d9-9b2d-d3e7324b37fb/019fd270-311b-74b9-9f5a-d17e38750786.jpg\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/300f4c65-27a0-47d9-9b2d-d3e7324b37fb/019fd270-4685-74fe-a6a4-662dc8c908fc.jpg\",\"metadata\":{\"tint\":\"hsl(0 0% 9%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019fd273-470e-724e-b498-7de375b2bdd8\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Mira just dropped. My best template yet. Take a look and drop a like/comment if you approve :D\"}]}]},\"likes\":{\"count\":104,\"liked\":false},\"comments\":{\"count\":18},\"reposts\":{\"count\":0,