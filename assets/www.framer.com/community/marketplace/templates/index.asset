,\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"https://organic-labeling-071396.framer.app/\",\"target\":\"_blank\"}}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"1 Prompt. 1 Customized Template.\",\"marks\":[{\"type\":\"code\"}]}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"This template comes with a custom AI prompt built specifically for it, covering every page, section, text field, image, button, and link.\",\"marks\":[{\"type\":\"code\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Simply copy the prompt, paste it into the Framer AI Agent, fill in your content, and click Share. The AI Agent will customize the template for you while keeping the original design and layout intact.\",\"marks\":[{\"type\":\"code\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"No complicated editing. Just fill in your content and let the AI do the work.\",\"marks\":[{\"type\":\"code\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Mariano\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" is a minimal, editorial portfolio template built around strong UX, clean typography, and a direct visual experience.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Designed for \"},{\"type\":\"text\",\"text\":\"photographers, videographers, creatives, and personal brands\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\", Mariano puts the work first with a carefully considered layout that keeps navigation simple and the interface intentionally minimal.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Whether you're a photographer showcasing a collection, a videographer presenting your latest work, or a creative building a personal portfolio, Mariano gives you a refined foundation that is easy to customize while maintaining a strong visual hierarchy.\"}]},