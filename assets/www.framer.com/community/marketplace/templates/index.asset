9,\"name\":\"Portfolio\",\"slug\":\"portfolio\"},{\"id\":14,\"name\":\"Landing Page\",\"slug\":\"landing-page\"},{\"id\":218,\"name\":\"Free\",\"slug\":\"free-website-templates\"}],\"styles\":[{\"id\":261,\"name\":\"Typographic\",\"slug\":\"typographic\"},{\"id\":110,\"name\":\"Animated\",\"slug\":\"animated\"},{\"id\":111,\"name\":\"Minimal\",\"slug\":\"minimal\"}],\"mainCategory\":{\"id\":3,\"name\":\"Agency\",\"slug\":\"agency\"},\"features\":[{\"id\":1,\"name\":\"Appear Effects\",\"slug\":\"appear-effects\"},{\"id\":9,\"name\":\"Overlays \u0026 Modals\",\"slug\":\"overlays-modals\"},{\"id\":13,\"name\":\"Slideshows/Tickers\",\"slug\":\"slideshows-tickers\"},{\"id\":17,\"name\":\"Sticky Scrolling\",\"slug\":\"sticky-scrolling\"},{\"id\":18,\"name\":\"Scroll Effects\",\"slug\":\"scroll-effects\"},{\"id\":21,\"name\":\"CMS\",\"slug\":\"cms\"},{\"id\":25,\"name\":\"Custom Cursors\",\"slug\":\"custom-cursors\"},{\"id\":32,\"name\":\"Layout Templates\",\"slug\":\"layout-templates\"},{\"id\":35,\"name\":\"Text Effects\",\"slug\":\"text-effects\"},{\"id\":36,\"name\":\"3D Transforms\",\"slug\":\"3d-transforms\"},{\"id\":37,\"name\":\"Code Components\",\"slug\":\"code-components\"},{\"id\":39,\"name\":\"Selection Styles\",\"slug\":\"selection-styles\"},{\"id\":40,\"name\":\"Variable Fonts\",\"slug\":\"variable-fonts\"},{\"id\":41,\"name\":\"Vector Sets\",\"slug\":\"vector-sets\"}]}},{\"id\":\"54139\",\"resolved\":true,\"title\":\"Norell Website\",\"body\":\"$67\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"View live demo\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer\",\"href\":\"https://norelltemplate.framer.website/\",\"target\":\"_blank\"}}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Norell is a creative portfolio and agency Framer template for design studios, branding agencies, and freelance designers. Build a complete website to showcase photography, design, or branding work with a minimalist aesthetic and bold typography.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"The template includes a CMS project gallery, a services section covering Branding, Development, Motion Design, and UI/UX, testimonials, built-in pricing tables, and a CMS blog across 10 or more pages.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"What is Included\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"10 or more pages covering Home, About, Services, Projects, Blog, Contact, Pricing, and legal pages. CMS-driven detail pages support both project and blog content, manageable without code.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Key Features\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"The services section covers Branding, Development, Motion Design, and UI/UX categories. Pricing tables present offerings clearly to visitors. The testimonials section highlights client feedback. Dynamic CMS integration supports adding new projects, blog posts, or team members at any time.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Who This Is For\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Suited to creative studios, design agencies, branding and art direction firms, freelance designers, and motion design and UX agencies needing a minimal portfolio-forward website.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Template Details\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Platform Framer, 10 or more pages, CMS-driven project and blog sections, pricing tables, testimonials section, legal pages included, fully responsive, no code required, one purchase for unlimited sites.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Norell gives creative studios and agencies a clean, design-led website with a CMS portfolio, structured services, and built-in pricing for client conversion.\"}]}]},\"introduction\":\"Creative \u0026 Portfolio Web template\",\"slug\":\"norell-website\",\"author\":{\"framerUserId\":\"1364828a-b355-487e-b32f-02641033b191\",\"name\":\"Tanjim Islam\",\"slug\":\"tanjim-islam\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/28885/avatar-ctk9oa9jzfLVvcTdTNu7W0AGiFbWhc.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/1364828a-b355-487e-b32f-02641033b191/019ff497-5913-727d-9bec-0c78e08f727d.png\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"video\",\"url\":\"https://stream.mux.com/cX4sYRWirck7zoZJSrpit01QM00v6rLJBQIc00baKDuzS8.m3u8\",\"metadata\":{\"posterUrl\":\"https://image.mux.com/cX4sYRWirck7zoZJSrpit01QM00v6rLJBQIc00baKDuzS8/thumbnail.webp?time=2.833\",\"aspectRatio\":\"4:3\",\"duration\":45.621333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/templates/54139/norell-RUM9e7OJGwVxapzWiopljY6p6DMNBu\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/templates/54139/norell-MAkYudRiGUVAuK87PWlmMwS1nsuXv0\",\"metadata\":{\"tint\":\"hsl(180 17% 19%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"01987fa9-facd-7ed8-ace2-85b00218d36e\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Norell is Free for you; take it now: \"},{\"type\":\"emoji\",\"attrs\":{\"name\":\"point_down\",\"emoji\":\"👇\"}},{\"type\":\"text\",\"text\":\"https://framer.link/CVlmpWG\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"https://framer.link/CVlmpWG\",\"target\":\"_blank\"}}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Designed for creative studios and branding agencies who want their portfolio to feel premium. Features a CMS project gallery, CMS blog, four service sections, pricing tables, client testimonials, and 10 thoughtfully crafted pages. Simple to customize, strong first impression.\",\"marks\":[{\"type\":\"code\"}]}]}]},\"likes\":{\"count\":1007,\"liked\":false},\"comments\":{\"count\":96},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2025-07-14T10:56:38.099Z\",\"updatedAt\":\"2026-08-28T04:51:10.810Z\",\"publishedAt\":\"2025-08-06T13:55:02.989Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":\"2026-06-01T14:46:12.987Z\",\"type\":\"template\",\"attributes\":{\"price\":null,\"paymentUrl\":\"https://framer.link/Q7xSYps\",\"remixUrl\":\"https://framer.link/Q7xSYps\",\"previewUrl\":\"https://norelltemplate.framer.website/\",\"categories\":[{\"id\":3,\"name\":\"Agency\",\"slug\":\"agency\"},{\"id\":19,\"name\":\"Portfolio\",\"slug\":\"portfolio\"},{\"id\":14,\"name\":\"Landing Page\",\"slug\":\"landing-page\"},{\"id\":218,\"name\":\"Free\",\"slug\":\"free-website-templates\"}],\"styles\":[{\"id\":234,\"name\":\"Large Type\",\"slug\":\"large-type\"},{\"id\":247,\"name\":\"Professional\",\"slug\":\"professional\"},{\"id\":109,\"name\":\"Modern\",\"slug\":\"modern\"},{\"id\":110,\"name\":\"Animated\",\"slug\":\"animated\"},{\"id\":111,\"name\":\"Minimal\",\"slug\":\"minimal\"}],\"mainCategory\":{\"id\":3,\"name\":\"Agency\",\"slug\":\"agency\"},\"features\":[{\"id\":1,\"name\":\"Appear Effects\",\"slug\":\"appear-effects\"},{\"id\":18,\"name\":\"Scroll Effects\",\"slug\":\"scroll-effects\"},{\"id\":21,\"name\":\"CMS\",\"slug\":\"cms\"},{\"id\":25,\"name\":\"Custom Cursors\",\"slug\":\"custom-cursors\"},{\"id\":30,\"name\":\"Forms\",\"slug\":\"forms\"},{\"id\":32,\"name\":\"Layout Templates\",\"slug\":\"layout-templates\"},{\"id\":35,\"name\":\"Text Effects\",\"slug\":\"text-effects\"},{\"id\":37,\"name\":\"Code Components\",\"slug\":\"code-components\"},{\"id\":38,\"name\":\"P3 Colors\",\"slug\":\"p3-colors\"},{\"id\":39,\"name\":\"Selection Styles\",\"slug\":\"selection-styles\"}]}},{\"id\":\"61205\",\"resolved\":true,\"title\":\"Meeko\",\"body\":\"$68\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"link\",\"emoji\":\"🔗\"}},{\"type\":\"text\",\"text\":\"  \",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\"Live preview →\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer\",\"href\":\"https://meeko-template.framer.website/\",\"target\":\"_blank\"}}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"point_right\",\"emoji\":\"👉\"}},{\"type\":\"text\",\"text\":\"  \"},{\"type\":\"text\",\"text\":\"Browse more free templates →\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer\",\"href\":\"https://www.framer.com/@elemis-themes/?tab=template\u0026sort=popular\",\"target\":\"_blank\"}}]}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Meeko is a modern Framer portfolio template built for designers, developers, freelancers, and creative professionals who want a clean and professional portfolio website.\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" With flexible layouts, CMS-powered content, and reusable UI components, Meeko makes it easy to launch a polished personal portfolio.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"The template includes \"},{\"type\":\"text\",\"text\":\"3 home page layouts and 2 portfolio layout options\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\", giving you multiple ways to present your projects and customize the structure of your site.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Meeko also features modern interactions including \"},{\"type\":\"text\",\"text\":\"slideshows, sticky navigation, smooth animations, and scroll-based animations\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\", creating a dynamic browsing experience while keeping the design minimal and professional.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Whether you are creating a \"},{\"type\":\"text\",\"text\":\"designer portfolio, developer portfolio, or creative personal website\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\", Meeko includes the essential sections and components needed to showcase your work, skills, and experience clearly.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Key Features\"}],\"attrs\":{\"level\":1}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"3 Home Page Layouts\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" – Three modern home page designs for a strong first impression.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"2 Portfolio Layouts\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" – Two flexible layouts to showcase your work.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Portfolio CMS\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" – Easily manage and display portfolio projects.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Blog CMS\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" – Publish articles and improve SEO with the built-in blog.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Slideshow Sections\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" – Showcase featured projects and content\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Tabs Component\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" – Organize services, skills, or testimonials.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Testimonial Sections\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" – Display client feedback with tabs or sliders.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Skills with Progress Bars\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" – Present your expertise visually.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Animated Counters\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" – Highlight key numbers and achievements.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Experience Timeline\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" – Showcase your career and milestones.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"FAQ Section\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" – Organize common questions with an accordion.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Process Section\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" – Explain your workflow step by step.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Contact Form\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" – Make it easy for clients to get in touch.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Modern Interactions\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" – Smooth animations, sticky navigation, slideshows, scroll effects, and interactive testimonials.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Fully Responsive\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" – Optimized for desktop, tablet, and mobile.\"}]}]}]}]},\"introduction\":\"Creative Portfolio Template\",\"slug\":\"meeko\",\"author\":{\"framerUserId\":\"db7a6821-a4ec-45fb-88fc-f791fbb3c977\",\"name\":\"Elemis Themes\",\"slug\":\"elemis-themes\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/db7a6821-a4ec-45fb-88fc-f791fbb3c977/vkpu3qsq\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/db7a6821-a4ec-45fb-88fc-f791fbb3c977/019f9463-3d7c-7368-ae22-95bd13641335.jpg\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/db7a6821-a4ec-45fb-88fc-f791fbb3c977/01a0287f-b9a9-7180-9e48-b0c00484ba1e.jpg\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/db7a6821-a4ec-45fb-88fc-f791fbb3c977/01a0287f-c4ed-750c-b439-5af95d016315.jpg\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019d447c-247b-74a2-a8d3-dcd6fd35b989\",\"bodyJson\":null,\"likes\":{\"count\":1165,\"liked\":false},\"comments\":{\"count\":17},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-03-08T08:12:08.628Z\",\"updatedAt\":\"2026-08-25T06:48:40.301Z\",\"publishedAt\":\"2026-03-31T15:21:19.739Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":\"2026-06-01T14:46:12.987Z\",\"type\":\"template\",\"attributes\":{