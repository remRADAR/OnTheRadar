\"type\":\"template\",\"attributes\":{\"price\":null,\"paymentUrl\":\"https://framer.link/mDshHfx\",\"remixUrl\":\"https://framer.link/mDshHfx\",\"previewUrl\":\"https://villo.framer.website/\",\"categories\":[{\"id\":107,\"name\":\"Resume\",\"slug\":\"resume-cv\"},{\"id\":16,\"name\":\"Personal\",\"slug\":\"personal\"},{\"id\":19,\"name\":\"Portfolio\",\"slug\":\"portfolio\"},{\"id\":218,\"name\":\"Free\",\"slug\":\"free-website-templates\"}],\"styles\":[{\"id\":234,\"name\":\"Large Type\",\"slug\":\"large-type\"},{\"id\":247,\"name\":\"Professional\",\"slug\":\"professional\"},{\"id\":236,\"name\":\"Light\",\"slug\":\"light\"},{\"id\":110,\"name\":\"Animated\",\"slug\":\"animated\"},{\"id\":208,\"name\":\"Dark\",\"slug\":\"dark\"}],\"mainCategory\":{\"id\":19,\"name\":\"Portfolio\",\"slug\":\"portfolio\"},\"features\":[{\"id\":1,\"name\":\"Appear Effects\",\"slug\":\"appear-effects\"},{\"id\":7,\"name\":\"Light \u0026 Dark Theme\",\"slug\":\"light-dark-theme\"},{\"id\":17,\"name\":\"Sticky Scrolling\",\"slug\":\"sticky-scrolling\"},{\"id\":18,\"name\":\"Scroll Effects\",\"slug\":\"scroll-effects\"},{\"id\":21,\"name\":\"CMS\",\"slug\":\"cms\"},{\"id\":30,\"name\":\"Forms\",\"slug\":\"forms\"}]}},{\"id\":\"70521\",\"resolved\":true,\"title\":\"Optique\",\"body\":\"$a0\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Optique\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" is a bold and thoughtfully crafted Framer template created for creative studios, design agencies, branding teams, and independent creatives who want their work to command attention.\"}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Built around expressive typography, immersive motion, and a refined editorial layout, Optique transforms your portfolio into a memorable digital experience. Every section is designed to communicate your studio’s personality, capabilities, and creative process with clarity and confidence.\"}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Showcase selected projects, introduce your services, present pricing, explain your creative process, share testimonials, publish studio insights, and guide potential clients towards making an enquiry.\"}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"What’s Included\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Striking creative studio homepage \"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Dedicated portfolio and case-study pages \"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Services and pricing sections \"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Interactive process presentation\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\" Client testimonials \"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Studio articles and insights\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\" FAQs and contact experience \"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Fully responsive layouts\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Smooth animations and polished interactions\"}]}]}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Whether you run a branding studio, digital agency, motion design practice, or multidisciplinary creative team, Optique gives you the structure and flexibility to create a portfolio that feels professional, distinctive, and unmistakably yours.\"}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Everything can be customised directly inside Framer. Replace the content, images, colours, typography, and project details to match your studio identity.\"}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"For Customisation:\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Need help customising the template for your brand or business? View my portfolio and contact me here:\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"https://ganesh.framer.media/\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer\",\"href\":\"https://ganesh.framer.media/\",\"target\":\"_blank\"}},{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" \",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Refund Policy:\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"As all our products are digital and delivered instantly, all sales are final and refunds are not available. Please review the product details carefully before purchasing, and contact us with any questions before completing your order.\"}]}]},\"introduction\":\"Creative Studio \u0026 Agency Template\",\"slug\":\"optique\",\"author\":{\"framerUserId\":\"49a22493-90bb-4cba-9e93-fb0906bf01af\",\"name\":\"Ganesh K\",\"slug\":\"ganesh-k-aefzws\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/431666/avatar-dxUhEWpVMtQRHLzSYrNkoHSOcfiXee.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"video\",\"url\":\"https://stream.mux.com/CGmcgVAY00UGRv2ArO9SLDa6UBIiAM01dQ00fFJS6u0001aw.m3u8\",