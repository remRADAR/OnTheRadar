phy\"},{\"id\":19,\"name\":\"Portfolio\",\"slug\":\"portfolio\"},{\"id\":188,\"name\":\"Art \u0026 Design\",\"slug\":\"art-and-design\"},{\"id\":221,\"name\":\"Graphic Design\",\"slug\":\"graphic-design\"},{\"id\":218,\"name\":\"Free\",\"slug\":\"free-website-templates\"}],\"styles\":[{\"id\":109,\"name\":\"Modern\",\"slug\":\"modern\"},{\"id\":111,\"name\":\"Minimal\",\"slug\":\"minimal\"}],\"mainCategory\":{\"id\":19,\"name\":\"Portfolio\",\"slug\":\"portfolio\"},\"features\":[{\"id\":1,\"name\":\"Appear Effects\",\"slug\":\"appear-effects\"},{\"id\":7,\"name\":\"Light \u0026 Dark Theme\",\"slug\":\"light-dark-theme\"},{\"id\":17,\"name\":\"Sticky Scrolling\",\"slug\":\"sticky-scrolling\"},{\"id\":18,\"name\":\"Scroll Effects\",\"slug\":\"scroll-effects\"},{\"id\":21,\"name\":\"CMS\",\"slug\":\"cms\"},{\"id\":41,\"name\":\"Vector Sets\",\"slug\":\"vector-sets\"}]}},{\"id\":\"70658\",\"resolved\":true,\"title\":\"Boolka\",\"body\":\"$7a\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"customHeading\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"point_right\",\"emoji\":\"👉\"}},{\"type\":\"text\",\"text\":\" Live Preview\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer\",\"href\":\"https://boolka.framer.website/\",\"target\":\"_blank\"}},{\"type\":\"bold\"}]}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"MORE TEMPLATES →\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer\",\"href\":\"https://www.framer.com/@rkoby/?tab=template\",\"target\":\"_blank\"}}]}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Boolka - Bakery \u0026 cafe Framer template\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Boolka is a warm and playful Framer template created for cafes, bakeries, brunch spots, coffee shops, and food brands with a strong personality.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Built around bold typography, appetising photography, expressive colours, and relaxed editorial layouts, Boolka helps turn a simple cafe website into a memorable digital experience.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"The template gives visitors everything they need to explore the menu, discover the story behind the place, check opening hours and location details, and make a booking. Every section is designed to feel welcoming, fresh, and full of character.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Made fresh for cafe culture.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Included pages\"}],\"attrs\":{\"level\":1}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Home\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Menu\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"About\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Contact\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"404\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Key features\"}],\"attrs\":{\"level\":1}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Bold and playful cafe design\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Large food-focused hero section\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Menu and featured item layouts\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Opening hours and location information\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Clear booking calls to action\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Story and team sections\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Image-led editorial layouts\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Smooth Framer interactions\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Fully responsive across desktop, tablet, and mobile\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Easy customisation without code\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Who it is for\"}],\"attrs\":{\"level\":1}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Independent cafes\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Artisan bakeries\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Brunch restaurants\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Coffee shops\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Pastry studios\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Small restaurant teams\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Hospitality brands\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Creative food businesses\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Especially suited to\"}],\"attrs\":{\"level\":1}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"All-day breakfast cafes\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Neighbourhood coffee shops\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Sourdough bakeries\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Modern brunch spots\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Croissant and pastry shops\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Cafe openings and rebrands\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Food concepts with a strong visual identity\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Boolka helps you present your food, atmosphere, and personality in one expressive website - giving visitors a taste of the experience before they even arrive.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Support\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"If you need help with the template or have any issues while using it, feel free to reach out.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Email: \"},{\"type\":\"text\",\"text\":\"promakdesign@gmail.com\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"mailto:promakdesign@gmail.com\",\"target\":\"_blank\"}}]}]}]},\"introduction\":\"Made fresh for cafe culture\",\"slug\":\"boolka\",\"author\":{\"framerUserId\":\"98ab5a06-8301-4883-baae-44ea08e5277e\",\"name\":\"Roman Koby\",\"slug\":\"rkoby\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/98ab5a06-8301-4883-baae-44ea08e5277e/60ipsovp\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"video\",\"url\":\"https://stream.mux.com/LGnnZDBDBFfTjpOozCZ7G9N7EjqQE02eNPndyBTlkg9M.m3u8\",\"metadata\":{\"posterUrl\":\"https://image.mux.com/LGnnZDBDBFfTjpOozCZ7G9N7EjqQE02eNPndyBTlkg9M/thumbnail.webp?time=2.336\",\"aspectRatio\":\"4:3\",\"duration\":12.6126}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/98ab5a06-8301-4883-baae-44ea08e5277e/01a02d07-f7f2-7297-81f5-935551aafa5f.jpg\",\"metadata\":{\"tint\":\"hsl(30 74% 33%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/98ab5a06-8301-4883-baae-44ea08e5277e/01a02d08-7ea3-765b-9f0b-ba3f67891ad2.jpg\",\"metadata\":{\"tint\":\"hsl(30 74% 33%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/98ab5a06-8301-4883-baae-44ea08e5277e/01a02d08-7ea1-742b-b322-4de8ae4d5a74.jpg\",\"metadata\":{\"tint\":\"hsl(30 74% 33%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019fcb13-5955-707e-a3d1-1bc6235ff26a\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Just finished Boolka \"},{\"type\":\"emoji\",\"attrs\":{\"name\":\"croissant\",\"emoji\":\"🥐\"}}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"I wanted to create a cafe template that feels warm, playful, and full of personality - not like another polished restaurant website.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"It’s made for bakeries, brunch spots, and neighbourhood coffee shops that care as much about their atmosphere as their food.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Hope you like it!\"}]}]},\"likes\":{\"count\":42,\"liked\":false},\"comments\":{\"count\":9},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-08-04T04:41:10.242Z\",\"updatedAt\":\"2026-08-24T12:13:38.767Z\",\"publishedAt\":\"2026-08-04T04:41:10.239Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"template\",\"attributes\":{\"price\":\"19\",\"paymentUrl\":\"https://buy.polar.sh/polar_cl_EXe8AmWgappa04Q7Mh2s7zNWCfRxCzP0Lj7V34SAjyQ\",\"remixUrl\":null,\"previewUrl\":\"https://boolka.framer.website/\",\"categories\":[{\"id\":115,\"name\":\"Food\",\"slug\":\"food\"},{\"id\":191,\"name\":\"Bakery \u0026 Cafe\",\"slug\":\"bakery-and-cafe\"},{\"id\":24,\"name\":\"Restaurant\",\"slug\":\"restaurant\"}],\"styles\":[],\"mainCategory\":{\"id\":115,\"name\":\"Food\",\"slug\":\"food\"},\"features\":[{\"id\":1,\"name\":\"Appear Effects\",\"slug\":\"appear-effects\"},{\"id\":17,\"name\":\"Sticky Scrolling\",\"slug\":\"sticky-scrolling\"},{\"id\":21,\"name\":\"CMS\",\"slug\":\"cms\"},{\"id\":32,\"name\":\"Layout Templates\",\"slug\":\"layout-templates\"},{\"id\":35,\"name\":\"Text Effects\",\"slug\":\"text-effects\"},{\"id\":40,\"name\":\"Variable Fonts\",\"slug\":\"variable-fonts\"}]}},{\"id\":\"59533\",\"resolved\":true,\"title\":\"Kora\",\"body\":\"$7b\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Live Preview\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer\",\"href\":\"https://kora.framer.media?utm_source=framer\",\"target\":\"_blank\"}}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Hero Background Supports Videos\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Swap between a video or static image with a single toggle. Want a cinematic loop behind your headline? Set Show Video to Yes, drop in a URL, and you're done. Prefer a clean image? Toggle it off and upload one. No code, no fussing with layers.\"}]},{\"type\":\"customImage\",\"attrs\":{\"alt\":\"\",\"src\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/templates/59533-kora-oVZQCpnkcslWx7m8iuNjyHWspwCDZd\",\"link\":null,\"caption\":\"\",\"uploadId\":null}},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Why Most Consulting Sites Don't Convert:\"}],\"attrs\":{\"level\":2}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Vague positioning that sounds like every other firm\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"No proof of outcomes, just promises\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Case studies buried or missing entirely\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Generic layouts that don't reflect the quality of the work\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Kora fixes this with a structure built around credibility and conversion.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Deeply Connected CMS\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" — Six collections that work together out of the box. Case studies link to services. Insights link to team members and categories. Services power the homepage, contact form, and case study pages simultaneously. Add a service once and it shows up everywhere. Rename a team member and every article they've written updates automatically.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Conversion-Focused Components:\"}],\"attrs\":{\"level\":2}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Before/After Comparison Section\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Process Accordion\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Bar Graph for visualizing results\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Testimonial Accordion with star ratings\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Tiered Pricing Cards with benefit lists\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Contact Form\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Perfect For:\"}],\"attrs\":{\"level\":2}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Growth consultancies\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Revenue operations firms\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Go-to-market advisors\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Management consulting agencies\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Strategy and advisory firms\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"B2B consulting studios\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Built to Ship Fast\"}],\"attrs\":{\"level\":2}},{\"type\":