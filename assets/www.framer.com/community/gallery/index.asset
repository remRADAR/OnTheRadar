":\"01a042a0-d666-716a-8e70-132f1d32f864\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"New website live! Let me know what you think.\"}]}]},\"likes\":{\"count\":4,\"liked\":false},\"comments\":{\"count\":2},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-08-27T09:50:31.523Z\",\"updatedAt\":\"2026-08-27T09:50:31.523Z\",\"publishedAt\":\"2026-08-27T09:50:31.517Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"site\",\"attributes\":{\"url\":\"https://forestamaritiem.nl/\",\"categories\":[{\"id\":\"ddd39099-5b17-42e0-b333-7b7c480a114f\",\"name\":\"Business\",\"slug\":\"business\"}]}},{\"id\":\"16653\",\"resolved\":true,\"title\":\"KLYRO Security\",\"body\":\"\u003cp\u003eKLYRO needed a modern digital presence that could communicate complex security and integration services in a clear, engaging, and visually compelling way. Designed and developed in Framer, the website combines custom interactions, Unicorn Studio integrations, and signature 3D prism elements to create an experience that feels modern, interactive, and aligned with the brand’s identity.\u003c/p\u003e\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"KLYRO needed a modern digital presence that could communicate complex security and integration services in a clear, engaging, and visually compelling way. Designed and developed in Framer, the website combines custom interactions, Unicorn Studio integrations, and signature 3D prism elements to create an experience that feels modern, interactive, and aligned with the brand’s identity.\"}]}]},\"introduction\":\"\",\"slug\":\"klyro-security\",\"author\":{\"framerUserId\":\"7080020c-35d8-49ed-b761-29c615ecfca6\",\"name\":\"Kristaps Reinfelds\",\"slug\":\"kristaps-design\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/958943/avatar-4rla9NlDgKFMqYi