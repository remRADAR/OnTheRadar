oc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Kina is a rewards membership built for moms.\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Brand identity, landing page, and About Us — all custom-built in Framer. Visual system that speaks directly to modern motherhood.\"}]}]},\"introduction\":\"\",\"slug\":\"kina\",\"author\":{\"framerUserId\":\"fd602ffe-74b5-4520-9cff-2960ef697e4b\",\"name\":\"Liana Tudakova\",\"slug\":\"liana-tudakova\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/37787/avatar-E9E5pslHEgsMiSawsWFuNqJmX21RLT.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/fd602ffe-74b5-4520-9cff-2960ef697e4b/01a0433b-0314-7628-a86d-509cd9029810.png\",\"metadata\":{\"tint\":\"hsl(210 40% 16%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/fd602ffe-74b5-4520-9cff-2960ef697e4b/01a0433b-0295-72c9-91c6-349ffd79c862.png\",\"metadata\":{\"tint\":\"hsl(0 0% 16%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/fd602ffe-74b5-4520-9cff-2960ef697e4b/01a0433b-02b1-7334-8329-d199884f55e3.png\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/fd602ffe-74b5-4520-9cff-2960ef697e4b/01a0433b-02a2-770e-b498-7e7dbe26143c.png\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"01a0433c-19b6-710f-959a-017d3f34b266\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Just shipped Kina - a rewards platform built for moms.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Designed to make motherhood visible in fintech.\"}]}]},\"likes\":{\"count\":8,\"liked\":false},\"comments\":{\"count\":4},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-08-27T12:40:06.716Z\",\"updatedAt\":\"2026-08-27T12:40:06.716Z\",\"publishedAt\":\"2026-08-27T12:40:06.710Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"site\",\"attributes\":{\"url\":\"https://www.kina.co/\",\"categories\":[{\"id\":\"ddd39099-5b17-42e0-b333-7b7c480a114f\",\"name\":\"Business\",\"slug\":\"business\"},{\"id\":\"b65821c4-e205-4861-a28b-1623536037f7\",\"name\":\"Landing Page\",\"slug\":\"landing-page\"},{\"id\":\"1fec15c2-ca4a-4d52-bf3a-c04e6d002202\",\"name\":\"SaaS\",\"slug\":\"saas\"}]}},{\"id\":\"17003\",\"resolved\":true,\"title\":\"UGC Hourly\",\"body\":\"$57\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"UGC Hourly — UGC Creator Platform Website\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"HourlyUGC is a modern creator marketplace and UGC platform built to help brands produce high-volume video content through a network of vetted creators. The platform gives performance marketers a faster and more scalable alternative to traditional per-video UGC pricing, allowing brands to hire creators by the hour and generate multiple content variations for their campaigns.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"I developed the website in Framer with a strong focus on communicating the platform's unique pricing model, creator network, production workflow, and performance-driven value proposition through a bold, conversion-focused SaaS experience.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Services Provided\"}],\"attrs\":{\"level\":1}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",