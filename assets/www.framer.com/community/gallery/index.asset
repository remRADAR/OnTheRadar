s/31123/McHTH71f_400x400-VKlVpQryMU6V11WxN53SB2yWgeC2GY.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/e77c8d2c-881f-46e7-b945-68aebec62cb0/ifw4nux8\",\"metadata\":{\"tint\":\"hsl(0 0% 22%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019ea6e0-328c-702a-b79a-e49db3865369\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Stuck in a permanent loop of rebuilding my site just to make it \\\"look cleaner.\\\"\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Enjoy it before I change my mind again!\"}]}]},\"likes\":{\"count\":62,\"liked\":false},\"comments\":{\"count\":5},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-06-08T10:56:11.368Z\",\"updatedAt\":\"2026-06-08T10:56:11.368Z\",\"publishedAt\":\"2026-06-08T10:56:11.351Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"site\",\"attributes\":{\"url\":\"https://templifica.com/\",\"categories\":[{\"id\":\"ddd39099-5b17-42e0-b333-7b7c480a114f\",\"name\":\"Business\",\"slug\":\"business\"},{\"id\":\"cb1ce5d0-8749-428e-b0d8-917786928ffd\",\"name\":\"Personal\",\"slug\":\"personal\"},{\"id\":\"3b2881c5-bbfb-430d-83f6-b1b0ac597b8d\",\"name\":\"Ecommerce\",\"slug\":\"ecommerce\"}]}},{\"id\":\"16953\",\"resolved\":true,\"title\":\"Creator Zone\",\"body\":\"\u003cp\u003eA modern creative studio website built for Creatorzone, focused on showcasing their services, creative work, and performance-driven approach through a clean, bold, and conversion-focused experience.\u003c/p\u003e\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"A modern creative studio website built for Creatorzone, focused on showcasing their services, creative work, and performance-driven approach through a clean, bold, and conversion-focused experience.\"}]}]},\"introduction\":\"\",\"slug\":\"creator-zone\",\"author\":{\"framerUserId\":\"21f702d2-cbff-4c75-b839-4ebf0dcec4e9\",\"name\":\"Harshit Pandey\",\"slug\":\"harsheessh\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/41096/avatar-7ZeNEyhxF5smsrZTm1iHVr5tzZp0QF.jpg\",\"badges\":[\"pro\"],\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/21f702d2-cbff-4c75-b839-4ebf0dcec4e9/01a00d25-ee87-719d-801b-858795053303.png\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"01a00d26-c182-72ef-b926-5c369073b428\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"New Shipp\"}]}]},\"likes\":{\"count\":11,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-08-17T00:37:18.374Z\",\"updatedAt\":\"2026-08-17T00:37:18.374Z\",\"publishedAt\":\"2026-08-17T00:37:18.368Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"site\",\"attributes\":{\"url\":\"https://www.creatorzone.in/\",\"categories\":[{\"id\":\"4e292c6b-a094-4031-be7b-7affa4349187\",\"name\":\"Agency\",\"slug\":\"agency\"},{\"id\":\"1fec15c2-ca4a-4d52-bf3a-c04e6d002202\",\"name\":\"SaaS\",\"slug\":\"saas\"},{\"id\":\"ddd39099-5b17-42e0-b333-7b7c480a114f\",\"name\":\"Business\",\"slug\":\"business\"}]}},{\"id\":\"16622\",\"resolved\":true,\"title\":\"TAM radar\",\"body\":\"$5d\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"TAMradar — B2B SaaS Intelligence Platform\",\"marks\":[{\"type\":\"bold\"}]}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"A modern B2B SaaS platform built for GTM, Sales, and RevOps teams to transform real-time business intelligence into actionable opportunities. TAMradar consolidates company, people, and industry signals into a unified platform, allowing businesses to monitor hiring activity, funding rounds, product launches, news, and 20+ other market signals through powerful APIs and webhooks. My role focused on designing and developing a polished, high-converting Framer experience that clearly communicates a technically complex product while maintaining exceptional usability and performance.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Services Provided\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Framer Development\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Landing Page Development\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Additional Product Pages (2)\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Responsive Design\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Custom Scroll \u0026 Micro Animations\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Booking System Integration\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Performance Optimization\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Project Highlights\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Crafted a modern SaaS landing page focused on conversion and product clarity.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Developed two additional pages with a consistent, scalable design system.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Implemented smooth custom animations to enhance the browsing experience without sacrificing performance.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Integrated a seamless booking system for demos and sales calls.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Built a fully responsive experience optimized across desktop, tablet, and mobile.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Maintained clean layouts and intuitive user flows for a technical B2B audience.\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Let's Build Your Next Website\",\"marks\":[{\"type\":\"bold\"}]}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Looking for a modern, high-converting website tailored to your business?\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Message me on WhatsApp:\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"https://wa.me/923260558191?text=Hi%20Mazher!%20I%20just%20checked%20your%20TAMradar%20project.%20I'm%20looking%20to%20build%20a%20modern%20website%20for%20my%20business.%20Can%20we%20discuss%20my%20project\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"https://wa.me/923260558191?text=Hi%20Mazher!%20I%20just%20checked%20your%20TAMradar%20project.%20I'm%20looking%20to%20build%20a%20modern%20website%20for%20my%20business.%20Can%20we%20discuss%20my%20project\",\"target\":\"_blank\"}},{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\"?\",\"marks\":[{\"type\":\"bold\"}]}]}]},\"introduction\":\"\",\"slug\":\"tam-radar\",\"author\":{\"framerUserId\":\"34db2e5c-7885-42f1-87b5-7ba3d558d2a9\",\"name\":\"Mazher\",\"slug\":\"mazher\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/34db2e5c-7885-42f1-87b5-7ba3d558d2a9/oku4gs23\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"video\",\"url\":\"https://stream.mux.com/A3oCS01FmXONWKVO9FKRmXif502yHut6BMKrl6gVHVEo4.m3u8\",\"metadata\":{\"posterUrl\":\"https://image.mux.com/A3oCS01FmXONWKVO9FKRmXif502yHut6BMKrl6gVHVEo4/thumbnail.webp?time=13.7\",\"aspectRatio\":\"4:3\",\"duration\":22.309333}}],\"post\":{\"id\":\"019f43fb-baf8-7178-a7d8-825fc3dba04c\",\"bodyJson\":null,\"likes\":{\"count\":6,\"liked\":false},\"comments\":{\"count\":2},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-07-08T23:06:38.465Z\",\"updatedAt\":\"2026-07-25T10:51:53.792Z\",\"publishedAt\":\"2026-07-08T23:06:38.462Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"site\",\"attributes\":{\"url\":\"https://www.tamradar.com/\",\"categories\":[{\"id\":\"4e292c6b-a094-4031-be7b-7affa4349187\",\"name\":\"Agency\",\"slug\":\"agency\"},{\"id\":\"1fec15c2-ca4a-4d52-bf3a-c04e6d002202\",\"name\":\"SaaS\",\"slug\":\"saas\"}]}},{\"id\":\"13674\",\"resolved\":true,\"title\":\"Adam Lambert '98\",\"body\":null,\"bodyJson\":null,\"introduction\":\"A personal professional portfolio that is inspired by the Windows 98 design aesthetic built as closely as possible to simulate a desktop viewing experience.\",\"slug\":\"adam-lambert-98\",\"author\":{\"framerUserId\":\"ce13bd72-5956-4304-9daa-df70557fd4d6\",\"name\":\"Salvijus Striungys\",\"slug\":\"salvi\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/72723/avatar-I01PiAQJYhKeMLXDW8O3G3rzPEUlWl.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/sites/13674/thumbnail-HyoDpCfgHzCdrJkMPEuK0wHy7e1dJe.jpg\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019cc55f-298a-7f54-aef5-52a6306c21de\",\"bodyJson\":null,\"likes\":{\"count\":56,\"liked\":false},\"comments\":{\"count\":2},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-03-06T22:57:54.057Z\",\"updatedAt\":\"2026-03-06T22:57:54.057Z\",\"publishedAt\":\"2026-03-06T22:57:54.058Z\",\"featuredAt\":\"2026-06-16T10:27:44.220Z\",\"reported\":false,\"approvedAt\":null,\"type\":\"site\",\"attributes\":{\"url\":\"https://www.adamclambert.com/\",\"categories\":[{\"id\":\"cb1ce5d0-8749-428e-b0d8-917786928ffd\",\"name\":\"Personal\",\"slug\":\"personal\"},{\"id\":\"6a730e3d-bdf2-42a2-ab42-eee5ef39b694\",\"name\":\"Portfolio\",\"slug\":\"portfolio\"}]}},{\"id\":\"16346\",\"resolved\":true,\"title\":\"Mosaic\",\"body\":\"\u003cp\u003eMosaic by Huehaus is a daily curated gallery showcasing the pinnacle of web design\u003c/p\u003e\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Mosaic by Huehaus is a daily curated gallery showcasing the pinnacle of web design\"}]}]},\"introduction\":\"\",\"slug\":\"mosaic\",\"author\":{\"framerUserId\":\"75daa66e-f6ac-40cc-a657-fc512991d883\",\"name\":\"Huehaus Studio\",\"slug\":\"huehaus-studio\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/34299/avatar-bp3mzKKtnuZkwx4x5jOPkcGyYw2xUX.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"video\",\"url\":\"https://stream.mux.com/tIl9400z02O6026KVY6j6q00p01k4h5p5m01J8QnYlXmdFY2Y.m3u8\",\"metadata\":{\"posterUrl\":\"https://image.mux.com/tIl9400z02O6026KVY6j6q00p01k4h5p5m01J8QnYlXmdFY2Y/thumbnail.webp?time=6.7\",\"aspectRatio\":\"16:9\",\"duration\":10.033333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/75daa66e-f6ac-40cc-a657-fc512991d883/0lp4ret0\",\"metadata\":{\"tint\":\"hsl(0 0% 9%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/75daa66e-f6ac-40cc-a657-fc512991d883/u7suupi6\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019ed830-4318-74bb-8b2e-5037eb2f4030\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Excited to finally share this one.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Mosaic by Huehaus is a daily curated gallery of the best web design on the internet. We built it because we kept finding incredible sites with nowhere to share them. Now there is. \"}]}]},\"likes\":{\"count\":92,\"liked\":false},\"comments\":{\"count\":14},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-06-18T00:45:02.070Z\",\"updatedAt\":\"2026-06-18T00:45:02.070Z\",\"publishedAt\":\"2026-06-18T00:45:02.067Z\",\"featuredAt\":\"2026-07-01T07:12:58.997Z\",\"reported\":false,\"approvedAt\":null,\"type\":\"site\",\"attributes\":{\"url\":\"https://mosaic.select/\",\"categories\":[{\"id\":\"d26c907e-7d56-4582-9727-b7c10921b71e\",\"name\":\"Community\",\"slug\":\"community\"},{\"id\":\"03ece1c0-33fd-4e34-aa33-4dea1ef0c4b3\",\"name\":\"Blog\",\"slug\":\"blog\"},{\"id\":\"b65821c4-e205-4861-a28b-1623536037f7\",\"name\":\"Landing Page\",\"slug\":\"landing-page\"}]}},{\"id\":\"16518\",\"resolved\":true,\"title\":\"Antony Raphy\",\"body\":\"\u003ch2\u003eAntony Raphy — Product Design Engineer\u003c/h2\u003e\u003cp\u003eA case-file styled portfolio built around decision-led case studies, not just polished screens.\u003c/p\u003e\u003ch3\u003eWhat\u0026#39;s inside\u003c/h3\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eClarion — AI-assisted diagnostic workspace for middle-school teachers\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eZepto AI Intent Search — 1st place, Zepto Design Challenge (UX Trilogy)\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSENTINEL — clinical shift handover intelligence research\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch3\u003eHow it\u0026#39;s different\u003c/h3\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eEvery decision shown as: default direction → what I did instead → why → tradeoff\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eA dedicated AI Collaboration chapter in each case study, what AI suggested, what I chose, and why\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eOne committed visual language across the whole site, dossier-detective aesthetic, RDR2-inspired chapter cards, aged paper textures\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch3\u003eAbout me\u003c/h3\u003e\u003cp\u003eDesign + build, without the gap where quality gets lost. Self-directed path into design, now working toward product design engineering roles at growth-stage startups.\u003c/p\u003e\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Antony Raphy — Product Design Engineer\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"A case-file styled portfolio built around decision-led case studies, not just polished screens.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"What's inside\"}],\"attrs\":{\"level\":2}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Clarion — AI-assisted diagnostic workspace for middle-school teachers\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Zepto AI Intent Search — 1st place, Zepto Design Challenge (UX Trilogy)\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"SENTINEL — clinical shift handover intelligence research\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"How it's different\"}],\"attrs\":{\"level\":2}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Every decision shown as: default direction → what I did instead → why → tradeoff\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"A dedicated AI Collaboration chapter in each case study, what AI suggested, what I chose, and why\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"One committed visual language across the whole site, dossier-detective aesthetic, RDR2-inspired chapter cards, aged paper textures\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"About me\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Design + build, without the gap where quality gets lost. Self-directed path into design, now working toward product design engineering roles at growth-stage startups.\"}]}]},\"introduction\":\"\",\"slug\":\"antony-raphy\",\"author\":{\"framerUserId\":\"7fd40dc2-5d88-48bc-bbee-09cf536c40ce\",\"name\":\"Antony Raphy\",\"slug\":\"antony-raphy\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/41118/avatar-Xpqnhejv0Zafil0kw465Rq0T1wBNEb.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"video\",\"url\":\"https://stream.mux.com/krkJHxEgx01wij5ql3hJyNUiQc3RY01u7JoVpzolPw0278.m3u8\",\"metadata\":{\"posterUrl\":\"https://image.mux.com/krkJHxEgx01wij5ql3hJyNUiQc3RY01u7JoVpzolPw0278/thumbnail.webp?time=6.933\",\"aspectRatio\":\"16:9\",\"duration\":8.766667}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/7fd40dc2-5d88-48bc-bbee-09cf536c40ce/iqbqfd5z\",\"metadata\":{\"tint\":\"hsl(60 82% 33%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019f0823-16be-7459-abd7-d07442a7b87c\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Just shipped my portfolio — \"},{\"type\":\"text\",\"text\":\"antonyraphy.com\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"http://antonyraphy.com\",\"target\":\"_blank\"}}]},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"emoji\",\"attrs\":{\"name\":\"card_index_dividers\",\"emoji\":\"🗂\"}}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Built it like a case file, not a slideshow. Every project breaks down as: what the obvious move was, what I did instead, and why.\"}]}]},\"likes\":{\"count\":24,\"liked\":false},\"comments\":{\"count\":8},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-06-27T08:12:25.122Z\",\"updatedAt\":\"2026-08-03T04:54:02.809Z\",\"publishedAt\":\"2026-06-27T08:12:25.117Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"site\",\"attributes\":{\"url\":\"https://antonyraphy.com/\",\"categories\":[{\"id\":\"6a730e3d-bdf2-42a2-ab42-eee5ef39b694\",\"name\":\"Portfolio\",\"slug\":\"portfolio\"},{\"id\":\"cb1ce5d0-8749-428e-b0d8-917786928ffd\",\"name\":\"Personal\",\"slug\":\"personal\"}]}},{\"id\":\"13745\",\"resolved\":true,\"title\":\"Energy OS\",\"body\":null,\"bodyJson\":null,\"introduction\":\"Energy OS is the first data-driven system designed to 10x the founder, not just the business. We combine biomarker diagnostics with deep psychological coaching–built for leaders who want to thrive\",\"slug\":\"energy-os\",\"author\":{\"framerUserId\":\"1f6a9ce7-28c1-4341-bbd2-299785c1647a\",\"name\":\"Goran Babarogic\",\"slug\":\"babarogic\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/28782/profile-pic-IIc5o4R5Hdz85Zx3sVBCCqsrThTr7D.jpg\",\"badges\":[\"pro\"],\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/sites/13745/thumbnail-33CbNTfYE54cyhXV293PuN5GzOpsGA.jpg\",\"metadata\":{\"tint\":\"hsl(220 50% 19%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019cd74e-90da-72f9-82d5-65b62a57456d\",\"bodyJson\":null,\"likes\":{\"count\":4,\"liked\":false},\"comments\":{\"count\":1},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-03-10T10:32:56.280Z\",\"updatedAt\":\"2026-03-10T10:32:56.280Z\",\"publishedAt\":\"2026-03-10T10:32:56.282Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"site\",\"attributes\":{\"url\":\"https://yourenergyos.com/\",\"categories\":[{\"id\":\"ddd39099-5b17-42e0-b333-7b7c480a114f\",\"name\":\"Business\",\"slug\":\"business\"},{\"id\":\"b65821c4-e205-4861-a28b-1623536037f7\",\"name\":\"Landing Page\",\"slug\":\"landing-page\"}]}},{\"id\":\"17093\",\"resolved\":true,\"title\":\"Bombastic\",\"body\":\"\u003cp\u003eA product designer and art director\u003c/p\u003e\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"A product designer and art director\"}]}]},\"introduction\":\"\",\"slug\":\"bombastic\",\"author\":{\"framerUserId\":\"af132100-c38c-4280-9467-c468fb16f589\",\"name\":\"Ayush Halder\",\"slug\":\"ayush-halder\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/af132100-c38c-4280-9467-c468fb16f589/drp6zudu\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"video\",\"url\":\"https://stream.mux.com/zeitLuV01ShfI1D00yLfGNJkhERqYnnzDMmXAaj8S6vXg.m3u8\",\"metadata\":{\"posterUrl\":\"https://image.mux.com/zeitLuV01ShfI1D00yLfGNJkhERqYnnzDMmXAaj8S6vXg/thumbnail.webp?time=3.233\",\"aspectRatio\":\"907:682\",\"duration\":19.916667}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/af132100-c38c-4280-9467-c468fb16f589/01a03eb2-b24f-749e-a454-86f2df5160d2.jpg\",\"metadata\":{\"tint\":\"hsl(20 38% 13%)\",\"aspectRatio\":1.3299120234604105}}],\"post\":{\"id\":\"01a03eb4-b59b-7201-a67b-67083885784b\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"A collection of product design, branding, and experiments I've worked on.\"}]}]},\"likes\":{\"count\":6,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-08-26T15:33:44.680Z\",\"updatedAt\":\"2026-08-26T15:33:44.680Z\",\"publishedAt\":\"2026-08-26T15:33:44.675Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"site\",\"attributes\":{\"url\":\"https://www.thoughtsofayush.com/\",\"categories\":[{\"id\":\"6a730e3d-bdf2-42a2-ab42-eee5ef39b694\",\"name\":\"Portfolio\",\"slug\":\"portfolio\"}]}},{\"id\":\"16617\",\"resolved\":true,\"title\":\"Elastic\",\"body\":\"$5e\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Elastic Hotel — AI Revenue Management for Hotels\",\"marks\":[{\"type\":\"bold\"}]}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Elastic Hotel is a modern AI-powered platform that helps hotels maximize revenue through intelligent dynamic pricing and advanced revenue management. Designed for hospitality businesses, the website communicates complex technology with a clean, professional interface while emphasizing trust, innovation, and measurable business growth. I developed a fully custom landing page in Framer that combines premium visuals, smooth interactions, and conversion-focused design to effectively showcase the platform's capabilities.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Services Provided\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Framer Development\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Fully Custom Landing Page\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Responsive Development\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Custom Animations\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Interactive UI Development\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Performance Optimization\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Let's Build Your Next SaaS Website\",\"marks\":[{\"type\":\"bold\"}]}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"WhatsApp:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"https://wa.me/923260558191?text=Hi%20Mazher!%20I%20just%20viewed%20your%20Elastic%20Hotel%20project.%20I'm%20interested%20in%20building%20a%20similar%20high-quality%20website%20for%20my%20business.%20Can%20we%20discuss%20my%20project%3F\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"https://wa.me/923260558191?text=Hi%20Mazher!%20I%20just%20viewed%20your%20Elastic%20Hotel%20project.%20I'm%20interested%20in%20building%20a%20similar%20high-quality%20website%20for%20my%20business.%20Can%20we%20discuss%20my%20project%3F\",\"target\":\"_blank\"}}]}]}]},\"introduction\":\"\",\"slug\":\"elastic\",\"author\":{\"framerUserId\":\"34db2e5c-7885-42f1-87b5-7ba3d558d2a9\",\"name\":\"Mazher\",\"slug\":\"mazher\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/34db2e5c-7885-42f1-87b5-7ba3d558d2a9/oku4gs23\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"video\",\"url\":\"https://stream.mux.com/2Hzn1EpDLpit4UjmlyZbr4qYcqUelYi9BBhcD9vOzNo.m3u8\",\"metadata\":{\"posterUrl\":\"https://image.mux.com/2Hzn1EpDLpit4UjmlyZbr4qYcqUelYi9BBhcD9vOzNo/thumbnail.webp?time=5.417\",\"aspectRatio\":\"4:3\",\"duration\":23.209333}}],\"post\":{\"id\":\"019f43e0-1f95-76ce-b26f-bfc57d3d8431\",\"bodyJson\":null,\"likes\":{\"count\":10,\"liked\":false},\"comments\":{\"count\":1},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-07-08T22:36:29.202Z\",\"updatedAt\":\"2026-08-19T09:08:44.975Z\",\"publishedAt\":\"2026-07-08T22:36:29.199Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"site\",\"attributes\":{\"url\":\"https://elastichotel.com/\",\"categories\":[{\"id\":\"1fec15c2-ca4a-4d52-bf3a-c04e6d002202\",\"name\":\"SaaS\",\"slug\":\"saas\"},{\"id\":\"4e292c6b-a094-4031-be7b-7affa4349187\",\"name\":\"Agency\",\"slug\":\"agency\"},{\"id\":\"b65821c4-e205-4861-a28b-1623536037f7\",\"name\":\"Landing Page\",\"slug\":\"landing-page\"}]}},{\"id\":\"16877\",\"resolved\":true,\"title\":\"Trowel Craft\",\"body\":\"\u003cp\u003eTrowel Craft is a modern website created for a Melbourne-based plastering and interior finishing company. The site highlights their services, craftsmanship, and completed work through a clean editorial layout, strong visual presentation, and smooth interactions. Built in Framer, the website is fully responsive, easy to explore, and designed to help potential clients understand the company’s expertise and request a quote with confidence.\u003c/p\u003e\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Trowel Craft is a modern website created for a Melbourne-based plastering and interior finishing company. The site highlights their services, craftsmanship, and completed work through a clean editorial layout, strong visual presentation, and smooth interactions. Built in Framer, the website is fully responsive, easy to explore, and designed to help potential clients understand the company’s expertise and request a quote with confidence.\"}]}]},\"introduction\":\"\",\"slug\":\"trowel-craft\",\"author\":{\"framerUserId\":\"e384faea-043f-4f5c-bd25-070ec91488d7\",\"name\":\"Framer Geeks\",\"slug\":\"framergeeks\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/65683/avatar-DpmNXlAfqaNbZuhHKKWXXcPtwRkgYh.jpg\",\"badges\":[\"pro\"],\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/e384faea-043f-4f5c-bd25-070ec91488d7/019fd1d8-9eba-73bc-bc76-7f39b3f56fed.png\",\"metadata\":{\"tint\":\"hsl(0 0% 9%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019fd1d8-d869-776b-9f2d-966ec743d8c7\",\"bodyJson\":null,\"likes\":{\"count\":9,\"liked\":false},\"comments\":{\"count\":1},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-08-05T12:14:36.625Z\",\"updatedAt\":\"2026-08-05T12:14:36.625Z\",\"publishedAt\":\"2026-08-05T12:14:36.618Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"site\",\"attributes\":{\"url\":\"https://www.trowelcraft.com.au/\",\"categories\":[{\"id\":\"ddd39099-5b17-42e0-b333-7b7c480a114f\",\"name\":\"Business\",\"slug\":\"business\"},{\"id\":\"6a730e3d-bdf2-42a2-ab42-eee5ef39b694\",\"name\":\"Portfolio\",\"slug\":\"portfolio\"},{\"id\":\"b65821c4-e205-4861-a28b-1623536037f7\",\"name\":\"Landing Page\",\"slug\":\"landing-page\"}]}},{\"id\":\"16778\",\"resolved\":true,\"title\":\"Studio Paolo\",\"body\":\"\u003cp\u003eThe new, facelifted version of our studio. \u003c/p\u003e\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"The new, facelifted version of our studio. \"}]}]},\"introduction\":\"\",\"slug\":\"studio-paolo\",\"author\":{\"framerUserId\":\"f82c657f-9c59-476c-81cc-7565d33afb66\",\"name\":\"Balazs Boka\",\"slug\":\"boka-balazs\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/81167/avatar-XnykghXY7MuRUBWQhnbSS3LedSvA0g.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/f82c657f-9c59-476c-81cc-7565d33afb66/019f99e4-efa1-75d1-8783-5be3cf610433.png\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.638504864311316}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/f82c657f-9c59-476c-81cc-7565d33afb66/019f99e4-ebd2-778a-9954-ecbd7b5eada8.png\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.5038022813688212}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/f82c657f-9c59-476c-81cc-7565d33afb66/019f99e4-ec24-738d-938f-d5445527df62.png\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.4695817490494296}}],\"post\":{\"id\":\"019f99e5-3168-7472-9b26-8f163267b563\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"So we redesigned our whole studio website. Our previous one was funky and bold, but we realized that this is not what we are about, so we built a more conservative, more minimalist one, in bright mode. \"},{\"type\":\"text\",\"text\":\"https://studiopaolo.hu\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"https://studiopaolo.hu\",\"target\":\"_blank\"}}]},{\"type\":\"text\",\"text\":\"  \"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Actually, I really like it.\"}]}]},\"likes\":{\"count\":5,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-07-25T15:29:21.883Z\",\"updatedAt\":\"2026-07-25T15:29:21.883Z\",\"publishedAt\":\"2026-07-25T15:29:21.876Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"site\",\"attributes\":{\"url\":\"https://www.studiopaolo.hu/\",\"categories\":[{\"id\":\"6a730e3d-bdf2-42a2-ab42-eee5ef39b694\",\"name\":\"Portfolio\",\"slug\":\"portfolio\"},{\"id\":\"4e292c6b-a094-4031-be7b-7affa4349187\",\"name\":\"Agency\",\"slug\":\"agency\"},{\"id\":\"ddd39099-5b17-42e0-b333-7b7c480a114f\",\"name\":\"Business\",\"slug\":\"business\"}]}},{\"id\":\"16746\",\"resolved\":true,\"title\":\"Guifré Serrano\",\"body\":\"\u003cp\u003eGuifré Serrano is an independent graphic designer and developer working internationally (from BCN) with a focus on art, culture, fashion and sport.\u003c/p\u003e\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Guifré Serrano is an independent graphic designer and developer working internationally (from BCN) with a focus on art, culture, fashion and sport.\"}]}]},\"introduction\":\"\",\"slug\":\"guifr-serrano\",\"author\":{\"framerUserId\":\"db7d2178-61de-4cd7-825f-f38940073e64\",\"name\":\"Guifré Serrano\",\"slug\":\"guifre-serrano\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/100435/avatar-gRVkfcsrgZ833RLTCTJFL1TT0wVbxc.jpg\",\"badges\":[\"pro\"],\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/db7d2178-61de-4cd7-825f-f38940073e64/019f8ec9-2002-77a5-ac9b-a19564149935.png\",\"metadata\":{\"tint\":\"hsl(20 30% 16%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019f8ec9-717f-7139-9541-6636c3310890\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Guifré Serrano is an independent graphic designer and developer working internationally (from BCN) with a focus on art, culture, fashion and sport.\"}]}]},\"likes\":{\"count\":3,\"liked\":false},\"comments\":{\"count\":1},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-07-23T11:43:13.783Z\",\"updatedAt\":\"2026-07-23T11:43:13.783Z\",\"publishedAt\":\"2026-07-23T11:43:13.772Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"site\",\"attributes\":{\"url\":\"https://www.guifreserrano.com/\",\"categories\":[{\"id\":\"6a730e3d-bdf2-42a2-ab42-eee5ef39b694\",\"name\":\"Portfolio\",\"slug\":\"portfolio\"},{\"id\":\"cb1ce5d0-8749-428e-b0d8-917786928ffd\",\"name\":\"Personal\",\"slug\":\"personal\"},{\"id\":\"b65821c4-e205-4861-a28b-1623536037f7\",\"name\":\"Landing Page\",\"slug\":\"landing-page\"}]}},{\"id\":\"16992\",\"resolved\":true,\"title\":\"Code conneqt\",\"body\":\"\u003cp\u003eCode Conneqt is live, built in Framer.\u003c/p\u003e\u003cp\u003eCode Conneqt connects organisations and IT professionals in tech. No cv\u0026#39;s fired into a black hole, but a real conversation first, and a no cure no pay model behind it.\u003c/p\u003e\u003cp\u003eThe brief was clarity over flash. The audience is IT\u0026#39;ers weighing career moves and organisations weighing hires, both allergic to recruiter noise. So the design leans corporate and calm: white, blue, black, a thin network line motif that echoes the name without shouting it.\u003c/p\u003e\u003cp\u003eBuild notes:\u003c/p\u003e\u003cp\u003eBold condensed headline type paired with a clean body font, locked into text styles\u003c/p\u003e\u003cp\u003eA subtle animated node network in the hero, slow and understated, not decorative clutter\u003c/p\u003e\u003cp\u003eSeparate landing paths for organisations and for IT professionals, same page, different framing\u003c/p\u003e\u003cp\u003eCMS driven market insights section for recurring content\u003c/p\u003e\u003cp\u003eOne primary CTA throughout: plan een intakegesprek\u003c/p\u003e\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Code Conneqt is live, built in Framer.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Code Conneqt connects organisations and IT professionals in tech. No cv's fired into a black hole, but a real conversation first, and a no cure no pay model behind it.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"The brief was clarity over flash. The audience is IT'ers weighing career moves and organisations weighing hires, both allergic to recruiter noise. So the design leans corporate and calm: white, blue, black, a thin network line motif that echoes the name without shouting it.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Build notes:\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Bold condensed headline type paired with a clean body font, locked into text styles\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"A subtle animated node network in the hero, slow and understated, not decorative clutter\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Separate landing paths for organisations and for IT professionals, same page, different framing\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"CMS driven market insights section for recurring content\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"One primary CTA throughout: plan een intakegesprek\"}]}]},\"introduction\":\"\",\"slug\":\"code-conneqt\",\"author\":{\"framerUserId\":\"c602a7d6-63ac-4eaa-ab74-18fc0d2a8394\",\"name\":\"BRANDWIT\",\"slug\":\"brandwit\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/1464719/avatar-40fsDmZydYe9UjJqtQwA3mWOMgT869.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"video\",\"url\":\"https://stream.mux.com/ps6sZTLsesyE2bM26KQFoYqIGSBsCK5ed1bNbAPmCpI.m3u8\",\"metadata\":{\"posterUrl\":\"https://image.mux.com/ps6sZTLsesyE2bM26KQFoYqIGSBsCK5ed1bNbAPmCpI/thumbnail.webp?time=1.792\",\"aspectRatio\":\"321:179\",\"duration\":5.208333}}],\"post\":{\"id\":\"01a01ee5-798a-706d-9576-42c6d3599070\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Code Conneqt connects organisations and IT professionals in tech. No cv's fired into a black hole, but a real conversation first, and a no cure no pay model behind it.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"The brief was clarity over flash. The audience is IT'ers weighing career moves and organisations weighing hires, both allergic to recruiter noise. So the design leans corporate and calm: white, blue, black, a thin network line motif that echoes the name without shouting it.\"}]}]},\"likes\":{\"count\":7,\"liked\":false},\"comments\":{\"count\":1},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-08-20T11:19:09.904Z\",\"updatedAt\":\"2026-08-20T11:19:09.904Z\",\"publishedAt\":\"2026-08-20T11:19:09.897Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"site\",\"attributes\":{\"url\":\"https://www.codeconneqt.nl/\",\"categories\":[{\"id\":\"ddd39099-5b17-42e0-b333-7b7c480a114f\",\"name\":\"Business\",\"slug\":\"business\"},{\"id\":\"03ece1c0-33fd-4e34-aa33-4dea1ef0c4b3\",\"name\":\"Blog\",\"slug\":\"blog\"}]}}],\"pagination\":{\"next\":\"cG9wfDY3OTk4LjI3NDMzNzMyMTh8Y29tbXVuaXR5X2ludGVyYWN0aW9uczptYXJrZXRwbGFjZS1yZXNvdXJjZS1ibGVuZC00OjE3ODc5MzY0MDQwMDA6MTc4NzkzNjQwNDAwMHwxNzg3MjI0NzQ5ODk3fHN8MTY5OTI\",\"previous\":null}},\"fixedQuery\":\"$undefined\",\"searchEnabled\":false,\"type\":\"site\"}],\"children\":\"$L5f\"}]]}]\n2b:C\n29:C\n2a:C\n20:C\n19:C\n1b:C\n21:C\n22:C\n60:I[861124,[\"/creators-assets/_next/static/immutable/chunks/16d0e6blr3zvd.js\",\"/creators-assets/_next/static/immutable/chunks/3jpuro209qqra.js\",\"/creators-assets/_next/static/immutable/chunks/2ul6havqzfm41.js\",\"/creators-assets/_next/static/immutable/chunks/0c6romi9ma0is.js\",\"/creators-assets/_next/static/immutable/chunks/1jubx4t_1hq7l.js\",\"/creators-assets/_next/static/immutable/chunks/30hhj9fl_j_en.js\",\"/creators-assets/_next/static/immutab