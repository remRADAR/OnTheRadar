webp?time=10.3\",\"aspectRatio\":\"16:9\",\"duration\":26.8}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/sites/10392/thumbnail-9rforIzjCMekQWhS73tijC3c8LWDUw.jpg\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019af991-481c-73a9-b782-e69179cc1068\",\"bodyJson\":null,\"likes\":{\"count\":85,\"liked\":false},\"comments\":{\"count\":4},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2025-12-07T16:07:19.323Z\",\"updatedAt\":\"2025-12-13T13:29:34.637Z\",\"publishedAt\":\"2025-12-07T16:07:19.324Z\",\"featuredAt\":\"2026-07-24T13:21:36.526Z\",\"reported\":false,\"approvedAt\":null,\"type\":\"site\",\"attributes\":{\"url\":\"https://kargo-studio.com/\",\"categories\":[{\"id\":\"6a730e3d-bdf2-42a2-ab42-eee5ef39b694\",\"name\":\"Portfolio\",\"slug\":\"portfolio\"}]}},{\"id\":\"12686\",\"resolved\":true,\"title\":\"bohdan.design\",\"body\":null,\"bodyJson\":null,\"introduction\":\"Memorable interaction-driven experience built entirely in Framer. Scroll- and cursor-controlled video, expressive typographic animations, parallax, magnetic effects, pixel transitions, and custom overlays that turn navigation into a dynamic dialogue.\",\"slug\":\"bohdan-design\",\"author\":{\"framerUserId\":\"fbbf9124-572c-4663-922e-226e17935239\",\"name\":\"Bogdan Skripka\",\"slug\":\"bogdan-skripka\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/64353/avatar-msMtj4l1CHbJfCKEvt5GI0Ibp8CwKR.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"video\",\"url\":\"https://stream.mux.com/brVo2sjAps9sVIFhg7XZnN3ZNbHr1Q2LJudzMrvaJAc.m3u8\",\"metadata\":{\"posterUrl\":\"https://image.mux.com/brVo2sjAps9sVIFhg7XZnN3ZNbHr1Q2LJudzMrvaJAc/thumbnail.webp?time=2.449\",\"aspectRatio\":\"16:9\",\"duration\":36.770256}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/sites/12686/thumbnail.jpg\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/sites/12686/screenshotOne.jpg\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/sites/12686/screenshotTwo.jpg\",\"metadata\":{\"tint\":\"hsl(0 50% 6%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/sites/12686/screenshotThree.jpg\",\"metadata\":{\"tint\":\"hsl(17 70% 16%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019c1565-686a-7a32-844e-5ec8341653d7\",\"bodyJson\":null,\"likes\":{\"count\":270,\"liked\":false},\"comments\":{\"count\":11},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-01-31T18:51:33.352Z\",\"updatedAt\":\"2026-01-31T18:51:33.352Z\",\"publishedAt\":\"2026-01-31T18:51:33.354Z\",\"featuredAt\":\"2026-06-16T10:22:28.815Z\",\"reported\":false,\"approvedAt\":null,\"type\":\"site\",\"attributes\":{\"url\":\"https://bohdan.design/\",\"categories\":[]}},{\"id\":\"16967\",\"resolved\":true,\"title\":\"Physiflow\",\"body\":\"\u003cp\u003e\u003ca href=\\\"http://Physiflow.ai\\\" rel=\\\"noopener noreferrer nofollow\\\" target=\\\"_blank\\\"\u003ePhysiflow.ai\u003c/a\u003e is a Framer site for an Australian allied health platform that helps clinicians spend less time on admin and more time with patients.\u003c/p\u003e\u003cp\u003eThe product does a lot: notes, exercise prescription, treatment plans, letters, outcome measures, patient programmes and more, so the site needed to make all of that feel clear without flattening it into a wall of features.\u003c/p\u003e\u003cp\u003eWe kept the design clean and editorial, with big type, plenty of space, soft clinical blues, product UI throughout and motion used where it actually helps. There are animated demos, CMS-driven sections, responsive interactions and plenty of places to get into the product without the site ever feeling busy.\u003c/p\u003e\u003cp\u003eIt’s polished, but not overly “techy.” Clinical, but not cold. And it gives the product enough room to do the talking.\u003c/p\u003e\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Physiflow.ai\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"http://Physiflow.ai\",\"target\":\"_blank\"}}]},{\"type\":\"text\",\"text\":\" is a Framer site for an Australian allied health platform that helps clinicians spend less time on admin and more time with patients.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"The product does a lot: notes, exercise prescription, treatment plans, letters, outcome measures, patient programmes and more, so the site needed to make all of that feel clear without flattening it into a wall of features.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"We kept the design clean and editorial, with big type, plenty of space, soft clinical blues, product UI throughout and motion used where it actually helps. There are animated demos, CMS-driven sections, responsive interactions and plenty of places to get into the product without the site ever feeling busy.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"It’s polished, but not overly “techy.” Clinical, but not cold. And it gives the product enough room to do the talking.\"}]}]},\"introduction\":\"\",\"slug\":\"physiflow\",\"author\":{\"framerUserId\":\"284a6788-32de-4c5c-ae1e-dbce520404ec\",\"name\":\"Shawnee Wright\",\"slug\":\"shawnee-wright\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/1159017/avatar-wF7IXC1waagUGGGYTTdtr1g4BQB2lQ.jpg\",\"badges\":[\"pro\"],\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"video\",\"url\":\"https://stream.mux.com/oM8HjFvaGT6YJP2LN7zjgzAqUNA4cr9wJOFhtFbI01OI.m3u8\",\"metadata\":{\"posterUrl\":\"https://image.mux.com/oM8HjFvaGT6YJP2LN7zjgzAqUNA4cr9wJOFhtFbI01OI/thumbnail.webp?time=9.831\",\"aspectRatio\":\"4:3\",\"duration\":32.248889}}],\"post\":{\"id\":\"01a016d0-5817-72ca-bd10-5f06b779a062\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"New site shipped! Polished, but not overly “techy.” Clinical, but not cold. And it gives the product enough room to do the talking.\"}]}]},\"likes\":{\"count\":13,\"liked\":false},\"comments\":{\"count\":1},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-08-18T21:39:07.435Z\",\"updatedAt\":\"2026-08-18T21:39:07.435Z\",\"publishedAt\":\"2026-08-18T21:39:07.431Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"site\",\"attributes\":{\"url\":\"https://physiflow.ai/\",\"categories\":[{\"id\":\"0539c25a-136d-4f8b-a2e7-342a21b7d607\",\"name\":\"AI\",\"slug\":\"ai\"},{\"id\":\"ddd39099-5b17-42e0-b333-7b7c480a114f\",\"name\":\"Business\",\"slug\":\"business\"},{\"id\":\"1fec15c2-ca4a-4d52-bf3a-c04e6d002202\",\"name\":\"SaaS\",\"slug\":\"saas\"}]}},{\"id\":\"16007\",\"resolved\":true,\"title\":\"Billow\",\"body\":\"\u003cp\u003eLanding Page and Brand for Billow, the service operating system for freelancers, studios, and agencies!\u003c/p\u003e\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Landing Page and Brand for Billow, the service operating system for freelancers, studios, and agencies!\"}]}]},\"introduction\":\"\",\"slug\":\"billow\",\"author\":{\"framerUserId\":\"9387f0cc-b47f-4364-9402-a74231861534\",\"name\":\"Trueform\",\"slug\":\"trueform\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/563391/avatar-MIhUwg2ObrPnvha1HFHBwIQWwXG4BE.jpg\",\"badges\":[\"pro\"],\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/9387f0cc-b47f-4364-9402-a74231861534/trrfpzjb\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019e91c6-d5ce-7235-96aa-e1c075d07887\",\"bodyJson\":null,\"likes\":{\"count\":164,\"liked\":false},\"comments\":{\"count\":19},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-06-04T08:36:27.686Z\",\"updatedAt\":\"2026-06-04T08:36:27.686Z\",\"publishedAt\":\"2026-06-04T08:36:27.676Z\",\"featuredAt\":\"2026-06-04T15:05:44.384Z\",\"reported\":false,\"approvedAt\":null,\"type\":\"site\",\"attributes\":{\"url\":\"https://www.billow.so/\",\"categories\":[{\"id\":\"1fec15c2-ca4a-4d52-bf3a-c04e6d002202\",\"name\":\"SaaS\",\"slug\":\"saas\"},{\"id\":\"b65821c4-e205-4861-a28b-1623536037f7\",\"name\":\"Landing Page\",\"slug\":\"landing-page\"},{\"id\":\"ddd39099-5b17-42e0-b333-7b7c480a114f\",\"name\":\"Business\",\"slug\":\"business\"}]}},{\"id\":\"16954\",\"resolved\":true,\"title\":\"Hunar.ai\",\"body\":\"\u003cp\u003eWeb design and development for \u003ca href=\\\"https://Hunar.ai\\\" rel=\\\"noopener noreferrer nofollow\\\" target=\\\"_blank\\\"\u003eHunar.AI:\u003c/a\u003e\u003c/p\u003e\u003cp\u003eA platform that helps you make Voice AI enabled AI HRs for Hiring, Onboarding \u0026amp; Retention of your frontline workforce.\u003c/p\u003e\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Web design and development for \"},{\"type\":\"text\",\"text\":\"Hunar.AI:\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"https://Hunar.ai\",\"target\":\"_blank\"}}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"A platform that helps you make Voice AI enabled AI HRs for Hiring, Onboarding \u0026 Retention of your frontline workforce.\"}]}]},\"introduction\":\"\",\"slug\":\"hunar-ai\",\"author\":{\"framerUserId\":\"72406c5b-eb57-4fe8-a22c-20d8aee6f952\",\"name\":\"Nitin Sangwan\",\"slug\":\"nitin-sangwan\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/71895/avatar-wMSuRkDk8WeDyHl1x0Mj8orrVFpBiN.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/72406c5b-eb57-4fe8-a22c-20d8aee6f952/01a00e0d-6ff2-73e0-99ba-a80f8a1245c1.png\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/72406c5b-eb57-4fe8-a22c-20d8aee6f952/01a00e0e-a53c-714b-adeb-eacfe8c2c269.png\",\"metadata\":{\"tint\":\"hsl(0 0% 9%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/72406c5b-eb57-4fe8-a22c-20d8aee6f952/01a00e0f-4d0a-709c-bd14-8fd779f8e77c.png\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/72406c5b-eb57-4fe8-a22c-20d8aee6f952/01a00e0f-f2d2-755a-858e-3c96cb1b34a6.png\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"01a00e11-25cf-7119-91d4-0596824f45e9\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"emoji\",\"attrs\":{\"name\":\"rocket\",\"emoji\":\"🚀\"}},{\"type\":\"text\",\"text\":\" The new \"},{\"type\":\"text\",\"text\":\"Hunar.ai\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"http://Hunar.ai\",\"target\":\"_blank\"}}]},{\"type\":\"text\",\"text\":\" website is live!\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"We’ve been working on a new digital home for Hunar, a company building AI for the frontline workforce.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"The goal was simple: make a complex product feel clear, approachable, and a little more fun to explore.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"From the story and messaging to the interactions, motion, and visual system, I got to design and build this from the ground up in Framer.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"A lot of iterations, tiny details, and late-night tweaks went into this one.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Would love to hear what you think \"},{\"type\":\"emoji\",\"attrs\":{\"name\":\"point_down\",\"emoji\":\"👇\"}}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"→ \"},{\"type\":\"text\",\"text\":\"https://hunar.ai\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"https://hunar.ai\",\"target\":\"_blank\"}}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Built with Framer.\"}]}]},\"likes\":{\"count\":8,\"liked\":false},\"comments\":{\"count\":2},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-08-17T04:53:19.267Z\",\"updatedAt\":\"2026-08-17T04:53:19.267Z\",\"publishedAt\":\"2026-08-17T04:53:19.262Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"site\",\"attributes\":{\"url\":\"https://hunar.ai/\",\"categories\":[{\"id\":\"ddd39099-5b17-42e0-b333-7b7c480a114f\",\"name\":\"Business\",\"slug\":\"business\"},{\"id\":\"0539c25a-136d-4f8b-a2e7-342a21b7d607\",\"name\":\"AI\",\"slug\":\"ai\"},{\"id\":\"1fec15c2-ca4a-4d52-bf3a-c04e6d002202\",\"name\":\"SaaS\",\"slug\":\"saas\"}]}},{\"id\":\"17046\",\"resolved\":true,\"title\":\"Pinboard\",\"body\":\"\u003cp\u003ePinboard connects the companies moving people, goods and energy with the right investors. They are a \u003cstrong\u003especialist capital introductions firm\u003c/strong\u003e by people who understand the industry. They make a small number of highly targeted introductions, matching companies with investors who genuinely fit the opportunity.\u003c/p\u003e\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Pinboard connects the companies moving people, goods and energy with the right investors. They are a \"},{\"type\":\"text\",\"text\":\"specialist capital introductions firm\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" by people who understand the industry. They make a small number of highly targeted introductions, matching companies with investors who genuinely fit the opportunity.\"}]}]},\"introduction\":\"\",\"slug\":\"pinboard\",\"author\":{\"framerUserId\":\"e9ca18f0-0402-4218-9fd2-356dbea8ceb2\",\"name\":\"Heat Bureau\",\"slug\":\"heat-bureau\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/245128/avatar-BbU2nDJLROdLbfzjK7yE1h9CeIDOWH.jpg\",\"badges\":[\"pro\"],\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/e9ca18f0-0402-4218-9fd2-356dbea8ceb2/01a033f0-d7d5-71fd-95bc-d3576df513b8.png\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/e9ca18f0-0402-4218-9fd2-356dbea8ceb2/01a033ff-4250-727f-8064-a68d557e88b6.png\",\"metadata\":{\"tint\":\"hsl(210 18% 33%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"01a033ff-8351-7159-8268-98f39a52d53a\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Pinboard\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer\",\"href\":\"https://thepinboard.co.uk/\",\"target\":\"_blank\"}}]},{\"type\":\"text\",\"text\":\" is a specialist capital introductions firm connecting companies moving people, goods and energy with the right investors.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"We took their Lovable site and completely redesigned it in Framer – end to end in a week. The original served as our copy reference and structural vector; we rebuilt everything else. The scope: a full brandbook (logo, type, colour, motion), rewritten copy that puts fundraising companies front and centre, a single-scroll homepage, and a two-step contact flow that branches by audience.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"The design language leans quiet and editorial – a lot of whitespace, restrained accents, and imagery carrying four sector verticals: mobility \u0026 transport, logistics \u0026 supply chain, energy \u0026 electrification, and software \u0026 AI.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Branding + Framer build by HEAT Bureau \"},{\"type\":\"emoji\",\"attrs\":{\"name\":\"raised_hands\",\"emoji\":\"🙌\"}},{\"type\":\"text\",\"text\":\" .\"}]}]},\"likes\":{\"count\":7,\"liked\":false},\"comments\":{\"count\":1},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-08-24T13:39:37.800Z\",\"updatedAt\":\"2026-08-24T13:39:37.800Z\",\"publishedAt\":\"2026-08-24T13:39:37.796Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"site\",\"attributes\":{\"url\":\"https://thepinboard.co.uk/\",\"categories\":[{\"id\":\"6a730e3d-bdf2-42a2-ab42-eee5ef39b694\",\"name\":\"Portfolio\",\"slug\":\"portfolio\"},{\"id\":\"ddd39099-5b17-42e0-b333-7b7c480a114f\",\"name\":\"Business\",\"slug\":\"business\"},{\"id\":\"b65821c4-e205-4861-a28b-1623536037f7\",\"name\":\"Landing Page\",\"slug\":\"landing-page\"}]}},{\"id\":\"16733\",\"resolved\":true,\"title\":\"YanXin Zhang\",\"body\":\"\u003cp\u003eMultidisciplinary experiential designer and creative lead who blends art direction, branding, 2D/3D motion, and UI/UX into cohesive visual storytelling.\u003c/p\u003e\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Multidisciplinary experiential designer and creative lead who blends art direction, branding, 2D/3D motion, and UI/UX into cohesive visual storytelling.\"}]}]},\"introduction\":\"\",\"slug\":\"yanxin-zhang\",\"author\":{\"framerUserId\":\"c16ed0f1-6deb-407b-ad37-b33e165d3012\",\"name\":\"jason zay\",\"slug\":\"jason-zay\",\"avatar\":null,\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"video\",\"url\":\"https://stream.mux.com/us5E00NDkQcJhJM1Td701BRoWSyhFX82l00LPva02yhCFYk.m3u8\",\"metadata\":{\"posterUrl\":\"https://image.mux.com/us5E00NDkQcJhJM1Td701BRoWSyhFX82l00LPva02yhCFYk/thumbnail.webp?time=2.9\",\"aspectRatio\":\"40:27\",\"duration\":4.9}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/c16ed0f1-6deb-407b-ad37-b33e165d3012/019f84e1-aae1-717c-be4f-3d801c71befe.png\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3338891204668613}}],\"post\":{\"id\":\"019f84ca-24a2-7401-b2c2-a79ff1daf7d6\",\"bodyJson\":null,\"likes\":{\"count\":60,\"liked\":false},\"comments\":{\"count\":1},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-07-21T13:07:47.651Z\",\"updatedAt\":\"2026-07-21T13:33:44.164Z\",\"publishedAt\":\"2026-07-21T13:07:47.641Z\",\"featuredAt\":\"2026-07-23T09:13:56.929Z\",\"reported\":false,\"approvedAt\":null,\"type\":\"site\",\"attributes\":{\"url\":\"https://yanxinzhang.com/\",\"categories\":[{\"id\":\"6a730e3d-bdf2-42a2-ab42-eee5ef39b694\",\"name\":\"Portfolio\",\"slug\":\"portfolio\"},{\"id\":\"cb1ce5d0-8749-428e-b0d8-917786928ffd\",\"name\":\"Personal\",\"slug\":\"personal\"},{\"id\":\"b65821c4-e205-4861-a28b-1623536037f7\",\"name\":\"Landing Page\",\"slug\":\"landing-page\"}]}},{\"id\":\"16943\",\"resolved\":true,\"title\":\"RabenRifaie Studio\",\"body\":\"\u003cp\u003eAn immersive experience page introducing RabenRifaie creative design studio, featuring custom high-quality 3D animations, tactile textures and a seamless responsive layout for every device.\u003c/p\u003e\u003cp\u003eDesigned and developed in-house with major credits to \u003ca class=\\\"mention\\\" data-type=\\\"mention\\\" data-id=\\\"8134d96e-6a7e-49d6-bdff-49a6b26ce6f1\\\" href=\\\"/community/creator/@oliwia-mikolajczak/\\\"\u003e@Oliwia Mikołajczak\u003c/a\u003e \u003c/p\u003e\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"An immersive experience page introducing RabenRifaie creative design studio, featuring custom high-quality 3D animations, tactile textures and a seamless responsive layout for every device.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Designed and developed in-house with major credits to \"},{\"type\":\"mention\",\"attrs\":{\"id\":\"8134d96e-6a7e-49d6-bdff-49a6b26ce6f1\",\"slug\":\"oliwia-mikolajczak\",\"label\":\"Oliwia Mikołajczak\",\"mentionSuggestionChar\":\"@\"}},{\"type\":\"text\",\"text\":\" \"}]}]},\"introduction\":\"\",\"slug\":\"rabenrifaie-studio\",\"author\":{\"framerUserId\":\"3ef6f63c-419d-47bb-b96e-ae1abb169400\",\"name\":\"RabenRifaie\",\"slug\":\"rabenrifaie\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/3ef6f63c-419d-47bb-b96e-ae1abb169400/bd21ugbr\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"video\",\"url\":\"https://stream.mux.com/G02KCZ01RNBd02VGwa1A7OEq2uCRZwXFDK4a5YqkVXchoM.m3u8\",\"metadata\":{\"posterUrl\":\"https://image.mux.com/G02KCZ01RNBd02VGwa1A7OEq2uCRZwXFDK4a5YqkVXchoM/thumbnail.webp?time=18.392\",\"aspectRatio\":\"59:34\",\"duration\":26.55}}],\"post\":{\"id\":\"01a004c6-a153-76b0-a497-165ee19304e4\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Hi and welcome, here's our page! \"},{\"type\":\"emoji\",\"attrs\":{\"name\":\"smile\",\"emoji\":\"😄\"}},{\"type\":\"text\",\"text\":\" \"}]}]},\"likes\":{\"count\":15,\"liked\":false},\"comments\":{\"count\":2},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-08-15T09:35:20.963Z\",\"updatedAt\":\"2026-08-15T09:35:20.963Z\",\"publishedAt\":\"2026-08-15T09:35:20.956Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"site\",\"attributes\":{\"url\":\"https://rabenrifaie.com/\",\"categories\":[{\"id\":\"4e292c6b-a094-4031-be7b-7affa4349187\",\"name\":\"Agency\",\"slug\":\"agency\"},{\"id\":\"ddd39099-5b17-42e0-b333-7b7c480a114f\",\"name\":\"Business\",\"slug\":\"business\"},{\"id\":\"b65821c4-e205-4861-a28b-1623536037f7\",\"name\":\"Landing Page\",\"slug\":\"landing-page\"}]}},{\"id\":\"13152\",\"resolved\":true,\"title\":\"Huehaus\",\"body\":null,\"bodyJson\":null,\"introduction\":\"A creative design studio specializing in emotion-driven visual storytelling built on Framer. HueHaus combines fluid animations with strategic brand design to create immersive web experiences that drive engagement and conversions. \",\"slug\":\"huehaus\",\"author\":{\"framerUserId\":\"75daa66e-f6ac-40cc-a657-fc512991d883\",\"name\":\"Huehaus Studio\",\"slug\":\"huehaus-studio\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/34299/avatar-bp3mzKKtnuZkwx4x5jOPkcGyYw2xUX.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/sites/13152/thumbnail-zDJaNJRXkkCNUvreuIEIFOyFm5bTer.jpg\",\"metadata\":{\"tint\":\"hsl(60 53% 39%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019c6516-4fe9-7185-abb0-34e12b87b339\",\"bodyJson\":null,\"likes\":{\"count\":195,\"liked\":false},\"comments\":{\"count\":16},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-02-16T06:14:47.015Z\",\"updatedAt\":\"2026-02-16T06:14:47.015Z\",\"publishedAt\":\"2026-02-16T06:14:47.017Z\",\"featuredAt\":\"2026-06-16T10:20:34.421Z\",\"reported\":false,\"approvedAt\":null,\"type\":\"site\",\"attributes\":{\"url\":\"https://huehaus.design/\",\"categories\":[{\"id\":\"4e292c6b-a094-4031-be7b-7affa4349187\",\"name\":\"Agency\",\"slug\":\"agency\"},{\"id\":\"6a730e3d-bdf2-42a2-ab42-eee5ef39b694\",\"name\":\"Portfolio\",\"slug\":\"portfolio\"}]}},{\"id\":\"15527\",\"resolved\":true,\"title\":\"Denis Turbin — UI/UX Designer\",\"body\":null,\"bodyJson\":null,\"introduction\":\"Freelance UI/UX designer and Framer developer. 3+ years across fintech, SaaS, education, and e-commerce. Fast iterations, bold brand identities, and distinctive digital experiences.\",\"slug\":\"denis-turbin-ui-ux-designer\",\"author\":{\"framerUserId\":\"2b33eac4-4422-4c15-ba75-80a068fa9086\",\"name\":\"Denis Hussle\",\"slug\":\"denis-hussle\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/2b33eac4-4422-4c15-ba75-80a068fa9086/gogz3777\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/sites/15527/thumbnail-59vLx5sOIAQrgDXkKeZxJTEHhBWbqH.jpg\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019e2099-bb3b-706a-8558-723beb2cefce\",\"bodyJson\":null,\"likes\":{\"count\":111,\"liked\":false},\"comments\":{\"count\":2},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-05-13T09:10:06.394Z\",\"updatedAt\":\"2026-06-08T09:51:33.221Z\",\"publishedAt\":\"2026-05-13T09:10:06.395Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"site\",\"attributes\":{\"url\":\"https://trbn.design/old-home\",\"categories\":[{\"id\":\"4deaf317-a648-4f8b-ae2a-f9a4cf1a35da\",\"name\":\"Education\",\"slug\":\"education\"},{\"id\":\"6a730e3d-bdf2-42a2-ab42-eee5ef39b694\",\"name\":\"Portfolio\",\"slug\":\"portfolio\"}]}},{\"id\":\"16897\",\"resolved\":true,\"title\":\"Onmoon\",\"body\":\"\u003cp\u003e\u003cstrong\u003eOnmoon is a creative motion design agency that helps businesses communicate complex ideas through engaging animated videos. From explainer videos to brand storytelling, Onmoon creates high-quality visual content designed to capture attention, simplify messages, and boost audience engagement.\u003c/strong\u003e \u003c/p\u003e\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Onmoon is a creative motion design agency that helps businesses communicate complex ideas through engaging animated videos. From explainer videos to brand storytelling, Onmoon creates high-quality visual content designed to capture attention, simplify messages, and boost audience engagement.\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" \"}]}]},\"introduction\":\"\",\"slug\":\"onmoon\",\"author\":{\"framerUserId\":\"70bac9ed-94c3-45a0-b060-36fe533a38ac\",\"name\":\"anthony ramos\",\"slug\":\"anthony-ramos\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/70bac9ed-94c3-45a0-b060-36fe533a38ac/yf2xx25o\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/70bac9ed-94c3-45a0-b060-36fe533a38ac/019fdd0f-b87e-74fa-8856-736c76f2e80d.png\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1}}],\"post\":{\"id\":\"019fdd10-1745-729b-aa0a-469a04a681af\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"New Website ! \"}]}]},\"likes\":{\"count\":8,\"liked\":false},\"comments\":{\"count\":5},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-08-07T16:30:46.679Z\",\"updatedAt\":\"2026-08-07T16:30:46.679Z\",\"publishedAt\":\"2026-08-07T16:30:46.615Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"site\",\"attributes\":{\"url\":\"https://www.onmoon.fr/\",\"categories\":[{\"id\":\"4e292c6b-a094-4031-be7b-7affa4349187\",\"name\":\"Agency\",\"slug\":\"agency\"},{\"id\":\"b65821c4-e205-4861-a28b-1623536037f7\",\"name\":\"Landing Page\",\"slug\":\"landing-page\"},{\"id\":\"ddd39099-5b17-42e0-b333-7b7c480a114f\",\"name\":\"Business\",\"slug\":\"business\"}]}},{\"id\":\"17002\",\"resolved\":true,\"title\":\"Rolai\",\"body\":\"$50\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Designing a website for an enterprise AI platform\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Rolai is an AI platform built for businesses and universities. It brings AI agents, workflows, integrations, knowledge bases, and other AI tools into one place.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"The main challenge with the project was pretty straightforward: \"},{\"type\":\"text\",\"text\":\"there's a lot going on in the product.\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"I wanted the website to explain what Rolai does without making visitors work too hard to understand it.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"The Approach\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"I kept the design clean and focused heavily on the product itself.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Instead of filling the pages with long explanations, I used the interface, product visuals, and clear sections to show how Rolai actually works.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"The website walks users through the different parts of the platform, from AI agents and workflows to integrations and security.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Making AI Feel Less Complicated\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"AI products can easily start feeling technical or overwhelming, especially when you're targeting businesses and larger organizations.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"So the goal was to make Rolai feel approachable while still giving it the credibility you'd expect from an enterprise product.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"I focused on simple layouts, strong typography, clear hierarchy, and plenty of space around the content.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"The Result\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"The final website gives Rolai a more polished product presence while making the platform easier to understand at a glance.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"The idea was never to make the website feel flashy just for the sake of it.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"It was about taking a complex product and making it feel simple.\",\"marks\":[{\"type\":\"bold\"}]}]}]},\"introduction\":\"\",\"slug\":\"rolai\",\"author\":{\"framerUserId\":\"ba95b34a-5ed3-496b-b8b2-e8c0a7412fcb\",\"name\":\"Krokzy\",\"slug\":\"krokzy\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/2057450/_LOuTwfoj-wwUSciBlcKRdMrpgbBhdqkjnCk5hnd\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/ba95b34a-5ed3-496b-b8b2-e8c0a7412fcb/01a029ea-fc44-778a-9d99-450f444f465f.jpg\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"01a0280e-65ac-72cb-95d2-60ee0df1484b\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Worked on a new website for \"},{\"type\":\"text\",\"text\":\"Rolai\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\".\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"The product has a lot going on, so the main focus was keeping the website simple without making it feel too basic.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Spent most of the time on the layout, typography, product sections, and making the overall flow feel natural.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Sharing some of the work here.\"}]}]},\"likes\":{\"count\":12,\"liked\":false},\"comments\":{\"count\":0},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-08-22T06:00:26.718Z\",\"updatedAt\":\"2026-08-22T14:41:07.168Z\",\"publishedAt\":\"2026-08-22T06:00:26.715Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"site\",\"attributes\":{\"url\":\"https://www.rolai.com/\",\"categories\":[{\"id\":\"0539c25a-136d-4f8b-a2e7-342a21b7d607\",\"name\":\"AI\",\"slug\":\"ai\"},{\"id\":\"1fec15c2-ca4a-4d52-bf3a-c04e6d002202\",\"name\":\"SaaS\",\"slug\":\"saas\"},{\"id\":\"b65821c4-e205-4861-a28b-1623536037f7\",\"name\":\"Landing Page\",\"slug\":\"landing-page\"}]}},{\"id\":\"15234\",\"resolved\":true,\"title\":\"Stefan Stefancik\",\"body\":null,\"bodyJson\":null,\"introduction\":\"Personal Portfolio of a designer Stefan Stefancik\",\"slug\":\"stefan-stefancik\",\"author\":{\"framerUserId\":\"6f9a743c-857e-453b-bcbb-14157f92d8eb\",\"name\":\"Štefan Štefančík\",\"slug\":\"stefan-stefancik\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/142103/01Tbqcw_P-9kK9IJWrZz1KDWDV5F6nBcg7jeEjPD\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/sites/15234/thumbnail-4xOA2066dm74Fn6aVC271ohKeFWssJ.jpg\",\"metadata\":{\"tint\":\"hsl(180 7% 28%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019df247-e750-7379-8079-97c16150a3e3\",\"bodyJson\":null,\"likes\":{\"count\":171,