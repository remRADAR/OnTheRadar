es\":[\"framer\"],\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/6c7f4c94-b4ca-488a-a2e0-d504c4ca551d/4e5qmdoa\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019f043e-f053-706a-9262-02c9adfeb665\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Wondering if you Framer site titles, descriptions, and images look good? Preview any URL before it is shared. Check Open Graph tags, X preview cards, OG images, and link previews.\"}]}]},\"likes\":{\"count\":32,\"liked\":false},\"comments\":{\"count\":6},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-06-26T14:04:21.401Z\",\"updatedAt\":\"2026-06-26T14:04:21.401Z\",\"publishedAt\":\"2026-06-26T14:04:21.389Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"site\",\"attributes\":{\"url\":\"https://www.linkpreview.app/\",\"categories\":[{\"id\":\"1fec15c2-ca4a-4d52-bf3a-c04e6d002202\",\"name\":\"SaaS\",\"slug\":\"saas\"},{\"id\":\"b65821c4-e205-4861-a28b-1623536037f7\",\"name\":\"Landing Page\",\"slug\":\"landing-page\"}]}},{\"id\":\"15594\",\"resolved\":true,\"title\":\"Major Media Agency\",\"body\":null,\"bodyJson\":null,\"introduction\":\"A motion-first portfolio for Major, a US production house behind content for pro sports teams, global brands, and leading influencers. Designed to move as fast as the work itself.\",\"slug\":\"major-media-agency\",\"author\":{\"framerUserId\":\"6bb69307-087c-49b3-b3cc-0a8999855f1d\",\"name\":\"Stōkt\",\"slug\":\"wearestokt\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/110054/STOKT-CREATIVE-CO-BRANDING-01-Vg8u0ayr7EnzkYCH2I0XzrNMk6n2Pf.jpg\",\"badges\":[\"pro\"],\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/sites/15594/thumbnail-SJMgWNrYCBdtrh9DmJP6nk4FliNJfm.jpg\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019e2665-7a11-7613-834c-3a542fee07a1\",\"bodyJson\":null,\"likes\":{\"count\":80,\"liked\":false},\"comments\":{\"count\":1},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-05-14T12:10:45.135Z\",\"updatedAt\":\"2026-05-14T12:10:45.135Z\",\"publishedAt\":\"2026-05-14T12:10:45.137Z\",\"featuredAt\":\"2026-06-01T15:19:30.786Z\",\"reported\":false,\"approvedAt\":null,\"type\":\"site\",\"attributes\":{\"url\":\"https://thiswasmajor.com/\",\"categories\":[{\"id\":\"6a730e3d-bdf2-42a2-ab42-eee5ef39b694\",\"name\":\"Portfolio\",\"slug\":\"portfolio\"}]}},{\"id\":\"16615\",\"resolved\":true,\"title\":\"Startfrom\",\"body\":\"\u003cp\u003eStartfrom is a soft, editorial home for a growing library of Framer templates. The site combines a calm visual system, full-screen hero, template previews, CMS-powered writing, and simple conversion paths to help visitors choose a starting point and launch faster.\u003c/p\u003e\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Startfrom is a soft, editorial home for a growing library of Framer templates. The site combines a calm visual system, full-screen hero, template previews, CMS-powered writing, and simple conversion paths to help visitors choose a starting point and launch faster.\"}]}]},\"introduction\":\"\",\"slug\":\"startfrom\",\"author\":{\"framerUserId\":\"b505b9dc-5fa4-42d6-ad8a-36ea114d98d6\",\"name\":\"Alex Prokhorov\",\"slug\":\"alex-prokhorov\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/30678/photo_2023-08-02%2022.18.40-xybJQiuozIgB2Ywelb9O9kcMEVCmz4.jpeg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"video\",\"url\":\"https://stream.mux.com/ciXzSAelthFCuUQpe6xWVseW1DR005mzo02KJn701102WoI.m3u8\",\"metadata\":{\"posterUrl\":\"https://image.mux.com/ciXzSAelthFCuUQpe6xWVseW1DR005mzo02KJn701102WoI/thumbnail.webp?time=10.283\",\"aspectRatio\":\"4:3\",\"duration\":11.683333}},{\"type\":\"video\",\"url\":\"https://stream.mux.com/vnhInji1cW00MJo6jQQV8WO02hiaXyDgFbdLimJ1hkGng.m3u8\",\"metadata\":{\"posterUrl\":\"https://image.mux.com/vnhInji1cW00MJo6jQQV8WO02hiaXyDgFbdLimJ1hkGng/thumbnail.webp?time=2.717\",\"aspectRatio\":\"4:3\",\"duration\":15.666667}}],\"post\":{\"id\":\"019f436b-61bb-72ca-b843-543fc1c63978\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Startfrom is live in the Framer Gallery.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"A library of studio-made Framer templates you can duplicate, edit, and publish. Soft visual system, responsive layouts, and a simple path from browsing to launch.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Websites you can start from, not start over.\"}]}]},\"likes\":{\"count\":39,\"liked\":false},\"comments\":{\"count\":10},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-07-08T20:28:57.969Z\",\"updatedAt\":\"2026-07-08T20:28:57.969Z\",\"publishedAt\":\"2026-07-08T20:28:57.966Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"site\",\"attributes\":{\"url\":\"https://startfrom.co/\",\"categories\":[{\"id\":\"3b2881c5-bbfb-430d-83f6-b1b0ac597b8d\",\"name\":\"Ecommerce\",\"slug\":\"ecommerce\"},{\"id\":\"b65821c4-e205-4861-a28b-1623536037f7\",\"name\":\"Landing Page\",\"slug\":\"landing-page\"},{\"id\":\"6a730e3d-bdf2-42a2-ab42-eee5ef39b694\",\"name\":\"Portfolio\",\"slug\":\"portfolio\"}]}},{\"id\":\"17018\",\"resolved\":true,\"title\":\"Wishnow Legal\",\"body\":\"\u003ch3\u003eMy role:\u003c/h3\u003e\u003cp\u003eLed the complete design and development of Wishnow Legal\u0026#39;s landing page using Framer.\u003c/p\u003e\u003ch3\u003eProject description: \u003c/h3\u003e\u003cp\u003eDesigned and developed a professional Landing Page for Wishnow Legal, a New York-based entertainment law firm serving creators, producers and talent. The project focused on presenting complex legal services in a clear, approachable format while maintaining the credibility and sophistication expected from a legal practice. The result is a polished digital presence that effectively communicates the firm\u0026#39;s expertise and services.\u003c/p\u003e\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"My role:\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Led the complete design and development of Wishnow Legal's landing page using Framer.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Project description: \"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Designed and developed a professional Landing Page for Wishnow Legal, a New York-based entertainment law firm serving creators, producers and talent. The project focused on presenting complex legal services in a clear, approachable format while maintaining the credibility and sophistication expected from a legal practice. The result is a polished digital presence that effectively communicates the firm's expertise and services.\"}]}]},\"introduction\":\"\",\"slug\":\"wishnow-legal\",\"author\":{\"framerUserId\":\"4c22ca1a-0e8a-47ad-aa74-8786e65a25b2\",\"name\":\"Uzair J.\",\"slug\":\"uzair-j\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/34632/EiMhO3d2p-TBxlwGdEbDJOJymauoDIPQiw1z0DgF\",\"badges\":[\"pro\"],\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/4c22ca1a-0e8a-47ad-aa74-8786e65a25b2/01a02941-f69b-770b-8171-eed6a73f9876.png\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"01a02942-12b8-703e-9b89-7a94d38f334f\",\"bodyJson\":null,\"likes\":{\"count\":2,\"liked\":false},\"comments\":{\"count\":2},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-08-22T11:36:30.609Z\",\"updatedAt\":\"2026-08-22T11:36:30.609Z\",\"publishedAt\":\"2026-08-22T11:36:30.606Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"site\",\"attributes\":{\"url\":\"https://www.wishnowlegal.com/\",\"categories\":[{\"id\":\"4e292c6b-a094-4031-be7b-7affa4349187\",\"name\":\"Agency\",\"slug\":\"agency\"}]}},{\"id\":\"16940\",\"resolved\":true,\"title\":\"CartFlami\",\"body\":\"$5c\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"CartFlami\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" is a Brazilian transparent-checkout platform, and I built their marketing website in Framer to introduce it.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"The site's job was to sell a technical product (checkout infrastructure) to a broad range of sellers: infoproduct creators, e-commerce stores, and dropshippers. I built a feature-driven landing page walking visitors through cart recovery, order bumps, one-click upsell, progressive discounts, and installment Pix payments, alongside a global checkout section covering multi-currency support and a real-time analytics dashboard.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Key features:\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Feature grid built natively in Framer, with product mockups and embedded video demonstrating the checkout flow\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Global checkout section highlighting multi-currency and multi-language support\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Integrations showcase for payment gateways and e-commerce tools\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Tiered pricing section (Start, Rise, Prime) with transparent fee structures\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"App download section for iOS and Android\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Result:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" a clear, conversion-focused site for a checkout product whose value proposition is speed and simplicity, translated into a page that gets that message across just as fast.\"}]}]},\"introduction\":\"\",\"slug\":\"cartflami\",\"author\":{\"framerUserId\":\"06542684-037c-4e8e-867c-09efbbf8118a\",\"name\":\"Eduardo Henrique\",\"slug\":\"eduardo-henrique\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/450886/avatar-UCqUNa8WAiqx0LlDOquUqWPEgV01Ku.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"video\",\"url\":\"https://stream.mux.com/RI3hT01L01mbFjgP01HHFoPc01fHLsT00wWc8oBb2E002hzlw.m3u8\",\"metadata\":{\"posterUrl\":\"https://image.mux.com/RI3hT01L01mbFjgP01HHFoPc01fHLsT00wWc8oBb2E002hzlw/thumbnail.webp?time=13.933\",\"aspectRatio\":\"4:3\",\"duration\":22.666667}}],\"post\":{\"id\":\"01a001d5-b481-750c-862f-4ace7791f6e7\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"We lit this project on fire \"},{\"type\":\"emoji\",\"attrs\":{\"name\":\"fire\",\"emoji\":\"🔥\"}},{\"type\":\"text\",\"text\":\" New site just launched for CartFlami, a transparent checkout platform sparking e-commerce sales across Brazil.\\\"\"}]}]},\"likes\":{\"count\":9,\"liked\":false},\"comments\":{\"count\":1},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-08-14T19:52:57.262Z\",\"updatedAt\":\"2026-08-14T19:52:57.262Z\",\"publishedAt\":\"2026-08-14T19:52:57.259Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"site\",\"attributes\":{\"url\":\"https://www.cartflami.com.br/\",\"categories\":[{\"id\":\"1fec15c2-ca4a-4d52-bf3a-c04e6d002202\",\"name\":\"SaaS\",\"slug\":\"saas\"}]}},{\"id\":\"14993\",\"resolved\":true,\"title\":\"Contact Me Today\",\"body\":\"\u003ch2\u003e\u003cstrong\u003eLet\u0026#39;s Build Your Enterprise SaaS Website\u003c/strong\u003e\u003c/h2\u003e\u003cp\u003eWhether you\u0026#39;re launching an AI platform, enterprise software, or a high-growth SaaS product, I build premium Framer websites that combine modern design, seamless interactions, and scalable user experiences that convert.\u003c/p\u003e\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Let's Build Your Enterprise SaaS Website\",\"marks\":[{\"type\":\"bold\"}]}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Whether you're launching an AI platform, enterprise software, or a high-growth SaaS product, I build premium Framer websites that combine modern design, seamless interactions, and scalable user experiences that convert.\"}]}]},\"introduction\":\"Get a professional starter website starting from $399. Perfect for businesses, personal brands, and startups that need a clean online presence. Message me on WhatsApp to discuss your ideas and get a website that matches your goals and budget.\",\"slug\":\"contact-me-today\",\"author\":{\"framerUserId\":\"34db2e5c-7885-42f1-87b5-7ba3d558d2a9\",\"name\":\"Mazher\",\"slug\":\"mazher\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/34db2e5c-7885-42f1-87b5-7ba3d558d2a9/oku4gs23\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"im