\"title\":\"Sarah Zaheer\",\"body\":\"\u003cp\u003eA portfolio for product designer Sara Zaheer, showcasing her experience, design approach, and case studies through an immersive experience rooted in empathy, research, and clarity.\u003c/p\u003e\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"A portfolio for product designer Sara Zaheer, showcasing her experience, design approach, and case studies through an immersive experience rooted in empathy, research, and clarity.\"}]}]},\"introduction\":\"\",\"slug\":\"sarah-zaheer\",\"author\":{\"framerUserId\":\"d395bbc2-0e43-4461-bddf-7d1559e0c9e9\",\"name\":\"Maks K\",\"slug\":\"maks-k\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/655534/avatar-z4u7BTHLEaCwcGeFrPxtU8jttnxms5.jpg\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/d395bbc2-0e43-4461-bddf-7d1559e0c9e9/019fe799-e304-719c-9337-2c7618ae2eae.png\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/d395bbc2-0e43-4461-bddf-7d1559e0c9e9/019fe799-fe19-7642-b2c6-f02c89157c9b.png\",\"metadata\":{\"tint\":\"hsl(240 29% 65%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019fe7a1-9890-712e-a2c0-e6cbaa242f3c\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Let's do a challenge. Share your latest work. I'll start:\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"We developed a portfolio website for our client, including both design and development (we wanted something out of the ordinary). It took over two months to complete. Do you think it was worth it?)\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"I look forward to seeing your work)\"}]}]},\"likes\":{\"count\":14,\"liked\":false},\"comments\":{\"count\":2},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-08-09T17:45:54.629Z\",\"updatedAt\":\"2026-08-09T17:45:54.629Z\",\"publishedAt\":\"2026-08-09T17:45:54.625Z\",\"featuredAt\":null,\"reported\":false,\"approvedAt\":null,\"type\":\"site\",\"attributes\":{\"url\":\"https://sarahzaheer.site/\",\"categories\":[{\"id\":\"6a730e3d-bdf2-42a2-ab42-eee5ef39b694\",\"name\":\"Portfolio\",\"slug\":\"portfolio\"},{\"id\":\"cb1ce5d0-8749-428e-b0d8-917786928ffd\",\"name\":\"Personal\",\"slug\":\"personal\"},{\"id\":\"4e292c6b-a094-4031-be7b-7affa4349187\",\"name\":\"Agency\",\"slug\":\"agency\"}]}},{\"id\":\"12575\",\"resolved\":true,\"title\":\"newgenre.studio\",\"body\":null,\"bodyJson\":null,\"introduction\":\"We are New Genre, a global design \u0026 technology studio creating strategies, brand systems, digital products, and experiences with the world's most disruptive thinkers.\",\"slug\":\"newgenre-studio\",\"author\":{\"framerUserId\":\"6f9906d5-f384-4d9d-abd4-b4aceee2f815\",\"name\":\"New Genre\",\"slug\":\"new-genre\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/906064/a524283da56c6d06ce3318e428c36503-ZWOzrwLz6PsFdXXUT5ZQLLIXWr6or5\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/sites/12575/thumbnail.jpg\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"019c0e81-4abc-7013-bfbc-9ef6a0c9f1ef\",\"bodyJson\":null,\"likes\":{\"count\":34,\"liked\":false},\"comments\":{\"count\":2},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-01-30T10:44:40.249Z\",\"updatedAt\":\"2026-01-30T10:44:40.249Z\",\"publishedAt\":\"2026-01-30T10:44:40.252Z\",\"featuredAt\":\"2026-06-16T11:28:04.456Z\",\"reported\":false,\"approvedAt\":null,\"type\":\"site\",\"attributes\":{\"url\":\"https:/