Url\":\"https://image.mux.com/3J1YFZfMb9cs1BaQWYU6TW8E6yTLq400UNWyz6IYA6T8/thumbnail.webp?time=3.6\",\"aspectRatio\":\"237:121\",\"duration\":22.766667}}],\"resources\":[],\"contests\":[],\"categories\":[{\"id\":\"cf35162f-8406-49a9-a023-4c58024795ee\",\"name\":\"General\",\"slug\":\"general\",\"description\":\"General\",\"metaTitle\":\"General\",\"metaDescription\":\"General\"}],\"tags\":[],\"likes\":{\"count\":14,\"liked\":false},\"comments\":{\"count\":8},\"reposts\":{\"count\":1,\"reposted\":false,\"repostId\":null},\"version\":1,\"edited\":false,\"editedAt\":null,\"createdAt\":\"2026-08-27T07:07:02.675Z\",\"updatedAt\":\"2026-08-27T07:07:02.675Z\"}},{\"entityType\":\"post\",\"entityId\":\"01a03001-809e-759e-b069-323e7a01aab2\",\"entity\":{\"id\":\"01a03001-809e-759e-b069-323e7a01aab2\",\"title\":null,\"body\":\"\u003cp\u003eJust made my first ever comission. Not a Huge amount but we have to start somewhere ;)\u003c/p\u003e\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Just made my first ever comission. Not a Huge amount but we have to start somewhere ;)\"}]}]},\"author\":{\"framerUserId\":\"0e5ef2ef-5768-4b29-b22b-211af54dfcec\",\"name\":\"Melcoflow\",\"slug\":\"clement-coquel\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/0e5ef2ef-5768-4b29-b22b-211af54dfcec/87h1kbwr\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/0e5ef2ef-5768-4b29-b22b-211af54dfcec/01a03000-fc53-775d-9a01-d87c8d6b6c0d.jpg\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":0.8148648648648649}}],\"resources\":[],\"contests\":[],\"categories\":[{\"id\":\"cf35162f-8406-49a9-a023-4c58024795ee\",\"name\":\"General\",\"slug\":\"general\",\"description\":\"General\",\"metaTitle\":\"General\",\"metaDescription\":\"General\"}],\"tags\":[],\"likes\":{\"count\":26,\"liked\":false},\"comments\":{\"count\":17},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null},\"version\":1,\"edited\":false,\"editedAt\":null,\"createdAt\":\"2026-08-23T19:03:19.970Z\",\"updatedAt\":\"2026-08-23T19:03:19.970Z\"}},{\"entityType\":\"template\",\"entityId\":\"71827\",\"entity\":{\"id\":\"71827\",\"resolved\":true,\"title\":\"Estanza\",\"body\":\"\u003cp\u003eEstanza is a modern, fully responsive real estate template built for agencies, agents, and property platforms. It includes a clean Home page, a filterable Properties listing with individual detail pages, an About page, Agent profiles, a Blog with CMS-ready posts, and a Contact page with a working inquiry form.\u003c/p\u003e\u003cp\u003eThe design features a warm, editorial aesthetic with a Fraunces serif heading font paired with Inter for body text, giving the template a premium, trustworthy feel suited for luxury and residential listings alike. All sections are built with Framer\u0026#39;s native CMS, making it easy to add, edit, or remove properties, agents, and blog posts without touching code.\u003c/p\u003e\u003cp\u003ePerfect for real estate agencies, independent agents, property management companies, or anyone launching a modern real estate brand online.\u003c/p\u003e\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Estanza is a modern, fully responsive real estate template built for agencies, agents, and property platforms. It includes a clean Home page, a filterable Properties listing with individual detail pages, an About page, Agent profiles, a Blog with CMS-ready posts, and a Contact page with a working inquiry form.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"The design features a warm, editorial aesthetic with a Fraunces serif heading font paired with Inter for body text, giving the template a premium, trustworthy feel suited for luxury and residential listings alike. All sections are built with Framer's native CMS, making it easy to add, edit, or remove properties, agents, and blog posts without touching code.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Perfect for real estate agencies, independent agents, property management companies, or anyone launching a modern real estate brand online.\"}]}]},\"introduction\":\"Modern Real Estate Site Template\",\"slug\":\"estanza\",\"author\":{\"framerUserId\":\"e736ac88-b85c-4339-afdb-f271d52be144\",\"name\":\"mr. Haneef\",\"slug\":\"mrhaneef\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/e736ac88-b85c-4339-afdb-f271d52be144/pbmxz72w\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/e736ac88-b85c-4339-afdb-f271d52be144/01a03751-5c76-753a-8498-6c5047c196cc.png\",\"metadata\":{\"tint\":\"hsl(40 51% 48%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/e736ac88-b85c-4339-afdb-f271d52be144/01a03751-bd4b-732a-bf17-efa9fc80e314.png\",\"metadata\":{\"tint\":\"hsl(0 0% 58%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/e736ac88-b85c-4339-afdb-f271d52be144/01a03751-fd85-771c-b652-18d5e763aafc.png\",\"metadata\":{\"tint\":\"hsl(60 53% 39%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/e736ac88-b85c-4339-afdb-f271d52be144/01a03752-3bb7-728b-bef2-adc46718d479.png\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"01a03755-cfca-7789-817b-9d3c6461af9b\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Just launched Estanza — a modern real estate template built for agencies and agents. \"},{\"type\":\"emoji\",\"attrs\":{\"name\":\"house_with_garden\",\"emoji\":\"🏡\"}},{\"type\":\"text\",\"text\":\" Includes filterable property listings, agent profiles, a blog, and a working contact form, all powered by Framer CMS.\"}]}]},\"likes\":{\"count\":11,\"liked\":false},\"comments\":{\"count\":6},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-08-25T05:12:45.145Z\",\"updatedAt\":\"2026-08-25T05:12:45.145Z\",\"publishedAt\":\"2026-08-25T05:12:45.142Z\",\"featuredAt\":null,\"approvedAt\":null,\"type\":\"template\",\"attributes\":{\"price\":null,\"paymentUrl\":\"https://framer.link/IB7GbcV\",\"remixUrl\":\"https://framer.link/IB7GbcV\",\"previewUrl\":\"https://estanza.framer.website/\",\"categories\":[{\"id\":19,\"name\":\"Portfolio\",\"slug\":\"portfolio\"},{\"id\":25,\"name\":\"Property\",\"slug\":\"real-estate\"},{\"id\":187,\"name\":\"Architecture\",\"slug\":\"architecture\"},{\"id\":195,\"name\":\"Business Blog\",\"slug\":\"business-blog\"},{\"id\":218,\"name\":\"Free\",\"slug\":\"free-website-templates\"}],\"styles\":[{\"id\":109,\"name\":\"Modern\",\"slug\":\"modern\"},{\"id\":110,\"name\":\"Animated\",\"slug\":\"animated\"},{\"id\":111,\"name\":\"Minimal\",\"slug\":\"minimal\"},{\"id\":236,\"name\":\"Light\",\"slug\":\"light\"}],\"mainCategory\":{\"id\":25,\"name\":\"Property\",\"slug\":\"real-estate\"},\"features\":[{\"id\":1,\"name\":\"Appear Effects\",\"slug\":\"appear-effects\"},{\"id\":18,\"name\":\"Scroll Effects\",\"slug\":\"scroll-effects\"},{\"id\":21,\"name\":\"CMS\",\"slug\":\"cms\"},{\"id\":23,\"name\":\"Rich Media\",\"slug\":\"rich-media\"},{\"id\":30,\"name\":\"Forms\",\"slug\":\"forms\"},{\"id\":32,\"name\":\"Layout Templates\",\"slug\":\"layout-templates\"},{\"id\":35,\"name\":\"Text Effects\",\"slug\":\"text-effects\"},{\"id\":37,\"name\":\"Code Components\",\"slug\":\"code-components\"}]}}},{\"entityType\":\"post\",\"entityId\":\"01a03e58-3176-7273-b58d-a5ef445e871e\",\"entity\":{\"id\":\"01a03e58-3176-7273-b58d-a5ef445e871e\",\"title\":null,\"body\":\"\u003