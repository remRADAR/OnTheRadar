metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.8}}],\"resources\":[],\"contests\":[],\"categories\":[{\"id\":\"cf35162f-8406-49a9-a023-4c58024795ee\",\"name\":\"General\",\"slug\":\"general\",\"description\":\"General\",\"metaTitle\":\"General\",\"metaDescription\":\"General\"}],\"tags\":[],\"likes\":{\"count\":24,\"liked\":false},\"comments\":{\"count\":12},\"reposts\":{\"count\":1,\"reposted\":false,\"repostId\":null},\"version\":1,\"edited\":false,\"editedAt\":null,\"createdAt\":\"2026-08-26T16:31:28.597Z\",\"updatedAt\":\"2026-08-26T16:31:28.597Z\"}},{\"entityType\":\"post\",\"entityId\":\"01a04376-8f34-71cb-a940-503f5c0f689d\",\"entity\":{\"id\":\"01a04376-8f34-71cb-a940-503f5c0f689d\",\"title\":null,\"body\":\"\u003cp\u003eRecent design project. Created an animated background for the section using Midjourney + Codex.\u003c/p\u003e\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Recent design project. Created an animated background for the section using Midjourney + Codex.\"}]}]},\"author\":{\"framerUserId\":\"45c55f9e-cc72-4fee-bd30-059c3f46906c\",\"name\":\"Stacy More\",\"slug\":\"stacymore\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/795390/avatar-zCT1zzbyFssQ9c3PCPzsHSYbf8uD21.jpg\",\"badges\":[\"available\",\"expert\"],\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"video\",\"url\":\"https://stream.mux.com/EPpJDitbxWnMsCyCrDRxoI3IYQ3UKd2UmH01wlkRCcDA.m3u8\",\"metadata\":{\"posterUrl\":\"https://image.mux.com/EPpJDitbxWnMsCyCrDRxoI3IYQ3UKd2UmH01wlkRCcDA/thumbnail.webp?time=3.5\",\"aspectRatio\":\"610:437\",\"duration\":10.6}}],\"resources\":[],\"contests\":[],\"categories\":[{\"id\":\"cf35162f-8406-49a9-a023-4c58024795ee\",\"name\":\"General\",\"slug\":\"general\",\"description\":\"General\",\"metaTitle\":\"General\",\"metaDescription\":\"General\"}],\"tags\":[],\"likes\":{\"count\":18,\"liked\":false},\"comments\":{\"count\":4},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null},\"version\":1,\"edited\":false,\"editedAt\":null,\"createdAt\":\"2026-08-27T13:43:58.521Z\",\"updatedAt\":\"2026-08-27T13:43:58.521Z\"}},{\"entityType\":\"template\",\"entityId\":\"71878\",\"entity\":{\"id\":\"71878\",\"resolved\":true,\"title\":\"Zeeny\",\"body\":\"$52\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"emoji\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer\",\"href\":\"https://zeeny.framer.website/\",\"target\":\"_blank\"}}],\"attrs\":{\"name\":\"arrow_upper_right\",\"emoji\":\"↗\"}},{\"type\":\"text\",\"text\":\" Live preview\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer\",\"href\":\"https://zeeny.framer.website/\",\"target\":\"_blank\"}},{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"emoji\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer\",\"href\":\"https://www.workshop99.agency/templates-landing\",\"target\":\"_blank\"}}],\"attrs\":{\"name\":\"arrow_upper_right\",\"emoji\":\"↗\"}},{\"type\":\"text\",\"text\":\" More Framer templates\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer\",\"href\":\"https://www.workshop99.agency/templates-landing\",\"target\":\"_blank\"}},{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\"},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Zeen · Personal Brand Accelerator Template\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Zeen is a premium, long-form landing page Framer template built for coaches, consultants, founders, and course creators selling a cohort program, accelerator, or high-ticket offer.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Instead of a scattered multi-page site, Zeen is engineered as one persuasive scroll: a high-contrast hero, problem agitation, a phased framework, curriculum modules, a practitioner/tutor lineup, tiered pricing, an application form, and an objection-handling FAQ — all sequenced to move an expert visitor from \\\"undiscovered\\\" to \\\"applied.\\\" Every section is written to sell a program, not just describe one.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"It works just as well for masterminds, workshops, paid communities, and productized coaching — anywhere you need one focused page to fill a cohort.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Launch your accelerator page this week and start taking applications.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"This template is for you if you want to\"}],\"attrs\":{\"level\":1}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Sell a cohort, course, or accelerator with a page structured around problem, framework, and proof\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Fill applications with a focused contact form and repeated, high-intent CTAs\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Present your curriculum clearly with modules and a phased, chronological framework layout\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Build authority with a practitioner/tutor section that positions you as an operator, not a theorist\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Convert with tiered pricing and an FAQ that answers logistics before they cost you the sale\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Create urgency with a countdown to your next cohort's registration deadline\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"What you get:\",\"marks\":[{\"type\":\"bold\"}]}],\"attrs\":{\"level\":1}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Complete single-page accelerator/course sales layout with anchor-linked navigation\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Modular sections: hero, problem, framework, curriculum, tutors, pricing, application form, FAQ, final CTA\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Tiered pricing section with tabbed plan options\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Application/contact form ready to connect to your own tool\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Countdown timer, ready to set to your cohort deadline\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Editorial, high-contrast visual system designed to be re-skinned for any brand\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"CONTACT\",\"marks\":[{\"type\":\"bold\"}]}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Questions? Reach out via \"},{\"type\":\"text\",\"text\":\"x.com\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"http://x.com\",\"target\":\"_blank\"}},{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" or email \"},{\"type\":\"text\",\"text\":\"hello@workshop99.agency\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"mailto:hello@workshop99.agency\",\"target\":\"_blank\"}},{\"type\":\"bold\"}]}]}]},\"introduction\":\"