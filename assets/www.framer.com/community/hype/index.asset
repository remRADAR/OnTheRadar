"content\":[{\"type\":\"text\",\"text\":\"• Modern AI SaaS landing page \"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• AI agent-focused layouts \"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Product and feature sections \"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Use case showcases \"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Integrations section \"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Pricing layouts \"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Blog and CMS-ready structure \"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Responsive design \"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Smooth animations and interactions \"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Reusable components \"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Easy customization \"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• SEO-friendly structure\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Whether you're launching an AI startup, building an AI agent platform, or creating a developer-focused SaaS product, Orbital gives you a polished foundation to launch faster.\"}]}]},\"introduction\":\"AI SaaS template for startups\",\"slug\":\"orbital-website\",\"author\":{\"framerUserId\":\"b2e693cc-f59c-4f8e-bde0-94300933232f\",\"name\":\"Gr8r Themes\",\"slug\":\"get-greater-quality-template-for-you-saas-ai-startup-business\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/29410/256px%20gr8r%20logo%20Orange-nLWk5qudXtDMsXR5C2wZI2mvFAiXwr.jpg\",\"badges\":[\"available\",\"pro\",\"expert\"],\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/b2e69