media\":[{\"type\":\"video\",\"url\":\"https://stream.mux.com/FzrCcaMUDW2spr2xgHCzeaywn801S601zxXN837vYInPA.m3u8\",\"metadata\":{\"posterUrl\":\"https://image.mux.com/FzrCcaMUDW2spr2xgHCzeaywn801S601zxXN837vYInPA/thumbnail.webp?time=14.617\",\"aspectRatio\":\"193:135\",\"duration\":21.216667}}],\"resources\":[],\"contests\":[],\"categories\":[{\"id\":\"cf35162f-8406-49a9-a023-4c58024795ee\",\"name\":\"General\",\"slug\":\"general\",\"description\":\"General\",\"metaTitle\":\"General\",\"metaDescription\":\"General\"}],\"tags\":[],\"likes\":{\"count\":20,\"liked\":false},\"comments\":{\"count\":6},\"reposts\":{\"count\":3,\"reposted\":false,\"repostId\":null},\"version\":1,\"edited\":false,\"editedAt\":null,\"createdAt\":\"2026-08-27T13:43:28.875Z\",\"updatedAt\":\"2026-08-27T13:43:28.875Z\"}},{\"entityType\":\"post\",\"entityId\":\"01a03c83-a6b4-74be-9b95-3a05c9158b8c\",\"entity\":{\"id\":\"01a03c83-a6b4-74be-9b95-3a05c9158b8c\",\"title\":null,\"body\":\"\u003cp\u003eGrab it for free - \u003ca href=\\\"https://framer.link/6d3HZun\\\" rel=\\\"noopener noreferrer nofollow\\\" target=\\\"_blank\\\"\u003ehttps://framer.link/6d3HZun\u003c/a\u003e\u003c/p\u003e\u003cp\u003eMost SaaS templates stop at pricing and testimonials.\u003c/p\u003e\u003cp\u003eChatassist has a career portal.\u003c/p\u003e\u003cp\u003eJob listings, individual detail pages, the whole hiring flow — built into a template.\u003c/p\u003e\u003cp\u003eNobody clicks \u0026quot;Careers\u0026quot; expecting a sale. But a company that\u0026#39;s hiring reads as a company that\u0026#39;s growing. Buyers notice that before they read a single pricing tier.\u003c/p\u003e\u003cp\u003eTrust doesn\u0026#39;t only come from what you say about your product.\u003c/p\u003e\u003cp\u003eSometimes it comes from proof you\u0026#39;re still building it.\u003c/p\u003e\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Grab it for free - \"},{\"type\":\"text\",\"text\":\"https://framer.link/6d3HZun\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"https://framer.link/6d3HZun\",\"target\":\"_blank\"}}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Most SaaS templates stop at pricing and testimonials.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Chatassist has a career portal.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Job listings, individual detail pages, the whole hiring flow — built into a template.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Nobody clicks \\\"Careers\\\" expecting a sale. But a company that's hiring reads as a company that's growing. Buyers notice that before they read a single pricing tier.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Trust doesn't only come from what you say about your product.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Sometimes it comes from proof you're still building it.\"}]}]},\"author\":{\"framerUserId\":\"b2e693cc-f59c-4f8e-bde0-94300933232f\",\"name\":\"Gr8r Themes\",\"slug\":\"get-greater-quality-template-for-you-saas-ai-startup-business\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/29410/256px%20gr8r%20logo%20Orange-nLWk5qudXtDMsXR5C2wZI2mvFAiXwr.jpg\",\"badges\":[\"available\",\"pro\",\"expert\"],\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"video\",\"url\":\"https://stream.mux.com/7a00o4nGeHoixCJjr4mklkm3yt9STnPDT6O02oyvpx11Y.m3u8\",\"metadata\":{\"posterUrl\":\"https://image.mux.com/7a00o4nGeHoixCJjr4mklkm3yt9STnPDT6O02oyvpx11Y/thumbnail.webp?time=6.483\",\"aspectRatio\":\"4:3\",\"duration\":45.921333}}],\"resources\":[],\"contests\":[],\"categories\":[{\"id\":\"cf35162f-8406-49a9-a023-4c58024795ee\",\"name\":\"General\",\"slug\":\"general\",\"description\":\"General\",\"metaTitle\":\"General\",\"metaDescription\":\"General\"}],\"tags\":[],\"likes\":{\"count\":35,\"liked\":false},\"comments\":{\"count\":27},\"reposts\":{\"count\":14,\"reposted\":false,\"repostId\":null},\"version\":1,\"edited\":false,\"editedAt\":null,\"createdAt\":\"2026-08-26T05:20:55.993Z\",\"updatedAt\":\"2026-08-26T05:20:55.993Z\"}},{\"entityType\":\"template\",\"entityId\":\"71840\",\"entity\":{\"id\":\"71840\",\"resolved\":true,\"title\":\"TRBN One\",\"body\":\"$53\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"TRBN One is a cinematic one-page portfolio template for designers, developers, and independent creatives who want their work to feel like a world, not another grid.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Based on a personal portfolio that reached #26 in the Framer Gallery, TRBN One combines atmospheric visuals, editorial typography, and purposeful motion with a clear structure that guides visitors from introduction to contact.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"What’s included\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Responsive desktop, tablet, and mobile layouts\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Image- and video-ready cinematic hero\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• About, services, selected work, process, pricing, and contact sections\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Smooth scrolling and interactive details\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Easily editable typography, colors, media, text, and links\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• No coding required\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Perfect for\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• UI/UX and web designers\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Framer developers\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Art directors and digital artists\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"• Freelancers and independent creatives\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Replace the demonstration content with your own work, connect your domain, and publish directly through Framer.\"}]}]},\"introduction\":\"Dreamlike portfolio for creatives\",\"slug\":\"trbn-one\",\"author\":{\"framerUserId\":\"2b33eac4-4422-4c15-ba75-80a068fa9086\",\"name\":\"Denis Hussle\",\"slug\":\"denis-hussle\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/2b33eac4-4422-4c15-ba75-80a068fa9086/gogz3777\",\"badges\":[\"available\",\"expert\"],\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"video\",\"url\":\"https://stream.mux.com/SzhQFD4DAVb6dQik7TTIZA7o02CJtqKmTZ77bKHrAZ01Q.m3u8\",\"metadata\":{\"posterUrl\":\"https://image.mux.com/SzhQFD4DAVb6dQik7TTIZA7o02CJtqKmTZ77bKHrAZ01Q/thumbnail.webp?time=9.533\",\"aspectRatio\":\"4:3\",\"duration\":76}},{\"type\":\"video\",\"url\":\"https://stream.mux.com/nZKmjn6WCCS00xAHXjODBUrd5A8003NuM7WSYhS701wSQc.m3u8\",\"metadata\":{\"posterUrl\":\"https://image.mux.com/nZKmjn6WCCS00xAHXjODBUrd5A8003NuM7WSYhS701wSQc/thumbnail.webp?time=1.817\",\"aspectRatio\":\"4:3\",\"duration\":21.466667}}],\"post\":{\"id\":\"01a03885-2c08-70ce-9d77-3a669ba9314a\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"My portfolio has been sitting in the top 30 of the Framer Gallery for a while, so I decided to turn it into a template and share it.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"TRBN One is now available.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"$$49 for the first 5 buyers. Then the price goes up to $79.\