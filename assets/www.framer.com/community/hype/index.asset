"slug\":\"variable-fonts\"},{\"id\":41,\"name\":\"Vector Sets\",\"slug\":\"vector-sets\"}]}}},{\"entityType\":\"post\",\"entityId\":\"01a0467f-4cda-770a-a7c1-093bf2fe5c4b\",\"entity\":{\"id\":\"01a0467f-4cda-770a-a7c1-093bf2fe5c4b\",\"title\":null,\"body\":\"\u003cp\u003eTake it free, remix it → \u003ca href=\\\"https://framer.link/KqnqkQC\\\" rel=\\\"noopener noreferrer nofollow\\\" target=\\\"_blank\\\"\u003ehttps://framer.link/KqnqkQC\u003c/a\u003e\u003c/p\u003e\u003cp\u003eFrederock has a badge in the hero that just says \u0026quot;Available for work.\u0026quot;\u003c/p\u003e\u003cp\u003eOne line. Green dot. Nothing else.\u003c/p\u003e\u003cp\u003eMost portfolios make you dig for that answer - scroll to contact, check the footer, guess from the tone. Frederock puts it where the client looks first.\u003c/p\u003e\u003cp\u003eA portfolio\u0026#39;s job isn\u0026#39;t just to show your work. It\u0026#39;s to answer the one question every visitor actually came with: can I hire you right now?\u003c/p\u003e\u003cp\u003eAnswer that in the first three seconds, and the rest of the page just has to not get in the way.\u003c/p\u003e\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Take it free, remix it → \"},{\"type\":\"text\",\"text\":\"https://framer.link/KqnqkQC\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"https://framer.link/KqnqkQC\",\"target\":\"_blank\"}}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Frederock has a badge in the hero that just says \\\"Available for work.\\\"\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"One line. Green dot. Nothing else.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Most portfolios make you dig for that answer - scroll to contact, check the footer, guess from the tone. Frederock puts it where the client looks first.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"A portfolio's job isn't just to show your work. It's to answer the one question every visitor actually came with: can I hire you right now?\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Answer that in the first three seconds, and the rest of the page just has to not get in the way.\"}]}]},\"author\":{\"framerUserId\":\"1364828a-b355-487e-b32f-02641033b191\",\"name\":\"Tanjim Islam\",\"slug\":\"tanjim-islam\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/28885/avatar-ctk9oa9jzfLVvcTdTNu7W0AGiFbWhc.jpg\",\"badges\":[\"available\",\"studio\"],\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/1364828a-b355-487e-b32f-02641033b191/01a0467d-c926-70f4-83a4-3c629e5315a0.png\",\"metadata\":{\"tint\":\"hsl(0 0% 9%)\",\"aspectRatio\":1.3333333333333333}}],\"resources\":[],\"contests\":[],\"categories\":[{\"id\":\"cf35162f-8406-49a9-a023-4c58024795ee\",\"name\":\"General\",\"slug\":\"general\",\"description\":\"General\",\"metaTitle\":\"General\",\"metaDescription\":\"General\"}],\"tags\":[],\"likes\":{\"count\":18,\"liked\":false},\"comments\":{\"count\":14},\"reposts\":{\"count\":9,\"reposted\":false,\"repostId\":null},\"version\":1,\"edited\":false,\"editedAt\":null,\"createdAt\":\"2026-08-28T03:52:23.005Z\",\"updatedAt\":\"2026-08-28T03:52:23.005Z\"}},{\"entityType\":\"post\",\"entityId\":\"01a0474c-03a7-756a-9d54-f8e464e3086e\",\"entity\":{\"id\":\"01a0474c-03a7-756a-9d54-f8e464e3086e\",\"title\":null,\"body\":\"\u003cp\u003edear framer\u003c/p\u003e\u003cp\u003eit it possible to take first frame of video cover for preview?  otherwise it looks not as intended  \u003c/p\u003e\u003cp\u003ecc \u003ca class=\\\"mention\\\" data-type=\\\"mention\\\" data-id=\\\"18e62312-a57d-4b83-bb42-c9ae2ee7e746\\\" href=\\\"/community/creator/@andreu/\\\"\u003e@Andreu\u003c/a\u003e \u003c/p\u003e\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"dear framer\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"it it possible to take first frame of video cover for preview?  otherwise it looks not as intended  \"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"cc \"},{\"type\":\"mention\",\"attrs\":{\"id\":\"18e62312-a57d-4b83-bb42-c9ae2ee7e746\",\"slug\":\"andreu\",\"label\":\"Andreu\",\"mentionSuggestionChar\":\"@\"}},{\"type\":\"text\",\"text\":\" \"}]}]},\"author\":{\"framerUserId\":\"b505b9dc-5fa4-42d6-ad8a-36ea114d98d6\",\"name\":\"Alex Prokhorov\",\"slug\":\"alex-prokhorov\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/30678/photo_2023-08-02%2022.18.40-xybJQiuozIgB2Ywelb9O9kcMEVCmz4.jpeg\",\"badges\":[\"available\",\"studio\"],\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/b505b9dc-5fa4-42d6-ad8a-36ea114d98d6/01a0474b-dc4a-73ea-9713-9d16d70b8d6f.png\",\"metadata\":{\"tint\":\"hsl(0 0% 9%)\",\"aspectRatio\":1.3333333333333333}}],\"resources\":[],\"contests\":[],\"categories\":[{\"id\":\"cf35162f-8406-49a9-a023-4c58024795ee\",\"name\":\"General\",\"slug\":\"general\",\"description\":\"General\",\"metaTitle\":\"General\",\"metaDescription\":\"General\"}],\"tags\":[],\"likes\":{\"count\":13,\"liked\":false},\"comments\":{\"count\":3},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null},\"version\":2,\"edited\":true,\"editedAt\":\"2026-08-28T07:37:07.118Z\",\"createdAt\":\"2026-08-28T07:35:59.160Z\",\"updatedAt\":\"2026-08-28T07:37:07.118Z\"}},{\"entityType\":\"template\",\"entityId\":\"71894\",\"entity\":{\"id\":\"71894\",\"resolved\":true,\"title\":\"Aoutive Website\",\"body\":\"$55\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Aoutive is a Framer template for AI workflow automation platforms, integration tools, and operations SaaS startups. Build a complete product website for a visual workflow builder, an AI decision engine, or a business process automation tool.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"The template uses a modern product aesthetic with a four-part engine section, an infrastructure feature block, five use case cards, stat counters, an integrations section, three-tier pricing, a six-question FAQ, and a CMS articles blog.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"What is Included\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Home, About, Articles, Contact, and legal pages. The homepage includes a hero with a product screenshot, a logo bar, an AI engine section, an infrastructure block, use case cards, stat counters, integrations, pricing, FAQ, and a closing CTA. CMS collections cover Articles and Legal pages, both with detail pages manageable without code.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Key Features\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"The AI engine section covers workflow automation, integrations for CRMs and APIs, data processing, and a decision engine that triggers next actions. The infrastructure block covers high availability with multi-region failover, low-latency execution, edge delivery, a scalable workflow engine, and fault tolerance. Five use case cards cover lead qualification, ticket routing, campaign automation, data sync, and invoice processing. Three pricing tiers cover workflow limits, integrations, monitoring, and enterprise security with SSO.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Who This Is For\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Suited to workflow automation founders, integration platform teams, operations SaaS startups, AI decision engine products, and business process tools targeting sales, support, and operations teams.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Template Details\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Platform Framer, CMS articles and legal collections, engine section, infrastructure block, five use cases, integrations grid, three pricing tiers, six FAQ questions, newsletter signup, fully responsive, no code required, one purchase for unlimited sites.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Aoutive gives workflow automation products a clear website with structured use cases and transparent pricing.\"}]}]},\"introduction\":\"AI Automation SaaS Framer Template\",\"slug\":\"aoutive-website\",\"author\":{\"framerUserId\":\"b2e693cc-f59c-4f8e-bde0-94300933232f\",\"name\":\"Gr8r Themes\",\"slug\":\"get-greater-quality-template-for-you-saas-ai-startup-business\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/29410/256px%20gr8r%20logo%20Orange-nLWk5qudXtDMsXR5C2wZI2mvFAiXwr.jpg\",\"badges\":[\"available\",\"pro\",\"expert\"],\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"video\",\"url\":\"https://stream.mux.com/mDpkzIfSdYIcR02xVa02QGT5FukmZHaDBISS5h8JzUgfs.m3u8\",\"metadata\":{\"posterUrl\":\"https://image.mux.com/mDpkzIfSdYIcR02xVa02QGT5FukmZHaDBISS5h8JzUgfs/thumbnail.webp?time=2.3\",\"aspectRatio\":\"4:3\",\"duration\":32.821333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/b2e693cc-f59c-4f8e-bde0-94300933232f/01a03d62-8b5f-778e-8d73-cd97a964a6d4.png\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/b2e693cc-f59c-4f8e-bde0-94300933232f/01a03d62-899c-735a-bb63-bc5539195222.png\",\"metadata\":{\"tint\":\"hsl(0 0% 58%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/b2e693cc-f59c-4f8e-bde0-94300933232f/01a03d62-896c-77ed-ac0b-7d27e734cdfd.png\",\"metadata\":{\"tint\":\"hsl(0 0% 58%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/b2e693cc-f59c-4f8e-bde0-94300933232f/01a03d62-8c54-72a7-9883-7182eba78727.png\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"01a03d73-07d4-76aa-a02e-479efbc9307c\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Aoutive is live. An AI workflow automation Framer template with a four-part engine section, five use case cards, an integrations grid, and three-tier pricing. Built for automation platforms and operations SaaS startups.\"}]}]},\"likes\":{\"count\":17,\"liked\":false},\"comments\":{\"count\":14},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-08-26T09:42:23.268Z\",\"updatedAt\":\"2026-08-26T09:44:57.318Z\",\"publishedAt\":\"2026-08-26T09:42:23.265Z\",\"featuredAt\":null,\"approvedAt\":null,\"type\":\"template\",\"attributes\":{\"price\":null,\"paymentUrl\":\"https://framer.link/wEs3bz5\",\"remixUrl\":\"https://framer.link/wEs3bz5\",\"previewUrl\":\"https://aoutive.framer.website/\",\"categories\":[{\"id\":2,\"name\":\"SaaS\",\"slug\":\"saas\"},{\"id\":14,\"name\":\"Landing Page\",\"slug\":\"landing-page\"},{\"id\":26,\"name\":\"AI\",\"slug\":\"ai\"},{\"id\":195,\"name\":\"Business Blog\",\"slug\":\"business-blog\"},{\"id\":218,\"name\":\"Free\",\"slug\":\"free-website-templates\"}],\"styles\":[{\"id\":109,\"name\":\"Modern\",\"slug\":\"modern\"},{\"id\":110,\"name\":\"Animated\",\"slug\":\"animated\"},{\"id\":111,\"name\":\"Minimal\",\"slug\":\"minimal\"},{\"id\":228,\"name\":\"Illustrative\",\"slug\":\"illustrative\"}],\"mainCategory\":{\"id\":2,\"name\":\"SaaS\",\"slug\":\"saas\"},\"features\":[{\"id\":1,\"name\":\"Appear Effects\",\"slug\":\"appear-effects\"},{\"id\":18,\"name\":\"Scroll Effects\",\"slug\":\"scroll-effects\"},{\"id\":21,\"name\":\"CMS\",\"slug\":\"cms\"},{\"id\":32,\"name\":\"Layout Templates\",\"slug\":\"layout-templates\"},{\"id\":35,\"name\":\"Text Effects\",\"slug\":\"text-effects\"},{\"id\":36,\"name\":\"3D Transforms\",\"slug\":\"3d-transforms\"},{\"id\":38,\"name\":\"P3 Colors\",\"slug\":\"p3-colors\"},{\"id\":40,\"name\":\"Variable Fonts\",\"slug\":\"variable-fonts\"}]}}},{\"entityType\":\"post\",\"entityId\":\"01a03d08-cb68-73ed-b171-9215eb6cf74e\",\"entity\":{\"id\":\"01a03d08-cb68-73ed-b171-9215eb6cf74e\",\"title\":null,\"body\":\"\u003cp\u003ei had 0 ideas for the hero in the beginning so i designed it at the end after designing the whole website. the day and nighttime image switch was a last minute decision \u0026amp; i LOVE IT!\u003c/p\u003e\u003cp\u003e\u003ca href=\\\"https://shorturl.at/BDz3O\\\" rel=\\\"noopener noreferrer nofollow\\\" target=\\\"_blank\\\"\u003echeck out the template here\u003c/a\u003e, it\u0026#39;s FREE for a few days!\u003c/p\u003e\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"i had 0 ideas for the hero in the beginning so i designed it at the end after designing the whole website. the day and nighttime image switch was a last minute decision \u0026 i LOVE IT!\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"check out the template here\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer\",\"href\":\"https://shorturl.at/BDz3O\",\"target\":\"_blank\"}}]},{\"type\":\"text\",\"text\":\", it's FREE for a few days!\"}]}]},\"author\":{\"framerUserId\":\"84bfe3a9-2969-4b39-9898-af71228ef800\",\"name\":\"syeda fareha\",\"slug\":\"syeda-fareha\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/84bfe3a9-2969-4b39-9898-af71228ef800/345etdj0\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"video\",\"url\":\"https://stream.mux.com/HUbb4wKvDaMqm00z01qJ8RFu02mmacTk3eIKaImW2Y8nPg.m3u8\",\"metadata\":{\"posterUrl\":\"https://image.mux.com/HUbb4wKvDaMqm00z01qJ8RFu02mmacTk3eIKaImW2Y8nPg/thumbnail.webp?time=2.667\",\"aspectRatio\":\"750:449\",\"duration\":5.3}}],\"resources\":[],\"contests\":[],\"categories\":[{\"id\":\"cf35162f-8406-49a9-a023-4c58024795ee\",\"name\":\"General\",\"slug\":\"general\",\"description\":\"General\",\"metaTitle\":\"General\",\"metaDescription\":\"General\"}],\"tags\":[],\"likes\":{\"count\":19,\"liked\":false},\"comments\":{\"count\":11},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null},\"version\":2,\"edited\":true,\"editedAt\":\"2026-08-26T07:47:36.341Z\",\"createdAt\":\"2026-08-26T07:46:21.676Z\",\"updatedAt\":\"2026-08-26T07:47:36.341Z\"}},{\"entityType\":\"post\",\"entityId\":\"01a03c66-777b-70ea-b716-85c42d2e5e0e\",\"entity\":{\"id\":\"01a03c66-777b-70ea-b716-85c42d2e5e0e\",\"title\":null,\"body\":\"\u003cp\u003eFree to remix here → \u003ca href=\\\"https://framer.link/3sNcHAs\\\" rel=\\\"noopener noreferrer nofollow\\\" target=\\\"_blank\\\"\u003ehttps://framer.link/3sNcHAs\u003c/a\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003eA landscaping site with no video of the actual work is just a brochure.\u003c/p\u003e\u003cp\u003eLangard opens with a full-screen video hero, not a static photo.\u003c/p\u003e\u003cp\u003eThen it gets specific → three services, not \u0026quot;design and installation.\u0026quot; Landscape Design. Irrigation System. Seasonal Services. Each one numbered, photographed, named.\u003c/p\u003e\u003cp\u003eTestimonials carry a city, not just a name. \u0026quot;Sarah - Portland\u0026quot; reads as real. \u0026quot;Sarah T.\u0026quot; reads as filler.\u003c/p\u003e\u003cp\u003eLocal businesses don\u0026#39;t need to look impressive. They need to look like they showed up.\u003c/p\u003e\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Free to remix here → \"},{\"type\":\"text\",\"text\":\"https://framer.link/3sNcHAs\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"https://framer.link/3sNcHAs\",\"target\":\"_blank\"}}]}]},{\"type\":\"paragraph\"},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"A landscaping site with no video of the actual work is just a brochure.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Langard opens with a full-screen video hero, not a static photo.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Then it gets specific → three services, not \\\"design and installation.\\\" Landscape Design. Irrigation System. Seasonal Services. Each one numbered, photographed, named.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Testimonials carry a city, not just a name. \\\"Sarah - Portland\\\" reads as real. \\\"Sarah T.\\\" reads as filler.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Local businesses don't need to look impressive. They need to look like they showed up.\"}]}]},\"author\":{\"framerUserId\":\"1364828a-b355-487e-b32f-02641033b191\",\"name\":\"Tanjim Islam\",\"slug\":\"tanjim-islam\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/28885/avatar-ctk9oa9jzfLVvcTdTNu7W0AGiFbWhc.jpg\",\"badges\":[\"available\",\"studio\"],\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"video\",\"url\":\"https://stream.mux.com/3E2irrv00s900F83Bz29cjd2gU02hFJojAlxHXv3Q01wgF00.m3u8\",\"metadata\":{\"posterUrl\":\"https://image.mux.com/3E2irrv00s900F83Bz29cjd2gU02hFJojAlxHXv3Q01wgF00/thumbnail.webp?time=17.85\",\"aspectRatio\":\"4:3\",\"duration\":23.292667}}],\"resources\":[],\"contests\":[],\"categories\":[{\"id\":\"cf35162f-8406-49a9-a023-4c58024795ee\",\"name\":\"General\",\"slug\":\"general\",\"description\":\"General\",\"metaTitle\":\"General\",\"metaDescription\":\"General\"}],\"tags\":[],\"likes\":{\"count\":34,\"liked\":false},\"comments\":{\"count\":26},\"reposts\":{\"count\":13,\"reposted\":false,\"repostId\":null},\"version\":1,\"edited\":false,\"editedAt\":null,\"createdAt\":\"2026-08-26T04:49:03.359Z\",\"updatedAt\":\"2026-08-26T04:49:03.359Z\"}},{\"entityType\":\"template\",\"entityId\":\"71955\",\"entity\":{\"id\":\"71955\",\"resolved\":true,\"title\":\"MenuMaison\",\"body\":\"$56\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Menu Maison — Restaurant Menu \u0026 Reservation Framer Template\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Menu Maison is a menu-focused Framer template for restaurants, cafés, bars, and modern food brands. A CMS-powered food and drinks menu lets visitors filter categories and browse pricing without leaving the page, while a dedicated reservation form collects guest details, date and time, party size, and special requests — all editable from Framer CMS, with no coding required.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Live Preview: \"},{\"type\":\"text\",\"text\":\"https://maisonmenu.framer.website/\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"https://maisonmenu.framer.website/\",\"target\":\"_blank\"}}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Features\"}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"CMS-powered food and drinks menu\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Interactive category filtering\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Dedicated table reservation form with date, time, and party size fields\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Dish photography and clear pricing\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Featured and favourite dishes\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Sticky mobile category filters\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Responsive menu grids across desktop, tablet, and mobile\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Reusable menu cards and components\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Organized layers and CMS collections\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Perfect For\"}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Restaurants and bistros\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Cafés and bakeries\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Pizzerias\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Cocktail bars\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Food trucks\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Catering businesses\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Private chefs\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Seasonal dining concepts\"}]}]}]},{\"type