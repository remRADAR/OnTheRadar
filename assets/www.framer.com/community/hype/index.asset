-studio\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/95ad4a3e-53f4-4780-9aa7-4eb5b20de6a9/fx94z9y4\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/95ad4a3e-53f4-4780-9aa7-4eb5b20de6a9/01a04744-6027-72b8-95c4-2830d2e33413.jpg\",\"metadata\":{\"tint\":\"hsl(30 40% 16%)\",\"aspectRatio\":1.3640238704177323}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/95ad4a3e-53f4-4780-9aa7-4eb5b20de6a9/01a04744-5d33-7384-928f-73e38e880be9.jpg\",\"metadata\":{\"tint\":\"hsl(180 25% 13%)\",\"aspectRatio\":1.3640238704177323}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/95ad4a3e-53f4-4780-9aa7-4eb5b20de6a9/01a04744-6088-7039-b9b8-bb7ac7ff2810.jpg\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3640238704177323}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/95ad4a3e-53f4-4780-9aa7-4eb5b20de6a9/01a04744-60dd-740f-bef6-09ba9422076d.jpg\",\"metadata\":{\"tint\":\"hsl(120 25% 13%)\",\"aspectRatio\":1.3640238704177323}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/95ad4a3e-53f4-4780-9aa7-4eb5b20de6a9/01a04744-6110-700d-90ef-f66528634120.jpg\",\"metadata\":{\"tint\":\"hsl(30 40% 16%)\",\"aspectRatio\":1.5002344116268167}}],\"resources\":[],\"contests\":[],\"categories\":[{\"id\":\"cf35162f-8406-49a9-a023-4c58024795ee\",\"name\":\"General\",\"slug\":\"general\",\"description\":\"General\",\"metaTitle\":\"General\",\"metaDescription\":\"General\"}],\"tags\":[],\"likes\":{\"count\":22,\"liked\":false},\"comments\":{\"count\":5},\"reposts\":{\"count\":1,\"reposted\":false,\"repostId\":null},\"version\":1,\"edited\":false,\"editedAt\":null,\"createdAt\":\"2026-08-28T07:31:14.632Z\",\"updatedAt\":\"2026-08-28T07:31:14.632Z\"}},{\"entityType\":\"template\",\"entityId\":\"71997\",\"entity\":{\"id\":\"71997\",\"resolved\":true,\"title\":\"KORVEX\",\"body\":\"$4e\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Korvex — Branding \u0026 Creative Agency Framer Template\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Korvex is a premium Framer template crafted for branding agencies, creative studios, design teams, and independent creatives who want to showcase their work with confidence, clarity, and a modern visual presence. \"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"More than just a website template, Korvex is a complete platform for showcasing brand identity projects, creative campaigns, web design work, digital experiences, and agency capabilities.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Perfect For\"}],\"attrs\":{\"level\":2}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Branding Agencies\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Creative Studios\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Design Agencies\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Marketing \u0026 Advertising Teams\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"UI/UX Design Studios\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Framer Designers \u0026 Developers\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Creative Freelancers\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Digital Product Agencies\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Startup Branding Teams\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Creative Consultants\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Why Choose Korvex?\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Korvex is built to help agencies communicate their value clearly and professionally. The layout balances aesthetics with usability, ensuring that visitors can easily explore your services, portfolio, case studies, team, and contact information without distractions.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Its flexible structure allows you to customize content, colors, typography, imagery, and sections effortlessly, making it suitable for a wide variety of creative businesses. From showcasing brand transformations and visual identity systems to presenting website projects and creative campaigns, Korvex adapts to your workflow and growth.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Features \u0026 Benefits\"}],\"attrs\":{\"level\":2}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Modern and premium visual design\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Fully responsive across all devices\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Fast-loading and optimized for performance\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Easy customization with Framer\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"