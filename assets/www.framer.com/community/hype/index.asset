\\" target=\\\"_blank\\\"\u003ehttps://framer.link/3XhOSkE\u003c/a\u003e\u003c/p\u003e\u003cp\u003eRestro has a hero for every meal a restaurant serves.\u003c/p\u003e\u003cp\u003eBreakfast. Lunch. Dinner. Separate tabs, separate menus, on the homepage.\u003c/p\u003e\u003cp\u003eMost restaurant templates show one menu and hope it covers the whole day. Restroo assumes a cafe at 8am and a bar at 9pm are two different businesses wearing the same address.\u003c/p\u003e\u003cp\u003eA restaurant doesn\u0026#39;t have one customer. It has three shifts of them.\u003c/p\u003e\u003cp\u003eDesign for the shift, not just the storefront.\u003c/p\u003e\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Take it Free Remix - \"},{\"type\":\"text\",\"text\":\"https://framer.link/3XhOSkE\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"https://framer.link/3XhOSkE\",\"target\":\"_blank\"}}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Restro has a hero for every meal a restaurant serves.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Breakfast. Lunch. Dinner. Separate tabs, separate menus, on the homepage.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Most restaurant templates show one menu and hope it covers the whole day. Restroo assumes a cafe at 8am and a bar at 9pm are two different businesses wearing the same address.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"A restaurant doesn't have one customer. It has three shifts of them.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Design for the shift, not just the storefront.\"}]}]},\"author\":{\"framerUserId\":\"1364828a-b355-487e-b32f-02641033b191\",\"name\":\"Tanjim Islam\",\"slug\":\"tanjim-islam\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/28885/avatar-ctk9oa9jzfLVvcTdTNu7W0AGiFbWhc.jpg\",\"badges\":[\"available\",\"studio\"],\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/1364828a-b355-487e-b32f-02641033b191/01a04206-b034-726c-883b-248558fc9c3f.png\",\"metadata\":{\"tint\":\"hsl(0 0% 3%)\",\"aspectRatio\":1.3333333333333333}}],\"resources\":[],\"contests\":[],\"categories\":[{\"id\":\"cf35162f-8406-49a9-a023-4c58024795ee\",\"name\":\"General\",\"slug\":\"general\",\"description\":\"General\",\"metaTitle\":\"General\",\"metaDescription\":\"General\"}],\"tags\":[],\"likes\":{\"count\":23,\"liked\":false},\"comments\":{\"count\":14},\"reposts\":{\"count\":7,\"reposted\":false,\"repostId\":null},\"version\":1,\"edited\":false,\"editedAt\":null,\"createdAt\":\"2026-08-27T07:03:42.998Z\",\"updatedAt\":\"2026-08-27T07:03:42.998Z\"}},{\"entityType\":\"template\",\"entityId\":\"72026\",\"entity\":{\"id\":\"72026\",\"resolved\":true,\"title\":\"CARFIX TNC\",\"body\":\"$51\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"A garage website has one job before anything else: tell someone what you fix, whether you can look at their car this week, and what happens next. CARFIX TNC is a cars website template for Framer organized around that, with the services and contact routes doing the work rather than the hero image.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"At a glance\"}],\"attrs\":{\"level\":2}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Pages:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" 14 total (8 static, 4 CMS collections, 1 folder)\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"CMS collections:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" blog, category, product and service\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Online store:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" product, cart and checkout pages included as designs. Framer has no native store, so payment runs through a checkout you connect\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Contact form:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" yes\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Responsive:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" desktop, tablet and phone\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Built with:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Framer, no code\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Pages included\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Home, About Us, Blog, Checkout, Contact Us, FAQ, Products and Services, plus template pages for blog, category, product and service, and 404.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"What it does not do\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"It presents your garage and takes inquiries. It does not run a booking diary with technician availability, produce estimates or invoices, look up vehicles by registration, or track jobs through the workshop.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Who it is for\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"CARFIX TNC works best as a cars website template for:\"}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Independent garages and servicing centers taking bookings by inquiry\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Tyre, exhaust and diagnostic specialists with a defined service list\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Workshops that also sell parts or accessories over the counter\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"FAQ\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Can customers book a slot online?\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Not natively. The site takes a booking inquiry and you confirm.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Can I sell parts through the site?\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Yes. Products and checkout are included, so accessories, consumables and parts can be sold directly.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"How do I add a new service?\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Add an entry to the services collection. It gets its own page and appears in the services listing automatically.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Customizing it\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"We can customize this cars website template for you, from color and content through to new pages. \"},{\"type\":\"text\",\"text\":\"Request a quote\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"https://tncflow.com/request-a-quote/\",\"target\":\"_blank\"}},{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" or see our \"},{\"type\":\"text\",\"text\":\"Framer customization service\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer nofollow\",\"href\":\"https://tncflow.com/framer-website-development-customization-service/\",\"target\":\"_blank\"}},{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\". Support and updates are included.\"}]}]},\"introduction\":\"Transportation \u0026 Auto Template\",\"slug\":\"carfix-tnc\",\"author\":{\"framerUserId\":\"d878b21a-352c-4037-963d-18175b40a318\",\"name\":\"TNCFlow\",\"slug\":\"tncflow\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/d878b21a-352c-4037-963d-18175b40a318/q7c0vumk\",\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"video\",\"url\":\"https://stream.mux.com/a86M01dPSCfSPphBR5Il3zx5mnjZnErxtbl9OmsCRQtc.m3u8\",\"metadata\":{\"posterUrl\":\"https://image.mux.com/a86M01dPSCfSPphBR5Il3zx5mnjZnErxtbl9OmsCRQtc/thumbnail.webp?time=8.25\",\"aspectRatio\":\"1439:1080\",\"duration\":17.816667}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/d878b21a-352c-4037-963d-18175b40a318/01a046fe-c0d9-76a7-baad-a15cea09752b.png\",\"metadata\":{\"tint\":\"hsl(60 53% 39%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/d878b21a-352c-4037-963d-18175b40a318/01a046fe-c90b-7642-b4f7-d38bda06993e.png\",\"metadata\":{\"tint\":\"hsl(60 53% 39%)\",\"aspectRatio\":1.3333333333333333}},{\"type\":\"image\",\"url\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/media/d878b21a-352c-4037-963d-18175b40a318/01a046fe-d3f3-7596-afd7-7642cb0f97eb.webp\",\"metadata\":{\"tint\":\"hsl(60 53% 39%)\",\"aspectRatio\":1.3333333333333333}}],\"post\":{\"id\":\"01a046ff-4755-7479-84bb-684f7e1cd06e\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"CARFIX TNC is a cars website template built in Framer, made for independent garages and servicing centers taking bookings by inquiry. It ships 14 pages with 4 Framer CMS collections covering blog, category, product and service, so the parts that change often are edited as entries rather than rebuilt. Notable: services are a CMS collection, not a fixed list.\"}]}]},\"likes\":{\"count\":10,\"liked\":false},\"comments\":{\"count\":1},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null}},\"createdAt\":\"2026-08-28T06:12:09.159Z\",\"updatedAt\":\"2026-08-28T06:12:09.159Z\",\"publishedAt\":\"2026-08-28T06:12:09.153Z\",\"featuredAt\":null,\"approvedAt\":null,\"type\":\"template\",\"attributes\":{\"price\":\"79\",\"paymentUrl\":\"https://tncflow.com/checkout/?edd_action=add_to_cart\u0026download_id=247813\u0026edd_options%5Bprice_id%5D=4\",\"remixUrl\":null,\"previewUrl\":\"https://carfix.framer.website/\",\"categories\":[{\"id\":11,\"name\":\"Ecommerce\",\"slug\":\"ecommerce\"},{\"id\":196,\"name\":\"Car \u0026 Auto\",\"slug\":\"car-and-auto\"},{\"id\":211,\"name\":\"Electronics\",\"slug\":\"electronics\"}],\"styles\":[{\"id\":111,\"name\":\"Minimal\",\"slug\":\"minimal\"},{\"id\":236,\"name\":\"Light\",\"slug\":\"light\"}],\"mainCategory\":{\"id\":248,\"name\":\"Services\",\"slug\":\"professional-services\"},\"features\":[{\"id\":1,\"name\":\"Appear Effects\",\"slug\":\"appear-effects\"},{\"id\":9,\"name\":\"Overlays \u0026 Modals\",\"slug\":\"overlays-modals\"},{\"id\":13,\"name\":\"Slideshows/Tickers\",\"slug\":\"slideshows-tickers\"},{\"id\":17,\"name\":\"Sticky Scrolling\",\"slug\":\"sticky-scrolling\"},{\"id\":18,\"name\":\"Scroll Effects\",\"slug\":\"scroll-effects\"},{\"id\":21,\"name\":\"CMS\",\"slug\":\"cms\"},{\"id\":23,\"name\":\"Rich Media\",\"slug\":\"rich-media\"},{\"id\":24,\"name\":\"Site Search\",\"slug\":\"site-search\"},{\"id\":25,\"name\":\"Custom Cursors\",\"slug\":\"custom-cursors\"},{\"id\":30,\"name\":\"Forms\",\"slug\":\"forms\"},{\"id\":32,\"name\":\"Layout Templates\",\"slug\":\"layout-templates\"},{\"id\":35,\"name\":\"Text Effects\",\"slug\":\