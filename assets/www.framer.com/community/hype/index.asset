-cc72-4fee-bd30-059c3f46906c/01a03ceb-97a4-76da-bc5c-785b2965d201.png\",\"metadata\":{\"tint\":\"hsl(0 0% 57%)\",\"aspectRatio\":2.076642335766423}}],\"resources\":[],\"contests\":[],\"categories\":[{\"id\":\"cf35162f-8406-49a9-a023-4c58024795ee\",\"name\":\"General\",\"slug\":\"general\",\"description\":\"General\",\"metaTitle\":\"General\",\"metaDescription\":\"General\"}],\"tags\":[],\"likes\":{\"count\":19,\"liked\":false},\"comments\":{\"count\":4},\"reposts\":{\"count\":0,\"reposted\":false,\"repostId\":null},\"version\":1,\"edited\":false,\"editedAt\":null,\"createdAt\":\"2026-08-26T07:14:42.512Z\",\"updatedAt\":\"2026-08-26T07:14:42.512Z\"}},{\"entityType\":\"template\",\"entityId\":\"71727\",\"entity\":{\"id\":\"71727\",\"resolved\":true,\"title\":\"Dentelio\",\"body\":\"$57\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Dentelio — Modern Dental Framer Template\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Dentelio is a modern, premium Framer template crafted for dental clinics, dentists, orthodontists, cosmetic dentistry, and healthcare brands. It combines a clean editorial layout with bold typography, smooth animations, micro-interactions, and conversion-focused sections to create a polished digital experience.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Designed with a strong focus on modern UI and user experience, Dentelio uses spacious layouts, refined typography, subtle motion effects, interactive elements, and carefully structured sections to make every scroll feel engaging and professional.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"✦ What’s Included\"}],\"attrs\":{\"level\":2}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Modern Home page\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"About page\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Services page\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Doctors page\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Gallery page\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Blog page\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Contact / Appointment page\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Responsive desktop, tablet \u0026 mobile layouts\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Smooth animations \u0026 micro-interactions\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Interactive hover effects\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Modern scrolling effects\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Reusable components\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"CMS-ready content structure\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Blog CMS\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Doctor \u0026 service sections\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Testimonials\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"FAQ section\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Appointment-focused CTAs\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"SEO-friendly structure\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"✦ Modern Homepage Experience\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"The homepage features a bold hero, services, clinic statistics, interactive gallery, treatment process, specialist profiles, benefits, testimonials, FAQs, and strong appointment CTAs. Every section is balanced with whitespace, imagery, typography, and subtle motion for a clean and engaging experience.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"✦ CMS \u0026 Easy Customization\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Dentelio is built with reusable and flexible content in mind. Easily update services, doctors, blog posts, images, testimonials, colors, typography, and branding directly in Framer.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"✦ Built for Modern Dental Brands\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Dentelio brings together modern layouts, smooth effects, micro-interactions, responsive design, CMS flexibility, and conversion-focused sections in one premium Framer template.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Create a dental website that feels clean, modern, trustworthy, and memorable — without starting from scratch.\"}]}]},\"introduction\":\"Dentelio — Modern Dental Care, Mad\",\"slug\":\"dentelio\",\"author\":{\"framerUserId\":\"df0aeab2-687e-4760-b481-3d63c5122d53\",\"name\":\"Modex Studio\",\"slug\":\"modex-studio\",\"avatar\":\"https://y4pdgne