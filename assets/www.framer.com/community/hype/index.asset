aragraph\",\"content\":[{\"type\":\"text\",\"text\":\"It says lead qualification. Ticket routing. Campaign automation. Data sync. Invoice processing.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Five named jobs, not one vague promise.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"\\\"Automate your workflows\\\" could mean anything, so it convinces no one. Name the exact task someone hates doing, and they see themselves in it immediately.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Specific beats impressive, every time.\"}]}]},\"author\":{\"framerUserId\":\"1364828a-b355-487e-b32f-02641033b191\",\"name\":\"Tanjim Islam\",\"slug\":\"tanjim-islam\",\"avatar\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/creators/28885/avatar-ctk9oa9jzfLVvcTdTNu7W0AGiFbWhc.jpg\",\"badges\":[\"available\",\"studio\"],\"followed\":false,\"followsYou\":false},\"media\":[{\"type\":\"video\",\"url\":\"https://stream.mux.com/E00DNPWBvp02TPdv777DsPG7j7kaWAxlfO6y167X00U3og.m3u8\",\"metadata\":{\"posterUrl\":\"https://image.mux.com/E00DNPWBvp02TPdv777DsPG7j7kaWAxlfO6y167X00U3og/thumbnail.webp?time=2.3\",\"aspectRatio\":\"4:3\",\"duration\":32.821333}}],\"resources\":[],\"contests\":[],\"categories\":[{\"id\":\"cf35162f-8406-49a9-a023-4c58024795ee\",\"name\":\"General\",\"slug\":\"general\",\"description\":\"General\",\"metaTitle\":\"General\",\"metaDescription\":\"General\"}],\"tags\":[],\"likes\":{\"count\":26,\"liked\":false},\"comments\":{\"count\":12},\"reposts\":{\"count\":11,\"reposted\":false,\"repostId\":null},\"version\":1,\"edited\":false,\"editedAt\":null,\"createdAt\":\"2026-08-26T13:18:29.083Z\",\"updatedAt\":\"2026-08-26T13:18:29.083Z\"}},{\"entityType\":\"post\",\"entityId\":\"01a02e31-979b-73ef-93aa-e8b8d25d6ab2\",\"entity\":{\"id\":\"01a02e31-979b-73ef-93aa-e8b8d25d6ab2\",\"title\":null,\"body\":\"\u003cp\u003e\u003ca href=\\\"https://tinyurl.com/59mxjxcb\\\" rel=\\\"noopener noreferrer