u003e\u003cp\u003e24-hour email support\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eLifetime updates\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch3\u003eWhy Choose Kima\u003c/h3\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eEasy customization\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFully responsive\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCMS collection for projects\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSleek masonry grid\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eDark/Light theme\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSEO optimized\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePerformance optimized\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cfigure\u003e\u003cimg src=\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/templates/58971-kima-PIOtMWUc2BCllATe4YG8TDS1krbAD5\" alt=\"\" /\u003e\u003c/figure\u003e\u003ch3\u003eContact\u003c/h3\u003e\u003cp\u003eFeel free to reach out if you have any questions: \u003ca href=\"mailto:thaerswailem@gmail.com\"\u003ethaerswailem@gmail.com\u003c/a\u003e\u003c/p\u003e51:[\"$\",\"section\",null,{\"className\":\"section-card-module-scss-module__pvNjWq__root\",\"children\":[[\"$\",\"div\",null,{\"className\":\"section-card-module-scss-module__pvNjWq__header\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"typography-module-scss-module__cYy7za__h4 section-card-module-scss-module__pvNjWq__title\",\"children\":\"Trending Templates\"}],[\"$\",\"$L55\",null,{\"href\":\"/marketplace/templates/\",\"className\":\"typography-module-scss-module__cYy7za__bodyS trending-templates-module-scss-module__e9YJZW__seeAll\",\"children\":\"See all\"}]]}],[\"$\",\"div\",null,{\"className\":\"section-card-module-scss-module__pvNjWq__content\",\"children\":[[\"$\",\"$L56\",\"58971\",{\"resource\":{\"id\":\"58971\",\"resolved\":true,\"title\":\"Kima\",\"body\":\"$57\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\"