,\"slug\":\"appear-effects\"},{\"id\":7,\"name\":\"Light \u0026 Dark Theme\",\"slug\":\"light-dark-theme\"},{\"id\":17,\"name\":\"Sticky Scrolling\",\"slug\":\"sticky-scrolling\"},{\"id\":18,\"name\":\"Scroll Effects\",\"slug\":\"scroll-effects\"},{\"id\":21,\"name\":\"CMS\",\"slug\":\"cms\"},{\"id\":41,\"name\":\"Vector Sets\",\"slug\":\"vector-sets\"}]}},\"index\":0}],\"$L58\",\"$L59\",\"$L5a\",\"$L5b\"]}]]}]\n2b:92367\n2a:92322\n40:[\"$\",\"$L5c\",null,{\"seed\":{\"status\":\"unauthenticated\"}}]\n4e:null\n52:null\n7:{\"session\":null,\"channel\":\"stable\",\"hasControlsAccess\":false,\"experimentState\":{\"resourceReviewRequests\":false,\"readOnlyDashboard\":true,\"socialFeed\":true,\"recentsTab\":false,\"quality\":false,\"reposts\":true,\"tutorials\":false,\"creatorStats\":false,\"galleryLanding\":false,\"postTags\":false,\"welcomeCard\":false,\"weightedExpertRanking\":true}}\n3b:[\"$\",\"$L5d\",null,{\"categoryLinks\":{\"site\":[{\"icon\":\"flag\",\"label\":\"Agency\",\"slug\":\"agency\",\"href\":\"/community/gallery/categories/agency/\"},{\"icon\":\"sparkle\",\"label\":\"AI\",\"slug\":\"ai\",\"href\":\"/community/gallery/categories/ai/\"},{\"icon\":\"article\",\"label\":\"Blog\",\"slug\":\"blog\",\"href\":\"/community/gallery/categories/blog/\"},{\"icon\":\"chart\",\"label\":\"Business\",\"slug\":\"business\",\"href\":\"/community/gallery/categories/business/\"},{\"icon\":\"globe\",\"label\":\"Community\",\"slug\":\"community\",\"href\":\"/community/gallery/categories/community/\"},{\"icon\":\"card\",\"label\":\"Ecommerce\",\"slug\":\"ecommerce\",\"href\":\"/community/gallery/categories/ecommerce/\"},{\"icon\":\"play\",\"label\":\"Education\",\"slug\":\"education\",\"href\":\"/community/gallery/categories/education/\"},{\"icon\":\"template\",\"label\":\"Landing Page\",\"slug\":\"landing-page\",\"href\":\"/community/gallery/categories/landing-page/\"},{\"icon\":\"user\",\"label\":\"Personal\",\"slug\":\"personal\",\"href\":\"/community/gallery/categories/personal/\"},{\"icon\":\"images\",\"label\":\"Portfolio\",\"slug\":\"portfolio\",\"href\":\"/community/gallery/categories/portfolio/\"},{\"icon\":\"suitcase\",\"label\":\"Real Estate\",\"slug\":\"real-estate\",\"href\":\"/community/gallery/categories/real-estate/\"},{\"icon\":\"carrot\",\"label\":\"Restaurant\",\"slug\":\"restaurant\",\"href\":\"/community/gallery/categories/restaurant/\"},{\"icon\":\"computer\",\"label\":\"SaaS\",\"slug\":\"saas\",\"href\":\"/community/gallery/categories/saas/\"},{\"icon\":\"pin\",\"label\":\"Travel\",\"slug\":\"travel\",\"href\":\"/community/gallery/categories/travel/\"}]},\"profileSlug\":\"$undefined\"}]\n5e:T777,\u003ch2\u003eSWAG — A portfolio that does the talking for you\u003c/h2\u003e\u003cp\u003eSWAG is a minimal Framer portfolio template built for designers, artists, and creatives who want their work seen, not their website noticed.\u003c/p\u003e\u003cp\u003eClean layout. Grid based. No noise. Just your projects on a stage that gets out of the way.\u003c/p\u003e\u003ch3\u003eWhat makes SWAG different?\u003c/h3\u003e\u003cp\u003eIt\u0026#39;s not just a template. It\u0026#39;s a full portfolio system built to flex across creative disciplines.\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eMinimal grid design: a clean layout that puts your work first, nothing competing for attention.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eBuilt for any creative field: works for designers, artists, agencies, photographers, whoever needs to show visual work.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCMS powered showcase: manage your projects through a built in CMS. Add, edit, or remove work without touching code.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eLight theme: a bright, minimal look that keeps focus on the work.\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSEO ready and fast: built on Framer for clean structure and quick load times.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2\u003e\u003cstrong\u003eFree customization tutorial\u003c/strong\u003e\u003c/h2\u003e\u003cp\u003eEvery purchase includes a full walkthrough video, hosted right on my website. It walks you through customizing every part of the template, connecting your own domain, and publishing your site, so you\u0026#39;re never stuck figuring things out on your own.\u003c/p\u003e\u003cp\u003eClick here to access \u003ca href=\"https://titarvldesign.framer.website/works/swag\" rel=\"noopener noreferrer nofollow\" target=\"_blank\"\u003eFree Customization Tutorial\u003c/a\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003ch3\u003ePages included\u003c/h3\u003e\u003cp\u003eCore pages\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eHome\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eWork (CMS)\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAbout\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eContact\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e404\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePolicies\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eFeatures used\u003c/strong\u003e 3D Transforms, Appear Effects, CMS, Code Components, Custom Cursors, Forms, Layout Templates, Scroll Effects, Selection Styles, Slideshows/Tickers, Sticky Scrolling, Text Effects, Variable Fonts\u003c/p\u003e58:[\"$\",\"$L56\",\"69668\",{\"resource\":{\"id\":\"69668\",\"resolved\":true,\"title\":\"SWAG\",\"body\":\"$5e\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"SWAG — A portfolio that does the talking for you\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"SWAG is a minimal Framer portfolio template built for designers, artists, and creatives who want their work seen, not their website noticed.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Clean layout. Grid based. No noise. Just your projects on a stage that gets out of the way.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"What makes SWAG different?\"}],\"attrs\":{\"level\":2}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"It's not just a template. It's a full portfolio system built to flex across creative disciplines.\"}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Minimal grid design: a clean layout that puts your work first, nothing competing for attention.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Built for any creative field: works for designers, artists, agencies, photographers, whoever needs to show visual work.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"CMS powered showcase: manage your projects through a built in CMS. Add, edit, or remove work without touching code.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Light theme: a bright, minimal look that keeps focus on the work.\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"SEO ready and fast: built on Framer for clean structure and quick load times.\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Free customization tutorial\",\"marks\":[{\"type\":\"bold\"}]}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Every purchase includes a full walkthrough video, hosted right on my website. It walks you through customizing every part of the template, connecting your own domain, and publishing your site, so you're never stuck figuring things out on your own.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Click here to access \"},{\"type\":\"text\