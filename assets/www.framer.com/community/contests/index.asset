folio\",\"slug\":\"portfolio\"},{\"id\":188,\"name\":\"Art \u0026 Design\",\"slug\":\"art-and-design\"},{\"id\":14,\"name\":\"Landing Page\",\"slug\":\"landing-page\"},{\"id\":221,\"name\":\"Graphic Design\",\"slug\":\"graphic-design\"},{\"id\":218,\"name\":\"Free\",\"slug\":\"free-website-templates\"}],\"styles\":[{\"id\":247,\"name\":\"Professional\",\"slug\":\"professional\"},{\"id\":110,\"name\":\"Animated\",\"slug\":\"animated\"}],\"mainCategory\":{\"id\":19,\"name\":\"Portfolio\",\"slug\":\"portfolio\"},\"features\":[{\"id\":1,\"name\":\"Appear Effects\",\"slug\":\"appear-effects\"},{\"id\":9,\"name\":\"Overlays \u0026 Modals\",\"slug\":\"overlays-modals\"},{\"id\":13,\"name\":\"Slideshows/Tickers\",\"slug\":\"slideshows-tickers\"},{\"id\":18,\"name\":\"Scroll Effects\",\"slug\":\"scroll-effects\"},{\"id\":21,\"name\":\"CMS\",\"slug\":\"cms\"},{\"id\":23,\"name\":\"Rich Media\",\"slug\":\"rich-media\"},{\"id\":25,\"name\":\"Custom Cursors\",\"slug\":\"custom-cursors\"},{\"id\":30,\"name\":\"Forms\",\"slug\":\"forms\"},{\"id\":32,\"name\":\"Layout Templates\",\"slug\":\"layout-templates\"},{\"id\":35,\"name\":\"Text Effects\",\"slug\":\"text-effects\"},{\"id\":37,\"name\":\"Code Components\",\"slug\":\"code-components\"},{\"id\":39,\"name\":\"Selection Styles\",\"slug\":\"selection-styles\"},{\"id\":41,\"name\":\"Vector Sets\",\"slug\":\"vector-sets\"}]}},\"index\":0}],\"$L58\",\"$L59\",\"$L5a\",\"$L5b\"]}]]}]\n2b:92367\n2a:92322\n40:[\"$\",\"$L5c\",null,{\"seed\":{\"status\":\"unauthenticated\"}}]\n4e:null\n52:null\n7:{\"session\":null,\"channel\":\"stable\",\"hasControlsAccess\":false,\"experimentState\":{\"resourceReviewRequests\":false,\"readOnlyDashboard\":true,\"socialFeed\":true,\"recentsTab\":false,\"quality\":false,\"reposts\":true,\"tutorials\":false,\"creatorStats\":false,\"galleryLanding\":false,\"postTags\":false,\"welcomeCard\":false,\"weightedExpertRanking\":true}}\n3b:[\"$\",\"$L5d\",null,{\"categoryLinks\":{\"site\":[{\"icon\":\"flag\",\"label\":\"Agency\",\"slug\":\"agency\",\"href\":\"/community/gallery/categories/agency/\"},{\"icon\":\"sparkle\",\"label\":\"AI\",\"slug\":\"ai\",\"href\":\"/community/gallery/categories/ai/\"},{\"icon\":\"article\",\"label\":\"Blog\",\"slug\":\"blog\",\"href\":\"/community/gallery/categories/blog/\"},{\"icon\":\"chart\",\"label\":\"Business\",\"slug\":\"business\",\"href\":\"/community/gallery/categories/business/\"},{\"icon\":\"globe\",\"label\":\"Community\",\"slug\":\"community\",\"href\":\"/community/gallery/categories/community/\"},{\"icon\":\"card\",\"label\":\"Ecommerce\",\"slug\":\"ecommerce\",\"href\":\"/community/gallery/categories/ecommerce/\"},{\"icon\":\"play\",\"label\":\"Education\",\"slug\":\"education\",\"href\":\"/community/gallery/categories/education/\"},{\"icon\":\"template\",\"label\":\"Landing Page\",\"slug\":\"landing-page\",\"href\":\"/community/gallery/categories/landing-page/\"},{\"icon\":\"user\",\"label\":\"Personal\",\"slug\":\"personal\",\"href\":\"/community/gallery/categories/personal/\"},{\"icon\":\"images\",\"label\":\"Portfolio\",\"slug\":\"portfolio\",\"href\":\"/community/gallery/categories/portfolio/\"},{\"icon\":\"suitcase\",\"label\":\"Real Estate\",\"slug\":\"real-estate\",\"href\":\"/community/gallery/categories/real-estate/\"},{\"icon\":\"carrot\",\"label\":\"Restaurant\",\"slug\":\"restaurant\",\"href\":\"/community/gallery/categories/restaurant/\"},{\"icon\":\"computer\",\"label\":\"SaaS\",\"slug\":\"saas\",\"href\":\"/community/gallery/categories/saas/\"},{\"icon\":\"pin\",\"label\":\"Travel\",\"slug\":\"travel\",\"href\":\"/community/gallery/categories/travel/\"}]},\"profileSlug\":\"$undefined\"}]\n5e:Tb4f,\u003cp\u003e\u003ca href=\"https://span.framer.ai\" rel=\"noopener noreferrer nofollow\" target=\"_blank\"\u003eOpen Live Demo\u003c/a\u003e\u003c/p\u003e\u003cp\u003eIn a world where launching an AI SaaS is getting easier and easier, the challenge is no longer building a product, but getting people to notice it, understand it, and try it. The solution is a website that explains your product clearly and the knowledge to outperform competitors who have a product but no customers.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003ePages:\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eHome\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAbout\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eUpdates (CMS)\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003ePricing\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eCareers (CMS)\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eBlog (CMS)\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eWaitlist\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eContact\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eLegal (CMS)\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003e404\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003eSpan combines the key elements needed to launch an AI SaaS:\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eWebsite Template:\u003c/strong\u003e An easily customizable AI SaaS website template with 13 responsive pages to showcase your product in the best way. A Waitlist page is also included if you haven’t launched yet.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e30-Day Launch Plan:\u003c/strong\u003e Instead of guessing what to do next, I built a clear plan that takes you from validating your product idea to launching it with proof of demand from real users.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eResearch Guides:\u003c/strong\u003e 7 visual research guides on what worked for other founders and why, with each guide designed to be understood in under 5 minutes. Topics:\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eIdea \u0026amp; Validation\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eOffer \u0026amp; Positioning\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eLanding Page Conversion\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eTrust \u0026amp; Credibility\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eTraffic \u0026amp; Distribution\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFirst Revenue\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eFailure Patterns\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eTemplates \u0026amp; Assets:\u003c/strong\u003e Research-backed launch assets to help you get customers and skip months of trial and error. These include:\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eSocial Post Templates\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAd Templates\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eWebsite Optimization: AI prompts for Framer Agent to generate website copy\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eOutreach Templates\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eVisual Assets\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003ePerfect for:\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eAI SaaS \u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAI Startup \u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAI Agent \u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAI Automation \u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAI Productivity \u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAI Marketing \u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAI Sales \u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAI Developer Tool \u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAI Customer Support \u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAI Analytics \u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAI Workflow \u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAI Writing \u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAI Content \u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAI Research \u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAI B2B SaaS \u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSaaS Startup \u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSaaS MVP \u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eMicro SaaS \u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eIndie Hacker \u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSaaS Founder\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003eSpan\u0026#39;s core goal is to help AI SaaS founders figure out how to present your product and actually get people to try it.\u003c/p\u003e\u003cp\u003eIf you have any questions, reach out to me: \u003ca href=\"mailto:davetheartwarrior@gmail.com\"\u003edavetheartwarrior@gmail.com\u003c/a\u003e\u003c/p\u003e58:[\"$\",\"$L56\",\"71253\",{\"resource\":{\"id\":\"71253\",\"resolved\":true,\"title\":\"Span™\",\"body\":\"$5e\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Open Live Demo\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer\",\"href\":\"https://span.framer.ai\",\"target\":\"_blank\"}}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"In a world where launching an AI SaaS is getting easier and easier, the challenge is no longer building a product, but getting people to notice it, understand it, and try it. The solution is a website that explains your product clearly and the knowledge to outperform competitors who have a product but no customers.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Pages:\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Home\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"About\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Updates (CMS)\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Pricing\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Careers (CMS)\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Blog (CMS)\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Waitlist\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Contact\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Legal (CMS)\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"404\"}]}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Span combines the key elements needed to launch an AI SaaS:\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Website Template:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" An easily customizable AI SaaS website template with 13 responsive pages to showcase your product in the best way. A Waitlist page is also included if you haven’t launched yet.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"30-Day Launch Plan:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" Instead of guessing what to do next, I built a clear plan that takes you from validating your product idea to launching it with proof of demand from real users.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Research Guides:\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"text\",\"text\":\" 7 visual research guides on what worked for other founders and why, with each guide designed to be understood in under 5 minutes. Topics:\"}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"