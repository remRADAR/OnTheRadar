6bd2_9eh.js\",\"/creators-assets/_next/static/immutable/chunks/2rwbpl35w01v4.js\",\"/creators-assets/_next/static/immutable/chunks/19-jcjdymr-fa.js\",\"/creators-assets/_next/static/immutable/chunks/19r4rf2zyng-y.js\",\"/creators-assets/_next/static/immutable/chunks/1p31g3z3kho5v.js\",\"/creators-assets/_next/static/immutable/chunks/2qeyp4zfa4qwb.js\",\"/creators-assets/_next/static/immutable/chunks/3sj_xp-v1_jxx.js\",\"/creators-assets/_next/static/immutable/chunks/2njnkxjf39nsf.js\",\"/creators-assets/_next/static/immutable/chunks/0ph1ht6wvel_v.js\",\"/creators-assets/_next/static/immutable/chunks/2zfre20tirh12.js\",\"/creators-assets/_next/static/immutable/chunks/05i2jce8amocn.js\",\"/creators-assets/_next/static/immutable/chunks/0v-er0xp5q011.js\",\"/creators-assets/_next/static/immutable/chunks/43-2_mojmsou8.js\",\"/creators-assets/_next/static/immutable/chunks/3jvwfw465qqmy.js\",\"/creators-assets/_next/static/immutable/chunks/2f7pw7tsjdcfj.js\"],\"TopBarDynamic\"]\n57:T94b,\u003cp\u003e\u003ca href=\"https://launchfolio.framer.website/?utm_source=framer\" rel=\"noopener noreferrer nofollow\" target=\"_blank\"\u003eLive Preview\u003c/a\u003e\u003c/p\u003e\u003ch2\u003eLaunchfolio: A portfolio template that helps designers land more clients.\u003c/h2\u003e\u003cp\u003eBuilt after studying dozens of successful design businesses, this template helps you launch your design business in days, not months.\u003c/p\u003e\u003ch2\u003eBuilt for Conversion\u003c/h2\u003e\u003cp\u003eEvery section is strategically placed to guide potential clients toward hiring you. From projects to testimonials, each element builds trust and encourages action. It\u0026#39;s completely customizable. The minimal design means you can adapt it to your style without breaking what makes it convert.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eWhy most design portfolios fail to convert:\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eToo focused on aesthetics over conversion\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eMissing key trust-building elements\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eNo clear user journey. This template solves all of that.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2\u003eFlexible Image System\u003c/h2\u003e\u003cp\u003eThe multi-reference approach lets you create side-by-side comparisons, and add custom descriptions to explain your process—all without modifying the template structure.\u003c/p\u003e\u003ch3\u003e12/7/25* Image system now supports video file uploads\u003c/h3\u003e\u003ch2\u003eBlog\u003c/h2\u003e\u003cp\u003eIncludes category filters and search\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e2/19/26\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eThis template has been updated to support Framers new dynamic filters\u003c/p\u003e\u003cfigure\u003e\u003cimg src=\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/templates/48356-launchnow-q6sjU0smD4uPwuj0KoOOvfaD4DG5nM\" alt=\"\" /\u003e\u003c/figure\u003e\u003ch2\u003eProfessional Quote Generation\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eInclude detailed project briefs\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eProfessional terms and conditions\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eAutomatically calculates subtotal , vat, and grand total based off line item entries.\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003cfigure\u003e\u003cimg src=\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/templates/48356-launchnow-WTRCSrrNxlMa7Ok0vu17G0K8mjuuII\" alt=\"\" /\u003e\u003c/figure\u003e\u003ch2\u003eBuilt for Real Use\u003c/h2\u003e\u003cul\u003e\u003cli\u003e\u003cp\u003eClean, minimal design that adapts to your style\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eMobile-optimized viewing\u003c/p\u003e\u003c/li\u003e\u003cli\u003e\u003cp\u003eSEO-friendly structure\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2\u003eReal talk: Most designers spend weeks (or months) building their portfolio...and still end up with something that doesn\u0026#39;t convert visitors into clients. Why start from scratch when you can build in days with a template that\u0026#39;s designed to help you win more clients.\u003c/h2\u003e51:[\"$\",\"section\",null,{\"className\":\"section-card-module-scss-module__pvNjWq__root\",\"children\":[[\"$\",\"div\",null,{\"className\":\"section-card-module-scss-module__pvNjWq__header\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"typography-module-scss-module__cYy7za__h4 section-card-module-scss-module__pvNjWq__title\",\"children\":\"Trending Templates\"}],[\"$\",\"$L55\",null,{\"href\":\"/marketplace/templates/\",\"className\":\"typography-module-scss-module__cYy7za__bodyS trending-templates-module-scss-module__e9YJZW__seeAll\",\"children\":\"See all\"}]]}],[\"$\",\"div\",null,{\"className\":\"section-card-module-scss-module__pvNjWq__content\",\"children\":[[\"$\",\"$L56\",\"48356\",{\"resource\":{\"id\":\"48356\",\"resolved\":true,\"title\":\"LaunchFolio\",\"body\":\"$57\",\"bodyJson\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Live Preview\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"rel\":\"noopener noreferrer\",\"href\":\"https://launchfolio.framer.website/?utm_source=framer\",\"target\":\"_blank\"}}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Launchfolio: A portfolio template that helps designers land more clients.\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Built after studying dozens of successful design businesses, this template helps you launch your design business in days, not months.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Built for Conversion\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Every section is strategically placed to guide potential clients toward hiring you. From projects to testimonials, each element builds trust and encourages action. It's completely customizable. The minimal design means you can adapt it to your style without breaking what makes it convert.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Why most design portfolios fail to convert:\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Too focused on aesthetics over conversion\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Missing key trust-building elements\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"No clear user journey. This template solves all of that.\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Flexible Image System\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"The multi-reference approach lets you create side-by-side comparisons, and add custom descriptions to explain your process—all without modifying the template structure.\"}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"12/7/25* Image system now supports video file uploads\"}],\"attrs\":{\"level\":2}},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Blog\"}],\"attrs\":{\"level\":1}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Includes category filters and search\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"2/19/26\",\"marks\":[{\"type\":\"bold\"}]}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"This template has been updated to support Framers new dynamic filters\"}]},{\"type\":\"customImage\",\"attrs\":{\"alt\":\"\",\"src\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/templates/48356-launchnow-q6sjU0smD4uPwuj0KoOOvfaD4DG5nM\",\"link\":null,\"caption\":\"\",\"uploadId\":null}},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Professional Quote Generation\"}],\"attrs\":{\"level\":1}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Include detailed project briefs\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Professional terms and conditions\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Automatically calculates subtotal , vat, and grand total based off line item entries.\"}]}]}]},{\"type\":\"customImage\",\"attrs\":{\"alt\":\"\",\"src\":\"https://y4pdgnepgswqffpt.public.blob.vercel-storage.com/templates/48356-launchnow-WTRCSrrNxlMa7Ok0vu17G0K8mjuuII\",\"link\":null,\"caption\":\"\",\"uploadId\":null}},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Built for Real Use\"}],\"attrs\":{\"level\":1}},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Clean, minimal design that adapts to your style\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Mobile-optimized viewing\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"SEO-friendly structure\"}]}]}]},{\"type\":\"customHeading\",\"content\":[{\"type\":\"text\",\"text\":\"Real talk: Most designers spend weeks (or months) building their portfolio...and still end up with something that doesn't convert visitors into clients. Why start from scratch when you can build in days with a template that's designed to help you win more clients.\"}],\"attrs\":{\"level\":1}}]},\"introduction\":\"The complete portfolio template\",\"slug\":\"launchnow\",\"author\":{\