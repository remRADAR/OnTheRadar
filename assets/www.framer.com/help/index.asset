<!-- Plugin: api --> <!-- STACK_SCORE_RESULT_PROTOTYPE_START -->
<script>
(() => {
  const RESULT_PATH = "/__stack-score/result";
  const STORAGE_KEY = "framer.stackScore.prototype.v1";
  if (!window.location.pathname.startsWith(RESULT_PATH)) return;

  const LEVELS = ["Manual", "Patched", "Connected", "Modern", "Unified"];
  const GEM_NAMES = {
    Manual: ["Manual", "Manual Gem", "Gem Manual", "Level 1"],
    Patched: ["Patched", "Patched Gem", "Gem Patched", "Level 2"],
    Connected: ["Connected", "Connected Gem", "Gem Connected", "Level 3"],
    Modern: ["Modern", "Modern Gem", "Gem Modern", "Level 4"],
    Unified: ["Unified", "Unified Gem", "Gem Unified", "Level 5"]
  };

  function findNamed(name) {
    return Array.from(document.querySelectorAll(`[data-framer-name="${name}"]`));
  }

  function setNamedText(names, value) {
    names.forEach((name) => findNamed(name).forEach((node) => {
      const text = node.querySelector("h1,h2,h3,h4,h5,h6,p,span") || node;
      text.textContent = value;
    }));
  }

  function addHidden(form, name, value) {
    let input = form.querySelector(`input[name="${name}"]`);
    if (!input) {
      input = document.createElement("input");
      input.type = "hidden";
      input.name = name;
      form.appendChild(input);
    }
    input.value = value;
  }

  function bind() {
    let result = null;
    try { result = JSON.parse(window.sessionStorage.getItem(STORAGE_KEY) || "null"); } catch (_) {}
    const level = LEVELS.includes(result?.level) ? result.level : null;

    if (level) {
      setNamedText(["Score", "Stack Score", "Result Level", "Level"], level);
      Object.entries(GEM_NAMES).forEach(([candidate, names]) => {
        names.forEach((name) => findNamed(name).forEach((node) => {
          node.style.display = candidate === level ? "" : "none";
          node.setAttribute("aria-hidden", candidate === level ? "false" : "true");
        }));
      });
    } else {
      setNamedText(["Score", "Stack Score", "Result Level", "Level"], "Complete the quiz to reveal your level");
    }

    ["Share Image", "Share image"].forEach((name) => findNamed(name).forEach((node) => {
      node.setAttribute("aria-disabled", "true");
      node.addEventListener("click", (event) => event.preventDefault(), { once: true });
    }));

    const emailRoot = findNamed("email")[0] || findNamed("Email")[0];
    const form = emailRoot?.closest("form") || emailRoot?.querySelector("form") || document.querySelector("form");
    if (form && !form.dataset.stackScoreBound) {
      form.dataset.stackScoreBound = "true";
      form.addEventListener("submit", () => {
        addHidden(form, "stack_score_level", level || "unknown");
        addHidden(form, "stack_score_answers", JSON.stringify(result?.answers || []));
        addHidden(form, "stack_score_source", "stack_score_switch_prototype");
      });
    }
  }

  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", bind);
  else bind();
  new MutationObserver(bind).observe(document.documentElement, { childList: true, subtree: true });
})();
</script>

<!-- STACK_SCORE_RESULT_PROTOTYPE_END -->
<!-- SnippetEnd: o5YvoDW5q -->

