	<div id="main" data-framer-hydrate-v2="{&quot;routeId&quot;:&quot;KSxCF03ei&quot;,&quot;localeId&quot;:&quot;default&quot;,&quot;breakpoints&quot;:[{&quot;hash&quot;:&quot;bqokc5&quot;,&quot;mediaQuery&quot;:&quot;(min-width: 1200px)&quot;},{&quot;hash&quot;:&quot;1mdavca&quot;,&quot;mediaQuery&quot;:&quot;(min-width: 810px) and (max-width: 1199.98px)&quot;},{&quot;hash&quot;:&quot;19c8hry&quot;,&quot;mediaQuery&quot;:&quot;(max-width: 809.98px)&quot;},{&quot;hash&quot;:&quot;zprce9&quot;,&quot;mediaQuery&quot;:&quot;(min-width: 1200px)&quot;},{&quot;hash&quot;:&quot;nh9cw7&quot;,&quot;mediaQuery&quot;:&quot;(min-width: 810px) and (max-width: 1199.98px)&quot;},{&quot;hash&quot;:&quot;sv03hi&quot;,&quot;mediaQuery&quot;:&quot;(max-width: 809.98px)&quot;}]}" data-framer-ssr-released-at="2026-08-28T14:08:20.027Z" data-framer-page-optimized-at="2026-08-28T15:11:43.175Z" data-framer-generated-page><!--$--><!--$--><style data-framer-html-style>:root body { background: var(--token-958e2cd1-b113-4aa3-9235-7a2b959c8feb, rgb(0, 0, 0)); }</style><div class="framer-2C6Pk framer-Grv0o framer-zprce9" data-layout-template="true" data-selection="true" style="--1moyfq9:64px 0px 0px 0px;--1r5dcfs:hidden;--u410qi:var(--token-958e2cd1-b113-4aa3-9235-7a2b959c8feb, rgb(0, 0, 0));min-height:100vh;width:auto"><div class="framer-1w39556-container"><div class="ssr-variant hidden-sv03hi"><nav class="framer-Jf7Tj framer-140pdlc framer-v-140pdlc" data-framer-name="Desktop Nav" data-hide-scrollbars="true" style="background-color:rgba(0, 0, 0, 0);width:100%"><div class="framer-mhxkvs" data-framer-name="Wrapper"><div class="framer-z96yy7" data-framer-name="Logo + CTA" style="background-color:rgba(0, 0, 0, 0)"><div class="framer-fzxmln"><div class="framer-1e61pkd-container" style="opacity:1"><!--$--><!--$--><a class="framer-Tg70Q framer-qdeek2 framer-v-qdeek2 framer-4n26gx" data-framer-name="On" data-highlight="true" href="../" tabindex="0" style="height:100%"><div data-framer-component-type="SVG"